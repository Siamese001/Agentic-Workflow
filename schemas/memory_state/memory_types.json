{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentic-workflow-10-11/schemas/l4_memory/memory_types.json",
  "title": "L4 Memory State Types Schema",
  "description": "Data types for L4 memory state layer - providers, temporal, mappings",
  "type": "object",
  "properties": {
    "memory_request": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "enum": ["store", "retrieve", "update", "delete", "search"],
          "description": "Type of memory operation"
        },
        "memory_type": {
          "type": "string",
          "enum": ["short_term", "long_term", "episodic", "semantic", "action"],
          "description": "Type of memory to operate on"
        },
        "data": {
          "type": "object",
          "description": "Data to store or query parameters"
        },
        "temporal_context": {
          "type": "object",
          "properties": {
            "valid_at": {
              "type": "string",
              "format": "date-time",
              "description": "Temporal validity start"
            },
            "invalid_at": {
              "type": "string",
              "format": "date-time", 
              "description": "Temporal validity end"
            },
            "recency_weight": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Weight for temporal recency"
            }
          }
        }
      },
      "required": ["operation", "memory_type"]
    },
    "memory_response": {
      "type": "object",
      "properties": {
        "result": {
          "type": "object",
          "description": "Memory operation result"
        },
        "success": {
          "type": "boolean",
          "description": "Whether memory operation was successful"
        },
        "retrieved_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of items retrieved"
        },
        "temporal_metadata": {
          "type": "object",
          "description": "Temporal metadata for the operation"
        },
        "kg_triplets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "subject": {"type": "string"},
              "predicate": {"type": "string"},
              "object": {"type": "string"},
              "confidence": {"type": "number", "minimum": 0, "maximum": 1}
            }
          },
          "description": "Knowledge graph triplets if applicable"
        }
      },
      "required": ["result", "success"]
    }
  }
}
