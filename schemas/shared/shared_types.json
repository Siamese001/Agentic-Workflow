{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentic-workflow-10-11/schemas/shared/shared_types.json",
  "title": "Shared Types Schema",
  "description": "Common data types used across all agentic layers",
  "type": "object",
  "properties": {
    "mission_id": {
      "type": "string",
      "description": "Unique identifier for the current mission",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "session_id": {
      "type": "string", 
      "description": "Unique identifier for the current session",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "step_id": {
      "type": "string",
      "description": "Unique identifier for the current step",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp"
    },
    "trace_id": {
      "type": "string",
      "description": "OpenTelemetry trace identifier",
      "pattern": "^[a-f0-9]{32}$"
    },
    "cost_snapshot": {
      "type": "object",
      "properties": {
        "tokens_used": {"type": "integer", "minimum": 0},
        "model_cost": {"type": "number", "minimum": 0},
        "total_cost": {"type": "number", "minimum": 0}
      }
    }
  },
  "required": ["mission_id", "session_id", "step_id", "timestamp"]
}
