{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Semantic Cache Schema",
  "description": "Complete schema for Phase 0.5 semantic cache rebuild with engine separation",
  "version": "0.5.0",
  
  "definitions": {
    "EngineType": {
      "type": "string",
      "enum": ["RG", "LIC"],
      "description": "Engine type: RG=Resume Engine, LIC=Outreach Engine"
    },
    
    "ResponsibilityLevel": {
      "type": "string",
      "enum": ["L1", "L2", "L3", "L4", "L5"],
      "description": "L1-L5 responsibility tagging system"
    },
    
    "FileExtension": {
      "type": "string",
      "enum": [".py", ".json", ".md", ".txt", ".yaml", ".cfg"],
      "description": "Supported file types for semantic processing"
    },
    
    "FileSignature": {
      "type": "object",
      "required": ["file_path", "file_hash", "size_bytes", "last_modified", "engine", "archive_version", "file_extension"],
      "properties": {
        "file_path": {
          "type": "string",
          "description": "Absolute file path within archive"
        },
        "file_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 hash of file content"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "File size in bytes"
        },
        "last_modified": {
          "type": "string",
          "format": "date-time",
          "description": "Last modification timestamp"
        },
        "engine": {
          "$ref": "#/definitions/EngineType"
        },
        "archive_version": {
          "type": "string",
          "description": "Archive version folder name"
        },
        "file_extension": {
          "$ref": "#/definitions/FileExtension"
        }
      }
    },
    
    "ASTNode": {
      "type": "object",
      "required": ["node_type", "name", "line_number", "responsibility_level"],
      "properties": {
        "node_type": {
          "type": "string",
          "description": "AST node type (class, function, import, etc.)"
        },
        "name": {
          "type": "string",
          "description": "Node name identifier"
        },
        "line_number": {
          "type": "integer",
          "minimum": 1,
          "description": "Line number in source file"
        },
        "docstring": {
          "type": ["string", "null"],
          "description": "Docstring content if present"
        },
        "imports": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Import statements within this node"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Dependency references"
        },
        "responsibility_level": {
          "$ref": "#/definitions/ResponsibilityLevel"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ASTNode"
          },
          "description": "Child AST nodes"
        }
      }
    },
    
    "ASTSignature": {
      "type": "object",
      "required": ["signature", "root_nodes", "import_graph", "function_signatures", "class_signatures", "complexity_metrics"],
      "properties": {
        "signature": {
          "$ref": "#/definitions/FileSignature"
        },
        "root_nodes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ASTNode"
          },
          "description": "Root-level AST nodes"
        },
        "import_graph": {
          "type": "object",
          "patternProperties": {
            ".*": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "description": "Import dependency graph"
        },
        "function_signatures": {
          "type": "object",
          "patternProperties": {
            ".*": {
              "type": "string"
            }
          },
          "description": "Function signature mappings"
        },
        "class_signatures": {
          "type": "object",
          "patternProperties": {
            ".*": {
              "type": "string"
            }
          },
          "description": "Class signature mappings"
        },
        "complexity_metrics": {
          "type": "object",
          "properties": {
            "cyclomatic_complexity": {
              "type": "integer",
              "minimum": 1
            },
            "cognitive_complexity": {
              "type": "integer",
              "minimum": 0
            },
            "nesting_depth": {
              "type": "integer",
              "minimum": 0
            },
            "lines_of_code": {
              "type": "integer",
              "minimum": 0
            }
          },
          "description": "Code complexity metrics"
        }
      }
    },
    
    "EmbeddingVector": {
      "type": "object",
      "required": ["vector_hash", "embedding_model", "vector_dimensions", "embedding_data", "confidence_score", "semantic_tags"],
      "properties": {
        "vector_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Hash of embedding vector"
        },
        "embedding_model": {
          "type": "string",
          "description": "Model used to generate embeddings"
        },
        "vector_dimensions": {
          "type": "integer",
          "minimum": 1,
          "description": "Dimension count of embedding vector"
        },
        "embedding_data": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 1,
          "description": "Actual embedding values"
        },
        "confidence_score": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Confidence score for embedding quality"
        },
        "semantic_tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Semantic classification tags"
        }
      }
    },
    
    "ToolUsageSignature": {
      "type": "object",
      "required": ["api_calls", "retry_patterns", "backoff_strategies", "error_handling", "external_dependencies"],
      "properties": {
        "api_calls": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "function": {"type": "string"},
              "parameters": {"type": "object"},
              "retry_count": {"type": "integer"},
              "timeout": {"type": "number"}
            }
          },
          "description": "API call patterns detected"
        },
        "retry_patterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Retry mechanism patterns"
        },
        "backoff_strategies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Backoff strategy implementations"
        },
        "error_handling": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Error handling patterns"
        },
        "external_dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "External service dependencies"
        }
      }
    },
    
    "SafetySignature": {
      "type": "object",
      "required": ["safety_checks", "policy_compliance", "security_patterns", "data_handling", "access_controls"],
      "properties": {
        "safety_checks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Safety validation checks"
        },
        "policy_compliance": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Policy compliance markers"
        },
        "security_patterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Security implementation patterns"
        },
        "data_handling": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Data handling procedures"
        },
        "access_controls": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Access control implementations"
        }
      }
    },
    
    "SemanticDiff": {
      "type": "object",
      "required": ["added_functions", "removed_functions", "modified_functions", "signature_changes", "behavior_changes"],
      "properties": {
        "added_functions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Functions added in this version"
        },
        "removed_functions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Functions removed in this version"
        },
        "modified_functions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Functions modified in this version"
        },
        "signature_changes": {
          "type": "object",
          "patternProperties": {
            ".*": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "description": "Function signature changes [old, new]"
        },
        "behavior_changes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Behavioral change descriptions"
        }
      }
    },
    
    "GoldenProjection": {
      "type": "object",
      "required": ["canonical_form", "normalized_signature", "core_functionality", "interface_contract", "test_coverage"],
      "properties": {
        "canonical_form": {
          "type": "string",
          "description": "Canonical representation of the code"
        },
        "normalized_signature": {
          "type": "string",
          "description": "Normalized function/class signature"
        },
        "core_functionality": {
          "type": "string",
          "description": "Core functionality description"
        },
        "interface_contract": {
          "type": "string",
          "description": "Interface contract specification"
        },
        "test_coverage": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Test coverage indicators"
        }
      }
    },
    
    "IntegritySignals": {
      "type": "object",
      "required": ["content_hash", "structure_hash", "semantic_hash", "version_id", "lineage_chain", "verification_status"],
      "properties": {
        "content_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Hash of raw content"
        },
        "structure_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Hash of structure/AST"
        },
        "semantic_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Hash of semantic signature"
        },
        "version_id": {
          "type": "string",
          "description": "Version identifier"
        },
        "lineage_chain": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Lineage chain of previous versions"
        },
        "verification_status": {
          "type": "boolean",
          "description": "Integrity verification status"
        }
      }
    },
    
    "SemanticCacheEntry": {
      "type": "object",
      "required": ["file_signature", "ast_signature", "embedding", "tool_usage", "safety", "golden_projection", "integrity", "processing_timestamp"],
      "properties": {
        "file_signature": {
          "$ref": "#/definitions/FileSignature"
        },
        "ast_signature": {
          "$ref": "#/definitions/ASTSignature"
        },
        "embedding": {
          "$ref": "#/definitions/EmbeddingVector"
        },
        "tool_usage": {
          "$ref": "#/definitions/ToolUsageSignature"
        },
        "safety": {
          "$ref": "#/definitions/SafetySignature"
        },
        "semantic_diff": {
          "$ref": "#/definitions/SemanticDiff"
        },
        "golden_projection": {
          "$ref": "#/definitions/GoldenProjection"
        },
        "integrity": {
          "$ref": "#/definitions/IntegritySignals"
        },
        "processing_timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "When this entry was processed"
        }
      }
    },
    
    "ArchiveManifest": {
      "type": "object",
      "required": ["engine", "archive_version", "archive_path", "total_files", "processed_files", "failed_files", "file_hashes", "completeness_score", "processing_start"],
      "properties": {
        "engine": {
          "$ref": "#/definitions/EngineType"
        },
        "archive_version": {
          "type": "string",
          "description": "Archive version identifier"
        },
        "archive_path": {
          "type": "string",
          "description": "Absolute path to archive directory"
        },
        "total_files": {
          "type": "integer",
          "minimum": 0,
          "description": "Total files discovered in archive"
        },
        "processed_files": {
          "type": "integer",
          "minimum": 0,
          "description": "Successfully processed files"
        },
        "failed_files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of files that failed processing"
        },
        "file_hashes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "description": "All file hashes in this archive"
        },
        "completeness_score": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Processing completeness score"
        },
        "processing_start": {
          "type": "string",
          "format": "date-time",
          "description": "Processing start timestamp"
        },
        "processing_end": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "Processing end timestamp"
        }
      }
    },
    
    "GlobalCacheReport": {
      "type": "object",
      "required": ["resume_engine_manifests", "outreach_engine_manifests", "global_integrity", "drift_report", "orphan_report", "completeness_report"],
      "properties": {
        "resume_engine_manifests": {
          "type": "object",
          "patternProperties": {
            ".*": {
              "$ref": "#/definitions/ArchiveManifest"
            }
          },
          "description": "Resume engine archive manifests"
        },
        "outreach_engine_manifests": {
          "type": "object",
          "patternProperties": {
            ".*": {
              "$ref": "#/definitions/ArchiveManifest"
            }
          },
          "description": "Outreach engine archive manifests"
        },
        "global_integrity": {
          "type": "object",
          "properties": {
            "total_archives": {
              "type": "integer",
              "minimum": 0
            },
            "successful_archives": {
              "type": "integer",
              "minimum": 0
            },
            "total_files_processed": {
              "type": "integer",
              "minimum": 0
            },
            "integrity_violations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "description": "Global integrity metrics"
        },
        "drift_report": {
          "type": "object",
          "properties": {
            "semantic_drift": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "file": {"type": "string"},
                  "drift_score": {"type": "number"},
                  "drift_type": {"type": "string"}
                }
              }
            },
            "api_drift": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "description": "Drift analysis report"
        },
        "orphan_report": {
          "type": "object",
          "properties": {
            "orphaned_files": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "unreferenced_hashes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "description": "Orphaned file analysis"
        },
        "completeness_report": {
          "type": "object",
          "properties": {
            "required_archives": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "missing_archives": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "overall_completeness": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            }
          },
          "description": "Completeness analysis"
        }
      }
    }
  },
  
  "type": "object",
  "description": "Root schema for semantic cache validation",
  "properties": {
    "cache_entries": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/SemanticCacheEntry"
      }
    },
    "manifests": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ArchiveManifest"
      }
    },
    "global_report": {
      "$ref": "#/definitions/GlobalCacheReport"
    }
  }
}
