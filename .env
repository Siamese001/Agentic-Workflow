# =============================================================================
# VALIDATOR CONFIGURATION
# =============================================================================

# Healing Limits and Budgets
MAX_HEALING_PER_FILE=8
GLOBAL_HEALING_BUDGET=50
MAX_HEALING_ROUNDS=3

# Cache Settings
CACHE_TTL=3600
PATTERN_MATCH_TOP_K=3

# File Size and Complexity Limits
MAX_LINE_LENGTH=100
MAX_FUNCTION_LINES=50
MAX_CLASS_SIZE_KB=20
MAX_FUNCTION_COMPLEXITY=10
MAX_NESTING_DEPTH=4
MAX_PARAMETERS=8

# Content Generation Limits
MAX_VIOLATIONS_SHOWN=8
REFERENCE_FIX_CHARS=500
CODE_EXPANSION_FACTOR=4

# =============================================================================
# CONFIGURATION OPTIONS
# =============================================================================

# Redis Configuration (local testing - change to redis-stack for docker-compose)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

LANGCACHE_REDIS_KEY=
LANGCACHE_ID=

# Application Settings
PYTHONUNBUFFERED=1
LOG_LEVEL=INFO
DEBUG=false

# =============================================================================
# QUICK START INSTRUCTIONS
# =============================================================================

# 1. Copy this template:
#    cp .env.example .env
#
# 2. Edit .env with your actual API keys
#
# 3. Start the complete stack:
#    docker-compose up --build
#
# 4. Verify installation:
#    docker-compose logs agentic-app
#
# 5. Access services:
#    - RedisInsight UI: http://localhost:8001
#    - Application API: http://localhost:8000
#
