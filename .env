REDIS_URL=redis://localhost:6379

LANGCACHE_REDIS_KEY=
LANGCACHE_ID=

# Application Settings
PYTHONUNBUFFERED=1
LOG_LEVEL=INFO
DEBUG=false

# =============================================================================
# HIVE MIND CONFIGURATION (Phase 17-21 Meta-Learning Infrastructure)
# =============================================================================

# MANDATORY - Agents will not start without these (already defined above):
# - REDIS_URL (Working Memory - 24h TTL cache)
# - PINECONE_API_KEY (Long-Term DNA - semantic search)
# - GEMINI_API_KEY (Embeddings via text-embedding-004)

# Strict Mode: "true" raises CriticalInfrastructureError if Redis/Pinecone unavailable
# Set to "false" for graceful degradation (stateless fallback mode)
HIVE_MIND_STRICT_MODE=false

# Minimum similarity threshold for auto-recall (0.0 to 1.0)
# Higher = more precise matches, fewer false positives
HIVE_MIND_MIN_CONFIDENCE=0.98

# Trace sampling rate (0.0 to 1.0) - controls what % of executions are stored
# 1.0 = store all, 0.1 = store 10%, 0.0 = store none
HIVE_MIND_TRACE_SAMPLING_RATE=1.0

# Promotion threshold for Long-Term DNA (0.0 to 1.0)
# Memories with feedback_score >= this value are promoted to Pinecone
HIVE_MIND_PROMOTION_THRESHOLD=0.8

# Working Memory TTL in seconds (default: 24 hours)
# Memories in Redis expire after this duration unless promoted
HIVE_MIND_WORKING_MEMORY_TTL=86400

# Long-Term Memory TTL in seconds (default: 7 days)
# Promoted memories in Pinecone/Redis get extended TTL
HIVE_MIND_LONG_TERM_TTL=604800

# =============================================================================
# QUICK START INSTRUCTIONS
# =============================================================================

# 1. Copy this template:
#    cp .env.example .env
#
# 2. Edit .env with your actual API keys
#
# 3. Start the complete stack:
#    docker-compose up --build
#
# 4. Verify installation:
#    docker-compose logs agentic-app
#
# 5. Access services:
#    - RedisInsight UI: http://localhost:8001
#    - Application API: http://localhost:8000
#
