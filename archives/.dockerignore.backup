# .dockerignore - Canonical 50 Keys Enforcement
# Purpose: Prevents the Surgeon from seeing legacy/junk files in the root.

# 1. Global Exclusions
.git/
.github/
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
.env*
.vscode/
.idea/
logs/
tmp/

# 2. Strict Root Protection
# This ignores ALL python files in the root directory first...
/*.py

# ...then whitelists ONLY the absolute essentials for Phase B boot.
!/main.py
!/orchestrator.py
!/requirements.txt

# 3. Pattern-Based Junk Removal
# Prevents "Surgeon Leaks" where variants were being scanned
**/*_backup.py
**/*_v[0-9]*.py
**/*_old.py
**/temp_*.py
**/scratch_*.py
**/test_*.py
**/*_test.py

# 4. Directory Cordoning
# Explicitly ignore non-production areas to speed up the Librarian scan
experimental/
local/
dev/
archives/
backup/
docs/
node_modules/
build/
dist/

# 5. Infrastructure and Security
secrets/
*.key
*.pem
*.sqlite
*.db

# 6. Docker Recursion Prevention
Dockerfile*
docker-compose*.yml
.dockerignore
