{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cursor.agentic-workflow/author_gate_packet.schema.json",
  "title": "Author-Gate Packet (canonical SSOT)",
  "description": "Canonical shape of an AUTHOR_GATE_PACKET emitted by .cursor/skills/author-gate-packet-builder/emit_packet.py and consumed by post_cursor_agent_author_gate_{capture,schema,ui,miss}_audit.py + post_cursor_agent_ask_user_question_packet_audit.py. Plan: author-gate-ssot-consolidation-b7c3e1. Replaces 8-source SSOT sprawl. Versioned via $id; breaking changes require dated bump.",
  "type": "object",
  "required": [
    "decision_id",
    "created_at",
    "decision_type",
    "status",
    "candidates",
    "routing"
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "pattern": "^dec_[a-z0-9]{6,}$",
      "description": "Stable id; emit_packet.py mints as dec_<hex>."
    },
    "created_at": {"type": "string", "format": "date-time"},
    "branch": {"type": ["string", "null"]},
    "commit_sha": {
      "type": ["string", "null"],
      "pattern": "^([a-f0-9]{7,40})?$"
    },
    "decision_type": {
      "type": "string",
      "enum": [
        "architecture_choice",
        "refactor_scope",
        "anti_pattern",
        "dependency_addition",
        "test_strategy",
        "deletion_strategy",
        "error_handling",
        "certification_claim",
        "unknown"
      ]
    },
    "request_summary": {"type": ["string", "null"]},
    "normalized_intent": {"type": ["string", "null"]},
    "user_goal": {"type": ["string", "null"]},
    "principle_at_stake": {"type": ["string", "null"]},
    "recommended_option_id": {"type": ["string", "null"]},
    "selected_option_id": {"type": ["string", "null"]},
    "selection_rationale": {"type": ["string", "null"]},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/candidate"}
    },
    "confidence_top": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1
    },
    "confidence_dominance_gap": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1
    },
    "override_vs_recommendation": {
      "type": ["boolean", "integer", "null"]
    },
    "selection_latency_ms": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "policy_snapshot": {
      "type": ["string", "null"],
      "pattern": "^(author-gate@[0-9a-f]+|unknown)?$"
    },
    "context_fingerprint": {"$ref": "#/$defs/context_fingerprint"},
    "routing": {"$ref": "#/$defs/routing"},
    "precedent": {"$ref": "#/$defs/precedent"},
    "reason_code_palette": {
      "type": ["array", "null"],
      "items": {"type": "string"}
    },
    "calibrator_version": {"type": ["string", "null"]},
    "status": {
      "type": "string",
      "enum": ["surfaced", "executed", "rolled_back", "failed"]
    }
  },
  "additionalProperties": true,
  "$defs": {
    "candidate": {
      "type": "object",
      "required": ["id", "confidence_score"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "thesis": {"type": ["string", "null"]},
        "confidence_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "surfaced": {"type": ["boolean", "null"]},
        "is_recommended": {"type": ["boolean", "null"]},
        "suppression_reason": {
          "type": ["string", "null"],
          "enum": [
            "below_surface_threshold",
            "non_distinct",
            "dominance_fired",
            null
          ]
        },
        "key_tradeoffs": {
          "type": ["array", "null"],
          "items": {"type": "string"}
        },
        "what_youd_miss": {"type": ["string", "null"]},
        "what_would_flip": {
          "type": ["string", "array", "null"],
          "items": {"type": "string"}
        },
        "principle_at_stake": {"type": ["string", "null"]},
        "value_to_goal": {"type": ["string", "null"]},
        "execution_impact": {"type": ["string", "null"]},
        "risk_profile": {"type": ["string", "null"]},
        "time_to_value": {"type": ["string", "null"]},
        "reason_codes": {
          "type": ["array", "null"],
          "items": {"type": "string"}
        },
        "blast_radius": {
          "type": ["object", "null"]
        },
        "signals": {"type": ["object", "null"]},
        "signal_weights": {"type": ["object", "null"]},
        "raw_score": {"type": ["number", "null"]},
        "surface_label": {"type": ["string", "null"]},
        "surface_description_prefix": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "context_fingerprint": {
      "type": ["object", "null"],
      "properties": {
        "adg_snapshot": {"type": ["string", "null"]},
        "git_sha": {"type": ["string", "null"]},
        "branch": {"type": ["string", "null"]},
        "files_in_scope": {
          "type": "array",
          "items": {"type": "string"}
        },
        "fp": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]+$"
        },
        "blast_radius": {"type": ["object", "null"]}
      },
      "additionalProperties": true
    },
    "routing": {
      "type": "object",
      "required": ["rule_applied"],
      "properties": {
        "rule_applied": {
          "type": "string",
          "description": "Routing verdict. Star-count contract: dominance_fires => 1 star; otherwise 0 stars.",
          "pattern": "^(dominance_fires|low_confidence_ambiguity|surface_top_[0-9]+|empty|tie_break|manual_override|filter_passes)$"
        },
        "surface_threshold": {"type": ["number", "null"]},
        "dominance_delta_observed": {"type": ["number", "null"]},
        "top_score": {"type": ["number", "null"]}
      },
      "additionalProperties": true
    },
    "precedent": {
      "type": ["object", "null"],
      "properties": {
        "verdict": {
          "type": "string",
          "enum": ["none", "strong", "suggestive"]
        },
        "matched_ids": {
          "type": "array",
          "items": {"type": "string"}
        },
        "match_count": {"type": ["integer", "null"]},
        "summary": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    }
  }
}
