    "linguistic_validators": {
      "forbidden_verbs": [
        "helped",
        "assisted",
        "worked on",
        "participated in",
        "involved in",
        "responsible for",
        "duties included",
        "tasked with"
      ],
      "biased_terms": [
        "young",
        "old",
        "senior citizen",
        "millennial",
        "gen-z",
        "he",
        "she",
        "his",
        "her",
        "hers",
        "him",
        "crazy",
        "insane",
        "OCD",
        "bipolar"
      ],
      "weak_intros": [
        "I am",
        "I was",
        "I have",
        "I had",
        "I helped",
        "I assisted",
        "My role",
        "My responsibility",
        "In my position"
