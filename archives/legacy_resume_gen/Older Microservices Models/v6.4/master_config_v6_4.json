{
  "meta_loop_config": {
    "enable_meta_learning": true,
    "feedback_log_path": "feedback_log.jsonl",
    "rules_registry_path": "rules_registry.json",
    "pattern_confidence_threshold": 0.75,
    "min_samples_for_learning": 10
  },
  "batch_config": {
    "max_parallel_workers": 8,
    "enable_online_learning": true,
    "online_learning_failure_threshold": 2
  },
  "orchestration_config": {
    "orchestration_mode": "dynamic_goal_driven",
    "default_goal": "Produce a final_draft that passes all ValidationEngine checks",
    "default_policy_fallback": [
      "run_strategy_stack",
      "run_rag_stack",
      "run_prompt_stack",
      "run_bullet_stack",
      "run_drafting_stack",
      "run_qa_stack"
    ]
  },
  "governor_config": {
    "max_retries_per_node": 2,
    "veto_hierarchy": [
      "ADVERSARIAL",
      "HOLISTIC",
      "STRATEGY",
      "QA3_SEMANTIC",
      "QA2_FACTUAL",
      "QA1_LINGUISTIC"
    ]
  },
  "planner_config": {
    "max_replan_loops": 5,
    "enable_dynamic_replanning": true,
    "critique_threshold": 0.7
  },
  "conductor_config": {
    "enabled": true,
    "num_branches": 3,
    "strategies": [
      {
        "id": "branch_a",
        "description": "GTM-Focused",
        "emphasis": "partnerships_go_to_market",
        "weight_strategic": 0.7,
        "weight_technical": 0.3
      },
      {
        "id": "branch_b",
        "description": "Tech-Focused",
        "emphasis": "technical_depth_innovation",
        "weight_strategic": 0.3,
        "weight_technical": 0.7
      },
      {
        "id": "branch_c",
        "description": "Balanced",
        "emphasis": "balanced_leadership",
        "weight_strategic": 0.5,
        "weight_technical": 0.5
      }
    ],
    "voting_method": "score_based",
    "min_score_threshold": 0.75,
    "parallel_execution": true
  },
  "moe_config": {
    "enabled": true,
    "routers": {
      "linguistic_router": {
        "router_id": "linguistic_router",
        "router_name": "Linguistic Validation Router",
        "aggregation_method": "all_pass",
        "parallel_execution": true,
        "timeout_seconds": 60,
        "expert_agents": [
          "ForbiddenVerbValidator",
          "GrammarTokenCount",
          "FormatCompliance",
          "BiasScrubber",
          "IntroPhraseValidator"
        ]
      },
      "factual_router": {
        "router_id": "factual_router",
        "router_name": "Factual Validation Router",
        "aggregation_method": "all_pass",
        "parallel_execution": true,
        "timeout_seconds": 90,
        "expert_agents": [
          "MetricValidator",
          "TenureValidator",
          "EntityValidator",
          "ClaimValidator"
        ]
      },
      "semantic_router": {
        "router_id": "semantic_router",
        "router_name": "Semantic Validation Router",
        "aggregation_method": "voting",
        "parallel_execution": true,
        "timeout_seconds": 120,
        "expert_agents": [
          "ToneValidator",
          "ThematicAlignmentValidator",
          "SemanticEntailmentValidator",
          "NarrativeThread",
          "AdversarialReviewer"
        ]
      },
      "global_router": {
        "router_id": "global_router",
        "router_name": "Global Validation Router",
        "aggregation_method": "all_pass",
        "parallel_execution": true,
        "timeout_seconds": 60,
        "expert_agents": [
          "SectionPresence",
          "WordCount",
          "SentenceCount",
          "Structure",
          "Similarity",
          "JDSkillsValidator",
          "SignalScoreValidator"
        ]
      }
    }
  },
  "reflection_config": {
    "enable_reflection": true,
    "max_iterations": 3,
    "convergence_threshold": 0.9
  },
  "react_config": {
    "enabled": true,
    "max_tool_calls_per_query": 5,
    "max_reasoning_loops": 3,
