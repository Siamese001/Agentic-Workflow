{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cursor.local/schemas/exit_criteria.schema.json",
  "title": "Author-Gate Decision Exit Criteria",
  "description": "Machine-checkable exit conditions attached to a refactor-class decision. Fills decisions.exit_criteria_json. Each criterion has a stable id, a human label, an evaluator type, and optional parameters. The lookup/promotion path can consult these to decide when a decision is truly 'done' vs 'executed-but-unverified'.",
  "type": "object",
  "required": ["version", "criteria"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "enum": ["1"]
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["id", "label", "evaluator"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,47}$",
            "description": "Stable identifier (snake_case)"
          },
          "label": {
            "type": "string",
            "minLength": 3,
            "maxLength": 160,
            "description": "Human-readable exit condition"
          },
          "evaluator": {
            "type": "string",
            "enum": [
              "tests_passed",
              "coverage_metric",
              "audit_report_status",
              "ledger_field_present",
              "file_exists",
              "command_exit_zero",
              "manual_attestation"
            ]
          },
          "params": {
            "type": "object",
            "description": "Evaluator-specific parameters. Schema depends on evaluator."
          },
          "required": {
            "type": "boolean",
            "default": true,
            "description": "Whether plan cannot exit Done without this passing"
          },
          "notes": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    }
  }
}
