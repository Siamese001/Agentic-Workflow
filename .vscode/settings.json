{
    "python.defaultInterpreterPath": ".venv\\\\Scripts\\\\python.exe",
    "python.terminal.activateEnvironment": true,
    "python.terminal.activateInCurrentTerminal": true,
    "testing.pytest.enabled": true,
    "testing.pytest.pytestPath": ".venv\\\\Scripts\\\\pytest.exe",
    "python.testing.pytestEnabled": true,
    "python.testing.pytestArgs": [
        "tests"
    ],
    "python.testing.cwd": "${workspaceFolder}",
    "python.testing.unittestEnabled": false,
    "python.testing.autoTestDiscoverOnSaveEnabled": true,
    "python.testing.logLevel": "trace",
    "python.envFile": "${workspaceFolder}/.venv/Scripts/activate"
}
