{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentic-workflow.io/schemas/rule_frontmatter.schema.json",
  "title": "legacy editor Rule Frontmatter Schema",
  "description": "JSON Schema for validating .claude/rules/*.md YAML frontmatter",
  "type": "object",
  "required": ["version", "rule_class", "enforcement_tier"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Schema version of this rule",
      "pattern": "^\\d+\\.\\d+$",
      "examples": ["1.0", "2.1"]
    },
    "rule_class": {
      "type": "string",
      "description": "Classification of the rule type",
      "enum": [
        "always_on",
        "conditional",
        "skill",
        "workflow",
        "guardian",
        "audit"
      ]
    },
    "enforcement_tier": {
      "type": "string",
      "description": "Enforcement tier (T0-T6)",
      "enum": [
        "T0_question",
        "T1_trivial",
        "T2_scoped",
        "T3_architectural",
        "T4_governance",
        "T5_constitutional",
        "T6_meta"
      ]
    },
    "trigger": {
      "type": "object",
      "description": "When this rule should be evaluated",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "file_pattern",
            "content_pattern",
            "tool_invocation",
            "user_intent",
            "always"
          ]
        },
        "pattern": {
          "type": "string",
          "description": "Glob or regex pattern for file/content matching"
        }
      },
      "required": ["type"]
    },
    "adg_required": {
      "type": "boolean",
      "description": "Whether ADG analysis is required before applying this rule",
      "default": false
    },
    "author_gate_required": {
      "type": "boolean",
      "description": "Whether Author-Gate approval is required",
      "default": false
    },
    "bypass_env_var": {
      "type": "string",
      "description": "Environment variable name for bypassing this rule",
      "pattern": "^[A-Z_]+$"
    },
    "related_rules": {
      "type": "array",
      "description": "List of related rule files",
      "items": {
        "type": "string",
        "pattern": "^\\.claude/rules/[a-z0-9_-]+\\.md$"
      }
    },
    "related_skills": {
      "type": "array",
      "description": "List of related skill slugs",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_-]+$"
      }
    },
    "supersedes": {
      "type": "array",
      "description": "Rules this rule supersedes",
      "items": {
        "type": "string"
      }
    },
    "deprecated": {
      "type": "object",
      "description": "Deprecation information",
      "properties": {
        "since": {
          "type": "string",
          "format": "date"
        },
        "replaced_by": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": ["since", "replaced_by"]
    },
    "test_coverage": {
      "type": "object",
      "description": "Test coverage requirements",
      "properties": {
        "unit_tests_required": {
          "type": "boolean",
          "default": true
        },
        "integration_tests_required": {
          "type": "boolean",
          "default": false
        },
        "test_path_pattern": {
          "type": "string",
          "pattern": "^tests/.+"
        }
      }
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "version": "1.0",
      "rule_class": "always_on",
      "enforcement_tier": "T3_architectural",
      "trigger": {
        "type": "always"
      },
      "adg_required": true,
      "author_gate_required": true,
      "bypass_env_var": "ADG_FIRST_BYPASS"
    }
  ]
}
