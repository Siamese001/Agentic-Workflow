#!/usr/bin/env python3
"""
ROBUST NUCLEAR AUDIT: Enhanced Agent Technical Status Analysis

Improved version that handles syntax errors and provides comprehensive analysis
of all agents in agentic_core/ with better error recovery.
"""

import ast
import json
import logging
import sys
import re
from pathlib import Path
from typing import Any, Dict, List, Optional, Set, Tuple
from dataclasses import dataclass, field
from datetime import datetime

# Add project root to path
PROJECT_ROOT = Path(__file__).parent
sys.path.insert(0, str(PROJECT_ROOT))

# Configure logging
logging.basicConfig(level=logging.ERROR, format='%(levelname)s: %(message)s')
logger = logging.getLogger(__name__)


@dataclass
class AgentTechnicalStatus:
    """Technical status data for a single agent."""
    class_name: str
    file_path: str
    layer: str
    namespace_status: str = "[UNKNOWN]"
    inheritance_status: str = "[UNKNOWN]"
    heal_method_status: str = "[UNKNOWN]"
    import_status: str = "[UNKNOWN]"
    mixin_status: str = "[UNKNOWN]"
    agent_type: str = "[UNKNOWN]"
    violations: List[str] = field(default_factory=list)
    recommendations: List[str] = field(default_factory=list)
    line_count: int = 0
    complexity_score: float = 0.0
    parse_error: bool = False


class RobustNuclearAuditor:
    """Robust agent technical status auditor with error recovery."""
    
    def __init__(self, project_root: Path):
        self.project_root = project_root
        self.agentic_core_dir = project_root / "agentic_core"
        self.agent_statuses: List[AgentTechnicalStatus] = []
        
    def audit_all_agents(self) -> List[AgentTechnicalStatus]:
        """Perform comprehensive audit of all agents in agentic_core/."""
        print("Starting robust nuclear audit of agentic_core/ agents...")
        
        # Find all Python files in agentic_core
        python_files = list(self.agentic_core_dir.rglob("*.py"))
        print(f"Found {len(python_files)} Python files to analyze")
        
        for file_path in python_files:
            try:
                agents = self._analyze_file_robust(file_path)
                self.agent_statuses.extend(agents)
            except Exception as e:
                print(f"Failed to analyze {file_path}: {e}")
        
        print(f"Analyzed {len(self.agent_statuses)} agent classes")
        return self.agent_statuses
    
    def _analyze_file_robust(self, file_path: Path) -> List[AgentTechnicalStatus]:
        """Analyze a file using robust text-based methods."""
        agents = []
        
        try:
            with open(file_path, 'r', encoding='utf-8') as f:
                content = f.read()
            
            # Find agent classes using regex
            class_matches = re.finditer(r'^class\s+(\w+Agent)\s*\([^)]*\):', content, re.MULTILINE)
            
            for match in class_matches:
                class_name = match.group(1)
                status = self._analyze_agent_class_robust(class_name, file_path, content)
                agents.append(status)
                    
        except Exception as e:
            print(f"Error reading {file_path}: {e}")
        
        return agents
    
    def _analyze_agent_class_robust(self, class_name: str, file_path: Path, content: str) -> AgentTechnicalStatus:
        """Perform robust analysis using text-based methods."""
        status = AgentTechnicalStatus(
            class_name=class_name,
            file_path=str(file_path.relative_to(self.project_root)),
            layer=self._determine_layer(file_path),
            line_count=content.count('\n') + 1
        )
        
        # Extract class section
        class_start = content.find(f"class {class_name}")
        if class_start == -1:
            status.parse_error = True
            return status
            
        # Find the end of the class (next class or end of file)
        remaining_content = content[class_start:]
        next_class_match = re.search(r'\nclass\s+\w+', remaining_content[1:])  # Skip first char
        if next_class_match:
            class_content = remaining_content[:next_class_match.start() + 1]
        else:
            class_content = remaining_content
        
        # 1. Inheritance Analysis (text-based)
        status.inheritance_status = self._check_inheritance_robust(class_name, class_content)
        
        # 2. heal() Method Analysis (text-based)
        status.heal_method_status = self._check_heal_method_robust(class_content)
        
        # 3. Namespace/Structure Compliance
        status.namespace_status = self._check_namespace_compliance(file_path)
        
        # 4. Import Dependency Analysis  
        status.import_status = self._check_import_compliance(content)
        
        # 5. Agent Type Classification
        status.agent_type = self._classify_agent_type_robust(class_content)
        
        # 6. Calculate complexity score
        status.complexity_score = self._calculate_complexity_robust(class_content)
        
        # 7. Generate violations and recommendations
        self._generate_violations_and_recommendations(status)
        
        return status
    
    def _determine_layer(self, file_path: Path) -> str:
        """Determine the architectural layer for a file."""
        path_str = str(file_path)
        
        layer_mappings = {
            "L0_maintenance": "L0",
            "L1_cognition": "L1", 
            "L2_execution": "L2",
            "L3_orchestration": "L3",
            "L4_state": "L4",
            "L5_safety": "L5",
            "L6_observability": "L6",
            "base_agents": "Base",
            "domain": "Domain"
        }
        
        for pattern, layer in layer_mappings.items():
            if pattern in path_str:
                return layer
        
        return "Unknown"
    
    def _check_namespace_compliance(self, file_path: Path) -> str:
        """Check if file location complies with expected structure."""
        relative_path = file_path.relative_to(self.project_root)
        path_parts = relative_path.parts
        
        if len(path_parts) < 2 or path_parts[0] != "agentic_core":
            return "[INVALID] - Outside agentic_core"
        
        # Check for valid layer directories
        valid_layers = ["base_agents", "domain", "L0_maintenance", "L1_cognition", 
                       "L2_execution", "L3_orchestration", "L4_state", "L5_safety", 
                       "L6_observability", "patterns", "utils", "schemas", "config",
                       "prompt_governance", "runtime", "knowledge", "semantic_memory"]
        
        if len(path_parts) >= 3 and path_parts[2] in valid_layers:
            return "[VALID]"
        
        return "[INVALID]"
    
    def _check_inheritance_robust(self, class_name: str, class_content: str) -> str:
        """Check inheritance using text-based analysis."""
        # Extract inheritance from class definition
        class_match = re.search(rf'class\s+{class_name}\s*\(([^)]*)\):', class_content)
        if not class_match:
            return "[BROKEN] - No inheritance found"
        
        inheritance_str = class_match.group(1)
        
        # Check for SovereignBaseAgent
        if "SovereignBaseAgent" in inheritance_str:
            return "[VALID]"
        
        # Check for other base agents
        base_patterns = ["L0MaintenanceBaseAgent", "L1CognitionBaseAgent", "L2ExecutionBaseAgent",
                        "L3OrchestrationBaseAgent", "L4StateBaseAgent", "L5SafetyBaseAgent", 
                        "L6ObservabilityBaseAgent"]
        
        for pattern in base_patterns:
            if pattern in inheritance_str:
                return "[VALID]"
        
        # Check if it inherits from any Agent class
        if "Agent" in inheritance_str:
            return "[PARTIAL]"
        
        return "[BROKEN] - Missing proper base agent inheritance"
    
    def _check_heal_method_robust(self, class_content: str) -> str:
        """Check heal() method using text-based analysis."""
        # Look for heal method definition
        heal_match = re.search(r'def\s+heal\s*\([^)]*\):', class_content)
        if not heal_match:
            return "[MISSING] - No heal() method"
        
        # Extract parameter list
        method_signature = heal_match.group(0)
        
        # Check for 'violation' parameter
        if "violation" in method_signature:
            return "[VALID]"
        else:
            return "[INVALID] - Wrong signature"
    
    def _check_import_compliance(self, content: str) -> str:
        """Check import dependencies using text-based analysis."""
        # Check for SovereignBaseAgent import
        has_sovereign_import = "SovereignBaseAgent" in content
        has_agentic_core_import = "from agentic_core" in content or "import agentic_core" in content
        
        if has_sovereign_import and has_agentic_core_import:
            return "[VALID]"
        elif has_agentic_core_import:
            return "[PARTIAL]"
        else:
            return "[BROKEN]"
    
    def _classify_agent_type_robust(self, class_content: str) -> str:
        """Classify agent using text-based analysis."""
        # Check for abstract methods
        has_abstract = "@abstractmethod" in class_content or "abc.abstractmethod" in class_content
        
        # Check for TODO/FIXME markers
        has_todo = any(marker in class_content.upper() for marker in ["TODO", "FIXME", "XXX", "HACK"])
        
        # Check if mostly empty (only pass statements)
        pass_count = class_content.count("pass")
        method_count = len(re.findall(r'def\s+\w+', class_content))
        
        if has_abstract:
            return "Abstract"
        elif has_todo or (method_count <= 1 and pass_count > 0):
            return "Stub"
        else:
            return "Concrete"
    
    def _calculate_complexity_robust(self, class_content: str) -> float:
        """Calculate complexity using text-based analysis."""
        method_count = len(re.findall(r'def\s+\w+', class_content))
        
        # Estimate cyclomatic complexity
        complexity_keywords = ["if ", "elif ", "for ", "while ", "try:", "except ", "with "]
        cyclomatic = sum(class_content.count(keyword) for keyword in complexity_keywords)
        
        return float(method_count + cyclomatic * 0.5)
    
    def _generate_violations_and_recommendations(self, status: AgentTechnicalStatus):
        """Generate violation list and recommendations."""
        violations = []
        recommendations = []
        
        # Inheritance violations
        if "[BROKEN]" in status.inheritance_status:
            violations.append("Missing proper base agent inheritance")
            recommendations.append("Add appropriate base agent (SovereignBaseAgent or layer-specific)")
        
        # heal() method violations
        if "[MISSING]" in status.heal_method_status:
            violations.append("Missing heal() method")
            recommendations.append("Implement heal(self, violation: dict) -> dict method")
        elif "[INVALID]" in status.heal_method_status:
            violations.append("Incorrect heal() method signature")
            recommendations.append("Fix heal() method to match expected signature")
        
        # Namespace violations
        if "[INVALID]" in status.namespace_status:
            violations.append("Invalid namespace/location")
            recommendations.append("Move agent to proper directory per structure blueprint")
        
        # Import violations
        if "[BROKEN]" in status.import_status:
            violations.append("Broken import dependencies")
            recommendations.append("Fix import statements and dependencies")
        
        # Stub agent violations
        if status.agent_type == "Stub":
            violations.append("Agent is incomplete stub")
            recommendations.append("Complete agent implementation or mark as abstract")
        
        status.violations = violations
        status.recommendations = recommendations
    
    def generate_technical_status_table(self) -> str:
        """Generate comprehensive technical status table."""
        if not self.agent_statuses:
            return "No agents analyzed"
        
        # Sort by layer, then by status priority
        def sort_key(status):
            priority_order = {"[BROKEN]": 0, "[MISSING]": 1, "[INVALID]": 2, "[PARTIAL]": 3, "[VALID]": 4}
            layer_order = {"Base": 0, "L0": 1, "L1": 2, "L2": 3, "L3": 4, "L4": 5, "L5": 6, "L6": 7}
            
            # Count critical issues
            critical_issues = sum(1 for field in [status.inheritance_status, status.heal_method_status] 
                                if "[BROKEN]" in field or "[MISSING]" in field)
            
            return (critical_issues, layer_order.get(status.layer, 99), 
                   priority_order.get(status.inheritance_status, 99))
        
        sorted_agents = sorted(self.agent_statuses, key=sort_key)
        
        # Generate table header
        table = []
        table.append("# ROBUST NUCLEAR AUDIT REPORT: Agent Technical Status")
        table.append(f"Generated: {datetime.now().isoformat()}")
        table.append(f"Total Agents Analyzed: {len(self.agent_statuses)}")
        table.append("")
        
        # Summary statistics
        inheritance_broken = sum(1 for a in self.agent_statuses if "[BROKEN]" in a.inheritance_status)
        heal_missing = sum(1 for a in self.agent_statuses if "[MISSING]" in a.heal_method_status)
        namespace_invalid = sum(1 for a in self.agent_statuses if "[INVALID]" in a.namespace_status)
        stub_agents = sum(1 for a in self.agent_statuses if a.agent_type == "Stub")
        valid_agents = sum(1 for a in self.agent_statuses if "[VALID]" in a.inheritance_status and "[VALID]" in a.heal_method_status)
        
        table.append("## Summary Statistics")
        table.append(f"- Total Agents: {len(self.agent_statuses)}")
        table.append(f"- Broken Inheritance: {inheritance_broken} ({inheritance_broken/len(self.agent_statuses)*100:.1f}%)")
        table.append(f"- Missing heal() Method: {heal_missing} ({heal_missing/len(self.agent_statuses)*100:.1f}%)") 
        table.append(f"- Invalid Namespace: {namespace_invalid} ({namespace_invalid/len(self.agent_statuses)*100:.1f}%)")
        table.append(f"- Stub/Incomplete Agents: {stub_agents} ({stub_agents/len(self.agent_statuses)*100:.1f}%)")
        table.append(f"- Fully Compliant: {valid_agents} ({valid_agents/len(self.agent_statuses)*100:.1f}%)")
        table.append("")
        
        # Layer breakdown
        table.append("## Agent Distribution by Layer")
        table.append("")
        layer_counts = {}
        for agent in self.agent_statuses:
            layer_counts[agent.layer] = layer_counts.get(agent.layer, 0) + 1
        
        for layer in sorted(layer_counts.keys()):
            count = layer_counts[layer]
            table.append(f"- {layer}: {count} agents")
        table.append("")
        
        # Detailed table
        table.append("## Detailed Technical Status")
        table.append("")
        table.append("| Agent | Layer | File | Inheritance | heal() | Namespace | Type | Complexity | Issues |")
        table.append("|-------|-------|------|-------------|--------|-----------|------|------------|--------|")
        
        for status in sorted_agents:
            issues = len(status.violations)
            if issues > 0:
                issues_str = f"ISSUES {issues}"
            else:
                issues_str = "OK"
            
            # Shorten file path for display
            short_path = status.file_path.replace("agentic_core/", "a_c/").replace("agentic_core\\", "a_c\\")
            if len(short_path) > 40:
                short_path = short_path[-37:]
            
            table.append(f"| {status.class_name} | {status.layer} | {short_path} | "
                        f"{status.inheritance_status} | {status.heal_method_status} | "
                        f"{status.namespace_status} | {status.agent_type} | "
                        f"{status.complexity_score:.1f} | {issues_str} |")
        
        # Critical issues section
        table.append("")
        table.append("## Critical Issues Requiring Immediate Attention")
        table.append("")
        
        critical_agents = [a for a in sorted_agents if any("[BROKEN]" in field or "[MISSING]" in field 
                         for field in [a.inheritance_status, a.heal_method_status])]
        
        # Show top 20 critical agents to avoid overwhelming report
        for status in critical_agents[:20]:
            table.append(f"### CRITICAL: {status.class_name} ({status.layer})")
            table.append(f"**File:** `{status.file_path}`")
            table.append(f"**Issues:** {', '.join(status.violations)}")
            table.append(f"**Recommendations:** {', '.join(status.recommendations)}")
            table.append("")
        
        if len(critical_agents) > 20:
            table.append(f"*... and {len(critical_agents) - 20} more critical agents*")
            table.append("")
        
        return "\n".join(table)
    
    def save_report(self, output_path: Path):
        """Save detailed audit report to file."""
        report = self.generate_technical_status_table()
        
        with open(output_path, 'w', encoding='utf-8') as f:
            f.write(report)
        
        print(f"Audit report saved to: {output_path}")


def main():
    """Main execution function."""
    project_root = Path(__file__).parent
    auditor = RobustNuclearAuditor(project_root)
    
    # Perform comprehensive audit
    print("*** Starting ROBUST nuclear audit ***")
    auditor.audit_all_agents()
    
    # Generate and save report
    report_path = project_root / "ROBUST_NUCLEAR_AUDIT_REPORT.md"
    auditor.save_report(report_path)
    
    # Print summary
    statuses = auditor.agent_statuses
    total = len(statuses)
    broken = sum(1 for s in statuses if "[BROKEN]" in s.inheritance_status)
    missing_heal = sum(1 for s in statuses if "[MISSING]" in s.heal_method_status)
    valid = sum(1 for s in statuses if "[VALID]" in s.inheritance_status and "[VALID]" in s.heal_method_status)
    
    print(f"\n*** ROBUST NUCLEAR AUDIT COMPLETE ***")
    print(f"Total Agents: {total}")
    print(f"Broken Inheritance: {broken} ({broken/total*100:.1f}%)")
    print(f"Missing heal(): {missing_heal} ({missing_heal/total*100:.1f}%)")
    print(f"Fully Compliant: {valid} ({valid/total*100:.1f}%)")
    print(f"Report: {report_path}")


if __name__ == "__main__":
    main()
