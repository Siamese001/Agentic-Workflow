{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Prompt Schema",
  "description": "Schema for defining structured prompts",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the prompt"
    },
    "description": {
      "type": "string",
      "description": "Description of what the prompt does"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of the prompt"
    },
    "schema": {
      "type": "object",
      "description": "JSON schema for prompt parameters"
    },
    "template": {
      "type": "string",
      "description": "Prompt template with parameter placeholders"
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "input": {"type": "object"},
          "output": {"type": "string"}
        }
      }
    }
  },
  "required": ["name", "description", "version", "schema", "template"]
}
