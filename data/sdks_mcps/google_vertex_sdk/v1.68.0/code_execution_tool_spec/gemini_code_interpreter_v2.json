{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Gemini Code Interpreter V2",
  "description": "Code execution tool specification for Gemini 1.5 Pro with secure sandbox execution",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "const": "code_interpreter"
    },
    "description": {
      "type": "string",
      "const": "Execute Python code in a secure sandbox environment with file I/O and visualization capabilities"
    },
    "parameters": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "Python code to execute. Can include data analysis, visualization, file processing, and API calls",
          "minLength": 1,
          "maxLength": 50000
        },
        "execution_mode": {
          "type": "string",
          "enum": ["analysis", "visualization", "file_processing", "api_call", "data_transformation"],
          "description": "Type of code execution for resource allocation",
          "default": "analysis"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 300,
          "default": 60,
          "description": "Maximum execution time in seconds"
        },
        "memory_limit_mb": {
          "type": "integer",
          "minimum": 128,
          "maximum": 8192,
          "default": 1024,
          "description": "Memory limit in MB"
        },
        "allowed_libraries": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "pandas", "numpy", "matplotlib", "seaborn", "plotly", "scipy", "scikit-learn",
              "requests", "beautifulsoup4", "lxml", "openpyxl", "csv", "json", "yaml",
              "pillow", "opencv-python", "nltk", "spacy", "textblob", "wordcloud",
              "sqlalchemy", "psycopg2", "pymongo", "redis", "elasticsearch",
              "boto3", "google-cloud-storage", "azure-storage-blob",
              "jupyter", "ipython", "sympy", "networkx", "geopandas"
            ]
          },
          "description": "Allowed Python libraries for execution",
          "default": ["pandas", "numpy", "matplotlib", "requests", "json"]
        },
        "file_operations": {
          "type": "object",
          "properties": {
            "input_files": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Filename for reference in code"
                  },
                  "content": {
                    "type": "string",
                    "description": "Base64 encoded file content"
                  },
                  "type": {
                    "type": "string",
                    "enum": ["csv", "json", "txt", "xlsx", "parquet", "png", "jpg", "pdf"],
                    "description": "File type for proper handling"
                  }
                },
                "required": ["name", "content", "type"]
              },
              "description": "Files to make available to the code"
            },
            "output_files": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["csv", "json", "xlsx", "parquet", "png", "jpg", "pdf", "html"]
              },
              "description": "Expected output file types to capture",
              "default": ["json", "png"]
            }
          }
        },
        "environment": {
          "type": "object",
          "properties": {
            "variables": {
              "type": "object",
              "description": "Environment variables for API keys and configuration"
            },
            "network_access": {
              "type": "boolean",
              "default": false,
              "description": "Allow network access for API calls"
            },
            "internet_access": {
              "type": "boolean", 
              "default": false,
              "description": "Allow unrestricted internet access"
            }
          }
        },
        "output_format": {
          "type": "string",
          "enum": ["text", "json", "dataframe", "plot", "file"],
          "description": "Preferred output format",
          "default": "json"
        },
        "capture_output": {
          "type": "object",
          "properties": {
            "stdout": {
              "type": "boolean",
              "default": true
            },
            "stderr": {
              "type": "boolean",
              "default": true
            },
            "return_value": {
              "type": "boolean",
              "default": true
            },
            "execution_time": {
              "type": "boolean",
              "default": true
            },
            "memory_usage": {
              "type": "boolean",
              "default": false
            }
          }
        }
      },
      "required": ["code"]
    }
  },
  "examples": [
    {
      "description": "Data analysis with pandas",
      "parameters": {
        "code": "import pandas as pd\nimport numpy as np\n\n# Create sample data\ndata = {\n    'name': ['Alice', 'Bob', 'Charlie', 'Diana'],\n    'age': [25, 30, 35, 28],\n    'salary': [50000, 60000, 70000, 55000]\n}\ndf = pd.DataFrame(data)\n\n# Calculate statistics\nstats = {\n    'mean_age': df['age'].mean(),\n    'mean_salary': df['salary'].mean(),\n    'correlation': df['age'].corr(df['salary'])\n}\n\nprint(stats)",
        "execution_mode": "analysis",
        "allowed_libraries": ["pandas", "numpy"],
        "output_format": "json"
      }
    },
    {
      "description": "Generate visualization",
      "parameters": {
        "code": "import matplotlib.pyplot as plt\nimport numpy as np\n\n# Generate data\nx = np.linspace(0, 10, 100)\ny1 = np.sin(x)\ny2 = np.cos(x)\n\n# Create plot\nplt.figure(figsize=(10, 6))\nplt.plot(x, y1, label='sin(x)', linewidth=2)\nplt.plot(x, y2, label='cos(x)', linewidth=2)\nplt.xlabel('x')\nplt.ylabel('y')\nplt.title('Trigonometric Functions')\nplt.legend()\nplt.grid(True, alpha=0.3)\nplt.tight_layout()\n\n# Save plot\nplt.savefig('trig_functions.png', dpi=300, bbox_inches='tight')\nprint('Plot saved as trig_functions.png')",
        "execution_mode": "visualization",
        "allowed_libraries": ["matplotlib", "numpy"],
        "output_files": ["png"]
      }
    },
    {
      "description": "API data processing",
      "parameters": {
        "code": "import requests\nimport pandas as pd\nfrom datetime import datetime\n\n# Fetch data from API\nresponse = requests.get('https://jsonplaceholder.typicode.com/posts')\nposts = response.json()\n\n# Convert to DataFrame\ndf = pd.DataFrame(posts)\n\n# Analysis\nresults = {\n    'total_posts': len(df),\n    'unique_users': df['userId'].nunique(),\n    'avg_title_length': df['title'].str.len().mean(),\n    'processed_at': datetime.now().isoformat()\n}\n\nprint(results)",
        "execution_mode": "api_call",
        "environment": {"network_access": true},
        "allowed_libraries": ["requests", "pandas"]
      }
    }
  ],
  "security_constraints": {
    "blocked_operations": [
      "os.system", "subprocess.call", "eval", "exec", "compile",
      "__import__", "open", "file", "input", "raw_input"
    ],
    "resource_limits": {
      "max_file_size_mb": 100,
      "max_memory_mb": 8192,
      "max_execution_time_seconds": 300
    },
    "allowed_domains": [
      "api.github.com", "api.openai.com", "api.anthropic.com",
      "jsonplaceholder.typicode.com", "api.linkedin.com", "api.twitter.com"
    ]
  },
  "response_schema": {
    "type": "object",
    "properties": {
      "success": {
        "type": "boolean",
        "description": "Whether code executed successfully"
      },
      "output": {
        "type": "string",
        "description": "Standard output from code execution"
      },
      "error": {
        "type": "string",
        "description": "Error message if execution failed"
      },
      "return_value": {
        "description": "Return value from last expression"
      },
      "execution_time_seconds": {
        "type": "number",
        "description": "Time taken to execute code"
      },
      "memory_used_mb": {
        "type": "number",
        "description": "Peak memory usage in MB"
      },
      "generated_files": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "content": {
              "type": "string",
              "description": "Base64 encoded file content"
            },
            "size_bytes": {
              "type": "integer"
            }
          }
        }
      }
    },
    "required": ["success"]
  }
}
