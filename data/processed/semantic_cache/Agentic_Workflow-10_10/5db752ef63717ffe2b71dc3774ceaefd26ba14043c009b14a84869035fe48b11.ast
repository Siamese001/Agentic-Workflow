      "name": "WorkflowState",
      "line_number": 62,
      "docstring": "Canonical workflow state.\n\nThis is the single source of truth for all cross-layer state.\n\nL4 is the *only* layer allowed to mutate instances of this model;\nother layers must work with copies or immutable views.",
      "imports": [],
      "dependencies": [
        "BaseModel"
      ],
      "responsibility_level": "L5",
      "children": []
