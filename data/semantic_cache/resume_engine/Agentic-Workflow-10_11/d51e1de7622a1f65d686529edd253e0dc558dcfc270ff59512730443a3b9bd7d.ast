    {
      "node_type": "function",
      "name": "evaluate_patch",
      "line_number": 1316,
      "docstring": "Evaluate a single state patch (typically final_state_patch from L3/L4)\nagainst a GoldenExpectation.\n\nThe `state_patch` is expected to be shaped approximately like:\n\n    {\n        \"strategy_text\": str | None,\n        \"rag_evidence\": [ { \"text\": ..., \"score\": ..., \"source\": ... }, ... ],\n        \"drafted_sections\": [ { \"title\": ..., \"text\": ..., ... }, ... ],\n        \"qa_findings\": [ { \"id\": ..., \"passed\": bool, ... }, ... ],\n        \"safety_findings\": [ { \"id\": ..., \"category\": ..., \"blocking\": bool, ... }, ... ],\n        \"correction_loop_state\": {\n            \"iteration\": int,\n            \"max_iterations\": int,\n            \"surfaces_triggered\": [...],\n            \"last_signal\": str | None,\n            \"terminated_reason\": str | None,\n        },\n        \"safety_passed\": bool,\n        \"telemetry_summary\": ...,\n        \"cost_snapshot\": ...,\n    }\n\nExact keys are not required; the evaluator uses best\u2011effort extraction\nand will mark missing data as failing individual metrics with an\nexplanatory reason.",
      "imports": [],
      "dependencies": [
        "isinstance",
        "_metric_rag_and_hyde",
        "_as_mapping",
        "emit_golden_eval_event",
        "get_routing_trace",
        "CostSnapshot",
        "_metric_sections",
        "_metric_safety",
        "_metric_qa",
        "_metric_telemetry_and_cost",
        "_metric_field_expectations",
        "str",
        "_dotted_get",
        "_metric_rrf_and_council",
        "_summarise_resilience_events",
        "_metric_correction_loop"
      ],
      "responsibility_level": "L5",
      "children": []
    },
    {
      "node_type": "function",
      "name": "load_expectations",
      "line_number": 1440,
      "docstring": "Load GoldenExpectation objects from a JSON file.\n\nSupported shapes:\n\n    1) JSON array of expectation objects:\n        [\n          { \"scenario_id\": \"...\", ... },\n          { \"scenario_id\": \"...\", ... }\n        ]\n\n    2) JSON object mapping scenario_id \u2192 expectation object:\n        {\n          \"scenario_a\": { \"required_sections\": [...], ... },\n          \"scenario_b\": { ... }\n        }\n\nIn the second form the scenario_id key will be injected into the\nexpectation object if missing.",
      "imports": [],
      "dependencies": [
        "dict",
        "isinstance",
        "ValueError",
        "str",
        "Path"
      ],
      "responsibility_level": "L5",
      "children": []
    },
