    {
      "node_type": "class",
      "name": "PromptInstance",
      "line_number": 81,
      "docstring": "Concrete prompt ready for LLM invocation in resume generation.\n\nEnsures structured prompt delivery for consistent resume\nimprovement and job alignment.",
      "imports": [],
      "dependencies": [],
      "responsibility_level": "L5",
