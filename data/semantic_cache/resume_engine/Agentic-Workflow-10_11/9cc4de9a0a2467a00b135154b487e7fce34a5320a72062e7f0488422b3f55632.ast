    },
    {
      "node_type": "function",
      "name": "_extract_acl_metadata",
      "line_number": 107,
      "docstring": "Extract ACL metadata from a PromptDefinition.\n\nExpected shape (stored in defn.metadata[\"acl\"]):\n\n    {\n        \"layers\": [\"L1\", \"L2\", ...],\n        \"agents\": [\"strategy\", \"rag\", \"drafting\", \"qa\", \"safety\"],\n        \"model_tiers\": [\"cheap\", \"balanced\", \"premium\"],\n    }\n\nAll fields are optional; missing fields are treated as \"no restriction\".",
      "imports": [],
      "dependencies": [
        "list"
      ],
      "responsibility_level": "L5",
      "children": []
    },
    {
      "node_type": "function",
      "name": "_get_prompt_definition",
      "line_number": 138,
      "docstring": "Retrieve a PromptDefinition from the central registry.\n\nThis is a thin wrapper around ``PROMPT_REGISTRY`` / ``get_prompt``\nso that all lookups live in one place.",
      "imports": [],
      "dependencies": [
        "KeyError",
        "get_prompt"
      ],
      "responsibility_level": "L5",
      "children": []
    },
    {
      "node_type": "function",
      "name": "_get_template_text",
      "line_number": 154,
      "docstring": "Return the base template text for a PromptDefinition.\n\nIf the definition carries a CMS schema under metadata[\"cms_schema\"], we\ncompile it via the Prompt CMS; otherwise we fall back to defn.text.",
      "imports": [],
      "dependencies": [
        "validate_prompt",
        "compile_prompt",
        "isinstance"
      ],
      "responsibility_level": "L5",
      "children": []
    },
    {
      "node_type": "function",
      "name": "_check_prompt_acl",
      "line_number": 177,
      "docstring": "Enforce both registry-level ACLs and per-prompt ACL metadata.\n\nThis function is intentionally side-effect free; it either returns\nor raises PermissionError.",
      "imports": [],
      "dependencies": [
        "PermissionError",
        "_get_prompt_definition",
        "isinstance",
        "_extract_acl_metadata"
      ],
      "responsibility_level": "L5",
      "children": []
    },
    {
      "node_type": "function",
      "name": "_render_envelope_with_template",
      "line_number": 223,
      "docstring": "Merge a PromptEnvelope with the registry template into a final string.\n\nDefault templates follow the pattern:\n\n    \"## CONTEXT\\n\\n## INSTRUCTIONS\\n\\n## OUTPUT_FORMAT\\n\"\n\nThis helper injects the envelope contents into those anchors while\nalso adding the richer sections (Framing, Reasoning, Safety).",
      "imports": [],
      "dependencies": [
        "_get_template_text"
      ],
      "responsibility_level": "L5",
      "children": []
    },
