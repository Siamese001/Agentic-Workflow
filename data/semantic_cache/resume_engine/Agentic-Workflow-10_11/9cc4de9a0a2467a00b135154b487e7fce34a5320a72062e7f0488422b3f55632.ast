    },
    {
      "node_type": "function",
      "name": "build_strategy_prompt",
      "line_number": 461,
      "docstring": "Create the instructions for planning how to tailor the resume.\n\nThis prompt tells the strategy agent to read the job and resume, propose\nseveral options for how to position the candidate, and pick the most\neffective one. The goal is to ensure later steps work from a clear plan\nthat reflects the role's expectations and the candidate's strengths.",
      "imports": [],
      "dependencies": [
        "PromptEnvelope",
        "_make_prompt_instance",
        "get_prompt_version",
        "compile_prompt",
        "_summarize_job_and_resume"
      ],
      "responsibility_level": "L5",
      "children": []
    },
    {
      "node_type": "function",
      "name": "build_rag_prompt",
      "line_number": 528,
      "docstring": "Create the instructions for reasoning over retrieved evidence.\n\nThis prompt guides the agent to review the evidence gathered about the job\nand candidate, highlight the most relevant pieces, and explain how they\nshould influence the resume rewrite. It keeps drafting grounded in real\nsignals instead of generic assumptions.",
      "imports": [],
      "dependencies": [
        "PromptEnvelope",
        "_format_evidence",
        "list",
        "_make_prompt_instance",
        "_build_curated_context_for_rag",
        "_summarize_job_and_resume"
      ],
      "responsibility_level": "L5",
      "children": []
    },
    {
      "node_type": "function",
      "name": "build_hyde_prompt",
      "line_number": 595,
      "docstring": "Create the instructions for imagining an ideal candidate profile.\n\nThis prompt asks the agent to write a short description of a \"perfect\"\ncandidate for the role, based on the job and resume. Retrieval uses this\ntext as a semantic query to pull in better-matching examples and\nreferences, which in turn supports more targeted resume improvements.",
      "imports": [],
      "dependencies": [
        "PromptEnvelope",
        "_make_prompt_instance",
        "_summarize_job_and_resume"
      ],
      "responsibility_level": "L5",
      "children": []
    },
    {
      "node_type": "function",
      "name": "build_drafting_prompt",
      "line_number": 647,
      "docstring": "Create the instructions for writing or rewriting resume sections.\n\nThis prompt explains to the drafting agent what sections to produce, what\nstrategy to follow, and which evidence to lean on. It emphasizes impact,\nclarity, and alignment to the job so that the resulting resume feels\ntailored and recruiter-friendly rather than generic.",
      "imports": [],
      "dependencies": [
        "PromptEnvelope",
        "_make_prompt_instance",
        "_summarize_job_and_resume",
        "_build_curated_context_for_drafting"
      ],
      "responsibility_level": "L5",
      "children": []
    },
    {
      "node_type": "function",
      "name": "build_qa_prompt",
      "line_number": 706,
      "docstring": "Create the instructions for reviewing the drafted resume.\n\nThis prompt tells the QA agent to check the draft against the job\ndescription and evidence, surface issues such as unsupported claims or\nmissing requirements, and suggest concrete fixes. It helps keep the final\nresume accurate, clear, and focused on what employers care about.",
      "imports": [],
      "dependencies": [
        "PromptEnvelope",
        "_make_prompt_instance",
        "_summarize_job_and_resume"
      ],
      "responsibility_level": "L5",
      "children": []
    },
    {
      "node_type": "function",
      "name": "build_safety_prompt",
      "line_number": 762,
      "docstring": "Create the instructions for the final safety and policy review.\n\nThis prompt asks the safety agent to look for content that might violate\npolicies, privacy expectations, or fairness standards, and to recommend\nany required edits or blocks. It is a key part of ensuring resumes are not\nonly compelling but also safe and appropriate to share.",
      "imports": [],
      "dependencies": [
        "PromptEnvelope",
        "_make_prompt_instance",
        "_summarize_job_and_resume"
      ],
      "responsibility_level": "L5",
      "children": []
    },
    {
      "node_type": "function",
      "name": "to_sections",
      "line_number": 58,
      "docstring": "Returns the envelope sections as an ordered mapping so downstream tools can render and log exactly what the agent saw.",
      "imports": [],
      "dependencies": [],
      "responsibility_level": "L5",
      "children": []
    }
