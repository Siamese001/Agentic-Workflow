      "node_type": "class",
      "name": "MetaProfileSnapshot",
      "line_number": 80,
      "docstring": "Read-only snapshot of MetaProfile used by L1 and routing.\n\nThis is a *view* over the internal MetaProfile plus derived\nprofile inference fields. It must remain backwards compatible\nwith existing Phase-3 consumers (L1, routing, cognitive agents).",
      "imports": [],
      "dependencies": [],
      "responsibility_level": "L5",
      "children": []
