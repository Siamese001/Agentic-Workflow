      "node_type": "class",
      "name": "PredictiveCacheManager",
      "line_number": 309,
      "docstring": "Lightweight in-memory predictive/semantic cache.\n\nIntended use:\n    \u2022 Cache expensive L2 operations (RAG, cognitive agent calls).\n    \u2022 Keyed by (domain, plan, context signature).\n\nBehavior:\n    \u2022 In-memory only.\n    \u2022 Evicts oldest entry when capacity exceeded.",
      "imports": [],
      "dependencies": [],
      "responsibility_level": "L5",
      "children": []
    },
