    {
      "node_type": "class",
      "name": "FieldExpectation",
      "line_number": 185,
      "docstring": "Generic field\u2011level expectation expressed as a dotted path into\nthe state patch.\n\nExample JSON shape (for load_expectations):\n\n    {\n      \"path\": \"config.knobs.hyde_enabled\",\n      \"comparator\": \"eq\",\n      \"expected\": true,\n      \"weight\": 2.0,\n      \"hard_fail\": true,\n      \"description\": \"HYDE enabled in knob config\"\n    }",
      "imports": [],
      "dependencies": [
        "ModelLike"
      ],
      "responsibility_level": "L5",
      "children": []
    },
    {
      "node_type": "class",
      "name": "GoldenExpectation",
      "line_number": 224,
      "docstring": "Declarative description of what a single workflow run is expected\nto look like under a specific golden scenario.\n\nThe expectation is intentionally high\u2011level and tolerant of minor\nimplementation details; it focuses on invariants that should hold\nif the Phase\u20113 capabilities (G1\u2013G37) are wired correctly.",
      "imports": [],
      "dependencies": [
        "ModelLike"
      ],
      "responsibility_level": "L5",
      "children": []
    },
    {
      "node_type": "class",
      "name": "ScenarioKnobs",
      "line_number": 280,
      "docstring": "Minimal, string\u2011only description of Phase\u20113 knob settings for a\nscenario.  This mirrors Phase3Knobs from main_v10_10 but avoids\nimporting runtime modules.\n\nThese values are intended to be passed directly into\nmain_v10_10.run_workflow by simulation.py.",
      "imports": [],
      "dependencies": [
        "ModelLike"
      ],
      "responsibility_level": "L5",
      "children": []
