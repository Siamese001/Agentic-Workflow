      "line_number": 337,
      "docstring": "QA agent that evaluates drafted content and performs RAG reasoning.\n\nOutputs:\n    \u2022 QAResult with structured QAFinding items.\n    \u2022 RAG reasoning text for Phase-3 reasoning stage.",
      "imports": [],
      "dependencies": [
        "LLMBaseAgent"
      ],
