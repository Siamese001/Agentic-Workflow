      "name": "RoutingBias",
      "line_number": 45,
      "docstring": "Routing-level preferences for L2/L5.\n\nFields:\n    prefer_fast:             prefer cheaper/faster models\n    prefer_robust_retrieval: bias toward more robust RAG settings\n    prefer_long_context:     bias toward long-context models",
      "imports": [],
      "dependencies": [],
      "responsibility_level": "L5",
      "children": []
    },
    {
      "node_type": "class",
      "name": "PlanningBias",
      "line_number": 60,
      "docstring": "Planning (L1 reasoning) preferences.\n\nFields:\n    conservative:           reduce branching / depth\n    exploratory:            allow more branches / alternatives\n    deterministic_recovery: bias toward structured recovery plans",
      "imports": [],
      "dependencies": [],
      "responsibility_level": "L5",
      "children": []
    },
    {
      "node_type": "class",
      "name": "QaBias",
