    {
      "node_type": "function",
      "name": "fuse_ranked_groups",
      "line_number": 104,
      "docstring": "Fuse multiple pre-ranked lists into a single deterministic list.\n\nAlgorithm:\n    1. Flatten\n    2. Deduplicate by (query, evidence)\n    3. Sort by minimal rank across groups\n    4. Secondary sort by alphabetical evidence\n    5. Re-assign ranks\n\nAll behavior purely deterministic.",
      "imports": [],
      "dependencies": [
