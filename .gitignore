# ##############################################################################
# .gitignore — FINAL 2025: SOVEREIGN REPOSITORY PROTECTION
# ##############################################################################

# NEVER commit large or ephemeral data
data/cache/
data/tmp/
data/**/*.bin
archives/
*.zip
*.tar.gz
*.lfs
*.DS_Store

# [NEURAL LINK] SENSITIVE DATA
# Mandatory fail-fast protection: never commit the neural link credentials
.env

# Python artifacts
__pycache__/
*.pyc
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# IDE and OS noise
.vscode/
.idea/
Thumbs.db

# Logs and outputs
*.log
outputs/
logs/                # Unauthorized root folder - strictly ignored
cache/               # Unauthorized root folder - strictly ignored

# Temp extraction folders
temp_*/              # Automated sprawl - strictly ignored

# [L6 PHYSICS] ARCHITECTURAL NOISE
0[0-9]_*/            # Numbered migration folders (Forbidden Root Folders)
core/                # Unauthorized sprawl directory
