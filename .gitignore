*.archived

data/cache/
data/tmp/
data/**/*.bin
# [REFACTOR 2026-02-05] Healing backups folder (replaces archives/)
.healing_backups/
*.zip
*.tar.gz
*.lfs
*.DS_Store

# [NEURAL LINK] SENSITIVE DATA
