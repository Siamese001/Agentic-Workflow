# Now using .healing_backups/ as the canonical backup location
.sovereign_healing_backup/

# [L6 PHYSICS] ARCHITECTURAL NOISE
0[0-9]_*/            # Numbered migration folders (Forbidden Root Folders)
core/                # Unauthorized sprawl directory

# Test coverage output
coverage_html/

# Guardian test artifacts
guardian_report.txt
.test_artifacts/

# Ephemeral governance scope snapshots (COMMIT_SCOPE_SNAPSHOTS=false by default)
