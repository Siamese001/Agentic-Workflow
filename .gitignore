artifacts/healing/healing_events.jsonl
# Runtime CI lane gate result (timing changes on every test run)
artifacts/adg_ci_lane_gate_result.json
# ADG artifacts (all except README.md - store on Google Drive, not GitHub)
artifacts/adg/*.sqlite
artifacts/adg/*.json
artifacts/adg/*.zip
artifacts/adg/*.tar.gz
artifacts/adg/cache/
# Allow README.md to be tracked
!artifacts/adg/README.md
# ADG LATEST symlinks/copies (auto-generated, point to timestamped artifacts)
artifacts/adg/adg_LATEST*.sqlite
artifacts/adg/adg_LATEST*.json
# SQLite WAL/SHM temp files (never commit these)
*.sqlite-shm
*.sqlite-wal
# ADG archive directory (compressed backups - local only)
artifacts/adg/_archive/

# ADG determinism manifests (small verification files)
!artifacts/adg/*_determinism_manifest.json

# Memory knowledge graph (SQLite DB — local only, rebuilt via mem_import_adg_context)
artifacts/memory/
