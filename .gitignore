*.pyc
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Virtual environments
.venv/
.venv_gate/
.venv_final/
.venv_verify/
venv/
env/

# Build artifacts
*.egg-info/

# IDE and OS noise
.vscode/
.idea/
Thumbs.db

# Logs and outputs
*.log
outputs/
logs/                # Unauthorized root folder - strictly ignored
cache/               # Unauthorized root folder - strictly ignored

# Temp extraction folders
temp_*/              # Automated sprawl - strictly ignored

