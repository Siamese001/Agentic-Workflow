# .gitignore — FINAL 2025
# NEVER commit large or ephemeral data
data/cache/
data/tmp/
data/**/*.bin
data/**/*.npy
data/**/*.npz
data/**/*.parquet
*.lfs
*.DS_Store

# Agent memory (L3 Knowledge Graph)
.memory/

# Python artifacts
__pycache__/
*.pyc
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# IDE and OS noise
.vscode/
.idea/
Thumbs.db

# Logs and outputs
*.log
outputs/
logs/

# Temp extraction folders
temp_*/
