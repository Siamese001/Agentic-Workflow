# NEVER commit large or ephemeral data

# [CANON VALIDATOR] Sovereign purge artifacts — do not remove
# Auto-generated on 2025-12-29 by canon validator
*.archived

# ChromaDB artifacts (large vector database files)
artifacts/chromadb/
# ChromaDB metadata (not the full 2.9GB)
!artifacts/chromadb/collection_metadata.json
!artifacts/chromadb/seed_urls_snapshot.txt
*.sqlite3
*.bin
*.pickle

data/cache/
data/tmp/
data/**/*.bin
# [REFACTOR 2026-02-05] Healing backups folder (replaces archives/)
archives/
