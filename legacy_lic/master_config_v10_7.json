{
  "schema_version": "master_config_v10.7",
  "description": "v10.7: Implements 15 new enhancements including Semantic Caching, Idempotency Validation, Concurrent Node Execution, Constitutional AI, and Agent-to-Agent (A2A) Comms.",
  "version_notes": {
    "v10_6_changes": [
      "SCHEMA_VERSION: Updated to v10.6",
      "FILE_PATHS: All logs/dbs updated to v10_7 versions.",
      "FIX_5 (Concurrency): Architecture now supports concurrent node execution.",
      "FIX_7 (Dynamic Tooling): Added ToolRegistry config (see meta_loop_config).",
      "FIX_8 (UI Tools): Architecture supports UI control tools (logging only).",
      "FIX_9 (Streaming): Architecture supports real-time streaming (via main).",
      "FIX_10 (A2A Comms): Architecture supports A2A messaging via state.",
      "FIX_13 (Semantic Caching): Added 'enable_semantic_caching' and 'semantic_cache_similarity_threshold' to caching_config.",
      "FIX_14 (Smarter Pruning): Added 'summarizer_model' for agentic context pruning.",
      "FIX_15 (Cost/Latency Routing): Added 'max_complex_model_latency_ms' to performance_config.",
      "FIX_17 (Reflection): Architecture updated for metacognitive reflection in agents.",
      "FIX_19 (Goal-State): Architecture supports global goal state injection.",
      "FIX_20 (Cognitive Mode): Prompts refactored to use Cognitive Modes (e.g., 'MODE: ANALYTICAL').",
      "FIX_24 (Failure Anticipation): Architecture injects top failures into prompts.",
      "FIX_25 (Backpressure): Added 'max_batch_queue_size' to batch_config.",
      "FIX_29 (Idempotency): Added 'enable_idempotency_validation' and 'idempotency_validation_sample_rate' to caching_config.",
      "FIX_30 (Constitutional AI): Added 'enable_constitutional_review' and 'constitutional_review_model'."
    ],
    "v10_5_changes": [
      "Inherits all v10.5 features: Dynamic Model Routing, Tool Caching, Node Timeouts, Tool Generation, Agent Metrics, Self-Consistency Voting, Curriculum Prompting, PI Detection, and Semantic Validation."
    ],
    "v10_7_changes": [
      "SCHEMA_VERSION: Updated to v10.7",
      "MCP_WRAPPER: Added wrap_mcp capability with configurable client registry.",
      "MCP_DEFAULT: MCP wrapping enabled by default for orchestration and tools."
    ]
  },
  "logging_config": {
    "log_level": "INFO",
    "debug_log_level": "DEBUG",
    "log_file": "./logs/workflow_v10_7.log",
    "metrics_log_path": "./logs/metrics_v10_7.jsonl",
    "log_format": "json",
    "correlation_ids": true
  },
  "redis_config": {
    "host": "localhost",
    "port": 6379,
    "db": 0,
    "description": "Redis for LangGraph checkpoints, LLM caching, and Tool caching"
  },
  "chromadb_config": {
    "host": "localhost",
    "port": 8000,
    "use_http_client": false,
    "persistent_path": "./chroma_db_v10_7",
    "default_collection_name": "resume_embeddings_v10_7",
    "semantic_cache_collection": "llm_semantic_cache_v10_7",
    "description": "v10.6: ChromaDB for RAG and Semantic LLM Caching"
  },
  "caching_config": {
    "enable_llm_caching": true,
    "enable_tool_caching": true,
    "cache_ttl_seconds": 3600,
    "cache_db": 1,
    "enable_semantic_caching": true,
    "semantic_cache_similarity_threshold": 0.95,
    "enable_idempotency_validation": true,
    "idempotency_validation_sample_rate": 0.1
  },
  "performance_config": {
    "enable_async_llm": true,
    "max_concurrent_llm_calls": 10,
    "llm_timeout_seconds": 30,
    "workflow_node_timeout_seconds": 60,
    "default_token_limit": 8192,
    "max_complex_model_latency_ms": 15000
  },
  "cost_config": {
    "cost_ceiling_per_workflow": 5.0,
    "enable_cost_tracking": true
  },
  "batch_config": {
    "max_parallel_workers": 4,
    "enable_circuit_breaker": true,
    "circuit_breaker_failure_threshold": 3,
    "max_batch_queue_size": 1000
  },
  "meta_loop_config": {
    "enable_meta_learning": true,
    "max_meta_replan_loops": 3,
    "feedback_log_path": "./logs/feedback_log.jsonl",
