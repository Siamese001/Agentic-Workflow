    "message_type_router": {
      "router_execution_point": "K.1 (Message Type) — executes routing, logs audit payload, and writes selected message_type to context for downstream K.x.",
      "inputs_required": ["name", "title", "about", "profile_url"],
      "features": [
        "seniority_cues",
        "org_level_in_title",
        "scope_markers",
        "about_signals",
        "geo_signals",
        "industry_terms",
        "function_terms",
        "company_size_hint"
      ],
      "weights": {
        "boardroom_fit": 0.45,
        "exec_fit": 0.3,
        "role_fit": 0.2,
        "other": 0.05
      },
      "thresholds": {
        "c_level_min": 0.75,
        "executive_min": 0.6,
        "role_fit_min": 0.55
      },
      "tie_breakers": [
        "prefer boardroom_fit",
        "else exec_fit",
        "else highest role_fit with strongest company_size_hint"
      ],
      "mapping": [
        { "if": "boardroom_fit>=c_level_min", "route": "C_LEVEL" },
        { "elif": "exec_fit>=executive_min", "route": "EXECUTIVE" },
        { "elif": "role_fit>=role_fit_min and 'TA' in function_terms", "route": "SENIOR_TA" },
        { "elif": "role_fit>=role_fit_min and 'Recruiter' in function_terms", "route": "RECRUITER" },
        { "else": "SHORT_NEW" }
      ],
      "smoke_tests": [
        "Router blocks if any required LinkedIn field is missing (inputs_required).",
        "Router returns one of the five message_types.",
        "Scores, feature_contributions, and chosen_rule are logged to audit for explainability."
      ],
      "runtime_notes": "Router must load Section 3 defaults, apply Section 4 K.1 overrides (if present), run feature extraction, compute scores, apply mapping + tie-breakers, emit audit payload and chosen route."
    },

