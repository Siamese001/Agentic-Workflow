{
  "mcpServers": {
    "GitKraken": {
      "command": "${GITKRAKEN_GK_PATH}",
      "args": ["mcp"]
    },
    "adg_sqlite": {
      "url": "http://127.0.0.1:8765/mcp"
    },
    "deepwiki": {
      "url": "https://mcp.deepwiki.com/mcp"
    },
    "filesystem": {
      "command": "node",
      "args": [
        "${env:AGENTIC_REPO_ROOT}/.codex/governance/scripts/filesystem_mcp_launcher.js",
        "${env:AGENTIC_REPO_ROOT}"
      ],
      "_startup": "Repo-root-only filesystem MCP launcher (Rule #0); resolves the server package dynamically and never expands scope beyond the repo root."
    },
    "memory": {
      "url": "http://127.0.0.1:8766/mcp"
    },
    "vector_db": {
      "command": "python",
      "args": ["-u", "${AGENTIC_REPO_ROOT}/tools/mcp/vector_db_server.py"],
      "env": {
        "PYTHONPATH": "${AGENTIC_REPO_ROOT}",
        "VECTOR_DB_CHROMA_PATH": "${AGENTIC_REPO_ROOT}/data/cache/chromadb",
        "VECTOR_DB_EMBEDDING_MODEL": "BAAI/bge-m3",
        "VECTOR_DB_DEVICE": "cuda",
        "EMBEDDING_DEVICE": "cuda",
        "VECTOR_DB_ALLOW_MODEL_DOWNLOAD": "0",
        "VECTOR_DB_ENABLE_MODEL_PREWARM": "1",
        "VECTOR_DB_MODEL_LOAD_TIMEOUT": "75",
        "HF_HUB_OFFLINE": "1",
        "VECTOR_DB_ENCODE_QUEUE_WAIT_TIMEOUT": "90",
        "VECTOR_DB_SEARCH_PER_COLLECTION_TIMEOUT": "15",
        "MCP_MAX_THREADPOOL_WORKERS": "2"
      }
    },
    "notion": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@notionhq/notion-mcp-server"],
      "env": {
        "NOTION_TOKEN": "${NOTION_TOKEN}"
      }
    },
    "context7": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@upstash/context7-mcp"]
    },
    "playwright": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@playwright/mcp",
        "--output-dir",
        "artifacts/mcp/playwright",
        "--output-mode",
        "file"
      ]
    }
  }
}
