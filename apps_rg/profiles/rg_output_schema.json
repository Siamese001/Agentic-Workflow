{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RG Output Schema",
  "description": "Static output constraints for resume generation. Declarative only — no runtime behavior.",
  "type": "object",
  
  "profile_metadata": {
    "profile_id": "rg_output_schema_v1",
    "profile_type": "output_constraints",
    "domain": "resume_generation",
    "advisory_only": true
  },

  "constraints": {
    "bullets_per_section": {
      "description": "Declarative constraints for bullet count per section",
      "advisory": true,
      "min": 3,
      "max": 8
    },
    "section_word_limits": {
      "description": "Declarative word count limits per section type",
      "advisory": true,
      "limits": {
        "summary": 100,
        "experience_bullet": 30,
        "skills": 50
      }
    }
  },

  "report_structure": {
    "description": "QA report section ordering (advisory)",
    "required_sections": [
      "executive_summary",
      "quality_metrics",
      "validation_results",
      "recommendations"
    ],
    "optional_sections": [
      "improvement_suggestions",
      "comparison_analysis"
    ]
  },

  "formatting_preferences": {
    "description": "Output formatting declarative preferences",
    "advisory": true,
    "bullet_style": "action_verb_led",
    "metric_inclusion": "encouraged",
    "date_format": "MM/YYYY"
  },

  "note": "All constraints are advisory per AG-RGGOV-6. Core may adjust based on context."
}
