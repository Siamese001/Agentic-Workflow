{
  "clerk_extraction": {
    "metrics_patterns": [
      "\\$\\d+\\.?\\d*[MBK]\\+?",
      "\\d+\\.?\\d*%",
      "\\d{1,3}(?:,\\d{3})+"
    ],
    "min_bullets_per_section": 3,
    "max_bullets_per_section": 8
  },
  "enrichment": {
    "forbidden_phrases": [
      "responsible for",
      "duties included",
      "helped with",
      "assisted with",
      "worked on"
    ],
    "duplicate_threshold": 0.85,
    "power_verbs": [
      "achieved", "delivered", "led", "drove", "established",
      "transformed", "accelerated", "optimized", "pioneered", "spearheaded"
    ]
  },
  "generation": {
    "base_temperatures": {
      "summary": 0.7,
      "experience": 0.5,
      "skills": 0.3
    },
    "max_section_words": {
      "summary": 100,
      "experience_bullet": 30,
      "skills": 50
    },
    "n_candidates": 3
  },
  "validation": {
    "severity_threshold": "WARNING",
    "rule_categories": [
      "grammar",
      "formatting",
      "content_quality",
      "ats_compatibility"
    ],
    "min_quality_score": 0.7
  },
  "gate_decision": {
    "factual_failure_rules": [
      "hallucination_detected",
      "source_mismatch",
      "date_inconsistency"
    ],
    "max_factual_loops": 3,
    "max_creative_retries": 5,
    "pass_threshold": 0.8
  },
  "refinement": {
    "optimization_targets": [
      "keyword_density",
      "action_verb_strength",
      "quantification_rate"
    ],
    "max_iterations": 3
  },
  "qa_report": {
    "report_sections": [
      "executive_summary",
      "quality_metrics",
      "validation_results",
      "recommendations"
    ],
    "output_directory": "logs/rg_reports",
    "scoring_weights": {
      "content_quality": 0.3,
      "ats_compatibility": 0.25,
      "keyword_match": 0.25,
      "formatting": 0.2
    }
  },
  "orchestrator": {
    "global_step_limit": 20,
    "max_retry_iterations": 5,
    "checkpoint_enabled": true,
    "trace_persistence": true
  }
}
