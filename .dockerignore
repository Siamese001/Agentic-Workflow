# .dockerignore - Exclude files from Docker build context
# Reduces attack surface and prevents sensitive data leakage

# Version Control
.git
.gitignore
.gitattributes
.gitmodules

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
env/
ENV/
.venv/
.env/

# IDE and Editor Files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Test Files and Coverage
.coverage
.pytest_cache/
.tox/
htmlcov/
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# Documentation
docs/_build/
*.md
!README.md

# Logs and Temporary Files
*.log
*.tmp
*.temp
logs/
tmp/
temp/

# Secrets and Configuration
.env
.env.local
.env.development
.env.test
.env.production
secrets/
*.key
*.pem
*.crt
*.p12
passwords.txt

# Cache and Data
.cache/
data/
datasets/
models/
*.pkl
*.joblib
*.h5
*.bin

# Build Artifacts
build/
dist/
target/
node_modules/

# Docker Files (prevent recursion)
Dockerfile*
docker-compose*.yml
.dockerignore

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml
Jenkinsfile

# Archives and Backup
*.tar.gz
*.zip
*.rar
*.7z
archives/
backup/

# OS Generated Files
.DS_Store?
ehthumbs.db
Icon?
Thumbs.db

# Application Specific
workspace/
reports/
outputs/
results/
*.sqlite
*.db

# Test Suites
tests/
!tests/apps_cv/
test_*.py
*_test.py

# Development Tools
.pre-commit-config.yaml
pyproject.toml
setup.cfg
tox.ini

# Monitoring and Observability
.grafana/
.prometheus/
jaeger/
otel-collector-config.yaml

# Local Development
local/
dev/
experimental/
