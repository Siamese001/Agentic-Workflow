# .dockerignore - RECOVERY VERSION
.git/
__pycache__/
*.pyc
venv/
.venv/
logs/

# BLOCK ALL FIRST, THEN WHITELIST
*

# WHITELIST CORE FILES
!/main.py
!/orchestrator.py
!/connection_manager.py
!/main_connectivity.py
!/agent_logic_connectivity.py
!/etl_pipeline_connectivity.py
!/requirements.txt
!/requirements-test.txt
!/pyproject.toml
!/entrypoint.sh

# WHITELIST CORE DIRECTORIES (Essential for 50 Keys)
!/app/
!/mcp/
!/apps_rg/
