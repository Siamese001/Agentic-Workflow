{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentic-workflow.local/schemas/apps_e2e_static_l3_dag_proof.schema.json",
  "title": "AppStaticL3DagProof",
  "description": "Static L3 DAG proof for one app. Emitted whether the DAG exists or not (fail-closed when missing).",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "proof_schema_version",
    "proof_kind",
    "app_name",
    "generated_at_utc",
    "present",
    "fail_closed",
    "fail_reasons",
    "scan_results"
  ],
  "properties": {
    "proof_schema_version": {"type": "string"},
    "proof_kind": {"type": "string", "const": "static_l3_dag_proof"},
    "app_name": {"type": "string", "pattern": "^apps_[a-z_]+$"},
    "generated_at_utc": {"type": "string", "pattern": "Z$"},
    "present": {"type": "boolean"},
    "fail_closed": {"type": "boolean"},
    "fail_reasons": {"type": "array", "items": {"type": "string"}},
    "dag_id": {"type": ["string", "null"]},
    "dag_name": {"type": ["string", "null"]},
    "dag_version": {"type": ["string", "null"]},
    "dag_file_path": {"type": ["string", "null"]},
    "dag_sha256": {"type": ["string", "null"]},
    "dag_registry_ref": {"type": ["string", "null"]},
    "dag_registry_sha256": {"type": ["string", "null"]},
    "route_ids": {"type": "array", "items": {"type": "string"}},
    "route_binding_refs": {"type": "array"},
    "node_count": {"type": ["integer", "null"]},
    "edge_count": {"type": ["integer", "null"]},
    "entry_nodes": {"type": "array"},
    "terminal_nodes": {"type": "array"},
    "node_ids": {"type": "array"},
    "edge_list": {"type": "array"},
    "max_depth": {"type": ["integer", "null"]},
    "has_cycle": {"type": ["boolean", "null"]},
    "all_nodes_have_owner": {"type": ["boolean", "null"]},
    "all_nodes_have_step_contract_schema": {"type": ["boolean", "null"]},
    "all_nodes_have_allowed_execution_surface": {"type": ["boolean", "null"]},
    "l3_no_execute_policy": {"type": ["boolean", "null"]},
    "l3_no_retrieve_policy": {"type": ["boolean", "null"]},
    "l3_no_prompt_assembly_policy": {"type": ["boolean", "null"]},
    "l3_no_l4_write_policy": {"type": ["boolean", "null"]},
    "edges_reference_existing_nodes": {"type": ["boolean", "null"]},
    "registry_binding_matches_dag": {"type": ["boolean", "null"]},
    "app_name_matches": {"type": ["boolean", "null"]},
    "scan_results": {
      "type": "object",
      "required": ["registries", "dag_directories"],
      "properties": {
        "registries": {"type": "array"},
        "dag_directories": {"type": "array"}
      }
    },
    "scan_method": {"type": "string"},
    "notes": {"type": "string"}
  }
}
