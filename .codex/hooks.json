{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$AGENTIC_REPO_ROOT/.codex/hooks/selected_avatar_guard.py\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$AGENTIC_REPO_ROOT/.codex/hooks/session_start_branch_guard.py\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$AGENTIC_REPO_ROOT/.codex/hooks/session-start.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$AGENTIC_REPO_ROOT/.codex/hooks/selected_avatar_guard.py\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$AGENTIC_REPO_ROOT/.codex/hooks/before_submit_prompt.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$AGENTIC_REPO_ROOT/.codex/hooks/selected_avatar_guard.py\""
          }
        ],
        "matcher": ".*"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$AGENTIC_REPO_ROOT/.codex/hooks/before_ask_user_question.py\""
          }
        ],
        "matcher": "AskUserQuestion|request_user_input|functions\\.request_user_input"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$AGENTIC_REPO_ROOT/.codex/hooks/before_file_edit_branch_guard.py\""
          }
        ],
        "matcher": "Edit|Write|MultiEdit"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$AGENTIC_REPO_ROOT/.codex/hooks/pre_write_plan_mint_gate.py\""
          }
        ],
        "matcher": "Edit|Write|MultiEdit"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$AGENTIC_REPO_ROOT/.codex/hooks/pre_write_north_star_gate.py\""
          }
        ],
        "matcher": "Edit|Write|MultiEdit"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$AGENTIC_REPO_ROOT/.codex/hooks/before_shell_execution.py\""
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$AGENTIC_REPO_ROOT/.codex/hooks/before_read_file.py\""
          }
        ],
        "matcher": "Read"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$AGENTIC_REPO_ROOT/.codex/hooks/before_grep.py\""
          }
        ],
        "matcher": "Grep"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$AGENTIC_REPO_ROOT/.codex/hooks/before_mcp_execution.py\""
          }
        ],
        "matcher": "mcp__.*"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$AGENTIC_REPO_ROOT/.codex/hooks/pre_workflow_fanout_gate.py\""
          }
        ],
        "matcher": "Workflow"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$AGENTIC_REPO_ROOT/.codex/hooks/after_file_edit.py\""
          }
        ],
        "matcher": "Edit|Write|MultiEdit|NotebookEdit"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$AGENTIC_REPO_ROOT/.codex/hooks/after_ask_user_question.py\""
          }
        ],
        "matcher": "AskUserQuestion|request_user_input|functions\\.request_user_input"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$AGENTIC_REPO_ROOT/.codex/hooks/stop_task_audit.py\""
          },
          {
            "type": "command",
            "command": "python \"$AGENTIC_REPO_ROOT/.codex/hooks/stop_runtime_rca_gate.py\""
          },
          {
            "type": "command",
            "command": "python \"$AGENTIC_REPO_ROOT/.codex/hooks/after_agent_governance_dispatch.py\""
          }
        ]
      }
    ]
  }
}
