)
replace_once(
    "apps_rg/runtime/c0/c03_graph_expansion.py",
    '''    skill_pillar_by_id = _load_skill_pillar_index(repo_root)\n    from apps_rg.runtime.c0.c03_sqlite_graph_selection import (\n''',
    '''    skill_pillar_by_id = _load_skill_pillar_index(repo_root)\n    canonical_skill_ids = set(skill_pillar_by_id)\n    from apps_rg.runtime.c0.c03_sqlite_graph_selection import (\n''',
)
replace_once(
    "apps_rg/runtime/c0/c03_graph_expansion.py",
    '''            sqlite_selection_by_fact=sqlite_selection_by_fact,\n            sqlite_rejected_by_fact=sqlite_rejected_by_fact,\n        )\n''',
    '''            sqlite_selection_by_fact=sqlite_selection_by_fact,\n            sqlite_rejected_by_fact=sqlite_rejected_by_fact,\n            canonical_skill_ids=canonical_skill_ids,\n        )\n''',
)
replace_once(
    "apps_rg/runtime/c0/c03_graph_expansion.py",
    '''    if section_id == "executive_summary":\n''',
    '''    proof_atom_ids = {\n        str(atom.get("fact_id") or "")\n        for atom in atoms\n        if str(atom.get("proof_status") or "") == "proof_eligible"\n    }\n    missing_ranked_fact_ids = [\n        str(binding.get("fact_id") or "")\n        for binding in bindings\n        if str(binding.get("fact_id") or "") in proof_atom_ids\n        and binding.get("claim_support_allowed") is not True\n    ]\n    if missing_ranked_fact_ids:\n        raise C03GraphBindingError(\n            f"{section_id}: C0.3 fail-closed binding missing for proof facts "\n            + ",".join(sorted(set(missing_ranked_fact_ids)))\n        )\n\n    if section_id == "executive_summary":\n''',
)
replace_once(
    "apps_rg/runtime/c0/c03_graph_expansion.py",
    '''        "sqlite_selection_receipt": {\n''',
    '''        "selection_status": (\n            "PASS"\n            if not missing_ranked_fact_ids\n            else "BLOCKED"\n        ),\n        "missing_ranked_fact_ids": sorted(set(missing_ranked_fact_ids)),\n        "candidate_conservation_pass": bool(sqlite_selection.get("candidate_conservation_pass", True)),\n        "traversal_manifest": dict(sqlite_selection.get("traversal_manifest") or {}),\n        "authority_receipt": dict(sqlite_selection.get("authority_receipt") or {}),\n        "sqlite_selection_receipt": {\n''',
)
replace_once(
    "apps_rg/runtime/c0/c03_graph_expansion.py",
    '''    "BINDING_MODE_TAG_LABEL_ONLY",\n    "expand_c03_graph_bindings",\n]\n''',
    '''    "BINDING_MODE_TAG_LABEL_ONLY",\n    "C03GraphBindingError",\n    "expand_c03_graph_bindings",\n]\n''',
)
