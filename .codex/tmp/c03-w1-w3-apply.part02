
# C0.2 carries the canonical graph-plan binding into C0.3.  Surface aliases are
# preserved, while graph_query_fact_id identifies the actual fact used by the
# SQLite projection.
replace_once(
    "apps_rg/runtime/c0/c02_evidence_fetch.py",
    '''        atom = _atom_from_ledger_row(row, section_id=section_id)\n        atom["fact_id"] = fid\n        if ledger_fid:\n            atom["source_span_ref"] = f"candidate_ledger:{ledger_fid}"\n''',
    '''        atom = _atom_from_ledger_row(row, section_id=section_id)\n        atom["fact_id"] = fid\n        linked_identity_fact_ids = [\n            str(x).strip()\n            for x in (pf.get("linked_identity_fact_ids") or [])\n            if str(x).strip()\n        ]\n        graph_query_fact_id = ledger_fid or (linked_identity_fact_ids[0] if linked_identity_fact_ids else fid)\n        graph_skill_refs = [\n            str(x).strip()\n            for x in (pf.get("graph_skill_node_ids") or pf.get("selected_skill_ids") or [])\n            if str(x).strip()\n        ]\n        graph_metric_refs = [\n            str(x).strip()\n            for x in (pf.get("metric_outcome_ids") or pf.get("selected_metric_ids") or [])\n            if str(x).strip()\n        ]\n        selected_plan = pool.selected_fact_plan if isinstance(pool.selected_fact_plan, dict) else {}\n        atom["graph_query_fact_id"] = graph_query_fact_id\n        atom["graph_node_refs"] = graph_skill_refs\n        atom["metric_refs"] = graph_metric_refs\n        atom["graph_plan_id"] = str(selected_plan.get("plan_id") or "")\n        atom["graph_plan_digest"] = str(selected_plan.get("plan_digest") or "")\n        atom["graph_binding_source"] = (\n            "selected_graph_evidence_plan"\n            if graph_skill_refs and atom["graph_plan_digest"]\n            else ""\n        )\n        if ledger_fid:\n            atom["source_span_ref"] = f"candidate_ledger:{ledger_fid}"\n''',
)
replace_once(
    "apps_rg/runtime/c0/c02_evidence_fetch.py",
    '''        atom = _atom_from_ledger_row(row, section_id=section_id)\n        atom["fact_id"] = surface_fid\n        atom["source_span_ref"] = f"candidate_ledger:{ledger_fid}"\n''',
    '''        atom = _atom_from_ledger_row(row, section_id=section_id)\n        atom["fact_id"] = surface_fid\n        atom["graph_query_fact_id"] = ledger_fid\n        selected_plan = pool.selected_fact_plan if isinstance(pool.selected_fact_plan, dict) else {}\n        atom["graph_plan_id"] = str(selected_plan.get("plan_id") or "")\n        atom["graph_plan_digest"] = str(selected_plan.get("plan_digest") or "")\n        atom["graph_binding_source"] = ""\n        atom["source_span_ref"] = f"candidate_ledger:{ledger_fid}"\n''',
)

# C0.3 expansion may bind either to an already-frozen canonical graph plan or to
# authority-gated SQLite candidates.  Broad fact-link and label/tag proof
# fallbacks are removed; unmatched tags remain adjacency-only context.
replace_once(
    "apps_rg/runtime/c0/c03_graph_expansion.py",
    '''BINDING_MODE_FACT_LINKS_FIRST = "fact_links_first"\nBINDING_MODE_TAG_LABEL_ONLY = "tag_label_only"\n''',
    '''BINDING_MODE_FACT_LINKS_FIRST = "fact_links_first"\nBINDING_MODE_TAG_LABEL_ONLY = "tag_label_only"\n\n\nclass C03GraphBindingError(ValueError):\n    """A proof-eligible atom could not be bound through the canonical C0.3 graph path."""\n''',
)
regex_replace_once(
    "apps_rg/runtime/c0/c03_graph_expansion.py",
    r'''def _bind_atom\(.*?\n\n\ndef expand_c03_graph_bindings\(''',
    r'''def _bind_atom(
    *,
    atom: C02Atom,
    section_id: str,
    inner: dict[str, Any],
    skill_by_id: dict[str, dict[str, Any]],
    skill_by_label: dict[str, dict[str, Any]],
    links_by_fact: dict[str, list[dict[str, Any]]],
    binding_mode: str,
    skill_pillar_by_id: dict[str, str] | None = None,
    pillar_hints: tuple[str, ...] = (),
    sqlite_selection_by_fact: dict[str, list[dict[str, Any]]] | None = None,
    sqlite_rejected_by_fact: dict[str, list[dict[str, Any]]] | None = None,
    canonical_skill_ids: set[str] | None = None,
) -> dict[str, Any]:
    del skill_by_label, links_by_fact, pillar_hints
    fid = str(atom.get("fact_id") or "")
    query_fid = str(atom.get("graph_query_fact_id") or fid)
    tags = [str(tag).lower() for tag in (atom.get("skill_tags") or [])]
    graph_nodes: list[str] = []
    adjacent: list[str] = []
    labels: list[str] = []
    strength = GRAPH_STRENGTH_NONE
    claim_support = False
    binding_source = "none"
    selected_sqlite_candidates = list((sqlite_selection_by_fact or {}).get(query_fid) or [])
    rejected_sqlite_candidates = list((sqlite_rejected_by_fact or {}).get(query_fid) or [])

    prebound_refs = [
        str(skill_id).strip()
        for skill_id in (atom.get("graph_node_refs") or [])
        if str(skill_id).strip()
    ]
    canonical_plan_bound = (
        str(atom.get("graph_binding_source") or "") == "selected_graph_evidence_plan"
        and bool(str(atom.get("graph_plan_digest") or ""))
        and bool(prebound_refs)
    )
    known_skill_ids = canonical_skill_ids or set(skill_by_id)
    if canonical_plan_bound:
        unknown_refs = [skill_id for skill_id in prebound_refs if skill_id not in known_skill_ids]
        if not unknown_refs:
            graph_nodes = list(dict.fromkeys(prebound_refs))
            labels.append(REL_DIRECT_SUPPORT)
            strength = GRAPH_STRENGTH_DIRECT
            binding_source = "selected_graph_evidence_plan"
            claim_support = atom.get("proof_status") == "proof_eligible"
    elif binding_mode != BINDING_MODE_TAG_LABEL_ONLY and selected_sqlite_candidates:
        for candidate in selected_sqlite_candidates:
            skill_id = str(candidate.get("skill_id") or "").strip()
            authority = candidate.get("authority") if isinstance(candidate.get("authority"), dict) else {}
            if not skill_id or skill_id in graph_nodes or authority.get("authority_pass") is not True:
                continue
            graph_nodes.append(skill_id)
        if graph_nodes:
            labels.append(REL_DIRECT_SUPPORT)
            strength = GRAPH_STRENGTH_DIRECT
            binding_source = "skill_fact_links"
            if atom.get("proof_status") == "proof_eligible":
                claim_support = True

    if not graph_nodes and tags:
        labels.append(REL_ADJACENCY_ONLY)
        strength = GRAPH_STRENGTH_ADJACENT_ONLY
        adjacent = tags[:3]
        claim_support = False
        binding_source = "adjacency_only"

    if section_id:
        labels.append(REL_SECTION_FIT)

    return {
        "fact_id": fid,
        "graph_query_fact_id": query_fid,
        "graph_node_refs": graph_nodes,
        "career_phase_refs": list(atom.get("career_phase_refs") or []),
        "skill_cluster_refs": [
            str(pillar.get("node_id") or "")
            for pillar in (inner.get("pillars") or [])
            if isinstance(pillar, dict)
        ][:5],
        "adjacent_skill_refs": adjacent,
        "metric_binding_refs": list(atom.get("metric_refs") or []),
        "section_fit_refs": [section_id] if section_id else [],
        "lineage_refs": [str(atom.get("source_span_ref") or "")],
        "relationship_labels": sorted(set(labels)),
        "graph_support_strength": strength,
        "claim_support_allowed": claim_support,
        "binding_source": binding_source,
        "binding_query_source": (
            "canonical_selected_graph_plan"
            if binding_source == "selected_graph_evidence_plan"
            else "sqlite_ranked_skill_fact_links"
            if selected_sqlite_candidates and binding_source == "skill_fact_links"
            else binding_source
        ),
        "graph_plan_id": str(atom.get("graph_plan_id") or ""),
        "graph_plan_digest": str(atom.get("graph_plan_digest") or ""),
        "selected_metric_buckets": sorted(
            {
                str(candidate.get("metric_bucket") or "general_business_outcome")
                for candidate in selected_sqlite_candidates
                if (candidate.get("authority") or {}).get("authority_pass") is True
            }
        ),
        "rejected_sibling_skill_refs": [
            str(candidate.get("skill_id") or "")
            for candidate in rejected_sqlite_candidates
            if str(candidate.get("skill_id") or "")
        ],
        "rejected_sibling_reasons": [
            {
                "skill_id": str(candidate.get("skill_id") or ""),
                "reason": str(candidate.get("rejection_reason") or ""),
                "failed_gate": str(candidate.get("failed_gate") or ""),
                "metric_bucket": str(candidate.get("metric_bucket") or "general_business_outcome"),
            }
            for candidate in rejected_sqlite_candidates
            if str(candidate.get("skill_id") or "")
        ],
        "sqlite_ranked_candidates": [
            {
                "skill_id": str(candidate.get("skill_id") or ""),
                "score": candidate.get("score"),
                "base_score": candidate.get("base_score"),
                "score_components": dict(candidate.get("score_components") or {}),
                "metric_bucket": str(candidate.get("metric_bucket") or "general_business_outcome"),
                "skill_family": str(candidate.get("skill_family") or "unclassified"),
                "path_signature": str(candidate.get("path_signature") or ""),
                "prior_metric_usage": int(candidate.get("prior_metric_usage") or 0),
                "sibling_alternatives": list(candidate.get("sibling_alternatives") or [])[:5],
                "penalties": dict(candidate.get("penalties") or {}),
            }
            for candidate in selected_sqlite_candidates
            if str(candidate.get("skill_id") or "")
            and (candidate.get("authority") or {}).get("authority_pass") is True
        ],
        "reason": "bounded graph expansion over C0.2 atoms; no new facts and no broad proof fallback",
    }


def expand_c03_graph_bindings(''',
)
replace_once(
    "apps_rg/runtime/c0/c03_graph_expansion.py",
    '''    fact_ids = [str(a.get("fact_id") or "") for a in atoms if a.get("fact_id")]\n''',
