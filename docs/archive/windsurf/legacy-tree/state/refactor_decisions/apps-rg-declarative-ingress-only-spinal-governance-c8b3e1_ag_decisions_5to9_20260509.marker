DECISION_CAPTURED: timestamp=2026-05-09T08:37:00-04:00 plan=apps-rg-declarative-ingress-only-spinal-governance-c8b3e1 decision_id=AG-RGGOV-5 chosen_option=CORE_OWNED_FEC_ONLY rationale="apps_rg/cert/fec_producer.py must not remain a live FEC producer; Core C0 owns FinalEvidenceContract emission; apps_rg may supply evidence_profile_ref only"
DECISION_CAPTURED: timestamp=2026-05-09T08:37:00-04:00 plan=apps-rg-declarative-ingress-only-spinal-governance-c8b3e1 decision_id=AG-RGGOV-6 chosen_option=DECLARATIVE_PROFILE_ONLY rationale="agent_spec_config.py may contribute static fields to apps_rg/profiles/*.yaml only; any runtime behavior, model authority, routing, planning, prompt, execution, provider, or agent behavior is quarantined"
DECISION_CAPTURED: timestamp=2026-05-09T08:37:00-04:00 plan=apps-rg-declarative-ingress-only-spinal-governance-c8b3e1 decision_id=AG-RGGOV-7 chosen_option=HITL_INPUT_ONLY_FOR_APPS_RG rationale="apps_rg may collect human text as ingress/re-entry data only; HITL review, approval, re-clearance, and disposition belong to agentic_core Exit/L5"
DECISION_CAPTURED: timestamp=2026-05-09T08:37:00-04:00 plan=apps-rg-declarative-ingress-only-spinal-governance-c8b3e1 decision_id=AG-RGGOV-8 chosen_option=QUARANTINE_ALL_RUNTIME_HOPS rationale="apps_rg/integrations/hops/* must be removed or quarantined from live path unless purely inert declarative data; no hop runner, provider shim, judge runner, ensemble runner, or model caller may remain live"
DECISION_CAPTURED: timestamp=2026-05-09T08:37:00-04:00 plan=apps-rg-declarative-ingress-only-spinal-governance-c8b3e1 decision_id=AG-RGGOV-9 chosen_option=REMOVE_APPS_RG_RUNTIME_ALIASES rationale="agentic_core/utils/workflow_engines/apps_engines_aliases.py must not point to apps_rg runtime engines, orchestrators, planners, hops, or executors; if aliases remain, they may point only to declarative profile metadata"
