# Dockerfile for Canon Validator - Optimized for Docker Desktop
# Use a standard Python image
FROM python:3.11-slim

# Set working directory for the script and the mounted project
# The script will run from this directory, which will contain the mounted source code
WORKDIR /app

# Install dependencies from requirements.txt
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the validator script into the container
COPY canon_validator.py .

# Define the entrypoint to run the script.
# This assumes the user will mount their code into /app.
# If you want to pass arguments (like --purge-runaway), you will override this
# in the 'docker run' command.
ENTRYPOINT ["python3", "canon_validator.py"]

# Optional: Add a default command if no arguments are provided,
# but the ENTRYPOINT is usually sufficient here.
CMD []
