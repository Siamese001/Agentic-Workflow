Module(
  body=[
    Expr(
      value=Constant(value='L1 Planning Integration Tests.')),
    ClassDef(
      name='TestL1PlanningIntegration',
      body=[
        Expr(
          value=Constant(value='Integration tests for L1 planning layer.')),
        FunctionDef(
          name='test_workflow_to_strategy_integration',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test workflow to strategy planning integration.')),
            Assign(
              targets=[
                Name(id='workflow', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='id'),
                  Constant(value='steps')],
                values=[
                  Constant(value='wf1'),
                  List(
                    elts=[
                      Constant(value='plan'),
                      Constant(value='execute')],
                    ctx=Load())])),
            Assign(
              targets=[
                Name(id='strategy', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='workflow_id'),
                  Constant(value='mode')],
                values=[
                  Subscript(
                    value=Name(id='workflow', ctx=Load()),
                    slice=Constant(value='id'),
                    ctx=Load()),
                  Constant(value='cot')])),
            Assert(
              test=Compare(
                left=Subscript(
                  value=Name(id='strategy', ctx=Load()),
                  slice=Constant(value='workflow_id'),
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value='wf1')]))]),
        FunctionDef(
          name='test_strategy_to_drafting_integration',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test strategy to drafting integration.')),
            Assign(
              targets=[
                Name(id='strategy_result', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='complexity')],
                values=[
                  Constant(value='medium')])),
            Assign(
              targets=[
                Name(id='drafting_config', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='based_on')],
                values=[
                  Subscript(
                    value=Name(id='strategy_result', ctx=Load()),
                    slice=Constant(value='complexity'),
                    ctx=Load())])),
            Assert(
              test=Compare(
                left=Subscript(
                  value=Name(id='drafting_config', ctx=Load()),
                  slice=Constant(value='based_on'),
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value='medium')]))]),
        FunctionDef(
          name='test_planning_to_safety_integration',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test planning to safety integration.')),
            Assign(
              targets=[
                Name(id='plan', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='content')],
                values=[
                  Constant(value='resume text')])),
            Assign(
              targets=[
                Name(id='safety_check', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='plan_id'),
                  Constant(value='validated')],
                values=[
                  Constant(value='p1'),
                  Constant(value=True)])),
            Assert(
              test=Compare(
                left=Subscript(
                  value=Name(id='safety_check', ctx=Load()),
                  slice=Constant(value='validated'),
                  ctx=Load()),
                ops=[
                  Is()],
                comparators=[
                  Constant(value=True)]))]),
        FunctionDef(
          name='test_full_planning_pipeline',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test full planning pipeline integration.')),
            Assign(
              targets=[
                Name(id='stages', ctx=Store())],
              value=List(
                elts=[
                  Constant(value='workflow'),
                  Constant(value='strategy'),
                  Constant(value='drafting'),
                  Constant(value='qa'),
                  Constant(value='safety')],
                ctx=Load())),
            Assign(
              targets=[
                Name(id='completed', ctx=Store())],
              value=ListComp(
                elt=Constant(value=True),
                generators=[
                  comprehension(
                    target=Name(id='_', ctx=Store()),
                    iter=Name(id='stages', ctx=Load()),
                    is_async=0)])),
            Assert(
              test=Call(
                func=Name(id='all', ctx=Load()),
                args=[
                  Name(id='completed', ctx=Load())]))])])])