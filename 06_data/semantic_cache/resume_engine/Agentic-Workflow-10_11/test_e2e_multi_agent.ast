Module(
  body=[
    Expr(
      value=Constant(value='E2E Multi-Agent Scenario Tests.')),
    ClassDef(
      name='TestE2EMultiAgent',
      body=[
        Expr(
          value=Constant(value='E2E tests for multi-agent scenarios.')),
        FunctionDef(
          name='test_planner_executor_reviewer_chain',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test planner-executor-reviewer agent chain.')),
            Assign(
              targets=[
                Name(id='agents', ctx=Store())],
              value=List(
                elts=[
                  Constant(value='planner'),
                  Constant(value='executor'),
                  Constant(value='reviewer')],
                ctx=Load())),
            Assign(
              targets=[
                Name(id='results', ctx=Store())],
              value=List(ctx=Load())),
            For(
              target=Name(id='agent', ctx=Store()),
              iter=Name(id='agents', ctx=Load()),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='results', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Dict(
                        keys=[
                          Constant(value='agent'),
                          Constant(value='status')],
                        values=[
                          Name(id='agent', ctx=Load()),
                          Constant(value='complete')])]))]),
            Assert(
              test=Compare(
                left=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Name(id='results', ctx=Load())]),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value=3)]))]),
        FunctionDef(
          name='test_parallel_agent_coordination',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test parallel agent coordination.')),
            Assign(
              targets=[
                Name(id='parallel_agents', ctx=Store())],
              value=List(
                elts=[
                  Constant(value='agent_a'),
                  Constant(value='agent_b'),
                  Constant(value='agent_c')],
                ctx=Load())),
            Assign(
              targets=[
                Name(id='outputs', ctx=Store())],
              value=DictComp(
                key=Name(id='a', ctx=Load()),
                value=JoinedStr(
                  values=[
                    Constant(value='output_'),
                    FormattedValue(
                      value=Name(id='a', ctx=Load()),
                      conversion=-1)]),
                generators=[
                  comprehension(
                    target=Name(id='a', ctx=Store()),
                    iter=Name(id='parallel_agents', ctx=Load()),
                    is_async=0)])),
            Assert(
              test=Compare(
                left=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Name(id='outputs', ctx=Load())]),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value=3)]))])])])