Module(
  body=[
    ImportFrom(
      module='orchestration.control_plane',
      names=[
        alias(name='SafetyContext'),
        alias(name='run_safety_pipeline')],
      level=0),
    FunctionDef(
      name='test_control_plane_allows_safe_text',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='ctx', ctx=Store())],
          value=Call(
            func=Name(id='SafetyContext', ctx=Load()),
            keywords=[
              keyword(
                arg='input_text',
                value=Constant(value='This is a benign sentence.'))])),
        Assign(
          targets=[
            Tuple(
              elts=[
                Name(id='decision', ctx=Store()),
                Name(id='trace', ctx=Store())],
              ctx=Store())],
          value=Call(
            func=Name(id='run_safety_pipeline', ctx=Load()),
            args=[
              Name(id='ctx', ctx=Load())],
            keywords=[
              keyword(
                arg='execution_profile',
                value=Constant(value=None))])),
        Assert(
          test=Compare(
            left=Attribute(
              value=Name(id='decision', ctx=Load()),
              attr='action',
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value='allow')])),
        Assert(
          test=Compare(
            left=Attribute(
              value=Name(id='decision', ctx=Load()),
              attr='verdict',
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value='safe')])),
        Assert(
          test=Compare(
            left=Subscript(
              value=Attribute(
                value=Name(id='trace', ctx=Load()),
                attr='rules_engine',
                ctx=Load()),
              slice=Constant(value='match_count'),
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value=0)]))])])