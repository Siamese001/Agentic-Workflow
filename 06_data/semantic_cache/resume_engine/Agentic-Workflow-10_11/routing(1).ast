Module(
  body=[
    Expr(
      value=Constant(value='\nRouting Policy for Agentic Workflow v10_10\n=========================================\n\nThis is the v10_10 refactor of the v10_9 routing layer.\n\nIt removes:\n    - PlanObject-dependent logic\n    - L5.ModelRouter\n    - PromptEnvelope construction\n    - META-only routing criteria classes\n    - direct meta_profile accessors (get_routing_bias, get_planning_bias, etc.)\n    - simulated model invocation stubs\n\nand replaces them with a **minimal, deterministic RoutingPolicy** that:\n\n    - Selects models based on task + ComplexityLevel.\n    - Is influenced by a MetaProfileSnapshot (read-only).\n    - Provides ToT branch counts for StrategyLLMAgent.\n    - Contains NO provider SDK calls.\n    - Contains NO L1/L2/L3/L4/L5 logic.\n\nThis module is used only by L2 cognitive agents and L1 complexity\nclassification. It is **pure decision logic**.\n')),
    ImportFrom(
      module='__future__',
      names=[
        alias(name='annotations')],
      level=0),
    ImportFrom(
      module='dataclasses',
      names=[
        alias(name='dataclass')],
      level=0),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Optional'),
        alias(name='Any'),
        alias(name='List'),
        alias(name='Dict')],
      level=0),
    ImportFrom(
      module='core.models.models',
      names=[
        alias(name='ComplexityLevel'),
        alias(name='SkillClassifierResult'),
        alias(name='DomainClassifierResult'),
        alias(name='MultiAgentCouncilResult'),
        alias(name='RoutingDecisionEvent')],
      level=0),
    ImportFrom(
      module='config.meta_profile',
      names=[
        alias(name='MetaProfileSnapshot')],
      level=0),
    ImportFrom(
      module='observability',
      names=[
        alias(name='record_event')],
      level=0),
    Assign(
      targets=[
        Name(id='LIGHT_MODELS', ctx=Store())],
      value=Set(
        elts=[
          Constant(value='gpt-4o-mini'),
          Constant(value='gpt-3.5-turbo'),
          Constant(value='claude-3-haiku-20240307')])),
    Assign(
      targets=[
        Name(id='STANDARD_MODELS', ctx=Store())],
      value=Set(
        elts=[
          Constant(value='gpt-4o'),
          Constant(value='gpt-4-turbo'),
          Constant(value='claude-3-sonnet-20240229'),
          Constant(value='claude-3-5-sonnet-20240620')])),
    Assign(
      targets=[
        Name(id='HEAVY_MODELS', ctx=Store())],
      value=Set(
        elts=[
          Constant(value='gpt-4-turbo-preview'),
          Constant(value='claude-3-opus-20240229'),
          Constant(value='o1-preview'),
          Constant(value='o1-mini')])),
    ClassDef(
      name='RoutingPolicy',
      body=[
        Expr(
          value=Constant(value='\n    Minimal routing policy used by L2 cognitive agents.\n\n    Fields:\n        default_model: fallback model for unspecified tasks.\n        strategy_model: model used for strategy generation.\n        drafting_model: model used for draft generation.\n        qa_model: model used for QA checks.\n        safety_model: model used for safety evaluation.\n        tot_branch_count: Tree-of-Thought branching factor.\n    ')),
        AnnAssign(
          target=Name(id='default_model', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          value=Constant(value='gpt-4o'),
          simple=1),
        AnnAssign(
          target=Name(id='strategy_model', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          value=Constant(value='gpt-4o'),
          simple=1),
        AnnAssign(
          target=Name(id='drafting_model', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          value=Constant(value='gpt-4o'),
          simple=1),
        AnnAssign(
          target=Name(id='qa_model', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          value=Constant(value='gpt-4o-mini'),
          simple=1),
        AnnAssign(
          target=Name(id='safety_model', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          value=Constant(value='gpt-4o-mini'),
          simple=1),
        AnnAssign(
          target=Name(id='tot_branch_count', ctx=Store()),
          annotation=Name(id='int', ctx=Load()),
          value=Constant(value=3),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    FunctionDef(
      name='build_routing_policy',
      args=arguments(
        args=[
          arg(
            arg='complexity',
            annotation=Name(id='ComplexityLevel', ctx=Load())),
          arg(
            arg='meta_profile',
            annotation=Subscript(
              value=Name(id='Optional', ctx=Load()),
              slice=Name(id='MetaProfileSnapshot', ctx=Load()),
              ctx=Load()))],
        defaults=[
          Constant(value=None)]),
      body=[
        Expr(
          value=Constant(value='\n    Construct a RoutingPolicy based on ComplexityLevel and optional meta_profile.\n\n    Rules:\n        LOW complexity -> light models, 2 branches.\n        MEDIUM complexity -> standard models, 3 branches.\n        HIGH complexity -> heavy models, 5 branches.\n\n    If meta_profile contains bias overrides, they are applied here.\n    ')),
        If(
          test=Compare(
            left=Name(id='complexity', ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Attribute(
                value=Name(id='ComplexityLevel', ctx=Load()),
                attr='LOW',
                ctx=Load())]),
          body=[
            Assign(
              targets=[
                Name(id='policy', ctx=Store())],
              value=Call(
                func=Name(id='RoutingPolicy', ctx=Load()),
                keywords=[
                  keyword(
                    arg='default_model',
                    value=Constant(value='gpt-4o-mini')),
                  keyword(
                    arg='strategy_model',
                    value=Constant(value='gpt-4o-mini')),
                  keyword(
                    arg='drafting_model',
                    value=Constant(value='gpt-4o-mini')),
                  keyword(
                    arg='qa_model',
                    value=Constant(value='gpt-4o-mini')),
                  keyword(
                    arg='safety_model',
                    value=Constant(value='gpt-4o-mini')),
                  keyword(
                    arg='tot_branch_count',
                    value=Constant(value=2))]))],
          orelse=[
            If(
              test=Compare(
                left=Name(id='complexity', ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Attribute(
                    value=Name(id='ComplexityLevel', ctx=Load()),
                    attr='MEDIUM',
                    ctx=Load())]),
              body=[
                Assign(
                  targets=[
                    Name(id='policy', ctx=Store())],
                  value=Call(
                    func=Name(id='RoutingPolicy', ctx=Load()),
                    keywords=[
                      keyword(
                        arg='default_model',
                        value=Constant(value='gpt-4o')),
                      keyword(
                        arg='strategy_model',
                        value=Constant(value='gpt-4o')),
                      keyword(
                        arg='drafting_model',
                        value=Constant(value='gpt-4o')),
                      keyword(
                        arg='qa_model',
                        value=Constant(value='gpt-4o-mini')),
                      keyword(
                        arg='safety_model',
                        value=Constant(value='gpt-4o-mini')),
                      keyword(
                        arg='tot_branch_count',
                        value=Constant(value=3))]))],
              orelse=[
                Assign(
                  targets=[
                    Name(id='policy', ctx=Store())],
                  value=Call(
                    func=Name(id='RoutingPolicy', ctx=Load()),
                    keywords=[
                      keyword(
                        arg='default_model',
                        value=Constant(value='gpt-4-turbo-preview')),
                      keyword(
                        arg='strategy_model',
                        value=Constant(value='gpt-4-turbo-preview')),
                      keyword(
                        arg='drafting_model',
                        value=Constant(value='gpt-4o')),
                      keyword(
                        arg='qa_model',
                        value=Constant(value='gpt-4o')),
                      keyword(
                        arg='safety_model',
                        value=Constant(value='gpt-4o')),
                      keyword(
                        arg='tot_branch_count',
                        value=Constant(value=5))]))])]),
        If(
          test=Compare(
            left=Name(id='meta_profile', ctx=Load()),
            ops=[
              IsNot()],
            comparators=[
              Constant(value=None)]),
          body=[
            Try(
              body=[
                If(
                  test=BoolOp(
                    op=And(),
                    values=[
                      Call(
                        func=Name(id='hasattr', ctx=Load()),
                        args=[
                          Name(id='meta_profile', ctx=Load()),
                          Constant(value='preferred_strategy_model')]),
                      Attribute(
                        value=Name(id='meta_profile', ctx=Load()),
                        attr='preferred_strategy_model',
                        ctx=Load())]),
                  body=[
                    Assign(
                      targets=[
                        Attribute(
                          value=Name(id='policy', ctx=Load()),
                          attr='strategy_model',
                          ctx=Store())],
                      value=Attribute(
                        value=Name(id='meta_profile', ctx=Load()),
                        attr='preferred_strategy_model',
                        ctx=Load()))]),
                If(
                  test=BoolOp(
                    op=And(),
                    values=[
                      Call(
                        func=Name(id='hasattr', ctx=Load()),
                        args=[
                          Name(id='meta_profile', ctx=Load()),
                          Constant(value='preferred_drafting_model')]),
                      Attribute(
                        value=Name(id='meta_profile', ctx=Load()),
                        attr='preferred_drafting_model',
                        ctx=Load())]),
                  body=[
                    Assign(
                      targets=[
                        Attribute(
                          value=Name(id='policy', ctx=Load()),
                          attr='drafting_model',
                          ctx=Store())],
                      value=Attribute(
                        value=Name(id='meta_profile', ctx=Load()),
                        attr='preferred_drafting_model',
                        ctx=Load()))])],
              handlers=[
                ExceptHandler(
                  type=Name(id='Exception', ctx=Load()),
                  body=[
                    Pass()])])]),
        Return(
          value=Name(id='policy', ctx=Load()))],
      returns=Name(id='RoutingPolicy', ctx=Load())),
    FunctionDef(
      name='select_model_for_task',
      args=arguments(
        args=[
          arg(
            arg='task',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='policy',
            annotation=Name(id='RoutingPolicy', ctx=Load())),
          arg(
            arg='council',
            annotation=Subscript(
              value=Name(id='Optional', ctx=Load()),
              slice=Name(id='MultiAgentCouncilResult', ctx=Load()),
              ctx=Load()))],
        defaults=[
          Constant(value=None)]),
      body=[
        Expr(
          value=Constant(value='\n    Return the model name for a given task using the policy.\n\n    Tasks: "strategy", "drafting", "qa", "safety", or fallback to default.\n\n    If a council vote is provided and has a model override, use it.\n    ')),
        If(
          test=BoolOp(
            op=And(),
            values=[
              Compare(
                left=Name(id='council', ctx=Load()),
                ops=[
                  IsNot()],
                comparators=[
                  Constant(value=None)]),
              Call(
                func=Name(id='hasattr', ctx=Load()),
                args=[
                  Name(id='council', ctx=Load()),
                  Constant(value='metadata')])]),
          body=[
            Assign(
              targets=[
                Name(id='override', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='council', ctx=Load()),
                    attr='metadata',
                    ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='model_override')])),
            If(
              test=Name(id='override', ctx=Load()),
              body=[
                Return(
                  value=Call(
                    func=Name(id='str', ctx=Load()),
                    args=[
                      Name(id='override', ctx=Load())]))])]),
        Assign(
          targets=[
            Name(id='task_lower', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='task', ctx=Load()),
              attr='lower',
              ctx=Load()))),
        If(
          test=Compare(
            left=Name(id='task_lower', ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value='strategy')]),
          body=[
            Return(
              value=Attribute(
                value=Name(id='policy', ctx=Load()),
                attr='strategy_model',
                ctx=Load()))]),
        If(
          test=Compare(
            left=Name(id='task_lower', ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value='drafting')]),
          body=[
            Return(
              value=Attribute(
                value=Name(id='policy', ctx=Load()),
                attr='drafting_model',
                ctx=Load()))]),
        If(
          test=Compare(
            left=Name(id='task_lower', ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value='qa')]),
          body=[
            Return(
              value=Attribute(
                value=Name(id='policy', ctx=Load()),
                attr='qa_model',
                ctx=Load()))]),
        If(
          test=Compare(
            left=Name(id='task_lower', ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value='safety')]),
          body=[
            Return(
              value=Attribute(
                value=Name(id='policy', ctx=Load()),
                attr='safety_model',
                ctx=Load()))]),
        Return(
          value=Attribute(
            value=Name(id='policy', ctx=Load()),
            attr='default_model',
            ctx=Load()))],
      returns=Name(id='str', ctx=Load())),
    FunctionDef(
      name='record_routing_decision',
      args=arguments(
        args=[
          arg(
            arg='agent_role',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='decision',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='reason',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='council',
            annotation=Subscript(
              value=Name(id='Optional', ctx=Load()),
              slice=Name(id='MultiAgentCouncilResult', ctx=Load()),
              ctx=Load()))],
        defaults=[
          Constant(value=None)]),
      body=[
        Expr(
          value=Constant(value='\n    Record a routing decision event for observability.\n\n    Returns the decision string unchanged.\n    ')),
        AnnAssign(
          target=Name(id='attrs', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='Any', ctx=Load())],
              ctx=Load()),
            ctx=Load()),
          value=Dict(
            keys=[
              Constant(value='agent_role'),
              Constant(value='decision'),
              Constant(value='reason')],
            values=[
              Name(id='agent_role', ctx=Load()),
              Name(id='decision', ctx=Load()),
              Name(id='reason', ctx=Load())]),
          simple=1),
        If(
          test=Compare(
            left=Name(id='council', ctx=Load()),
            ops=[
              IsNot()],
            comparators=[
              Constant(value=None)]),
          body=[
            Assign(
              targets=[
                Subscript(
                  value=Name(id='attrs', ctx=Load()),
                  slice=Constant(value='council_selected_id'),
                  ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='council', ctx=Load()),
                    attr='metadata',
                    ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='selected_id')])),
            Assign(
              targets=[
                Subscript(
                  value=Name(id='attrs', ctx=Load()),
                  slice=Constant(value='council_aggregated_decision'),
                  ctx=Store())],
              value=Attribute(
                value=Name(id='council', ctx=Load()),
                attr='aggregated_decision',
                ctx=Load())),
            Assign(
              targets=[
                Subscript(
                  value=Name(id='attrs', ctx=Load()),
                  slice=Constant(value='council_vote_count'),
                  ctx=Store())],
              value=Call(
                func=Name(id='len', ctx=Load()),
                args=[
                  Attribute(
                    value=Name(id='council', ctx=Load()),
                    attr='votes',
                    ctx=Load())]))]),
        Assign(
          targets=[
            Name(id='event', ctx=Store())],
          value=Call(
            func=Name(id='RoutingDecisionEvent', ctx=Load()),
            keywords=[
              keyword(
                arg='name',
                value=Constant(value='routing_decision')),
              keyword(
                arg='agent_id',
                value=Name(id='agent_role', ctx=Load())),
              keyword(
                arg='provider',
                value=Constant(value='meta_routing')),
              keyword(
                arg='model_name',
                value=Constant(value='')),
              keyword(
                arg='reason',
                value=Name(id='reason', ctx=Load())),
              keyword(
                arg='attributes',
                value=Name(id='attrs', ctx=Load()))])),
        Try(
          body=[
            Expr(
              value=Call(
                func=Name(id='record_event', ctx=Load()),
                args=[
                  Attribute(
                    value=Name(id='event', ctx=Load()),
                    attr='name',
                    ctx=Load()),
                  Attribute(
                    value=Name(id='event', ctx=Load()),
                    attr='attributes',
                    ctx=Load())]))],
          handlers=[
            ExceptHandler(
              type=Name(id='Exception', ctx=Load()),
              body=[
                Pass()])]),
        Return(
          value=Name(id='decision', ctx=Load()))],
      returns=Name(id='str', ctx=Load())),
    FunctionDef(
      name='classify_skill_profile',
      args=arguments(
        args=[
          arg(
            arg='job',
            annotation=Name(id='Any', ctx=Load())),
          arg(
            arg='resume',
            annotation=Name(id='Any', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='Deterministic, rule-based skill classifier (non-LLM).\n\n    Uses simple keyword / structural heuristics on job + resume to\n    derive a coarse skill profile. This is intentionally conservative\n    but stable for routing and complexity decisions.\n    ')),
        AnnAssign(
          target=Name(id='labels', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load()),
          value=List(ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='features', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='Any', ctx=Load())],
              ctx=Load()),
            ctx=Load()),
          value=Dict(),
          simple=1),
        Assign(
          targets=[
            Name(id='title', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Call(
