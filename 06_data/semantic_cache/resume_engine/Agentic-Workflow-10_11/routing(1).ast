                  attr='append',
                  ctx=Load()),
                args=[
                  Constant(value='actuarial_insurance')]))]),
        Assign(
          targets=[
            Name(id='exp_sections', ctx=Store())],
          value=BoolOp(
            op=Or(),
            values=[
              Call(
                func=Name(id='getattr', ctx=Load()),
                args=[
                  Name(id='resume', ctx=Load()),
                  Constant(value='experience_sections'),
                  List(ctx=Load())]),
              List(ctx=Load())])),
        Assign(
          targets=[
