          value=Tuple(
            elts=[
              Constant(value='manager'),
              Constant(value='lead'),
              Constant(value='senior')],
            ctx=Load())),
        If(
          test=Call(
            func=Name(id='any', ctx=Load()),
            args=[
              GeneratorExp(
                elt=Compare(
                  left=Name(id='t', ctx=Load()),
                  ops=[
                    In()],
                  comparators=[
                    Name(id='title', ctx=Load())]),
                generators=[
                  comprehension(
                    target=Name(id='t', ctx=Store()),
                    iter=Name(id='senior_tokens', ctx=Load()),
                    is_async=0)])]),
          body=[
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='labels', ctx=Load()),
                  attr='append',
                  ctx=Load()),
                args=[
                  Constant(value='senior_leadership')]))],
          orelse=[
            If(
              test=Call(
                func=Name(id='any', ctx=Load()),
                args=[
                  GeneratorExp(
                    elt=Compare(
                      left=Name(id='t', ctx=Load()),
                      ops=[
                        In()],
                      comparators=[
                        Name(id='title', ctx=Load())]),
                    generators=[
                      comprehension(
                        target=Name(id='t', ctx=Store()),
                        iter=Name(id='mid_tokens', ctx=Load()),
                        is_async=0)])]),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
