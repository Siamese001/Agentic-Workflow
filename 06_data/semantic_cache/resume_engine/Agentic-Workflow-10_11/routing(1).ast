                      attr='append',
                      ctx=Load()),
                    args=[
                      Constant(value='senior_individual_contributor')]))],
              orelse=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='labels', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Constant(value='individual_contributor')]))])]),
        If(
          test=BoolOp(
            op=Or(),
            values=[
              Compare(
                left=Constant(value='machine learning'),
                ops=[
                  In()],
                comparators=[
                  Name(id='desc', ctx=Load())]),
              Compare(
                left=Constant(value='ml'),
                ops=[
                  In()],
                comparators=[
                  Name(id='desc', ctx=Load())]),
              Compare(
