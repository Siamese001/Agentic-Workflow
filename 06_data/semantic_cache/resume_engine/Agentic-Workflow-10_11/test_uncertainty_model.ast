Module(
  body=[
    ImportFrom(
      module='meta.metacognition.models',
      names=[
        alias(name='Hypothesis')],
      level=0),
    ImportFrom(
      module='meta.metacognition.uncertainty',
      names=[
        alias(name='compute_uncertainty')],
      level=0),
    FunctionDef(
      name='test_uncertainty_increases_with_signals',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='hs', ctx=Store())],
          value=List(
            elts=[
              Call(
                func=Name(id='Hypothesis', ctx=Load()),
                keywords=[
                  keyword(
                    arg='id',
                    value=Constant(value='h1')),
                  keyword(
                    arg='agent_id',
                    value=Constant(value='a1')),
                  keyword(
                    arg='content',
                    value=Constant(value='c1')),
                  keyword(
                    arg='confidence',
                    value=Constant(value=0.8))]),
              Call(
                func=Name(id='Hypothesis', ctx=Load()),
                keywords=[
                  keyword(
                    arg='id',
                    value=Constant(value='h2')),
                  keyword(
                    arg='agent_id',
                    value=Constant(value='a1')),
                  keyword(
                    arg='content',
                    value=Constant(value='c2')),
                  keyword(
                    arg='confidence',
                    value=Constant(value=0.6))])],
            ctx=Load())),
        Assign(
          targets=[
            Name(id='low', ctx=Store())],
          value=Call(
            func=Name(id='compute_uncertainty', ctx=Load()),
            args=[
              Name(id='hs', ctx=Load())],
            keywords=[
              keyword(
                arg='qa_signals',
                value=Constant(value=0)),
              keyword(
                arg='safety_signals',
                value=Constant(value=0))])),
        Assign(
          targets=[
            Name(id='high', ctx=Store())],
          value=Call(
            func=Name(id='compute_uncertainty', ctx=Load()),
            args=[
              Name(id='hs', ctx=Load())],
            keywords=[
              keyword(
                arg='qa_signals',
                value=Constant(value=3)),
              keyword(
                arg='safety_signals',
                value=Constant(value=2))])),
        Assert(
          test=Compare(
            left=Constant(value=0.0),
            ops=[
              LtE(),
              LtE()],
            comparators=[
              Name(id='low', ctx=Load()),
              Constant(value=1.0)])),
        Assert(
          test=Compare(
            left=Constant(value=0.0),
            ops=[
              LtE(),
              LtE()],
            comparators=[
              Name(id='high', ctx=Load()),
              Constant(value=1.0)])),
        Assert(
          test=Compare(
            left=Name(id='high', ctx=Load()),
            ops=[
              Gt()],
            comparators=[
              Name(id='low', ctx=Load())]))])])