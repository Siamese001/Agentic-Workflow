Module(
  body=[
    Expr(
      value=Constant(value='L4 Memory State Transitions Tests.')),
    ClassDef(
      name='TestL4StateTransitions',
      body=[
        Expr(
          value=Constant(value='Tests for L4 state transitions.')),
        FunctionDef(
          name='test_init_to_active_transition',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test init to active state transition.')),
            Assign(
              targets=[
                Name(id='states', ctx=Store())],
              value=List(
                elts=[
                  Constant(value='init'),
                  Constant(value='active'),
                  Constant(value='completed')],
                ctx=Load())),
            Assign(
              targets=[
                Name(id='current', ctx=Store())],
              value=Constant(value=0)),
            AugAssign(
              target=Name(id='current', ctx=Store()),
              op=Add(),
              value=Constant(value=1)),
            Assert(
              test=Compare(
                left=Subscript(
                  value=Name(id='states', ctx=Load()),
                  slice=Name(id='current', ctx=Load()),
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value='active')]))]),
        FunctionDef(
          name='test_active_to_completed_transition',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test active to completed state transition.')),
            Assign(
              targets=[
                Name(id='state', ctx=Store())],
              value=Constant(value='active')),
            Assign(
              targets=[
                Name(id='state', ctx=Store())],
              value=Constant(value='completed')),
            Assert(
              test=Compare(
                left=Name(id='state', ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value='completed')]))]),
        FunctionDef(
          name='test_rollback_transition',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test rollback state transition.')),
            Assign(
              targets=[
                Name(id='history', ctx=Store())],
              value=List(
                elts=[
                  Constant(value='s1'),
                  Constant(value='s2'),
                  Constant(value='s3')],
                ctx=Load())),
            Assign(
              targets=[
                Name(id='rollback_to', ctx=Store())],
              value=Subscript(
                value=Name(id='history', ctx=Load()),
                slice=UnaryOp(
                  op=USub(),
                  operand=Constant(value=2)),
                ctx=Load())),
            Assert(
              test=Compare(
                left=Name(id='rollback_to', ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value='s2')]))])])])