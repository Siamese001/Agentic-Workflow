Module(
  body=[
    ImportFrom(
      module='orchestration.model_routing',
      names=[
        alias(name='RoutingContext'),
        alias(name='select_model')],
      level=0),
    FunctionDef(
      name='test_selector_integration_uses_cache_for_generic_calls',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='ctx', ctx=Store())],
          value=Call(
            func=Name(id='RoutingContext', ctx=Load()),
            keywords=[
              keyword(
                arg='agent_id',
                value=Constant(value='agent1')),
              keyword(
                arg='task_type',
                value=Constant(value='llm_call')),
              keyword(
                arg='execution_profile',
                value=Constant(value=None))])),
        Assign(
          targets=[
            Name(id='first', ctx=Store())],
          value=Call(
            func=Name(id='select_model', ctx=Load()),
            args=[
              Name(id='ctx', ctx=Load())],
            keywords=[
              keyword(
                arg='requested_model',
                value=Constant(value=None)),
              keyword(
                arg='execution_profile',
                value=Constant(value=None))])),
        Assign(
          targets=[
            Name(id='second', ctx=Store())],
          value=Call(
            func=Name(id='select_model', ctx=Load()),
            args=[
              Name(id='ctx', ctx=Load())],
            keywords=[
              keyword(
                arg='requested_model',
                value=Constant(value=None)),
              keyword(
                arg='execution_profile',
                value=Constant(value=None))])),
        Assert(
          test=Compare(
            left=Attribute(
              value=Name(id='first', ctx=Load()),
              attr='provider',
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Attribute(
                value=Name(id='second', ctx=Load()),
                attr='provider',
                ctx=Load())])),
        Assert(
          test=Compare(
            left=Attribute(
              value=Name(id='first', ctx=Load()),
              attr='model_name',
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Attribute(
                value=Name(id='second', ctx=Load()),
                attr='model_name',
                ctx=Load())]))])])