Module(
  body=[
    Expr(
      value=Constant(value='\nTest KG Retrieval Executor\n\nTests knowledge graph retrieval execution functionality extracted from working legacy tests.\n')),
    Import(
      names=[
        alias(name='pytest')]),
    ImportFrom(
      module='l2.kg_retrieval_executor',
      names=[
        alias(name='KGRetrievalResult'),
        alias(name='execute_entity_query'),
        alias(name='execute_multi_hop_query')],
      level=0),
    ImportFrom(
      module='l4.triplet_store',
      names=[
        alias(name='TripletStore'),
        alias(name='create_triplet')],
      level=0),
    Assign(
      targets=[
        Name(id='pytestmark', ctx=Store())],
      value=List(
        elts=[
          Attribute(
            value=Attribute(
              value=Name(id='pytest', ctx=Load()),
              attr='mark',
              ctx=Load()),
            attr='unit',
            ctx=Load()),
          Attribute(
            value=Attribute(
              value=Name(id='pytest', ctx=Load()),
              attr='mark',
              ctx=Load()),
            attr='l2',
            ctx=Load()),
          Attribute(
            value=Attribute(
              value=Name(id='pytest', ctx=Load()),
              attr='mark',
              ctx=Load()),
            attr='execution',
            ctx=Load())],
        ctx=Load())),
    ClassDef(
      name='TestKGRetrievalExecutor',
      body=[
        Expr(
          value=Constant(value='Test L2 KG Retrieval Executor.')),
        FunctionDef(
          name='test_execute_entity_query',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test executing entity fact query.')),
            Assign(
              targets=[
                Name(id='store', ctx=Store())],
              value=Call(
                func=Name(id='TripletStore', ctx=Load()))),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='store', ctx=Load()),
                  attr='add_triplet',
                  ctx=Load()),
                args=[
                  Call(
                    func=Name(id='create_triplet', ctx=Load()),
                    args=[
                      Constant(value='user_1'),
                      Constant(value='has_skill'),
                      Constant(value='Python')])])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='store', ctx=Load()),
                  attr='add_triplet',
                  ctx=Load()),
                args=[
                  Call(
                    func=Name(id='create_triplet', ctx=Load()),
                    args=[
                      Constant(value='user_1'),
                      Constant(value='has_skill'),
                      Constant(value='AWS')])])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='store', ctx=Load()),
                  attr='add_triplet',
                  ctx=Load()),
                args=[
                  Call(
                    func=Name(id='create_triplet', ctx=Load()),
                    args=[
                      Constant(value='user_1'),
                      Constant(value='worked_at'),
                      Constant(value='Google')])])),
            Assign(
              targets=[
                Name(id='result', ctx=Store())],
              value=Call(
                func=Name(id='execute_entity_query', ctx=Load()),
                args=[
                  Name(id='store', ctx=Load()),
                  Constant(value='user_1')])),
            Assert(
              test=Call(
                func=Name(id='isinstance', ctx=Load()),
                args=[
                  Name(id='result', ctx=Load()),
                  Name(id='KGRetrievalResult', ctx=Load())])),
            Assert(
              test=Compare(
                left=Attribute(
                  value=Name(id='result', ctx=Load()),
                  attr='total_triplets',
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value=3)])),
            Assert(
              test=Compare(
                left=Constant(value='user_1'),
                ops=[
                  In()],
                comparators=[
                  Attribute(
                    value=Name(id='result', ctx=Load()),
                    attr='entities',
                    ctx=Load())]))]),
        FunctionDef(
          name='test_execute_multi_hop',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test multi-hop neighborhood query.')),
            Assign(
              targets=[
                Name(id='store', ctx=Store())],
              value=Call(
                func=Name(id='TripletStore', ctx=Load()))),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='store', ctx=Load()),
                  attr='add_triplet',
                  ctx=Load()),
                args=[
                  Call(
                    func=Name(id='create_triplet', ctx=Load()),
                    args=[
                      Constant(value='user_1'),
                      Constant(value='has_skill'),
                      Constant(value='Python')])])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='store', ctx=Load()),
                  attr='add_triplet',
                  ctx=Load()),
                args=[
                  Call(
                    func=Name(id='create_triplet', ctx=Load()),
                    args=[
                      Constant(value='job_1'),
                      Constant(value='requires_skill'),
                      Constant(value='Python')])])),
            Assign(
              targets=[
                Name(id='result', ctx=Store())],
              value=Call(
                func=Name(id='execute_multi_hop_query', ctx=Load()),
                args=[
                  Name(id='store', ctx=Load())],
                keywords=[
                  keyword(
                    arg='start_entity',
                    value=Constant(value='user_1')),
                  keyword(
                    arg='max_hops',
                    value=Constant(value=2))])),
            Assert(
              test=Compare(
                left=Attribute(
                  value=Name(id='result', ctx=Load()),
                  attr='total_triplets',
                  ctx=Load()),
                ops=[
                  GtE()],
                comparators=[
                  Constant(value=1)]))])])])