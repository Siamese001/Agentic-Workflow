Module(
  body=[
    ImportFrom(
      module='__future__',
      names=[
        alias(name='annotations')],
      level=0),
    ImportFrom(
      module='typing',
      names=[
        alias(name='List')],
      level=0),
    ImportFrom(
      module='core.models.models',
      names=[
        alias(name='ExecutionProfile')],
      level=0),
    ImportFrom(
      module='eval.golden_state.datasets',
      names=[
        alias(name='load_golden_inputs'),
        alias(name='load_golden_cases')],
      level=0),
    ImportFrom(
      module='eval.golden_state.evaluator',
      names=[
        alias(name='evaluate_case_output')],
      level=0),
    ImportFrom(
      module='eval.golden_state.judge',
      names=[
        alias(name='evaluate_output')],
      level=0),
    ImportFrom(
      module='eval.golden_state.models',
      names=[
        alias(name='EvalResult'),
        alias(name='GoldenOutput')],
      level=0),
    FunctionDef(
      name='_mock_agent_output',
      args=arguments(
        args=[
          arg(
            arg='input_text',
            annotation=Name(id='str', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='Acts as a deterministic stand-in for the real pipeline so golden tests can measure behavior without calling live resume agents.')),
        If(
          test=Compare(
            left=Constant(value='unethical'),
            ops=[
              In()],
            comparators=[
              Call(
                func=Attribute(
                  value=Name(id='input_text', ctx=Load()),
                  attr='lower',
                  ctx=Load()))]),
          body=[
            Return(
              value=Constant(value='I cannot assist with unethical behavior.'))]),
        Return(
          value=Constant(value='This is a professional, concise summary placeholder.'))],
      returns=Name(id='str', ctx=Load())),
    FunctionDef(
      name='run_all_golden_tests',
      args=arguments(
        args=[
          arg(
            arg='profile',
            annotation=Name(id='ExecutionProfile', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='Runs the golden-state suite against the current setup so teams can see how well the system would summarize or respond in key resume-related scenarios.')),
        AnnAssign(
          target=Name(id='results', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='EvalResult', ctx=Load()),
            ctx=Load()),
          value=List(ctx=Load()),
          simple=1),
        For(
          target=Name(id='tc', ctx=Store()),
          iter=Call(
            func=Name(id='load_golden_inputs', ctx=Load())),
          body=[
            Assign(
              targets=[
                Name(id='output', ctx=Store())],
              value=Call(
                func=Name(id='_mock_agent_output', ctx=Load()),
                args=[
                  Attribute(
                    value=Name(id='tc', ctx=Load()),
                    attr='input_text',
                    ctx=Load())])),
            Assign(
              targets=[
                Name(id='verdict', ctx=Store())],
              value=Call(
                func=Name(id='evaluate_output', ctx=Load()),
                args=[
                  Name(id='tc', ctx=Load()),
                  Name(id='output', ctx=Load())])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='results', ctx=Load()),
                  attr='append',
                  ctx=Load()),
                args=[
                  Call(
                    func=Name(id='EvalResult', ctx=Load()),
                    keywords=[
                      keyword(
                        arg='test_id',
                        value=Attribute(
                          value=Name(id='tc', ctx=Load()),
                          attr='id',
                          ctx=Load())),
                      keyword(
                        arg='verdict',
                        value=Name(id='verdict', ctx=Load())),
                      keyword(
                        arg='raw_output',
                        value=Name(id='output', ctx=Load())),
                      keyword(
                        arg='reasoning_trace',
                        value=List(ctx=Load()))])]))]),
        Return(
          value=Name(id='results', ctx=Load()))],
      returns=Subscript(
        value=Name(id='List', ctx=Load()),
        slice=Name(id='EvalResult', ctx=Load()),
        ctx=Load())),
    FunctionDef(
      name='run_golden_suite',
      args=arguments(
        args=[
          arg(
            arg='execution_profile',
            annotation=Name(id='ExecutionProfile', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='Runs golden cases end to end and attaches simple verdicts so it is easy to spot when resume behavior regresses across versions.')),
        AnnAssign(
          target=Name(id='outputs', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='GoldenOutput', ctx=Load()),
            ctx=Load()),
          value=List(ctx=Load()),
          simple=1),
        For(
          target=Name(id='case', ctx=Store()),
          iter=Call(
            func=Name(id='load_golden_cases', ctx=Load())),
          body=[
            Assign(
              targets=[
                Name(id='out', ctx=Store())],
              value=Call(
                func=Name(id='GoldenOutput', ctx=Load()),
                keywords=[
                  keyword(
                    arg='case_id',
                    value=Attribute(
                      value=Name(id='case', ctx=Load()),
                      attr='id',
                      ctx=Load())),
                  keyword(
                    arg='produced_keypoints',
                    value=Attribute(
                      value=Name(id='case', ctx=Load()),
                      attr='expected_keypoints',
                      ctx=Load())),
                  keyword(arg='correctness_map', value=Dict()),
                  keyword(arg='safety_decisions', value=Dict()),
                  keyword(arg='metacognition_summary', value=Dict()),
                  keyword(
                    arg='final_verdict',
                    value=Constant(value='borderline'))])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='outputs', ctx=Load()),
                  attr='append',
                  ctx=Load()),
                args=[
                  Call(
                    func=Name(id='evaluate_case_output', ctx=Load()),
                    args=[
                      Name(id='case', ctx=Load()),
                      Name(id='out', ctx=Load())])]))]),
        Return(
          value=Name(id='outputs', ctx=Load()))],
      returns=Subscript(
        value=Name(id='List', ctx=Load()),
        slice=Name(id='GoldenOutput', ctx=Load()),
        ctx=Load()))])