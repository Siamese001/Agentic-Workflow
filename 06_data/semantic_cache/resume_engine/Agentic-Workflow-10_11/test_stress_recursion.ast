Module(
  body=[
    Expr(
      value=Constant(value='Stress Tests for Recursion Depth.')),
    ClassDef(
      name='TestStressRecursion',
      body=[
        Expr(
          value=Constant(value='Stress tests for recursion depth.')),
        FunctionDef(
          name='test_deep_recursion_handling',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test handling of deep recursion.')),
            FunctionDef(
              name='recursive_sum',
              args=arguments(
                args=[
                  arg(arg='n'),
                  arg(arg='acc')],
                defaults=[
                  Constant(value=0)]),
              body=[
                If(
                  test=Compare(
                    left=Name(id='n', ctx=Load()),
                    ops=[
                      LtE()],
                    comparators=[
                      Constant(value=0)]),
                  body=[
                    Return(
                      value=Name(id='acc', ctx=Load()))]),
                Return(
                  value=Call(
                    func=Name(id='recursive_sum', ctx=Load()),
                    args=[
                      BinOp(
                        left=Name(id='n', ctx=Load()),
                        op=Sub(),
                        right=Constant(value=1)),
                      BinOp(
                        left=Name(id='acc', ctx=Load()),
                        op=Add(),
                        right=Name(id='n', ctx=Load()))]))]),
            Assign(
              targets=[
                Name(id='result', ctx=Store())],
              value=Call(
                func=Name(id='recursive_sum', ctx=Load()),
                args=[
                  Constant(value=100)])),
            Assert(
              test=Compare(
                left=Name(id='result', ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value=5050)]))]),
        FunctionDef(
          name='test_nested_structure_depth',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test nested structure depth handling.')),
            Assign(
              targets=[
                Name(id='depth', ctx=Store())],
              value=Constant(value=50)),
            Assign(
              targets=[
                Name(id='nested', ctx=Store())],
              value=Dict()),
            Assign(
              targets=[
                Name(id='current', ctx=Store())],
              value=Name(id='nested', ctx=Load())),
            For(
              target=Name(id='i', ctx=Store()),
              iter=Call(
                func=Name(id='range', ctx=Load()),
                args=[
                  Name(id='depth', ctx=Load())]),
              body=[
                Assign(
                  targets=[
                    Subscript(
                      value=Name(id='current', ctx=Load()),
                      slice=Constant(value='level'),
                      ctx=Store())],
                  value=Name(id='i', ctx=Load())),
                Assign(
                  targets=[
                    Subscript(
                      value=Name(id='current', ctx=Load()),
                      slice=Constant(value='child'),
                      ctx=Store())],
                  value=Dict()),
                Assign(
                  targets=[
                    Name(id='current', ctx=Store())],
                  value=Subscript(
                    value=Name(id='current', ctx=Load()),
                    slice=Constant(value='child'),
                    ctx=Load()))]),
            Assert(
              test=Compare(
                left=Subscript(
                  value=Name(id='nested', ctx=Load()),
                  slice=Constant(value='level'),
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value=0)]))])])])