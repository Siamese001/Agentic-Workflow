Module(
  body=[
    ImportFrom(
      module='tools.simulation',
      names=[
        alias(name='Engine')],
      level=0),
    ImportFrom(
      module='eval.simulation.models',
      names=[
        alias(name='SimScenario')],
      level=0),
    ImportFrom(
      module='eval.simulation.simulator',
      names=[
        alias(name='run_scenario')],
      level=0),
    FunctionDef(
      name='test_run_scenario_uses_existing_engine',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='scenarios', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='Engine', ctx=Load()),
              attr='list',
              ctx=Load()))),
        Assert(
          test=Name(id='scenarios', ctx=Load()),
          msg=Constant(value='Expected at least one registered simulation scenario')),
        Assign(
          targets=[
            Tuple(
              elts=[
                Name(id='scenario_id', ctx=Store()),
                Name(id='description', ctx=Store())],
              ctx=Store())],
          value=Call(
            func=Name(id='next', ctx=Load()),
            args=[
              Call(
                func=Name(id='iter', ctx=Load()),
                args=[
                  Call(
                    func=Attribute(
                      value=Name(id='scenarios', ctx=Load()),
                      attr='items',
                      ctx=Load()))])])),
        Assign(
          targets=[
            Name(id='scenario', ctx=Store())],
          value=Call(
            func=Name(id='SimScenario', ctx=Load()),
            keywords=[
              keyword(
                arg='id',
                value=Name(id='scenario_id', ctx=Load())),
              keyword(
                arg='description',
                value=Name(id='description', ctx=Load())),
              keyword(arg='initial_context', value=Dict()),
              keyword(
                arg='execution_profile_name',
                value=Constant(value='default')),
              keyword(
                arg='run_count',
                value=Constant(value=1))])),
        Assign(
          targets=[
            Name(id='outcome', ctx=Store())],
          value=Call(
            func=Name(id='run_scenario', ctx=Load()),
            args=[
              Name(id='scenario', ctx=Load())])),
        Assert(
          test=Compare(
            left=Attribute(
              value=Name(id='outcome', ctx=Load()),
              attr='scenario_id',
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Name(id='scenario_id', ctx=Load())]))])])