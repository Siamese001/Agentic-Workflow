Module(
  body=[
    ImportFrom(
      module='__future__',
      names=[
        alias(name='annotations')],
      level=0),
    ImportFrom(
      module='typing',
      names=[
        alias(name='List')],
      level=0),
    ImportFrom(
      module='meta.metacognition.models',
      names=[
        alias(name='Hypothesis')],
      level=0),
    FunctionDef(
      name='evaluate_hypotheses',
      args=arguments(
        args=[
          arg(
            arg='hypotheses',
            annotation=Subscript(
              value=Name(id='List', ctx=Load()),
              slice=Name(id='Hypothesis', ctx=Load()),
              ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='Return a new list of hypotheses with adjusted confidence.\n\n    Heuristics (purely deterministic):\n    - penalize very long or very short content slightly.\n    - if a hypothesis has no evidence_ids, reduce confidence.\n    - clamp confidence to [0, 1].\n    ')),
        AnnAssign(
          target=Name(id='evaluated', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='Hypothesis', ctx=Load()),
            ctx=Load()),
          value=List(ctx=Load()),
          simple=1),
        For(
          target=Name(id='h', ctx=Store()),
          iter=Name(id='hypotheses', ctx=Load()),
          body=[
            Assign(
              targets=[
                Name(id='conf', ctx=Store())],
              value=Call(
                func=Name(id='float', ctx=Load()),
                args=[
                  Attribute(
                    value=Name(id='h', ctx=Load()),
                    attr='confidence',
                    ctx=Load())])),
            Assign(
              targets=[
                Name(id='length', ctx=Store())],
              value=Call(
                func=Name(id='len', ctx=Load()),
                args=[
                  BoolOp(
                    op=Or(),
                    values=[
                      Attribute(
                        value=Name(id='h', ctx=Load()),
                        attr='content',
                        ctx=Load()),
                      Constant(value='')])])),
            If(
              test=BoolOp(
                op=Or(),
                values=[
                  Compare(
                    left=Name(id='length', ctx=Load()),
                    ops=[
                      Lt()],
                    comparators=[
                      Constant(value=20)]),
                  Compare(
                    left=Name(id='length', ctx=Load()),
                    ops=[
                      Gt()],
                    comparators=[
                      Constant(value=400)])]),
              body=[
                AugAssign(
                  target=Name(id='conf', ctx=Store()),
                  op=Mult(),
                  value=Constant(value=0.9))]),
            If(
              test=UnaryOp(
                op=Not(),
                operand=Attribute(
                  value=Name(id='h', ctx=Load()),
                  attr='evidence_ids',
                  ctx=Load())),
              body=[
                AugAssign(
                  target=Name(id='conf', ctx=Store()),
                  op=Mult(),
                  value=Constant(value=0.7))]),
            Assign(
              targets=[
                Name(id='conf', ctx=Store())],
              value=Call(
                func=Name(id='max', ctx=Load()),
                args=[
                  Constant(value=0.0),
                  Call(
                    func=Name(id='min', ctx=Load()),
                    args=[
                      Constant(value=1.0),
                      Name(id='conf', ctx=Load())])])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='evaluated', ctx=Load()),
                  attr='append',
                  ctx=Load()),
                args=[
                  Call(
                    func=Attribute(
                      value=Name(id='h', ctx=Load()),
                      attr='model_copy',
                      ctx=Load()),
                    keywords=[
                      keyword(
                        arg='update',
                        value=Dict(
                          keys=[
                            Constant(value='confidence')],
                          values=[
                            Name(id='conf', ctx=Load())]))])]))]),
        Return(
          value=Name(id='evaluated', ctx=Load()))],
      returns=Subscript(
        value=Name(id='List', ctx=Load()),
        slice=Name(id='Hypothesis', ctx=Load()),
        ctx=Load()))])