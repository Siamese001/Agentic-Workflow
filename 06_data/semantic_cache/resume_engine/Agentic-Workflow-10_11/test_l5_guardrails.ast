Module(
  body=[
    Expr(
      value=Constant(value='L5 Safety Guardrails Tests.')),
    ClassDef(
      name='TestL5Guardrails',
      body=[
        Expr(
          value=Constant(value='Tests for L5 safety guardrails.')),
        FunctionDef(
          name='test_content_guardrail',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test content guardrail enforcement.')),
            Assign(
              targets=[
                Name(id='content', ctx=Store())],
              value=Constant(value='safe resume content')),
            Assign(
              targets=[
                Name(id='blocked_terms', ctx=Store())],
              value=List(
                elts=[
                  Constant(value='SSN'),
                  Constant(value='password')],
                ctx=Load())),
            Assign(
              targets=[
                Name(id='is_safe', ctx=Store())],
              value=UnaryOp(
                op=Not(),
                operand=Call(
                  func=Name(id='any', ctx=Load()),
                  args=[
                    GeneratorExp(
                      elt=Compare(
                        left=Name(id='term', ctx=Load()),
                        ops=[
                          In()],
                        comparators=[
                          Name(id='content', ctx=Load())]),
                      generators=[
                        comprehension(
                          target=Name(id='term', ctx=Store()),
                          iter=Name(id='blocked_terms', ctx=Load()),
                          is_async=0)])]))),
            Assert(
              test=Compare(
                left=Name(id='is_safe', ctx=Load()),
                ops=[
                  Is()],
                comparators=[
                  Constant(value=True)]))]),
        FunctionDef(
          name='test_pii_guardrail',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test PII detection guardrail.')),
            Assign(
              targets=[
                Name(id='text', ctx=Store())],
              value=Constant(value='Hello World')),
            Assign(
              targets=[
                Name(id='has_pii', ctx=Store())],
              value=BoolOp(
                op=Or(),
                values=[
                  Compare(
                    left=Constant(value='SSN:'),
                    ops=[
                      In()],
                    comparators=[
                      Name(id='text', ctx=Load())]),
                  Compare(
                    left=Constant(value='DOB:'),
                    ops=[
                      In()],
                    comparators=[
                      Name(id='text', ctx=Load())])])),
            Assert(
              test=Compare(
                left=Name(id='has_pii', ctx=Load()),
                ops=[
                  Is()],
                comparators=[
                  Constant(value=False)]))])])])