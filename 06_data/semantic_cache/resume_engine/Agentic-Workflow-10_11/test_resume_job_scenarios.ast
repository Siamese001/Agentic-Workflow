                    test=Compare(
                      left=Name(id='total_requirements', ctx=Load()),
                      ops=[
                        Gt()],
                      comparators=[
                        Constant(value=0)]),
                    body=BinOp(
                      left=Name(id='covered_requirements', ctx=Load()),
                      op=Div(),
                      right=Name(id='total_requirements', ctx=Load())),
                    orelse=Constant(value=0.0))),
                Expr(
