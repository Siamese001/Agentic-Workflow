            Assign(
              targets=[
                Name(id='validation_results', ctx=Store())],
              value=List(ctx=Load())),
            For(
              target=Name(id='scenario', ctx=Store()),
              iter=Name(id='scenarios', ctx=Load()),
              body=[
                Assign(
                  targets=[
                    Name(id='outcome', ctx=Store())],
                  value=Subscript(
                    value=Name(id='scenario', ctx=Load()),
                    slice=Constant(value='outcome'),
                    ctx=Load())),
                Assign(
                  targets=[
                    Name(id='score', ctx=Store())],
                  value=Subscript(
                    value=Name(id='scenario', ctx=Load()),
                    slice=Constant(value='score'),
                    ctx=Load())),
                If(
                  test=Compare(
                    left=Name(id='outcome', ctx=Load()),
                    ops=[
                      Eq()],
                    comparators=[
                      Attribute(
                        value=Name(id='ExpectedOutcome', ctx=Load()),
                        attr='HIGH_MATCH',
                        ctx=Load())]),
                  body=[
                    Assign(
                      targets=[
                        Name(id='is_valid', ctx=Store())],
                      value=Compare(
                        left=Name(id='score', ctx=Load()),
                        ops=[
                          GtE()],
                        comparators=[
                          Constant(value=0.8)]))],
                  orelse=[
                    If(
                      test=Compare(
                        left=Name(id='outcome', ctx=Load()),
                        ops=[
                          Eq()],
                        comparators=[
                          Attribute(
                            value=Name(id='ExpectedOutcome', ctx=Load()),
                            attr='MEDIUM_MATCH',
                            ctx=Load())]),
                      body=[
                        Assign(
                          targets=[
                            Name(id='is_valid', ctx=Store())],
                          value=Compare(
                            left=Constant(value=0.5),
                            ops=[
                              LtE(),
                              LtE()],
                            comparators=[
                              Name(id='score', ctx=Load()),
                              Constant(value=0.8)]))],
                      orelse=[
                        If(
                          test=Compare(
                            left=Name(id='outcome', ctx=Load()),
                            ops=[
                              Eq()],
                            comparators=[
                              Attribute(
                                value=Name(id='ExpectedOutcome', ctx=Load()),
                                attr='LOW_MATCH',
                                ctx=Load())]),
                          body=[
                            Assign(
                              targets=[
                                Name(id='is_valid', ctx=Store())],
                              value=Compare(
                                left=Name(id='score', ctx=Load()),
                                ops=[
                                  Lt()],
                                comparators=[
                                  Constant(value=0.5)]))],
                          orelse=[
                            If(
                              test=Compare(
                                left=Name(id='outcome', ctx=Load()),
                                ops=[
                                  Eq()],
                                comparators=[
                                  Attribute(
                                    value=Name(id='ExpectedOutcome', ctx=Load()),
                                    attr='REJECT',
                                    ctx=Load())]),
                              body=[
                                Assign(
                                  targets=[
                                    Name(id='is_valid', ctx=Store())],
                                  value=Compare(
                                    left=Name(id='score', ctx=Load()),
                                    ops=[
                                      Eq()],
                                    comparators=[
                                      Constant(value=0.0)]))],
                              orelse=[
                                Assign(
                                  targets=[
                                    Name(id='is_valid', ctx=Store())],
                                  value=Constant(value=False))])])])]),
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='validation_results', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Dict(
                        keys=[
                          Constant(value='outcome'),
                          Constant(value='score'),
                          Constant(value='is_valid'),
                          Constant(value='expected_valid')],
                        values=[
                          Name(id='outcome', ctx=Load()),
                          Name(id='score', ctx=Load()),
                          Name(id='is_valid', ctx=Load()),
                          Subscript(
                            value=Name(id='scenario', ctx=Load()),
                            slice=Constant(value='should_be_valid'),
                            ctx=Load())])]))]),
            Assign(
              targets=[
                Name(id='invalid_scenarios', ctx=Store())],
              value=ListComp(
                elt=Name(id='result', ctx=Load()),
                generators=[
                  comprehension(
                    target=Name(id='result', ctx=Store()),
                    iter=Name(id='validation_results', ctx=Load()),
                    ifs=[
