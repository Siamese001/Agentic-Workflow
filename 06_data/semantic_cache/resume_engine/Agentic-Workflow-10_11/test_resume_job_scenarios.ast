                      Constant(value='should_be_valid')],
                    values=[
                      Attribute(
                        value=Name(id='ExpectedOutcome', ctx=Load()),
                        attr='MEDIUM_MATCH',
                        ctx=Load()),
                      Constant(value=0.3),
                      Constant(value=False)]),
                  Dict(
                    keys=[
                      Constant(value='outcome'),
                      Constant(value='score'),
                      Constant(value='should_be_valid')],
                    values=[
                      Attribute(
                        value=Name(id='ExpectedOutcome', ctx=Load()),
                        attr='LOW_MATCH',
                        ctx=Load()),
                      Constant(value=0.7),
                      Constant(value=False)]),
                  Dict(
                    keys=[
                      Constant(value='outcome'),
                      Constant(value='score'),
                      Constant(value='should_be_valid')],
                    values=[
                      Attribute(
                        value=Name(id='ExpectedOutcome', ctx=Load()),
                        attr='REJECT',
                        ctx=Load()),
                      Constant(value=0.1),
                      Constant(value=False)])],
