Module(
  body=[
    Expr(
      value=Constant(value='Tests for Instructional Injection v6 Prompts and Many-Shot Examples\n\nThis module validates:\n- v6 prompt structure and completeness\n- Many-shot example quality\n- Prompt integration with agents\n- Layer and extension functionality\n')),
    Import(
      names=[
        alias(name='pytest')]),
    ImportFrom(
      module='l1.instructional_injection_v6',
      names=[
        alias(name='InstructionalPrompt'),
        alias(name='InstructionalLayer'),
        alias(name='InstructionalExtension'),
        alias(name='LayerContent'),
        alias(name='ExtensionContent'),
        alias(name='create_l1_planner_prompt'),
        alias(name='create_l2_executor_prompt'),
        alias(name='add_rag_extension'),
        alias(name='add_cot_extension')],
      level=0),
    ImportFrom(
      module='l1.many_shot_examples',
      names=[
        alias(name='ExampleType'),
        alias(name='get_examples'),
        alias(name='format_examples_for_prompt'),
        alias(name='STRATEGY_PLANNING_EXAMPLES'),
        alias(name='RAG_PLANNING_EXAMPLES')],
      level=0),
    ImportFrom(
      module='l1.v6_prompt_integration',
      names=[
        alias(name='create_strategy_planner_prompt'),
        alias(name='create_rag_planner_prompt'),
        alias(name='create_qa_planner_prompt'),
        alias(name='create_safety_planner_prompt'),
        alias(name='create_strategy_executor_prompt'),
        alias(name='validate_v6_prompt')],
      level=0),
    ClassDef(
      name='TestInstructionalPromptStructure',
      body=[
        Expr(
          value=Constant(value='Test v6 prompt structure and functionality.')),
        FunctionDef(
          name='test_create_l1_planner_prompt',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test L1 planner prompt creation.')),
            Assign(
              targets=[
                Name(id='prompt', ctx=Store())],
              value=Call(
                func=Name(id='create_l1_planner_prompt', ctx=Load()),
                keywords=[
                  keyword(
                    arg='agent_name',
                    value=Constant(value='Test Planner')),
                  keyword(
                    arg='domain',
                    value=Constant(value='testing')),
                  keyword(
                    arg='objective',
                    value=Constant(value='Test objective'))])),
            Assert(
              test=Compare(
                left=Attribute(
                  value=Name(id='prompt', ctx=Load()),
                  attr='agent_type',
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value='planner')])),
            Assert(
              test=Compare(
                left=Attribute(
                  value=Name(id='prompt', ctx=Load()),
                  attr='layer_type',
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value='L1')])),
            Assert(
              test=Compare(
                left=Attribute(
                  value=Name(id='InstructionalLayer', ctx=Load()),
                  attr='AGENT_IDENTITY',
                  ctx=Load()),
                ops=[
                  In()],
                comparators=[
                  Attribute(
                    value=Name(id='prompt', ctx=Load()),
                    attr='layers',
                    ctx=Load())])),
            Assert(
              test=Compare(
                left=Attribute(
                  value=Name(id='InstructionalLayer', ctx=Load()),
                  attr='ROLE_DEFINITION',
                  ctx=Load()),
                ops=[
                  In()],
                comparators=[
                  Attribute(
                    value=Name(id='prompt', ctx=Load()),
                    attr='layers',
                    ctx=Load())])),
            Assert(
              test=Compare(
                left=Attribute(
                  value=Name(id='InstructionalLayer', ctx=Load()),
                  attr='PRIMARY_OBJECTIVE',
                  ctx=Load()),
                ops=[
                  In()],
                comparators=[
                  Attribute(
                    value=Name(id='prompt', ctx=Load()),
                    attr='layers',
                    ctx=Load())])),
            Assert(
              test=Compare(
                left=Attribute(
                  value=Name(id='InstructionalLayer', ctx=Load()),
                  attr='OUTPUT_FORMAT',
                  ctx=Load()),
                ops=[
                  In()],
                comparators=[
                  Attribute(
                    value=Name(id='prompt', ctx=Load()),
                    attr='layers',
                    ctx=Load())]))]),
        FunctionDef(
          name='test_create_l2_executor_prompt',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test L2 executor prompt creation.')),
            Assign(
              targets=[
                Name(id='prompt', ctx=Store())],
              value=Call(
                func=Name(id='create_l2_executor_prompt', ctx=Load()),
                keywords=[
                  keyword(
                    arg='agent_name',
                    value=Constant(value='Test Executor')),
                  keyword(
                    arg='domain',
                    value=Constant(value='testing')),
                  keyword(
                    arg='capabilities',
                    value=List(
                      elts=[
                        Constant(value='execute'),
                        Constant(value='validate')],
                      ctx=Load()))])),
            Assert(
              test=Compare(
                left=Attribute(
                  value=Name(id='prompt', ctx=Load()),
                  attr='agent_type',
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value='executor')])),
            Assert(
              test=Compare(
                left=Attribute(
                  value=Name(id='prompt', ctx=Load()),
                  attr='layer_type',
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value='L2')])),
            Assert(
              test=Compare(
                left=Attribute(
                  value=Name(id='InstructionalLayer', ctx=Load()),
                  attr='AGENT_IDENTITY',
                  ctx=Load()),
                ops=[
                  In()],
                comparators=[
                  Attribute(
                    value=Name(id='prompt', ctx=Load()),
                    attr='layers',
                    ctx=Load())])),
            Assert(
              test=Compare(
                left=Attribute(
                  value=Name(id='InstructionalLayer', ctx=Load()),
                  attr='ERROR_RECOVERY',
                  ctx=Load()),
                ops=[
                  In()],
                comparators=[
                  Attribute(
                    value=Name(id='prompt', ctx=Load()),
                    attr='layers',
                    ctx=Load())]))]),
        FunctionDef(
          name='test_add_rag_extension',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test RAG extension addition.')),
            Assign(
              targets=[
                Name(id='prompt', ctx=Store())],
              value=Call(
                func=Name(id='create_l1_planner_prompt', ctx=Load()),
                args=[
                  Constant(value='Test'),
                  Constant(value='test'),
                  Constant(value='test')])),
            Expr(
              value=Call(
                func=Name(id='add_rag_extension', ctx=Load()),
                args=[
                  Name(id='prompt', ctx=Load()),
                  Dict(
                    keys=[
                      Constant(value='top_k'),
                      Constant(value='score_threshold')],
                    values=[
                      Constant(value=5),
                      Constant(value=0.8)])])),
            Assert(
              test=Compare(
                left=Attribute(
                  value=Name(id='InstructionalExtension', ctx=Load()),
                  attr='RAG_INTEGRATION',
                  ctx=Load()),
                ops=[
                  In()],
                comparators=[
                  Attribute(
                    value=Name(id='prompt', ctx=Load()),
                    attr='extensions',
                    ctx=Load())])),
            Assign(
              targets=[
                Name(id='ext', ctx=Store())],
              value=Subscript(
                value=Attribute(
                  value=Name(id='prompt', ctx=Load()),
                  attr='extensions',
                  ctx=Load()),
                slice=Attribute(
                  value=Name(id='InstructionalExtension', ctx=Load()),
                  attr='RAG_INTEGRATION',
                  ctx=Load()),
                ctx=Load())),
            Assert(
              test=Attribute(
                value=Name(id='ext', ctx=Load()),
                attr='enabled',
                ctx=Load())),
            Assert(
              test=Compare(
                left=Constant(value='top_k'),
                ops=[
                  In()],
                comparators=[
                  Attribute(
                    value=Name(id='ext', ctx=Load()),
                    attr='metadata',
                    ctx=Load())]))]),
        FunctionDef(
          name='test_add_cot_extension',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test Chain-of-Thought extension addition.')),
            Assign(
              targets=[
                Name(id='prompt', ctx=Store())],
              value=Call(
                func=Name(id='create_l1_planner_prompt', ctx=Load()),
                args=[
                  Constant(value='Test'),
                  Constant(value='test'),
                  Constant(value='test')])),
            Expr(
              value=Call(
                func=Name(id='add_cot_extension', ctx=Load()),
                args=[
                  Name(id='prompt', ctx=Load())])),
            Assert(
              test=Compare(
                left=Attribute(
                  value=Name(id='InstructionalExtension', ctx=Load()),
                  attr='CHAIN_OF_THOUGHT',
                  ctx=Load()),
                ops=[
                  In()],
                comparators=[
                  Attribute(
                    value=Name(id='prompt', ctx=Load()),
                    attr='extensions',
                    ctx=Load())])),
            Assign(
              targets=[
                Name(id='ext', ctx=Store())],
              value=Subscript(
                value=Attribute(
                  value=Name(id='prompt', ctx=Load()),
                  attr='extensions',
                  ctx=Load()),
                slice=Attribute(
                  value=Name(id='InstructionalExtension', ctx=Load()),
                  attr='CHAIN_OF_THOUGHT',
                  ctx=Load()),
                ctx=Load())),
            Assert(
              test=Attribute(
                value=Name(id='ext', ctx=Load()),
                attr='enabled',
                ctx=Load())),
            Assert(
              test=Compare(
                left=Constant(value='step-by-step'),
                ops=[
                  In()],
                comparators=[
                  Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='ext', ctx=Load()),
                        attr='content',
                        ctx=Load()),
                      attr='lower',
                      ctx=Load()))]))]),
        FunctionDef(
          name='test_prompt_render',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test prompt rendering.')),
            Assign(
              targets=[
                Name(id='prompt', ctx=Store())],
              value=Call(
                func=Name(id='create_l1_planner_prompt', ctx=Load()),
                args=[
                  Constant(value='Test'),
                  Constant(value='test'),
                  Constant(value='test')])),
            Assign(
              targets=[
                Name(id='rendered', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='prompt', ctx=Load()),
                  attr='render',
                  ctx=Load()))),
            Assert(
              test=Compare(
                left=Constant(value='AGENT IDENTITY'),
                ops=[
                  In()],
                comparators=[
                  Name(id='rendered', ctx=Load())])),
            Assert(
              test=Compare(
                left=Constant(value='ROLE DEFINITION'),
                ops=[
                  In()],
                comparators=[
                  Name(id='rendered', ctx=Load())])),
            Assert(
              test=Compare(
                left=Constant(value='PRIMARY OBJECTIVE'),
                ops=[
                  In()],
                comparators=[
                  Name(id='rendered', ctx=Load())])),
            Assert(
              test=Compare(
                left=Constant(value='OUTPUT FORMAT'),
                ops=[
                  In()],
                comparators=[
                  Name(id='rendered', ctx=Load())]))]),
        FunctionDef(
          name='test_prompt_validation',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test prompt validation.')),
            Assign(
              targets=[
                Name(id='prompt', ctx=Store())],
              value=Call(
                func=Name(id='create_l1_planner_prompt', ctx=Load()),
                args=[
                  Constant(value='Test'),
                  Constant(value='test'),
                  Constant(value='test')])),
            Assign(
              targets=[
                Name(id='issues', ctx=Store())],
              value=Call(
                func=Name(id='validate_v6_prompt', ctx=Load()),
                args=[
                  Name(id='prompt', ctx=Load())])),
            Assert(
              test=Compare(
                left=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Name(id='issues', ctx=Load())]),
                ops=[
                  Gt()],
                comparators=[
                  Constant(value=0)]))])]),
    ClassDef(
      name='TestPromptIntegration',
      body=[
        Expr(
          value=Constant(value='Test prompt integration with specific agent types.')),
        FunctionDef(
          name='test_create_strategy_planner_prompt',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test strategy planner prompt creation.')),
            Assign(
              targets=[
                Name(id='prompt', ctx=Store())],
              value=Call(
                func=Name(id='create_strategy_planner_prompt', ctx=Load()),
                keywords=[
                  keyword(
                    arg='include_examples',
                    value=Constant(value=False))])),
            Assert(
              test=Compare(
                left=Constant(value='Strategy Planner'),
                ops=[
                  In()],
                comparators=[
                  Name(id='prompt', ctx=Load())])),
            Assert(
              test=Compare(
                left=Constant(value='planning'),
                ops=[
                  In()],
                comparators=[
                  Call(
                    func=Attribute(
                      value=Name(id='prompt', ctx=Load()),
                      attr='lower',
