            Assign(
              targets=[
                Name(id='prompt', ctx=Store())],
              value=Call(
                func=Name(id='create_qa_planner_prompt', ctx=Load()),
                keywords=[
                  keyword(
                    arg='include_examples',
                    value=Constant(value=False))])),
            Assert(
              test=Compare(
                left=Constant(value='QA Planner'),
                ops=[
                  In()],
                comparators=[
                  Name(id='prompt', ctx=Load())])),
            Assert(
              test=Compare(
                left=Constant(value='quality assurance'),
                ops=[
                  In()],
                comparators=[
                  Call(
                    func=Attribute(
                      value=Name(id='prompt', ctx=Load()),
                      attr='lower',
                      ctx=Load()))]))]),
        FunctionDef(
          name='test_create_safety_planner_prompt',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test safety planner prompt creation.')),
            Assign(
              targets=[
                Name(id='prompt', ctx=Store())],
              value=Call(
                func=Name(id='create_safety_planner_prompt', ctx=Load()),
                keywords=[
                  keyword(
                    arg='include_examples',
                    value=Constant(value=False))])),
            Assert(
              test=Compare(
                left=Constant(value='Safety Planner'),
                ops=[
                  In()],
                comparators=[
                  Name(id='prompt', ctx=Load())])),
            Assert(
              test=Compare(
                left=Constant(value='SAFETY CONSTRAINTS'),
                ops=[
                  In()],
                comparators=[
                  Name(id='prompt', ctx=Load())])),
            Assert(
              test=Compare(
                left=Constant(value='ETHICAL GUIDELINES'),
                ops=[
                  In()],
                comparators=[
                  Name(id='prompt', ctx=Load())]))]),
        FunctionDef(
          name='test_create_strategy_executor_prompt',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test strategy executor prompt creation.')),
            Assign(
              targets=[
                Name(id='prompt', ctx=Store())],
              value=Call(
                func=Name(id='create_strategy_executor_prompt', ctx=Load()),
                keywords=[
                  keyword(
                    arg='include_examples',
