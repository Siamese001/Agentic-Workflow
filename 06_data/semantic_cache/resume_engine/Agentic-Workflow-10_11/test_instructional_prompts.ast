                ops=[
                  In()],
                comparators=[
                  Call(
                    func=Attribute(
                      value=Name(id='prompt', ctx=Load()),
                      attr='lower',
                      ctx=Load()))]))]),
        FunctionDef(
          name='test_validate_v6_prompt_l1',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test v6 prompt validation for L1.')),
            Assign(
              targets=[
                Name(id='prompt', ctx=Store())],
              value=Call(
                func=Name(id='create_l1_planner_prompt', ctx=Load()),
                args=[
                  Constant(value='Test'),
                  Constant(value='test'),
                  Constant(value='test')])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='prompt', ctx=Load()),
                  attr='add_layer',
                  ctx=Load()),
                args=[
                  Call(
                    func=Name(id='LayerContent', ctx=Load()),
                    keywords=[
                      keyword(
                        arg='layer',
                        value=Attribute(
                          value=Name(id='InstructionalLayer', ctx=Load()),
                          attr='REASONING_MODE',
                          ctx=Load())),
                      keyword(
                        arg='content',
                        value=Constant(value='analytical'))])])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='prompt', ctx=Load()),
                  attr='add_layer',
                  ctx=Load()),
                args=[
                  Call(
                    func=Name(id='LayerContent', ctx=Load()),
                    keywords=[
                      keyword(
                        arg='layer',
                        value=Attribute(
                          value=Name(id='InstructionalLayer', ctx=Load()),
                          attr='DOMAIN_KNOWLEDGE',
                          ctx=Load())),
                      keyword(
                        arg='content',
                        value=Constant(value='test knowledge'))])])),
            Assign(
              targets=[
                Name(id='issues', ctx=Store())],
              value=Call(
                func=Name(id='validate_v6_prompt', ctx=Load()),
                args=[
                  Name(id='prompt', ctx=Load())])),
            Assert(
              test=Compare(
                left=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Name(id='issues', ctx=Load())]),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value=0)]))]),
        FunctionDef(
          name='test_validate_v6_prompt_l2',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test v6 prompt validation for L2.')),
            Assign(
              targets=[
                Name(id='prompt', ctx=Store())],
              value=Call(
                func=Name(id='create_l2_executor_prompt', ctx=Load()),
                args=[
                  Constant(value='Test'),
