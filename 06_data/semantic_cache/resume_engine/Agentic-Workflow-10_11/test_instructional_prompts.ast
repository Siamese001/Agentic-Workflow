                left=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Name(id='issues', ctx=Load())]),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value=0)]))])]),
    ClassDef(
      name='TestManyShotExamples',
      body=[
        Expr(
          value=Constant(value='Test many-shot example quality and structure.')),
        FunctionDef(
          name='test_examples_have_valid_structure',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test that all examples have valid structure.')),
            Assign(
              targets=[
                Name(id='all_examples', ctx=Store())],
              value=BinOp(
                left=Name(id='STRATEGY_PLANNING_EXAMPLES', ctx=Load()),
                op=Add(),
                right=Name(id='RAG_PLANNING_EXAMPLES', ctx=Load()))),
            For(
              target=Name(id='example', ctx=Store()),
              iter=Name(id='all_examples', ctx=Load()),
              body=[
                Assert(
                  test=Attribute(
                    value=Name(id='example', ctx=Load()),
                    attr='example_id',
                    ctx=Load())),
                Assert(
                  test=Attribute(
                    value=Name(id='example', ctx=Load()),
                    attr='description',
                    ctx=Load())),
                Assert(
                  test=Call(
                    func=Name(id='isinstance', ctx=Load()),
                    args=[
                      Attribute(
                        value=Name(id='example', ctx=Load()),
                        attr='input_data',
                        ctx=Load()),
                      Name(id='dict', ctx=Load())])),
                Assert(
                  test=Call(
                    func=Name(id='isinstance', ctx=Load()),
                    args=[
                      Attribute(
                        value=Name(id='example', ctx=Load()),
                        attr='expected_output',
                        ctx=Load()),
                      Name(id='dict', ctx=Load())])),
                Assert(
                  test=Compare(
                    left=Constant(value=0.0),
                    ops=[
                      LtE(),
                      LtE()],
                    comparators=[
                      Attribute(
                        value=Name(id='example', ctx=Load()),
                        attr='quality_score',
                        ctx=Load()),
                      Constant(value=1.0)]))])]),
        FunctionDef(
          name='test_format_examples_for_prompt',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test example formatting for prompt inclusion.')),
            Assign(
              targets=[
                Name(id='examples', ctx=Store())],
              value=Call(
                func=Name(id='get_examples', ctx=Load()),
                args=[
                  Attribute(
                    value=Name(id='ExampleType', ctx=Load()),
                    attr='STRATEGY_PLANNING',
                    ctx=Load())],
                keywords=[
                  keyword(
                    arg='limit',
                    value=Constant(value=2))])),
            Assign(
              targets=[
                Name(id='formatted', ctx=Store())],
              value=Call(
                func=Name(id='format_examples_for_prompt', ctx=Load()),
                args=[
                  Name(id='examples', ctx=Load())])),
            Assert(
              test=Call(
                func=Name(id='isinstance', ctx=Load()),
                args=[
                  Name(id='formatted', ctx=Load()),
                  Name(id='str', ctx=Load())])),
            Assert(
              test=Compare(
                left=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Name(id='formatted', ctx=Load())]),
                ops=[
                  Gt()],
                comparators=[
                  Constant(value=0)])),
            Assert(
              test=Compare(
                left=Constant(value='EXAMPLE'),
                ops=[
                  In()],
                comparators=[
                  Name(id='formatted', ctx=Load())]))]),
        FunctionDef(
          name='test_example_quality_filtering',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test that examples can be filtered by quality.')),
            Assign(
              targets=[
                Name(id='examples', ctx=Store())],
              value=Call(
                func=Name(id='get_examples', ctx=Load()),
                args=[
                  Attribute(
                    value=Name(id='ExampleType', ctx=Load()),
                    attr='STRATEGY_PLANNING',
                    ctx=Load())],
                keywords=[
                  keyword(
                    arg='min_quality',
                    value=Constant(value=0.8))])),
            For(
              target=Name(id='example', ctx=Store()),
              iter=Name(id='examples', ctx=Load()),
              body=[
                Assert(
                  test=Compare(
                    left=Attribute(
                      value=Name(id='example', ctx=Load()),
                      attr='quality_score',
                      ctx=Load()),
                    ops=[
                      GtE()],
                    comparators=[
                      Constant(value=0.8)]))])])]),
    ClassDef(
      name='TestPromptQuality',
      body=[
        Expr(
          value=Constant(value='Test prompt quality and completeness.')),
        FunctionDef(
          name='test_all_l1_prompts_have_required_layers',
          args=arguments(
            args=[
              arg(arg='self')]),
