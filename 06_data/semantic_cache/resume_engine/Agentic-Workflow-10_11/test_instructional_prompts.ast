                  List(
                    elts=[
                      Constant(value='execute')],
                    ctx=Load())])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='prompt', ctx=Load()),
                  attr='add_layer',
                  ctx=Load()),
                args=[
