                  In()],
                comparators=[
                  Call(
                    func=Attribute(
                      value=Name(id='prompt', ctx=Load()),
                      attr='lower',
                      ctx=Load()))]))]),
        FunctionDef(
          name='test_create_qa_planner_prompt',
          args=arguments(
            args=[
