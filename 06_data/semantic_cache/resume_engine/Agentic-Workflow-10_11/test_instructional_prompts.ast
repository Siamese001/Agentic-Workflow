              targets=[
                Name(id='prompt', ctx=Store())],
              value=Call(
                func=Name(id='create_rag_planner_prompt', ctx=Load()),
                keywords=[
                  keyword(
                    arg='include_examples',
                    value=Constant(value=False))])),
            Assert(
              test=Compare(
                left=Constant(value='RAG Planner'),
                ops=[
                  In()],
                comparators=[
                  Name(id='prompt', ctx=Load())])),
            Assert(
              test=Compare(
                left=Constant(value='retrieval'),
