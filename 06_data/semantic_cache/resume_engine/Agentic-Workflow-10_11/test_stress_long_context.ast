Module(
  body=[
    Expr(
      value=Constant(value='Stress Tests for Long Context.')),
    ClassDef(
      name='TestStressLongContext',
      body=[
        Expr(
          value=Constant(value='Stress tests for long context handling.')),
        FunctionDef(
          name='test_large_text_processing',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test processing of large text content.')),
            Assign(
              targets=[
                Name(id='large_text', ctx=Store())],
              value=BinOp(
                left=Constant(value='word '),
                op=Mult(),
                right=Constant(value=10000))),
            Assign(
              targets=[
                Name(id='word_count', ctx=Store())],
              value=Call(
                func=Name(id='len', ctx=Load()),
                args=[
                  Call(
                    func=Attribute(
                      value=Name(id='large_text', ctx=Load()),
                      attr='split',
                      ctx=Load()))])),
            Assert(
              test=Compare(
                left=Name(id='word_count', ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value=10000)]))]),
        FunctionDef(
          name='test_large_document_chunking',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test large document chunking.')),
            Assign(
              targets=[
                Name(id='doc', ctx=Store())],
              value=BinOp(
                left=Constant(value='sentence. '),
                op=Mult(),
                right=Constant(value=1000))),
            Assign(
              targets=[
                Name(id='chunks', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='doc', ctx=Load()),
                  attr='split',
                  ctx=Load()),
                args=[
                  Constant(value='. ')])),
            Assert(
              test=Compare(
                left=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Name(id='chunks', ctx=Load())]),
                ops=[
                  Gt()],
                comparators=[
                  Constant(value=100)]))])])])