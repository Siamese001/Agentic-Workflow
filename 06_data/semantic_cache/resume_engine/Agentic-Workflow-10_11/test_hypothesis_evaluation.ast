Module(
  body=[
    ImportFrom(
      module='meta.metacognition.evaluator',
      names=[
        alias(name='evaluate_hypotheses')],
      level=0),
    ImportFrom(
      module='meta.metacognition.models',
      names=[
        alias(name='Hypothesis')],
      level=0),
    FunctionDef(
      name='test_evaluate_penalizes_no_evidence',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='h', ctx=Store())],
          value=Call(
            func=Name(id='Hypothesis', ctx=Load()),
            keywords=[
              keyword(
                arg='id',
                value=Constant(value='h1')),
              keyword(
                arg='agent_id',
                value=Constant(value='a1')),
              keyword(
                arg='content',
                value=Constant(value='short')),
              keyword(
                arg='confidence',
                value=Constant(value=1.0)),
              keyword(
                arg='evidence_ids',
                value=List(ctx=Load()))])),
        Assign(
          targets=[
            Name(id='evaluated', ctx=Store())],
          value=Subscript(
            value=Call(
              func=Name(id='evaluate_hypotheses', ctx=Load()),
              args=[
                List(
                  elts=[
                    Name(id='h', ctx=Load())],
                  ctx=Load())]),
            slice=Constant(value=0),
            ctx=Load())),
        Assert(
          test=Compare(
            left=Attribute(
              value=Name(id='evaluated', ctx=Load()),
              attr='confidence',
              ctx=Load()),
            ops=[
              Lt()],
            comparators=[
              Constant(value=1.0)]))]),
    FunctionDef(
      name='test_evaluate_clamps_confidence_range',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='h', ctx=Store())],
          value=Call(
            func=Name(id='Hypothesis', ctx=Load()),
            keywords=[
              keyword(
                arg='id',
                value=Constant(value='h1')),
              keyword(
                arg='agent_id',
                value=Constant(value='a1')),
              keyword(
                arg='content',
                value=BinOp(
                  left=Constant(value='x'),
                  op=Mult(),
                  right=Constant(value=10))),
              keyword(
                arg='confidence',
                value=Constant(value=10.0)),
              keyword(
                arg='evidence_ids',
                value=List(
                  elts=[
                    Constant(value='e1')],
                  ctx=Load()))])),
        Assign(
          targets=[
            Name(id='evaluated', ctx=Store())],
          value=Subscript(
            value=Call(
              func=Name(id='evaluate_hypotheses', ctx=Load()),
              args=[
                List(
                  elts=[
                    Name(id='h', ctx=Load())],
                  ctx=Load())]),
            slice=Constant(value=0),
            ctx=Load())),
        Assert(
          test=Compare(
            left=Constant(value=0.0),
            ops=[
              LtE(),
              LtE()],
            comparators=[
              Attribute(
                value=Name(id='evaluated', ctx=Load()),
                attr='confidence',
                ctx=Load()),
              Constant(value=1.0)]))])])