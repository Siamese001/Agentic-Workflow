Module(
  body=[
    ImportFrom(
      module='orchestration.agent_registry',
      names=[
        alias(name='AgentRegistry')],
      level=0),
    ImportFrom(
      module='core.agent_router_policy',
      names=[
        alias(name='choose_agents_for_task')],
      level=0),
    ImportFrom(
      module='config.agent_profile',
      names=[
        alias(name='AgentCard')],
      level=0),
    ImportFrom(
      module='core.models.models',
      names=[
        alias(name='AgentRole')],
      level=0),
    FunctionDef(
      name='test_choose_agents_for_strategy_task_prefers_planner',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='registry', ctx=Store())],
          value=Call(
            func=Name(id='AgentRegistry', ctx=Load()))),
        Assign(
          targets=[
            Name(id='planner', ctx=Store())],
          value=Call(
            func=Name(id='AgentCard', ctx=Load()),
            keywords=[
              keyword(
                arg='agent_id',
                value=Constant(value='planner-1')),
              keyword(
                arg='role',
                value=Attribute(
                  value=Name(id='AgentRole', ctx=Load()),
                  attr='PLANNER',
                  ctx=Load())),
              keyword(
                arg='agent_type',
                value=Constant(value='planner'))])),
        Assign(
          targets=[
            Name(id='researcher', ctx=Store())],
          value=Call(
            func=Name(id='AgentCard', ctx=Load()),
            keywords=[
              keyword(
                arg='agent_id',
                value=Constant(value='researcher-1')),
              keyword(
                arg='role',
                value=Attribute(
                  value=Name(id='AgentRole', ctx=Load()),
                  attr='EXECUTION',
                  ctx=Load())),
              keyword(
                arg='agent_type',
                value=Constant(value='researcher'))])),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='registry', ctx=Load()),
              attr='register_agent',
              ctx=Load()),
            args=[
              Name(id='planner', ctx=Load())])),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='registry', ctx=Load()),
              attr='register_agent',
              ctx=Load()),
            args=[
              Name(id='researcher', ctx=Load())])),
        Assign(
          targets=[
            Name(id='chosen', ctx=Store())],
          value=Call(
            func=Name(id='choose_agents_for_task', ctx=Load()),
            args=[
              Constant(value='strategy'),
              Name(id='registry', ctx=Load())])),
        Assert(
          test=Compare(
            left=Name(id='planner', ctx=Load()),
            ops=[
              In()],
            comparators=[
              Name(id='chosen', ctx=Load())]))])])