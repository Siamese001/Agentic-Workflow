Module(
  body=[
    Expr(
      value=Constant(value='\nJudge engine for résumé processing safety verdict generation.\n\nProvides deterministic safety evaluation for comprehensive résumé improvement workflows.\n')),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Any'),
        alias(name='Dict')],
      level=0),
    ImportFrom(
      module='decisions',
      names=[
        alias(name='JudgeVerdict'),
        alias(name='RulesEngineResult')],
      level=1),
    ImportFrom(
      module='models',
      names=[
        alias(name='SafetyContext')],
      level=1),
    FunctionDef(
      name='evaluate_with_guard_model',
      args=arguments(
        args=[
          arg(
            arg='context',
            annotation=Name(id='SafetyContext', ctx=Load())),
          arg(
            arg='rules_result',
            annotation=Name(id='RulesEngineResult', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Evaluates résumé processing safety with deterministic guard model.\n\n    Provides structured safety assessment for comprehensive résumé enhancement operations.\n    ')),
        AnnAssign(
          target=Name(id='signals', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='Any', ctx=Load())],
              ctx=Load()),
            ctx=Load()),
          value=Dict(
            keys=[
              Constant(value='max_severity'),
              Constant(value='match_count'),
              Constant(value='has_pii')],
            values=[
              Attribute(
                value=Name(id='rules_result', ctx=Load()),
                attr='max_severity',
                ctx=Load()),
              Call(
                func=Name(id='len', ctx=Load()),
                args=[
                  Attribute(
                    value=Name(id='rules_result', ctx=Load()),
                    attr='matches',
                    ctx=Load())]),
              Attribute(
                value=Name(id='rules_result', ctx=Load()),
                attr='has_pii',
                ctx=Load())]),
          simple=1),
        Assign(
          targets=[
            Name(id='max_sev', ctx=Store())],
          value=Call(
            func=Attribute(
              value=BoolOp(
                op=Or(),
                values=[
                  Attribute(
                    value=Name(id='rules_result', ctx=Load()),
                    attr='max_severity',
                    ctx=Load()),
                  Constant(value='')]),
              attr='lower',
              ctx=Load()))),
        If(
          test=Compare(
            left=Name(id='max_sev', ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value='high')]),
          body=[
            Return(
              value=Call(
                func=Name(id='JudgeVerdict', ctx=Load()),
                keywords=[
                  keyword(
                    arg='verdict',
                    value=Constant(value='unsafe')),
                  keyword(
                    arg='explanation',
                    value=Constant(value='High-severity safety rules matched in deterministic guard.')),
                  keyword(
                    arg='signals',
                    value=Name(id='signals', ctx=Load()))]))]),
        If(
          test=BoolOp(
            op=Or(),
            values=[
              Compare(
                left=Name(id='max_sev', ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value='medium')]),
              Attribute(
                value=Name(id='rules_result', ctx=Load()),
                attr='has_pii',
                ctx=Load())]),
          body=[
            Return(
              value=Call(
                func=Name(id='JudgeVerdict', ctx=Load()),
                keywords=[
                  keyword(
                    arg='verdict',
                    value=Constant(value='ambiguous')),
                  keyword(
                    arg='explanation',
                    value=Constant(value='Medium-severity or PII-related signals detected; recommend revision.')),
                  keyword(
                    arg='signals',
                    value=Name(id='signals', ctx=Load()))]))]),
        Return(
          value=Call(
            func=Name(id='JudgeVerdict', ctx=Load()),
            keywords=[
              keyword(
                arg='verdict',
                value=Constant(value='safe')),
              keyword(
                arg='explanation',
                value=Constant(value='No significant safety rule matches detected.')),
              keyword(
                arg='signals',
                value=Name(id='signals', ctx=Load()))]))],
      returns=Name(id='JudgeVerdict', ctx=Load()))])