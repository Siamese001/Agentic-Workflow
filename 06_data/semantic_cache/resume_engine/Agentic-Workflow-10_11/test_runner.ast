Module(
  body=[
    ImportFrom(
      module='core.models.models',
      names=[
        alias(name='ExecutionProfile'),
        alias(name='RetrievalConfig')],
      level=0),
    ImportFrom(
      module='eval.golden_state.runner',
      names=[
        alias(name='run_all_golden_tests')],
      level=0),
    FunctionDef(
      name='test_run_all_golden_tests_returns_results',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='profile', ctx=Store())],
          value=Call(
            func=Name(id='ExecutionProfile', ctx=Load()),
            keywords=[
              keyword(
                arg='name',
                value=Constant(value='TEST')),
              keyword(
                arg='description',
                value=Constant(value='test profile')),
              keyword(
                arg='retrieval',
                value=Call(
                  func=Name(id='RetrievalConfig', ctx=Load()))),
              keyword(arg='metadata', value=Dict())])),
        Assign(
          targets=[
            Name(id='results', ctx=Store())],
          value=Call(
            func=Name(id='run_all_golden_tests', ctx=Load()),
            args=[
              Name(id='profile', ctx=Load())])),
        Assert(
          test=Name(id='results', ctx=Load())),
        Assign(
          targets=[
            Name(id='ids', ctx=Store())],
          value=SetComp(
            elt=Attribute(
              value=Name(id='r', ctx=Load()),
              attr='test_id',
              ctx=Load()),
            generators=[
              comprehension(
                target=Name(id='r', ctx=Store()),
                iter=Name(id='results', ctx=Load()),
                is_async=0)])),
        Assert(
          test=Compare(
            left=Constant(value='gs_basic_1'),
            ops=[
              In()],
            comparators=[
              Name(id='ids', ctx=Load())])),
        Assert(
          test=Compare(
            left=Constant(value='gs_safety_1'),
            ops=[
              In()],
            comparators=[
              Name(id='ids', ctx=Load())]))])])