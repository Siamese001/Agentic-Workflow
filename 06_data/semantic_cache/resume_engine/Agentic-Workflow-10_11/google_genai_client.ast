Module(
  body=[
    Expr(
      value=Constant(value='Google Generative AI (Gemini) client adapter for v10_10.\n\nThis module is the ONLY place where google.generativeai is imported.\nIt exposes a narrow run_llm interface used by runtime_utils.\n')),
    ImportFrom(
      module='__future__',
      names=[
        alias(name='annotations')],
      level=0),
    Import(
      names=[
        alias(name='os')]),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Any')],
      level=0),
    FunctionDef(
      name='run_llm_google',
      args=arguments(
        args=[
          arg(
            arg='model',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='prompt',
            annotation=Name(id='str', ctx=Load()))],
        kwonlyargs=[
          arg(
            arg='temperature',
            annotation=Name(id='float', ctx=Load())),
          arg(
            arg='max_tokens',
            annotation=Name(id='int', ctx=Load())),
          arg(
            arg='timeout_s',
            annotation=Name(id='int', ctx=Load()))],
        kw_defaults=[
          None,
          None,
          None]),
      body=[
        Expr(
          value=Constant(value='Run a Gemini generate_content call and return the response text.')),
        Try(
          body=[
            Import(
              names=[
                alias(name='google.generativeai', asname='genai')])],
          handlers=[
            ExceptHandler(
              type=Name(id='ImportError', ctx=Load()),
              name='exc',
              body=[
                Raise(
                  exc=Call(
                    func=Name(id='ImportError', ctx=Load()),
                    args=[
                      Constant(value='google-generativeai package not installed')]),
                  cause=Name(id='exc', ctx=Load()))])]),
        Assign(
          targets=[
            Name(id='api_key', ctx=Store())],
          value=BoolOp(
            op=Or(),
            values=[
              Call(
                func=Attribute(
                  value=Name(id='os', ctx=Load()),
                  attr='getenv',
                  ctx=Load()),
                args=[
                  Constant(value='GOOGLE_API_KEY')]),
              Call(
                func=Attribute(
                  value=Name(id='os', ctx=Load()),
                  attr='getenv',
                  ctx=Load()),
                args=[
                  Constant(value='GEMINI_API_KEY')])])),
        If(
          test=UnaryOp(
            op=Not(),
            operand=Name(id='api_key', ctx=Load())),
          body=[
            Raise(
              exc=Call(
                func=Name(id='RuntimeError', ctx=Load()),
                args=[
                  Constant(value='GOOGLE_API_KEY or GEMINI_API_KEY must be set for Google provider')]))]),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='genai', ctx=Load()),
              attr='configure',
              ctx=Load()),
            keywords=[
              keyword(
                arg='api_key',
                value=Name(id='api_key', ctx=Load()))])),
        Assign(
          targets=[
            Name(id='model_client', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='genai', ctx=Load()),
              attr='GenerativeModel',
              ctx=Load()),
            args=[
              Name(id='model', ctx=Load())])),
        AnnAssign(
          target=Name(id='resp', ctx=Store()),
          annotation=Name(id='Any', ctx=Load()),
          value=Call(
            func=Attribute(
              value=Name(id='model_client', ctx=Load()),
              attr='generate_content',
              ctx=Load()),
            args=[
              Name(id='prompt', ctx=Load())]),
          simple=1),
        Return(
          value=Call(
            func=Name(id='str', ctx=Load()),
            args=[
              BoolOp(
                op=Or(),
                values=[
                  Call(
                    func=Name(id='getattr', ctx=Load()),
                    args=[
                      Name(id='resp', ctx=Load()),
                      Constant(value='text'),
                      Constant(value='')]),
                  Constant(value='')])]))],
      returns=Name(id='str', ctx=Load()))])