Module(
  body=[
    Expr(
      value=Constant(value='L4 Memory State Unit Tests - Core.')),
    ClassDef(
      name='TestL4MemoryStateUnitCore',
      body=[
        Expr(
          value=Constant(value='Core unit tests for L4 memory state layer.')),
        FunctionDef(
          name='test_state_store_initialization',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test state store initialization.')),
            Assign(
              targets=[
                Name(id='store', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='entries'),
                  Constant(value='initialized')],
                values=[
                  List(ctx=Load()),
                  Constant(value=True)])),
            Assert(
              test=Compare(
                left=Subscript(
                  value=Name(id='store', ctx=Load()),
                  slice=Constant(value='initialized'),
                  ctx=Load()),
                ops=[
                  Is()],
                comparators=[
                  Constant(value=True)]))]),
        FunctionDef(
          name='test_memory_entry_creation',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test memory entry creation.')),
            Assign(
              targets=[
                Name(id='entry', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='id'),
                  Constant(value='content'),
                  Constant(value='timestamp')],
                values=[
                  Constant(value='e1'),
                  Constant(value='data'),
                  Constant(value=1000)])),
            Assert(
              test=Compare(
                left=Subscript(
                  value=Name(id='entry', ctx=Load()),
                  slice=Constant(value='id'),
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value='e1')]))]),
        FunctionDef(
          name='test_state_serialization',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test state serialization.')),
            Assign(
              targets=[
                Name(id='state', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='key')],
                values=[
                  Constant(value='value')])),
            Assign(
              targets=[
                Name(id='serialized', ctx=Store())],
              value=Call(
                func=Name(id='str', ctx=Load()),
                args=[
                  Name(id='state', ctx=Load())])),
            Assert(
              test=Compare(
                left=Constant(value='key'),
                ops=[
                  In()],
                comparators=[
                  Name(id='serialized', ctx=Load())]))]),
        FunctionDef(
          name='test_state_deserialization',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test state deserialization.')),
            Assign(
              targets=[
                Name(id='data', ctx=Store())],
              value=Constant(value='{"key": "value"}')),
            Assert(
              test=Compare(
                left=Constant(value='key'),
                ops=[
                  In()],
                comparators=[
                  Name(id='data', ctx=Load())]))]),
        FunctionDef(
          name='test_memory_indexing',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test memory indexing.')),
            Assign(
              targets=[
                Name(id='index', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='term1'),
                  Constant(value='term2')],
                values=[
                  List(
                    elts=[
                      Constant(value=0),
                      Constant(value=1)],
                    ctx=Load()),
                  List(
                    elts=[
                      Constant(value=2)],
                    ctx=Load())])),
            Assert(
              test=Compare(
                left=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Subscript(
                      value=Name(id='index', ctx=Load()),
                      slice=Constant(value='term1'),
                      ctx=Load())]),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value=2)]))])])])