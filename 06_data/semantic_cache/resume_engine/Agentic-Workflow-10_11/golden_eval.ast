      name='evaluate_patch',
      args=arguments(
        args=[
          arg(
            arg='state_patch',
            annotation=Subscript(
              value=Name(id='Mapping', ctx=Load()),
              slice=Tuple(
                elts=[
                  Name(id='str', ctx=Load()),
                  Name(id='Any', ctx=Load())],
                ctx=Load()),
              ctx=Load())),
          arg(
            arg='expectation',
            annotation=Name(id='GoldenExpectation', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Evaluate a single state patch (typically final_state_patch from L3/L4)\n    against a GoldenExpectation.\n\n    The `state_patch` is expected to be shaped approximately like:\n\n        {\n            "strategy_text": str | None,\n            "rag_evidence": [ { "text": ..., "score": ..., "source": ... }, ... ],\n            "drafted_sections": [ { "title": ..., "text": ..., ... }, ... ],\n            "qa_findings": [ { "id": ..., "passed": bool, ... }, ... ],\n            "safety_findings": [ { "id": ..., "category": ..., "blocking": bool, ... }, ... ],\n            "correction_loop_state": {\n                "iteration": int,\n                "max_iterations": int,\n                "surfaces_triggered": [...],\n                "last_signal": str | None,\n                "terminated_reason": str | None,\n            },\n            "safety_passed": bool,\n            "telemetry_summary": ...,\n            "cost_snapshot": ...,\n        }\n\n    Exact keys are not required; the evaluator uses best‑effort extraction\n    and will mark missing data as failing individual metrics with an\n    explanatory reason.\n    ')),
        Assign(
          targets=[
            Name(id='patch_map', ctx=Store())],
          value=Call(
            func=Name(id='_as_mapping', ctx=Load()),
            args=[
              Name(id='state_patch', ctx=Load())])),
        AnnAssign(
          target=Name(id='metrics', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='EvalMetric', ctx=Load()),
            ctx=Load()),
          value=List(ctx=Load()),
          simple=1),
