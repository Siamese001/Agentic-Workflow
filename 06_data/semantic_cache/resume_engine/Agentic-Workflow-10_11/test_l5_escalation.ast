Module(
  body=[
    Expr(
      value=Constant(value='L5 Safety Guardrails Escalation Tests.')),
    ClassDef(
      name='TestL5Escalation',
      body=[
        Expr(
          value=Constant(value='Tests for L5 safety escalation.')),
        FunctionDef(
          name='test_severity_escalation',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test severity-based escalation.')),
            Assign(
              targets=[
                Name(id='severity', ctx=Store())],
              value=Constant(value='high')),
            Assign(
              targets=[
                Name(id='escalate', ctx=Store())],
              value=Compare(
                left=Name(id='severity', ctx=Load()),
                ops=[
                  In()],
                comparators=[
                  List(
                    elts=[
                      Constant(value='high'),
                      Constant(value='critical')],
                    ctx=Load())])),
            Assert(
              test=Compare(
                left=Name(id='escalate', ctx=Load()),
                ops=[
                  Is()],
                comparators=[
                  Constant(value=True)]))]),
        FunctionDef(
          name='test_human_in_loop_escalation',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test human-in-loop escalation trigger.')),
            Assign(
              targets=[
                Name(id='findings', ctx=Store())],
              value=List(
                elts=[
                  Dict(
                    keys=[
                      Constant(value='type'),
                      Constant(value='severity')],
                    values=[
                      Constant(value='pii'),
                      Constant(value='critical')])],
                ctx=Load())),
            Assign(
              targets=[
                Name(id='needs_hil', ctx=Store())],
              value=Call(
                func=Name(id='any', ctx=Load()),
                args=[
                  GeneratorExp(
                    elt=Compare(
                      left=Subscript(
                        value=Name(id='f', ctx=Load()),
                        slice=Constant(value='severity'),
                        ctx=Load()),
                      ops=[
                        Eq()],
                      comparators=[
                        Constant(value='critical')]),
                    generators=[
                      comprehension(
                        target=Name(id='f', ctx=Store()),
                        iter=Name(id='findings', ctx=Load()),
                        is_async=0)])])),
            Assert(
              test=Compare(
                left=Name(id='needs_hil', ctx=Load()),
                ops=[
                  Is()],
                comparators=[
                  Constant(value=True)]))])])])