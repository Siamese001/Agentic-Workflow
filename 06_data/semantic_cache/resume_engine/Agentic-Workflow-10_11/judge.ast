Module(
  body=[
    ImportFrom(
      module='__future__',
      names=[
        alias(name='annotations')],
      level=0),
    ImportFrom(
      module='eval.golden_state.models',
      names=[
        alias(name='GoldenStateTestCase'),
        alias(name='JudgeVerdict')],
      level=0),
    FunctionDef(
      name='evaluate_output',
      args=arguments(
        args=[
          arg(
            arg='test_case',
            annotation=Name(id='GoldenStateTestCase', ctx=Load())),
          arg(
            arg='agent_output',
            annotation=Name(id='str', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='Deterministic judge over agent output for a given test case.\n\n    This initial implementation is intentionally simple and does not\n    call any language models. It uses string heuristics to produce a\n    coarse score in [0.0, 1.0].\n    ')),
        Assign(
          targets=[
            Name(id='text', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Call(
                func=Attribute(
                  value=BoolOp(
                    op=Or(),
                    values=[
                      Name(id='agent_output', ctx=Load()),
                      Constant(value='')]),
                  attr='strip',
                  ctx=Load())),
              attr='lower',
              ctx=Load()))),
        If(
          test=UnaryOp(
            op=Not(),
            operand=Name(id='text', ctx=Load())),
          body=[
            Return(
              value=Call(
                func=Name(id='JudgeVerdict', ctx=Load()),
                keywords=[
                  keyword(
                    arg='score',
                    value=Constant(value=0.0)),
                  keyword(
                    arg='rating',
                    value=Constant(value='fail')),
                  keyword(
                    arg='explanation',
                    value=Constant(value='Empty output.'))]))]),
        Assign(
          targets=[
            Name(id='expected', ctx=Store())],
          value=Call(
            func=Attribute(
              value=BoolOp(
                op=Or(),
                values=[
                  Attribute(
                    value=Name(id='test_case', ctx=Load()),
                    attr='expected_behavior',
                    ctx=Load()),
                  Constant(value='')]),
              attr='lower',
              ctx=Load()))),
        Assign(
          targets=[
            Name(id='key_ok', ctx=Store())],
          value=BoolOp(
            op=And(),
            values=[
              Compare(
                left=Constant(value='professional'),
                ops=[
                  In()],
                comparators=[
                  Name(id='expected', ctx=Load())]),
              Compare(
                left=Constant(value='professional'),
                ops=[
                  In()],
                comparators=[
                  Name(id='text', ctx=Load())])])),
        If(
          test=Name(id='key_ok', ctx=Load()),
          body=[
            Return(
              value=Call(
                func=Name(id='JudgeVerdict', ctx=Load()),
                keywords=[
                  keyword(
                    arg='score',
                    value=Constant(value=1.0)),
                  keyword(
                    arg='rating',
                    value=Constant(value='pass')),
                  keyword(
                    arg='explanation',
                    value=Constant(value='Output contains key expected behavior signal.'))]))]),
        Return(
          value=Call(
            func=Name(id='JudgeVerdict', ctx=Load()),
            keywords=[
              keyword(
                arg='score',
                value=Constant(value=0.5)),
              keyword(
                arg='rating',
                value=Constant(value='borderline')),
              keyword(
                arg='explanation',
                value=Constant(value='Output is non-empty but did not hit key expected signals.'))]))],
      returns=Name(id='JudgeVerdict', ctx=Load()))])