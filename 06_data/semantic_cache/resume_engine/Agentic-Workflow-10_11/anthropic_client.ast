Module(
  body=[
    Expr(
      value=Constant(value='Anthropic client adapter for v10_10.\n\nThis module is the ONLY place where the Anthropic SDK is imported.\nIt exposes a narrow run_llm interface used by runtime_utils.\n')),
    ImportFrom(
      module='__future__',
      names=[
        alias(name='annotations')],
      level=0),
    Import(
      names=[
        alias(name='os')]),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Any'),
        alias(name='List')],
      level=0),
    FunctionDef(
      name='run_llm_anthropic',
      args=arguments(
        args=[
          arg(
            arg='model',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='prompt',
            annotation=Name(id='str', ctx=Load()))],
        kwonlyargs=[
          arg(
            arg='temperature',
            annotation=Name(id='float', ctx=Load())),
          arg(
            arg='max_tokens',
            annotation=Name(id='int', ctx=Load())),
          arg(
            arg='timeout_s',
            annotation=Name(id='int', ctx=Load()))],
        kw_defaults=[
          None,
          None,
          None]),
      body=[
        Expr(
          value=Constant(value='Run an Anthropic message completion and return the response text.')),
        Try(
          body=[
            Import(
              names=[
                alias(name='anthropic')])],
          handlers=[
            ExceptHandler(
              type=Name(id='ImportError', ctx=Load()),
              name='exc',
              body=[
                Raise(
                  exc=Call(
                    func=Name(id='ImportError', ctx=Load()),
                    args=[
                      Constant(value='anthropic package not installed')]),
                  cause=Name(id='exc', ctx=Load()))])]),
        Assign(
          targets=[
            Name(id='api_key', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='os', ctx=Load()),
              attr='getenv',
              ctx=Load()),
            args=[
              Constant(value='ANTHROPIC_API_KEY')])),
        If(
          test=UnaryOp(
            op=Not(),
            operand=Name(id='api_key', ctx=Load())),
          body=[
            Raise(
              exc=Call(
                func=Name(id='RuntimeError', ctx=Load()),
                args=[
                  Constant(value='ANTHROPIC_API_KEY must be set for Anthropic provider')]))]),
        Assign(
          targets=[
            Name(id='client', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='anthropic', ctx=Load()),
              attr='Anthropic',
              ctx=Load()),
            keywords=[
              keyword(
                arg='api_key',
                value=Name(id='api_key', ctx=Load()))])),
        AnnAssign(
          target=Name(id='resp', ctx=Store()),
          annotation=Name(id='Any', ctx=Load()),
          value=Call(
            func=Attribute(
              value=Attribute(
                value=Name(id='client', ctx=Load()),
                attr='messages',
                ctx=Load()),
              attr='create',
              ctx=Load()),
            keywords=[
              keyword(
                arg='model',
                value=Name(id='model', ctx=Load())),
              keyword(
                arg='messages',
                value=List(
                  elts=[
                    Dict(
                      keys=[
                        Constant(value='role'),
                        Constant(value='content')],
                      values=[
                        Constant(value='user'),
                        Name(id='prompt', ctx=Load())])],
                  ctx=Load())),
              keyword(
                arg='temperature',
                value=Name(id='temperature', ctx=Load())),
              keyword(
                arg='max_tokens',
                value=Name(id='max_tokens', ctx=Load())),
              keyword(
                arg='timeout',
                value=Name(id='timeout_s', ctx=Load()))]),
          simple=1),
        AnnAssign(
          target=Name(id='parts', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load()),
          value=List(ctx=Load()),
          simple=1),
        For(
          target=Name(id='block', ctx=Store()),
          iter=BoolOp(
            op=Or(),
            values=[
              Call(
                func=Name(id='getattr', ctx=Load()),
                args=[
                  Name(id='resp', ctx=Load()),
                  Constant(value='content'),
                  List(ctx=Load())]),
              List(ctx=Load())]),
          body=[
            If(
              test=Compare(
                left=Call(
                  func=Name(id='getattr', ctx=Load()),
                  args=[
                    Name(id='block', ctx=Load()),
                    Constant(value='type'),
                    Constant(value=None)]),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value='text')]),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='parts', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Call(
                        func=Name(id='getattr', ctx=Load()),
                        args=[
                          Name(id='block', ctx=Load()),
                          Constant(value='text'),
                          Constant(value='')])]))])]),
        Return(
          value=Call(
            func=Attribute(
              value=Constant(value='\n'),
              attr='join',
              ctx=Load()),
            args=[
              Name(id='parts', ctx=Load())]))],
      returns=Name(id='str', ctx=Load()))])