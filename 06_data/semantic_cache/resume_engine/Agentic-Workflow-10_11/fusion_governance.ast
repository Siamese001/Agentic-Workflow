                  ctx=Load()))],
            defaults=[
              Constant(value=None),
              Constant(value=None),
              Constant(value=None),
              Constant(value=None)]),
          body=[
            Expr(
              value=Constant(value="Run a complete safe temporal KG + RAG fusion session.\n        \n        Args:\n            question: User's natural language query\n            user_context: Optional user context for safety evaluation\n            safety_profile: Safety profile to apply\n            temporal_constraints: Temporal filtering constraints\n            max_recursion_depth: Override for recursion depth limit\n            \n        Returns:\n            SafetyWrappedResult with answer and safety information\n        ")),
            Assign(
              targets=[
                Name(id='session_id', ctx=Store())],
              value=JoinedStr(
                values=[
                  Constant(value='fusion_'),
                  FormattedValue(
                    value=Subscript(
                      value=Attribute(
                        value=Call(
                          func=Attribute(
                            value=Name(id='uuid', ctx=Load()),
                            attr='uuid4',
                            ctx=Load())),
                        attr='hex',
                        ctx=Load()),
                      slice=Slice(
                        upper=Constant(value=12)),
                      ctx=Load()),
                    conversion=-1),
                  Constant(value='_'),
                  FormattedValue(
                    value=Call(
                      func=Attribute(
                        value=Call(
                          func=Attribute(
                            value=Name(id='datetime', ctx=Load()),
                            attr='now',
                            ctx=Load()),
                          args=[
                            Name(id='UTC', ctx=Load())]),
                        attr='strftime',
                        ctx=Load()),
                      args=[
                        Constant(value='%Y%m%d%H%M%S')]),
                    conversion=-1)])),
            Assign(
              targets=[
                Name(id='start_time', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='datetime', ctx=Load()),
                  attr='now',
                  ctx=Load()),
                args=[
                  Name(id='UTC', ctx=Load())])),
            Try(
              body=[
                Assign(
                  targets=[
                    Name(id='session', ctx=Store())],
                  value=Call(
                    func=Name(id='FusionSession', ctx=Load()),
                    keywords=[
                      keyword(
                        arg='session_id',
                        value=Name(id='session_id', ctx=Load())),
                      keyword(
                        arg='user_query',
                        value=Name(id='question', ctx=Load())),
                      keyword(
                        arg='temporal_constraints',
                        value=Name(id='temporal_constraints', ctx=Load())),
                      keyword(
                        arg='safety_profile',
                        value=Name(id='safety_profile', ctx=Load()))])),
                If(
                  test=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='l4_state_manager',
                    ctx=Load()),
                  body=[
                    Assign(
                      targets=[
                        Subscript(
                          value=Attribute(
                            value=Name(id='self', ctx=Load()),
                            attr='active_sessions',
                            ctx=Load()),
                          slice=Name(id='session_id', ctx=Load()),
                          ctx=Store())],
                      value=Name(id='session', ctx=Load()))]),
                Assign(
                  targets=[
                    Name(id='span', ctx=Store())],
                  value=Call(
                    func=Name(id='start_span', ctx=Load()),
                    args=[
                      Constant(value='fusion.governance.session'),
                      Dict(
                        keys=[
                          Constant(value='session_id')],
                        values=[
                          Name(id='session_id', ctx=Load())])])),
                Expr(
                  value=Call(
                    func=Name(id='emit_node_event', ctx=Load()),
                    keywords=[
                      keyword(
                        arg='node',
                        value=Constant(value='fusion_session')),
                      keyword(
                        arg='status',
                        value=Constant(value='start')),
                      keyword(
                        arg='details',
                        value=Dict(
                          keys=[
                            Constant(value='session_id'),
                            Constant(value='question'),
                            Constant(value='safety_profile')],
                          values=[
                            Name(id='session_id', ctx=Load()),
                            IfExp(
                              test=Compare(
                                left=Call(
                                  func=Name(id='len', ctx=Load()),
                                  args=[
                                    Name(id='question', ctx=Load())]),
                                ops=[
                                  Gt()],
                                comparators=[
                                  Constant(value=100)]),
                              body=BinOp(
                                left=Subscript(
                                  value=Name(id='question', ctx=Load()),
                                  slice=Slice(
                                    upper=Constant(value=100)),
                                  ctx=Load()),
                                op=Add(),
                                right=Constant(value='...')),
                              orelse=Name(id='question', ctx=Load())),
                            Name(id='safety_profile', ctx=Load())]))])),
                Assign(
                  targets=[
                    Name(id='result', ctx=Store())],
                  value=Await(
                    value=Call(
                      func=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='_execute_fusion_pipeline',
                        ctx=Load()),
                      keywords=[
                        keyword(
                          arg='session_id',
                          value=Name(id='session_id', ctx=Load())),
                        keyword(
                          arg='question',
                          value=Name(id='question', ctx=Load())),
                        keyword(
                          arg='user_context',
                          value=BoolOp(
                            op=Or(),
                            values=[
                              Name(id='user_context', ctx=Load()),
                              Dict()])),
                        keyword(
                          arg='safety_profile',
                          value=Name(id='safety_profile', ctx=Load())),
                        keyword(
                          arg='temporal_constraints',
                          value=BoolOp(
                            op=Or(),
                            values=[
                              Name(id='temporal_constraints', ctx=Load()),
                              Dict()])),
                        keyword(
                          arg='max_recursion_depth',
                          value=BoolOp(
                            op=Or(),
                            values=[
                              Name(id='max_recursion_depth', ctx=Load()),
                              Attribute(
                                value=Attribute(
                                  value=Name(id='self', ctx=Load()),
                                  attr='config',
                                  ctx=Load()),
                                attr='max_recursion_depth',
                                ctx=Load())]))]))),
                Assign(
