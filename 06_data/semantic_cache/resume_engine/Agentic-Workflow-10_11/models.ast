      names=[
        alias(name='BaseModel'),
        alias(name='Field')],
      level=0),
    ClassDef(
      name='Hypothesis',
      bases=[
        Name(id='BaseModel', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Lightweight hypothesis used by the metacognition layer.')),
        AnnAssign(
          target=Name(id='id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='agent_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='content', ctx=Store()),
