            ctx=Load()),
          value=Constant(value=None),
          simple=1)]),
    ClassDef(
      name='MetacognitionReport',
      bases=[
        Name(id='BaseModel', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Aggregate view over a set of hypotheses and signals.')),
        AnnAssign(
          target=Name(id='hypotheses', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
