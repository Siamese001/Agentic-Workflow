          annotation=Name(id='float', ctx=Load()),
          value=Constant(value=0.0),
          simple=1),
        AnnAssign(
          target=Name(id='evidence_ids', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load()),
          value=Call(
            func=Name(id='Field', ctx=Load()),
            keywords=[
              keyword(
                arg='default_factory',
                value=Name(id='list', ctx=Load()))]),
          simple=1),
        AnnAssign(
