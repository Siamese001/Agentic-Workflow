                    elts=[
                      Constant(value='step_1'),
                      Constant(value='step_2')],
                    ctx=Load()),
                  Constant(value='step_3'),
                  Dict(
                    keys=[
                      Constant(value='step_1'),
                      Constant(value='step_2')],
                    values=[
                      Dict(
                        keys=[
                          Constant(value='result')],
                        values=[
                          Constant(value='requirements_extracted')]),
                      Dict(
                        keys=[
                          Constant(value='result')],
                        values=[
                          Constant(value='resume_parsed')])]),
                  Dict(
                    keys=[
                      Constant(value='user_id'),
                      Constant(value='session_id')],
                    values=[
                      Constant(value='user_456'),
                      Constant(value='session_789')])])),
            Assign(
              targets=[
                Name(id='interruption_point', ctx=Store())],
              value=Constant(value='step_3')),
            If(
              test=Compare(
                left=Name(id='interruption_point', ctx=Load()),
                ops=[
                  In()],
                comparators=[
                  Subscript(
                    value=Name(id='checkpoint_state', ctx=Load()),
                    slice=Constant(value='completed_steps'),
