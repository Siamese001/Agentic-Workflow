        AsyncFunctionDef(
          name='test_workflow_error_recovery_and_retry',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test workflow error recovery and retry mechanisms.')),
            Assign(
              targets=[
                Name(id='execution_attempts', ctx=Store())],
              value=List(
                elts=[
                  Dict(
                    keys=[
                      Constant(value='success'),
                      Constant(value='error'),
                      Constant(value='attempt')],
                    values=[
                      Constant(value=False),
                      Constant(value='Network timeout'),
                      Constant(value=1)]),
                  Dict(
                    keys=[
                      Constant(value='success'),
                      Constant(value='error'),
                      Constant(value='attempt')],
                    values=[
                      Constant(value=False),
                      Constant(value='Rate limit exceeded'),
                      Constant(value=2)]),
                  Dict(
                    keys=[
                      Constant(value='success'),
                      Constant(value='data'),
                      Constant(value='attempt')],
                    values=[
                      Constant(value=True),
                      Dict(
                        keys=[
                          Constant(value='result')],
                        values=[
                          Constant(value='Success after retry')]),
                      Constant(value=3)])],
                ctx=Load())),
            Assign(
              targets=[
                Name(id='max_retries', ctx=Store())],
              value=Constant(value=3)),
            Assign(
              targets=[
                Name(id='final_result', ctx=Store())],
              value=Constant(value=None)),
            For(
              target=Name(id='attempt', ctx=Store()),
              iter=Call(
                func=Name(id='range', ctx=Load()),
                args=[
                  Name(id='max_retries', ctx=Load())]),
              body=[
                Assign(
                  targets=[
                    Name(id='attempt_result', ctx=Store())],
                  value=Subscript(
                    value=Name(id='execution_attempts', ctx=Load()),
                    slice=Name(id='attempt', ctx=Load()),
                    ctx=Load())),
                If(
                  test=Subscript(
                    value=Name(id='attempt_result', ctx=Load()),
                    slice=Constant(value='success'),
                    ctx=Load()),
                  body=[
                    Assign(
                      targets=[
                        Name(id='final_result', ctx=Store())],
                      value=Name(id='attempt_result', ctx=Load())),
                    Break()],
                  orelse=[
                    Continue()])]),
            Assert(
              test=Compare(
                left=Name(id='final_result', ctx=Load()),
                ops=[
                  IsNot()],
                comparators=[
                  Constant(value=None)])),
            Assert(
              test=Compare(
                left=Subscript(
                  value=Name(id='final_result', ctx=Load()),
                  slice=Constant(value='success'),
                  ctx=Load()),
                ops=[
                  Is()],
                comparators=[
                  Constant(value=True)])),
            Assert(
              test=Compare(
                left=Subscript(
                  value=Name(id='final_result', ctx=Load()),
                  slice=Constant(value='attempt'),
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value=3)]))]),
