        AsyncFunctionDef(
          name='test_workflow_resource_usage_monitoring',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test monitoring of resource usage during workflow execution.')),
            Assign(
              targets=[
                Name(id='resource_metrics', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='memory_peak_mb'),
                  Constant(value='cpu_usage_percent'),
                  Constant(value='tokens_consumed'),
                  Constant(value='api_calls_made'),
                  Constant(value='disk_io_mb')],
                values=[
                  Constant(value=256),
                  Constant(value=45),
                  Constant(value=1250),
                  Constant(value=8),
                  Constant(value=12)])),
            Assign(
              targets=[
                Name(id='resource_limits', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='max_memory_mb'),
                  Constant(value='max_cpu_percent'),
                  Constant(value='max_tokens'),
                  Constant(value='max_api_calls')],
                values=[
                  Constant(value=512),
                  Constant(value=80),
                  Constant(value=2000),
                  Constant(value=20)])),
            Assign(
              targets=[
                Name(id='violations', ctx=Store())],
              value=List(ctx=Load())),
            For(
              target=Tuple(
                elts=[
                  Name(id='resource', ctx=Store()),
                  Name(id='usage', ctx=Store())],
                ctx=Store()),
              iter=Call(
                func=Attribute(
                  value=Name(id='resource_metrics', ctx=Load()),
                  attr='items',
                  ctx=Load())),
              body=[
                Assign(
                  targets=[
                    Name(id='limit', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='resource_limits', ctx=Load()),
                      attr='get',
                      ctx=Load()),
                    args=[
                      JoinedStr(
                        values=[
                          Constant(value='max_'),
                          FormattedValue(
                            value=Name(id='resource', ctx=Load()),
                            conversion=-1)]),
                      Call(
                        func=Name(id='float', ctx=Load()),
                        args=[
                          Constant(value='inf')])])),
                If(
                  test=Compare(
                    left=Name(id='usage', ctx=Load()),
                    ops=[
                      Gt()],
                    comparators=[
                      Name(id='limit', ctx=Load())]),
                  body=[
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Name(id='violations', ctx=Load()),
                          attr='append',
                          ctx=Load()),
                        args=[
                          JoinedStr(
                            values=[
                              FormattedValue(
                                value=Name(id='resource', ctx=Load()),
                                conversion=-1),
                              Constant(value=': '),
                              FormattedValue(
                                value=Name(id='usage', ctx=Load()),
                                conversion=-1),
                              Constant(value=' > '),
                              FormattedValue(
                                value=Name(id='limit', ctx=Load()),
                                conversion=-1)])]))])]),
            Assert(
              test=Compare(
                left=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Name(id='violations', ctx=Load())]),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value=0)])),
            Assign(
              targets=[
                Name(id='efficiency_metrics', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='memory_efficiency'),
                  Constant(value='token_efficiency'),
                  Constant(value='api_call_efficiency')],
                values=[
                  BinOp(
                    left=Subscript(
                      value=Name(id='resource_metrics', ctx=Load()),
                      slice=Constant(value='memory_peak_mb'),
                      ctx=Load()),
                    op=Div(),
                    right=Subscript(
                      value=Name(id='resource_limits', ctx=Load()),
                      slice=Constant(value='max_memory_mb'),
                      ctx=Load())),
                  BinOp(
                    left=Subscript(
                      value=Name(id='resource_metrics', ctx=Load()),
                      slice=Constant(value='tokens_consumed'),
                      ctx=Load()),
                    op=Div(),
                    right=Subscript(
                      value=Name(id='resource_limits', ctx=Load()),
                      slice=Constant(value='max_tokens'),
                      ctx=Load())),
                  BinOp(
                    left=Subscript(
                      value=Name(id='resource_metrics', ctx=Load()),
                      slice=Constant(value='api_calls_made'),
                      ctx=Load()),
                    op=Div(),
                    right=Subscript(
                      value=Name(id='resource_limits', ctx=Load()),
                      slice=Constant(value='max_api_calls'),
                      ctx=Load()))])),
            Assert(
