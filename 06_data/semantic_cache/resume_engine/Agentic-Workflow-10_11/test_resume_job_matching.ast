    ClassDef(
      name='TestWorkflowErrorHandling',
      body=[
        Expr(
          value=Constant(value='Test comprehensive error handling in end-to-end workflows.')),
        AsyncFunctionDef(
          name='test_cascading_failure_prevention',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test prevention of cascading failures across layers.')),
            Assign(
              targets=[
                Name(id='failure_scenarios', ctx=Store())],
              value=List(
                elts=[
                  Dict(
                    keys=[
                      Constant(value='layer'),
                      Constant(value='error'),
                      Constant(value='should_cascade')],
                    values=[
                      Constant(value='L2'),
                      Constant(value='Tool timeout'),
                      Constant(value=False)]),
                  Dict(
                    keys=[
                      Constant(value='layer'),
                      Constant(value='error'),
                      Constant(value='should_cascade')],
                    values=[
                      Constant(value='L4'),
                      Constant(value='Memory store unavailable'),
                      Constant(value=False)]),
                  Dict(
                    keys=[
                      Constant(value='layer'),
                      Constant(value='error'),
                      Constant(value='should_cascade')],
                    values=[
                      Constant(value='L5'),
                      Constant(value='Safety policy violation'),
                      Constant(value=True)])],
                ctx=Load())),
            For(
              target=Name(id='scenario', ctx=Store()),
              iter=Name(id='failure_scenarios', ctx=Load()),
              body=[
                Assign(
                  targets=[
                    Name(id='layer', ctx=Store())],
                  value=Subscript(
                    value=Name(id='scenario', ctx=Load()),
                    slice=Constant(value='layer'),
                    ctx=Load())),
                Assign(
                  targets=[
                    Name(id='error', ctx=Store())],
                  value=Subscript(
                    value=Name(id='scenario', ctx=Load()),
                    slice=Constant(value='error'),
                    ctx=Load())),
                Assign(
                  targets=[
                    Name(id='should_cascade', ctx=Store())],
                  value=Subscript(
                    value=Name(id='scenario', ctx=Load()),
                    slice=Constant(value='should_cascade'),
                    ctx=Load())),
                If(
                  test=Compare(
                    left=Name(id='layer', ctx=Load()),
                    ops=[
                      Eq()],
                    comparators=[
                      Constant(value='L5')]),
                  body=[
                    Assign(
                      targets=[
                        Name(id='workflow_stopped', ctx=Store())],
                      value=Constant(value=True))],
                  orelse=[
                    If(
                      test=Compare(
                        left=Name(id='layer', ctx=Load()),
                        ops=[
                          Eq()],
                        comparators=[
                          Constant(value='L2')]),
                      body=[
                        Assign(
                          targets=[
                            Name(id='workflow_stopped', ctx=Store())],
                          value=Constant(value=False)),
                        Assign(
                          targets=[
                            Name(id='recovery_action', ctx=Store())],
                          value=Constant(value='retry_with_fallback'))],
                      orelse=[
                        If(
                          test=Compare(
                            left=Name(id='layer', ctx=Load()),
                            ops=[
                              Eq()],
                            comparators=[
                              Constant(value='L4')]),
                          body=[
                            Assign(
                              targets=[
                                Name(id='workflow_stopped', ctx=Store())],
                              value=Constant(value=False)),
                            Assign(
                              targets=[
                                Name(id='recovery_action', ctx=Store())],
                              value=Constant(value='use_cache'))],
                          orelse=[
                            Assign(
                              targets=[
                                Name(id='workflow_stopped', ctx=Store())],
                              value=Constant(value=True))])])]),
                Assert(
                  test=Compare(
                    left=Name(id='workflow_stopped', ctx=Load()),
                    ops=[
                      Eq()],
                    comparators=[
                      Name(id='should_cascade', ctx=Load())])),
                If(
                  test=UnaryOp(
                    op=Not(),
                    operand=Name(id='workflow_stopped', ctx=Load())),
                  body=[
                    Assert(
                      test=Compare(
                        left=Constant(value='recovery_action'),
                        ops=[
                          In()],
                        comparators=[
                          Call(
                            func=Name(id='locals', ctx=Load()))]))])])]),
        AsyncFunctionDef(
          name='test_workflow_state_recovery',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test workflow state recovery after interruptions.')),
            Assign(
              targets=[
                Name(id='checkpoint_state', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='workflow_id'),
                  Constant(value='completed_steps'),
                  Constant(value='current_step'),
