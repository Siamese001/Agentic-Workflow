        AsyncFunctionDef(
          name='test_workflow_with_conditional_branching',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test workflow with conditional branching based on analysis results.')),
            Assign(
              targets=[
                Name(id='test_cases', ctx=Store())],
              value=List(
                elts=[
                  Dict(
                    keys=[
                      Constant(value='experience_years'),
                      Constant(value='expected_path')],
                    values=[
                      Constant(value=7),
                      Constant(value='senior_path')]),
                  Dict(
                    keys=[
                      Constant(value='experience_years'),
                      Constant(value='expected_path')],
                    values=[
                      Constant(value=3),
                      Constant(value='junior_path')]),
                  Dict(
                    keys=[
                      Constant(value='experience_years'),
                      Constant(value='expected_path')],
                    values=[
                      Constant(value=5),
                      Constant(value='senior_path')])],
                ctx=Load())),
            For(
              target=Name(id='case', ctx=Store()),
              iter=Name(id='test_cases', ctx=Load()),
              body=[
                Assign(
                  targets=[
                    Name(id='experience', ctx=Store())],
                  value=Subscript(
                    value=Name(id='case', ctx=Load()),
                    slice=Constant(value='experience_years'),
                    ctx=Load())),
                Assign(
                  targets=[
                    Name(id='expected_path', ctx=Store())],
                  value=Subscript(
                    value=Name(id='case', ctx=Load()),
                    slice=Constant(value='expected_path'),
                    ctx=Load())),
                Assign(
                  targets=[
                    Name(id='executed_steps', ctx=Store())],
                  value=List(
                    elts=[
                      Constant(value='analyze_experience')],
                    ctx=Load())),
                If(
                  test=Compare(
                    left=Name(id='experience', ctx=Load()),
                    ops=[
                      GtE()],
                    comparators=[
                      Constant(value=5)]),
                  body=[
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Name(id='executed_steps', ctx=Load()),
                          attr='append',
                          ctx=Load()),
                        args=[
                          Constant(value='senior_path')]))],
                  orelse=[
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Name(id='executed_steps', ctx=Load()),
                          attr='append',
                          ctx=Load()),
                        args=[
                          Constant(value='junior_path')]))]),
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='executed_steps', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Constant(value='generate_output')])),
                Assert(
                  test=Compare(
                    left=Name(id='expected_path', ctx=Load()),
                    ops=[
                      In()],
                    comparators=[
                      Name(id='executed_steps', ctx=Load())])),
                If(
                  test=Compare(
                    left=Name(id='expected_path', ctx=Load()),
                    ops=[
                      Eq()],
                    comparators=[
                      Constant(value='senior_path')]),
                  body=[
                    Assert(
                      test=Compare(
                        left=Constant(value='junior_path'),
                        ops=[
                          NotIn()],
                        comparators=[
                          Name(id='executed_steps', ctx=Load())]))],
                  orelse=[
                    Assert(
                      test=Compare(
                        left=Constant(value='senior_path'),
                        ops=[
                          NotIn()],
                        comparators=[
                          Name(id='executed_steps', ctx=Load())]))])])])]),
