    ClassDef(
      name='TestWorkflowPerformance',
      body=[
        Expr(
          value=Constant(value='Test workflow performance and optimization.')),
        FunctionDef(
          name='test_workflow_execution_time',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test workflow execution time is reasonable.')),
            Import(
              names=[
                alias(name='time')]),
            Assign(
              targets=[
                Name(id='ctx', ctx=Store())],
              value=Call(
                func=Name(id='ExecutionContext', ctx=Load()),
                keywords=[
                  keyword(
                    arg='job',
                    value=Call(
                      func=Name(id='JobInput', ctx=Load()),
                      keywords=[
                        keyword(
                          arg='title',
                          value=Constant(value='Test')),
                        keyword(
                          arg='role_type',
                          value=Constant(value='test')),
                        keyword(
                          arg='seniority',
                          value=Constant(value='mid')),
                        keyword(
                          arg='posting_text',
                          value=Constant(value='test'))])),
                  keyword(
                    arg='resume',
                    value=Call(
                      func=Name(id='ResumeInput', ctx=Load()),
                      keywords=[
                        keyword(
                          arg='name',
                          value=Constant(value='Test')),
                        keyword(
                          arg='email',
                          value=Constant(value='test@example.com')),
                        keyword(arg='sections', value=Dict())])),
                  keyword(
                    arg='user_id',
                    value=Constant(value='test_user'))])),
            With(
              items=[
                withitem(
                  context_expr=Call(
                    func=Name(id='patch', ctx=Load()),
                    args=[
                      Constant(value='l2.execute_workflow_plans')]),
                  optional_vars=Name(id='mock_execute', ctx=Store()))],
              body=[
                ImportFrom(
                  module='l2',
                  names=[
                    alias(name='L2ResultBundle')],
                  level=0),
                Assign(
                  targets=[
                    Name(id='mock_strategy', ctx=Store())],
                  value=Call(
                    func=Name(id='Mock', ctx=Load()))),
                Assign(
                  targets=[
                    Attribute(
                      value=Name(id='mock_strategy', ctx=Load()),
                      attr='branches',
                      ctx=Store())],
                  value=List(
                    elts=[
                      Call(
                        func=Name(id='Mock', ctx=Load()),
                        keywords=[
                          keyword(
                            arg='description',
                            value=Constant(value='Test strategy'))])],
                    ctx=Load())),
                Assign(
                  targets=[
                    Attribute(
                      value=Name(id='mock_execute', ctx=Load()),
                      attr='return_value',
                      ctx=Store())],
                  value=Call(
                    func=Name(id='L2ResultBundle', ctx=Load()),
                    keywords=[
                      keyword(
                        arg='strategy',
                        value=Name(id='mock_strategy', ctx=Load())),
                      keyword(
                        arg='rag',
                        value=Call(
                          func=Name(id='Mock', ctx=Load()))),
                      keyword(
                        arg='drafting',
                        value=Call(
                          func=Name(id='Mock', ctx=Load()))),
                      keyword(
                        arg='qa',
                        value=Call(
                          func=Name(id='Mock', ctx=Load()))),
                      keyword(
                        arg='safety',
                        value=Call(
                          func=Name(id='Mock', ctx=Load())))])),
                Assign(
                  targets=[
                    Name(id='start_time', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='time', ctx=Load()),
                      attr='time',
                      ctx=Load()))),
                ImportFrom(
                  module='orchestration.run_dag',
                  names=[
                    alias(name='run_dag')],
                  level=0),
                Assign(
                  targets=[
                    Name(id='plans', ctx=Store())],
                  value=List(
                    elts=[
                      Call(
                        func=Name(id='Mock', ctx=Load()))],
                    ctx=Load())),
                Assign(
                  targets=[
                    Name(id='result', ctx=Store())],
                  value=Call(
                    func=Name(id='run_dag', ctx=Load()),
                    args=[
                      Name(id='plans', ctx=Load()),
                      Name(id='ctx', ctx=Load())])),
                Assign(
                  targets=[
                    Name(id='execution_time', ctx=Store())],
                  value=BinOp(
                    left=Call(
                      func=Attribute(
                        value=Name(id='time', ctx=Load()),
                        attr='time',
                        ctx=Load())),
                    op=Sub(),
                    right=Name(id='start_time', ctx=Load()))),
                Assert(
                  test=Compare(
                    left=Name(id='execution_time', ctx=Load()),
                    ops=[
                      Lt()],
                    comparators=[
                      Constant(value=5.0)])),
                Assert(
                  test=Compare(
                    left=Name(id='result', ctx=Load()),
                    ops=[
                      IsNot()],
                    comparators=[
                      Constant(value=None)]))])])]),
    If(
      test=Compare(
        left=Name(id='__name__', ctx=Load()),
        ops=[
          Eq()],
        comparators=[
          Constant(value='__main__')]),
      body=[
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='pytest', ctx=Load()),
              attr='main',
              ctx=Load()),
            args=[
              List(
                elts=[
                  Name(id='__file__', ctx=Load())],
                ctx=Load())]))])])