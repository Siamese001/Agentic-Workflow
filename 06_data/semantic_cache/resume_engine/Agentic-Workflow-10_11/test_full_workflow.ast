    ClassDef(
      name='TestEndToEndWorkflow',
      body=[
        Expr(
          value=Constant(value='Test complete end-to-end workflow execution.')),
        FunctionDef(
          name='test_full_workflow_with_all_components',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test complete workflow with strategy, RAG, drafting, QA, and safety.')),
            Assign(
              targets=[
                Name(id='ctx', ctx=Store())],
              value=Call(
                func=Name(id='ExecutionContext', ctx=Load()),
                keywords=[
                  keyword(
                    arg='job',
                    value=Call(
                      func=Name(id='JobInput', ctx=Load()),
                      keywords=[
                        keyword(
                          arg='title',
                          value=Constant(value='Senior Software Engineer')),
                        keyword(
                          arg='role_type',
                          value=Constant(value='engineering')),
                        keyword(
                          arg='seniority',
                          value=Constant(value='senior')),
                        keyword(
                          arg='posting_text',
                          value=Constant(value='Looking for a senior software engineer with Python experience'))])),
                  keyword(
                    arg='resume',
                    value=Call(
                      func=Name(id='ResumeInput', ctx=Load()),
                      keywords=[
                        keyword(
                          arg='name',
                          value=Constant(value='Jane Doe')),
                        keyword(
                          arg='email',
                          value=Constant(value='jane@example.com')),
                        keyword(arg='sections', value=Dict())])),
                  keyword(
                    arg='user_id',
                    value=Constant(value='test_user'))])),
            With(
              items=[
                withitem(
                  context_expr=Call(
                    func=Name(id='patch', ctx=Load()),
                    args=[
                      Constant(value='l2.execute_workflow_plans')]),
                  optional_vars=Name(id='mock_execute', ctx=Store()))],
              body=[
                With(
                  items=[
                    withitem(
                      context_expr=Call(
                        func=Name(id='patch', ctx=Load()),
                        args=[
                          Constant(value='runtime.runtime_utils.invoke_model')]),
                      optional_vars=Name(id='mock_llm', ctx=Store()))],
                  body=[
                    Assign(
                      targets=[
                        Attribute(
                          value=Name(id='mock_llm', ctx=Load()),
                          attr='side_effect',
                          ctx=Store())],
                      value=List(
                        elts=[
                          Constant(value='Generated strategy for senior software engineer'),
                          Constant(value='Drafted resume content'),
                          Constant(value='QA evaluation passed'),
                          Constant(value='Safety check passed')],
                        ctx=Load())),
                    ImportFrom(
                      module='l2',
                      names=[
                        alias(name='L2ResultBundle')],
                      level=0),
                    Assign(
                      targets=[
                        Name(id='mock_strategy', ctx=Store())],
                      value=Call(
                        func=Name(id='Mock', ctx=Load()))),
                    Assign(
                      targets=[
                        Attribute(
                          value=Name(id='mock_strategy', ctx=Load()),
                          attr='branches',
                          ctx=Store())],
                      value=List(
                        elts=[
                          Call(
                            func=Name(id='Mock', ctx=Load()),
                            keywords=[
                              keyword(
                                arg='description',
                                value=Constant(value='Senior engineer strategy'))])],
                        ctx=Load())),
                    Assign(
                      targets=[
                        Attribute(
                          value=Name(id='mock_execute', ctx=Load()),
                          attr='return_value',
                          ctx=Store())],
                      value=Call(
                        func=Name(id='L2ResultBundle', ctx=Load()),
                        keywords=[
                          keyword(
                            arg='strategy',
                            value=Name(id='mock_strategy', ctx=Load())),
                          keyword(
                            arg='rag',
                            value=Call(
                              func=Name(id='Mock', ctx=Load()))),
                          keyword(
                            arg='drafting',
                            value=Call(
                              func=Name(id='Mock', ctx=Load()))),
                          keyword(
                            arg='qa',
                            value=Call(
                              func=Name(id='Mock', ctx=Load()))),
                          keyword(
                            arg='safety',
                            value=Call(
                              func=Name(id='Mock', ctx=Load())))])),
                    ImportFrom(
                      module='orchestration.run_dag',
                      names=[
                        alias(name='run_dag')],
                      level=0),
                    Assign(
