                        args=[
                          Name(id='plans', ctx=Load()),
                          Name(id='ctx', ctx=Load())])),
                    Assert(
                      test=Compare(
                        left=Name(id='result', ctx=Load()),
                        ops=[
                          IsNot()],
                        comparators=[
                          Constant(value=None)])),
                    Assert(
                      test=Compare(
                        left=Subscript(
                          value=Attribute(
                            value=Name(id='result', ctx=Load()),
                            attr='final_state_patch',
                            ctx=Load()),
                          slice=Constant(value='strategy_text'),
                          ctx=Load()),
                        ops=[
                          IsNot()],
                        comparators=[
                          Constant(value=None)]))])])]),
        FunctionDef(
