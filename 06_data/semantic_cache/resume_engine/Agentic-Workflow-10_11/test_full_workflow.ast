Module(
  body=[
    Expr(
      value=Constant(value='End-to-End Workflow Tests\n\nTests complete workflows from job input to final output,\nintegrating all layers and components.\n')),
    Import(
      names=[
        alias(name='pytest')]),
    ImportFrom(
      module='unittest.mock',
      names=[
        alias(name='Mock'),
