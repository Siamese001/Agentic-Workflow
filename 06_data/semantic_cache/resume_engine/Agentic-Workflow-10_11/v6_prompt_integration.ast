      names=[
        alias(name='ExampleType'),
        alias(name='get_examples'),
        alias(name='format_examples_for_prompt')],
      level=1),
    FunctionDef(
      name='create_strategy_planner_prompt',
      args=arguments(
        args=[
          arg(
            arg='include_examples',
            annotation=Name(id='bool', ctx=Load())),
          arg(
            arg='enable_cot',
            annotation=Name(id='bool', ctx=Load()))],
        defaults=[
          Constant(value=True),
          Constant(value=True)]),
      body=[
        Expr(
          value=Constant(value='\nCreates v6 prompt for L1 strategy planner with resume examples.\n\nGenerates structured approach for optimal resume job alignment\nand enhanced content quality.\n    ')),
        Assign(
          targets=[
            Name(id='prompt', ctx=Store())],
          value=Call(
            func=Name(id='create_l1_planner_prompt', ctx=Load()),
            keywords=[
              keyword(
                arg='agent_name',
                value=Constant(value='Strategy Planner')),
              keyword(
                arg='domain',
                value=Constant(value='resume tailoring')),
              keyword(
                arg='objective',
                value=Constant(value='Analyze job description and resume to create a tailored strategy plan that emphasizes relevant experience and skills.'))])),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='prompt', ctx=Load()),
              attr='add_layer',
              ctx=Load()),
            args=[
              Call(
                func=Name(id='LayerContent', ctx=Load()),
                keywords=[
                  keyword(
                    arg='layer',
                    value=Attribute(
                      value=Name(id='InstructionalLayer', ctx=Load()),
                      attr='DOMAIN_CONTEXT',
                      ctx=Load())),
                  keyword(
                    arg='content',
                    value=Call(
                      func=Attribute(
                        value=Constant(value="\nDomain: Resume Tailoring for Job Applications\n\nKey Concepts:\n- Job requirements: Skills, experience, and qualifications sought by employer\n- Resume content: Candidate's experience, skills, and achievements\n- Strategy: Approach to emphasize relevant content and deemphasize irrelevant content\n- Tone: Professional communication style appropriate for the role level\n- Gaps: Missing qualifications that need mitigation strategies\n"),
                        attr='strip',
                        ctx=Load()))),
                  keyword(
                    arg='priority',
                    value=Constant(value=8))])])),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='prompt', ctx=Load()),
              attr='add_layer',
              ctx=Load()),
            args=[
              Call(
                func=Name(id='LayerContent', ctx=Load()),
                keywords=[
                  keyword(
                    arg='layer',
                    value=Attribute(
                      value=Name(id='InstructionalLayer', ctx=Load()),
                      attr='DOMAIN_KNOWLEDGE',
                      ctx=Load())),
                  keyword(
                    arg='content',
                    value=Call(
                      func=Attribute(
                        value=Constant(value='\nResume Tailoring Best Practices:\n1. Match keywords from job description (ATS optimization)\n2. Quantify achievements with metrics when possible\n3. Emphasize recent and relevant experience\n4. Address gaps proactively with mitigation strategies\n5. Adjust tone based on role level (entry/mid/senior/executive)\n6. Highlight transferable skills for career transitions\n7. Use action verbs and achievement-focused language\n'),
                        attr='strip',
                        ctx=Load()))),
                  keyword(
                    arg='priority',
                    value=Constant(value=7))])])),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='prompt', ctx=Load()),
              attr='add_layer',
              ctx=Load()),
            args=[
              Call(
                func=Name(id='LayerContent', ctx=Load()),
                keywords=[
                  keyword(
                    arg='layer',
                    value=Attribute(
                      value=Name(id='InstructionalLayer', ctx=Load()),
                      attr='CONSTRAINTS',
                      ctx=Load())),
                  keyword(
                    arg='content',
                    value=Call(
                      func=Attribute(
                        value=Constant(value='\nHard Constraints:\n- Never fabricate experience or skills\n- Never suggest misleading information\n- Plans must be executable by L2 agents\n- Output must be valid JSON\n\nSoft Constraints:\n- Prefer recent experience (last 3-5 years)\n- Limit strategy to 3-5 key themes\n- Keep complexity estimates realistic\n'),
                        attr='strip',
                        ctx=Load()))),
                  keyword(
                    arg='priority',
                    value=Constant(value=9))])])),
        If(
          test=Name(id='enable_cot', ctx=Load()),
          body=[
            Expr(
              value=Call(
                func=Name(id='add_cot_extension', ctx=Load()),
                args=[
                  Name(id='prompt', ctx=Load())]))]),
        Assign(
          targets=[
            Name(id='base_prompt', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='prompt', ctx=Load()),
              attr='render',
              ctx=Load()))),
        If(
          test=Name(id='include_examples', ctx=Load()),
          body=[
            Assign(
              targets=[
