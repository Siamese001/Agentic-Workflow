                      attr='SAFETY_CONSTRAINTS',
                      ctx=Load())),
                  keyword(
                    arg='content',
                    value=Call(
                      func=Attribute(
                        value=Constant(value='\nSafety Categories to Check:\n1. No fabricated experience or credentials\n2. No misleading claims\n3. No protected class information (age, race, religion, etc.)\n4. No inappropriate language\n5. No confidential information from previous employers\n6. No false certifications or degrees\n7. No plagiarized content\n'),
                        attr='strip',
                        ctx=Load()))),
                  keyword(
                    arg='priority',
                    value=Constant(value=10))])])),
        Expr(
