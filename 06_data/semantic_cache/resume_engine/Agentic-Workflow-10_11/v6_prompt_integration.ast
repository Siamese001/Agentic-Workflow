                func=Name(id='LayerContent', ctx=Load()),
                keywords=[
                  keyword(
                    arg='layer',
                    value=Attribute(
                      value=Name(id='InstructionalLayer', ctx=Load()),
                      attr='DOMAIN_CONTEXT',
                      ctx=Load())),
                  keyword(
                    arg='content',
                    value=Call(
                      func=Attribute(
                        value=Constant(value='\nDomain: Resume Quality Assurance\n\nKey Concepts:\n- Accuracy: Factual correctness of claims\n- Completeness: All required sections present\n- Consistency: Uniform style and formatting\n- Relevance: Alignment with job requirements\n- Readability: Clear and professional language\n- ATS compatibility: Keyword optimization\n'),
                        attr='strip',
                        ctx=Load()))),
                  keyword(
                    arg='priority',
                    value=Constant(value=8))])])),
        Expr(
