              keyword(
                arg='objective',
                value=Constant(value='Create comprehensive QA plans to validate resume quality, accuracy, and alignment with job requirements.'))])),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='prompt', ctx=Load()),
              attr='add_layer',
              ctx=Load()),
            args=[
