              keyword(
                arg='objective',
                value=Constant(value='Create safety review plans to detect and prevent problematic content in resumes.'))])),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='prompt', ctx=Load()),
              attr='add_layer',
              ctx=Load()),
            args=[
              Call(
                func=Name(id='LayerContent', ctx=Load()),
                keywords=[
                  keyword(
                    arg='layer',
                    value=Attribute(
