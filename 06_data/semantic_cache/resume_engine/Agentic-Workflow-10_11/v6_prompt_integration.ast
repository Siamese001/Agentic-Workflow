      returns=Name(id='str', ctx=Load())),
    FunctionDef(
      name='create_strategy_executor_prompt',
      args=arguments(
        args=[
          arg(
            arg='include_examples',
            annotation=Name(id='bool', ctx=Load()))],
        defaults=[
          Constant(value=True)]),
      body=[
        Expr(
          value=Constant(value='Create v6 prompt for L2 strategy executor with examples.\n    \n    Args:\n        include_examples: Whether to include many-shot examples\n        \n    Returns:\n        Rendered prompt string\n    ')),
        Assign(
          targets=[
            Name(id='prompt', ctx=Store())],
          value=Call(
            func=Name(id='create_l2_executor_prompt', ctx=Load()),
            keywords=[
              keyword(
                arg='agent_name',
                value=Constant(value='Strategy Executor')),
              keyword(
                arg='domain',
                value=Constant(value='resume tailoring')),
              keyword(
                arg='capabilities',
                value=List(
                  elts=[
                    Constant(value='analyze job requirements'),
                    Constant(value='identify key themes'),
                    Constant(value='select emphasis areas'),
                    Constant(value='determine tone'),
                    Constant(value='estimate complexity')],
                  ctx=Load()))])),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='prompt', ctx=Load()),
              attr='add_layer',
              ctx=Load()),
            args=[
              Call(
                func=Name(id='LayerContent', ctx=Load()),
                keywords=[
                  keyword(
                    arg='layer',
                    value=Attribute(
                      value=Name(id='InstructionalLayer', ctx=Load()),
                      attr='PROCEDURAL_MEMORY',
                      ctx=Load())),
                  keyword(
                    arg='content',
                    value=Call(
                      func=Attribute(
                        value=Constant(value='\nExecution Procedure:\n1. Parse strategy plan from L1\n2. Extract job requirements and resume content\n3. Apply strategy approach (technical_depth, transferable_skills, etc.)\n4. Generate tailored content sections\n5. Validate output against plan\n6. Return structured result\n'),
                        attr='strip',
                        ctx=Load()))),
                  keyword(
                    arg='priority',
                    value=Constant(value=8))])])),
        Assign(
          targets=[
            Name(id='base_prompt', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='prompt', ctx=Load()),
              attr='render',
              ctx=Load()))),
        If(
          test=Name(id='include_examples', ctx=Load()),
          body=[
            Assign(
              targets=[
                Name(id='examples', ctx=Store())],
              value=Call(
                func=Name(id='get_examples', ctx=Load()),
                keywords=[
                  keyword(
                    arg='example_type',
                    value=Attribute(
                      value=Name(id='ExampleType', ctx=Load()),
                      attr='L2_STRATEGY_EXECUTION',
                      ctx=Load())),
                  keyword(
                    arg='max_examples',
                    value=Constant(value=2)),
                  keyword(
                    arg='min_quality',
                    value=Constant(value=0.9))])),
            Assign(
              targets=[
                Name(id='examples_section', ctx=Store())],
              value=Call(
                func=Name(id='format_examples_for_prompt', ctx=Load()),
                args=[
                  Name(id='examples', ctx=Load())])),
            Return(
              value=JoinedStr(
                values=[
                  FormattedValue(
                    value=Name(id='base_prompt', ctx=Load()),
                    conversion=-1),
                  Constant(value='\n\n'),
                  FormattedValue(
                    value=Name(id='examples_section', ctx=Load()),
                    conversion=-1)]))]),
        Return(
          value=Name(id='base_prompt', ctx=Load()))],
      returns=Name(id='str', ctx=Load())),
    FunctionDef(
      name='validate_v6_prompt',
      args=arguments(
        args=[
          arg(
            arg='prompt',
            annotation=Name(id='InstructionalPrompt', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='Validate a v6 prompt for completeness and correctness.\n    \n    Args:\n        prompt: InstructionalPrompt to validate\n        \n    Returns:\n        List of validation issues (empty if valid)\n    ')),
        Assign(
          targets=[
            Name(id='issues', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='prompt', ctx=Load()),
              attr='validate',
              ctx=Load()))),
        If(
          test=Compare(
            left=Attribute(
              value=Name(id='prompt', ctx=Load()),
              attr='layer_type',
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value='L1')]),
          body=[
            If(
              test=Compare(
                left=Attribute(
                  value=Name(id='InstructionalLayer', ctx=Load()),
                  attr='REASONING_MODE',
                  ctx=Load()),
                ops=[
                  NotIn()],
                comparators=[
                  Attribute(
                    value=Name(id='prompt', ctx=Load()),
                    attr='layers',
                    ctx=Load())]),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='issues', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Constant(value='L1 planner missing REASONING_MODE layer')]))]),
            If(
              test=Compare(
                left=Attribute(
                  value=Name(id='InstructionalLayer', ctx=Load()),
                  attr='DOMAIN_KNOWLEDGE',
                  ctx=Load()),
                ops=[
                  NotIn()],
                comparators=[
                  Attribute(
                    value=Name(id='prompt', ctx=Load()),
                    attr='layers',
                    ctx=Load())]),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='issues', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Constant(value='L1 planner missing DOMAIN_KNOWLEDGE layer')]))])]),
        If(
          test=Compare(
            left=Attribute(
              value=Name(id='prompt', ctx=Load()),
              attr='layer_type',
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value='L2')]),
          body=[
            If(
              test=Compare(
                left=Attribute(
                  value=Name(id='InstructionalLayer', ctx=Load()),
                  attr='PROCEDURAL_MEMORY',
                  ctx=Load()),
                ops=[
                  NotIn()],
                comparators=[
                  Attribute(
                    value=Name(id='prompt', ctx=Load()),
                    attr='layers',
                    ctx=Load())]),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='issues', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Constant(value='L2 executor missing PROCEDURAL_MEMORY layer')]))]),
            If(
              test=Compare(
                left=Attribute(
                  value=Name(id='InstructionalLayer', ctx=Load()),
                  attr='ERROR_RECOVERY',
                  ctx=Load()),
                ops=[
                  NotIn()],
                comparators=[
                  Attribute(
                    value=Name(id='prompt', ctx=Load()),
                    attr='layers',
                    ctx=Load())]),
              body=[
                Expr(
                  value=Call(
