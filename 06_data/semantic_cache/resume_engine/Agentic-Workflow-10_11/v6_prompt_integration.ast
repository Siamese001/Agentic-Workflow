                  FormattedValue(
                    value=Name(id='examples_section', ctx=Load()),
                    conversion=-1)]))]),
        Return(
          value=Name(id='base_prompt', ctx=Load()))],
      returns=Name(id='str', ctx=Load())),
    FunctionDef(
      name='create_rag_planner_prompt',
      args=arguments(
        args=[
          arg(
            arg='include_examples',
            annotation=Name(id='bool', ctx=Load())),
          arg(
            arg='rag_config',
            annotation=Subscript(
              value=Name(id='Optional', ctx=Load()),
              slice=Subscript(
                value=Name(id='Dict', ctx=Load()),
                slice=Tuple(
                  elts=[
                    Name(id='str', ctx=Load()),
                    Name(id='Any', ctx=Load())],
                  ctx=Load()),
                ctx=Load()),
              ctx=Load()))],
        defaults=[
          Constant(value=True),
          Constant(value=None)]),
      body=[
        Expr(
          value=Constant(value='Create v6 prompt for L1 RAG planner with examples.\n    \n    Args:\n        include_examples: Whether to include many-shot examples\n        rag_config: RAG configuration (top_k, filters, etc.)\n        \n    Returns:\n        Rendered prompt string\n    ')),
        Assign(
          targets=[
            Name(id='prompt', ctx=Store())],
          value=Call(
            func=Name(id='create_l1_planner_prompt', ctx=Load()),
            keywords=[
              keyword(
                arg='agent_name',
                value=Constant(value='RAG Planner')),
              keyword(
                arg='domain',
                value=Constant(value='retrieval-augmented generation')),
              keyword(
                arg='objective',
                value=Constant(value='Create optimized retrieval plans to find relevant evidence from vector stores and knowledge bases.'))])),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='prompt', ctx=Load()),
              attr='add_layer',
              ctx=Load()),
            args=[
              Call(
                func=Name(id='LayerContent', ctx=Load()),
                keywords=[
                  keyword(
                    arg='layer',
                    value=Attribute(
                      value=Name(id='InstructionalLayer', ctx=Load()),
                      attr='DOMAIN_CONTEXT',
                      ctx=Load())),
                  keyword(
                    arg='content',
                    value=Call(
                      func=Attribute(
                        value=Constant(value='\nDomain: Retrieval-Augmented Generation (RAG)\n\nKey Concepts:\n- Query formulation: Crafting effective search queries\n- Vector similarity: Semantic search in embedding space\n- Metadata filtering: Narrowing results by attributes\n- Temporal filtering: Time-based result filtering\n- Reranking: Improving result relevance\n- Multi-query: Multiple queries for comprehensive coverage\n'),
                        attr='strip',
                        ctx=Load()))),
                  keyword(
                    arg='priority',
                    value=Constant(value=8))])])),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='prompt', ctx=Load()),
              attr='add_layer',
              ctx=Load()),
            args=[
              Call(
                func=Name(id='LayerContent', ctx=Load()),
                keywords=[
                  keyword(
                    arg='layer',
                    value=Attribute(
                      value=Name(id='InstructionalLayer', ctx=Load()),
                      attr='DOMAIN_KNOWLEDGE',
                      ctx=Load())),
                  keyword(
                    arg='content',
                    value=Call(
                      func=Attribute(
                        value=Constant(value='\nRAG Best Practices:\n1. Use multiple queries for complex information needs\n2. Apply metadata filters to narrow scope\n3. Set appropriate score thresholds (typically 0.7-0.8)\n4. Use temporal filters for time-sensitive queries\n5. Enable reranking for better precision\n6. Balance recall (top_k) with precision (threshold)\n7. Consider query expansion for better coverage\n'),
                        attr='strip',
                        ctx=Load()))),
                  keyword(
                    arg='priority',
                    value=Constant(value=7))])])),
        If(
          test=Compare(
            left=Name(id='rag_config', ctx=Load()),
            ops=[
              Is()],
            comparators=[
              Constant(value=None)]),
          body=[
            Assign(
              targets=[
                Name(id='rag_config', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='top_k'),
                  Constant(value='score_threshold')],
                values=[
                  Constant(value=10),
                  Constant(value=0.7)]))]),
        Expr(
          value=Call(
            func=Name(id='add_rag_extension', ctx=Load()),
            args=[
              Name(id='prompt', ctx=Load()),
              Name(id='rag_config', ctx=Load())])),
        Assign(
          targets=[
            Name(id='base_prompt', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='prompt', ctx=Load()),
              attr='render',
              ctx=Load()))),
        If(
          test=Name(id='include_examples', ctx=Load()),
          body=[
            Assign(
              targets=[
                Name(id='examples', ctx=Store())],
              value=Call(
                func=Name(id='get_examples', ctx=Load()),
                keywords=[
                  keyword(
                    arg='example_type',
                    value=Attribute(
                      value=Name(id='ExampleType', ctx=Load()),
                      attr='L1_RAG_PLANNING',
                      ctx=Load())),
                  keyword(
                    arg='max_examples',
                    value=Constant(value=3)),
                  keyword(
                    arg='min_quality',
                    value=Constant(value=0.9))])),
            Assign(
              targets=[
                Name(id='examples_section', ctx=Store())],
              value=Call(
                func=Name(id='format_examples_for_prompt', ctx=Load()),
                args=[
                  Name(id='examples', ctx=Load())])),
            Return(
              value=JoinedStr(
                values=[
                  FormattedValue(
                    value=Name(id='base_prompt', ctx=Load()),
                    conversion=-1),
                  Constant(value='\n\n'),
                  FormattedValue(
                    value=Name(id='examples_section', ctx=Load()),
                    conversion=-1)]))]),
        Return(
          value=Name(id='base_prompt', ctx=Load()))],
      returns=Name(id='str', ctx=Load())),
    FunctionDef(
