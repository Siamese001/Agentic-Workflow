                      value=Name(id='InstructionalLayer', ctx=Load()),
                      attr='ETHICAL_GUIDELINES',
                      ctx=Load())),
                  keyword(
                    arg='content',
                    value=Call(
                      func=Attribute(
                        value=Constant(value='\nEthical Guidelines:\n1. Truthfulness: All claims must be factually accurate\n2. Privacy: Respect confidentiality of previous employers\n3. Fairness: Avoid discriminatory content\n4. Transparency: Be honest about gaps and transitions\n5. Professionalism: Maintain appropriate tone\n'),
                        attr='strip',
                        ctx=Load()))),
                  keyword(
                    arg='priority',
                    value=Constant(value=10))])])),
        Assign(
          targets=[
            Name(id='base_prompt', ctx=Store())],
