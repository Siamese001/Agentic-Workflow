                keywords=[
                  keyword(
                    arg='example_type',
                    value=Attribute(
                      value=Name(id='ExampleType', ctx=Load()),
                      attr='L1_STRATEGY_PLANNING',
                      ctx=Load())),
                  keyword(
                    arg='max_examples',
                    value=Constant(value=4)),
                  keyword(
                    arg='min_quality',
                    value=Constant(value=0.9))])),
            Assign(
              targets=[
                Name(id='examples_section', ctx=Store())],
              value=Call(
                func=Name(id='format_examples_for_prompt', ctx=Load()),
                args=[
                  Name(id='examples', ctx=Load())])),
            Return(
