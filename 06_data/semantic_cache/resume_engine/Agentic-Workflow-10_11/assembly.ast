Module(
  body=[
    Expr(
      value=Constant(value='\nContext assembly and pruning for résumé processing workflows.\n\nOrchestrates relevant information into structured text blocks for optimal résumé improvement prompts.\n')),
    ImportFrom(
      module='typing',
      names=[
        alias(name='List')],
      level=0),
    ImportFrom(
      module='pinned',
      names=[
        alias(name='PinnedItem'),
        alias(name='filter_pinned')],
      level=1),
    ImportFrom(
      module='relevance',
      names=[
        alias(name='ContextItem'),
        alias(name='score_relevance')],
      level=1),
    ImportFrom(
      module='slots',
      names=[
        alias(name='ContextSlot'),
        alias(name='assign_to_slot')],
      level=1),
    FunctionDef(
      name='assemble_context',
      args=arguments(
        args=[
          arg(
            arg='query',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='pinned',
            annotation=Subscript(
              value=Name(id='List', ctx=Load()),
              slice=Name(id='PinnedItem', ctx=Load()),
              ctx=Load())),
          arg(
            arg='candidates',
            annotation=Subscript(
              value=Name(id='List', ctx=Load()),
              slice=Name(id='ContextItem', ctx=Load()),
              ctx=Load())),
          arg(
            arg='slots',
            annotation=Subscript(
              value=Name(id='List', ctx=Load()),
              slice=Name(id='ContextSlot', ctx=Load()),
              ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Assembles context strings for résumé improvement prompt generation.\n\n    Prioritizes relevant information to ensure comprehensive résumé enhancement processing.\n    ')),
        AnnAssign(
          target=Name(id='result', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load()),
          value=List(ctx=Load()),
          simple=1),
        Assign(
          targets=[
            Name(id='pinned_selected', ctx=Store())],
          value=Call(
            func=Name(id='filter_pinned', ctx=Load()),
            args=[
              Name(id='pinned', ctx=Load())],
            keywords=[
              keyword(
                arg='max_items',
                value=Call(
                  func=Name(id='sum', ctx=Load()),
                  args=[
                    GeneratorExp(
                      elt=Attribute(
                        value=Name(id='s', ctx=Load()),
                        attr='max_items',
                        ctx=Load()),
                      generators=[
                        comprehension(
                          target=Name(id='s', ctx=Store()),
                          iter=Name(id='slots', ctx=Load()),
                          is_async=0)])]))])),
        Assign(
          targets=[
            Name(id='scored', ctx=Store())],
          value=Call(
            func=Name(id='score_relevance', ctx=Load()),
            args=[
              Name(id='query', ctx=Load()),
              Name(id='candidates', ctx=Load())])),
        Assign(
          targets=[
            Name(id='ranked_candidates', ctx=Store())],
          value=ListComp(
            elt=Name(id='item', ctx=Load()),
            generators=[
              comprehension(
                target=Tuple(
                  elts=[
                    Name(id='item', ctx=Store()),
                    Name(id='_', ctx=Store())],
                  ctx=Store()),
                iter=Name(id='scored', ctx=Load()),
                is_async=0)])),
        Assign(
          targets=[
            Name(id='pinned_texts', ctx=Store())],
          value=ListComp(
            elt=Attribute(
              value=Name(id='p', ctx=Load()),
              attr='text',
              ctx=Load()),
            generators=[
              comprehension(
                target=Name(id='p', ctx=Store()),
                iter=Name(id='pinned_selected', ctx=Load()),
                is_async=0)])),
        Assign(
          targets=[
            Name(id='candidate_texts', ctx=Store())],
          value=ListComp(
            elt=Attribute(
              value=Name(id='c', ctx=Load()),
              attr='text',
              ctx=Load()),
            generators=[
              comprehension(
                target=Name(id='c', ctx=Store()),
                iter=Name(id='ranked_candidates', ctx=Load()),
                is_async=0)])),
        For(
          target=Name(id='slot', ctx=Store()),
          iter=Name(id='slots', ctx=Load()),
          body=[
            Assign(
              targets=[
                Name(id='texts_for_slot', ctx=Store())],
              value=BinOp(
                left=Name(id='pinned_texts', ctx=Load()),
                op=Add(),
                right=Name(id='candidate_texts', ctx=Load()))),
            Assign(
              targets=[
                Name(id='assigned', ctx=Store())],
              value=Call(
                func=Name(id='assign_to_slot', ctx=Load()),
                args=[
                  Name(id='slot', ctx=Load()),
                  Name(id='texts_for_slot', ctx=Load())])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='result', ctx=Load()),
                  attr='extend',
                  ctx=Load()),
                args=[
                  Name(id='assigned', ctx=Load())]))]),
        Return(
          value=Name(id='result', ctx=Load()))],
      returns=Subscript(
        value=Name(id='List', ctx=Load()),
        slice=Name(id='str', ctx=Load()),
        ctx=Load()))])