Module(
  body=[
    ImportFrom(
      module='eval.golden_state.models',
      names=[
        alias(name='GoldenStateTestCase')],
      level=0),
    ImportFrom(
      module='eval.golden_state.judge',
      names=[
        alias(name='evaluate_output')],
      level=0),
    FunctionDef(
      name='test_judge_empty_output_fails',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='tc', ctx=Store())],
          value=Call(
            func=Name(id='GoldenStateTestCase', ctx=Load()),
            keywords=[
              keyword(
                arg='id',
                value=Constant(value='t1')),
              keyword(
                arg='input_text',
                value=Constant(value='x')),
              keyword(
                arg='expected_behavior',
                value=Constant(value='')),
              keyword(arg='metadata', value=Dict())])),
        Assign(
          targets=[
            Name(id='verdict', ctx=Store())],
          value=Call(
            func=Name(id='evaluate_output', ctx=Load()),
            args=[
              Name(id='tc', ctx=Load()),
              Constant(value='')])),
        Assert(
          test=Compare(
            left=Attribute(
              value=Name(id='verdict', ctx=Load()),
              attr='rating',
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value='fail')])),
        Assert(
          test=Compare(
            left=Attribute(
              value=Name(id='verdict', ctx=Load()),
              attr='score',
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value=0.0)]))]),
    FunctionDef(
      name='test_judge_detects_key_behavior',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='tc', ctx=Store())],
          value=Call(
            func=Name(id='GoldenStateTestCase', ctx=Load()),
            keywords=[
              keyword(
                arg='id',
                value=Constant(value='t2')),
              keyword(
                arg='input_text',
                value=Constant(value='x')),
              keyword(
                arg='expected_behavior',
                value=Constant(value='Summary should be professional')),
              keyword(arg='metadata', value=Dict())])),
        Assign(
          targets=[
            Name(id='verdict', ctx=Store())],
          value=Call(
            func=Name(id='evaluate_output', ctx=Load()),
            args=[
              Name(id='tc', ctx=Load()),
              Constant(value='This is a professional summary.')])),
        Assert(
          test=Compare(
            left=Attribute(
              value=Name(id='verdict', ctx=Load()),
              attr='rating',
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value='pass')])),
        Assert(
          test=Compare(
            left=Attribute(
              value=Name(id='verdict', ctx=Load()),
              attr='score',
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value=1.0)]))])])