Module(
  body=[
    Expr(
      value=Constant(value='Tests for Temporal KG Components - Triplets, Entities, Multi-hop Retrieval\n\nThis module tests the new KG components:\n- L4 TripletStore and EntityRegistry\n- L2 Triplet Extraction and KG Retrieval Executors\n- L1 KG Retrieval Planner\n- L3 KG-First Retrieval Orchestration\n')),
    Import(
      names=[
        alias(name='pytest')]),
    ImportFrom(
      module='datetime',
      names=[
        alias(name='datetime'),
        alias(name='UTC')],
      level=0),
    ImportFrom(
      module='l4.triplet_store',
      names=[
        alias(name='TripletStore'),
        alias(name='Triplet'),
        alias(name='TripletQuery'),
        alias(name='TemporalType'),
        alias(name='TripletStatus'),
        alias(name='create_triplet'),
        alias(name='PREDICATES')],
      level=0),
    ImportFrom(
      module='l4.entity_resolution',
      names=[
        alias(name='EntityRegistry'),
        alias(name='EntityType'),
        alias(name='CanonicalEntity'),
        alias(name='EntityMention'),
        alias(name='create_entity'),
        alias(name='create_mention')],
      level=0),
    ImportFrom(
      module='l1.kg_retrieval_planning',
      names=[
        alias(name='KGRetrievalPlanner'),
        alias(name='KGQueryPlan'),
        alias(name='QueryType'),
        alias(name='HopDirection'),
        alias(name='plan_entity_retrieval')],
      level=0),
    ImportFrom(
      module='l2.kg_retrieval_executor',
      names=[
        alias(name='KGRetrievalExecutor'),
        alias(name='KGRetrievalResult'),
        alias(name='execute_entity_query')],
      level=0),
    ImportFrom(
      module='l2.triplet_extraction_executor',
      names=[
        alias(name='TripletExtractionExecutor'),
        alias(name='ExtractionPlan'),
        alias(name='create_extraction_plan')],
      level=0),
    ImportFrom(
      module='l2.invalidation_executor',
      names=[
        alias(name='InvalidationExecutor'),
        alias(name='InvalidationPlan'),
        alias(name='InvalidationReason'),
        alias(name='create_invalidation_plan')],
      level=0),
    ImportFrom(
      module='orchestration.kg_retrieval_orchestration',
      names=[
        alias(name='KGFirstRetrievalOrchestrator'),
        alias(name='HybridRetrievalContext'),
        alias(name='create_hybrid_context')],
      level=0),
    ClassDef(
      name='TestTripletStore',
      body=[
        Expr(
          value=Constant(value='Test L4 TripletStore functionality.')),
        FunctionDef(
          name='test_create_triplet',
          args=arguments(
