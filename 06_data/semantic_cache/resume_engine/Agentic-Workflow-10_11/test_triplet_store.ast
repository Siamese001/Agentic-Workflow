              value=Constant(value='Test triplet creation.')),
            Assign(
              targets=[
                Name(id='triplet', ctx=Store())],
              value=Call(
                func=Name(id='create_triplet', ctx=Load()),
                keywords=[
                  keyword(
                    arg='subject',
                    value=Constant(value='user_123')),
                  keyword(
                    arg='predicate',
                    value=Constant(value='has_skill')),
                  keyword(
                    arg='obj',
                    value=Constant(value='Python')),
                  keyword(
                    arg='confidence',
                    value=Constant(value=0.9))])),
            Assert(
              test=Compare(
                left=Attribute(
                  value=Name(id='triplet', ctx=Load()),
                  attr='subject',
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value='user_123')])),
            Assert(
              test=Compare(
                left=Attribute(
                  value=Name(id='triplet', ctx=Load()),
                  attr='predicate',
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value='has_skill')])),
            Assert(
              test=Compare(
                left=Attribute(
                  value=Name(id='triplet', ctx=Load()),
                  attr='object',
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value='Python')])),
            Assert(
