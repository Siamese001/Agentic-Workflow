                  attr='status',
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Attribute(
                    value=Name(id='TripletStatus', ctx=Load()),
                    attr='ACTIVE',
                    ctx=Load())]))]),
