Module(
  body=[
    Expr(
      value=Constant(value='L5 Safety Guardrails Tests.')),
    ClassDef(
      name='TestGuardrails',
      body=[
        Expr(
          value=Constant(value='Tests for L5 safety guardrails.')),
        FunctionDef(
          name='test_content_guardrail',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test content guardrail enforcement.')),
            Assign(
              targets=[
                Name(id='content', ctx=Store())],
              value=Constant(value='safe content')),
            Assert(
              test=Compare(
                left=Constant(value='unsafe'),
                ops=[
                  NotIn()],
                comparators=[
                  Name(id='content', ctx=Load())]))]),
        FunctionDef(
          name='test_pii_guardrail',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test PII detection guardrail.')),
            Assign(
              targets=[
                Name(id='text', ctx=Store())],
              value=Constant(value='Hello World')),
            Assign(
              targets=[
                Name(id='has_ssn', ctx=Store())],
              value=Compare(
                left=Constant(value='SSN'),
                ops=[
                  In()],
                comparators=[
                  Name(id='text', ctx=Load())])),
            Assert(
              test=UnaryOp(
                op=Not(),
                operand=Name(id='has_ssn', ctx=Load())))])])])