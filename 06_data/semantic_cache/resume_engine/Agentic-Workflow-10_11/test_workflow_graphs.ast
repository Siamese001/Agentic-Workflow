Module(
  body=[
    Expr(
      value=Constant(value='L3 Orchestration Workflow Graph Tests.')),
    ClassDef(
      name='TestWorkflowGraphs',
      body=[
        Expr(
          value=Constant(value='Tests for L3 workflow graphs.')),
        FunctionDef(
          name='test_graph_construction',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test workflow graph construction.')),
            Assign(
              targets=[
                Name(id='nodes', ctx=Store())],
              value=List(
                elts=[
                  Constant(value='plan'),
                  Constant(value='execute'),
                  Constant(value='validate')],
                ctx=Load())),
            Assign(
              targets=[
                Name(id='edges', ctx=Store())],
              value=List(
                elts=[
                  Tuple(
                    elts=[
                      Constant(value='plan'),
                      Constant(value='execute')],
                    ctx=Load()),
                  Tuple(
                    elts=[
                      Constant(value='execute'),
                      Constant(value='validate')],
                    ctx=Load())],
                ctx=Load())),
            Assert(
              test=Compare(
                left=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Name(id='nodes', ctx=Load())]),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value=3)])),
            Assert(
              test=Compare(
                left=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Name(id='edges', ctx=Load())]),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value=2)]))]),
        FunctionDef(
          name='test_graph_traversal',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test workflow graph traversal.')),
            Assign(
              targets=[
                Name(id='visited', ctx=Store())],
              value=List(ctx=Load())),
            Assign(
              targets=[
                Name(id='nodes', ctx=Store())],
              value=List(
                elts=[
                  Constant(value='a'),
                  Constant(value='b'),
                  Constant(value='c')],
                ctx=Load())),
            For(
              target=Name(id='node', ctx=Store()),
              iter=Name(id='nodes', ctx=Load()),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='visited', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Name(id='node', ctx=Load())]))]),
            Assert(
              test=Compare(
                left=Name(id='visited', ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Name(id='nodes', ctx=Load())]))])])])