Module(
  body=[
    Expr(
      value=Constant(value='Redis-backed caching utilities (v10_10 · META cache layer).\n\nThis module encapsulates all direct interactions with Redis so that\ncore layers and agents remain pure. It is safe to import even if the\n`redis` package is not installed: imports are performed lazily inside\nhelper functions and surfaced as explicit errors.\n')),
    ImportFrom(
      module='__future__',
      names=[
        alias(name='annotations')],
      level=0),
    Import(
      names=[
        alias(name='json')]),
    Import(
      names=[
        alias(name='os')]),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Any'),
        alias(name='Optional')],
      level=0),
    ClassDef(
      name='RedisNotConfiguredError',
      bases=[
        Name(id='RuntimeError', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Raised when Redis usage is requested but not configured/enabled.'))]),
    ClassDef(
      name='RedisClientError',
      bases=[
        Name(id='RuntimeError', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Raised when the underlying Redis client cannot be created or used.'))]),
    FunctionDef(
      name='_import_redis',
      args=arguments(),
      body=[
        Expr(
          value=Constant(value='Import the redis package using provider isolation.\n\n    This helper ensures the module uses the provider layer instead of direct SDK imports.\n    ')),
        ImportFrom(
          module='providers.redis_client',
          names=[
            alias(name='RedisClient')],
          level=0),
        Return(
          value=Name(id='RedisClient', ctx=Load()))]),
    FunctionDef(
      name='init_redis_client',
      args=arguments(
        args=[
          arg(
            arg='url',
            annotation=Subscript(
              value=Name(id='Optional', ctx=Load()),
              slice=Name(id='str', ctx=Load()),
              ctx=Load()))],
        kwonlyargs=[
          arg(
            arg='timeout_s',
            annotation=Name(id='float', ctx=Load()))],
        kw_defaults=[
          Constant(value=1.0)],
        defaults=[
          Constant(value=None)]),
      body=[
        Expr(
          value=Constant(value='Initialise a synchronous Redis client.\n\n    Parameters\n    ----------\n    url:\n        Redis connection URL. If omitted, REDIS_URL is read from the\n        environment. If still missing, :class:`RedisNotConfiguredError`\n        is raised.\n    timeout_s:\n        Socket/connect timeout in seconds.\n    ')),
        Assign(
          targets=[
            Name(id='url', ctx=Store())],
          value=BoolOp(
            op=Or(),
            values=[
              Name(id='url', ctx=Load()),
              Call(
                func=Attribute(
                  value=Name(id='os', ctx=Load()),
                  attr='getenv',
                  ctx=Load()),
                args=[
                  Constant(value='REDIS_URL')])])),
        If(
          test=UnaryOp(
            op=Not(),
            operand=Name(id='url', ctx=Load())),
          body=[
            Raise(
              exc=Call(
                func=Name(id='RedisNotConfiguredError', ctx=Load()),
                args=[
                  Constant(value='REDIS_URL not configured')]))]),
        Assign(
          targets=[
            Name(id='redis', ctx=Store())],
          value=Call(
            func=Name(id='_import_redis', ctx=Load()))),
        Try(
          body=[
            Assign(
              targets=[
                Name(id='client', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='redis', ctx=Load()),
                    attr='Redis',
                    ctx=Load()),
                  attr='from_url',
                  ctx=Load()),
                args=[
                  Name(id='url', ctx=Load())],
                keywords=[
                  keyword(
                    arg='socket_timeout',
                    value=Name(id='timeout_s', ctx=Load()))])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='client', ctx=Load()),
                  attr='ping',
                  ctx=Load())))],
          handlers=[
            ExceptHandler(
              type=Name(id='Exception', ctx=Load()),
              name='exc',
              body=[
                Raise(
                  exc=Call(
                    func=Name(id='RedisClientError', ctx=Load()),
                    args=[
                      JoinedStr(
                        values=[
                          Constant(value='Failed to connect to Redis at '),
                          FormattedValue(
                            value=Name(id='url', ctx=Load()),
                            conversion=114),
                          Constant(value=': '),
                          FormattedValue(
                            value=Name(id='exc', ctx=Load()),
                            conversion=-1)])]),
                  cause=Name(id='exc', ctx=Load()))])]),
        Return(
          value=Name(id='client', ctx=Load()))]),
    FunctionDef(
      name='redis_healthcheck',
      args=arguments(
        args=[
          arg(arg='client')]),
      body=[
        Expr(
          value=Constant(value='Return True if the Redis client responds to PING, False otherwise.')),
        Try(
          body=[
            Return(
              value=Call(
                func=Name(id='bool', ctx=Load()),
                args=[
                  Call(
                    func=Attribute(
                      value=Name(id='client', ctx=Load()),
                      attr='ping',
                      ctx=Load()))]))],
          handlers=[
            ExceptHandler(
              type=Name(id='Exception', ctx=Load()),
              body=[
                Return(
                  value=Constant(value=False))])])],
      returns=Name(id='bool', ctx=Load())),
    FunctionDef(
      name='get_llm_cache',
      args=arguments(
        args=[
          arg(arg='client'),
          arg(
            arg='key',
            annotation=Name(id='str', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='Fetch a cached LLM payload by key.\n\n    The value is expected to be JSON-encoded; failures to decode will\n    result in ``None``.\n    ')),
        Try(
          body=[
            Assign(
              targets=[
                Name(id='raw', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='client', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Name(id='key', ctx=Load())]))],
          handlers=[
            ExceptHandler(
              type=Name(id='Exception', ctx=Load()),
              name='exc',
              body=[
                Raise(
                  exc=Call(
                    func=Name(id='RedisClientError', ctx=Load()),
                    args=[
                      JoinedStr(
                        values=[
                          Constant(value='Redis GET failed for key='),
                          FormattedValue(
                            value=Name(id='key', ctx=Load()),
                            conversion=114),
                          Constant(value=': '),
                          FormattedValue(
                            value=Name(id='exc', ctx=Load()),
                            conversion=-1)])]),
                  cause=Name(id='exc', ctx=Load()))])]),
        If(
          test=Compare(
            left=Name(id='raw', ctx=Load()),
            ops=[
              Is()],
            comparators=[
              Constant(value=None)]),
          body=[
            Return(
              value=Constant(value=None))]),
        Try(
          body=[
            Return(
              value=Call(
                func=Attribute(
                  value=Name(id='json', ctx=Load()),
                  attr='loads',
                  ctx=Load()),
                args=[
                  Name(id='raw', ctx=Load())]))],
          handlers=[
            ExceptHandler(
              type=Name(id='Exception', ctx=Load()),
              body=[
                Return(
                  value=Name(id='raw', ctx=Load()))])])],
      returns=Subscript(
        value=Name(id='Optional', ctx=Load()),
        slice=Name(id='Any', ctx=Load()),
        ctx=Load())),
    FunctionDef(
      name='set_llm_cache',
      args=arguments(
        args=[
          arg(arg='client'),
          arg(
            arg='key',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='value',
            annotation=Name(id='Any', ctx=Load()))],
        kwonlyargs=[
          arg(
            arg='ttl_s',
            annotation=Subscript(
              value=Name(id='Optional', ctx=Load()),
              slice=Name(id='int', ctx=Load()),
              ctx=Load()))],
        kw_defaults=[
          Constant(value=3600)]),
      body=[
        Expr(
          value=Constant(value='Store a cached LLM payload by key.\n\n    The value is JSON-encoded before writing. Errors are surfaced as\n    :class:`RedisClientError`.\n    ')),
        Try(
          body=[
            Assign(
              targets=[
                Name(id='payload', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='json', ctx=Load()),
                  attr='dumps',
                  ctx=Load()),
                args=[
                  Name(id='value', ctx=Load())]))],
          handlers=[
            ExceptHandler(
              type=Name(id='TypeError', ctx=Load()),
              name='exc',
              body=[
                Raise(
                  exc=Call(
                    func=Name(id='RedisClientError', ctx=Load()),
                    args=[
                      JoinedStr(
                        values=[
                          Constant(value='Value for key='),
                          FormattedValue(
                            value=Name(id='key', ctx=Load()),
                            conversion=114),
                          Constant(value=' is not JSON serialisable: '),
                          FormattedValue(
                            value=Name(id='exc', ctx=Load()),
                            conversion=-1)])]),
                  cause=Name(id='exc', ctx=Load()))])]),
        Try(
          body=[
            If(
              test=Compare(
                left=Name(id='ttl_s', ctx=Load()),
                ops=[
                  Is()],
                comparators=[
                  Constant(value=None)]),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='client', ctx=Load()),
                      attr='set',
                      ctx=Load()),
                    args=[
                      Name(id='key', ctx=Load()),
                      Name(id='payload', ctx=Load())]))],
              orelse=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='client', ctx=Load()),
                      attr='setex',
                      ctx=Load()),
                    args=[
                      Name(id='key', ctx=Load()),
                      Name(id='ttl_s', ctx=Load()),
                      Name(id='payload', ctx=Load())]))])],
          handlers=[
            ExceptHandler(
              type=Name(id='Exception', ctx=Load()),
              name='exc',
              body=[
                Raise(
                  exc=Call(
                    func=Name(id='RedisClientError', ctx=Load()),
                    args=[
                      JoinedStr(
                        values=[
                          Constant(value='Redis SET failed for key='),
                          FormattedValue(
                            value=Name(id='key', ctx=Load()),
                            conversion=114),
                          Constant(value=': '),
                          FormattedValue(
                            value=Name(id='exc', ctx=Load()),
                            conversion=-1)])]),
                  cause=Name(id='exc', ctx=Load()))])])],
      returns=Constant(value=None))])