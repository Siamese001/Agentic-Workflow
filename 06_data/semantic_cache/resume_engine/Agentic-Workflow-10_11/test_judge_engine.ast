Module(
  body=[
    ImportFrom(
      module='orchestration.control_plane',
      names=[
        alias(name='SafetyContext'),
        alias(name='PolicyRule'),
        alias(name='RulesEngineResult'),
        alias(name='RuleMatch'),
        alias(name='evaluate_with_guard_model')],
      level=0),
    FunctionDef(
      name='test_judge_engine_unsafe_on_high_severity',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='ctx', ctx=Store())],
          value=Call(
            func=Name(id='SafetyContext', ctx=Load()),
            keywords=[
              keyword(
                arg='input_text',
                value=Constant(value='harmful text'))])),
        Assign(
          targets=[
            Name(id='rules_result', ctx=Store())],
          value=Call(
            func=Name(id='RulesEngineResult', ctx=Load()),
            keywords=[
              keyword(
                arg='matches',
                value=List(
                  elts=[
                    Call(
                      func=Name(id='RuleMatch', ctx=Load()),
                      keywords=[
                        keyword(
                          arg='rule_id',
                          value=Constant(value='r1')),
                        keyword(
                          arg='category',
                          value=Constant(value='violence')),
                        keyword(
                          arg='severity',
                          value=Constant(value='high'))])],
                  ctx=Load())),
              keyword(
                arg='max_severity',
                value=Constant(value='high')),
              keyword(
                arg='has_pii',
                value=Constant(value=False))])),
        Assign(
          targets=[
            Name(id='verdict', ctx=Store())],
          value=Call(
            func=Name(id='evaluate_with_guard_model', ctx=Load()),
            args=[
              Name(id='ctx', ctx=Load()),
              Name(id='rules_result', ctx=Load())])),
        Assert(
          test=Compare(
            left=Attribute(
              value=Name(id='verdict', ctx=Load()),
              attr='verdict',
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value='unsafe')]))])])