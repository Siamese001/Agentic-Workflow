Module(
  body=[
    Expr(
      value=Constant(value='L4 RAG Hybrid Search Tests.')),
    ClassDef(
      name='TestL4RAGHybrid',
      body=[
        Expr(
          value=Constant(value='Tests for L4 RAG hybrid search.')),
        FunctionDef(
          name='test_hybrid_search_combination',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test hybrid search combining dense and sparse.')),
            Assign(
              targets=[
                Name(id='dense_results', ctx=Store())],
              value=List(
                elts=[
                  Dict(
                    keys=[
                      Constant(value='id'),
                      Constant(value='score')],
                    values=[
                      Constant(value='d1'),
                      Constant(value=0.9)])],
                ctx=Load())),
            Assign(
              targets=[
                Name(id='sparse_results', ctx=Store())],
              value=List(
                elts=[
                  Dict(
                    keys=[
                      Constant(value='id'),
                      Constant(value='score')],
                    values=[
                      Constant(value='s1'),
                      Constant(value=0.8)])],
                ctx=Load())),
            Assign(
              targets=[
                Name(id='combined', ctx=Store())],
              value=BinOp(
                left=Name(id='dense_results', ctx=Load()),
                op=Add(),
                right=Name(id='sparse_results', ctx=Load()))),
            Assert(
              test=Compare(
                left=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Name(id='combined', ctx=Load())]),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value=2)]))]),
        FunctionDef(
          name='test_hybrid_reranking',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test hybrid reranking.')),
            Assign(
              targets=[
                Name(id='results', ctx=Store())],
              value=List(
                elts=[
                  Dict(
                    keys=[
                      Constant(value='id'),
                      Constant(value='score')],
                    values=[
                      Constant(value='r1'),
                      Constant(value=0.7)]),
                  Dict(
                    keys=[
                      Constant(value='id'),
                      Constant(value='score')],
                    values=[
                      Constant(value='r2'),
                      Constant(value=0.9)])],
                ctx=Load())),
            Assign(
              targets=[
                Name(id='reranked', ctx=Store())],
              value=Call(
                func=Name(id='sorted', ctx=Load()),
                args=[
                  Name(id='results', ctx=Load())],
                keywords=[
                  keyword(
                    arg='key',
                    value=Lambda(
                      args=arguments(
                        args=[
                          arg(arg='x')]),
                      body=Subscript(
                        value=Name(id='x', ctx=Load()),
                        slice=Constant(value='score'),
                        ctx=Load()))),
                  keyword(
                    arg='reverse',
                    value=Constant(value=True))])),
            Assert(
              test=Compare(
                left=Subscript(
                  value=Subscript(
                    value=Name(id='reranked', ctx=Load()),
                    slice=Constant(value=0),
                    ctx=Load()),
                  slice=Constant(value='id'),
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value='r2')]))])])])