Module(
  body=[
    Expr(
      value=Constant(value='L4 RAG (Retrieval Augmented Generation) Tests.')),
    ClassDef(
      name='TestL4RAG',
      body=[
        Expr(
          value=Constant(value='Tests for L4 RAG functionality.')),
        FunctionDef(
          name='test_retrieval_query',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test retrieval query construction.')),
            Assign(
              targets=[
                Name(id='query', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='text'),
                  Constant(value='top_k')],
                values=[
                  Constant(value='python developer'),
                  Constant(value=10)])),
            Assert(
              test=Compare(
                left=Subscript(
                  value=Name(id='query', ctx=Load()),
                  slice=Constant(value='top_k'),
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value=10)]))]),
        FunctionDef(
          name='test_context_augmentation',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test context augmentation logic.')),
            Assign(
              targets=[
                Name(id='docs', ctx=Store())],
              value=List(
                elts=[
                  Constant(value='doc1 content'),
                  Constant(value='doc2 content')],
                ctx=Load())),
            Assign(
              targets=[
                Name(id='augmented', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Constant(value=' '),
                  attr='join',
                  ctx=Load()),
                args=[
                  Name(id='docs', ctx=Load())])),
            Assert(
              test=Compare(
                left=Constant(value='doc1'),
                ops=[
                  In()],
                comparators=[
                  Name(id='augmented', ctx=Load())]))]),
        FunctionDef(
          name='test_relevance_scoring',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test relevance scoring.')),
            Assign(
              targets=[
                Name(id='scores', ctx=Store())],
              value=List(
                elts=[
                  Constant(value=0.9),
                  Constant(value=0.8),
                  Constant(value=0.7)],
                ctx=Load())),
            Assign(
              targets=[
                Name(id='top_score', ctx=Store())],
              value=Call(
                func=Name(id='max', ctx=Load()),
                args=[
                  Name(id='scores', ctx=Load())])),
            Assert(
              test=Compare(
                left=Name(id='top_score', ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value=0.9)]))])])])