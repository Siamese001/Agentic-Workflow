Module(
  body=[
    Expr(
      value=Constant(value='Shared Fake LLM for Deterministic Testing.')),
    ClassDef(
      name='FakeLLM',
      body=[
        Expr(
          value=Constant(value='Deterministic fake LLM for testing.')),
        FunctionDef(
          name='__init__',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(arg='responses')],
            defaults=[
              Constant(value=None)]),
          body=[
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='responses',
                  ctx=Store())],
              value=BoolOp(
                op=Or(),
                values=[
                  Name(id='responses', ctx=Load()),
                  List(
                    elts=[
                      Constant(value='Default fake response')],
                    ctx=Load())])),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='call_count',
                  ctx=Store())],
              value=Constant(value=0))]),
        FunctionDef(
          name='generate',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(arg='prompt')]),
          body=[
            Expr(
              value=Constant(value='Generate deterministic response.')),
            Assign(
              targets=[
                Name(id='response', ctx=Store())],
              value=Subscript(
                value=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='responses',
                  ctx=Load()),
                slice=BinOp(
                  left=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='call_count',
                    ctx=Load()),
                  op=Mod(),
                  right=Call(
                    func=Name(id='len', ctx=Load()),
                    args=[
                      Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='responses',
                        ctx=Load())])),
                ctx=Load())),
            AugAssign(
              target=Attribute(
                value=Name(id='self', ctx=Load()),
                attr='call_count',
                ctx=Store()),
              op=Add(),
              value=Constant(value=1)),
            Return(
              value=Name(id='response', ctx=Load()))]),
        FunctionDef(
          name='reset',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Reset call count.')),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='call_count',
                  ctx=Store())],
              value=Constant(value=0))])]),
    FunctionDef(
      name='test_fake_llm_deterministic',
      args=arguments(),
      body=[
        Expr(
          value=Constant(value='Test FakeLLM produces deterministic responses.')),
        Assign(
          targets=[
            Name(id='llm', ctx=Store())],
          value=Call(
            func=Name(id='FakeLLM', ctx=Load()),
            keywords=[
              keyword(
                arg='responses',
                value=List(
                  elts=[
                    Constant(value='Response A'),
                    Constant(value='Response B')],
                  ctx=Load()))])),
        Assert(
          test=Compare(
            left=Call(
              func=Attribute(
                value=Name(id='llm', ctx=Load()),
                attr='generate',
                ctx=Load()),
              args=[
                Constant(value='prompt1')]),
            ops=[
              Eq()],
            comparators=[
              Constant(value='Response A')])),
        Assert(
          test=Compare(
            left=Call(
              func=Attribute(
                value=Name(id='llm', ctx=Load()),
                attr='generate',
                ctx=Load()),
              args=[
                Constant(value='prompt2')]),
            ops=[
              Eq()],
            comparators=[
              Constant(value='Response B')])),
        Assert(
          test=Compare(
            left=Call(
              func=Attribute(
                value=Name(id='llm', ctx=Load()),
                attr='generate',
                ctx=Load()),
              args=[
                Constant(value='prompt3')]),
            ops=[
              Eq()],
            comparators=[
              Constant(value='Response A')])),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='llm', ctx=Load()),
              attr='reset',
              ctx=Load()))),
        Assert(
          test=Compare(
            left=Attribute(
              value=Name(id='llm', ctx=Load()),
              attr='call_count',
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value=0)]))])])