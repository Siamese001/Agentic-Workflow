Module(
  body=[
    Expr(
      value=Constant(value='Tests for Runtime Core Integration\n\nTests LLM invocation, sandbox execution, and\nworkflow orchestration integration.\n')),
    Import(
      names=[
        alias(name='pytest')]),
    ImportFrom(
      module='unittest.mock',
      names=[
        alias(name='Mock'),
        alias(name='patch'),
        alias(name='MagicMock')],
      level=0),
    ImportFrom(
      module='datetime',
      names=[
        alias(name='datetime')],
      level=0),
    ImportFrom(
      module='core.models.models',
      names=[
        alias(name='ExecutionContext'),
        alias(name='JobInput'),
        alias(name='ResumeInput')],
      level=0),
    ImportFrom(
      module='runtime.runtime_utils',
      names=[
        alias(name='invoke_model'),
        alias(name='SandboxConfig')],
      level=0),
    ClassDef(
      name='TestLLMInvocation',
      body=[
        Expr(
          value=Constant(value='Test LLM invocation with mock responses.')),
        FunctionDef(
          name='test_mock_invoke_model_strategy_response',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test mock LLM response for strategy generation.')),
            Assign(
              targets=[
                Name(id='prompt', ctx=Store())],
              value=Constant(value='Generate strategy for software engineer role')),
            Assign(
              targets=[
                Name(id='result', ctx=Store())],
              value=Call(
                func=Name(id='invoke_model', ctx=Load()),
                args=[
                  Name(id='prompt', ctx=Load())],
                keywords=[
                  keyword(
                    arg='model',
                    value=Constant(value='test-model'))])),
            Assert(
              test=Compare(
                left=Constant(value='strategy'),
                ops=[
                  In()],
                comparators=[
                  Call(
                    func=Attribute(
                      value=Name(id='result', ctx=Load()),
                      attr='lower',
                      ctx=Load()))])),
            Assert(
              test=Compare(
                left=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Name(id='result', ctx=Load())]),
                ops=[
                  Gt()],
                comparators=[
                  Constant(value=0)]))]),
        FunctionDef(
          name='test_mock_invoke_model_drafting_response',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test mock LLM response for drafting.')),
            Assign(
              targets=[
                Name(id='prompt', ctx=Store())],
              value=Constant(value='Draft resume for software engineer')),
            Assign(
              targets=[
                Name(id='result', ctx=Store())],
              value=Call(
                func=Name(id='invoke_model', ctx=Load()),
                args=[
                  Name(id='prompt', ctx=Load())],
                keywords=[
                  keyword(
                    arg='model',
                    value=Constant(value='test-model'))])),
            Assert(
              test=Compare(
                left=Constant(value='draft'),
                ops=[
                  In()],
                comparators=[
                  Call(
                    func=Attribute(
                      value=Name(id='result', ctx=Load()),
                      attr='lower',
                      ctx=Load()))])),
            Assert(
              test=Compare(
                left=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Name(id='result', ctx=Load())]),
                ops=[
                  Gt()],
                comparators=[
                  Constant(value=0)]))])]),
    ClassDef(
      name='TestSandboxExecution',
      body=[
        Expr(
          value=Constant(value='Test sandbox execution and configuration.')),
        FunctionDef(
          name='test_sandbox_config_creation',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test sandbox configuration.')),
            Assign(
              targets=[
                Name(id='config', ctx=Store())],
              value=Call(
                func=Name(id='SandboxConfig', ctx=Load()),
                keywords=[
                  keyword(
                    arg='timeout',
                    value=Constant(value=30)),
                  keyword(
                    arg='memory_limit',
                    value=Constant(value='512MB')),
                  keyword(
                    arg='allow_network',
                    value=Constant(value=False))])),
            Assert(
              test=Compare(
                left=Attribute(
                  value=Name(id='config', ctx=Load()),
                  attr='timeout',
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value=30)])),
            Assert(
              test=Compare(
                left=Attribute(
                  value=Name(id='config', ctx=Load()),
                  attr='memory_limit',
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value='512MB')])),
            Assert(
              test=Compare(
                left=Attribute(
                  value=Name(id='config', ctx=Load()),
                  attr='allow_network',
                  ctx=Load()),
                ops=[
                  Is()],
                comparators=[
                  Constant(value=False)]))]),
        FunctionDef(
          name='test_sandbox_execution_mock',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test sandbox execution with mock.')),
            ImportFrom(
              module='runtime.runtime_utils',
              names=[
                alias(name='get_sandbox')],
              level=0),
            Assign(
              targets=[
                Name(id='config', ctx=Store())],
              value=Call(
                func=Name(id='SandboxConfig', ctx=Load()),
                keywords=[
                  keyword(
                    arg='timeout',
                    value=Constant(value=10))])),
            Assign(
              targets=[
                Name(id='sandbox', ctx=Store())],
              value=Call(
                func=Name(id='get_sandbox', ctx=Load()),
                args=[
                  Name(id='config', ctx=Load())])),
            Assign(
              targets=[
                Name(id='result', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='sandbox', ctx=Load()),
                  attr='execute',
                  ctx=Load()),
                args=[
                  Constant(value="print('test')")])),
            Assert(
              test=Call(
                func=Name(id='hasattr', ctx=Load()),
                args=[
                  Name(id='sandbox', ctx=Load()),
                  Constant(value='execute')]))])]),
    ClassDef(
      name='TestWorkflowOrchestration',
      body=[
        Expr(
          value=Constant(value='Test workflow orchestration integration.')),
        FunctionDef(
          name='setup_method',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Set up test fixtures.')),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='ctx',
                  ctx=Store())],
              value=Call(
                func=Name(id='ExecutionContext', ctx=Load()),
                keywords=[
                  keyword(
                    arg='job',
                    value=Call(
                      func=Name(id='JobInput', ctx=Load()),
                      keywords=[
                        keyword(
                          arg='title',
                          value=Constant(value='Software Engineer')),
                        keyword(
                          arg='role_type',
                          value=Constant(value='engineering')),
                        keyword(
                          arg='seniority',
                          value=Constant(value='mid')),
                        keyword(
                          arg='posting_text',
                          value=Constant(value='Looking for a software engineer'))])),
                  keyword(
                    arg='resume',
                    value=Call(
                      func=Name(id='ResumeInput', ctx=Load()),
                      keywords=[
                        keyword(
                          arg='name',
                          value=Constant(value='John Doe')),
                        keyword(
                          arg='email',
                          value=Constant(value='john@example.com')),
                        keyword(arg='sections', value=Dict())])),
                  keyword(
                    arg='user_id',
                    value=Constant(value='test_user'))]))]),
        FunctionDef(
          name='test_l2_execute_with_mock_llm',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(arg='mock_execute')]),
          body=[
            Expr(
              value=Constant(value='Test L2 execution with mock LLM responses.')),
            ImportFrom(
              module='l2',
              names=[
                alias(name='execute_workflow_plans'),
                alias(name='L2ResultBundle')],
              level=0),
            Assign(
              targets=[
                Name(id='mock_strategy', ctx=Store())],
              value=Call(
                func=Name(id='Mock', ctx=Load()))),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='mock_strategy', ctx=Load()),
                  attr='branches',
                  ctx=Store())],
              value=List(
                elts=[
                  Call(
                    func=Name(id='Mock', ctx=Load()),
                    keywords=[
                      keyword(
                        arg='description',
                        value=Constant(value='Test strategy'))])],
                ctx=Load())),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='mock_execute', ctx=Load()),
                  attr='return_value',
                  ctx=Store())],
              value=Call(
                func=Name(id='L2ResultBundle', ctx=Load()),
                keywords=[
                  keyword(
                    arg='strategy',
                    value=Name(id='mock_strategy', ctx=Load())),
                  keyword(
                    arg='rag',
                    value=Call(
                      func=Name(id='Mock', ctx=Load()))),
                  keyword(
                    arg='drafting',
                    value=Call(
                      func=Name(id='Mock', ctx=Load()))),
                  keyword(
                    arg='qa',
                    value=Call(
                      func=Name(id='Mock', ctx=Load()))),
                  keyword(
                    arg='safety',
                    value=Call(
                      func=Name(id='Mock', ctx=Load())))])),
            Assign(
              targets=[
                Name(id='plans', ctx=Store())],
              value=List(
                elts=[
                  Call(
                    func=Name(id='Mock', ctx=Load()))],
                ctx=Load())),
            Assign(
              targets=[
                Name(id='result', ctx=Store())],
              value=Call(
                func=Name(id='execute_workflow_plans', ctx=Load()),
                args=[
                  Name(id='plans', ctx=Load()),
                  Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='ctx',
                    ctx=Load())])),
            Assert(
              test=Call(
                func=Name(id='isinstance', ctx=Load()),
                args=[
                  Name(id='result', ctx=Load()),
                  Name(id='L2ResultBundle', ctx=Load())])),
            Assert(
              test=Compare(
                left=Attribute(
                  value=Name(id='result', ctx=Load()),
                  attr='strategy',
                  ctx=Load()),
                ops=[
                  IsNot()],
                comparators=[
                  Constant(value=None)]))],
          decorator_list=[
            Call(
              func=Name(id='patch', ctx=Load()),
              args=[
                Constant(value='l2.execute_workflow_plans')])]),
        FunctionDef(
          name='test_l3_dag_orchestration',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(arg='mock_orchestrate')]),
          body=[
            Expr(
              value=Constant(value='Test L3 DAG orchestration.')),
            ImportFrom(
              module='orchestration.run_dag',
              names=[
                alias(name='run_dag')],
              level=0),
            ImportFrom(
              module='l2',
              names=[
                alias(name='L2ResultBundle')],
              level=0),
            Assign(
              targets=[
                Name(id='mock_strategy', ctx=Store())],
              value=Call(
                func=Name(id='Mock', ctx=Load()))),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='mock_strategy', ctx=Load()),
                  attr='branches',
                  ctx=Store())],
              value=List(
                elts=[
                  Call(
                    func=Name(id='Mock', ctx=Load()),
                    keywords=[
                      keyword(
                        arg='description',
                        value=Constant(value='Test strategy branch text'))])],
                ctx=Load())),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='mock_orchestrate', ctx=Load()),
                  attr='return_value',
                  ctx=Store())],
              value=Call(
                func=Name(id='L2ResultBundle', ctx=Load()),
                keywords=[
                  keyword(
                    arg='strategy',
                    value=Name(id='mock_strategy', ctx=Load())),
                  keyword(
                    arg='rag',
                    value=Call(
                      func=Name(id='Mock', ctx=Load()))),
                  keyword(
                    arg='drafting',
                    value=Call(
                      func=Name(id='Mock', ctx=Load()))),
                  keyword(
                    arg='qa',
                    value=Call(
                      func=Name(id='Mock', ctx=Load()))),
                  keyword(
                    arg='safety',
                    value=Call(
                      func=Name(id='Mock', ctx=Load())))])),
            Assign(
              targets=[
                Name(id='plans', ctx=Store())],
              value=List(
                elts=[
                  Call(
                    func=Name(id='Mock', ctx=Load()))],
                ctx=Load())),
            Assign(
              targets=[
                Name(id='dag', ctx=Store())],
              value=Call(
                func=Name(id='run_dag', ctx=Load()),
                args=[
                  Name(id='plans', ctx=Load()),
                  Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='ctx',
                    ctx=Load())])),
            Assert(
              test=Compare(
                left=Subscript(
                  value=Attribute(
                    value=Name(id='dag', ctx=Load()),
                    attr='final_state_patch',
                    ctx=Load()),
                  slice=Constant(value='strategy_text'),
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value='Test strategy branch text')])),
            Assert(
              test=Compare(
                left=Constant(value='strategy'),
                ops=[
                  In()],
                comparators=[
                  Attribute(
                    value=Name(id='dag', ctx=Load()),
                    attr='final_state_patch',
                    ctx=Load())])),
            Assert(
              test=Compare(
                left=Constant(value='rag'),
                ops=[
                  In()],
                comparators=[
                  Attribute(
                    value=Name(id='dag', ctx=Load()),
                    attr='final_state_patch',
                    ctx=Load())]))],
          decorator_list=[
            Call(
              func=Name(id='patch', ctx=Load()),
              args=[
                Constant(value='l3.orchestrate_execution')])])]),
    ClassDef(
      name='TestIntegrationWithAdapters',
      body=[
        Expr(
          value=Constant(value='Test integration with various adapters.')),
        FunctionDef(
          name='test_pinecone_adapter_integration',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test Pinecone adapter integration.')),
            Assign(
              targets=[
                Name(id='mock_adapter', ctx=Store())],
              value=Call(
                func=Name(id='Mock', ctx=Load()))),
            Assign(
              targets=[
                Attribute(
                  value=Attribute(
                    value=Name(id='mock_adapter', ctx=Load()),
                    attr='query_by_text',
                    ctx=Load()),
                  attr='return_value',
                  ctx=Store())],
              value=List(
                elts=[
                  Call(
                    func=Name(id='Mock', ctx=Load()),
                    keywords=[
                      keyword(
                        arg='id',
                        value=Constant(value='doc1')),
                      keyword(
                        arg='score',
                        value=Constant(value=0.9)),
                      keyword(
                        arg='metadata',
                        value=Dict(
                          keys=[
                            Constant(value='text')],
                          values=[
                            Constant(value='test')]))])],
                ctx=Load())),
            Assign(
              targets=[
                Name(id='ctx', ctx=Store())],
              value=Call(
                func=Name(id='ExecutionContext', ctx=Load()),
                keywords=[
                  keyword(
                    arg='job',
                    value=Call(
                      func=Name(id='JobInput', ctx=Load()),
                      keywords=[
                        keyword(
                          arg='title',
                          value=Constant(value='Test')),
                        keyword(
                          arg='role_type',
                          value=Constant(value='test')),
                        keyword(
                          arg='seniority',
                          value=Constant(value='test')),
                        keyword(
                          arg='posting_text',
                          value=Constant(value='test'))])),
                  keyword(
                    arg='resume',
                    value=Call(
                      func=Name(id='ResumeInput', ctx=Load()),
                      keywords=[
                        keyword(
                          arg='name',
                          value=Constant(value='Test')),
                        keyword(
                          arg='email',
                          value=Constant(value='test@example.com')),
                        keyword(arg='sections', value=Dict())])),
                  keyword(
                    arg='user_id',
                    value=Constant(value='test_user')),
                  keyword(
                    arg='pinecone_adapter',
                    value=Name(id='mock_adapter', ctx=Load()))])),
            Assert(
              test=Compare(
                left=Attribute(
                  value=Name(id='ctx', ctx=Load()),
                  attr='pinecone_adapter',
                  ctx=Load()),
                ops=[
                  Is()],
                comparators=[
                  Name(id='mock_adapter', ctx=Load())]))]),
        FunctionDef(
          name='test_execution_context_validation',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test ExecutionContext validation.')),
            With(
              items=[
                withitem(
                  context_expr=Call(
                    func=Attribute(
                      value=Name(id='pytest', ctx=Load()),
                      attr='raises',
                      ctx=Load()),
                    args=[
                      Name(id='Exception', ctx=Load())]))],
              body=[
                Expr(
                  value=Call(
                    func=Name(id='ExecutionContext', ctx=Load())))])])]),
    Assign(
      targets=[
        Name(id='MOCK_LLM_RESPONSES', ctx=Store())],
      value=Dict(
        keys=[
          Constant(value='strategy_generate_branch'),
          Constant(value='drafting_generate_content'),
          Constant(value='qa_evaluate_quality'),
          Constant(value='safety_check_policy')],
        values=[
          Constant(value='Mock strategy branch text for testing.'),
          Constant(value='Mock drafted content for testing.'),
          Constant(value='Mock quality assessment for testing.'),
          Constant(value='Mock safety evaluation for testing.')])),
    FunctionDef(
      name='mock_invoke_model',
      args=arguments(
        args=[
          arg(
            arg='prompt',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='model',
            annotation=Name(id='str', ctx=Load()))],
        defaults=[
          Constant(value='test-model')]),
      body=[
        Expr(
          value=Constant(value='Mock invoke_model function for testing.')),
        For(
          target=Tuple(
            elts=[
              Name(id='keyword', ctx=Store()),
              Name(id='response', ctx=Store())],
            ctx=Store()),
          iter=Call(
            func=Attribute(
              value=Name(id='MOCK_LLM_RESPONSES', ctx=Load()),
              attr='items',
              ctx=Load())),
          body=[
            If(
              test=Compare(
                left=Name(id='keyword', ctx=Load()),
                ops=[
                  In()],
                comparators=[
                  Call(
                    func=Attribute(
                      value=Name(id='prompt', ctx=Load()),
                      attr='lower',
                      ctx=Load()))]),
              body=[
                Return(
                  value=Name(id='response', ctx=Load()))])]),
        Return(
          value=JoinedStr(
            values=[
              Constant(value='Mock response for: '),
              FormattedValue(
                value=Subscript(
                  value=Name(id='prompt', ctx=Load()),
                  slice=Slice(
                    upper=Constant(value=50)),
                  ctx=Load()),
                conversion=-1),
              Constant(value='...')]))],
      returns=Name(id='str', ctx=Load())),
    FunctionDef(
      name='patch_invoke_model',
      args=arguments(),
      body=[
        Expr(
          value=Constant(value='Patch invoke_model for all tests in this module.')),
        With(
          items=[
            withitem(
              context_expr=Call(
                func=Name(id='patch', ctx=Load()),
                args=[
                  Constant(value='runtime.runtime_utils.invoke_model')],
                keywords=[
                  keyword(
                    arg='side_effect',
                    value=Name(id='mock_invoke_model', ctx=Load()))]))],
          body=[
            Expr(value=Yield())])],
      decorator_list=[
        Call(
          func=Attribute(
            value=Name(id='pytest', ctx=Load()),
            attr='fixture',
            ctx=Load()),
          keywords=[
            keyword(
              arg='autouse',
              value=Constant(value=True))])]),
    If(
      test=Compare(
        left=Name(id='__name__', ctx=Load()),
        ops=[
          Eq()],
        comparators=[
          Constant(value='__main__')]),
      body=[
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='pytest', ctx=Load()),
              attr='main',
              ctx=Load()),
            args=[
              List(
                elts=[
                  Name(id='__file__', ctx=Load())],
                ctx=Load())]))])])