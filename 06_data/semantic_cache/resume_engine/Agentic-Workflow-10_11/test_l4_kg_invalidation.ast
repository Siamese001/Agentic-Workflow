Module(
  body=[
    Expr(
      value=Constant(value='L4 Temporal KG Invalidation Tests.')),
    ClassDef(
      name='TestL4KGInvalidation',
      body=[
        Expr(
          value=Constant(value='Tests for L4 KG invalidation.')),
        FunctionDef(
          name='test_age_based_invalidation',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test age-based invalidation.')),
            Assign(
              targets=[
                Name(id='entry', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='created'),
                  Constant(value='max_age')],
                values=[
                  Constant(value=1000),
                  Constant(value=500)])),
            Assign(
              targets=[
                Name(id='current_time', ctx=Store())],
              value=Constant(value=1600)),
            Assign(
              targets=[
                Name(id='is_expired', ctx=Store())],
              value=Compare(
                left=BinOp(
                  left=Name(id='current_time', ctx=Load()),
                  op=Sub(),
                  right=Subscript(
                    value=Name(id='entry', ctx=Load()),
                    slice=Constant(value='created'),
                    ctx=Load())),
                ops=[
                  Gt()],
                comparators=[
                  Subscript(
                    value=Name(id='entry', ctx=Load()),
                    slice=Constant(value='max_age'),
                    ctx=Load())])),
            Assert(
              test=Compare(
                left=Name(id='is_expired', ctx=Load()),
                ops=[
                  Is()],
                comparators=[
                  Constant(value=True)]))]),
        FunctionDef(
          name='test_explicit_invalidation',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test explicit invalidation.')),
            Assign(
              targets=[
                Name(id='entry', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='id'),
                  Constant(value='valid')],
                values=[
                  Constant(value='e1'),
                  Constant(value=True)])),
            Assign(
              targets=[
                Subscript(
                  value=Name(id='entry', ctx=Load()),
                  slice=Constant(value='valid'),
                  ctx=Store())],
              value=Constant(value=False)),
            Assert(
              test=Compare(
                left=Subscript(
                  value=Name(id='entry', ctx=Load()),
                  slice=Constant(value='valid'),
                  ctx=Load()),
                ops=[
                  Is()],
                comparators=[
                  Constant(value=False)]))]),
        FunctionDef(
          name='test_cascade_invalidation',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test cascade invalidation.')),
            Assign(
              targets=[
                Name(id='entries', ctx=Store())],
              value=List(
                elts=[
                  Dict(
                    keys=[
                      Constant(value='id'),
                      Constant(value='valid')],
                    values=[
                      Constant(value='e1'),
                      Constant(value=True)]),
                  Dict(
                    keys=[
                      Constant(value='id'),
                      Constant(value='valid'),
                      Constant(value='depends_on')],
                    values=[
                      Constant(value='e2'),
                      Constant(value=True),
                      Constant(value='e1')])],
                ctx=Load())),
            Assign(
              targets=[
                Subscript(
                  value=Subscript(
                    value=Name(id='entries', ctx=Load()),
                    slice=Constant(value=0),
                    ctx=Load()),
                  slice=Constant(value='valid'),
                  ctx=Store())],
              value=Constant(value=False)),
            For(
              target=Name(id='e', ctx=Store()),
              iter=Name(id='entries', ctx=Load()),
              body=[
                If(
                  test=Compare(
                    left=Call(
                      func=Attribute(
                        value=Name(id='e', ctx=Load()),
                        attr='get',
                        ctx=Load()),
                      args=[
                        Constant(value='depends_on')]),
                    ops=[
                      Eq()],
                    comparators=[
                      Constant(value='e1')]),
                  body=[
                    Assign(
                      targets=[
                        Subscript(
                          value=Name(id='e', ctx=Load()),
                          slice=Constant(value='valid'),
                          ctx=Store())],
                      value=Constant(value=False))])]),
            Assert(
              test=Compare(
                left=Subscript(
                  value=Subscript(
                    value=Name(id='entries', ctx=Load()),
                    slice=Constant(value=1),
                    ctx=Load()),
                  slice=Constant(value='valid'),
                  ctx=Load()),
                ops=[
                  Is()],
                comparators=[
                  Constant(value=False)]))])])])