      value=Set(
        elts=[
          Constant(value='core'),
          Constant(value='meta'),
          Constant(value='prompts'),
          Constant(value='profiles')])),
    FunctionDef(
      name='_iter_project_py_files',
      args=arguments(),
      body=[
        For(
          target=Name(id='path', ctx=Store()),
          iter=Call(
            func=Attribute(
              value=Name(id='PROJECT_ROOT', ctx=Load()),
              attr='glob',
              ctx=Load()),
            args=[
              Constant(value='*.py')]),
          body=[
            If(
              test=Compare(
                left=Attribute(
                  value=Name(id='path', ctx=Load()),
