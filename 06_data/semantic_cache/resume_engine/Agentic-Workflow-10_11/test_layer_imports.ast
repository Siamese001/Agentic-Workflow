                  ctx=Load()),
                ops=[
                  In()],
                comparators=[
                  Set(
                    elts=[
                      Constant(value='l1.py'),
                      Constant(value='l2.py'),
                      Constant(value='cognitive_agents.py'),
                      Constant(value='import_check.py')])]),
              body=[
                Continue()]),
            Expr(
              value=Yield(
                value=Name(id='path', ctx=Load())))]),
        For(
          target=Name(id='path', ctx=Store()),
          iter=Call(
            func=Attribute(
              value=Name(id='PROJECT_ROOT', ctx=Load()),
              attr='iterdir',
              ctx=Load())),
          body=[
            If(
              test=BoolOp(
                op=And(),
                values=[
                  Call(
                    func=Attribute(
                      value=Name(id='path', ctx=Load()),
                      attr='is_dir',
                      ctx=Load())),
                  Compare(
                    left=Attribute(
                      value=Name(id='path', ctx=Load()),
                      attr='name',
                      ctx=Load()),
                    ops=[
                      NotIn()],
                    comparators=[
                      Set(
                        elts=[
                          Constant(value='tests'),
                          Constant(value='.mypy_cache'),
                          Constant(value='.pytest_cache'),
                          Constant(value='.ruff_cache'),
                          Constant(value='.git')])])]),
              body=[
                For(
                  target=Name(id='sub', ctx=Store()),
                  iter=Call(
                    func=Attribute(
                      value=Name(id='path', ctx=Load()),
                      attr='rglob',
                      ctx=Load()),
                    args=[
                      Constant(value='*.py')]),
                  body=[
                    Expr(
                      value=Yield(
                        value=Name(id='sub', ctx=Load())))])])])]),
    FunctionDef(
      name='_get_imported_modules',
      args=arguments(
        args=[
          arg(
            arg='path',
            annotation=Attribute(
              value=Name(id='pathlib', ctx=Load()),
              attr='Path',
              ctx=Load()))]),
      body=[
        Assign(
          targets=[
            Name(id='tree', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='ast', ctx=Load()),
              attr='parse',
              ctx=Load()),
            args=[
              Call(
                func=Attribute(
                  value=Name(id='path', ctx=Load()),
                  attr='read_text',
                  ctx=Load()),
                keywords=[
                  keyword(
                    arg='encoding',
                    value=Constant(value='utf-8'))])],
            keywords=[
              keyword(
                arg='filename',
                value=Call(
                  func=Name(id='str', ctx=Load()),
                  args=[
                    Name(id='path', ctx=Load())]))])),
        AnnAssign(
          target=Name(id='modules', ctx=Store()),
          annotation=Subscript(
            value=Name(id='set', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load()),
          value=Call(
            func=Name(id='set', ctx=Load())),
          simple=1),
        For(
          target=Name(id='node', ctx=Store()),
          iter=Call(
            func=Attribute(
              value=Name(id='ast', ctx=Load()),
              attr='walk',
              ctx=Load()),
            args=[
              Name(id='tree', ctx=Load())]),
          body=[
            If(
              test=Call(
                func=Name(id='isinstance', ctx=Load()),
                args=[
                  Name(id='node', ctx=Load()),
                  Attribute(
                    value=Name(id='ast', ctx=Load()),
                    attr='Import',
                    ctx=Load())]),
              body=[
                For(
                  target=Name(id='alias', ctx=Store()),
                  iter=Attribute(
                    value=Name(id='node', ctx=Load()),
                    attr='names',
                    ctx=Load()),
                  body=[
                    If(
                      test=Attribute(
