                                      ctx=Load()),
                                    attr='split',
                                    ctx=Load()),
                                  args=[
                                    Constant(value='.')]),
                                slice=Constant(value=0),
                                ctx=Load())]))])])])]),
        Return(
          value=Name(id='modules', ctx=Load()))],
      returns=Subscript(
