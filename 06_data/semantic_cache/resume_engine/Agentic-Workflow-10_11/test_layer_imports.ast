                                value=Call(
                                  func=Attribute(
                                    value=Attribute(
                                      value=Name(id='alias', ctx=Load()),
                                      attr='name',
                                      ctx=Load()),
                                    attr='split',
                                    ctx=Load()),
                                  args=[
                                    Constant(value='.')]),
                                slice=Constant(value=0),
                                ctx=Load())]))])])],
              orelse=[
                If(
                  test=Call(
                    func=Name(id='isinstance', ctx=Load()),
                    args=[
                      Name(id='node', ctx=Load()),
                      Attribute(
                        value=Name(id='ast', ctx=Load()),
                        attr='ImportFrom',
                        ctx=Load())]),
                  body=[
