Module(
  body=[
    Expr(
      value=Constant(value='Observability Tracing Tests.')),
    ClassDef(
      name='TestObservabilityTracing',
      body=[
        Expr(
          value=Constant(value='Tests for observability tracing.')),
        FunctionDef(
          name='test_span_creation',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test trace span creation.')),
            Assign(
              targets=[
                Name(id='span', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='id'),
                  Constant(value='name'),
                  Constant(value='start_time'),
                  Constant(value='end_time'),
                  Constant(value='duration_ms')],
                values=[
                  Constant(value='span_001'),
                  Constant(value='test_operation'),
                  Constant(value=1000),
                  Constant(value=1100),
                  Constant(value=100)])),
            Assert(
              test=Compare(
                left=Subscript(
                  value=Name(id='span', ctx=Load()),
                  slice=Constant(value='duration_ms'),
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value=100)])),
            Assert(
              test=Compare(
                left=Subscript(
                  value=Name(id='span', ctx=Load()),
                  slice=Constant(value='end_time'),
                  ctx=Load()),
                ops=[
                  Gt()],
                comparators=[
                  Subscript(
                    value=Name(id='span', ctx=Load()),
                    slice=Constant(value='start_time'),
                    ctx=Load())]))])])])