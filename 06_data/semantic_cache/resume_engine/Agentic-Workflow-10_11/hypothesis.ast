Module(
  body=[
    ImportFrom(
      module='__future__',
      names=[
        alias(name='annotations')],
      level=0),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Any'),
        alias(name='List')],
      level=0),
    ImportFrom(
      module='meta.metacognition.models',
      names=[
        alias(name='Hypothesis')],
      level=0),
    FunctionDef(
      name='generate_initial_hypotheses',
      args=arguments(
        args=[
          arg(
            arg='task',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='rag_result',
            annotation=Name(id='Any', ctx=Load())),
          arg(
            arg='agent_card',
            annotation=Name(id='Any', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='Generate a small set of coarse hypotheses from task + RAG.\n\n    This implementation is deterministic and uses only cheap heuristics:\n    - if there is any evidence, we create 1–3 simple hypotheses whose\n      confidence is proportional to the number of evidence items.\n    - if no evidence is present, we still produce a single low-confidence\n      hypothesis so downstream code has something to inspect.\n    ')),
        Assign(
          targets=[
            Name(id='evidence', ctx=Store())],
          value=BoolOp(
            op=Or(),
            values=[
              Call(
                func=Name(id='getattr', ctx=Load()),
                args=[
                  Name(id='rag_result', ctx=Load()),
                  Constant(value='evidence'),
                  List(ctx=Load())]),
              List(ctx=Load())])),
        Assign(
          targets=[
            Name(id='evidence_ids', ctx=Store())],
          value=ListComp(
            elt=Call(
              func=Name(id='str', ctx=Load()),
              args=[
                Name(id='i', ctx=Load())]),
            generators=[
              comprehension(
                target=Name(id='i', ctx=Store()),
                iter=Call(
                  func=Name(id='range', ctx=Load()),
                  args=[
                    Call(
                      func=Name(id='len', ctx=Load()),
                      args=[
                        Name(id='evidence', ctx=Load())])]),
                is_async=0)])),
        Assign(
          targets=[
            Name(id='count', ctx=Store())],
          value=Call(
            func=Name(id='len', ctx=Load()),
            args=[
              Name(id='evidence', ctx=Load())])),
        Assign(
          targets=[
            Name(id='base_conf', ctx=Store())],
          value=IfExp(
            test=Compare(
              left=Name(id='count', ctx=Load()),
              ops=[
                Eq()],
              comparators=[
                Constant(value=0)]),
            body=Constant(value=0.2),
            orelse=Call(
              func=Name(id='min', ctx=Load()),
              args=[
                Constant(value=1.0),
                BinOp(
                  left=Constant(value=0.3),
                  op=Add(),
                  right=BinOp(
                    left=Constant(value=0.1),
                    op=Mult(),
                    right=Name(id='count', ctx=Load())))]))),
        AnnAssign(
          target=Name(id='hypotheses', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='Hypothesis', ctx=Load()),
            ctx=Load()),
          value=List(ctx=Load()),
          simple=1),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='hypotheses', ctx=Load()),
              attr='append',
              ctx=Load()),
            args=[
              Call(
                func=Name(id='Hypothesis', ctx=Load()),
                keywords=[
                  keyword(
                    arg='id',
                    value=Constant(value='h1')),
                  keyword(
                    arg='agent_id',
                    value=Call(
                      func=Name(id='getattr', ctx=Load()),
                      args=[
                        Name(id='agent_card', ctx=Load()),
                        Constant(value='agent_id'),
                        Constant(value='unknown')])),
                  keyword(
                    arg='content',
                    value=JoinedStr(
                      values=[
                        Constant(value="Task '"),
                        FormattedValue(
                          value=Name(id='task', ctx=Load()),
                          conversion=-1),
                        Constant(value="' appears achievable given current evidence.")])),
                  keyword(
                    arg='confidence',
                    value=Name(id='base_conf', ctx=Load())),
                  keyword(
                    arg='evidence_ids',
                    value=Name(id='evidence_ids', ctx=Load())),
                  keyword(
                    arg='rationale',
                    value=Constant(value=None))])])),
        If(
          test=Compare(
            left=Name(id='count', ctx=Load()),
            ops=[
              Gt()],
            comparators=[
              Constant(value=0)]),
          body=[
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='hypotheses', ctx=Load()),
                  attr='append',
                  ctx=Load()),
                args=[
                  Call(
                    func=Name(id='Hypothesis', ctx=Load()),
                    keywords=[
                      keyword(
                        arg='id',
                        value=Constant(value='h2')),
                      keyword(
                        arg='agent_id',
                        value=Call(
                          func=Name(id='getattr', ctx=Load()),
                          args=[
                            Name(id='agent_card', ctx=Load()),
                            Constant(value='agent_id'),
                            Constant(value='unknown')])),
                      keyword(
                        arg='content',
                        value=Constant(value='Additional evidence may improve specificity of the draft.')),
                      keyword(
                        arg='confidence',
                        value=Call(
                          func=Name(id='max', ctx=Load()),
                          args=[
                            Constant(value=0.1),
                            BinOp(
                              left=Name(id='base_conf', ctx=Load()),
                              op=Sub(),
                              right=Constant(value=0.1))])),
                      keyword(
                        arg='evidence_ids',
                        value=Subscript(
                          value=Name(id='evidence_ids', ctx=Load()),
                          slice=Slice(
                            upper=Call(
                              func=Name(id='max', ctx=Load()),
                              args=[
                                Constant(value=1),
                                BinOp(
                                  left=Call(
                                    func=Name(id='len', ctx=Load()),
                                    args=[
                                      Name(id='evidence_ids', ctx=Load())]),
                                  op=FloorDiv(),
                                  right=Constant(value=2))])),
                          ctx=Load())),
                      keyword(
                        arg='rationale',
                        value=Constant(value='Derived from partial evidence coverage.'))])]))]),
        Return(
          value=Name(id='hypotheses', ctx=Load()))],
      returns=Subscript(
        value=Name(id='List', ctx=Load()),
        slice=Name(id='Hypothesis', ctx=Load()),
        ctx=Load()))])