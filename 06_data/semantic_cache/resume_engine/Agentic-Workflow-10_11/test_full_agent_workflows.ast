Module(
  body=[
    Expr(
      value=Constant(value='E2E Full Agent Workflow Tests.')),
    ClassDef(
      name='TestFullAgentWorkflows',
      body=[
        Expr(
          value=Constant(value='E2E tests for full agent workflows.')),
        FunctionDef(
          name='test_resume_improvement_workflow',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test complete resume improvement workflow.')),
            Assign(
              targets=[
                Name(id='workflow_steps', ctx=Store())],
              value=List(
                elts=[
                  Constant(value='analyze'),
                  Constant(value='plan'),
                  Constant(value='draft'),
                  Constant(value='review')],
                ctx=Load())),
            Assert(
              test=Compare(
                left=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Name(id='workflow_steps', ctx=Load())]),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value=4)]))]),
        FunctionDef(
          name='test_job_matching_workflow',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test complete job matching workflow.')),
            Assign(
              targets=[
                Name(id='stages', ctx=Store())],
              value=List(
                elts=[
                  Constant(value='extract'),
                  Constant(value='match'),
                  Constant(value='rank')],
                ctx=Load())),
            Assert(
              test=Compare(
                left=Constant(value='match'),
                ops=[
                  In()],
                comparators=[
                  Name(id='stages', ctx=Load())]))])])])