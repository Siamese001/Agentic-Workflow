      body=[
        Expr(
          value=Constant(value='\n    Unified LLM invocation for v10_10.\n\n    Parameters:\n        model:       model ID selected by RoutingPolicy (e.g. "gpt-5.1-codex").\n        prompt:      final rendered prompt text.\n        sandbox:     SandboxConfig (request_timeout_s, max_tokens_per_call).\n        temperature: sampling temperature.\n        max_tokens:  requested max tokens (will be clamped to sandbox).\n    ')),
        If(
          test=UnaryOp(
            op=Not(),
            operand=Attribute(
              value=Name(id='sandbox', ctx=Load()),
              attr='allow_network',
              ctx=Load())),
          body=[
            Raise(
              exc=Call(
                func=Name(id='ToolExecutionError', ctx=Load()),
                args=[
                  Constant(value='Network access disabled by SandboxConfig')]))]),
        If(
          test=Compare(
            left=Name(id='max_tokens', ctx=Load()),
            ops=[
              Gt()],
            comparators=[
              Attribute(
                value=Name(id='sandbox', ctx=Load()),
                attr='max_tokens_per_call',
                ctx=Load())]),
          body=[
            Assign(
              targets=[
                Name(id='max_tokens', ctx=Store())],
              value=Attribute(
                value=Name(id='sandbox', ctx=Load()),
                attr='max_tokens_per_call',
                ctx=Load()))]),
        Assign(
          targets=[
            Name(id='routing_ctx', ctx=Store())],
          value=Call(
            func=Name(id='RoutingContext', ctx=Load()),
            keywords=[
              keyword(
                arg='agent_id',
                value=Constant(value='runtime_utils')),
              keyword(
                arg='task_type',
                value=Constant(value='llm_call')),
              keyword(
                arg='execution_profile',
                value=Constant(value=None))])),
        Assign(
          targets=[
            Name(id='choice', ctx=Store())],
          value=Call(
            func=Name(id='select_model', ctx=Load()),
            args=[
              Name(id='routing_ctx', ctx=Load())],
            keywords=[
              keyword(
                arg='requested_model',
                value=Name(id='model', ctx=Load())),
              keyword(
                arg='execution_profile',
                value=Constant(value=None))])),
        Assign(
          targets=[
            Name(id='provider', ctx=Store())],
          value=Attribute(
            value=Name(id='choice', ctx=Load()),
            attr='provider',
            ctx=Load())),
        Assign(
          targets=[
            Name(id='routed_model', ctx=Store())],
          value=Attribute(
            value=Name(id='choice', ctx=Load()),
            attr='model_name',
            ctx=Load())),
        Assign(
          targets=[
            Name(id='cache_client', ctx=Store())],
          value=Call(
            func=Name(id='_get_redis_client_for_llm_cache', ctx=Load()))),
        Assign(
          targets=[
            Name(id='cache_key', ctx=Store())],
          value=Constant(value=None)),
        If(
          test=Compare(
            left=Name(id='cache_client', ctx=Load()),
            ops=[
              IsNot()],
            comparators=[
              Constant(value=None)]),
          body=[
            Try(
              body=[
                Assign(
                  targets=[
                    Name(id='payload', ctx=Store())],
                  value=Dict(
                    keys=[
                      Constant(value='model'),
                      Constant(value='prompt'),
                      Constant(value='temperature'),
                      Constant(value='max_tokens')],
                    values=[
                      Name(id='routed_model', ctx=Load()),
                      Name(id='prompt', ctx=Load()),
                      Name(id='temperature', ctx=Load()),
                      Name(id='max_tokens', ctx=Load())])),
                Assign(
                  targets=[
                    Name(id='cache_key', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Call(
                        func=Attribute(
                          value=Name(id='hashlib', ctx=Load()),
                          attr='sha256',
                          ctx=Load()),
                        args=[
                          Call(
                            func=Attribute(
                              value=Call(
                                func=Attribute(
                                  value=Name(id='json', ctx=Load()),
                                  attr='dumps',
                                  ctx=Load()),
                                args=[
                                  Name(id='payload', ctx=Load())],
                                keywords=[
                                  keyword(
                                    arg='sort_keys',
                                    value=Constant(value=True)),
                                  keyword(
                                    arg='default',
                                    value=Name(id='str', ctx=Load()))]),
                              attr='encode',
                              ctx=Load()),
                            args=[
                              Constant(value='utf-8')])]),
                      attr='hexdigest',
                      ctx=Load()))),
                If(
                  test=Compare(
                    left=Name(id='get_llm_cache', ctx=Load()),
                    ops=[
                      IsNot()],
                    comparators=[
                      Constant(value=None)]),
                  body=[
                    Assign(
                      targets=[
                        Name(id='cached', ctx=Store())],
                      value=Call(
                        func=Name(id='get_llm_cache', ctx=Load()),
                        args=[
                          Name(id='cache_client', ctx=Load()),
                          Name(id='cache_key', ctx=Load())]))],
                  orelse=[
                    Assign(
                      targets=[
                        Name(id='cached', ctx=Store())],
                      value=Constant(value=None))]),
                If(
                  test=BoolOp(
                    op=And(),
                    values=[
                      Call(
                        func=Name(id='isinstance', ctx=Load()),
                        args=[
                          Name(id='cached', ctx=Load()),
                          Name(id='dict', ctx=Load())]),
                      Compare(
                        left=Constant(value='text'),
                        ops=[
                          In()],
                        comparators=[
                          Name(id='cached', ctx=Load())])]),
                  body=[
                    Expr(
                      value=Call(
                        func=Name(id='record_event', ctx=Load()),
                        args=[
                          Constant(value='invoke_model_cache_hit'),
                          Dict(
                            keys=[
                              Constant(value='model'),
                              Constant(value='provider'),
                              Constant(value='cache_key')],
                            values=[
                              Name(id='routed_model', ctx=Load()),
                              Name(id='provider', ctx=Load()),
                              Name(id='cache_key', ctx=Load())])])),
                    Return(
                      value=Call(
                        func=Name(id='str', ctx=Load()),
                        args=[
                          Subscript(
                            value=Name(id='cached', ctx=Load()),
                            slice=Constant(value='text'),
                            ctx=Load())]))])],
              handlers=[
                ExceptHandler(
                  type=Name(id='Exception', ctx=Load()),
                  name='exc',
                  body=[
                    Expr(
                      value=Call(
                        func=Name(id='record_exception', ctx=Load()),
                        args=[
                          Constant(value='invoke_model_cache_error'),
                          Name(id='exc', ctx=Load())]))])])]),
        Expr(
          value=Call(
            func=Name(id='record_event', ctx=Load()),
            args=[
              Constant(value='invoke_model_start'),
              Dict(
                keys=[
                  Constant(value='model'),
                  Constant(value='provider'),
                  Constant(value='temperature'),
                  Constant(value='max_tokens')],
                values=[
                  Name(id='routed_model', ctx=Load()),
                  Name(id='provider', ctx=Load()),
                  Name(id='temperature', ctx=Load()),
                  Name(id='max_tokens', ctx=Load())])])),
        Try(
          body=[
            If(
              test=Compare(
                left=Name(id='provider', ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value='openai')]),
              body=[
                Assign(
                  targets=[
                    Name(id='text', ctx=Store())],
                  value=Call(
                    func=Name(id='run_llm_openai', ctx=Load()),
                    keywords=[
                      keyword(
                        arg='model',
                        value=Name(id='routed_model', ctx=Load())),
                      keyword(
                        arg='prompt',
                        value=Name(id='prompt', ctx=Load())),
                      keyword(
                        arg='temperature',
                        value=Name(id='temperature', ctx=Load())),
                      keyword(
                        arg='max_tokens',
                        value=Name(id='max_tokens', ctx=Load())),
                      keyword(
                        arg='timeout_s',
                        value=Attribute(
                          value=Name(id='sandbox', ctx=Load()),
                          attr='request_timeout_s',
                          ctx=Load()))]))],
              orelse=[
                If(
                  test=Compare(
                    left=Name(id='provider', ctx=Load()),
                    ops=[
                      Eq()],
                    comparators=[
                      Constant(value='anthropic')]),
                  body=[
                    Assign(
                      targets=[
                        Name(id='text', ctx=Store())],
                      value=Call(
                        func=Name(id='run_llm_anthropic', ctx=Load()),
                        keywords=[
                          keyword(
                            arg='model',
                            value=Name(id='routed_model', ctx=Load())),
                          keyword(
                            arg='prompt',
                            value=Name(id='prompt', ctx=Load())),
                          keyword(
                            arg='temperature',
                            value=Name(id='temperature', ctx=Load())),
                          keyword(
                            arg='max_tokens',
                            value=Name(id='max_tokens', ctx=Load())),
                          keyword(
                            arg='timeout_s',
                            value=Attribute(
                              value=Name(id='sandbox', ctx=Load()),
                              attr='request_timeout_s',
                              ctx=Load()))]))],
                  orelse=[
                    If(
                      test=Compare(
                        left=Name(id='provider', ctx=Load()),
                        ops=[
                          Eq()],
                        comparators=[
                          Constant(value='google')]),
                      body=[
                        Assign(
                          targets=[
                            Name(id='text', ctx=Store())],
                          value=Call(
                            func=Name(id='run_llm_google', ctx=Load()),
                            keywords=[
                              keyword(
                                arg='model',
                                value=Name(id='routed_model', ctx=Load())),
                              keyword(
                                arg='prompt',
                                value=Name(id='prompt', ctx=Load())),
                              keyword(
                                arg='temperature',
                                value=Name(id='temperature', ctx=Load())),
                              keyword(
                                arg='max_tokens',
                                value=Name(id='max_tokens', ctx=Load())),
                              keyword(
                                arg='timeout_s',
                                value=Attribute(
                                  value=Name(id='sandbox', ctx=Load()),
                                  attr='request_timeout_s',
                                  ctx=Load()))]))],
                      orelse=[
                        Raise(
                          exc=Call(
                            func=Name(id='LLMInvocationError', ctx=Load()),
                            args=[
                              JoinedStr(
                                values=[
                                  Constant(value='Unsupported provider inferred for model: '),
                                  FormattedValue(
                                    value=Name(id='routed_model', ctx=Load()),
                                    conversion=-1)])]))])])]),
            If(
              test=BoolOp(
                op=And(),
                values=[
                  Compare(
                    left=Name(id='cache_client', ctx=Load()),
                    ops=[
                      IsNot()],
                    comparators=[
                      Constant(value=None)]),
                  Compare(
                    left=Name(id='cache_key', ctx=Load()),
                    ops=[
                      IsNot()],
                    comparators=[
                      Constant(value=None)]),
                  Compare(
                    left=Name(id='set_llm_cache', ctx=Load()),
                    ops=[
                      IsNot()],
                    comparators=[
                      Constant(value=None)])]),
              body=[
                Try(
                  body=[
                    Expr(
                      value=Call(
                        func=Name(id='set_llm_cache', ctx=Load()),
                        args=[
                          Name(id='cache_client', ctx=Load()),
                          Name(id='cache_key', ctx=Load()),
                          Dict(
                            keys=[
                              Constant(value='text')],
                            values=[
                              Name(id='text', ctx=Load())])])),
                    Expr(
                      value=Call(
                        func=Name(id='record_event', ctx=Load()),
                        args=[
                          Constant(value='invoke_model_cache_store'),
                          Dict(
                            keys=[
                              Constant(value='model'),
                              Constant(value='provider'),
                              Constant(value='cache_key')],
                            values=[
                              Name(id='routed_model', ctx=Load()),
                              Name(id='provider', ctx=Load()),
                              Name(id='cache_key', ctx=Load())])]))],
                  handlers=[
                    ExceptHandler(
                      type=Name(id='Exception', ctx=Load()),
                      name='exc',
                      body=[
                        Expr(
                          value=Call(
                            func=Name(id='record_exception', ctx=Load()),
                            args=[
                              Constant(value='invoke_model_cache_store_error'),
                              Name(id='exc', ctx=Load())]))])])]),
            Expr(
              value=Call(
                func=Name(id='record_event', ctx=Load()),
                args=[
                  Constant(value='invoke_model_success'),
                  Dict(
                    keys=[
                      Constant(value='model'),
                      Constant(value='provider'),
                      Constant(value='response_len')],
                    values=[
                      Name(id='routed_model', ctx=Load()),
                      Name(id='provider', ctx=Load()),
                      Call(
                        func=Name(id='len', ctx=Load()),
                        args=[
                          Name(id='text', ctx=Load())])])])),
            Assign(
              targets=[
                Name(id='cost_evt', ctx=Store())],
              value=Call(
                func=Name(id='CostEvent', ctx=Load()),
                keywords=[
                  keyword(
                    arg='ts_ms',
                    value=Call(
                      func=Name(id='int', ctx=Load()),
                      args=[
                        BinOp(
                          left=Call(
                            func=Attribute(
                              value=Name(id='time', ctx=Load()),
                              attr='time',
                              ctx=Load())),
                          op=Mult(),
                          right=Constant(value=1000))])),
                  keyword(
                    arg='workflow_id',
                    value=Constant(value=None)),
                  keyword(
                    arg='agent_id',
                    value=Constant(value='runtime_utils')),
                  keyword(
                    arg='provider',
                    value=Name(id='provider', ctx=Load())),
                  keyword(
                    arg='model_name',
                    value=Name(id='routed_model', ctx=Load())),
                  keyword(
                    arg='estimated_cost',
                    value=Call(
                      func=Name(id='getattr', ctx=Load()),
                      args=[
                        Name(id='choice', ctx=Load()),
                        Constant(value='estimated_cost'),
                        Constant(value=0.0)])),
                  keyword(
                    arg='latency_ms',
                    value=Call(
                      func=Name(id='getattr', ctx=Load()),
                      args=[
                        Name(id='choice', ctx=Load()),
                        Constant(value='latency_ms'),
                        Constant(value=0)])),
                  keyword(arg='metadata', value=Dict())])),
            Expr(
              value=Call(
                func=Name(id='append_agentic_event', ctx=Load()),
                args=[
                  Name(id='cost_evt', ctx=Load())])),
            Return(
              value=Name(id='text', ctx=Load()))],
          handlers=[
            ExceptHandler(
              type=Name(id='Exception', ctx=Load()),
              name='exc',
              body=[
                Expr(
                  value=Call(
                    func=Name(id='record_exception', ctx=Load()),
                    args=[
                      Constant(value='invoke_model_failure'),
                      Name(id='exc', ctx=Load())])),
                Raise(
                  exc=Call(
                    func=Name(id='LLMInvocationError', ctx=Load()),
                    args=[
                      JoinedStr(
                        values=[
                          Constant(value='LLM invocation failed for model '),
                          FormattedValue(
                            value=Name(id='routed_model', ctx=Load()),
                            conversion=-1),
                          Constant(value=': '),
                          FormattedValue(
                            value=Name(id='exc', ctx=Load()),
                            conversion=-1)])]),
                  cause=Name(id='exc', ctx=Load()))])])],
      returns=Name(id='str', ctx=Load()))])