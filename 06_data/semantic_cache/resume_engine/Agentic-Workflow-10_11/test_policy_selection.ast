Module(
  body=[
    ImportFrom(
      module='orchestration.model_routing',
      names=[
        alias(name='RoutingContext'),
        alias(name='choose_provider_and_model')],
      level=0),
    FunctionDef(
      name='test_policy_selection_honors_requested_model',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='ctx', ctx=Store())],
          value=Call(
            func=Name(id='RoutingContext', ctx=Load()),
            keywords=[
              keyword(
                arg='agent_id',
                value=Constant(value='agent')),
              keyword(
                arg='task_type',
                value=Constant(value='llm_call')),
              keyword(
                arg='execution_profile',
                value=Constant(value=None))])),
        Assign(
          targets=[
            Name(id='choice', ctx=Store())],
          value=Call(
            func=Name(id='choose_provider_and_model', ctx=Load()),
            args=[
              Name(id='ctx', ctx=Load())],
            keywords=[
              keyword(
                arg='requested_model',
                value=Constant(value='claude-3-haiku'))])),
        Assert(
          test=Compare(
            left=Attribute(
              value=Name(id='choice', ctx=Load()),
              attr='model_name',
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value='claude-3-haiku')])),
        Assert(
          test=Compare(
            left=Attribute(
              value=Name(id='choice', ctx=Load()),
              attr='provider',
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value='anthropic')]))]),
    FunctionDef(
      name='test_policy_selection_defaults_when_no_model',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='ctx', ctx=Store())],
          value=Call(
            func=Name(id='RoutingContext', ctx=Load()),
            keywords=[
              keyword(
                arg='agent_id',
                value=Constant(value='agent')),
              keyword(
                arg='task_type',
                value=Constant(value='llm_call')),
              keyword(
                arg='execution_profile',
                value=Constant(value=None))])),
        Assign(
          targets=[
            Name(id='choice', ctx=Store())],
          value=Call(
            func=Name(id='choose_provider_and_model', ctx=Load()),
            args=[
              Name(id='ctx', ctx=Load())],
            keywords=[
              keyword(
                arg='requested_model',
                value=Constant(value=None))])),
        Assert(
          test=Attribute(
            value=Name(id='choice', ctx=Load()),
            attr='model_name',
            ctx=Load())),
        Assert(
          test=Compare(
            left=Attribute(
              value=Name(id='choice', ctx=Load()),
              attr='provider',
              ctx=Load()),
            ops=[
              In()],
            comparators=[
              Set(
                elts=[
                  Constant(value='openai'),
                  Constant(value='anthropic'),
                  Constant(value='google')])]))])])