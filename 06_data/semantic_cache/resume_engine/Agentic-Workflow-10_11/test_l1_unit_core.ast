Module(
  body=[
    Expr(
      value=Constant(value='L1 Planning Unit Tests - Core.')),
    Import(
      names=[
        alias(name='pytest')]),
    ClassDef(
      name='TestL1PlanningUnitCore',
      body=[
        Expr(
          value=Constant(value='Core unit tests for L1 planning layer.')),
        FunctionDef(
          name='test_workflow_plan_creation',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test workflow plan creation.')),
            Assign(
              targets=[
                Name(id='plan', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='steps')],
                values=[
                  List(
                    elts=[
                      Constant(value='analyze'),
                      Constant(value='plan'),
                      Constant(value='execute')],
                    ctx=Load())])),
            Assert(
              test=Compare(
                left=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Subscript(
                      value=Name(id='plan', ctx=Load()),
                      slice=Constant(value='steps'),
                      ctx=Load())]),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value=3)]))]),
        FunctionDef(
          name='test_strategy_plan_initialization',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test strategy plan initialization.')),
            Assign(
              targets=[
                Name(id='strategy', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='mode'),
                  Constant(value='depth')],
                values=[
                  Constant(value='cot'),
                  Constant(value=2)])),
            Assert(
              test=Compare(
                left=Subscript(
                  value=Name(id='strategy', ctx=Load()),
                  slice=Constant(value='mode'),
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value='cot')]))]),
        FunctionDef(
          name='test_complexity_classification',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test complexity classification logic.')),
            Assign(
              targets=[
                Name(id='levels', ctx=Store())],
              value=List(
                elts=[
                  Constant(value='low'),
                  Constant(value='medium'),
                  Constant(value='high')],
                ctx=Load())),
            Assert(
              test=Compare(
                left=Constant(value='medium'),
                ops=[
                  In()],
                comparators=[
                  Name(id='levels', ctx=Load())]))]),
        FunctionDef(
          name='test_seniority_inference',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test seniority inference from job title.')),
            Assign(
              targets=[
                Name(id='titles', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='senior'),
                  Constant(value='director'),
                  Constant(value='vp')],
                values=[
                  Constant(value='senior_ic'),
                  Constant(value='director'),
                  Constant(value='executive')])),
            Assert(
              test=Compare(
                left=Subscript(
                  value=Name(id='titles', ctx=Load()),
                  slice=Constant(value='senior'),
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value='senior_ic')]))]),
        FunctionDef(
          name='test_domain_inference',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test domain inference from job description.')),
            Assign(
              targets=[
                Name(id='domains', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='ml'),
                  Constant(value='cloud')],
                values=[
                  Constant(value='machine_learning'),
                  Constant(value='cloud_infrastructure')])),
            Assert(
              test=Compare(
                left=Constant(value='ml'),
                ops=[
                  In()],
                comparators=[
                  Name(id='domains', ctx=Load())]))])])])