Module(
  body=[
    Expr(
      value=Constant(value='Stress Tests for Recursion Depth.')),
    ClassDef(
      name='TestRecursionDepth',
      body=[
        Expr(
          value=Constant(value='Stress tests for recursion depth limits.')),
        FunctionDef(
          name='test_deep_recursion_handling',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test handling of deep recursion.')),
            FunctionDef(
              name='recursive_func',
              args=arguments(
                args=[
                  arg(arg='n'),
                  arg(arg='acc')],
                defaults=[
                  Constant(value=0)]),
              body=[
                If(
                  test=Compare(
                    left=Name(id='n', ctx=Load()),
                    ops=[
                      LtE()],
                    comparators=[
                      Constant(value=0)]),
                  body=[
                    Return(
                      value=Name(id='acc', ctx=Load()))]),
                Return(
                  value=Call(
