                    args=[
                      BinOp(
                        left=Name(id='n', ctx=Load()),
                        op=Sub(),
                        right=Constant(value=1)),
                      BinOp(
                        left=Name(id='acc', ctx=Load()),
                        op=Add(),
                        right=Constant(value=1))]))]),
            Assign(
              targets=[
                Name(id='result', ctx=Store())],
              value=Call(
                func=Name(id='recursive_func', ctx=Load()),
                args=[
                  Constant(value=100)])),
            Assert(
              test=Compare(
                left=Name(id='result', ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value=100)]))])])])