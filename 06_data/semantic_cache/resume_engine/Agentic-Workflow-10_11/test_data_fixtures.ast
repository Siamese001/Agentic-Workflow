    FunctionDef(
      name='generate_test_resume',
      args=arguments(
        args=[
          arg(
            arg='customizations',
            annotation=Subscript(
              value=Name(id='Optional', ctx=Load()),
              slice=Subscript(
                value=Name(id='Dict', ctx=Load()),
                slice=Tuple(
                  elts=[
                    Name(id='str', ctx=Load()),
                    Name(id='Any', ctx=Load())],
                  ctx=Load()),
                ctx=Load()),
              ctx=Load()))],
        defaults=[
          Constant(value=None)]),
      body=[
        Expr(
          value=Constant(value='Generate a test resume with optional customizations.')),
        Assign(
          targets=[
            Name(id='base_resume', ctx=Store())],
          value=Call(
            func=Name(id='ResumeTestData', ctx=Load()),
            keywords=[
              keyword(
                arg='candidate_name',
                value=Constant(value='Test Candidate')),
              keyword(
                arg='contact_info',
                value=Dict(
                  keys=[
                    Constant(value='email'),
                    Constant(value='phone')],
                  values=[
                    Constant(value='test@example.com'),
                    Constant(value='+1-555-0000')])),
              keyword(
                arg='experience',
                value=List(ctx=Load())),
              keyword(
                arg='education',
                value=List(ctx=Load())),
              keyword(
                arg='skills',
                value=List(ctx=Load())),
              keyword(
                arg='certifications',
                value=List(ctx=Load())),
              keyword(
                arg='projects',
                value=List(ctx=Load()))])),
        If(
          test=Name(id='customizations', ctx=Load()),
          body=[
            If(
              test=Compare(
                left=Constant(value='skills'),
                ops=[
                  In()],
                comparators=[
                  Name(id='customizations', ctx=Load())]),
              body=[
                Assign(
                  targets=[
                    Name(id='base_resume', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='base_resume', ctx=Load()),
                      attr='_replace',
                      ctx=Load()),
                    keywords=[
                      keyword(
                        arg='skills',
                        value=Subscript(
                          value=Name(id='customizations', ctx=Load()),
                          slice=Constant(value='skills'),
                          ctx=Load()))]))]),
            If(
              test=Compare(
                left=Constant(value='experience_years'),
                ops=[
                  In()],
                comparators=[
                  Name(id='customizations', ctx=Load())]),
              body=[
                Assign(
                  targets=[
                    Name(id='base_resume', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='base_resume', ctx=Load()),
                      attr='_replace',
                      ctx=Load()),
                    keywords=[
                      keyword(
                        arg='experience',
                        value=List(
                          elts=[
                            Dict(
                              keys=[
                                Constant(value='title'),
                                Constant(value='company'),
                                Constant(value='dates'),
                                Constant(value='bullet_points')],
                              values=[
                                Constant(value='Software Engineer'),
                                Constant(value='Test Company'),
                                Dict(
                                  keys=[
                                    Constant(value='start'),
                                    Constant(value='end')],
                                  values=[
                                    JoinedStr(
                                      values=[
                                        FormattedValue(
                                          value=BinOp(
                                            left=Constant(value=2024),
                                            op=Sub(),
                                            right=Subscript(
                                              value=Name(id='customizations', ctx=Load()),
                                              slice=Constant(value='experience_years'),
                                              ctx=Load())),
                                          conversion=-1),
                                        Constant(value='-01')]),
                                    Constant(value='2024-12')]),
                                List(
                                  elts=[
                                    Constant(value='Test experience')],
                                  ctx=Load())])],
                          ctx=Load()))]))])]),
        Return(
          value=Name(id='base_resume', ctx=Load()))],
      returns=Name(id='ResumeTestData', ctx=Load())),
    FunctionDef(
      name='generate_test_job',
      args=arguments(
        args=[
          arg(
            arg='difficulty',
            annotation=Name(id='str', ctx=Load()))],
        defaults=[
          Constant(value='medium')]),
      body=[
        Expr(
          value=Constant(value='Generate a test job description with specified difficulty.')),
        If(
          test=Compare(
            left=Name(id='difficulty', ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value='easy')]),
          body=[
            Assign(
              targets=[
                Name(id='requirements', ctx=Store())],
              value=List(
                elts=[
                  Constant(value='Basic programming skills')],
                ctx=Load())),
            Assign(
              targets=[
                Name(id='qualifications', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='min_experience_years'),
                  Constant(value='required_skills')],
                values=[
                  Constant(value=0),
                  List(
                    elts=[
                      Constant(value='Python')],
                    ctx=Load())]))],
          orelse=[
            If(
              test=Compare(
                left=Name(id='difficulty', ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value='hard')]),
              body=[
                Assign(
                  targets=[
                    Name(id='requirements', ctx=Store())],
                  value=List(
                    elts=[
                      Constant(value='10+ years experience'),
                      Constant(value='PhD preferred'),
                      Constant(value='Multiple certifications')],
                    ctx=Load())),
                Assign(
                  targets=[
                    Name(id='qualifications', ctx=Store())],
                  value=Dict(
                    keys=[
                      Constant(value='min_experience_years'),
                      Constant(value='required_skills')],
                    values=[
                      Constant(value=10),
                      List(
                        elts=[
                          Constant(value='Python'),
                          Constant(value='AWS'),
                          Constant(value='ML'),
                          Constant(value='Leadership')],
                        ctx=Load())]))],
              orelse=[
                Assign(
                  targets=[
                    Name(id='requirements', ctx=Store())],
                  value=List(
                    elts=[
                      Constant(value='3-5 years experience'),
                      Constant(value="Bachelor's degree")],
                    ctx=Load())),
                Assign(
                  targets=[
                    Name(id='qualifications', ctx=Store())],
                  value=Dict(
                    keys=[
                      Constant(value='min_experience_years'),
                      Constant(value='required_skills')],
                    values=[
                      Constant(value=3),
                      List(
                        elts=[
                          Constant(value='Python'),
                          Constant(value='SQL')],
                        ctx=Load())]))])]),
        Return(
          value=Call(
            func=Name(id='JobDescriptionTestData', ctx=Load()),
            keywords=[
              keyword(
                arg='job_id',
                value=JoinedStr(
                  values=[
                    Constant(value='test_job_'),
                    FormattedValue(
                      value=Name(id='difficulty', ctx=Load()),
                      conversion=-1)])),
              keyword(
                arg='title',
                value=JoinedStr(
                  values=[
                    Constant(value='Test Position ('),
                    FormattedValue(
                      value=Name(id='difficulty', ctx=Load()),
                      conversion=-1),
                    Constant(value=')')])),
              keyword(
                arg='company',
                value=Constant(value='Test Company')),
              keyword(
                arg='location',
                value=Constant(value='Remote')),
              keyword(
                arg='requirements',
                value=Name(id='requirements', ctx=Load())),
              keyword(
                arg='responsibilities',
                value=List(
                  elts=[
                    Constant(value='Test responsibilities')],
                  ctx=Load())),
              keyword(
                arg='qualifications',
                value=Name(id='qualifications', ctx=Load())),
              keyword(
                arg='description',
                value=Constant(value='Test job description'))]))],
      returns=Name(id='JobDescriptionTestData', ctx=Load()))])