Module(
  body=[
    Expr(
      value=Constant(value='Shared Test Factories.')),
    ClassDef(
      name='JobInputFactory',
      body=[
        Expr(
          value=Constant(value='Factory for creating JobInput test objects.')),
        FunctionDef(
          name='create',
          args=arguments(
            args=[
              arg(arg='title'),
              arg(arg='requirements')],
            defaults=[
              Constant(value='Software Engineer'),
              Constant(value=None)]),
          body=[
            Expr(
              value=Constant(value='Create a JobInput dict.')),
            Return(
              value=Dict(
                keys=[
                  Constant(value='title'),
                  Constant(value='requirements')],
                values=[
                  Name(id='title', ctx=Load()),
                  BoolOp(
                    op=Or(),
                    values=[
                      Name(id='requirements', ctx=Load()),
                      List(
                        elts=[
                          Constant(value='Python'),
                          Constant(value='AWS')],
                        ctx=Load())])]))],
          decorator_list=[
            Name(id='staticmethod', ctx=Load())])]),
    ClassDef(
      name='ResumeInputFactory',
      body=[
        Expr(
          value=Constant(value='Factory for creating ResumeInput test objects.')),
        FunctionDef(
          name='create',
          args=arguments(
            args=[
              arg(arg='summary'),
              arg(arg='skills')],
            defaults=[
              Constant(value='Experienced developer'),
              Constant(value=None)]),
          body=[
            Expr(
              value=Constant(value='Create a ResumeInput dict.')),
            Return(
              value=Dict(
                keys=[
                  Constant(value='summary'),
                  Constant(value='skills'),
                  Constant(value='experience_sections'),
                  Constant(value='projects')],
                values=[
                  Name(id='summary', ctx=Load()),
                  BoolOp(
                    op=Or(),
                    values=[
                      Name(id='skills', ctx=Load()),
                      List(
                        elts=[
                          Constant(value='Python'),
                          Constant(value='JavaScript')],
                        ctx=Load())]),
                  List(ctx=Load()),
                  List(ctx=Load())]))],
          decorator_list=[
            Name(id='staticmethod', ctx=Load())])]),
    FunctionDef(
      name='test_job_input_factory',
      args=arguments(),
      body=[
        Expr(
          value=Constant(value='Test JobInputFactory.')),
        Assign(
          targets=[
            Name(id='job', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='JobInputFactory', ctx=Load()),
              attr='create',
              ctx=Load()))),
        Assert(
          test=Compare(
            left=Subscript(
              value=Name(id='job', ctx=Load()),
              slice=Constant(value='title'),
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value='Software Engineer')]))]),
    FunctionDef(
      name='test_resume_input_factory',
      args=arguments(),
      body=[
        Expr(
          value=Constant(value='Test ResumeInputFactory.')),
        Assign(
          targets=[
            Name(id='resume', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='ResumeInputFactory', ctx=Load()),
              attr='create',
              ctx=Load()))),
        Assert(
          test=Compare(
            left=Subscript(
              value=Name(id='resume', ctx=Load()),
              slice=Constant(value='summary'),
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value='Experienced developer')]))])])