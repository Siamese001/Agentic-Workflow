Module(
  body=[
    Expr(
      value=Constant(value='Transforms low-level observability events into a simple format so health checks can spot patterns that might harm resume quality or reliability.')),
    ImportFrom(
      module='__future__',
      names=[
        alias(name='annotations')],
      level=0),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Any'),
        alias(name='Dict'),
        alias(name='List')],
      level=0),
    ImportFrom(
      module='observability',
      names=[
        alias(name='get_all_events')],
      level=0),
    FunctionDef(
      name='collect_error_events',
      args=arguments(),
      body=[
        Expr(
          value=Constant(value='Collects error-like events from the global stream so health detectors can flag recurring issues before they impact resume runs.')),
        AnnAssign(
          target=Name(id='events', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Subscript(
              value=Name(id='Dict', ctx=Load()),
              slice=Tuple(
                elts=[
                  Name(id='str', ctx=Load()),
                  Name(id='Any', ctx=Load())],
                ctx=Load()),
              ctx=Load()),
            ctx=Load()),
          value=List(ctx=Load()),
          simple=1),
        For(
          target=Name(id='evt', ctx=Store()),
          iter=Call(
            func=Name(id='get_all_events', ctx=Load())),
          body=[
            Assign(
              targets=[
                Name(id='attrs', ctx=Store())],
              value=BoolOp(
                op=Or(),
                values=[
                  Call(
                    func=Name(id='getattr', ctx=Load()),
                    args=[
                      Name(id='evt', ctx=Load()),
                      Constant(value='attributes'),
                      Dict()]),
                  Dict()])),
            If(
              test=Compare(
                left=Call(
                  func=Attribute(
                    value=Name(id='attrs', ctx=Load()),
                    attr='get',
                    ctx=Load()),
                  args=[
                    Constant(value='event_type')]),
                ops=[
                  NotEq()],
                comparators=[
                  Constant(value='error')]),
              body=[
                Continue()]),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='events', ctx=Load()),
                  attr='append',
                  ctx=Load()),
                args=[
                  Dict(
                    keys=[
                      Constant(value='event_type'),
                      Constant(value='error_code'),
                      Constant(value='message')],
                    values=[
                      Constant(value='error'),
                      Call(
                        func=Attribute(
                          value=Name(id='attrs', ctx=Load()),
                          attr='get',
                          ctx=Load()),
                        args=[
                          Constant(value='error_code')]),
                      Call(
                        func=Attribute(
                          value=Name(id='attrs', ctx=Load()),
                          attr='get',
                          ctx=Load()),
                        args=[
                          Constant(value='message')])])]))]),
        Return(
          value=Name(id='events', ctx=Load()))],
      returns=Subscript(
        value=Name(id='List', ctx=Load()),
        slice=Subscript(
          value=Name(id='Dict', ctx=Load()),
          slice=Tuple(
            elts=[
              Name(id='str', ctx=Load()),
              Name(id='Any', ctx=Load())],
            ctx=Load()),
          ctx=Load()),
        ctx=Load()))])