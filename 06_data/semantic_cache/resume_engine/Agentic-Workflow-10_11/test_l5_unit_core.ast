Module(
  body=[
    Expr(
      value=Constant(value='L5 Safety Policy Unit Tests - Core.')),
    ClassDef(
      name='TestL5SafetyPolicyUnitCore',
      body=[
        Expr(
          value=Constant(value='Core unit tests for L5 safety policy layer.')),
        FunctionDef(
          name='test_policy_rule_creation',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test policy rule creation.')),
            Assign(
              targets=[
                Name(id='rule', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='id'),
                  Constant(value='type'),
                  Constant(value='pattern')],
                values=[
                  Constant(value='r1'),
                  Constant(value='block'),
                  Constant(value='SSN')])),
            Assert(
              test=Compare(
                left=Subscript(
                  value=Name(id='rule', ctx=Load()),
                  slice=Constant(value='type'),
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value='block')]))]),
        FunctionDef(
          name='test_safety_check_initialization',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test safety check initialization.')),
            Assign(
              targets=[
                Name(id='check', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='name'),
                  Constant(value='enabled')],
                values=[
                  Constant(value='pii_check'),
                  Constant(value=True)])),
            Assert(
              test=Compare(
                left=Subscript(
                  value=Name(id='check', ctx=Load()),
                  slice=Constant(value='enabled'),
                  ctx=Load()),
                ops=[
                  Is()],
                comparators=[
                  Constant(value=True)]))]),
        FunctionDef(
          name='test_violation_detection',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test violation detection logic.')),
            Assign(
              targets=[
                Name(id='content', ctx=Store())],
              value=Constant(value='safe content')),
            Assign(
              targets=[
                Name(id='violations', ctx=Store())],
              value=List(ctx=Load())),
            If(
              test=Compare(
                left=Constant(value='SSN'),
                ops=[
                  In()],
                comparators=[
                  Name(id='content', ctx=Load())]),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='violations', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Constant(value='pii_detected')]))]),
            Assert(
              test=Compare(
                left=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Name(id='violations', ctx=Load())]),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value=0)]))])])])