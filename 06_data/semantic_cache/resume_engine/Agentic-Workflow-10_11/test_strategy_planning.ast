Module(
  body=[
    Expr(
      value=Constant(value='\nTest Strategy Planning\n\nTests comprehensive strategy planning functionality for résumé improvement,\nincluding strategy plan creation, drafting plan generation, and latent thinking planning.\n')),
    Import(
      names=[
        alias(name='pytest')]),
    ImportFrom(
      module='unittest.mock',
      names=[
        alias(name='Mock'),
        alias(name='patch')],
      level=0),
    Try(
      body=[
        ImportFrom(
          module='l1.strategy_planning',
          names=[
            alias(name='generate_latent_thinking_plan'),
            alias(name='StrategyPlan'),
            alias(name='DraftPlan'),
            alias(name='LatentThinkingPlan')],
          level=0)],
      handlers=[
        ExceptHandler(
          type=Name(id='ImportError', ctx=Load()),
          body=[
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='pytest', ctx=Load()),
                  attr='skip',
                  ctx=Load()),
                args=[
                  Constant(value='Strategy planning components not available')],
                keywords=[
                  keyword(
                    arg='allow_module_level',
                    value=Constant(value=True))]))])]),
    Assign(
      targets=[
        Name(id='pytestmark', ctx=Store())],
      value=List(
        elts=[
          Attribute(
            value=Attribute(
              value=Name(id='pytest', ctx=Load()),
              attr='mark',
              ctx=Load()),
            attr='l1',
            ctx=Load()),
          Attribute(
