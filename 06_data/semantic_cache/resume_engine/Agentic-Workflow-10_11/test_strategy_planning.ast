                args=[
                  Name(id='result', ctx=Load()),
                  Name(id='ctx', ctx=Load())])),
            Assert(
              test=Call(
                func=Name(id='isinstance', ctx=Load()),
                args=[
                  Name(id='plan', ctx=Load()),
                  Name(id='LatentThinkingPlan', ctx=Load())])),
            Assert(
              test=Compare(
                left=Attribute(
                  value=Name(id='plan', ctx=Load()),
                  attr='profile_name',
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value='default')])),
            Assert(
              test=Compare(
                left=Attribute(
                  value=Name(id='plan', ctx=Load()),
                  attr='reasoning_mode',
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value='cot')])),
            Assert(
              test=Compare(
                left=Attribute(
                  value=Name(id='plan', ctx=Load()),
                  attr='depth',
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value=1)])),
            Assert(
              test=Call(
                func=Name(id='isinstance', ctx=Load()),
                args=[
                  Attribute(
                    value=Name(id='plan', ctx=Load()),
                    attr='trace',
                    ctx=Load()),
                  Name(id='list', ctx=Load())]))]),
