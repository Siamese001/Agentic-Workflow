                func=Name(id='Mock', ctx=Load()))),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='ctx', ctx=Load()),
                  attr='profile_name',
                  ctx=Store())],
              value=Constant(value='default')),
            Assign(
