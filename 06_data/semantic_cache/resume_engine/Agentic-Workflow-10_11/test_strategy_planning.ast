              value=Name(id='pytest', ctx=Load()),
              attr='mark',
              ctx=Load()),
            attr='planning',
            ctx=Load()),
          Attribute(
            value=Attribute(
              value=Name(id='pytest', ctx=Load()),
              attr='mark',
              ctx=Load()),
            attr='strategy',
            ctx=Load())],
        ctx=Load())),
    ClassDef(
      name='TestStrategyPlanning',
      body=[
        Expr(
          value=Constant(value='Test strategy planning functionality.')),
        FunctionDef(
          name='test_generate_latent_thinking_plan_basic',
