              value=Constant(value=False))])]),
    ImportFrom(
      module='l4.temporal_schemas',
      names=[
        alias(name='TemporalEntity'),
        alias(name='TemporalTriplet'),
        alias(name='TemporalEvent')],
      level=0),
    AsyncFunctionDef(
      name='insert_entity',
      args=arguments(
        args=[
          arg(
            arg='entity',
            annotation=Name(id='TemporalEntity', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Inserts resume entity into Neo4j for timeline analysis.\n\n    Mirrors canonical entity data to support resume job alignment.\n    ')),
        If(
          test=UnaryOp(
            op=Not(),
            operand=Name(id='_NEO4J_AVAILABLE', ctx=Load())),
          body=[
            Return()]),
        Try(
          body=[
            If(
              test=Compare(
                left=Name(id='_neo4j_graph', ctx=Load()),
                ops=[
                  IsNot()],
                comparators=[
                  Constant(value=None)]),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='_neo4j_graph', ctx=Load()),
                      attr='upsert_entity',
                      ctx=Load()),
                    keywords=[
                      keyword(
                        arg='entity_id',
                        value=Attribute(
                          value=Name(id='entity', ctx=Load()),
                          attr='entity_id',
                          ctx=Load())),
                      keyword(
                        arg='etype',
                        value=Attribute(
                          value=Name(id='entity', ctx=Load()),
                          attr='entity_type',
                          ctx=Load())),
                      keyword(
                        arg='name',
                        value=Attribute(
                          value=Name(id='entity', ctx=Load()),
                          attr='entity_id',
                          ctx=Load())),
                      keyword(
                        arg='metadata',
                        value=Dict(
                          keys=[
                            Constant(value='canonical_id'),
                            Constant(value='aliases'),
                            Constant(value='confidence'),
                            Constant(value='created_at'),
                            None],
                          values=[
                            Attribute(
                              value=Name(id='entity', ctx=Load()),
                              attr='canonical_id',
                              ctx=Load()),
                            Call(
                              func=Name(id='list', ctx=Load()),
                              args=[
                                Attribute(
                                  value=Name(id='entity', ctx=Load()),
                                  attr='aliases',
                                  ctx=Load())]),
                            Attribute(
                              value=Name(id='entity', ctx=Load()),
                              attr='confidence',
                              ctx=Load()),
                            Call(
                              func=Attribute(
                                value=Attribute(
                                  value=Name(id='entity', ctx=Load()),
                                  attr='created_at',
                                  ctx=Load()),
                                attr='isoformat',
                                ctx=Load())),
                            Attribute(
                              value=Name(id='entity', ctx=Load()),
                              attr='metadata',
                              ctx=Load())]))]))])],
          handlers=[
            ExceptHandler(
              type=Name(id='Exception', ctx=Load()),
              body=[
                Pass()])])],
      returns=Constant(value=None)),
    AsyncFunctionDef(
      name='insert_triplet',
      args=arguments(
        args=[
          arg(
            arg='triplet',
            annotation=Name(id='TemporalTriplet', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Inserts resume triplet as relation in Neo4j for timeline analysis.\n\n    Creates RELATION edge to support resume job alignment.\n    ')),
        If(
          test=UnaryOp(
            op=Not(),
            operand=Name(id='_NEO4J_AVAILABLE', ctx=Load())),
          body=[
            Return()]),
        Try(
          body=[
            If(
              test=Compare(
                left=Name(id='_neo4j_graph', ctx=Load()),
                ops=[
                  IsNot()],
                comparators=[
                  Constant(value=None)]),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='_neo4j_graph', ctx=Load()),
                      attr='upsert_relation',
                      ctx=Load()),
                    keywords=[
                      keyword(
                        arg='rel_id',
                        value=Attribute(
                          value=Name(id='triplet', ctx=Load()),
                          attr='triplet_id',
                          ctx=Load())),
                      keyword(
                        arg='subject_id',
                        value=Attribute(
                          value=Name(id='triplet', ctx=Load()),
