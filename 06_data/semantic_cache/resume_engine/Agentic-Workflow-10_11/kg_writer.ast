Module(
  body=[
    Expr(
      value=Constant(value='\nL2 KG Writer for resume temporal graph data.\n\nWrites entities, relations, and events to Neo4jGraphStore\nto support resume timeline analysis and job alignment.\n')),
    ImportFrom(
