      returns=Constant(value=None)),
    AsyncFunctionDef(
      name='insert_event',
      args=arguments(
        args=[
          arg(
            arg='event',
            annotation=Name(id='TemporalEvent', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Inserts resume temporal event in Neo4j for timeline analysis.\n\n    Updates relation invalidation to support resume job alignment.\n    ')),
        If(
          test=UnaryOp(
            op=Not(),
            operand=Name(id='_NEO4J_AVAILABLE', ctx=Load())),
          body=[
            Return()]),
        Try(
          body=[
            If(
              test=Compare(
                left=Name(id='_neo4j_graph', ctx=Load()),
                ops=[
                  IsNot()],
                comparators=[
                  Constant(value=None)]),
              body=[
                If(
                  test=BoolOp(
                    op=And(),
                    values=[
                      Attribute(
                        value=Name(id='event', ctx=Load()),
                        attr='triplet_id',
                        ctx=Load()),
                      Compare(
                        left=Attribute(
                          value=Name(id='event', ctx=Load()),
                          attr='event_type',
                          ctx=Load()),
                        ops=[
                          In()],
                        comparators=[
                          List(
                            elts=[
                              Constant(value='invalidation'),
                              Constant(value='expiration')],
                            ctx=Load())])]),
                  body=[
                    Assign(
                      targets=[
                        Name(id='invalid_at', ctx=Store())],
                      value=Call(
                        func=Attribute(
                          value=Attribute(
                            value=Name(id='event', ctx=Load()),
                            attr='metadata',
                            ctx=Load()),
                          attr='get',
                          ctx=Load()),
                        args=[
                          Constant(value='invalid_at')])),
                    Assign(
                      targets=[
                        Name(id='invalidated_by', ctx=Store())],
                      value=Call(
                        func=Attribute(
                          value=Attribute(
                            value=Name(id='event', ctx=Load()),
                            attr='metadata',
                            ctx=Load()),
                          attr='get',
                          ctx=Load()),
                        args=[
                          Constant(value='invalidated_by')])),
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Name(id='_neo4j_graph', ctx=Load()),
                          attr='update_relation_invalidity',
                          ctx=Load()),
                        keywords=[
                          keyword(
                            arg='rel_id',
                            value=Attribute(
                              value=Name(id='event', ctx=Load()),
                              attr='triplet_id',
                              ctx=Load())),
                          keyword(
                            arg='invalid_at',
                            value=IfExp(
                              test=Call(
                                func=Name(id='isinstance', ctx=Load()),
                                args=[
                                  Name(id='invalid_at', ctx=Load()),
                                  Name(id='datetime', ctx=Load())]),
                              body=Call(
                                func=Attribute(
                                  value=Name(id='invalid_at', ctx=Load()),
                                  attr='isoformat',
                                  ctx=Load())),
                              orelse=Name(id='invalid_at', ctx=Load()))),
                          keyword(
                            arg='invalidated_by',
                            value=Name(id='invalidated_by', ctx=Load()))]))])])],
          handlers=[
            ExceptHandler(
              type=Name(id='Exception', ctx=Load()),
              body=[
                Pass()])])],
      returns=Constant(value=None)),
    AsyncFunctionDef(
      name='batch_process_invalidation',
      args=arguments(
        args=[
          arg(
            arg='events_to_update',
            annotation=Subscript(
              value=Name(id='List', ctx=Load()),
              slice=Name(id='TemporalEvent', ctx=Load()),
              ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Processes batch invalidation updates for resume timeline analysis.\n\n    Updates multiple relations to support resume job alignment.\n    ')),
        If(
          test=UnaryOp(
            op=Not(),
            operand=Name(id='_NEO4J_AVAILABLE', ctx=Load())),
          body=[
            Return()]),
        For(
          target=Name(id='event', ctx=Store()),
          iter=Name(id='events_to_update', ctx=Load()),
          body=[
            Expr(
              value=Await(
                value=Call(
                  func=Name(id='insert_event', ctx=Load()),
                  args=[
                    Name(id='event', ctx=Load())])))])],
      returns=Constant(value=None)),
    AsyncFunctionDef(
      name='ingest_transcript',
      args=arguments(
        args=[
          arg(
            arg='transcript_id',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='entities',
            annotation=Subscript(
              value=Name(id='List', ctx=Load()),
              slice=Name(id='TemporalEntity', ctx=Load()),
              ctx=Load())),
          arg(
            arg='triplets',
            annotation=Subscript(
              value=Name(id='List', ctx=Load()),
              slice=Name(id='TemporalTriplet', ctx=Load()),
              ctx=Load())),
          arg(
            arg='events',
            annotation=Subscript(
              value=Name(id='List', ctx=Load()),
              slice=Name(id='TemporalEvent', ctx=Load()),
              ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Ingests complete resume transcript data for timeline analysis.\n\n    Mirrors all components to support resume job alignment.\n    ')),
        If(
          test=UnaryOp(
            op=Not(),
            operand=Name(id='_NEO4J_AVAILABLE', ctx=Load())),
          body=[
            Return()]),
        For(
          target=Name(id='entity', ctx=Store()),
          iter=Name(id='entities', ctx=Load()),
          body=[
            Expr(
              value=Await(
                value=Call(
                  func=Name(id='insert_entity', ctx=Load()),
                  args=[
                    Name(id='entity', ctx=Load())])))]),
        For(
          target=Name(id='triplet', ctx=Store()),
          iter=Name(id='triplets', ctx=Load()),
          body=[
            Expr(
              value=Await(
                value=Call(
                  func=Name(id='insert_triplet', ctx=Load()),
                  args=[
                    Name(id='triplet', ctx=Load())])))]),
        For(
          target=Name(id='event', ctx=Store()),
          iter=Name(id='events', ctx=Load()),
          body=[
            Expr(
              value=Await(
                value=Call(
                  func=Name(id='insert_event', ctx=Load()),
                  args=[
                    Name(id='event', ctx=Load())])))])],
      returns=Constant(value=None))])