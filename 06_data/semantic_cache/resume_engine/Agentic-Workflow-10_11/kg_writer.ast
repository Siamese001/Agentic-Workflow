                          ctx=Load())),
                      keyword(
                        arg='object_id',
                        value=Attribute(
                          value=Name(id='triplet', ctx=Load()),
                          attr='object',
                          ctx=Load())),
                      keyword(
                        arg='valid_at',
                        value=Call(
                          func=Attribute(
                            value=Attribute(
                              value=Attribute(
                                value=Name(id='triplet', ctx=Load()),
                                attr='temporal_range',
                                ctx=Load()),
                              attr='valid_at',
                              ctx=Load()),
                            attr='isoformat',
                            ctx=Load()))),
                      keyword(
