Module(
  body=[
    Expr(
      value=Constant(value='Golden Evaluation Tests.')),
    ClassDef(
      name='TestGoldenEvaluation',
      body=[
        Expr(
          value=Constant(value='Tests for golden evaluation.')),
        FunctionDef(
          name='test_section_completeness',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test section completeness evaluation.')),
            Assign(
              targets=[
                Name(id='required', ctx=Store())],
              value=List(
                elts=[
                  Constant(value='summary'),
                  Constant(value='experience'),
                  Constant(value='skills')],
                ctx=Load())),
            Assign(
              targets=[
                Name(id='present', ctx=Store())],
              value=List(
                elts=[
                  Constant(value='summary'),
                  Constant(value='experience'),
                  Constant(value='skills'),
                  Constant(value='education')],
                ctx=Load())),
            Assign(
              targets=[
                Name(id='completeness', ctx=Store())],
              value=BinOp(
                left=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    BinOp(
                      left=Call(
                        func=Name(id='set', ctx=Load()),
                        args=[
                          Name(id='required', ctx=Load())]),
                      op=BitAnd(),
                      right=Call(
                        func=Name(id='set', ctx=Load()),
                        args=[
                          Name(id='present', ctx=Load())]))]),
                op=Div(),
                right=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Name(id='required', ctx=Load())]))),
            Assert(
              test=Compare(
                left=Name(id='completeness', ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value=1.0)]))]),
        FunctionDef(
          name='test_content_quality_evaluation',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test content quality evaluation.')),
            Assign(
              targets=[
                Name(id='metrics', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='clarity'),
                  Constant(value='relevance'),
                  Constant(value='impact')],
                values=[
                  Constant(value=0.9),
                  Constant(value=0.85),
                  Constant(value=0.88)])),
            Assign(
              targets=[
                Name(id='avg_quality', ctx=Store())],
              value=BinOp(
                left=Call(
                  func=Name(id='sum', ctx=Load()),
                  args=[
                    Call(
                      func=Attribute(
                        value=Name(id='metrics', ctx=Load()),
                        attr='values',
                        ctx=Load()))]),
                op=Div(),
                right=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Name(id='metrics', ctx=Load())]))),
            Assert(
              test=Compare(
                left=Name(id='avg_quality', ctx=Load()),
                ops=[
                  Gt()],
                comparators=[
                  Constant(value=0.8)]))])])])