Module(
  body=[
    ImportFrom(
      module='infra.sandbox.microvm',
      names=[
        alias(name='create_vm'),
        alias(name='teardown_vm'),
        alias(name='exec_in_vm')],
      level=0),
    ImportFrom(
      module='infra.sandbox.models',
      names=[
        alias(name='ToolCallRequest')],
      level=0),
    ImportFrom(
      module='observability',
      names=[
        alias(name='get_all_events'),
        alias(name='clear_events')],
      level=0),
    FunctionDef(
      name='test_microvm_create_exec_teardown_emits_events',
      args=arguments(),
      body=[
        Expr(
          value=Call(
            func=Name(id='clear_events', ctx=Load()))),
        Assign(
          targets=[
            Name(id='vm', ctx=Store())],
          value=Call(
            func=Name(id='create_vm', ctx=Load()),
            args=[
              Dict(
                keys=[
                  Constant(value='cpu_ms')],
                values=[
                  Constant(value=1000)])])),
        Assign(
          targets=[
            Name(id='req', ctx=Store())],
          value=Call(
            func=Name(id='ToolCallRequest', ctx=Load()),
            keywords=[
              keyword(
                arg='tool_name',
                value=Constant(value='echo')),
              keyword(
                arg='args',
                value=List(
                  elts=[
                    Constant(value='hello')],
                  ctx=Load())),
              keyword(
                arg='timeout_s',
                value=Constant(value=1.0))])),
        Assign(
          targets=[
            Name(id='result', ctx=Store())],
          value=Call(
            func=Name(id='exec_in_vm', ctx=Load()),
            args=[
              Name(id='vm', ctx=Load()),
              Name(id='req', ctx=Load())])),
        Expr(
          value=Call(
            func=Name(id='teardown_vm', ctx=Load()),
            args=[
              Name(id='vm', ctx=Load())])),
        Assert(
          test=Compare(
            left=Attribute(
              value=Name(id='result', ctx=Load()),
              attr='success',
              ctx=Load()),
            ops=[
              Is()],
            comparators=[
              Constant(value=True)])),
        Assert(
          test=Compare(
            left=Constant(value='TOOL echo'),
            ops=[
              In()],
            comparators=[
              Attribute(
                value=Name(id='result', ctx=Load()),
                attr='stdout',
                ctx=Load())])),
        Assign(
          targets=[
            Name(id='events', ctx=Store())],
          value=Call(
            func=Name(id='get_all_events', ctx=Load()))),
        Assign(
          targets=[
            Name(id='names', ctx=Store())],
          value=ListComp(
            elt=Attribute(
              value=Name(id='e', ctx=Load()),
              attr='name',
              ctx=Load()),
            generators=[
              comprehension(
                target=Name(id='e', ctx=Store()),
                iter=Name(id='events', ctx=Load()),
                is_async=0)])),
        Assert(
          test=Compare(
            left=Constant(value='sandbox_start'),
            ops=[
              In()],
            comparators=[
              Name(id='names', ctx=Load())])),
        Assert(
          test=Compare(
            left=Constant(value='sandbox_stop'),
            ops=[
              In()],
            comparators=[
              Name(id='names', ctx=Load())])),
        Assert(
          test=Compare(
            left=Constant(value='sandbox_tool_complete'),
            ops=[
              In()],
            comparators=[
              Name(id='names', ctx=Load())]))])])