Module(
  body=[
    Expr(
      value=Constant(value='Golden Scoring Tests.')),
    ClassDef(
      name='TestGoldenScoring',
      body=[
        Expr(
          value=Constant(value='Tests for golden scoring.')),
        FunctionDef(
          name='test_quality_score_calculation',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test quality score calculation.')),
            Assign(
              targets=[
                Name(id='scores', ctx=Store())],
              value=List(
                elts=[
                  Constant(value=0.85),
                  Constant(value=0.9),
                  Constant(value=0.88),
                  Constant(value=0.92)],
                ctx=Load())),
            Assign(
              targets=[
                Name(id='avg_score', ctx=Store())],
              value=BinOp(
                left=Call(
                  func=Name(id='sum', ctx=Load()),
                  args=[
                    Name(id='scores', ctx=Load())]),
                op=Div(),
                right=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Name(id='scores', ctx=Load())]))),
            Assert(
              test=Compare(
                left=Name(id='avg_score', ctx=Load()),
                ops=[
                  Gt()],
                comparators=[
                  Constant(value=0.8)]))]),
        FunctionDef(
          name='test_keyword_match_scoring',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test keyword match scoring.')),
            Assign(
              targets=[
                Name(id='expected', ctx=Store())],
              value=List(
                elts=[
                  Constant(value='python'),
                  Constant(value='aws'),
                  Constant(value='docker')],
                ctx=Load())),
            Assign(
              targets=[
                Name(id='actual', ctx=Store())],
              value=List(
                elts=[
                  Constant(value='python'),
                  Constant(value='aws'),
                  Constant(value='kubernetes')],
                ctx=Load())),
            Assign(
              targets=[
                Name(id='matches', ctx=Store())],
              value=Call(
                func=Name(id='len', ctx=Load()),
                args=[
                  BinOp(
                    left=Call(
                      func=Name(id='set', ctx=Load()),
                      args=[
                        Name(id='expected', ctx=Load())]),
                    op=BitAnd(),
                    right=Call(
                      func=Name(id='set', ctx=Load()),
                      args=[
                        Name(id='actual', ctx=Load())]))])),
            Assign(
              targets=[
                Name(id='score', ctx=Store())],
              value=BinOp(
                left=Name(id='matches', ctx=Load()),
                op=Div(),
                right=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Name(id='expected', ctx=Load())]))),
            Assert(
              test=Compare(
                left=Name(id='score', ctx=Load()),
                ops=[
                  Gt()],
                comparators=[
                  Constant(value=0.5)]))])])])