    ClassDef(
      name='UnifiedKGIngestionDAG',
      body=[
        Expr(
          value=Constant(value='Unified DAG for temporal knowledge graph ingestion.\n    \n    This orchestrates the complete ingestion pipeline from raw documents\n    to persisted temporal KG data with configurable failure handling\n    and checkpointing support.\n    ')),
        FunctionDef(
