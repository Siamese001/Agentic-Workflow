                    is_async=0)])),
            Assert(
              test=Compare(
                left=Attribute(
                  value=Name(id='result', ctx=Load()),
                  attr='total_extracted',
                  ctx=Load()),
                ops=[
                  GtE()],
                comparators=[
                  Constant(value=0)])),
            Assert(
              test=Call(
