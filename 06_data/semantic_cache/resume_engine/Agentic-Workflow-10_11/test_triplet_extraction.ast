Module(
  body=[
    Expr(
      value=Constant(value='\nTest Triplet Extraction\n\nTests triplet extraction functionality extracted from working legacy tests.\n')),
    Import(
      names=[
        alias(name='pytest')]),
    ImportFrom(
      module='l2.triplet_extraction_executor',
      names=[
        alias(name='TripletExtractionExecutor'),
        alias(name='create_extraction_plan')],
      level=0),
    Assign(
      targets=[
        Name(id='pytestmark', ctx=Store())],
      value=List(
        elts=[
          Attribute(
            value=Attribute(
              value=Name(id='pytest', ctx=Load()),
              attr='mark',
              ctx=Load()),
            attr='unit',
            ctx=Load()),
          Attribute(
