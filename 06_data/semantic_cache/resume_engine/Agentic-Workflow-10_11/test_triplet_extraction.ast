              attr='mark',
              ctx=Load()),
            attr='execution',
            ctx=Load())],
        ctx=Load())),
    ClassDef(
      name='TestTripletExtraction',
      body=[
        Expr(
          value=Constant(value='Test L2 Triplet Extraction Executor.')),
        FunctionDef(
          name='test_extract_skills',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test skill extraction from text.')),
            Assign(
              targets=[
                Name(id='executor', ctx=Store())],
              value=Call(
                func=Name(id='TripletExtractionExecutor', ctx=Load()))),
            Assign(
              targets=[
                Name(id='plan', ctx=Store())],
              value=Call(
                func=Name(id='create_extraction_plan', ctx=Load()),
                keywords=[
                  keyword(
                    arg='source_text',
                    value=Constant(value='Experienced Python developer with expertise in AWS and Docker')),
                  keyword(
                    arg='source_id',
                    value=Constant(value='doc_001')),
                  keyword(
                    arg='user_id',
                    value=Constant(value='user_123'))])),
            Assign(
              targets=[
                Name(id='result', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='executor', ctx=Load()),
                  attr='execute',
                  ctx=Load()),
                args=[
                  Name(id='plan', ctx=Load())])),
            Assert(
              test=Compare(
                left=Attribute(
                  value=Name(id='result', ctx=Load()),
                  attr='total_extracted',
                  ctx=Load()),
                ops=[
                  Gt()],
                comparators=[
                  Constant(value=0)])),
            Assign(
              targets=[
                Name(id='skills', ctx=Store())],
              value=ListComp(
                elt=Attribute(
                  value=Name(id='t', ctx=Load()),
                  attr='object',
                  ctx=Load()),
                generators=[
                  comprehension(
                    target=Name(id='t', ctx=Store()),
                    iter=Attribute(
                      value=Name(id='result', ctx=Load()),
                      attr='triplets',
                      ctx=Load()),
                    ifs=[
                      Compare(
                        left=Attribute(
                          value=Name(id='t', ctx=Load()),
                          attr='predicate',
                          ctx=Load()),
                        ops=[
                          Eq()],
                        comparators=[
                          Constant(value='has_skill')])],
                    is_async=0)])),
            Assert(
              test=Compare(
                left=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Name(id='skills', ctx=Load())]),
                ops=[
                  GtE()],
                comparators=[
                  Constant(value=1)]))]),
        FunctionDef(
          name='test_extract_experience',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test experience extraction from text.')),
            Assign(
              targets=[
                Name(id='executor', ctx=Store())],
              value=Call(
                func=Name(id='TripletExtractionExecutor', ctx=Load()))),
            Assign(
