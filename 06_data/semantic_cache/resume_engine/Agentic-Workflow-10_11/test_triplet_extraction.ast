                    value=Constant(value='Worked at Google as Senior Engineer from 2020 to present')),
                  keyword(
                    arg='source_id',
                    value=Constant(value='doc_002')),
                  keyword(
                    arg='user_id',
                    value=Constant(value='user_123'))])),
            Assign(
