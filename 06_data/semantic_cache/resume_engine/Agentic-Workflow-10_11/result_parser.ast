Module(
  body=[
    Expr(
      value=Constant(value='\nL1 Result Parser for resume generation result processing.\n\nParses and structures results for consistent resume improvement\nand job alignment validation.\n')),
    ImportFrom(
      module='dataclasses',
      names=[
        alias(name='dataclass')],
      level=0),
    ClassDef(
      name='StrategyResult',
      body=[
        Expr(
          value=Constant(value='\n    Strategy result data for resume improvement planning.\n\n    Ensures structured strategy output for optimal resume job alignment.\n    ')),
        AnnAssign(
          target=Name(id='strategy', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='confidence', ctx=Store()),
          annotation=Name(id='float', ctx=Load()),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='DraftResult',
      body=[
        Expr(
          value=Constant(value='\n    Draft result data for resume content creation.\n\n    Ensures structured draft output for professional resume enhancement.\n    ')),
        AnnAssign(
          target=Name(id='sections', ctx=Store()),
          annotation=Name(id='list', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='content', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='QAResult',
      body=[
        Expr(
          value=Constant(value='\n    QA result data for resume quality validation.\n\n    Ensures structured QA output for resume accuracy assessment.\n    ')),
        AnnAssign(
          target=Name(id='findings', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='confidence', ctx=Store()),
          annotation=Name(id='float', ctx=Load()),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='SafetyResult',
      body=[
        Expr(
          value=Constant(value='\n    Safety result data for resume compliance checking.\n\n    Ensures structured safety output for professional standards.\n    ')),
        AnnAssign(
          target=Name(id='violations', ctx=Store()),
          annotation=Name(id='list', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='approved', ctx=Store()),
          annotation=Name(id='bool', ctx=Load()),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='ResultParser',
      body=[
        Expr(
          value=Constant(value='\n    Parses resume generation results without execution logic.\n\n    Ensures consistent result processing for improved resume\n    quality and job alignment validation.\n    ')),
        FunctionDef(
          name='parse_strategy_result',
          args=arguments(
            args=[
              arg(
                arg='llm_response',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Parses strategy result for resume improvement planning.\n\n        Structures strategy output for optimal resume job alignment.\n        ')),
            Return(
              value=Call(
                func=Name(id='StrategyResult', ctx=Load()),
                keywords=[
                  keyword(
                    arg='strategy',
                    value=Call(
                      func=Attribute(
                        value=Name(id='llm_response', ctx=Load()),
                        attr='strip',
                        ctx=Load()))),
                  keyword(
                    arg='confidence',
                    value=Constant(value=0.8))]))],
          decorator_list=[
            Name(id='staticmethod', ctx=Load())],
          returns=Name(id='StrategyResult', ctx=Load())),
        FunctionDef(
          name='parse_draft_result',
          args=arguments(
            args=[
              arg(
                arg='llm_response',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Parses draft result for resume content creation.\n\n        Structures draft output for professional resume enhancement.\n        ')),
            Return(
              value=Call(
                func=Name(id='DraftResult', ctx=Load()),
                keywords=[
                  keyword(
                    arg='sections',
                    value=List(
                      elts=[
                        Constant(value='summary'),
                        Constant(value='experience'),
                        Constant(value='skills')],
                      ctx=Load())),
                  keyword(
                    arg='content',
                    value=Call(
                      func=Attribute(
                        value=Name(id='llm_response', ctx=Load()),
                        attr='strip',
                        ctx=Load())))]))],
          decorator_list=[
            Name(id='staticmethod', ctx=Load())],
          returns=Name(id='DraftResult', ctx=Load())),
        FunctionDef(
          name='parse_qa_result',
          args=arguments(
            args=[
              arg(
                arg='llm_response',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Parses QA result for resume quality validation.\n\n        Structures QA output for resume accuracy assessment.\n        ')),
            Return(
              value=Call(
                func=Name(id='QAResult', ctx=Load()),
                keywords=[
                  keyword(
                    arg='findings',
                    value=Call(
                      func=Attribute(
                        value=Name(id='llm_response', ctx=Load()),
                        attr='strip',
                        ctx=Load()))),
                  keyword(
                    arg='confidence',
                    value=Constant(value=0.8))]))],
          decorator_list=[
            Name(id='staticmethod', ctx=Load())],
          returns=Name(id='QAResult', ctx=Load())),
        FunctionDef(
          name='parse_safety_result',
          args=arguments(
            args=[
              arg(
                arg='llm_response',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Parses safety result for resume compliance checking.\n\n        Structures safety output for professional standards validation.\n        ')),
            Return(
              value=Call(
                func=Name(id='SafetyResult', ctx=Load()),
                keywords=[
                  keyword(
                    arg='violations',
                    value=List(ctx=Load())),
                  keyword(
                    arg='approved',
                    value=Constant(value=True))]))],
          decorator_list=[
            Name(id='staticmethod', ctx=Load())],
          returns=Name(id='SafetyResult', ctx=Load()))])])