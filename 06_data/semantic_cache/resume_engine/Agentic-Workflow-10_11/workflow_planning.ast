    FunctionDef(
      name='_run_profile_inference',
      args=arguments(
        args=[
          arg(
            arg='job_text',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='resume_text',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='complexity',
            annotation=Name(id='ComplexityLevel', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Analyzes career profile from job and resume content.\n\n    Generates comprehensive profile insights for targeted\n    resume optimization and job alignment.\n    ')),
        Assign(
          targets=[
            Name(id='seniority_label', ctx=Store())],
          value=Call(
            func=Name(id='_infer_seniority', ctx=Load()),
            args=[
              Name(id='job_text', ctx=Load()),
              Name(id='resume_text', ctx=Load())])),
        Assign(
          targets=[
            Name(id='domains', ctx=Store())],
          value=Call(
            func=Name(id='_infer_domains', ctx=Load()),
            args=[
              Name(id='job_text', ctx=Load()),
              Name(id='resume_text', ctx=Load())])),
        Assign(
          targets=[
            Name(id='skill_clusters', ctx=Store())],
          value=Call(
            func=Name(id='_infer_skill_clusters', ctx=Load()),
            args=[
              Name(id='job_text', ctx=Load()),
              Name(id='resume_text', ctx=Load())])),
        Assign(
          targets=[
            Name(id='seniority', ctx=Store())],
          value=Call(
            func=Name(id='SeniorityClassifierResult', ctx=Load()),
            keywords=[
              keyword(
                arg='label',
                value=Name(id='seniority_label', ctx=Load()))])),
        Assign(
          targets=[
            Name(id='domain', ctx=Store())],
          value=Constant(value=None)),
        If(
          test=Name(id='domains', ctx=Load()),
          body=[
            Assign(
              targets=[
                Name(id='domain', ctx=Store())],
              value=Call(
                func=Name(id='DomainClassifierResult', ctx=Load()),
                keywords=[
                  keyword(
                    arg='labels',
                    value=Name(id='domains', ctx=Load())),
                  keyword(
                    arg='primary_label',
                    value=Subscript(
                      value=Name(id='domains', ctx=Load()),
                      slice=Constant(value=0),
                      ctx=Load()))]))]),
        Assign(
          targets=[
            Name(id='skills', ctx=Store())],
          value=Constant(value=None)),
        If(
          test=Name(id='skill_clusters', ctx=Load()),
          body=[
            Assign(
              targets=[
                Name(id='skills', ctx=Store())],
              value=Call(
                func=Name(id='SkillClusterResult', ctx=Load()),
                keywords=[
                  keyword(
                    arg='labels',
                    value=Name(id='skill_clusters', ctx=Load())),
                  keyword(
                    arg='primary_label',
                    value=Subscript(
                      value=Name(id='skill_clusters', ctx=Load()),
                      slice=Constant(value=0),
                      ctx=Load()))]))]),
        Return(
          value=Call(
            func=Name(id='ProfileInferenceResult', ctx=Load()),
            keywords=[
              keyword(
                arg='seniority',
                value=Name(id='seniority', ctx=Load())),
              keyword(
                arg='domain',
                value=Name(id='domain', ctx=Load())),
              keyword(
                arg='skills',
                value=Name(id='skills', ctx=Load())),
              keyword(
                arg='complexity',
                value=Name(id='complexity', ctx=Load()))]))],
      returns=Name(id='ProfileInferenceResult', ctx=Load())),
    Expr(
      value=Constant(value='\nDetermines processing complexity from content analysis.\n\nEnsures appropriate resource allocation for optimal resume\nimprovement quality and job alignment.\n')),
    FunctionDef(
      name='_classify_complexity',
      args=arguments(
        args=[
          arg(
            arg='job_text',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='resume_text',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='profile_spec',
            annotation=Name(id='ExecutionProfileSpec', ctx=Load())),
          arg(
            arg='meta_profile',
            annotation=Subscript(
              value=Name(id='Optional', ctx=Load()),
              slice=Name(id='MetaProfileSnapshot', ctx=Load()),
              ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Determines processing complexity from content analysis.\n\n    Ensures appropriate resource allocation for optimal resume\n    improvement quality and job alignment.\n    ')),
        Assign(
          targets=[
            Name(id='total_tokens', ctx=Store())],
          value=BinOp(
            left=Call(
              func=Name(id='len', ctx=Load()),
              args=[
                Call(
                  func=Attribute(
                    value=Name(id='job_text', ctx=Load()),
                    attr='split',
                    ctx=Load()))]),
            op=Add(),
            right=Call(
              func=Name(id='len', ctx=Load()),
              args=[
                Call(
                  func=Attribute(
                    value=Name(id='resume_text', ctx=Load()),
                    attr='split',
                    ctx=Load()))]))),
        If(
          test=Compare(
            left=Name(id='total_tokens', ctx=Load()),
            ops=[
              Lt()],
            comparators=[
              Constant(value=800)]),
          body=[
            AnnAssign(
              target=Name(id='level', ctx=Store()),
              annotation=Name(id='ComplexityLevel', ctx=Load()),
              value=Attribute(
                value=Name(id='ComplexityLevel', ctx=Load()),
                attr='LOW',
                ctx=Load()),
              simple=1)],
          orelse=[
            If(
              test=Compare(
                left=Name(id='total_tokens', ctx=Load()),
                ops=[
                  Lt()],
                comparators=[
                  Constant(value=2500)]),
              body=[
                Assign(
                  targets=[
                    Name(id='level', ctx=Store())],
                  value=Attribute(
                    value=Name(id='ComplexityLevel', ctx=Load()),
                    attr='MEDIUM',
                    ctx=Load()))],
              orelse=[
                Assign(
                  targets=[
                    Name(id='level', ctx=Store())],
                  value=Attribute(
                    value=Name(id='ComplexityLevel', ctx=Load()),
                    attr='HIGH',
                    ctx=Load()))])]),
        If(
          test=Compare(
            left=Name(id='meta_profile', ctx=Load()),
            ops=[
              IsNot()],
            comparators=[
              Constant(value=None)]),
          body=[
            If(
              test=BoolOp(
                op=Or(),
                values=[
                  Attribute(
                    value=Name(id='meta_profile', ctx=Load()),
                    attr='elevated_caution',
                    ctx=Load()),
                  Compare(
                    left=Attribute(
                      value=Name(id='meta_profile', ctx=Load()),
                      attr='correction_rate_last_10',
                      ctx=Load()),
                    ops=[
                      Gt()],
                    comparators=[
                      Constant(value=0.3)])]),
              body=[
                If(
                  test=Compare(
                    left=Name(id='level', ctx=Load()),
                    ops=[
                      Is()],
                    comparators=[
                      Attribute(
                        value=Name(id='ComplexityLevel', ctx=Load()),
                        attr='LOW',
                        ctx=Load())]),
                  body=[
                    Assign(
                      targets=[
                        Name(id='level', ctx=Store())],
                      value=Attribute(
                        value=Name(id='ComplexityLevel', ctx=Load()),
                        attr='MEDIUM',
                        ctx=Load()))],
                  orelse=[
                    If(
                      test=Compare(
                        left=Name(id='level', ctx=Load()),
                        ops=[
                          Is()],
                        comparators=[
                          Attribute(
                            value=Name(id='ComplexityLevel', ctx=Load()),
                            attr='MEDIUM',
                            ctx=Load())]),
                      body=[
                        Assign(
                          targets=[
                            Name(id='level', ctx=Store())],
                          value=Attribute(
                            value=Name(id='ComplexityLevel', ctx=Load()),
                            attr='HIGH',
                            ctx=Load()))])])])]),
        If(
          test=Compare(
            left=Attribute(
              value=Name(id='profile_spec', ctx=Load()),
              attr='min_complexity',
              ctx=Load()),
            ops=[
              IsNot()],
            comparators=[
              Constant(value=None)]),
          body=[
            If(
              test=Compare(
                left=Attribute(
                  value=Name(id='level', ctx=Load()),
                  attr='value',
                  ctx=Load()),
                ops=[
                  Lt()],
                comparators=[
                  Attribute(
                    value=Attribute(
                      value=Name(id='profile_spec', ctx=Load()),
                      attr='min_complexity',
                      ctx=Load()),
                    attr='value',
                    ctx=Load())]),
              body=[
                Assign(
                  targets=[
                    Name(id='level', ctx=Store())],
                  value=Attribute(
                    value=Name(id='profile_spec', ctx=Load()),
                    attr='min_complexity',
                    ctx=Load()))])]),
        Return(
          value=Name(id='level', ctx=Load()))],
      returns=Name(id='ComplexityLevel', ctx=Load())),
    FunctionDef(
      name='_choose_reasoning_mode',
      args=arguments(
        args=[
          arg(
            arg='profile_spec',
            annotation=Name(id='ExecutionProfileSpec', ctx=Load())),
          arg(
            arg='meta_profile',
            annotation=Subscript(
              value=Name(id='Optional', ctx=Load()),
              slice=Name(id='MetaProfileSnapshot', ctx=Load()),
              ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Selects optimal reasoning approach for resume analysis.\n\n    Adapts processing strategy based on user preferences\n    and content complexity for better job alignment.\n    ')),
        Assign(
          targets=[
            Name(id='mode', ctx=Store())],
          value=Attribute(
            value=Name(id='profile_spec', ctx=Load()),
            attr='reasoning_mode',
            ctx=Load())),
        If(
          test=Compare(
            left=Name(id='meta_profile', ctx=Load()),
            ops=[
              IsNot()],
            comparators=[
              Constant(value=None)]),
          body=[
            Assign(
              targets=[
                Name(id='hint', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=BoolOp(
                    op=Or(),
                    values=[
                      Attribute(
                        value=Name(id='meta_profile', ctx=Load()),
                        attr='reasoning_mode_hint',
                        ctx=Load()),
                      Constant(value='')]),
                  attr='lower',
                  ctx=Load()))),
            If(
              test=Compare(
                left=Name(id='hint', ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value='cot')]),
              body=[
                Assign(
                  targets=[
                    Name(id='mode', ctx=Store())],
                  value=Attribute(
                    value=Name(id='ReasoningMode', ctx=Load()),
                    attr='CHAIN_OF_THOUGHT',
                    ctx=Load()))],
              orelse=[
                If(
                  test=Compare(
                    left=Name(id='hint', ctx=Load()),
                    ops=[
                      Eq()],
                    comparators=[
                      Constant(value='tot')]),
                  body=[
                    Assign(
                      targets=[
                        Name(id='mode', ctx=Store())],
                      value=Attribute(
                        value=Name(id='ReasoningMode', ctx=Load()),
                        attr='TOT',
                        ctx=Load()))],
                  orelse=[
                    If(
                      test=Compare(
                        left=Name(id='hint', ctx=Load()),
                        ops=[
                          Eq()],
                        comparators=[
                          Constant(value='react')]),
                      body=[
                        Assign(
                          targets=[
                            Name(id='mode', ctx=Store())],
                          value=Attribute(
                            value=Name(id='ReasoningMode', ctx=Load()),
                            attr='REACT',
                            ctx=Load()))])])])]),
        Return(
          value=Name(id='mode', ctx=Load()))],
      returns=Name(id='ReasoningMode', ctx=Load())),
    FunctionDef(
      name='_to_execution_profile',
      args=arguments(
        args=[
          arg(
            arg='spec',
            annotation=Name(id='ExecutionProfileSpec', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Converts configuration spec into execution profile.\n\n    Creates structured workflow settings for consistent resume\n    improvement processing and job alignment.\n    ')),
        Return(
          value=Call(
            func=Name(id='ExecutionProfile', ctx=Load()),
            keywords=[
              keyword(
                arg='name',
                value=Attribute(
                  value=Name(id='spec', ctx=Load()),
                  attr='id',
                  ctx=Load())),
              keyword(
                arg='description',
                value=Attribute(
                  value=Name(id='spec', ctx=Load()),
                  attr='description',
                  ctx=Load())),
              keyword(
                arg='retrieval',
                value=Attribute(
                  value=Name(id='spec', ctx=Load()),
                  attr='retrieval',
                  ctx=Load())),
              keyword(
                arg='metadata',
                value=Dict(
                  keys=[
                    Constant(value='safety_tier'),
                    Constant(value='model_tier'),
                    Constant(value='max_cost_usd'),
                    Constant(value='max_latency_ms'),
                    Constant(value='qa_council_size'),
                    Constant(value='enable_correction_loop'),
                    Constant(value='max_corrections'),
                    Constant(value='rag_allow_hyde'),
                    Constant(value='hyde_model_tier'),
                    Constant(value='routing_telemetry_mode')],
                  values=[
                    Attribute(
                      value=Attribute(
                        value=Name(id='spec', ctx=Load()),
                        attr='safety_tier',
                        ctx=Load()),
                      attr='value',
                      ctx=Load()),
