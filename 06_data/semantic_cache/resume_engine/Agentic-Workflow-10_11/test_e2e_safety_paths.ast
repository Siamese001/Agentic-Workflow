Module(
  body=[
    Expr(
      value=Constant(value='E2E Safety Enforced Path Tests.')),
    ClassDef(
      name='TestE2ESafetyPaths',
      body=[
        Expr(
          value=Constant(value='E2E tests for safety enforced paths.')),
        FunctionDef(
          name='test_pii_blocked_workflow',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test PII is blocked in complete workflow.')),
            Assign(
              targets=[
                Name(id='content', ctx=Store())],
              value=Constant(value='safe resume without PII')),
            Assign(
              targets=[
                Name(id='pii_patterns', ctx=Store())],
              value=List(
                elts=[
                  Constant(value='SSN:'),
                  Constant(value='DOB:')],
                ctx=Load())),
            Assign(
              targets=[
                Name(id='is_blocked', ctx=Store())],
              value=Call(
                func=Name(id='any', ctx=Load()),
                args=[
                  GeneratorExp(
                    elt=Compare(
                      left=Name(id='p', ctx=Load()),
                      ops=[
                        In()],
                      comparators=[
                        Name(id='content', ctx=Load())]),
                    generators=[
                      comprehension(
                        target=Name(id='p', ctx=Store()),
                        iter=Name(id='pii_patterns', ctx=Load()),
                        is_async=0)])])),
            Assert(
              test=Compare(
                left=Name(id='is_blocked', ctx=Load()),
                ops=[
                  Is()],
                comparators=[
                  Constant(value=False)]))]),
        FunctionDef(
          name='test_injection_prevented_workflow',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test injection is prevented in workflow.')),
            Assign(
              targets=[
                Name(id='prompt', ctx=Store())],
              value=Constant(value='normal user prompt')),
            Assign(
              targets=[
                Name(id='injection_patterns', ctx=Store())],
              value=List(
                elts=[
                  Constant(value='ignore previous'),
                  Constant(value='system override')],
                ctx=Load())),
            Assign(
              targets=[
                Name(id='is_safe', ctx=Store())],
              value=UnaryOp(
                op=Not(),
                operand=Call(
                  func=Name(id='any', ctx=Load()),
                  args=[
                    GeneratorExp(
                      elt=Compare(
                        left=Name(id='p', ctx=Load()),
                        ops=[
                          In()],
                        comparators=[
                          Call(
                            func=Attribute(
                              value=Name(id='prompt', ctx=Load()),
                              attr='lower',
                              ctx=Load()))]),
                      generators=[
                        comprehension(
                          target=Name(id='p', ctx=Store()),
                          iter=Name(id='injection_patterns', ctx=Load()),
                          is_async=0)])]))),
            Assert(
              test=Compare(
                left=Name(id='is_safe', ctx=Load()),
                ops=[
                  Is()],
                comparators=[
                  Constant(value=True)]))])])])