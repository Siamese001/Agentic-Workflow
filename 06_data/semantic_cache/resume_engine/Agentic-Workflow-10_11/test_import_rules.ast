Module(
  body=[
    Import(
      names=[
        alias(name='ast')]),
    ImportFrom(
      module='pathlib',
      names=[
        alias(name='Path')],
      level=0),
    Assign(
      targets=[
        Name(id='PROJECT_ROOT', ctx=Store())],
      value=Subscript(
        value=Attribute(
          value=Call(
            func=Attribute(
              value=Call(
                func=Name(id='Path', ctx=Load()),
                args=[
                  Name(id='__file__', ctx=Load())]),
              attr='resolve',
              ctx=Load())),
          attr='parents',
          ctx=Load()),
        slice=Constant(value=2),
        ctx=Load())),
    FunctionDef(
      name='_iter_py_files',
      args=arguments(
        args=[
          arg(
            arg='root',
            annotation=Name(id='Path', ctx=Load()))]),
      body=[
        If(
          test=UnaryOp(
            op=Not(),
            operand=Call(
              func=Attribute(
                value=Name(id='root', ctx=Load()),
                attr='exists',
                ctx=Load()))),
          body=[
            Return()]),
        For(
          target=Name(id='path', ctx=Store()),
          iter=Call(
            func=Attribute(
              value=Name(id='root', ctx=Load()),
              attr='rglob',
              ctx=Load()),
            args=[
              Constant(value='*.py')]),
          body=[
            If(
              test=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='path', ctx=Load()),
                    attr='name',
                    ctx=Load()),
                  attr='startswith',
                  ctx=Load()),
                args=[
                  Constant(value='test_')]),
              body=[
                Continue()]),
            Expr(
              value=Yield(
                value=Name(id='path', ctx=Load())))])]),
    FunctionDef(
      name='_parse_imports',
      args=arguments(
        args=[
          arg(
            arg='path',
            annotation=Name(id='Path', ctx=Load()))]),
      body=[
        Try(
          body=[
            Assign(
              targets=[
                Name(id='source', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='path', ctx=Load()),
                  attr='read_text',
                  ctx=Load()),
                keywords=[
                  keyword(
                    arg='encoding',
                    value=Constant(value='utf-8'))]))],
          handlers=[
            ExceptHandler(
              type=Name(id='OSError', ctx=Load()),
              body=[
                Return(
                  value=List(ctx=Load()))])]),
        Try(
          body=[
            Assign(
              targets=[
                Name(id='tree', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='ast', ctx=Load()),
                  attr='parse',
                  ctx=Load()),
                args=[
                  Name(id='source', ctx=Load())],
                keywords=[
                  keyword(
                    arg='filename',
                    value=Call(
                      func=Name(id='str', ctx=Load()),
                      args=[
                        Name(id='path', ctx=Load())]))]))],
          handlers=[
            ExceptHandler(
              type=Name(id='SyntaxError', ctx=Load()),
              body=[
                Return(
                  value=List(ctx=Load()))])]),
        AnnAssign(
          target=Name(id='imports', ctx=Store()),
          annotation=Subscript(
            value=Name(id='list', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load()),
          value=List(ctx=Load()),
          simple=1),
        For(
          target=Name(id='node', ctx=Store()),
          iter=Call(
            func=Attribute(
              value=Name(id='ast', ctx=Load()),
              attr='walk',
              ctx=Load()),
            args=[
              Name(id='tree', ctx=Load())]),
          body=[
            If(
              test=Call(
                func=Name(id='isinstance', ctx=Load()),
                args=[
                  Name(id='node', ctx=Load()),
                  Attribute(
                    value=Name(id='ast', ctx=Load()),
                    attr='Import',
                    ctx=Load())]),
              body=[
                For(
                  target=Name(id='alias', ctx=Store()),
                  iter=Attribute(
                    value=Name(id='node', ctx=Load()),
                    attr='names',
                    ctx=Load()),
                  body=[
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Name(id='imports', ctx=Load()),
                          attr='append',
                          ctx=Load()),
                        args=[
                          Attribute(
                            value=Name(id='alias', ctx=Load()),
                            attr='name',
                            ctx=Load())]))])],
              orelse=[
                If(
                  test=Call(
                    func=Name(id='isinstance', ctx=Load()),
                    args=[
                      Name(id='node', ctx=Load()),
                      Attribute(
                        value=Name(id='ast', ctx=Load()),
                        attr='ImportFrom',
                        ctx=Load())]),
                  body=[
                    If(
                      test=Attribute(
                        value=Name(id='node', ctx=Load()),
                        attr='module',
                        ctx=Load()),
                      body=[
                        Expr(
                          value=Call(
                            func=Attribute(
                              value=Name(id='imports', ctx=Load()),
                              attr='append',
                              ctx=Load()),
                            args=[
                              Attribute(
                                value=Name(id='node', ctx=Load()),
                                attr='module',
                                ctx=Load())]))])])])]),
        Return(
          value=Name(id='imports', ctx=Load()))]),
    FunctionDef(
      name='_has_forbidden_import',
      args=arguments(
        args=[
          arg(
            arg='root',
            annotation=Name(id='Path', ctx=Load())),
          arg(
            arg='forbidden_prefixes',
            annotation=Subscript(
              value=Name(id='list', ctx=Load()),
              slice=Name(id='str', ctx=Load()),
              ctx=Load()))]),
      body=[
        AnnAssign(
          target=Name(id='violations', ctx=Store()),
          annotation=Subscript(
            value=Name(id='list', ctx=Load()),
            slice=Subscript(
              value=Name(id='tuple', ctx=Load()),
              slice=Tuple(
                elts=[
                  Name(id='Path', ctx=Load()),
                  Name(id='str', ctx=Load())],
                ctx=Load()),
              ctx=Load()),
            ctx=Load()),
          value=List(ctx=Load()),
          simple=1),
        For(
          target=Name(id='path', ctx=Store()),
          iter=Call(
            func=Name(id='_iter_py_files', ctx=Load()),
            args=[
              Name(id='root', ctx=Load())]),
          body=[
            For(
              target=Name(id='mod', ctx=Store()),
              iter=Call(
                func=Name(id='_parse_imports', ctx=Load()),
                args=[
                  Name(id='path', ctx=Load())]),
              body=[
                For(
                  target=Name(id='prefix', ctx=Store()),
                  iter=Name(id='forbidden_prefixes', ctx=Load()),
                  body=[
                    If(
                      test=BoolOp(
                        op=Or(),
                        values=[
                          Compare(
                            left=Name(id='mod', ctx=Load()),
                            ops=[
                              Eq()],
                            comparators=[
                              Name(id='prefix', ctx=Load())]),
                          Call(
                            func=Attribute(
                              value=Name(id='mod', ctx=Load()),
                              attr='startswith',
                              ctx=Load()),
                            args=[
                              BinOp(
                                left=Name(id='prefix', ctx=Load()),
                                op=Add(),
                                right=Constant(value='.'))])]),
                      body=[
                        Expr(
                          value=Call(
                            func=Attribute(
                              value=Name(id='violations', ctx=Load()),
                              attr='append',
                              ctx=Load()),
                            args=[
                              Tuple(
                                elts=[
                                  Name(id='path', ctx=Load()),
                                  Name(id='mod', ctx=Load())],
                                ctx=Load())]))])])])]),
        Return(
          value=Name(id='violations', ctx=Load()))],
      returns=Subscript(
        value=Name(id='list', ctx=Load()),
        slice=Subscript(
          value=Name(id='tuple', ctx=Load()),
          slice=Tuple(
            elts=[
              Name(id='Path', ctx=Load()),
              Name(id='str', ctx=Load())],
            ctx=Load()),
          ctx=Load()),
        ctx=Load())),
    FunctionDef(
      name='test_core_does_not_import_providers',
      args=arguments(),
      body=[
        Expr(
          value=Constant(value='core/* MUST NOT import providers/* (scoped to new core tree only).')),
        Assign(
          targets=[
            Name(id='core_root', ctx=Store())],
          value=BinOp(
            left=Name(id='PROJECT_ROOT', ctx=Load()),
            op=Div(),
            right=Constant(value='core'))),
        Assign(
          targets=[
            Name(id='violations', ctx=Store())],
          value=Call(
            func=Name(id='_has_forbidden_import', ctx=Load()),
            args=[
              Name(id='core_root', ctx=Load()),
              List(
                elts=[
                  Constant(value='providers')],
                ctx=Load())])),
        Assert(
          test=UnaryOp(
            op=Not(),
            operand=Name(id='violations', ctx=Load())),
          msg=JoinedStr(
            values=[
              Constant(value='core modules must not import providers: '),
              FormattedValue(
                value=Name(id='violations', ctx=Load()),
                conversion=-1)]))],
      returns=Constant(value=None)),
    FunctionDef(
      name='test_core_does_not_import_meta_retrievers_directly',
      args=arguments(),
      body=[
        Expr(
          value=Constant(value='core/* must not depend on low-level retrievers; use orchestrators instead.')),
        Assign(
          targets=[
            Name(id='core_root', ctx=Store())],
          value=BinOp(
            left=Name(id='PROJECT_ROOT', ctx=Load()),
            op=Div(),
            right=Constant(value='core'))),
        Assign(
          targets=[
            Name(id='violations', ctx=Store())],
          value=Call(
            func=Name(id='_has_forbidden_import', ctx=Load()),
            args=[
              Name(id='core_root', ctx=Load()),
              List(
                elts=[
                  Constant(value='meta.retrieval.retrievers')],
                ctx=Load())])),
        Assert(
          test=UnaryOp(
            op=Not(),
            operand=Name(id='violations', ctx=Load())),
          msg=JoinedStr(
            values=[
              Constant(value='core modules must not import retrievers directly: '),
              FormattedValue(
                value=Name(id='violations', ctx=Load()),
                conversion=-1)]))],
      returns=Constant(value=None)),
    FunctionDef(
      name='test_meta_does_not_import_core',
      args=arguments(),
      body=[
        Expr(
          value=Constant(value='meta/* MUST NOT import core/* (except core.models.models for data types).')),
        Assign(
          targets=[
            Name(id='meta_root', ctx=Store())],
          value=BinOp(
            left=Name(id='PROJECT_ROOT', ctx=Load()),
            op=Div(),
            right=Constant(value='meta'))),
        Assign(
          targets=[
            Name(id='all_violations', ctx=Store())],
          value=Call(
            func=Name(id='_has_forbidden_import', ctx=Load()),
            args=[
              Name(id='meta_root', ctx=Load()),
              List(
                elts=[
                  Constant(value='core')],
                ctx=Load())])),
        Assign(
          targets=[
            Name(id='allowed_imports', ctx=Store())],
          value=Set(
            elts=[
              Constant(value='core.models.models'),
              Constant(value='core.models')])),
        Assign(
          targets=[
            Name(id='violations', ctx=Store())],
          value=ListComp(
            elt=Tuple(
              elts=[
                Name(id='path', ctx=Load()),
                Name(id='mod', ctx=Load())],
              ctx=Load()),
            generators=[
              comprehension(
                target=Tuple(
                  elts=[
                    Name(id='path', ctx=Store()),
                    Name(id='mod', ctx=Store())],
                  ctx=Store()),
                iter=Name(id='all_violations', ctx=Load()),
                ifs=[
                  Compare(
                    left=Name(id='mod', ctx=Load()),
                    ops=[
                      NotIn()],
                    comparators=[
                      Name(id='allowed_imports', ctx=Load())])],
                is_async=0)])),
        Assert(
          test=UnaryOp(
            op=Not(),
            operand=Name(id='violations', ctx=Load())),
          msg=JoinedStr(
            values=[
              Constant(value='meta modules must not import core (except core.models): '),
              FormattedValue(
                value=Name(id='violations', ctx=Load()),
                conversion=-1)]))],
      returns=Constant(value=None)),
    FunctionDef(
      name='test_providers_do_not_import_core_or_meta',
      args=arguments(),
      body=[
        Expr(
          value=Constant(value='providers/* MUST be infrastructure-only; no core/meta imports.')),
        Assign(
          targets=[
            Name(id='providers_root', ctx=Store())],
          value=BinOp(
            left=Name(id='PROJECT_ROOT', ctx=Load()),
            op=Div(),
            right=Constant(value='providers'))),
        Assign(
          targets=[
            Name(id='violations', ctx=Store())],
          value=Call(
            func=Name(id='_has_forbidden_import', ctx=Load()),
            args=[
              Name(id='providers_root', ctx=Load()),
              List(
                elts=[
                  Constant(value='core'),
                  Constant(value='meta')],
                ctx=Load())])),
        Assert(
          test=UnaryOp(
            op=Not(),
            operand=Name(id='violations', ctx=Load())),
          msg=JoinedStr(
            values=[
              Constant(value='providers must not import core/meta: '),
              FormattedValue(
                value=Name(id='violations', ctx=Load()),
                conversion=-1)]))],
      returns=Constant(value=None))])