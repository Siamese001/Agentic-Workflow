Module(
  body=[
    Expr(
      value=Constant(value='L3 Orchestration Graph Unit Tests.')),
    ClassDef(
      name='TestL3Graphs',
      body=[
        Expr(
          value=Constant(value='Unit tests for L3 orchestration graphs.')),
        FunctionDef(
          name='test_graph_node_creation',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test graph node creation.')),
            Assign(
              targets=[
                Name(id='nodes', ctx=Store())],
              value=ListComp(
                elt=Dict(
                  keys=[
                    Constant(value='id'),
                    Constant(value='data')],
                  values=[
                    JoinedStr(
                      values=[
                        Constant(value='n'),
                        FormattedValue(
                          value=Name(id='i', ctx=Load()),
                          conversion=-1)]),
                    Dict()]),
                generators=[
                  comprehension(
                    target=Name(id='i', ctx=Store()),
                    iter=Call(
                      func=Name(id='range', ctx=Load()),
                      args=[
                        Constant(value=3)]),
                    is_async=0)])),
            Assert(
              test=Compare(
                left=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Name(id='nodes', ctx=Load())]),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value=3)]))]),
        FunctionDef(
          name='test_graph_edge_creation',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test graph edge creation.')),
            Assign(
              targets=[
                Name(id='edges', ctx=Store())],
              value=List(
                elts=[
                  Tuple(
                    elts=[
                      Constant(value='n0'),
                      Constant(value='n1')],
                    ctx=Load()),
                  Tuple(
                    elts=[
                      Constant(value='n1'),
                      Constant(value='n2')],
                    ctx=Load())],
                ctx=Load())),
            Assert(
              test=Compare(
                left=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Name(id='edges', ctx=Load())]),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value=2)]))]),
        FunctionDef(
          name='test_graph_traversal_order',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test graph traversal order.')),
            Assign(
              targets=[
                Name(id='order', ctx=Store())],
              value=List(
                elts=[
                  Constant(value='n0'),
                  Constant(value='n1'),
                  Constant(value='n2')],
                ctx=Load())),
            For(
              target=Tuple(
                elts=[
                  Name(id='i', ctx=Store()),
                  Name(id='node', ctx=Store())],
                ctx=Store()),
              iter=Call(
                func=Name(id='enumerate', ctx=Load()),
                args=[
                  Name(id='order', ctx=Load())]),
              body=[
                Assert(
                  test=Compare(
                    left=Name(id='node', ctx=Load()),
                    ops=[
                      Eq()],
                    comparators=[
                      JoinedStr(
                        values=[
                          Constant(value='n'),
                          FormattedValue(
                            value=Name(id='i', ctx=Load()),
                            conversion=-1)])]))])])])])