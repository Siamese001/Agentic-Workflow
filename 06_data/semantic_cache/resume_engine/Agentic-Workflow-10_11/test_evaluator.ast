Module(
  body=[
    ImportFrom(
      module='eval.golden_state.datasets',
      names=[
        alias(name='load_golden_cases')],
      level=0),
    ImportFrom(
      module='eval.golden_state.evaluator',
      names=[
        alias(name='evaluate_case_output')],
      level=0),
    ImportFrom(
      module='eval.golden_state.models',
      names=[
        alias(name='GoldenCase'),
        alias(name='GoldenOutput')],
      level=0),
    FunctionDef(
      name='test_evaluate_case_output_basic',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='cases', ctx=Store())],
          value=Call(
            func=Name(id='load_golden_cases', ctx=Load()))),
        Assert(
          test=Name(id='cases', ctx=Load())),
        Assign(
          targets=[
            Name(id='case', ctx=Store())],
          value=Subscript(
            value=Name(id='cases', ctx=Load()),
            slice=Constant(value=0),
            ctx=Load())),
        Assign(
          targets=[
            Name(id='output', ctx=Store())],
          value=Call(
            func=Name(id='GoldenOutput', ctx=Load()),
            keywords=[
              keyword(
                arg='case_id',
                value=Attribute(
                  value=Name(id='case', ctx=Load()),
                  attr='id',
                  ctx=Load())),
              keyword(
                arg='produced_keypoints',
                value=Call(
                  func=Name(id='list', ctx=Load()),
                  args=[
                    Attribute(
                      value=Name(id='case', ctx=Load()),
                      attr='expected_keypoints',
                      ctx=Load())])),
              keyword(arg='correctness_map', value=Dict()),
              keyword(arg='safety_decisions', value=Dict()),
              keyword(arg='metacognition_summary', value=Dict()),
              keyword(
                arg='final_verdict',
                value=Constant(value='borderline'))])),
        Assign(
          targets=[
            Name(id='evaluated', ctx=Store())],
          value=Call(
            func=Name(id='evaluate_case_output', ctx=Load()),
            args=[
              Name(id='case', ctx=Load()),
              Name(id='output', ctx=Load())])),
        Assert(
          test=Call(
            func=Name(id='isinstance', ctx=Load()),
            args=[
              Name(id='evaluated', ctx=Load()),
              Name(id='GoldenOutput', ctx=Load())])),
        Assert(
          test=Compare(
            left=Attribute(
              value=Name(id='evaluated', ctx=Load()),
              attr='final_verdict',
              ctx=Load()),
            ops=[
              In()],
            comparators=[
              Set(
                elts=[
                  Constant(value='pass'),
                  Constant(value='fail'),
                  Constant(value='borderline')])]))])])