Module(
  body=[
    Expr(
      value=Constant(value='Integration Tests for Security and Injection Detection\n\nTests integration between injection detection, dependency injection,\nand V6 prompt systems to ensure end-to-end security flows work correctly.\n')),
    Import(
      names=[
        alias(name='pytest')]),
    ImportFrom(
      module='unittest.mock',
      names=[
        alias(name='Mock')],
      level=0),
    ImportFrom(
      module='datetime',
      names=[
        alias(name='datetime')],
      level=0),
    ImportFrom(
      module='l5.injection_detection',
      names=[
        alias(name='InjectionDetector'),
