Module(
  body=[
    ImportFrom(
      module='infra.sandbox.models',
      names=[
        alias(name='ToolCallRequest'),
        alias(name='ToolCallResult'),
        alias(name='SandboxEvent')],
      level=0),
    FunctionDef(
      name='test_tool_call_request_defaults',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='req', ctx=Store())],
          value=Call(
            func=Name(id='ToolCallRequest', ctx=Load()),
            keywords=[
              keyword(
                arg='tool_name',
                value=Constant(value='echo'))])),
        Assert(
          test=Compare(
            left=Attribute(
              value=Name(id='req', ctx=Load()),
              attr='tool_name',
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value='echo')])),
        Assert(
          test=Compare(
            left=Attribute(
              value=Name(id='req', ctx=Load()),
              attr='args',
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              List(ctx=Load())])),
        Assert(
          test=Call(
            func=Name(id='isinstance', ctx=Load()),
            args=[
              Attribute(
                value=Name(id='req', ctx=Load()),
                attr='env',
                ctx=Load()),
              Name(id='dict', ctx=Load())])),
        Assert(
          test=Compare(
            left=Attribute(
              value=Name(id='req', ctx=Load()),
              attr='timeout_s',
              ctx=Load()),
            ops=[
              Gt()],
            comparators=[
              Constant(value=0)]))]),
    FunctionDef(
      name='test_tool_call_result_defaults',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='res', ctx=Store())],
          value=Call(
            func=Name(id='ToolCallResult', ctx=Load()),
            keywords=[
              keyword(
                arg='success',
                value=Constant(value=True))])),
        Assert(
          test=Compare(
            left=Attribute(
              value=Name(id='res', ctx=Load()),
              attr='success',
              ctx=Load()),
            ops=[
              Is()],
            comparators=[
              Constant(value=True)])),
        Assert(
          test=Compare(
            left=Attribute(
              value=Name(id='res', ctx=Load()),
              attr='exit_code',
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value=0)]))]),
    FunctionDef(
      name='test_sandbox_event_structure',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='evt', ctx=Store())],
          value=Call(
            func=Name(id='SandboxEvent', ctx=Load()),
            keywords=[
              keyword(
                arg='name',
                value=Constant(value='sandbox_start')),
              keyword(
                arg='ts_ms',
                value=Constant(value=1234)),
              keyword(
                arg='vm_id',
                value=Constant(value='vm1')),
              keyword(
                arg='tool_name',
                value=Constant(value=None))])),
        Assert(
          test=Compare(
            left=Attribute(
              value=Name(id='evt', ctx=Load()),
              attr='name',
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value='sandbox_start')])),
        Assert(
          test=Compare(
            left=Attribute(
              value=Name(id='evt', ctx=Load()),
              attr='ts_ms',
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value=1234)])),
        Assert(
          test=Compare(
            left=Attribute(
              value=Name(id='evt', ctx=Load()),
              attr='vm_id',
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value='vm1')]))])])