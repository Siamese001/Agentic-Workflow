        ImportFrom(
          module='config.config_profiles_v10_10',
          names=[
            alias(name='ExecutionProfileSpec'),
            alias(name='get_profile')],
          level=0),
        ImportFrom(
          module='config.meta_profile',
          names=[
            alias(name='MetaProfileSnapshot')],
          level=0)],
      handlers=[
        ExceptHandler(
          type=Name(id='ImportError', ctx=Load()),
          body=[
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='pytest', ctx=Load()),
                  attr='skip',
                  ctx=Load()),
                args=[
                  Constant(value='Workflow planning components not available')],
                keywords=[
                  keyword(
                    arg='allow_module_level',
                    value=Constant(value=True))]))])]),
    Assign(
      targets=[
        Name(id='pytestmark', ctx=Store())],
      value=List(
        elts=[
          Attribute(
