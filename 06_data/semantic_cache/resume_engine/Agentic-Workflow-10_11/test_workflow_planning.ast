        FunctionDef(
          name='test_normalize_text_basic',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test basic text normalization.')),
            Assign(
              targets=[
                Name(id='dirty_text', ctx=Store())],
              value=Constant(value='  Hello   World!  \n\n  This   has   extra   spaces.  ')),
            Assign(
              targets=[
                Name(id='normalized', ctx=Store())],
              value=Call(
                func=Name(id='_normalize_text', ctx=Load()),
                args=[
                  Name(id='dirty_text', ctx=Load())])),
            Assert(
              test=Compare(
                left=Name(id='normalized', ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value='Hello   World!  \n\n  This   has   extra   spaces.')])),
            Assert(
              test=UnaryOp(
                op=Not(),
                operand=Call(
                  func=Attribute(
                    value=Name(id='normalized', ctx=Load()),
                    attr='startswith',
                    ctx=Load()),
                  args=[
                    Constant(value=' ')]))),
            Assert(
              test=UnaryOp(
                op=Not(),
                operand=Call(
                  func=Attribute(
                    value=Name(id='normalized', ctx=Load()),
                    attr='endswith',
                    ctx=Load()),
                  args=[
                    Constant(value=' ')])))]),
