Module(
  body=[
    ImportFrom(
      module='infra.sandbox.models',
      names=[
        alias(name='ToolCallRequest')],
      level=0),
    ImportFrom(
      module='infra.sandbox.vm_manager',
      names=[
        alias(name='run_in_ephemeral_vm')],
      level=0),
    FunctionDef(
      name='test_run_in_ephemeral_vm_basic',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='req', ctx=Store())],
          value=Call(
            func=Name(id='ToolCallRequest', ctx=Load()),
            keywords=[
              keyword(
                arg='tool_name',
                value=Constant(value='echo')),
              keyword(
                arg='args',
                value=List(
                  elts=[
                    Constant(value='x')],
                  ctx=Load())),
              keyword(
                arg='timeout_s',
                value=Constant(value=1.0))])),
        Assign(
          targets=[
            Name(id='result', ctx=Store())],
          value=Call(
            func=Name(id='run_in_ephemeral_vm', ctx=Load()),
            args=[
              Name(id='req', ctx=Load())],
            keywords=[
              keyword(
                arg='resource_limits',
                value=Dict(
                  keys=[
                    Constant(value='memory_mb')],
                  values=[
                    Constant(value=64)]))])),
        Assert(
          test=Compare(
            left=Attribute(
              value=Name(id='result', ctx=Load()),
              attr='success',
              ctx=Load()),
            ops=[
              Is()],
            comparators=[
              Constant(value=True)])),
        Assert(
          test=Compare(
            left=Attribute(
              value=Name(id='result', ctx=Load()),
              attr='exit_code',
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value=0)])),
        Assert(
          test=Compare(
            left=Constant(value='TOOL echo'),
            ops=[
              In()],
            comparators=[
              Attribute(
                value=Name(id='result', ctx=Load()),
                attr='stdout',
                ctx=Load())]))])])