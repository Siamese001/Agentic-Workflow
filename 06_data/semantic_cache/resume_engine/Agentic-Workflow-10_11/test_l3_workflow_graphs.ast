Module(
  body=[
    Expr(
      value=Constant(value='L3 Orchestration Workflow Graphs Tests.')),
    ClassDef(
      name='TestL3WorkflowGraphs',
      body=[
        Expr(
          value=Constant(value='Tests for L3 workflow graphs.')),
        FunctionDef(
          name='test_workflow_graph_construction',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test workflow graph construction.')),
            Assign(
              targets=[
                Name(id='nodes', ctx=Store())],
              value=List(
                elts=[
                  Constant(value='start'),
                  Constant(value='process'),
                  Constant(value='end')],
                ctx=Load())),
            Assign(
              targets=[
                Name(id='edges', ctx=Store())],
              value=List(
                elts=[
                  Tuple(
                    elts=[
                      Constant(value='start'),
                      Constant(value='process')],
                    ctx=Load()),
                  Tuple(
                    elts=[
                      Constant(value='process'),
                      Constant(value='end')],
                    ctx=Load())],
                ctx=Load())),
            Assert(
              test=Compare(
                left=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Name(id='nodes', ctx=Load())]),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value=3)])),
            Assert(
              test=Compare(
                left=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Name(id='edges', ctx=Load())]),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value=2)]))]),
        FunctionDef(
          name='test_workflow_graph_validation',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test workflow graph validation.')),
            Assign(
              targets=[
                Name(id='graph', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='nodes'),
                  Constant(value='edges'),
                  Constant(value='valid')],
                values=[
                  Constant(value=3),
                  Constant(value=2),
                  Constant(value=True)])),
            Assert(
              test=Compare(
                left=Subscript(
                  value=Name(id='graph', ctx=Load()),
                  slice=Constant(value='valid'),
                  ctx=Load()),
                ops=[
                  Is()],
                comparators=[
                  Constant(value=True)]))]),
        FunctionDef(
          name='test_workflow_graph_execution',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test workflow graph execution.')),
            Assign(
              targets=[
                Name(id='executed_nodes', ctx=Store())],
              value=List(ctx=Load())),
            For(
              target=Name(id='node', ctx=Store()),
              iter=List(
                elts=[
                  Constant(value='a'),
                  Constant(value='b'),
                  Constant(value='c')],
                ctx=Load()),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='executed_nodes', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Name(id='node', ctx=Load())]))]),
            Assert(
              test=Compare(
                left=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Name(id='executed_nodes', ctx=Load())]),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value=3)]))])])])