              arg(
                arg='top_k',
                annotation=Name(id='int', ctx=Load()))],
            kwarg=arg(
              arg='kwargs',
              annotation=Name(id='Any', ctx=Load())),
            defaults=[
              Constant(value=5)]),
          body=[
            Expr(
              value=Constant(value='Query the vector database for similar vectors.\n        \n        Args:\n            namespace: The namespace to query\n            vector: Query vector\n            top_k: Number of results to return\n            **kwargs: Additional query parameters\n            \n        Returns:\n            List of matching vectors with scores and metadata\n        ')),
            Assign(
              targets=[
                Name(id='results', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='index',
