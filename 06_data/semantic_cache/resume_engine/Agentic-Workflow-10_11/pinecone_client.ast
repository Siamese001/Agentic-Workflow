                        attr='getenv',
                        ctx=Load()),
                      args=[
                        Constant(value='OPENAI_API_KEY')]))]))]),
        FunctionDef(
          name='upsert',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='namespace',
                annotation=Name(id='str', ctx=Load())),
              arg(
