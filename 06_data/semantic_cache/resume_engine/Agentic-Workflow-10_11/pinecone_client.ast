                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Initialize the Pinecone client.\n        \n        Args:\n            api_key: Pinecone API key\n            index_name: Name of the Pinecone index to use\n        ')),
            Assign(
              targets=[
