                  attr='query',
                  ctx=Load()),
                keywords=[
                  keyword(
                    arg='vector',
                    value=Name(id='vector', ctx=Load())),
                  keyword(
                    arg='top_k',
                    value=Name(id='top_k', ctx=Load())),
                  keyword(
                    arg='namespace',
                    value=Name(id='namespace', ctx=Load())),
                  keyword(
                    arg='include_metadata',
                    value=Constant(value=True)),
                  keyword(
                    value=Name(id='kwargs', ctx=Load()))])),
            If(
              test=Call(
                func=Name(id='hasattr', ctx=Load()),
                args=[
                  Name(id='results', ctx=Load()),
                  Constant(value='matches')]),
              body=[
                Return(
