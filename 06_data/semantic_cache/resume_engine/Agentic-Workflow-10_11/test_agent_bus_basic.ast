Module(
  body=[
    ImportFrom(
      module='orchestration.agent_bus',
      names=[
        alias(name='AgentBus')],
      level=0),
    ImportFrom(
      module='core.models.models',
      names=[
        alias(name='AgentMessage')],
      level=0),
    FunctionDef(
      name='test_agent_bus_send_and_get',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='bus', ctx=Store())],
          value=Call(
            func=Name(id='AgentBus', ctx=Load()))),
        Assign(
          targets=[
            Name(id='msg', ctx=Store())],
          value=Call(
            func=Name(id='AgentMessage', ctx=Load()),
            keywords=[
              keyword(
                arg='message_id',
                value=Constant(value='m1')),
              keyword(
                arg='source_agent_id',
                value=Constant(value='planner-1')),
              keyword(
                arg='target_agent_id',
                value=Constant(value='qa-1')),
              keyword(
                arg='channel',
                value=Constant(value='test')),
              keyword(
                arg='payload_type',
                value=Constant(value='request')),
              keyword(
                arg='content',
                value=Dict(
                  keys=[
                    Constant(value='x')],
                  values=[
                    Constant(value=1)]))])),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='bus', ctx=Load()),
              attr='send',
              ctx=Load()),
            args=[
              Name(id='msg', ctx=Load())])),
        Assign(
          targets=[
            Name(id='inbox', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='bus', ctx=Load()),
              attr='get_for',
              ctx=Load()),
            args=[
              Constant(value='qa-1')])),
        Assert(
          test=Compare(
            left=Name(id='msg', ctx=Load()),
            ops=[
              In()],
            comparators=[
              Name(id='inbox', ctx=Load())])),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='bus', ctx=Load()),
              attr='clear',
              ctx=Load()))),
        Assert(
          test=Compare(
            left=Call(
              func=Attribute(
                value=Name(id='bus', ctx=Load()),
                attr='get_for',
                ctx=Load()),
              args=[
                Constant(value='qa-1')]),
            ops=[
              Eq()],
            comparators=[
              List(ctx=Load())]))])])