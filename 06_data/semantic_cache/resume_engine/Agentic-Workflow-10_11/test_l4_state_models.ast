Module(
  body=[
    Expr(
      value=Constant(value='L4 Memory State Models Tests.')),
    ClassDef(
      name='TestL4StateModels',
      body=[
        Expr(
          value=Constant(value='Tests for L4 state models.')),
        FunctionDef(
          name='test_triplet_model',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test triplet model structure.')),
            Assign(
              targets=[
                Name(id='triplet', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='subject'),
                  Constant(value='predicate'),
                  Constant(value='object')],
                values=[
                  Constant(value='entity1'),
                  Constant(value='relates_to'),
                  Constant(value='entity2')])),
            Assert(
              test=Compare(
                left=Subscript(
                  value=Name(id='triplet', ctx=Load()),
                  slice=Constant(value='predicate'),
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value='relates_to')]))]),
        FunctionDef(
          name='test_entity_model',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test entity model structure.')),
            Assign(
              targets=[
                Name(id='entity', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='id'),
                  Constant(value='type'),
                  Constant(value='value')],
                values=[
                  Constant(value='e1'),
                  Constant(value='skill'),
                  Constant(value='Python')])),
            Assert(
              test=Compare(
                left=Subscript(
                  value=Name(id='entity', ctx=Load()),
                  slice=Constant(value='type'),
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value='skill')]))]),
        FunctionDef(
          name='test_relationship_model',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test relationship model structure.')),
            Assign(
              targets=[
                Name(id='rel', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='from'),
                  Constant(value='to'),
                  Constant(value='type')],
                values=[
                  Constant(value='e1'),
                  Constant(value='e2'),
                  Constant(value='has_skill')])),
            Assert(
              test=Compare(
                left=Subscript(
                  value=Name(id='rel', ctx=Load()),
                  slice=Constant(value='type'),
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value='has_skill')]))])])])