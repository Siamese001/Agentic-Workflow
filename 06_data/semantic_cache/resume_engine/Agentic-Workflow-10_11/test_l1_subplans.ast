Module(
  body=[
    Expr(
      value=Constant(value='L1 Planning Subplans Tests.')),
    ClassDef(
      name='TestL1Subplans',
      body=[
        Expr(
          value=Constant(value='Tests for L1 planning subplans.')),
        FunctionDef(
          name='test_rag_subplan_creation',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test RAG subplan creation.')),
            Assign(
              targets=[
                Name(id='subplan', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='strategy'),
                  Constant(value='max_hits')],
                values=[
                  Constant(value='hybrid'),
                  Constant(value=16)])),
            Assert(
              test=Compare(
                left=Subscript(
                  value=Name(id='subplan', ctx=Load()),
                  slice=Constant(value='strategy'),
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value='hybrid')]))]),
        FunctionDef(
          name='test_drafting_subplan_creation',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test drafting subplan creation.')),
            Assign(
              targets=[
                Name(id='sections', ctx=Store())],
              value=List(
                elts=[
                  Constant(value='summary'),
                  Constant(value='experience'),
                  Constant(value='skills')],
                ctx=Load())),
            Assert(
              test=Compare(
                left=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Name(id='sections', ctx=Load())]),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value=3)]))]),
        FunctionDef(
          name='test_qa_subplan_creation',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test QA subplan creation.')),
            Assign(
              targets=[
                Name(id='qa_config', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='depth'),
                  Constant(value='council_size')],
                values=[
                  Constant(value=2),
                  Constant(value=3)])),
            Assert(
              test=Compare(
                left=Subscript(
                  value=Name(id='qa_config', ctx=Load()),
                  slice=Constant(value='depth'),
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value=2)]))])])])