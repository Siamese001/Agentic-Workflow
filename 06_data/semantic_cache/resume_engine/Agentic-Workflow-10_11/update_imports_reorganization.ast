          value=Constant(value='Fix imports in a single file. Returns True if changes were made.')),
        Try(
          body=[
            With(
              items=[
                withitem(
                  context_expr=Call(
                    func=Name(id='open', ctx=Load()),
                    args=[
                      Name(id='filepath', ctx=Load()),
                      Constant(value='r')],
                    keywords=[
                      keyword(
