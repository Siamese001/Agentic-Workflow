Module(
  body=[
    Expr(
      value=Constant(value='L2 Execution Unit Tests - Core.')),
    ClassDef(
      name='TestL2ExecutionUnitCore',
      body=[
        Expr(
          value=Constant(value='Core unit tests for L2 execution layer.')),
        FunctionDef(
          name='test_tool_executor_initialization',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test tool executor initialization.')),
            Assign(
              targets=[
                Name(id='executor', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='name'),
                  Constant(value='ready')],
                values=[
                  Constant(value='tool_executor'),
                  Constant(value=True)])),
            Assert(
              test=Compare(
                left=Subscript(
                  value=Name(id='executor', ctx=Load()),
                  slice=Constant(value='ready'),
                  ctx=Load()),
                ops=[
                  Is()],
                comparators=[
                  Constant(value=True)]))]),
        FunctionDef(
          name='test_execution_context_creation',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test execution context creation.')),
            Assign(
              targets=[
                Name(id='ctx', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='user_id'),
                  Constant(value='session_id')],
                values=[
                  Constant(value='u1'),
                  Constant(value='s1')])),
            Assert(
              test=Compare(
                left=Subscript(
                  value=Name(id='ctx', ctx=Load()),
                  slice=Constant(value='user_id'),
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value='u1')]))]),
        FunctionDef(
          name='test_result_aggregation',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test result aggregation logic.')),
            Assign(
              targets=[
                Name(id='results', ctx=Store())],
              value=List(
                elts=[
                  Dict(
                    keys=[
                      Constant(value='score')],
                    values=[
                      Constant(value=0.8)]),
                  Dict(
                    keys=[
                      Constant(value='score')],
                    values=[
                      Constant(value=0.9)])],
                ctx=Load())),
            Assign(
              targets=[
                Name(id='avg', ctx=Store())],
              value=BinOp(
                left=Call(
                  func=Name(id='sum', ctx=Load()),
                  args=[
                    GeneratorExp(
                      elt=Subscript(
                        value=Name(id='r', ctx=Load()),
                        slice=Constant(value='score'),
                        ctx=Load()),
                      generators=[
                        comprehension(
                          target=Name(id='r', ctx=Store()),
                          iter=Name(id='results', ctx=Load()),
                          is_async=0)])]),
                op=Div(),
                right=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Name(id='results', ctx=Load())]))),
            Assert(
              test=Compare(
                left=Call(
                  func=Name(id='abs', ctx=Load()),
                  args=[
                    BinOp(
                      left=Name(id='avg', ctx=Load()),
                      op=Sub(),
                      right=Constant(value=0.85))]),
                ops=[
                  Lt()],
                comparators=[
                  Constant(value=0.001)]))])])])