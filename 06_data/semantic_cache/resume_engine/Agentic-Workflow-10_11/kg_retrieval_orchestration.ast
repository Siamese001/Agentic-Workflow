    ClassDef(
      name='KGFirstRetrievalOrchestrator',
      body=[
        Expr(
          value=Constant(value='Orchestrator for KG-first hybrid retrieval.\n    \n    This orchestrator builds and executes retrieval DAGs that:\n    1. First query the Knowledge Graph for structured facts\n    2. Use KG entities to enhance vector search\n    3. Fuse results with weighted combination\n    4. Optionally rerank for relevance\n    ')),
        FunctionDef(
          name='__init__',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='kg_planner',
                annotation=Subscript(
                  value=Name(id='Optional', ctx=Load()),
                  slice=Name(id='Any', ctx=Load()),
                  ctx=Load())),
              arg(
                arg='kg_executor',
                annotation=Subscript(
                  value=Name(id='Optional', ctx=Load()),
                  slice=Name(id='Any', ctx=Load()),
                  ctx=Load())),
              arg(
                arg='vector_executor',
                annotation=Subscript(
                  value=Name(id='Optional', ctx=Load()),
                  slice=Name(id='Any', ctx=Load()),
                  ctx=Load()))],
            defaults=[
              Constant(value=None),
              Constant(value=None),
              Constant(value=None)]),
          body=[
            Expr(
              value=Constant(value='Initialize orchestrator.\n        \n        Args:\n            kg_planner: L1 KG retrieval planner\n            kg_executor: L2 KG retrieval executor\n            vector_executor: L2 vector search executor\n        ')),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='kg_planner',
                  ctx=Store())],
              value=Name(id='kg_planner', ctx=Load())),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='kg_executor',
                  ctx=Store())],
              value=Name(id='kg_executor', ctx=Load())),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='vector_executor',
                  ctx=Store())],
              value=Name(id='vector_executor', ctx=Load()))]),
        FunctionDef(
          name='build_dag',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='context',
                annotation=Name(id='HybridRetrievalContext', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Build a retrieval DAG for the given context.\n        \n        Args:\n            context: Retrieval context\n            \n        Returns:\n            RetrievalDAG ready for execution\n        ')),
            Assign(
              targets=[
                Name(id='dag_id', ctx=Store())],
              value=JoinedStr(
                values=[
                  Constant(value='retrieval_dag_'),
                  FormattedValue(
                    value=Call(
                      func=Attribute(
                        value=Call(
                          func=Attribute(
                            value=Name(id='datetime', ctx=Load()),
                            attr='now',
                            ctx=Load()),
                          args=[
                            Name(id='UTC', ctx=Load())]),
                        attr='strftime',
                        ctx=Load()),
                      args=[
                        Constant(value='%Y%m%d%H%M%S%f')]),
                    conversion=-1)])),
            Assign(
              targets=[
                Name(id='dag', ctx=Store())],
              value=Call(
                func=Name(id='RetrievalDAG', ctx=Load()),
                keywords=[
                  keyword(
                    arg='dag_id',
                    value=Name(id='dag_id', ctx=Load())),
                  keyword(arg='nodes', value=Dict())])),
            Assign(
              targets=[
                Name(id='kg_node', ctx=Store())],
              value=Call(
                func=Name(id='RetrievalNode', ctx=Load()),
                keywords=[
                  keyword(
                    arg='node_id',
                    value=Constant(value='kg_query')),
                  keyword(
                    arg='stage',
                    value=Attribute(
                      value=Name(id='RetrievalStage', ctx=Load()),
                      attr='KG_QUERY',
                      ctx=Load())),
                  keyword(
                    arg='config',
                    value=Dict(
                      keys=[
                        Constant(value='entities'),
                        Constant(value='predicates'),
                        Constant(value='max_hops'),
                        Constant(value='temporal_constraint')],
                      values=[
                        Attribute(
                          value=Name(id='context', ctx=Load()),
                          attr='kg_entities',
                          ctx=Load()),
                        Attribute(
                          value=Name(id='context', ctx=Load()),
                          attr='kg_predicates',
                          ctx=Load()),
                        Attribute(
                          value=Name(id='context', ctx=Load()),
                          attr='kg_max_hops',
                          ctx=Load()),
                        Attribute(
                          value=Name(id='context', ctx=Load()),
                          attr='temporal_constraint',
                          ctx=Load())]))])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='dag', ctx=Load()),
                  attr='add_node',
                  ctx=Load()),
                args=[
                  Name(id='kg_node', ctx=Load())])),
            Assign(
              targets=[
                Name(id='vector_node', ctx=Store())],
              value=Call(
                func=Name(id='RetrievalNode', ctx=Load()),
                keywords=[
                  keyword(
                    arg='node_id',
                    value=Constant(value='vector_search')),
                  keyword(
                    arg='stage',
                    value=Attribute(
                      value=Name(id='RetrievalStage', ctx=Load()),
                      attr='VECTOR_SEARCH',
                      ctx=Load())),
                  keyword(
                    arg='config',
                    value=Dict(
                      keys=[
                        Constant(value='query'),
                        Constant(value='namespace'),
                        Constant(value='top_k')],
                      values=[
                        Attribute(
                          value=Name(id='context', ctx=Load()),
                          attr='query',
                          ctx=Load()),
                        Attribute(
                          value=Name(id='context', ctx=Load()),
                          attr='vector_namespace',
                          ctx=Load()),
                        Attribute(
                          value=Name(id='context', ctx=Load()),
                          attr='vector_top_k',
                          ctx=Load())]))])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='dag', ctx=Load()),
                  attr='add_node',
                  ctx=Load()),
                args=[
                  Name(id='vector_node', ctx=Load())])),
            Assign(
              targets=[
                Name(id='enhanced_vector_node', ctx=Store())],
              value=Call(
                func=Name(id='RetrievalNode', ctx=Load()),
                keywords=[
                  keyword(
                    arg='node_id',
                    value=Constant(value='enhanced_vector_search')),
                  keyword(
                    arg='stage',
                    value=Attribute(
                      value=Name(id='RetrievalStage', ctx=Load()),
                      attr='VECTOR_SEARCH',
                      ctx=Load())),
                  keyword(
                    arg='depends_on',
                    value=List(
                      elts=[
                        Constant(value='kg_query')],
                      ctx=Load())),
                  keyword(
                    arg='config',
                    value=Dict(
                      keys=[
                        Constant(value='query'),
                        Constant(value='namespace'),
                        Constant(value='top_k'),
                        Constant(value='use_kg_entities')],
                      values=[
                        Attribute(
                          value=Name(id='context', ctx=Load()),
                          attr='query',
                          ctx=Load()),
                        Attribute(
                          value=Name(id='context', ctx=Load()),
                          attr='vector_namespace',
                          ctx=Load()),
                        Attribute(
                          value=Name(id='context', ctx=Load()),
                          attr='vector_top_k',
                          ctx=Load()),
                        Constant(value=True)]))])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='dag', ctx=Load()),
                  attr='add_node',
                  ctx=Load()),
                args=[
                  Name(id='enhanced_vector_node', ctx=Load())])),
            Assign(
              targets=[
                Name(id='fusion_node', ctx=Store())],
              value=Call(
                func=Name(id='RetrievalNode', ctx=Load()),
                keywords=[
                  keyword(
                    arg='node_id',
                    value=Constant(value='fusion')),
                  keyword(
                    arg='stage',
                    value=Attribute(
                      value=Name(id='RetrievalStage', ctx=Load()),
                      attr='FUSION',
                      ctx=Load())),
                  keyword(
                    arg='depends_on',
                    value=List(
                      elts=[
                        Constant(value='kg_query'),
                        Constant(value='vector_search'),
                        Constant(value='enhanced_vector_search')],
                      ctx=Load())),
                  keyword(
                    arg='config',
                    value=Dict(
                      keys=[
                        Constant(value='kg_weight'),
                        Constant(value='vector_weight'),
                        Constant(value='min_score')],
                      values=[
                        Attribute(
                          value=Name(id='context', ctx=Load()),
                          attr='kg_weight',
                          ctx=Load()),
                        Attribute(
                          value=Name(id='context', ctx=Load()),
                          attr='vector_weight',
                          ctx=Load()),
                        Attribute(
                          value=Name(id='context', ctx=Load()),
                          attr='min_score',
                          ctx=Load())]))])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='dag', ctx=Load()),
                  attr='add_node',
                  ctx=Load()),
                args=[
                  Name(id='fusion_node', ctx=Load())])),
            Assign(
              targets=[
                Name(id='filter_node', ctx=Store())],
              value=Call(
                func=Name(id='RetrievalNode', ctx=Load()),
                keywords=[
                  keyword(
                    arg='node_id',
                    value=Constant(value='filtering')),
                  keyword(
                    arg='stage',
                    value=Attribute(
                      value=Name(id='RetrievalStage', ctx=Load()),
                      attr='FILTERING',
                      ctx=Load())),
                  keyword(
                    arg='depends_on',
                    value=List(
                      elts=[
                        Constant(value='fusion')],
                      ctx=Load())),
                  keyword(
                    arg='config',
                    value=Dict(
                      keys=[
                        Constant(value='min_score'),
                        Constant(value='deduplicate')],
                      values=[
                        Attribute(
                          value=Name(id='context', ctx=Load()),
                          attr='min_score',
                          ctx=Load()),
                        Constant(value=True)]))])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='dag', ctx=Load()),
                  attr='add_node',
                  ctx=Load()),
                args=[
                  Name(id='filter_node', ctx=Load())])),
            Return(
              value=Name(id='dag', ctx=Load()))],
