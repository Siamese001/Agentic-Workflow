                      attr='add',
                      ctx=Load()),
                    args=[
                      Name(id='node_id', ctx=Load())])),
                Assign(
                  targets=[
                    Name(id='node', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='nodes',
                        ctx=Load()),
                      attr='get',
                      ctx=Load()),
                    args=[
                      Name(id='node_id', ctx=Load())])),
                If(
                  test=Name(id='node', ctx=Load()),
                  body=[
                    For(
                      target=Name(id='dep', ctx=Store()),
                      iter=Attribute(
                        value=Name(id='node', ctx=Load()),
                        attr='depends_on',
                        ctx=Load()),
                      body=[
                        Expr(
                          value=Call(
                            func=Name(id='visit', ctx=Load()),
                            args=[
                              Name(id='dep', ctx=Load())]))]),
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Name(id='order', ctx=Load()),
                          attr='append',
                          ctx=Load()),
                        args=[
                          Name(id='node_id', ctx=Load())]))])],
              returns=Constant(value=None)),
            For(
              target=Name(id='node_id', ctx=Store()),
              iter=Attribute(
                value=Name(id='self', ctx=Load()),
                attr='nodes',
                ctx=Load()),
              body=[
                Expr(
                  value=Call(
                    func=Name(id='visit', ctx=Load()),
                    args=[
                      Name(id='node_id', ctx=Load())]))]),
            Return(
              value=Name(id='order', ctx=Load()))],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load()))],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
