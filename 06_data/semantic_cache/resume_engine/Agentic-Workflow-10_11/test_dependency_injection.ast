                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='ctx',
                    ctx=Load()),
                  attr='session_id',
                  ctx=Store())],
              value=Constant(value='test_session')),
            For(
              target=Name(id='attr', ctx=Store()),
              iter=List(
                elts=[
                  Constant(value='pinecone_adapter'),
                  Constant(value='safety_engine'),
                  Constant(value='state_manager')],
                ctx=Load()),
              body=[
                If(
                  test=Call(
                    func=Name(id='hasattr', ctx=Load()),
                    args=[
                      Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='ctx',
                        ctx=Load()),
                      Name(id='attr', ctx=Load())]),
                  body=[
                    Expr(
                      value=Call(
                        func=Name(id='delattr', ctx=Load()),
                        args=[
                          Attribute(
                            value=Name(id='self', ctx=Load()),
                            attr='ctx',
                            ctx=Load()),
                          Name(id='attr', ctx=Load())]))])])]),
        FunctionDef(
          name='test_inject_dependencies_adds_services',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test that inject_dependencies adds services to context.')),
            Assert(
              test=UnaryOp(
                op=Not(),
                operand=Call(
                  func=Name(id='hasattr', ctx=Load()),
                  args=[
                    Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='ctx',
                      ctx=Load()),
                    Constant(value='pinecone_adapter')]))),
            Assert(
              test=UnaryOp(
                op=Not(),
                operand=Call(
                  func=Name(id='hasattr', ctx=Load()),
                  args=[
                    Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='ctx',
                      ctx=Load()),
                    Constant(value='safety_engine')]))),
            Assign(
              targets=[
                Name(id='updated_ctx', ctx=Store())],
              value=Call(
                func=Name(id='inject_dependencies', ctx=Load()),
                args=[
                  Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='ctx',
                    ctx=Load())])),
            Assert(
              test=Call(
                func=Name(id='hasattr', ctx=Load()),
                args=[
                  Name(id='updated_ctx', ctx=Load()),
                  Constant(value='pinecone_adapter')])),
            Assert(
              test=Call(
                func=Name(id='hasattr', ctx=Load()),
                args=[
                  Name(id='updated_ctx', ctx=Load()),
                  Constant(value='safety_engine')])),
            Assert(
              test=Call(
                func=Name(id='isinstance', ctx=Load()),
                args=[
                  Attribute(
                    value=Name(id='updated_ctx', ctx=Load()),
                    attr='pinecone_adapter',
                    ctx=Load()),
                  Name(id='PineconeAdapter', ctx=Load())])),
            Assert(
              test=Call(
                func=Name(id='isinstance', ctx=Load()),
                args=[
                  Attribute(
                    value=Name(id='updated_ctx', ctx=Load()),
                    attr='safety_engine',
                    ctx=Load()),
                  Name(id='SafetyEngine', ctx=Load())]))]),
        FunctionDef(
          name='test_inject_dependencies_preserves_existing',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test that inject_dependencies preserves existing services.')),
            Assign(
              targets=[
                Name(id='existing_adapter', ctx=Store())],
              value=Call(
                func=Name(id='Mock', ctx=Load()),
                keywords=[
                  keyword(
                    arg='spec',
                    value=Name(id='PineconeAdapter', ctx=Load()))])),
            Assign(
              targets=[
                Attribute(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='ctx',
                    ctx=Load()),
                  attr='pinecone_adapter',
                  ctx=Store())],
              value=Name(id='existing_adapter', ctx=Load())),
            Assign(
              targets=[
                Name(id='updated_ctx', ctx=Store())],
              value=Call(
                func=Name(id='inject_dependencies', ctx=Load()),
                args=[
                  Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='ctx',
                    ctx=Load())])),
            Assert(
              test=Compare(
