                  attr='pinecone_adapter',
                  ctx=Load()),
                ops=[
                  Is()],
                comparators=[
                  Name(id='existing_adapter', ctx=Load())])),
            Assert(
              test=Call(
                func=Name(id='hasattr', ctx=Load()),
                args=[
                  Name(id='updated_ctx', ctx=Load()),
                  Constant(value='safety_engine')]))])]),
    ClassDef(
      name='TestLayerDIIntegration',
      body=[
