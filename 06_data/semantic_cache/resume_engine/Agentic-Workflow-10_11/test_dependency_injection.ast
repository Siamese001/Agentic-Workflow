                    func=Name(id='getattr', ctx=Load()),
                    args=[
                      Name(id='engine', ctx=Load()),
                      Constant(value='evaluate')])]))])]),
    ClassDef(
      name='TestDIAtomicityCompliance',
      body=[
        Expr(
          value=Constant(value='Test that DI maintains L1-L5 atomicity constraints.')),
        FunctionDef(
          name='test_no_direct_imports_in_l2',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value="Test that L2 doesn't directly import services.")),
            Import(
              names=[
                alias(name='l2.execution')]),
            Assign(
              targets=[
                Name(id='source_lines', ctx=Store())],
              value=List(ctx=Load())),
            Try(
              body=[
                With(
                  items=[
                    withitem(
                      context_expr=Call(
                        func=Name(id='open', ctx=Load()),
                        args=[
                          Constant(value='l2/execution.py'),
                          Constant(value='r')]),
                      optional_vars=Name(id='f', ctx=Store()))],
                  body=[
                    Assign(
                      targets=[
                        Name(id='source_lines', ctx=Store())],
                      value=Call(
                        func=Attribute(
                          value=Name(id='f', ctx=Load()),
                          attr='readlines',
                          ctx=Load())))])],
              handlers=[
                ExceptHandler(
                  type=Name(id='FileNotFoundError', ctx=Load()),
                  body=[
                    Return()])]),
            Assign(
              targets=[
                Name(id='source', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Constant(value=''),
                  attr='join',
                  ctx=Load()),
                args=[
                  Name(id='source_lines', ctx=Load())])),
            Assert(
              test=Compare(
                left=Constant(value='from infra.di_container import'),
                ops=[
                  In()],
                comparators=[
                  Name(id='source', ctx=Load())])),
            Assign(
              targets=[
                Name(id='business_logic_imports', ctx=Store())],
              value=List(
                elts=[
                  Constant(value='from pinecone import'),
                  Constant(value='import pinecone')],
                ctx=Load())),
            For(
              target=Name(id='imp', ctx=Store()),
              iter=Name(id='business_logic_imports', ctx=Load()),
              body=[
                Assign(
                  targets=[
                    Name(id='lines_with_imp', ctx=Store())],
                  value=ListComp(
                    elt=Name(id='line', ctx=Load()),
                    generators=[
                      comprehension(
                        target=Name(id='line', ctx=Store()),
                        iter=Name(id='source_lines', ctx=Load()),
                        ifs=[
                          BoolOp(
                            op=And(),
                            values=[
                              Compare(
                                left=Name(id='imp', ctx=Load()),
                                ops=[
                                  In()],
                                comparators=[
                                  Name(id='line', ctx=Load())]),
                              UnaryOp(
                                op=Not(),
                                operand=Call(
                                  func=Attribute(
                                    value=Call(
                                      func=Attribute(
                                        value=Name(id='line', ctx=Load()),
                                        attr='strip',
                                        ctx=Load())),
                                    attr='startswith',
                                    ctx=Load()),
                                  args=[
                                    Constant(value='#')]))])],
                        is_async=0)])),
                Assert(
                  test=Compare(
                    left=Call(
                      func=Name(id='len', ctx=Load()),
                      args=[
                        Name(id='lines_with_imp', ctx=Load())]),
                    ops=[
                      Eq()],
                    comparators=[
                      Constant(value=0)]),
                  msg=JoinedStr(
                    values=[
                      Constant(value='Found direct import: '),
                      FormattedValue(
                        value=Name(id='imp', ctx=Load()),
                        conversion=-1)]))])]),
        FunctionDef(
          name='test_no_direct_imports_in_l3',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value="Test that L3 doesn't directly import services.")),
            Import(
              names=[
                alias(name='l3')]),
            Assign(
              targets=[
                Name(id='source_lines', ctx=Store())],
              value=List(ctx=Load())),
            Try(
              body=[
                With(
                  items=[
                    withitem(
                      context_expr=Call(
                        func=Name(id='open', ctx=Load()),
                        args=[
                          Constant(value='l3/__init__.py'),
                          Constant(value='r')]),
                      optional_vars=Name(id='f', ctx=Store()))],
                  body=[
                    Assign(
                      targets=[
                        Name(id='source_lines', ctx=Store())],
                      value=Call(
                        func=Attribute(
                          value=Name(id='f', ctx=Load()),
                          attr='readlines',
                          ctx=Load())))])],
              handlers=[
                ExceptHandler(
                  type=Name(id='FileNotFoundError', ctx=Load()),
                  body=[
                    Return()])]),
            Assign(
              targets=[
                Name(id='source', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Constant(value=''),
                  attr='join',
                  ctx=Load()),
                args=[
                  Name(id='source_lines', ctx=Load())])),
            Assert(
              test=Compare(
                left=Constant(value='from infra.di_container import'),
                ops=[
                  In()],
                comparators=[
                  Name(id='source', ctx=Load())]))])]),
    If(
      test=Compare(
        left=Name(id='__name__', ctx=Load()),
        ops=[
          Eq()],
        comparators=[
          Constant(value='__main__')]),
      body=[
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='pytest', ctx=Load()),
              attr='main',
              ctx=Load()),
            args=[
              List(
                elts=[
                  Name(id='__file__', ctx=Load())],
                ctx=Load())]))])])