Module(
  body=[
    Import(
      names=[
        alias(name='pytest')]),
    ImportFrom(
      module='workflow.graph',
      names=[
        alias(name='get_nodes'),
        alias(name='get_edges')],
      level=0),
    FunctionDef(
      name='test_required_nodes_present',
      args=arguments(
        args=[
          arg(arg='node')]),
      body=[
        Assert(
          test=Compare(
            left=Name(id='node', ctx=Load()),
            ops=[
              In()],
            comparators=[
              Call(
                func=Name(id='set', ctx=Load()),
                args=[
                  Call(
                    func=Name(id='get_nodes', ctx=Load()))])]))],
      decorator_list=[
        Call(
          func=Attribute(
            value=Attribute(
              value=Name(id='pytest', ctx=Load()),
              attr='mark',
              ctx=Load()),
            attr='parametrize',
            ctx=Load()),
          args=[
            Constant(value='node'),
            List(
              elts=[
                Constant(value='PromptInjectionDetector'),
                Constant(value='PIISanitizerAgent'),
                Constant(value='QAAgent'),
                Constant(value='StrategyAgent'),
                Constant(value='RAGAgent'),
                Constant(value='DraftingAgent')],
              ctx=Load())])]),
    FunctionDef(
      name='test_edges_render',
      args=arguments(
        args=[
          arg(arg='edge_contains')]),
      body=[
        Assign(
          targets=[
            Name(id='edges', ctx=Store())],
          value=Call(
            func=Name(id='get_edges', ctx=Load()))),
        Assert(
          test=BoolOp(
            op=And(),
            values=[
              Name(id='edges', ctx=Load()),
              Call(
                func=Name(id='all', ctx=Load()),
                args=[
                  GeneratorExp(
                    elt=Compare(
                      left=Name(id='edge_contains', ctx=Load()),
                      ops=[
                        In()],
                      comparators=[
                        Name(id='e', ctx=Load())]),
                    generators=[
                      comprehension(
                        target=Name(id='e', ctx=Store()),
                        iter=Name(id='edges', ctx=Load()),
                        is_async=0)])])]))],
      decorator_list=[
        Call(
          func=Attribute(
            value=Attribute(
              value=Name(id='pytest', ctx=Load()),
              attr='mark',
              ctx=Load()),
            attr='parametrize',
            ctx=Load()),
          args=[
            Constant(value='edge_contains'),
            List(
              elts=[
                Constant(value='->')],
              ctx=Load())])])])