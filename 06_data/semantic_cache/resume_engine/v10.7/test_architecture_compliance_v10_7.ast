Module(
  body=[
    Import(
      names=[
        alias(name='subprocess')]),
    Import(
      names=[
        alias(name='pytest')]),
    FunctionDef(
      name='test_no_global_config_usage',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='r', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='subprocess', ctx=Load()),
              attr='run',
              ctx=Load()),
            args=[
              List(
                elts=[
                  Constant(value='grep'),
                  Constant(value='-R'),
                  Constant(value='GLOBAL_CONFIG'),
                  Constant(value='agentic_workflow/')],
                ctx=Load())],
            keywords=[
              keyword(
                arg='capture_output',
                value=Constant(value=True)),
              keyword(
                arg='text',
                value=Constant(value=True))])),
        Assert(
          test=Compare(
            left=Constant(value='GLOBAL_CONFIG'),
            ops=[
              NotIn()],
            comparators=[
              Attribute(
                value=Name(id='r', ctx=Load()),
                attr='stdout',
                ctx=Load())]))],
      decorator_list=[
        Attribute(
          value=Attribute(
            value=Name(id='pytest', ctx=Load()),
            attr='mark',
            ctx=Load()),
          attr='architecture',
          ctx=Load())]),
    FunctionDef(
      name='test_dependency_injection_exists',
      args=arguments(),
      body=[
        ImportFrom(
          module='inspect',
          names=[
            alias(name='signature')],
          level=0),
        ImportFrom(
          module='agents',
          names=[
            alias(name='StrategyAgent')],
          level=0),
        Assert(
          test=Compare(
            left=Constant(value='context'),
            ops=[
              In()],
            comparators=[
              Attribute(
                value=Call(
                  func=Name(id='signature', ctx=Load()),
                  args=[
                    Attribute(
                      value=Name(id='StrategyAgent', ctx=Load()),
                      attr='__init__',
                      ctx=Load())]),
                attr='parameters',
                ctx=Load())]))],
      decorator_list=[
        Attribute(
          value=Attribute(
            value=Name(id='pytest', ctx=Load()),
            attr='mark',
            ctx=Load()),
          attr='architecture',
          ctx=Load())]),
    FunctionDef(
      name='test_placeholder',
      args=arguments(),
      body=[
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='pytest', ctx=Load()),
              attr='xfail',
              ctx=Load()),
            args=[
              Constant(value='Add 13 architecture compliance tests')]))],
      decorator_list=[
        Call(
          func=Attribute(
            value=Attribute(
              value=Name(id='pytest', ctx=Load()),
              attr='mark',
              ctx=Load()),
            attr='xfail',
            ctx=Load()),
          keywords=[
            keyword(
              arg='reason',
              value=Constant(value='Add 13 architecture compliance tests')),
            keyword(
              arg='strict',
              value=Constant(value=False))])])])