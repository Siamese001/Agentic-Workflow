Module(
  body=[
    Import(
      names=[
        alias(name='pytest')]),
    ImportFrom(
      module='workflow.runner',
      names=[
        alias(name='run_workflow')],
      level=0),
    FunctionDef(
      name='test_full_resume_generation_pipeline',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='ctx', ctx=Store())],
          value=Dict(
            keys=[
              Constant(value='resume'),
              Constant(value='jd')],
            values=[
              Constant(value='Jane Doe'),
              Constant(value='Chief AI Officer')])),
        Assign(
          targets=[
            Name(id='output', ctx=Store())],
          value=Call(
            func=Name(id='run_workflow', ctx=Load()),
            args=[
              Name(id='ctx', ctx=Load())])),
        Assert(
          test=Compare(
            left=Subscript(
              value=Name(id='output', ctx=Load()),
              slice=Constant(value='status'),
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value='success')])),
        Assert(
          test=Compare(
            left=Constant(value='summary'),
            ops=[
              In()],
            comparators=[
              Name(id='output', ctx=Load())]))],
      decorator_list=[
        Attribute(
          value=Attribute(
            value=Name(id='pytest', ctx=Load()),
            attr='mark',
            ctx=Load()),
          attr='integration',
          ctx=Load())]),
    FunctionDef(
      name='test_ambiguity_triggers_tot_branching',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='ctx', ctx=Store())],
          value=Dict(
            keys=[
              Constant(value='resume')],
            values=[
              Constant(value='ambiguous input')])),
        Assign(
          targets=[
            Name(id='out', ctx=Store())],
          value=Call(
            func=Name(id='run_workflow', ctx=Load()),
            args=[
              Name(id='ctx', ctx=Load())])),
        Assert(
          test=Compare(
            left=Constant(value='ToT'),
            ops=[
              In()],
            comparators=[
              Subscript(
                value=Name(id='out', ctx=Load()),
                slice=Constant(value='events'),
                ctx=Load())]))],
      decorator_list=[
        Attribute(
          value=Attribute(
            value=Name(id='pytest', ctx=Load()),
            attr='mark',
            ctx=Load()),
          attr='integration',
          ctx=Load())]),
    FunctionDef(
      name='test_low_confidence_triggers_retry',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='ctx', ctx=Store())],
          value=Dict(
            keys=[
              Constant(value='resume')],
            values=[
              Constant(value='low_confidence_case')])),
        Assign(
          targets=[
            Name(id='out', ctx=Store())],
          value=Call(
            func=Name(id='run_workflow', ctx=Load()),
            args=[
              Name(id='ctx', ctx=Load())])),
        Assert(
          test=Compare(
            left=Constant(value='retry'),
            ops=[
              In()],
            comparators=[
              Subscript(
                value=Name(id='out', ctx=Load()),
                slice=Constant(value='events'),
                ctx=Load())]))],
      decorator_list=[
        Attribute(
          value=Attribute(
            value=Name(id='pytest', ctx=Load()),
            attr='mark',
            ctx=Load()),
          attr='integration',
          ctx=Load())]),
    FunctionDef(
      name='test_placeholder',
      args=arguments(),
      body=[
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='pytest', ctx=Load()),
              attr='xfail',
              ctx=Load()),
            args=[
              Constant(value='Add 17 more integration tests for all stacks')]))],
      decorator_list=[
        Call(
          func=Attribute(
            value=Attribute(
              value=Name(id='pytest', ctx=Load()),
              attr='mark',
              ctx=Load()),
            attr='xfail',
            ctx=Load()),
          keywords=[
            keyword(
              arg='reason',
              value=Constant(value='Add 17 more integration tests for all stacks')),
            keyword(
              arg='strict',
              value=Constant(value=False))])])])