            Name(id='new', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='json', ctx=Load()),
              attr='load',
              ctx=Load()),
            args=[
              Call(
                func=Name(id='open', ctx=Load()),
                args=[
                  Constant(value='tests/baseline_outputs_v10_7.json')])])),
        For(
          target=Name(id='k', ctx=Store()),
          iter=Call(
            func=Attribute(
              value=Name(id='prev', ctx=Load()),
              attr='keys',
              ctx=Load())),
          body=[
            Assert(
              test=Call(
                func=Attribute(
                  value=Call(
                    func=Name(id='set', ctx=Load()),
                    args=[
                      Call(
                        func=Attribute(
                          value=Subscript(
                            value=Name(id='prev', ctx=Load()),
                            slice=Name(id='k', ctx=Load()),
                            ctx=Load()),
                          attr='keys',
                          ctx=Load()))]),
                  attr='issubset',
                  ctx=Load()),
                args=[
                  Call(
                    func=Attribute(
                      value=Subscript(
                        value=Name(id='new', ctx=Load()),
                        slice=Name(id='k', ctx=Load()),
                        ctx=Load()),
                      attr='keys',
                      ctx=Load()))]))])],
      decorator_list=[
        Attribute(
          value=Attribute(
            value=Name(id='pytest', ctx=Load()),
            attr='mark',
            ctx=Load()),
          attr='regression',
          ctx=Load())]),
    FunctionDef(
      name='test_placeholder',
      args=arguments(),
      body=[
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='pytest', ctx=Load()),
              attr='xfail',
              ctx=Load()),
            args=[
              Constant(value='Add additional regression tests for model drift and scoring consistency')]))],
      decorator_list=[
        Call(
