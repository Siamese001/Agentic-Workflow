Module(
  body=[
    Import(
      names=[
        alias(name='json')]),
    Import(
      names=[
        alias(name='pytest')]),
    FunctionDef(
      name='test_output_backward_compatibility',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='prev', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='json', ctx=Load()),
              attr='load',
              ctx=Load()),
            args=[
              Call(
                func=Name(id='open', ctx=Load()),
                args=[
                  Constant(value='tests/baseline_outputs_previous.json')])])),
        Assign(
