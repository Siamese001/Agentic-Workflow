Module(
  body=[
    Import(
      names=[
        alias(name='pytest')]),
    ImportFrom(
      module='workflow.runner',
      names=[
        alias(name='run_workflow')],
      level=0),
    FunctionDef(
      name='test_parallel_branch_merge',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='ctx', ctx=Store())],
          value=Dict(
            keys=[
              Constant(value='resume'),
              Constant(value='jd')],
            values=[
              Constant(value='multi_branch_case'),
