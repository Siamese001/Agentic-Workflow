            args=[
              Name(id='ctx', ctx=Load())])),
        Assert(
          test=Compare(
            left=Constant(value='merged_output'),
            ops=[
              In()],
            comparators=[
              Name(id='result', ctx=Load())]))],
      decorator_list=[
        Attribute(
          value=Attribute(
            value=Name(id='pytest', ctx=Load()),
            attr='mark',
            ctx=Load()),
          attr='integration',
          ctx=Load())]),
    FunctionDef(
      name='test_hil_trigger_on_ambiguity',
      args=arguments(),
      body=[
