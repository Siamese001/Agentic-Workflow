            Name(id='ctx', ctx=Store())],
          value=Dict(
            keys=[
              Constant(value='resume')],
            values=[
              Constant(value='confused output')])),
        Assign(
          targets=[
            Name(id='out', ctx=Store())],
          value=Call(
            func=Name(id='run_workflow', ctx=Load()),
            args=[
              Name(id='ctx', ctx=Load())])),
        Assert(
          test=Compare(
            left=Constant(value='HIL'),
            ops=[
              In()],
            comparators=[
              Subscript(
                value=Name(id='out', ctx=Load()),
                slice=Constant(value='events'),
                ctx=Load())]))],
      decorator_list=[
        Attribute(
          value=Attribute(
            value=Name(id='pytest', ctx=Load()),
            attr='mark',
            ctx=Load()),
          attr='integration',
          ctx=Load())]),
    FunctionDef(
      name='test_placeholder',
      args=arguments(),
      body=[
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='pytest', ctx=Load()),
              attr='xfail',
              ctx=Load()),
            args=[
              Constant(value='Add 18 integration flow tests for cache, async merges, and redis persistence')]))],
      decorator_list=[
        Call(
          func=Attribute(
            value=Attribute(
              value=Name(id='pytest', ctx=Load()),
              attr='mark',
              ctx=Load()),
            attr='xfail',
            ctx=Load()),
          keywords=[
            keyword(
              arg='reason',
