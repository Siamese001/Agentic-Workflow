Module(
  body=[
    Import(
      names=[
        alias(name='pytest')]),
    ImportFrom(
      module='workflow.runner',
      names=[
        alias(name='run_workflow')],
      level=0),
    ImportFrom(
      module='schema',
      names=[
        alias(name='ResumeOutputSchema')],
      level=0),
    FunctionDef(
      name='test_resume_schema_compliance',
      args=arguments(
        args=[
          arg(arg='jd')]),
      body=[
        Assign(
          targets=[
            Name(id='out', ctx=Store())],
          value=Call(
            func=Name(id='run_workflow', ctx=Load()),
            args=[
              Dict(
                keys=[
                  Constant(value='resume'),
                  Constant(value='jd')],
                values=[
                  Constant(value='AI Exec'),
                  Name(id='jd', ctx=Load())])])),
        Expr(
          value=Call(
            func=Name(id='ResumeOutputSchema', ctx=Load()),
            keywords=[
              keyword(
                value=Subscript(
                  value=Name(id='out', ctx=Load()),
                  slice=Constant(value='resume'),
                  ctx=Load()))]))],
      decorator_list=[
        Call(
          func=Attribute(
            value=Attribute(
              value=Name(id='pytest', ctx=Load()),
              attr='mark',
              ctx=Load()),
            attr='parametrize',
            ctx=Load()),
          args=[
            Constant(value='jd'),
            List(
              elts=[
                Constant(value='AWS'),
                Constant(value='Anthropic'),
                Constant(value='Databricks'),
                Constant(value='CoreWeave'),
                Constant(value='Citi')],
              ctx=Load())])]),
    FunctionDef(
      name='test_idempotency',
      args=arguments(
        args=[
          arg(arg='repeat')]),
      body=[
        Assign(
          targets=[
            Name(id='ctx', ctx=Store())],
          value=Dict(
            keys=[
              Constant(value='resume'),
              Constant(value='jd')],
            values=[
              Constant(value='repeatable'),
              Constant(value='same')])),
        Assign(
          targets=[
            Name(id='outs', ctx=Store())],
          value=ListComp(
            elt=Call(
              func=Name(id='run_workflow', ctx=Load()),
              args=[
                Name(id='ctx', ctx=Load())]),
            generators=[
              comprehension(
                target=Name(id='_', ctx=Store()),
                iter=Call(
                  func=Name(id='range', ctx=Load()),
                  args=[
                    Name(id='repeat', ctx=Load())]),
                is_async=0)])),
        Assert(
          test=Call(
            func=Name(id='all', ctx=Load()),
            args=[
              GeneratorExp(
                elt=Compare(
                  left=Name(id='o', ctx=Load()),
                  ops=[
                    Eq()],
                  comparators=[
                    Subscript(
                      value=Name(id='outs', ctx=Load()),
                      slice=Constant(value=0),
                      ctx=Load())]),
                generators=[
                  comprehension(
                    target=Name(id='o', ctx=Store()),
                    iter=Name(id='outs', ctx=Load()),
                    is_async=0)])]))],
      decorator_list=[
        Call(
          func=Attribute(
            value=Attribute(
              value=Name(id='pytest', ctx=Load()),
              attr='mark',
              ctx=Load()),
            attr='parametrize',
            ctx=Load()),
          args=[
            Constant(value='repeat'),
            List(
              elts=[
                Constant(value=1),
                Constant(value=2),
                Constant(value=3),
                Constant(value=4),
                Constant(value=5)],
              ctx=Load())])])])