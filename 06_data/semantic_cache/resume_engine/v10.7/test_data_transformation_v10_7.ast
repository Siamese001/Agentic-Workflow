Module(
  body=[
    Import(
      names=[
        alias(name='pytest')]),
    ImportFrom(
      module='agents',
      names=[
        alias(name='PIISanitizerAgent'),
        alias(name='QAAgent')],
      level=0),
    FunctionDef(
      name='test_structure_preserved_after_sanitization',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='inp', ctx=Store())],
          value=Dict(
            keys=[
              Constant(value='email'),
              Constant(value='name')],
            values=[
              Constant(value='a@b.com'),
              Constant(value='John')])),
        Assign(
          targets=[
            Name(id='out', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Call(
                func=Name(id='PIISanitizerAgent', ctx=Load())),
              attr='sanitize',
              ctx=Load()),
            args=[
              Name(id='inp', ctx=Load())])),
        Assert(
          test=Compare(
            left=Call(
              func=Name(id='set', ctx=Load()),
              args=[
                Call(
                  func=Attribute(
                    value=Name(id='inp', ctx=Load()),
                    attr='keys',
                    ctx=Load()))]),
            ops=[
              Eq()],
            comparators=[
              Call(
                func=Name(id='set', ctx=Load()),
                args=[
                  Call(
                    func=Attribute(
                      value=Name(id='out', ctx=Load()),
                      attr='keys',
                      ctx=Load()))])]))],
      decorator_list=[
        Attribute(
          value=Attribute(
            value=Name(id='pytest', ctx=Load()),
            attr='mark',
            ctx=Load()),
          attr='data',
          ctx=Load())]),
    FunctionDef(
      name='test_analyzer_adds_confidence_field',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='out', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Call(
                func=Name(id='QAAgent', ctx=Load())),
              attr='evaluate',
              ctx=Load()),
            args=[
              Constant(value='sample')])),
        Assert(
          test=Compare(
            left=Constant(value='confidence'),
            ops=[
              In()],
            comparators=[
              Name(id='out', ctx=Load())]))],
      decorator_list=[
        Attribute(
          value=Attribute(
            value=Name(id='pytest', ctx=Load()),
            attr='mark',
            ctx=Load()),
          attr='data',
          ctx=Load())]),
    FunctionDef(
      name='test_placeholder',
      args=arguments(),
      body=[
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='pytest', ctx=Load()),
              attr='xfail',
              ctx=Load()),
            args=[
              Constant(value='Add 13 transformation tests on Analyzer, Enricher, Validator, Aggregator')]))],
      decorator_list=[
        Call(
          func=Attribute(
            value=Attribute(
              value=Name(id='pytest', ctx=Load()),
              attr='mark',
              ctx=Load()),
            attr='xfail',
            ctx=Load()),
          keywords=[
            keyword(
              arg='reason',
              value=Constant(value='Add 13 transformation tests on Analyzer, Enricher, Validator, Aggregator')),
            keyword(
              arg='strict',
              value=Constant(value=False))])])])