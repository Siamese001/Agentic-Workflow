                    List(
                      elts=[
                        Constant(value='summary')],
                      ctx=Load())],
                  ctx=Load()),
                Tuple(
                  elts=[
                    Constant(value='John Smith'),
                    Constant(value='Director, AI'),
                    List(
                      elts=[
                        Constant(value='summary')],
                      ctx=Load())],
                  ctx=Load()),
                Tuple(
                  elts=[
                    Constant(value='LowConf'),
                    Constant(value='Analyst'),
                    List(
                      elts=[
                        Constant(value='events')],
                      ctx=Load())],
                  ctx=Load()),
                Tuple(
                  elts=[
                    Constant(value='Ambiguous'),
                    Constant(value='Unknown'),
                    List(
                      elts=[
                        Constant(value='events')],
                      ctx=Load())],
                  ctx=Load())],
              ctx=Load())])]),
    FunctionDef(
      name='test_scenarios_collectively',
      args=arguments(
        args=[
          arg(arg='scenario')]),
      body=[
