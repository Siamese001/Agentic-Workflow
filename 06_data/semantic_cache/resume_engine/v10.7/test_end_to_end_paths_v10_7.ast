              attr='mark',
              ctx=Load()),
            attr='parametrize',
            ctx=Load()),
          args=[
            Constant(value='resume,jd,expect_keys'),
            List(
              elts=[
                Tuple(
                  elts=[
                    Constant(value='Jane Doe'),
