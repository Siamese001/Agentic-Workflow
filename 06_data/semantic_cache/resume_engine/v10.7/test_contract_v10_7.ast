Module(
  body=[
    Import(
      names=[
        alias(name='pytest')]),
    ImportFrom(
      module='schema',
      names=[
        alias(name='ResumeOutputSchema')],
      level=0),
    ImportFrom(
      module='workflow.runner',
      names=[
        alias(name='run_workflow')],
      level=0),
    FunctionDef(
      name='test_resume_schema_compliance',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='result', ctx=Store())],
          value=Call(
            func=Name(id='run_workflow', ctx=Load()),
            args=[
              Dict(
                keys=[
                  Constant(value='resume'),
                  Constant(value='jd')],
                values=[
                  Constant(value='AI Exec'),
                  Constant(value='AWS')])])),
        Expr(
          value=Call(
            func=Name(id='ResumeOutputSchema', ctx=Load()),
            keywords=[
              keyword(
                value=Subscript(
                  value=Name(id='result', ctx=Load()),
                  slice=Constant(value='resume'),
                  ctx=Load()))]))],
      decorator_list=[
        Attribute(
          value=Attribute(
            value=Name(id='pytest', ctx=Load()),
            attr='mark',
            ctx=Load()),
          attr='contract',
          ctx=Load())]),
    FunctionDef(
      name='test_latency_under_sla',
      args=arguments(
        args=[
          arg(arg='benchmark')]),
      body=[
        Assign(
          targets=[
            Name(id='ctx', ctx=Store())],
          value=Dict(
            keys=[
              Constant(value='resume'),
              Constant(value='jd')],
            values=[
              Constant(value='fast'),
              Constant(value='QuickTest')])),
        Assign(
          targets=[
            Name(id='out', ctx=Store())],
          value=Call(
            func=Name(id='benchmark', ctx=Load()),
            args=[
              Lambda(
                args=arguments(),
                body=Call(
                  func=Name(id='run_workflow', ctx=Load()),
                  args=[
                    Name(id='ctx', ctx=Load())]))])),
        Assert(
          test=Compare(
            left=Name(id='out', ctx=Load()),
            ops=[
              IsNot()],
            comparators=[
              Constant(value=None)]))],
      decorator_list=[
        Attribute(
          value=Attribute(
            value=Name(id='pytest', ctx=Load()),
            attr='mark',
            ctx=Load()),
          attr='contract',
          ctx=Load())]),
    FunctionDef(
      name='test_idempotent_results',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='ctx', ctx=Store())],
          value=Dict(
            keys=[
              Constant(value='resume'),
              Constant(value='jd')],
            values=[
              Constant(value='repeat'),
              Constant(value='same')])),
        Assign(
          targets=[
            Tuple(
              elts=[
                Name(id='r1', ctx=Store()),
                Name(id='r2', ctx=Store())],
              ctx=Store())],
          value=Tuple(
            elts=[
              Call(
                func=Name(id='run_workflow', ctx=Load()),
                args=[
                  Name(id='ctx', ctx=Load())]),
              Call(
                func=Name(id='run_workflow', ctx=Load()),
                args=[
                  Name(id='ctx', ctx=Load())])],
            ctx=Load())),
        Assert(
          test=Compare(
            left=Name(id='r1', ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Name(id='r2', ctx=Load())]))],
      decorator_list=[
        Attribute(
          value=Attribute(
            value=Name(id='pytest', ctx=Load()),
            attr='mark',
            ctx=Load()),
          attr='contract',
          ctx=Load())]),
    FunctionDef(
      name='test_placeholder',
      args=arguments(),
      body=[
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='pytest', ctx=Load()),
              attr='xfail',
              ctx=Load()),
            args=[
              Constant(value='Add 22 more contract and SLA enforcement tests')]))],
      decorator_list=[
        Call(
          func=Attribute(
            value=Attribute(
              value=Name(id='pytest', ctx=Load()),
              attr='mark',
              ctx=Load()),
            attr='xfail',
            ctx=Load()),
          keywords=[
            keyword(
              arg='reason',
              value=Constant(value='Add 22 more contract and SLA enforcement tests')),
            keyword(
              arg='strict',
              value=Constant(value=False))])])])