Module(
  body=[
    ImportFrom(
      module='core_v10_7',
      names=[
        alias(name='MetricsCollector'),
        alias(name='SemanticValidator')],
      level=0),
    FunctionDef(
      name='_validator',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='metrics', ctx=Store())],
          value=Call(
            func=Name(id='MetricsCollector', ctx=Load()))),
        Return(
          value=Call(
            func=Name(id='SemanticValidator', ctx=Load()),
            keywords=[
              keyword(
                arg='metrics_collector',
                value=Name(id='metrics', ctx=Load()))]))],
      returns=Name(id='SemanticValidator', ctx=Load())),
    FunctionDef(
      name='test_word_count_within_range_passes',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='validator', ctx=Store())],
          value=Call(
            func=Name(id='_validator', ctx=Load()))),
        Assign(
          targets=[
            Tuple(
              elts=[
                Name(id='ok', ctx=Store()),
                Name(id='message', ctx=Store())],
              ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='validator', ctx=Load()),
              attr='check_word_count',
              ctx=Load()),
            args=[
              Constant(value='a b c d')],
            keywords=[
              keyword(
                arg='min_words',
                value=Constant(value=2)),
              keyword(
                arg='max_words',
                value=Constant(value=10))])),
        Assert(
          test=Compare(
            left=Name(id='ok', ctx=Load()),
            ops=[
              Is()],
            comparators=[
              Constant(value=True)])),
        Assert(
          test=Compare(
            left=Constant(value='Word count OK'),
            ops=[
              In()],
            comparators=[
              Name(id='message', ctx=Load())]))]),
    FunctionDef(
      name='test_word_count_out_of_range_fails',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='validator', ctx=Store())],
          value=Call(
            func=Name(id='_validator', ctx=Load()))),
        Assign(
          targets=[
            Tuple(
              elts=[
                Name(id='ok', ctx=Store()),
                Name(id='message', ctx=Store())],
              ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='validator', ctx=Load()),
              attr='check_word_count',
              ctx=Load()),
            args=[
              Constant(value='one')],
            keywords=[
              keyword(
                arg='min_words',
                value=Constant(value=2)),
              keyword(
                arg='max_words',
                value=Constant(value=5))])),
        Assert(
          test=Compare(
            left=Name(id='ok', ctx=Load()),
            ops=[
              Is()],
            comparators=[
              Constant(value=False)])),
        Assert(
          test=Compare(
            left=Constant(value='FAILED'),
            ops=[
              In()],
            comparators=[
              Name(id='message', ctx=Load())]))]),
    FunctionDef(
      name='test_llm_reported_count_discrepancy_logs_metric',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='metrics', ctx=Store())],
          value=Call(
            func=Name(id='MetricsCollector', ctx=Load()))),
        Assign(
          targets=[
            Name(id='validator', ctx=Store())],
          value=Call(
            func=Name(id='SemanticValidator', ctx=Load()),
            keywords=[
              keyword(
                arg='metrics_collector',
                value=Name(id='metrics', ctx=Load()))])),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='validator', ctx=Load()),
              attr='check_word_count',
              ctx=Load()),
            args=[
              Constant(value='token token')],
            keywords=[
              keyword(
                arg='min_words',
                value=Constant(value=1)),
              keyword(
                arg='max_words',
                value=Constant(value=10)),
              keyword(
                arg='llm_reported_count',
                value=Constant(value=100)),
              keyword(
                arg='workflow_id',
                value=Constant(value='wf-123'))])),
        Assert(
          test=Call(
            func=Name(id='any', ctx=Load()),
            args=[
              GeneratorExp(
                elt=Compare(
                  left=Subscript(
                    value=Name(id='m', ctx=Load()),
                    slice=Constant(value='task_name'),
                    ctx=Load()),
                  ops=[
                    Eq()],
                  comparators=[
                    Constant(value='word_count_discrepancy')]),
                generators=[
                  comprehension(
                    target=Name(id='m', ctx=Store()),
                    iter=Attribute(
                      value=Name(id='metrics', ctx=Load()),
                      attr='metrics',
                      ctx=Load()),
                    is_async=0)])]))])])