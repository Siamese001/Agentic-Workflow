Module(
  body=[
    Import(
      names=[
        alias(name='pytest')]),
    ImportFrom(
      module='stacks_v10_8.bullet_execution',
      names=[
        alias(name='BulletExecutionStack')],
      level=0),
    AsyncFunctionDef(
      name='test_generate_from_state_async_builds_expected_patch',
      args=arguments(
        args=[
          arg(arg='workflow_context')]),
      body=[
        Assign(
          targets=[
            Name(id='state', ctx=Store())],
          value=Dict(
            keys=[
              Constant(value='metadata'),
              Constant(value='prompts'),
              Constant(value='strategy'),
              Constant(value='resume')],
            values=[
              Dict(
                keys=[
                  Constant(value='workflow_id')],
                values=[
                  Constant(value='wf-bullets')]),
              Dict(
                keys=[
                  Constant(value='prompts')],
                values=[
                  Dict(
                    keys=[
                      Constant(value='bullet_generation_prompt')],
                    values=[
                      Constant(value='Write impact bullets.')])]),
              Dict(
                keys=[
                  Constant(value='strategy_plan')],
                values=[
                  Dict(
                    keys=[
                      Constant(value='strategy_name'),
                      Constant(value='focus_areas'),
                      Constant(value='key_achievements_to_highlight'),
                      Constant(value='tone')],
                    values=[
                      Constant(value='default'),
                      List(
                        elts=[
                          Constant(value='impact')],
                        ctx=Load()),
                      List(
                        elts=[
                          Constant(value='growth')],
                        ctx=Load()),
                      Constant(value='Bold')])]),
              Dict(
                keys=[
                  Constant(value='experience_bullets')],
                values=[
                  List(
                    elts=[
                      Dict(
                        keys=[
                          Constant(value='id'),
                          Constant(value='text')],
                        values=[
                          Constant(value='exp-1'),
                          Constant(value='Improved retention')]),
                      Dict(
                        keys=[
                          Constant(value='id'),
                          Constant(value='text')],
                        values=[
                          Constant(value='exp-2'),
                          Constant(value='Cut churn')])],
                    ctx=Load())])])),
        Assign(
          targets=[
            Name(id='stack', ctx=Store())],
          value=Call(
            func=Name(id='BulletExecutionStack', ctx=Load()),
            args=[
              Name(id='workflow_context', ctx=Load())])),
        Assign(
          targets=[
            Name(id='captured', ctx=Store())],
          value=Dict()),
        AsyncFunctionDef(
          name='fake_generate_async',
          args=arguments(
            args=[
              arg(arg='prompt'),
              arg(arg='experiences'),
              arg(arg='strategy'),
              arg(arg='workflow_id')]),
          body=[
            Assign(
              targets=[
                Subscript(
                  value=Name(id='captured', ctx=Load()),
                  slice=Constant(value='prompt'),
                  ctx=Store())],
              value=Name(id='prompt', ctx=Load())),
            Assign(
              targets=[
                Subscript(
                  value=Name(id='captured', ctx=Load()),
                  slice=Constant(value='experiences'),
                  ctx=Store())],
              value=Name(id='experiences', ctx=Load())),
            Assign(
              targets=[
                Subscript(
                  value=Name(id='captured', ctx=Load()),
                  slice=Constant(value='workflow_id'),
                  ctx=Store())],
              value=Name(id='workflow_id', ctx=Load())),
            Assign(
              targets=[
                Subscript(
                  value=Name(id='captured', ctx=Load()),
                  slice=Constant(value='strategy_tone'),
                  ctx=Store())],
              value=IfExp(
                test=Call(
                  func=Name(id='hasattr', ctx=Load()),
                  args=[
                    Name(id='strategy', ctx=Load()),
                    Constant(value='tone')]),
                body=Attribute(
                  value=Name(id='strategy', ctx=Load()),
                  attr='tone',
                  ctx=Load()),
                orelse=Constant(value=None))),
            Return(
              value=Dict(
                keys=[
                  Constant(value='bullets')],
                values=[
                  Dict(
                    keys=[
                      Constant(value='generated_bullets')],
                    values=[
                      Name(id='experiences', ctx=Load())])]))]),
        Assign(
          targets=[
            Attribute(
              value=Name(id='stack', ctx=Load()),
              attr='generate_async',
              ctx=Store())],
          value=Name(id='fake_generate_async', ctx=Load())),
        Assign(
          targets=[
            Name(id='patch', ctx=Store())],
          value=Await(
            value=Call(
              func=Attribute(
                value=Name(id='stack', ctx=Load()),
                attr='generate_from_state_async',
                ctx=Load()),
              args=[
                Name(id='state', ctx=Load()),
                Constant(value='wf-bullets')]))),
        Assert(
          test=Compare(
            left=Subscript(
              value=Name(id='captured', ctx=Load()),
              slice=Constant(value='prompt'),
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value='Write impact bullets.')])),
        Assert(
          test=Compare(
            left=Subscript(
              value=Name(id='captured', ctx=Load()),
              slice=Constant(value='workflow_id'),
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value='wf-bullets')])),
        Assert(
          test=Compare(
            left=Subscript(
              value=Name(id='captured', ctx=Load()),
              slice=Constant(value='strategy_tone'),
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value='Bold')])),
        Assert(
          test=Compare(
            left=Subscript(
              value=Subscript(
                value=Name(id='patch', ctx=Load()),
                slice=Constant(value='bullets'),
                ctx=Load()),
              slice=Constant(value='generated_bullets'),
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Subscript(
                value=Subscript(
                  value=Subscript(
                    value=Name(id='state', ctx=Load()),
                    slice=Constant(value='resume'),
                    ctx=Load()),
                  slice=Constant(value='experience_bullets'),
                  ctx=Load()),
                slice=Slice(
                  upper=Constant(value=3)),
                ctx=Load())]))],
      decorator_list=[
        Attribute(
          value=Attribute(
            value=Name(id='pytest', ctx=Load()),
            attr='mark',
            ctx=Load()),
          attr='asyncio',
          ctx=Load())]),
    AsyncFunctionDef(
      name='test_critique_from_state_async_uses_generated_bullets',
      args=arguments(
        args=[
          arg(arg='workflow_context')]),
      body=[
        Assign(
          targets=[
            Name(id='state', ctx=Store())],
          value=Dict(
            keys=[
              Constant(value='metadata'),
              Constant(value='prompts'),
              Constant(value='bullets')],
            values=[
              Dict(
                keys=[
                  Constant(value='workflow_id')],
                values=[
                  Constant(value='wf-critique')]),
              Dict(
                keys=[
                  Constant(value='prompts')],
                values=[
                  Dict(
                    keys=[
                      Constant(value='critique_prompt')],
                    values=[
                      Constant(value='Score bullets')])]),
              Dict(
                keys=[
                  Constant(value='generated_bullets')],
                values=[
                  List(
                    elts=[
                      Dict(
                        keys=[
                          Constant(value='id'),
                          Constant(value='text')],
                        values=[
                          Constant(value='b-1'),
                          Constant(value='Shipped features')]),
                      Dict(
                        keys=[
                          Constant(value='id'),
                          Constant(value='text')],
                        values=[
                          Constant(value='b-2'),
                          Constant(value='Optimized ops')])],
                    ctx=Load())])])),
        Assign(
          targets=[
            Name(id='stack', ctx=Store())],
          value=Call(
            func=Name(id='BulletExecutionStack', ctx=Load()),
            args=[
              Name(id='workflow_context', ctx=Load())])),
        Assign(
          targets=[
            Name(id='captured', ctx=Store())],
          value=Dict()),
        AsyncFunctionDef(
          name='fake_critique_async',
          args=arguments(
            args=[
              arg(arg='bullets'),
              arg(arg='critique_prompt'),
              arg(arg='workflow_id')]),
          body=[
            Assign(
              targets=[
                Subscript(
                  value=Name(id='captured', ctx=Load()),
                  slice=Constant(value='bullets'),
                  ctx=Store())],
              value=Name(id='bullets', ctx=Load())),
            Assign(
              targets=[
                Subscript(
                  value=Name(id='captured', ctx=Load()),
                  slice=Constant(value='prompt'),
                  ctx=Store())],
              value=Name(id='critique_prompt', ctx=Load())),
            Assign(
              targets=[
                Subscript(
                  value=Name(id='captured', ctx=Load()),
                  slice=Constant(value='workflow_id'),
                  ctx=Store())],
              value=Name(id='workflow_id', ctx=Load())),
            Return(
              value=Dict(
                keys=[
                  Constant(value='bullets')],
                values=[
                  Dict(
                    keys=[
                      Constant(value='critiqued_bullets')],
                    values=[
                      Name(id='bullets', ctx=Load())])]))]),
        Assign(
          targets=[
            Attribute(
              value=Name(id='stack', ctx=Load()),
              attr='critique_async',
              ctx=Store())],
          value=Name(id='fake_critique_async', ctx=Load())),
        Assign(
          targets=[
            Name(id='patch', ctx=Store())],
          value=Await(
            value=Call(
              func=Attribute(
                value=Name(id='stack', ctx=Load()),
                attr='critique_from_state_async',
                ctx=Load()),
              args=[
                Name(id='state', ctx=Load()),
                Constant(value=None)]))),
        Assert(
          test=Compare(
            left=Subscript(
              value=Name(id='captured', ctx=Load()),
              slice=Constant(value='prompt'),
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value='Score bullets')])),
        Assert(
          test=Compare(
            left=Subscript(
              value=Name(id='captured', ctx=Load()),
              slice=Constant(value='workflow_id'),
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value='wf-critique')])),
        Assert(
          test=Compare(
            left=Subscript(
              value=Subscript(
                value=Name(id='patch', ctx=Load()),
                slice=Constant(value='bullets'),
                ctx=Load()),
              slice=Constant(value='critiqued_bullets'),
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Subscript(
                value=Subscript(
                  value=Name(id='state', ctx=Load()),
                  slice=Constant(value='bullets'),
                  ctx=Load()),
                slice=Constant(value='generated_bullets'),
                ctx=Load())]))],
      decorator_list=[
        Attribute(
          value=Attribute(
            value=Name(id='pytest', ctx=Load()),
            attr='mark',
            ctx=Load()),
          attr='asyncio',
          ctx=Load())])])