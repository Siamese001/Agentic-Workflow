Module(
  body=[
    Expr(
      value=Constant(value='Lightweight workflow graph for system tests.')),
    ImportFrom(
      module='__future__',
      names=[
        alias(name='annotations')],
      level=0),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Iterable'),
        alias(name='List')],
      level=0),
    AnnAssign(
      target=Name(id='_REQUIRED_NODES', ctx=Store()),
      annotation=Subscript(
        value=Name(id='List', ctx=Load()),
        slice=Name(id='str', ctx=Load()),
        ctx=Load()),
      value=List(
        elts=[
          Constant(value='PromptInjectionDetector'),
          Constant(value='PIISanitizerAgent'),
          Constant(value='QAAgent'),
          Constant(value='StrategyAgent'),
          Constant(value='RAGAgent'),
          Constant(value='DraftingAgent')],
        ctx=Load()),
      simple=1),
    AnnAssign(
      target=Name(id='_EDGES', ctx=Store()),
      annotation=Subscript(
        value=Name(id='List', ctx=Load()),
        slice=Name(id='str', ctx=Load()),
        ctx=Load()),
      value=List(
        elts=[
          Constant(value='PromptInjectionDetector -> PIISanitizerAgent'),
          Constant(value='PIISanitizerAgent -> StrategyAgent'),
          Constant(value='StrategyAgent -> RAGAgent'),
          Constant(value='RAGAgent -> DraftingAgent'),
          Constant(value='DraftingAgent -> QAAgent')],
        ctx=Load()),
      simple=1),
    FunctionDef(
      name='get_nodes',
      args=arguments(),
      body=[
        Expr(
          value=Constant(value='Return the ordered list of workflow nodes.')),
        Return(
          value=Call(
            func=Name(id='list', ctx=Load()),
            args=[
              Name(id='_REQUIRED_NODES', ctx=Load())]))],
      returns=Subscript(
        value=Name(id='Iterable', ctx=Load()),
        slice=Name(id='str', ctx=Load()),
        ctx=Load())),
    FunctionDef(
      name='get_edges',
      args=arguments(),
      body=[
        Expr(
          value=Constant(value='Return labelled edges in ``node_a -> node_b`` form.')),
        Return(
          value=Call(
            func=Name(id='list', ctx=Load()),
            args=[
              Name(id='_EDGES', ctx=Load())]))],
      returns=Subscript(
        value=Name(id='Iterable', ctx=Load()),
        slice=Name(id='str', ctx=Load()),
        ctx=Load()))])