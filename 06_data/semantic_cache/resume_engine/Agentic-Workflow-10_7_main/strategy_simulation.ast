Module(
  body=[
    Expr(
      value=Constant(value='Strategy simulation models.')),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Any'),
        alias(name='Dict'),
        alias(name='List')],
      level=0),
    ImportFrom(
      module='pydantic',
      names=[
        alias(name='BaseModel'),
        alias(name='Field')],
      level=0),
    ImportFrom(
      module='simulation_base',
      names=[
        alias(name='SimulationInput'),
        alias(name='SimulationResult')],
      level=1),
    ClassDef(
      name='StrategySimRequest',
      bases=[
        Name(id='SimulationInput', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Input payload for strategy simulation.')),
        AnnAssign(
          target=Name(id='job_title', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='company', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='strategy_plan', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='Any', ctx=Load())],
              ctx=Load()),
            ctx=Load()),
          simple=1)]),
    ClassDef(
      name='StrategySimMetrics',
      bases=[
        Name(id='BaseModel', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Metrics produced by a strategy simulation.')),
        AnnAssign(
          target=Name(id='clarity_score', ctx=Store()),
          annotation=Name(id='float', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='alignment_score', ctx=Store()),
          annotation=Name(id='float', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='risk_score', ctx=Store()),
          annotation=Name(id='float', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='notes', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load()),
          value=Call(
            func=Name(id='Field', ctx=Load()),
            keywords=[
              keyword(
                arg='default_factory',
                value=Name(id='list', ctx=Load()))]),
          simple=1)]),
    ClassDef(
      name='StrategySimResult',
      bases=[
        Name(id='SimulationResult', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Result model for strategy simulations.')),
        AnnAssign(
          target=Name(id='metrics', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='Any', ctx=Load())],
              ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='details', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='Any', ctx=Load())],
              ctx=Load()),
            ctx=Load()),
          simple=1)])])