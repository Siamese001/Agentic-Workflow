        Assign(
          targets=[
            Name(id='engine', ctx=Store())],
          value=Call(
            func=Name(id='_make_engine', ctx=Load()))),
        Assign(
          targets=[
            Name(id='result', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='engine', ctx=Load()),
              attr='review_text',
              ctx=Load()),
