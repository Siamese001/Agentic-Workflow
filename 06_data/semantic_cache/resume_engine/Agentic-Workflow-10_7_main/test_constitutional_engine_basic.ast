              Attribute(
                value=Name(id='result', ctx=Load()),
                attr='violations',
                ctx=Load()),
              Name(id='list', ctx=Load())])),
        Assert(
          test=Compare(
            left=Attribute(
              value=Name(id='result', ctx=Load()),
              attr='passed',
              ctx=Load()),
            ops=[
              Is()],
            comparators=[
              Constant(value=True)]))]),
    FunctionDef(
