Module(
  body=[
    Import(
      names=[
        alias(name='pytest')]),
    ImportFrom(
      module='core_v10_7.models',
      names=[
        alias(name='NodeResult'),
        alias(name='NodeStatus')],
      level=0),
    ImportFrom(
      module='agent_orchestration_v10_7',
      names=[
        alias(name='node_success'),
        alias(name='node_error')],
      level=0),
    FunctionDef(
      name='test_node_status_values',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='values', ctx=Store())],
          value=SetComp(
            elt=Attribute(
              value=Name(id='status', ctx=Load()),
              attr='value',
              ctx=Load()),
            generators=[
              comprehension(
                target=Name(id='status', ctx=Store()),
                iter=Name(id='NodeStatus', ctx=Load()),
                is_async=0)])),
        Assert(
          test=Compare(
            left=Name(id='values', ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Set(
                elts=[
                  Constant(value='success'),
                  Constant(value='retriable_error'),
                  Constant(value='fatal_error'),
                  Constant(value='blocked')])]))]),
    FunctionDef(
      name='test_node_result_serialization_round_trip',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='result', ctx=Store())],
          value=Call(
            func=Name(id='NodeResult', ctx=Load()),
            keywords=[
              keyword(
                arg='node',
                value=Constant(value='example')),
              keyword(
                arg='status',
                value=Attribute(
                  value=Name(id='NodeStatus', ctx=Load()),
                  attr='SUCCESS',
                  ctx=Load())),
              keyword(
                arg='error_kind',
                value=Constant(value=None)),
              keyword(
                arg='error_message',
                value=Constant(value=None)),
              keyword(
                arg='payload',
                value=Dict(
                  keys=[
                    Constant(value='foo')],
                  values=[
                    Constant(value='bar')]))])),
        Assign(
          targets=[
            Name(id='serialized', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='result', ctx=Load()),
              attr='model_dump',
              ctx=Load()))),
        Assert(
          test=Compare(
            left=Subscript(
              value=Name(id='serialized', ctx=Load()),
              slice=Constant(value='node'),
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value='example')])),
        Assert(
          test=Compare(
            left=Subscript(
              value=Name(id='serialized', ctx=Load()),
              slice=Constant(value='status'),
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Attribute(
                value=Attribute(
                  value=Name(id='NodeStatus', ctx=Load()),
                  attr='SUCCESS',
                  ctx=Load()),
                attr='value',
                ctx=Load())])),
        Assert(
          test=Compare(
            left=Subscript(
              value=Name(id='serialized', ctx=Load()),
              slice=Constant(value='payload'),
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Dict(
                keys=[
                  Constant(value='foo')],
                values=[
                  Constant(value='bar')])])),
        Assign(
          targets=[
            Name(id='deserialized', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='NodeResult', ctx=Load()),
              attr='model_validate',
              ctx=Load()),
            args=[
              Name(id='serialized', ctx=Load())])),
        Assert(
          test=Compare(
            left=Name(id='deserialized', ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Name(id='result', ctx=Load())]))]),
    FunctionDef(
      name='test_node_success_helper_builds_successful_result',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='payload', ctx=Store())],
          value=Dict(
            keys=[
              Constant(value='state')],
            values=[
              Dict(
                keys=[
                  Constant(value='foo')],
                values=[
                  Constant(value='bar')])])),
        Assign(
          targets=[
            Name(id='result', ctx=Store())],
          value=Call(
            func=Name(id='node_success', ctx=Load()),
            args=[
              Constant(value='test_node'),
              Name(id='payload', ctx=Load())])),
        Assert(
          test=Compare(
            left=Subscript(
              value=Name(id='result', ctx=Load()),
              slice=Constant(value='node'),
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value='test_node')])),
        Assert(
          test=Compare(
            left=Subscript(
              value=Name(id='result', ctx=Load()),
              slice=Constant(value='status'),
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Attribute(
                value=Attribute(
                  value=Name(id='NodeStatus', ctx=Load()),
                  attr='SUCCESS',
                  ctx=Load()),
                attr='value',
                ctx=Load())])),
        Assert(
          test=Compare(
            left=Subscript(
              value=Name(id='result', ctx=Load()),
              slice=Constant(value='payload'),
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Name(id='payload', ctx=Load())]))]),
    FunctionDef(
      name='test_node_error_helper_records_error_details',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='payload', ctx=Store())],
          value=Dict(
            keys=[
              Constant(value='state')],
            values=[
              Dict(
                keys=[
                  Constant(value='foo')],
                values=[
                  Constant(value='bar')])])),
        Assign(
          targets=[
            Name(id='result', ctx=Store())],
          value=Call(
            func=Name(id='node_error', ctx=Load()),
            args=[
              Constant(value='test_node')],
            keywords=[
              keyword(
                arg='status',
                value=Attribute(
                  value=Name(id='NodeStatus', ctx=Load()),
                  attr='FATAL_ERROR',
                  ctx=Load())),
              keyword(
                arg='error_kind',
                value=Constant(value='ValueError')),
              keyword(
                arg='error_message',
                value=Constant(value='bad value')),
              keyword(
                arg='payload',
                value=Name(id='payload', ctx=Load()))])),
        Assert(
          test=Compare(
            left=Subscript(
              value=Name(id='result', ctx=Load()),
              slice=Constant(value='node'),
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value='test_node')])),
        Assert(
          test=Compare(
            left=Subscript(
              value=Name(id='result', ctx=Load()),
              slice=Constant(value='status'),
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Attribute(
                value=Attribute(
                  value=Name(id='NodeStatus', ctx=Load()),
                  attr='FATAL_ERROR',
                  ctx=Load()),
                attr='value',
                ctx=Load())])),
        Assert(
          test=Compare(
            left=Subscript(
              value=Name(id='result', ctx=Load()),
              slice=Constant(value='error_kind'),
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value='ValueError')])),
        Assert(
          test=Compare(
            left=Subscript(
              value=Name(id='result', ctx=Load()),
              slice=Constant(value='error_message'),
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value='bad value')])),
        Assert(
          test=Compare(
            left=Subscript(
              value=Name(id='result', ctx=Load()),
              slice=Constant(value='payload'),
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Name(id='payload', ctx=Load())]))])])