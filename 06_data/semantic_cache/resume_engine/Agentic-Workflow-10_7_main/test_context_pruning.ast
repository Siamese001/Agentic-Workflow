Module(
  body=[
    ImportFrom(
      module='context_budget_v10_8',
      names=[
        alias(name='ContextBudgetConfig'),
        alias(name='ContextBudgetManager')],
      level=0),
    FunctionDef(
      name='test_strict_pruning_applies_at_thresholds',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='config', ctx=Store())],
          value=Call(
            func=Name(id='ContextBudgetConfig', ctx=Load()),
            keywords=[
              keyword(
                arg='max_episodic_messages',
                value=Constant(value=3)),
              keyword(
                arg='max_rag_documents',
                value=Constant(value=2)),
              keyword(
                arg='max_summary_chars',
                value=Constant(value=10))])),
        Assign(
          targets=[
            Name(id='manager', ctx=Store())],
          value=Call(
            func=Name(id='ContextBudgetManager', ctx=Load()),
            args=[
              Name(id='config', ctx=Load())])),
        Assign(
          targets=[
            Name(id='state', ctx=Store())],
          value=Dict(
            keys=[
              Constant(value='memory'),
              Constant(value='rag'),
              Constant(value='resume')],
            values=[
              Dict(
                keys=[
                  Constant(value='episodic')],
                values=[
                  Dict(
                    keys=[
                      Constant(value='conversation')],
                    values=[
                      List(
                        elts=[
                          Dict(
                            keys=[
                              Constant(value='role'),
                              Constant(value='content')],
                            values=[
                              Constant(value='user'),
                              Constant(value='1')]),
                          Dict(
                            keys=[
                              Constant(value='role'),
                              Constant(value='content')],
                            values=[
                              Constant(value='assistant'),
                              Constant(value='2')]),
                          Dict(
                            keys=[
                              Constant(value='role'),
                              Constant(value='content')],
                            values=[
                              Constant(value='assistant'),
                              Constant(value='3')]),
                          Dict(
                            keys=[
                              Constant(value='role'),
                              Constant(value='content')],
                            values=[
                              Constant(value='assistant'),
                              Constant(value='4')])],
                        ctx=Load())])]),
              Dict(
                keys=[
                  Constant(value='history')],
                values=[
                  List(
                    elts=[
                      Constant(value=1),
                      Constant(value=2),
                      Constant(value=3)],
                    ctx=Load())]),
              Dict(
                keys=[
                  Constant(value='summary')],
                values=[
                  Constant(value='1234567890123')])])),
        Assign(
          targets=[
            Name(id='pruned', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='manager', ctx=Load()),
              attr='enforce_all',
              ctx=Load()),
            args=[
              Name(id='state', ctx=Load())])),
        Assert(
          test=Compare(
            left=Subscript(
              value=Subscript(
                value=Subscript(
                  value=Name(id='pruned', ctx=Load()),
                  slice=Constant(value='memory'),
                  ctx=Load()),
                slice=Constant(value='episodic'),
                ctx=Load()),
              slice=Constant(value='conversation'),
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              List(
                elts=[
                  Dict(
                    keys=[
                      Constant(value='role'),
                      Constant(value='content')],
                    values=[
                      Constant(value='assistant'),
                      Constant(value='2')]),
                  Dict(
                    keys=[
                      Constant(value='role'),
                      Constant(value='content')],
                    values=[
                      Constant(value='assistant'),
                      Constant(value='3')]),
                  Dict(
                    keys=[
                      Constant(value='role'),
                      Constant(value='content')],
                    values=[
                      Constant(value='assistant'),
                      Constant(value='4')])],
                ctx=Load())])),
        Assert(
          test=Compare(
            left=Subscript(
              value=Subscript(
                value=Name(id='pruned', ctx=Load()),
                slice=Constant(value='rag'),
                ctx=Load()),
              slice=Constant(value='history'),
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              List(
                elts=[
                  Constant(value=2),
                  Constant(value=3)],
                ctx=Load())])),
        Assert(
          test=Call(
            func=Attribute(
              value=Subscript(
                value=Subscript(
                  value=Name(id='pruned', ctx=Load()),
                  slice=Constant(value='resume'),
                  ctx=Load()),
                slice=Constant(value='summary'),
                ctx=Load()),
              attr='endswith',
              ctx=Load()),
            args=[
              Constant(value='[... SUMMARY TRIMMED ...]')])),
        Assert(
          test=Compare(
            left=Call(
              func=Name(id='len', ctx=Load()),
              args=[
                Subscript(
                  value=Subscript(
                    value=Name(id='pruned', ctx=Load()),
                    slice=Constant(value='resume'),
                    ctx=Load()),
                  slice=Constant(value='summary'),
                  ctx=Load())]),
            ops=[
              LtE()],
            comparators=[
              BinOp(
                left=Constant(value=10),
                op=Add(),
                right=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Constant(value='\n\n[... SUMMARY TRIMMED ...]')]))]))])])