Module(
  body=[
    Expr(
      value=Constant(value='Synthetic safety simulator.')),
    Import(
      names=[
        alias(name='random')]),
    ImportFrom(
      module='simulations.models.safety_simulation',
      names=[
        alias(name='SafetySimMetrics'),
        alias(name='SafetySimRequest'),
        alias(name='SafetySimResult')],
      level=0),
    ImportFrom(
      module='simulations.utils',
      names=[
        alias(name='model_to_payload')],
      level=0),
    ClassDef(
      name='SafetySimulator',
      body=[
        Expr(
          value=Constant(value='Simulates safety assessments.')),
        AsyncFunctionDef(
          name='run',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='request',
                annotation=Name(id='SafetySimRequest', ctx=Load()))]),
          body=[
            Assign(
              targets=[
                Name(id='base_risk', ctx=Store())],
              value=IfExp(
                test=Compare(
                  left=Call(
                    func=Name(id='len', ctx=Load()),
                    args=[
                      Attribute(
                        value=Name(id='request', ctx=Load()),
                        attr='text',
                        ctx=Load())]),
                  ops=[
                    Lt()],
                  comparators=[
                    Constant(value=100)]),
                body=Constant(value=0.2),
                orelse=Constant(value=0.4))),
            Assign(
              targets=[
                Name(id='pii_risk', ctx=Store())],
              value=Call(
                func=Name(id='round', ctx=Load()),
                args=[
                  Call(
                    func=Name(id='min', ctx=Load()),
                    args=[
                      Constant(value=1.0),
                      BinOp(
                        left=Name(id='base_risk', ctx=Load()),
                        op=Add(),
                        right=Call(
                          func=Attribute(
                            value=Name(id='random', ctx=Load()),
                            attr='uniform',
                            ctx=Load()),
                          args=[
                            Constant(value=0.0),
                            Constant(value=0.4)]))]),
                  Constant(value=3)])),
            Assign(
              targets=[
                Name(id='injection_risk', ctx=Store())],
              value=Call(
                func=Name(id='round', ctx=Load()),
                args=[
                  Call(
                    func=Name(id='min', ctx=Load()),
                    args=[
                      Constant(value=1.0),
                      BinOp(
                        left=Constant(value=0.1),
                        op=Add(),
                        right=Call(
                          func=Attribute(
                            value=Name(id='random', ctx=Load()),
                            attr='uniform',
                            ctx=Load()),
                          args=[
                            Constant(value=0.0),
                            Constant(value=0.5)]))]),
                  Constant(value=3)])),
            Assign(
              targets=[
                Name(id='bias_risk', ctx=Store())],
              value=Call(
                func=Name(id='round', ctx=Load()),
                args=[
                  Call(
                    func=Name(id='max', ctx=Load()),
                    args=[
                      Constant(value=0.0),
                      BinOp(
                        left=Constant(value=0.05),
                        op=Add(),
                        right=Call(
                          func=Attribute(
                            value=Name(id='random', ctx=Load()),
                            attr='uniform',
                            ctx=Load()),
                          args=[
                            Constant(value=0.0),
                            Constant(value=0.4)]))]),
                  Constant(value=3)])),
            Assign(
              targets=[
                Name(id='metrics', ctx=Store())],
              value=Call(
                func=Name(id='SafetySimMetrics', ctx=Load()),
                keywords=[
                  keyword(
                    arg='pii_risk',
                    value=Name(id='pii_risk', ctx=Load())),
                  keyword(
                    arg='injection_risk',
                    value=Name(id='injection_risk', ctx=Load())),
                  keyword(
                    arg='bias_risk',
                    value=Name(id='bias_risk', ctx=Load()))])),
            Assign(
              targets=[
                Name(id='snippet', ctx=Store())],
              value=Subscript(
                value=Attribute(
                  value=Name(id='request', ctx=Load()),
                  attr='text',
                  ctx=Load()),
                slice=Slice(
                  upper=Constant(value=100)),
                ctx=Load())),
            Return(
              value=Call(
                func=Name(id='SafetySimResult', ctx=Load()),
                keywords=[
                  keyword(
                    arg='simulation_id',
                    value=Attribute(
                      value=Name(id='request', ctx=Load()),
                      attr='simulation_id',
                      ctx=Load())),
                  keyword(
                    arg='success',
                    value=Constant(value=True)),
                  keyword(
                    arg='metrics',
                    value=Call(
                      func=Name(id='model_to_payload', ctx=Load()),
                      args=[
                        Name(id='metrics', ctx=Load())])),
                  keyword(
                    arg='details',
                    value=Dict(
                      keys=[
                        Constant(value='text_snippet')],
                      values=[
                        Name(id='snippet', ctx=Load())]))]))],
          returns=Name(id='SafetySimResult', ctx=Load()))])])