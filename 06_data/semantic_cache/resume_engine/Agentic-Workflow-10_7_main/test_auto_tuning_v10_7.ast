Module(
  body=[
    Import(
      names=[
        alias(name='copy')]),
    Import(
      names=[
        alias(name='pytest')]),
    ImportFrom(
      module='core_v10_7',
      names=[
        alias(name='ConfigV10_7'),
        alias(name='MetricsCollector'),
        alias(name='PolicyAutoTuner'),
        alias(name='TuningProfile')],
      level=0),
    Assign(
      targets=[
        Name(id='CONFIG_PATH', ctx=Store())],
      value=Constant(value='master_config_v10_7.json')),
    FunctionDef(
      name='_enabled_config',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='cfg', ctx=Store())],
          value=Call(
            func=Name(id='ConfigV10_7', ctx=Load()),
            args=[
              Name(id='CONFIG_PATH', ctx=Load())])),
        Assign(
          targets=[
            Attribute(
              value=Attribute(
                value=Name(id='cfg', ctx=Load()),
                attr='auto_tuning_config',
                ctx=Load()),
              attr='enabled',
              ctx=Store())],
          value=Constant(value=True)),
        Return(
          value=Name(id='cfg', ctx=Load()))],
      returns=Name(id='ConfigV10_7', ctx=Load())),
    FunctionDef(
      name='_make_metrics',
      args=arguments(
        vararg=arg(arg='entries')),
      body=[
        Assign(
          targets=[
            Name(id='metrics', ctx=Store())],
          value=Call(
            func=Name(id='MetricsCollector', ctx=Load()))),
        For(
          target=Name(id='entry', ctx=Store()),
          iter=Name(id='entries', ctx=Load()),
          body=[
            Expr(
              value=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='metrics', ctx=Load()),
                    attr='metrics',
                    ctx=Load()),
                  attr='append',
                  ctx=Load()),
                args=[
                  Name(id='entry', ctx=Load())]))]),
        Return(
          value=Name(id='metrics', ctx=Load()))]),
    FunctionDef(
      name='_drafting_metric',
      args=arguments(
        args=[
          arg(
            arg='duration_ms',
            annotation=Name(id='float', ctx=Load())),
          arg(
            arg='workflow_id',
            annotation=Name(id='str', ctx=Load()))],
        defaults=[
          Constant(value='wf-1')]),
      body=[
        Return(
          value=Dict(
            keys=[
              Constant(value='agent_name'),
              Constant(value='task_name'),
              Constant(value='duration_ms'),
              Constant(value='success'),
              Constant(value='metadata')],
            values=[
              Constant(value='DraftingStrategistTool'),
              Constant(value='tool_drafting_llm'),
              Name(id='duration_ms', ctx=Load()),
              Constant(value=True),
              Dict(
                keys=[
                  Constant(value='workflow_id')],
                values=[
                  Name(id='workflow_id', ctx=Load())])]))]),
    FunctionDef(
      name='_rag_metric',
      args=arguments(
        args=[
          arg(
            arg='duration_ms',
            annotation=Name(id='float', ctx=Load())),
          arg(
            arg='workflow_id',
            annotation=Name(id='str', ctx=Load()))],
        defaults=[
          Constant(value='wf-1')]),
      body=[
        Return(
          value=Dict(
            keys=[
              Constant(value='agent_name'),
              Constant(value='task_name'),
              Constant(value='duration_ms'),
              Constant(value='success'),
              Constant(value='metadata')],
            values=[
              Constant(value='RAG_SearchAgent'),
              Constant(value='run_agentic_rag'),
              Name(id='duration_ms', ctx=Load()),
              Constant(value=True),
              Dict(
                keys=[
                  Constant(value='workflow_id')],
                values=[
                  Name(id='workflow_id', ctx=Load())])]))]),
    FunctionDef(
      name='_drafting_signal_metric',
      args=arguments(
        args=[
          arg(
            arg='stage',
            annotation=Name(id='str', ctx=Load()))]),
      body=[
        Return(
          value=Dict(
            keys=[
              Constant(value='agent_name'),
              Constant(value='task_name'),
              Constant(value='duration_ms'),
              Constant(value='success'),
              Constant(value='metadata')],
            values=[
              Constant(value='ArbitrationEngine'),
              Constant(value='run_check'),
              Constant(value=5),
              Constant(value=True),
              Dict(
                keys=[
                  Constant(value='stage'),
                  Constant(value='workflow_id')],
                values=[
                  Name(id='stage', ctx=Load()),
                  Constant(value='wf-2')])]))]),
    FunctionDef(
      name='test_auto_tuning_disabled_no_change',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='cfg', ctx=Store())],
          value=Call(
            func=Name(id='ConfigV10_7', ctx=Load()),
            args=[
              Name(id='CONFIG_PATH', ctx=Load())])),
        Assign(
          targets=[
            Name(id='metrics', ctx=Store())],
          value=Call(
            func=Name(id='_make_metrics', ctx=Load()),
            args=[
              Call(
                func=Name(id='_drafting_metric', ctx=Load()),
                args=[
                  Constant(value=2500)])])),
        Assign(
          targets=[
            Name(id='tuner', ctx=Store())],
          value=Call(
            func=Name(id='PolicyAutoTuner', ctx=Load()),
            args=[
              Name(id='cfg', ctx=Load()),
              Name(id='metrics', ctx=Load())])),
        Assign(
          targets=[
            Name(id='profile', ctx=Store())],
          value=Call(
            func=Name(id='TuningProfile', ctx=Load()))),
        Assign(
          targets=[
            Name(id='before', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='copy', ctx=Load()),
              attr='deepcopy',
              ctx=Load()),
            args=[
              Call(
                func=Attribute(
                  value=Name(id='profile', ctx=Load()),
                  attr='model_dump',
                  ctx=Load()))])),
        Assign(
          targets=[
            Name(id='updated', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='tuner', ctx=Load()),
              attr='tune_profile',
              ctx=Load()),
            args=[
              Name(id='profile', ctx=Load())])),
        Assert(
          test=Compare(
            left=Attribute(
              value=Name(id='updated', ctx=Load()),
              attr='temperature',
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Subscript(
                value=Name(id='before', ctx=Load()),
                slice=Constant(value='temperature'),
                ctx=Load())])),
        Assert(
          test=Compare(
            left=Attribute(
              value=Name(id='updated', ctx=Load()),
              attr='history',
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              List(ctx=Load())])),
        Assert(
          test=Compare(
            left=Attribute(
              value=Name(id='updated', ctx=Load()),
              attr='drafting_expand_summary',
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Subscript(
                value=Name(id='before', ctx=Load()),
                slice=Constant(value='drafting_expand_summary'),
                ctx=Load())]))]),
    FunctionDef(
      name='test_temperature_adjusts_with_latency',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='cfg', ctx=Store())],
          value=Call(
            func=Name(id='_enabled_config', ctx=Load()))),
        Assign(
          targets=[
            Name(id='metrics', ctx=Store())],
          value=Call(
            func=Name(id='_make_metrics', ctx=Load()),
            args=[
              Call(
                func=Name(id='_drafting_metric', ctx=Load()),
                args=[
                  Constant(value=4000)])])),
        Assign(
          targets=[
            Name(id='tuner', ctx=Store())],
          value=Call(
            func=Name(id='PolicyAutoTuner', ctx=Load()),
            args=[
              Name(id='cfg', ctx=Load()),
              Name(id='metrics', ctx=Load())])),
        Assign(
          targets=[
            Name(id='profile', ctx=Store())],
          value=Call(
            func=Name(id='TuningProfile', ctx=Load()),
            keywords=[
              keyword(
                arg='temperature',
                value=Constant(value=0.5))])),
        Assign(
          targets=[
            Name(id='original_prune', ctx=Store())],
          value=Attribute(
            value=Name(id='profile', ctx=Load()),
            attr='prune_factor',
            ctx=Load())),
        Assign(
          targets=[
            Name(id='updated', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='tuner', ctx=Load()),
              attr='tune_profile',
              ctx=Load()),
            args=[
              Name(id='profile', ctx=Load())])),
        Assert(
          test=Compare(
            left=Call(
              func=Attribute(
                value=Name(id='pytest', ctx=Load()),
                attr='approx',
                ctx=Load()),
              args=[
                Attribute(
                  value=Name(id='updated', ctx=Load()),
                  attr='temperature',
                  ctx=Load())]),
            ops=[
              Eq()],
            comparators=[
              Constant(value=0.45)])),
        Assert(
          test=Compare(
            left=Attribute(
              value=Name(id='updated', ctx=Load()),
              attr='prune_factor',
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Name(id='original_prune', ctx=Load())]))]),
    FunctionDef(
      name='test_rag_force_multi_tool_engages',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='cfg', ctx=Store())],
          value=Call(
            func=Name(id='_enabled_config', ctx=Load()))),
        Assign(
          targets=[
            Name(id='metrics', ctx=Store())],
          value=Call(
            func=Name(id='_make_metrics', ctx=Load()),
            args=[
              Call(
                func=Name(id='_drafting_metric', ctx=Load()),
                args=[
                  Constant(value=2000)]),
              Call(
                func=Name(id='_rag_metric', ctx=Load()),
                args=[
                  BinOp(
                    left=Attribute(
                      value=Attribute(
                        value=Name(id='cfg', ctx=Load()),
                        attr='auto_tuning_config',
                        ctx=Load()),
                      attr='latency_target_ms',
                      ctx=Load()),
                    op=Mult(),
                    right=Constant(value=1.2))])])),
        Assign(
          targets=[
            Name(id='tuner', ctx=Store())],
          value=Call(
            func=Name(id='PolicyAutoTuner', ctx=Load()),
            args=[
              Name(id='cfg', ctx=Load()),
              Name(id='metrics', ctx=Load())])),
        Assign(
          targets=[
            Name(id='profile', ctx=Store())],
          value=Call(
            func=Name(id='TuningProfile', ctx=Load()))),
        Assign(
          targets=[
            Name(id='updated', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='tuner', ctx=Load()),
              attr='tune_profile',
              ctx=Load()),
            args=[
              Name(id='profile', ctx=Load())])),
        Assert(
          test=Compare(
            left=Attribute(
              value=Name(id='updated', ctx=Load()),
              attr='rag_force_multi_tool',
              ctx=Load()),
            ops=[
              Is()],
            comparators=[
              Constant(value=True)]))]),
    FunctionDef(
      name='test_drafting_overrides_trigger',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='cfg', ctx=Store())],
          value=Call(
            func=Name(id='_enabled_config', ctx=Load()))),
        Assign(
          targets=[
            Name(id='metrics', ctx=Store())],
          value=Call(
            func=Name(id='_make_metrics', ctx=Load()),
            args=[
              Call(
                func=Name(id='_drafting_metric', ctx=Load()),
                args=[
                  Constant(value=2000)]),
              Call(
                func=Name(id='_drafting_signal_metric', ctx=Load()),
                args=[
                  Constant(value='draft_post_assembly')])])),
        Assign(
          targets=[
            Name(id='tuner', ctx=Store())],
          value=Call(
            func=Name(id='PolicyAutoTuner', ctx=Load()),
            args=[
              Name(id='cfg', ctx=Load()),
              Name(id='metrics', ctx=Load())])),
        Assign(
          targets=[
            Name(id='profile', ctx=Store())],
          value=Call(
            func=Name(id='TuningProfile', ctx=Load()))),
        Assign(
          targets=[
            Name(id='updated', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='tuner', ctx=Load()),
              attr='tune_profile',
              ctx=Load()),
            args=[
              Name(id='profile', ctx=Load())])),
        Assert(
          test=Compare(
            left=Attribute(
              value=Name(id='updated', ctx=Load()),
              attr='drafting_expand_summary',
              ctx=Load()),
            ops=[
              Is()],
            comparators=[
              Constant(value=True)])),
        Assert(
          test=Compare(
            left=Attribute(
              value=Name(id='updated', ctx=Load()),
              attr='drafting_boost_metrics',
              ctx=Load()),
            ops=[
              Is()],
            comparators=[
              Constant(value=True)]))]),
    FunctionDef(
      name='test_profile_history_populates',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='cfg', ctx=Store())],
          value=Call(
            func=Name(id='_enabled_config', ctx=Load()))),
        Assign(
          targets=[
            Name(id='metrics', ctx=Store())],
          value=Call(
            func=Name(id='_make_metrics', ctx=Load()),
            args=[
              Call(
                func=Name(id='_drafting_metric', ctx=Load()),
                args=[
                  Constant(value=2000)])])),
        Assign(
          targets=[
            Name(id='tuner', ctx=Store())],
          value=Call(
            func=Name(id='PolicyAutoTuner', ctx=Load()),
            args=[
              Name(id='cfg', ctx=Load()),
              Name(id='metrics', ctx=Load())])),
        Assign(
          targets=[
            Name(id='profile', ctx=Store())],
          value=Call(
            func=Name(id='TuningProfile', ctx=Load()))),
        Assign(
          targets=[
            Name(id='updated', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='tuner', ctx=Load()),
              attr='tune_profile',
              ctx=Load()),
            args=[
              Name(id='profile', ctx=Load())])),
        Assert(
          test=Compare(
            left=Call(
              func=Name(id='len', ctx=Load()),
              args=[
                Attribute(
                  value=Name(id='updated', ctx=Load()),
                  attr='history',
                  ctx=Load())]),
            ops=[
              Eq()],
            comparators=[
              Constant(value=1)])),
        Assign(
          targets=[
            Name(id='record', ctx=Store())],
          value=Subscript(
            value=Attribute(
              value=Name(id='updated', ctx=Load()),
              attr='history',
              ctx=Load()),
            slice=Constant(value=0),
            ctx=Load())),
        Assert(
          test=Compare(
            left=Constant(value='timestamp'),
            ops=[
              In()],
            comparators=[
              Name(id='record', ctx=Load())])),
        Assert(
          test=Compare(
            left=Subscript(
              value=Name(id='record', ctx=Load()),
              slice=Constant(value='temperature'),
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Attribute(
                value=Name(id='updated', ctx=Load()),
                attr='temperature',
                ctx=Load())])),
        Assert(
          test=Compare(
            left=Attribute(
              value=Name(id='updated', ctx=Load()),
              attr='last_update',
              ctx=Load()),
            ops=[
              GtE()],
            comparators=[
              Subscript(
                value=Name(id='record', ctx=Load()),
                slice=Constant(value='timestamp'),
                ctx=Load())]))])])