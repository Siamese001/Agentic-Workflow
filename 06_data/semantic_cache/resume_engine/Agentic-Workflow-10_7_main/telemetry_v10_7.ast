Module(
  body=[
    Expr(
      value=Constant(value='\nTelemetry helpers for v10.7.\n\nThis module provides a unified event envelope for:\n - LLM metrics\n - tool execution metrics\n - cache events (exact + semantic)\n - agent routing decisions\n - pruning outcomes\n - MCP-integrated telemetry streams\n\nAll telemetry events are emitted via MCP (if present) and mirrored to local logs.\nExisting calls to log_event(...) continue to work unchanged.\n')),
    ImportFrom(
      module='__future__',
      names=[
        alias(name='annotations')],
      level=0),
    Import(
      names=[
        alias(name='logging')]),
    ImportFrom(
      module='datetime',
      names=[
        alias(name='datetime')],
      level=0),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Any'),
        alias(name='Dict'),
        alias(name='Optional')],
      level=0),
    ImportFrom(
      module='mcp',
      names=[
        alias(name='emit_event')],
      level=0),
    Assign(
      targets=[
        Name(id='logger', ctx=Store())],
      value=Call(
        func=Attribute(
          value=Name(id='logging', ctx=Load()),
          attr='getLogger',
          ctx=Load()),
        args=[
          Constant(value='telemetry_v10_7')])),
    FunctionDef(
      name='check_langgraph',
      args=arguments(),
      body=[
        Expr(
          value=Constant(value='Capability-based LangGraph health check used by diagnostics.')),
        Try(
          body=[
            ImportFrom(
              module='langgraph.graph',
              names=[
                alias(name='StateGraph')],
              level=0),
            Return(
              value=Dict(
                keys=[
                  Constant(value='ok'),
                  Constant(value='info')],
                values=[
                  Constant(value=True),
                  Constant(value='StateGraph import succeeded')]))],
          handlers=[
            ExceptHandler(
              type=Name(id='Exception', ctx=Load()),
              name='exc',
              body=[
                Return(
                  value=Dict(
                    keys=[
                      Constant(value='ok'),
                      Constant(value='error')],
                    values=[
                      Constant(value=False),
                      Call(
                        func=Name(id='str', ctx=Load()),
                        args=[
                          Name(id='exc', ctx=Load())])]))])])],
      returns=Subscript(
        value=Name(id='Dict', ctx=Load()),
        slice=Tuple(
          elts=[
            Name(id='str', ctx=Load()),
            Name(id='Any', ctx=Load())],
          ctx=Load()),
        ctx=Load())),
    FunctionDef(
      name='_build_envelope',
      args=arguments(
        args=[
          arg(
            arg='agent',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='event',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='payload',
            annotation=Subscript(
              value=Name(id='Dict', ctx=Load()),
              slice=Tuple(
                elts=[
                  Name(id='str', ctx=Load()),
                  Name(id='Any', ctx=Load())],
                ctx=Load()),
              ctx=Load()))],
        kwonlyargs=[
          arg(
            arg='workflow_id',
            annotation=Subscript(
              value=Name(id='Optional', ctx=Load()),
              slice=Name(id='str', ctx=Load()),
              ctx=Load())),
          arg(
            arg='node',
            annotation=Subscript(
              value=Name(id='Optional', ctx=Load()),
              slice=Name(id='str', ctx=Load()),
              ctx=Load())),
          arg(
            arg='category',
            annotation=Subscript(
              value=Name(id='Optional', ctx=Load()),
              slice=Name(id='str', ctx=Load()),
              ctx=Load()))],
        kw_defaults=[
          Constant(value=None),
          Constant(value=None),
          Constant(value=None)]),
      body=[
        Expr(
          value=Constant(value='\n    Build a standardized telemetry envelope for v10.7.\n    This allows all components (LLM, Tools, Agents, Cache, Meta Learning)\n    to produce consistent MCP-compatible events.\n    ')),
        Assign(
          targets=[
            Name(id='envelope', ctx=Store())],
          value=Dict(
            keys=[
              Constant(value='timestamp'),
              Constant(value='agent'),
              Constant(value='event'),
              Constant(value='category'),
              Constant(value='workflow_id'),
              Constant(value='node'),
              Constant(value='payload')],
            values=[
              Call(
                func=Attribute(
                  value=Call(
                    func=Attribute(
                      value=Name(id='datetime', ctx=Load()),
                      attr='utcnow',
                      ctx=Load())),
                  attr='isoformat',
                  ctx=Load())),
              Name(id='agent', ctx=Load()),
              Name(id='event', ctx=Load()),
              BoolOp(
                op=Or(),
                values=[
                  Name(id='category', ctx=Load()),
                  Constant(value='runtime')]),
              Name(id='workflow_id', ctx=Load()),
              Name(id='node', ctx=Load()),
              BoolOp(
                op=Or(),
                values=[
                  Name(id='payload', ctx=Load()),
                  Dict()])])),
        Return(
          value=DictComp(
            key=Name(id='k', ctx=Load()),
            value=Name(id='v', ctx=Load()),
            generators=[
              comprehension(
                target=Tuple(
                  elts=[
                    Name(id='k', ctx=Store()),
                    Name(id='v', ctx=Store())],
                  ctx=Store()),
                iter=Call(
                  func=Attribute(
                    value=Name(id='envelope', ctx=Load()),
                    attr='items',
                    ctx=Load())),
                ifs=[
                  Compare(
                    left=Name(id='v', ctx=Load()),
                    ops=[
                      IsNot()],
                    comparators=[
                      Constant(value=None)])],
                is_async=0)]))],
      returns=Subscript(
        value=Name(id='Dict', ctx=Load()),
        slice=Tuple(
          elts=[
            Name(id='str', ctx=Load()),
            Name(id='Any', ctx=Load())],
          ctx=Load()),
        ctx=Load())),
    FunctionDef(
      name='log_event',
      args=arguments(
        args=[
          arg(
            arg='agent',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='event',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='data',
            annotation=Subscript(
              value=Name(id='Optional', ctx=Load()),
              slice=Subscript(
                value=Name(id='Dict', ctx=Load()),
                slice=Tuple(
                  elts=[
                    Name(id='str', ctx=Load()),
                    Name(id='Any', ctx=Load())],
                  ctx=Load()),
                ctx=Load()),
              ctx=Load()))],
        kwonlyargs=[
          arg(
            arg='workflow_id',
            annotation=Subscript(
              value=Name(id='Optional', ctx=Load()),
              slice=Name(id='str', ctx=Load()),
              ctx=Load())),
          arg(
            arg='node',
            annotation=Subscript(
              value=Name(id='Optional', ctx=Load()),
              slice=Name(id='str', ctx=Load()),
              ctx=Load())),
          arg(
            arg='category',
            annotation=Subscript(
              value=Name(id='Optional', ctx=Load()),
              slice=Name(id='str', ctx=Load()),
              ctx=Load()))],
        kw_defaults=[
          Constant(value=None),
          Constant(value=None),
          Constant(value=None)],
        defaults=[
          Constant(value=None)]),
      body=[
        Expr(
          value=Constant(value='\n    Emit a telemetry event via MCP and local logging.\n    Fully backwards compatible with earlier versions, but now supports:\n\n        log_event(\n            agent="StrategyStack",\n            event="branch_selected",\n            data={"branch_id": 3},\n            workflow_id=context.workflow_id,\n            node="STRATEGY_TOT_VOTE",\n            category="decision"\n        )\n\n    Parameters:\n      agent      - Logical agent/tool name\n      event      - Event type (e.g. "cache_hit", "latency_fallback")\n      data       - Free-form metadata\n      workflow_id - Optional workflow identifier\n      node        - Optional graph node emitting the event\n      category    - Optional event category for grouping\n    ')),
        Assign(
          targets=[
            Name(id='data', ctx=Store())],
          value=BoolOp(
            op=Or(),
            values=[
              Name(id='data', ctx=Load()),
              Dict()])),
        Assign(
          targets=[
            Name(id='env', ctx=Store())],
          value=Call(
            func=Name(id='_build_envelope', ctx=Load()),
            keywords=[
              keyword(
                arg='agent',
                value=Name(id='agent', ctx=Load())),
              keyword(
                arg='event',
                value=Name(id='event', ctx=Load())),
              keyword(
                arg='payload',
                value=Name(id='data', ctx=Load())),
              keyword(
                arg='workflow_id',
                value=Name(id='workflow_id', ctx=Load())),
              keyword(
                arg='node',
                value=Name(id='node', ctx=Load())),
              keyword(
                arg='category',
                value=Name(id='category', ctx=Load()))])),
        Try(
          body=[
            Expr(
              value=Call(
                func=Name(id='emit_event', ctx=Load()),
                args=[
                  Name(id='env', ctx=Load())])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='logger', ctx=Load()),
                  attr='debug',
                  ctx=Load()),
                args=[
                  Constant(value='Telemetry emitted: %s'),
                  Name(id='env', ctx=Load())]))],
          handlers=[
            ExceptHandler(
              type=Name(id='Exception', ctx=Load()),
              name='exc',
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='logger', ctx=Load()),
                      attr='warning',
                      ctx=Load()),
                    args=[
                      JoinedStr(
                        values=[
                          Constant(value='Failed to emit MCP telemetry: '),
                          FormattedValue(
                            value=Name(id='exc', ctx=Load()),
                            conversion=-1)])])),
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='logger', ctx=Load()),
                      attr='debug',
                      ctx=Load()),
                    args=[
                      Constant(value='Failed payload was: %s'),
                      Name(id='env', ctx=Load())]))])])],
      returns=Constant(value=None)),
    Assign(
      targets=[
        Name(id='__all__', ctx=Store())],
      value=List(
        elts=[
          Constant(value='log_event'),
          Constant(value='check_langgraph')],
        ctx=Load()))])