                  args=[
                    Constant(value='*.py')])])])]),
    FunctionDef(
      name='_extract_imports',
      args=arguments(
        args=[
          arg(
            arg='tree',
            annotation=Attribute(
              value=Name(id='ast', ctx=Load()),
              attr='Module',
              ctx=Load()))]),
      body=[
        Assign(
          targets=[
            Name(id='imports', ctx=Store())],
          value=List(ctx=Load())),
        For(
          target=Name(id='node', ctx=Store()),
          iter=Attribute(
            value=Name(id='tree', ctx=Load()),
            attr='body',
            ctx=Load()),
          body=[
            If(
              test=Call(
                func=Name(id='isinstance', ctx=Load()),
                args=[
                  Name(id='node', ctx=Load()),
                  Attribute(
                    value=Name(id='ast', ctx=Load()),
                    attr='Import',
                    ctx=Load())]),
              body=[
                For(
                  target=Name(id='n', ctx=Store()),
                  iter=Attribute(
                    value=Name(id='node', ctx=Load()),
                    attr='names',
                    ctx=Load()),
                  body=[
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Name(id='imports', ctx=Load()),
                          attr='append',
                          ctx=Load()),
                        args=[
                          Attribute(
                            value=Name(id='n', ctx=Load()),
                            attr='name',
                            ctx=Load())]))])],
              orelse=[
                If(
                  test=Call(
                    func=Name(id='isinstance', ctx=Load()),
                    args=[
                      Name(id='node', ctx=Load()),
                      Attribute(
                        value=Name(id='ast', ctx=Load()),
                        attr='ImportFrom',
                        ctx=Load())]),
                  body=[
                    If(
                      test=Attribute(
                        value=Name(id='node', ctx=Load()),
                        attr='module',
                        ctx=Load()),
                      body=[
                        Expr(
                          value=Call(
                            func=Attribute(
                              value=Name(id='imports', ctx=Load()),
                              attr='append',
                              ctx=Load()),
                            args=[
                              Attribute(
                                value=Name(id='node', ctx=Load()),
                                attr='module',
                                ctx=Load())]))])])])]),
        Return(
          value=Name(id='imports', ctx=Load()))]),
    FunctionDef(
      name='test_no_circular_imports',
      args=arguments(),
      body=[
        Expr(
          value=Constant(value='\n    Builds a simple dependency graph and ensures no A → B → A cycles.\n    We only check stack files because other layers have external deps.\n    ')),
        Assign(
          targets=[
            Name(id='graph', ctx=Store())],
          value=Dict()),
        Assign(
          targets=[
            Name(id='files', ctx=Store())],
          value=Call(
            func=Name(id='list', ctx=Load()),
            args=[
              Call(
                func=Attribute(
                  value=Name(id='STACKS_DIR', ctx=Load()),
                  attr='rglob',
                  ctx=Load()),
                args=[
                  Constant(value='*.py')])])),
        For(
          target=Name(id='f', ctx=Store()),
          iter=Name(id='files', ctx=Load()),
          body=[
            Assign(
              targets=[
                Name(id='tree', ctx=Store())],
              value=Call(
                func=Name(id='load_ast', ctx=Load()),
                args=[
                  Name(id='f', ctx=Load())])),
            Assign(
              targets=[
                Name(id='imports', ctx=Store())],
              value=Call(
                func=Name(id='_extract_imports', ctx=Load()),
                args=[
                  Name(id='tree', ctx=Load())])),
            Assign(
              targets=[
                Subscript(
                  value=Name(id='graph', ctx=Load()),
                  slice=Name(id='f', ctx=Load()),
                  ctx=Store())],
              value=List(ctx=Load())),
            For(
              target=Name(id='imp', ctx=Store()),
              iter=Name(id='imports', ctx=Load()),
              body=[
                For(
                  target=Name(id='candidate', ctx=Store()),
                  iter=Name(id='files', ctx=Load()),
                  body=[
                    If(
                      test=BoolOp(
                        op=Or(),
                        values=[
                          Compare(
                            left=Attribute(
                              value=Name(id='candidate', ctx=Load()),
                              attr='stem',
                              ctx=Load()),
                            ops=[
                              Eq()],
                            comparators=[
                              Name(id='imp', ctx=Load())]),
                          Compare(
                            left=Attribute(
                              value=Name(id='candidate', ctx=Load()),
                              attr='stem',
                              ctx=Load()),
                            ops=[
                              Eq()],
                            comparators=[
                              Subscript(
                                value=Call(
                                  func=Attribute(
                                    value=Name(id='imp', ctx=Load()),
                                    attr='split',
                                    ctx=Load()),
                                  args=[
                                    Constant(value='.')]),
                                slice=UnaryOp(
                                  op=USub(),
                                  operand=Constant(value=1)),
                                ctx=Load())])]),
                      body=[
                        Expr(
                          value=Call(
                            func=Attribute(
                              value=Subscript(
                                value=Name(id='graph', ctx=Load()),
                                slice=Name(id='f', ctx=Load()),
                                ctx=Load()),
                              attr='append',
                              ctx=Load()),
                            args=[
                              Name(id='candidate', ctx=Load())]))])])])]),
        Assign(
          targets=[
            Name(id='visited', ctx=Store())],
          value=Call(
            func=Name(id='set', ctx=Load()))),
        Assign(
          targets=[
            Name(id='stack', ctx=Store())],
          value=Call(
            func=Name(id='set', ctx=Load()))),
        FunctionDef(
          name='dfs',
          args=arguments(
            args=[
              arg(arg='node')]),
          body=[
            If(
              test=Compare(
                left=Name(id='node', ctx=Load()),
                ops=[
                  In()],
                comparators=[
                  Name(id='stack', ctx=Load())]),
              body=[
                Raise(
                  exc=Call(
                    func=Name(id='AssertionError', ctx=Load()),
                    args=[
                      JoinedStr(
                        values=[
                          Constant(value='Circular import detected at: '),
                          FormattedValue(
                            value=Name(id='node', ctx=Load()),
                            conversion=-1)])]))]),
            If(
              test=Compare(
                left=Name(id='node', ctx=Load()),
                ops=[
                  In()],
                comparators=[
                  Name(id='visited', ctx=Load())]),
              body=[
                Return()]),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='visited', ctx=Load()),
                  attr='add',
                  ctx=Load()),
                args=[
                  Name(id='node', ctx=Load())])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='stack', ctx=Load()),
                  attr='add',
                  ctx=Load()),
                args=[
                  Name(id='node', ctx=Load())])),
            For(
              target=Name(id='nxt', ctx=Store()),
              iter=Subscript(
                value=Name(id='graph', ctx=Load()),
                slice=Name(id='node', ctx=Load()),
                ctx=Load()),
              body=[
                Expr(
                  value=Call(
                    func=Name(id='dfs', ctx=Load()),
                    args=[
                      Name(id='nxt', ctx=Load())]))]),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='stack', ctx=Load()),
                  attr='remove',
                  ctx=Load()),
                args=[
                  Name(id='node', ctx=Load())]))]),
        For(
          target=Name(id='f', ctx=Store()),
          iter=Name(id='files', ctx=Load()),
          body=[
            Expr(
              value=Call(
                func=Name(id='dfs', ctx=Load()),
                args=[
                  Name(id='f', ctx=Load())]))])],
      decorator_list=[
        Attribute(
          value=Attribute(
            value=Name(id='pytest', ctx=Load()),
            attr='mark',
            ctx=Load()),
          attr='architecture',
          ctx=Load())])])