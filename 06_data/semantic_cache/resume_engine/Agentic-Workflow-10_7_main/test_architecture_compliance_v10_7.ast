              test=Compare(
                left=Name(id='other_stack', ctx=Load()),
                ops=[
                  In()],
                comparators=[
                  Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='path', ctx=Load()),
                        attr='name',
                        ctx=Load()),
                      attr='lower',
                      ctx=Load()))]),
              body=[
                Continue()]),
            Assign(
              targets=[
                Name(id='import_pattern', ctx=Store())],
              value=JoinedStr(
                values=[
                  Constant(value='import '),
                  FormattedValue(
