    FunctionDef(
      name='test_agents_have_run_method',
      args=arguments(
        args=[
          arg(
            arg='pyfile',
            annotation=Name(id='Path', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value="\n    Ensures every agent class in stack directories has a 'run' method.\n    This enforces the agent interface.\n\n    Only classes ending in 'Agent' are checked.\n    ")),
        Assign(
          targets=[
            Name(id='tree', ctx=Store())],
          value=Call(
            func=Name(id='load_ast', ctx=Load()),
            args=[
              Name(id='pyfile', ctx=Load())])),
        For(
          target=Name(id='cls', ctx=Store()),
          iter=Call(
            func=Name(id='_get_classes_with_name', ctx=Load()),
            args=[
              Name(id='tree', ctx=Load())]),
          body=[
            If(
              test=UnaryOp(
                op=Not(),
                operand=Call(
                  func=Attribute(
                    value=Attribute(
                      value=Name(id='cls', ctx=Load()),
                      attr='name',
                      ctx=Load()),
                    attr='endswith',
                    ctx=Load()),
                  args=[
                    Constant(value='Agent')])),
              body=[
                Continue()]),
            Assign(
              targets=[
                Name(id='has_run', ctx=Store())],
              value=Call(
                func=Name(id='any', ctx=Load()),
                args=[
                  GeneratorExp(
                    elt=BoolOp(
                      op=And(),
                      values=[
                        Call(
                          func=Name(id='isinstance', ctx=Load()),
                          args=[
                            Name(id='n', ctx=Load()),
                            Attribute(
                              value=Name(id='ast', ctx=Load()),
                              attr='FunctionDef',
                              ctx=Load())]),
                        Compare(
                          left=Attribute(
                            value=Name(id='n', ctx=Load()),
                            attr='name',
                            ctx=Load()),
                          ops=[
                            Eq()],
                          comparators=[
                            Constant(value='run')])]),
                    generators=[
                      comprehension(
                        target=Name(id='n', ctx=Store()),
                        iter=Attribute(
                          value=Name(id='cls', ctx=Load()),
                          attr='body',
                          ctx=Load()),
                        is_async=0)])])),
            Assert(
              test=Name(id='has_run', ctx=Load()),
              msg=JoinedStr(
                values=[
                  Constant(value="Agent '"),
                  FormattedValue(
                    value=Attribute(
                      value=Name(id='cls', ctx=Load()),
                      attr='name',
                      ctx=Load()),
                    conversion=-1),
                  Constant(value="' must implement a run() method ("),
                  FormattedValue(
                    value=Name(id='pyfile', ctx=Load()),
                    conversion=-1),
                  Constant(value=')')]))])],
      decorator_list=[
        Attribute(
          value=Attribute(
            value=Name(id='pytest', ctx=Load()),
            attr='mark',
            ctx=Load()),
          attr='architecture',
          ctx=Load()),
        Call(
          func=Attribute(
