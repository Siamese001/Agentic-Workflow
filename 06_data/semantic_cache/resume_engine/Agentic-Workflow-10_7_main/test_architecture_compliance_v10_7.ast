                    attr='rglob',
                    ctx=Load()),
                  args=[
                    Constant(value='*.py')])])])]),
    FunctionDef(
      name='test_no_context_instantiation',
      args=arguments(
        args=[
          arg(
            arg='path',
            annotation=Name(id='Path', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value="\n    v10.7 design prohibits stacks from creating new WorkflowContext instances inside the agent.\n    All context objects must be injected.\n\n    Looks for 'WorkflowContext(' constructor usage.\n    ")),
        Assign(
          targets=[
            Name(id='text', ctx=Store())],
