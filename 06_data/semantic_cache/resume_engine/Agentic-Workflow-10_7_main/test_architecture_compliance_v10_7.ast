    FunctionDef(
      name='test_no_cross_stack_imports',
      args=arguments(
        args=[
          arg(
            arg='path',
            annotation=Name(id='Path', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    StrategyStack cannot import QAStack, DraftingStack cannot import RAGStack, etc.\n    Prevents architecture collapse and circular dependencies.\n    ')),
        Assign(
