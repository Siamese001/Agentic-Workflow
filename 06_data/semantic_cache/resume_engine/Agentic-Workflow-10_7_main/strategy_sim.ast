Module(
  body=[
    Expr(
      value=Constant(value='Synthetic strategy simulator.')),
    Import(
      names=[
        alias(name='random')]),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Any')],
      level=0),
    ImportFrom(
      module='simulations.models.strategy_simulation',
      names=[
        alias(name='StrategySimMetrics'),
        alias(name='StrategySimRequest'),
        alias(name='StrategySimResult')],
      level=0),
    ImportFrom(
      module='simulations.utils',
      names=[
        alias(name='model_to_payload')],
      level=0),
    ClassDef(
      name='StrategySimulator',
      body=[
        Expr(
          value=Constant(value='Runs a lightweight strategy simulation.')),
        AsyncFunctionDef(
          name='run',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='request',
                annotation=Name(id='StrategySimRequest', ctx=Load()))]),
          body=[
            Assign(
              targets=[
                Name(id='metrics', ctx=Store())],
              value=Call(
                func=Name(id='StrategySimMetrics', ctx=Load()),
                keywords=[
                  keyword(
                    arg='clarity_score',
                    value=Call(
                      func=Name(id='round', ctx=Load()),
                      args=[
                        Call(
                          func=Attribute(
                            value=Name(id='random', ctx=Load()),
                            attr='uniform',
                            ctx=Load()),
                          args=[
                            Constant(value=0.5),
                            Constant(value=1.0)]),
                        Constant(value=3)])),
                  keyword(
                    arg='alignment_score',
                    value=Call(
                      func=Name(id='round', ctx=Load()),
                      args=[
                        Call(
                          func=Attribute(
                            value=Name(id='random', ctx=Load()),
                            attr='uniform',
                            ctx=Load()),
                          args=[
                            Constant(value=0.3),
                            Constant(value=1.0)]),
                        Constant(value=3)])),
                  keyword(
                    arg='risk_score',
                    value=Call(
                      func=Name(id='round', ctx=Load()),
                      args=[
                        Call(
                          func=Attribute(
                            value=Name(id='random', ctx=Load()),
                            attr='uniform',
                            ctx=Load()),
                          args=[
                            Constant(value=0.0),
                            Constant(value=0.7)]),
                        Constant(value=3)])),
                  keyword(
                    arg='notes',
                    value=List(
                      elts=[
                        Constant(value='synthetic simulation only')],
                      ctx=Load()))])),
            Assign(
              targets=[
                Name(id='strategy_name', ctx=Store())],
              value=Constant(value=None)),
            AnnAssign(
              target=Name(id='strategy_plan', ctx=Store()),
              annotation=Name(id='Any', ctx=Load()),
              value=BoolOp(
                op=Or(),
                values=[
                  Attribute(
                    value=Name(id='request', ctx=Load()),
                    attr='strategy_plan',
                    ctx=Load()),
                  Dict()]),
              simple=1),
            If(
              test=Call(
                func=Name(id='isinstance', ctx=Load()),
                args=[
                  Name(id='strategy_plan', ctx=Load()),
                  Name(id='dict', ctx=Load())]),
              body=[
                Assign(
                  targets=[
                    Name(id='strategy_name', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='strategy_plan', ctx=Load()),
                      attr='get',
                      ctx=Load()),
                    args=[
                      Constant(value='strategy_name')]))]),
            Return(
              value=Call(
                func=Name(id='StrategySimResult', ctx=Load()),
                keywords=[
                  keyword(
                    arg='simulation_id',
                    value=Attribute(
                      value=Name(id='request', ctx=Load()),
                      attr='simulation_id',
                      ctx=Load())),
                  keyword(
                    arg='success',
                    value=Constant(value=True)),
                  keyword(
                    arg='metrics',
                    value=Call(
                      func=Name(id='model_to_payload', ctx=Load()),
                      args=[
                        Name(id='metrics', ctx=Load())])),
                  keyword(
                    arg='details',
                    value=Dict(
                      keys=[
                        Constant(value='strategy_preview')],
                      values=[
                        Name(id='strategy_name', ctx=Load())]))]))],
          returns=Name(id='StrategySimResult', ctx=Load()))])])