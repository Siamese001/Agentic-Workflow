Module(
  body=[
    Expr(
      value=Constant(value='RAG simulation models.')),
    ImportFrom(
      module='typing',
      names=[
        alias(name='List')],
      level=0),
    ImportFrom(
      module='pydantic',
      names=[
        alias(name='BaseModel')],
      level=0),
    ImportFrom(
      module='simulation_base',
      names=[
        alias(name='SimulationInput'),
        alias(name='SimulationResult')],
      level=1),
    ClassDef(
      name='RAGSimRequest',
      bases=[
        Name(id='SimulationInput', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Input payload for RAG simulation.')),
        AnnAssign(
          target=Name(id='query', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='documents', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load()),
          simple=1)]),
    ClassDef(
      name='RAGSimMetrics',
      bases=[
        Name(id='BaseModel', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Metrics produced by the RAG simulation.')),
        AnnAssign(
          target=Name(id='recall', ctx=Store()),
          annotation=Name(id='float', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='precision', ctx=Store()),
          annotation=Name(id='float', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='redundancy', ctx=Store()),
          annotation=Name(id='float', ctx=Load()),
          simple=1)]),
    ClassDef(
      name='RAGSimResult',
      bases=[
        Name(id='SimulationResult', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Result model for RAG simulations.')),
        Pass()])])