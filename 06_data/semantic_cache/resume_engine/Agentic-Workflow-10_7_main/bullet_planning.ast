        alias(name='collect_sections'),
        alias(name='describe_experience'),
        alias(name='detect_metrics'),
        alias(name='extract_job_profile'),
        alias(name='extract_resume_profile')],
      level=1),
    ClassDef(
      name='BulletPlanningStack',
      bases=[
        Name(id='BaseAgent', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Outlines which bullets to generate before invoking execution stacks.')),
        FunctionDef(
          name='__init__',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='context',
                annotation=Name(id='Any', ctx=Load())),
              arg(
                arg='debug_mode',
                annotation=Name(id='bool', ctx=Load()))],
            defaults=[
              Constant(value=False)]),
          body=[
            Expr(
              value=Call(
                func=Attribute(
                  value=Call(
                    func=Name(id='super', ctx=Load())),
                  attr='__init__',
                  ctx=Load()),
                args=[
                  Name(id='context', ctx=Load()),
                  Name(id='debug_mode', ctx=Load())]))],
          returns=Constant(value=None)),
        AsyncFunctionDef(
          name='run_async',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='state',
                annotation=Subscript(
                  value=Name(id='Dict', ctx=Load()),
                  slice=Tuple(
                    elts=[
                      Name(id='str', ctx=Load()),
                      Name(id='Any', ctx=Load())],
                    ctx=Load()),
                  ctx=Load())),
              arg(
                arg='workflow_id',
                annotation=Subscript(
                  value=Name(id='Optional', ctx=Load()),
                  slice=Name(id='str', ctx=Load()),
                  ctx=Load()))],
            defaults=[
              Constant(value=None)]),
          body=[
            Assign(
              targets=[
                Name(id='plan', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='_build_plan',
                  ctx=Load()),
                args=[
                  Name(id='state', ctx=Load())])),
            Return(
              value=Dict(
                keys=[
                  Constant(value='bullets')],
                values=[
                  Dict(
                    keys=[
                      Constant(value='plan')],
                    values=[
                      Call(
                        func=Attribute(
                          value=Name(id='plan', ctx=Load()),
                          attr='model_dump',
                          ctx=Load()))])]))],
          returns=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='Any', ctx=Load())],
              ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='_build_plan',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='state',
                annotation=Subscript(
                  value=Name(id='Dict', ctx=Load()),
                  slice=Tuple(
                    elts=[
                      Name(id='str', ctx=Load()),
                      Name(id='Any', ctx=Load())],
                    ctx=Load()),
                  ctx=Load()))]),
          body=[
            Assign(
              targets=[
                Name(id='job_profile', ctx=Store())],
              value=Call(
                func=Name(id='extract_job_profile', ctx=Load()),
                args=[
                  Name(id='state', ctx=Load())])),
            Assign(
              targets=[
                Name(id='resume_profile', ctx=Store())],
              value=Call(
                func=Name(id='extract_resume_profile', ctx=Load()),
                args=[
                  Name(id='state', ctx=Load())])),
            Assign(
              targets=[
                Name(id='experiences', ctx=Store())],
              value=Subscript(
                value=Name(id='resume_profile', ctx=Load()),
                slice=Constant(value='experiences'),
                ctx=Load())),
            Assign(
              targets=[
                Name(id='sections', ctx=Store())],
              value=Call(
                func=Name(id='collect_sections', ctx=Load()),
                args=[
                  Name(id='state', ctx=Load())])),
            Assign(
              targets=[
                Name(id='highlight_order', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='_highlight_order',
                  ctx=Load()),
                args=[
                  Name(id='job_profile', ctx=Load()),
                  Name(id='experiences', ctx=Load())])),
            Assign(
              targets=[
                Name(id='metrics_focus', ctx=Store())],
              value=Call(
                func=Name(id='detect_metrics', ctx=Load()),
                args=[
                  Name(id='experiences', ctx=Load())])),
            Assign(
              targets=[
                Name(id='style_guidelines', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='_style_guidelines',
                  ctx=Load()),
                args=[
                  Name(id='job_profile', ctx=Load()),
                  Name(id='state', ctx=Load())])),
            Assign(
              targets=[
                Name(id='validation_checks', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='_validation_checks',
                  ctx=Load()),
                args=[
                  Name(id='job_profile', ctx=Load()),
                  Name(id='experiences', ctx=Load())])),
            Return(
              value=Call(
                func=Name(id='BulletPlan', ctx=Load()),
                keywords=[
                  keyword(
                    arg='target_sections',
                    value=Name(id='sections', ctx=Load())),
                  keyword(
                    arg='highlight_order',
                    value=Name(id='highlight_order', ctx=Load())),
                  keyword(
                    arg='metrics_focus',
                    value=Name(id='metrics_focus', ctx=Load())),
                  keyword(
                    arg='style_guidelines',
                    value=Name(id='style_guidelines', ctx=Load())),
                  keyword(
                    arg='validation_checks',
                    value=Name(id='validation_checks', ctx=Load()))]))],
          returns=Name(id='BulletPlan', ctx=Load())),
        FunctionDef(
          name='_highlight_order',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='job_profile',
                annotation=Subscript(
                  value=Name(id='Dict', ctx=Load()),
                  slice=Tuple(
                    elts=[
                      Name(id='str', ctx=Load()),
                      Name(id='Any', ctx=Load())],
                    ctx=Load()),
                  ctx=Load())),
              arg(
                arg='experiences',
                annotation=Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Subscript(
                    value=Name(id='Dict', ctx=Load()),
                    slice=Tuple(
                      elts=[
                        Name(id='str', ctx=Load()),
                        Name(id='Any', ctx=Load())],
                      ctx=Load()),
                    ctx=Load()),
                  ctx=Load()))]),
          body=[
            If(
              test=Name(id='experiences', ctx=Load()),
              body=[
                Assign(
                  targets=[
                    Name(id='ordered', ctx=Store())],
                  value=ListComp(
                    elt=Call(
                      func=Name(id='describe_experience', ctx=Load()),
                      args=[
                        Name(id='exp', ctx=Load())]),
                    generators=[
                      comprehension(
                        target=Name(id='exp', ctx=Store()),
                        iter=Subscript(
                          value=Name(id='experiences', ctx=Load()),
                          slice=Slice(
                            upper=Constant(value=3)),
                          ctx=Load()),
                        is_async=0)])),
                Return(
                  value=Name(id='ordered', ctx=Load()))]),
            Assign(
              targets=[
                Name(id='title', ctx=Store())],
              value=BoolOp(
                op=Or(),
                values=[
                  Subscript(
                    value=Name(id='job_profile', ctx=Load()),
                    slice=Constant(value='title'),
                    ctx=Load()),
                  Constant(value='Target role')])),
            Return(
              value=List(
                elts=[
                  JoinedStr(
                    values=[
                      Constant(value='Show relevant wins for '),
                      FormattedValue(
                        value=Name(id='title', ctx=Load()),
                        conversion=-1)])],
                ctx=Load()))],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='_style_guidelines',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='job_profile',
                annotation=Subscript(
                  value=Name(id='Dict', ctx=Load()),
                  slice=Tuple(
                    elts=[
                      Name(id='str', ctx=Load()),
                      Name(id='Any', ctx=Load())],
                    ctx=Load()),
                  ctx=Load())),
              arg(
                arg='state',
                annotation=Subscript(
                  value=Name(id='Dict', ctx=Load()),
                  slice=Tuple(
                    elts=[
                      Name(id='str', ctx=Load()),
                      Name(id='Any', ctx=Load())],
                    ctx=Load()),
                  ctx=Load()))]),
          body=[
            Assign(
              targets=[
                Name(id='strategy_plan', ctx=Store())],
              value=BoolOp(
                op=Or(),
                values=[
                  Call(
                    func=Attribute(
                      value=Call(
                        func=Attribute(
                          value=Name(id='state', ctx=Load()),
                          attr='get',
                          ctx=Load()),
                        args=[
                          Constant(value='strategy'),
                          Dict()]),
                      attr='get',
                      ctx=Load()),
                    args=[
                      Constant(value='strategy_plan')]),
                  Dict()])),
            If(
              test=Call(
                func=Name(id='hasattr', ctx=Load()),
                args=[
                  Name(id='strategy_plan', ctx=Load()),
                  Constant(value='model_dump')]),
              body=[
                Assign(
                  targets=[
                    Name(id='strategy_plan', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='strategy_plan', ctx=Load()),
                      attr='model_dump',
                      ctx=Load())))]),
            Assign(
              targets=[
                Name(id='tone', ctx=Store())],
              value=BoolOp(
                op=Or(),
                values=[
                  Call(
                    func=Attribute(
                      value=Name(id='strategy_plan', ctx=Load()),
                      attr='get',
                      ctx=Load()),
                    args=[
                      Constant(value='tone')]),
                  Constant(value='Professional')])),
            Assign(
              targets=[
                Name(id='guidelines', ctx=Store())],
              value=List(
                elts=[
                  JoinedStr(
                    values=[
                      Constant(value='Use a '),
                      FormattedValue(
                        value=Call(
                          func=Attribute(
                            value=Name(id='tone', ctx=Load()),
                            attr='lower',
                            ctx=Load())),
                        conversion=-1),
                      Constant(value=' tone anchored in measurable outcomes')]),
                  Constant(value='Lead with action + metric + outcome structure')],
                ctx=Load())),
            If(
              test=Subscript(
                value=Name(id='job_profile', ctx=Load()),
                slice=Constant(value='requirements'),
                ctx=Load()),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='guidelines', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      JoinedStr(
                        values=[
                          Constant(value='Mirror JD keywords such as '),
                          FormattedValue(
                            value=Call(
                              func=Attribute(
                                value=Constant(value=', '),
                                attr='join',
                                ctx=Load()),
                              args=[
                                Subscript(
                                  value=Subscript(
                                    value=Name(id='job_profile', ctx=Load()),
                                    slice=Constant(value='requirements'),
                                    ctx=Load()),
                                  slice=Slice(
                                    upper=Constant(value=3)),
                                  ctx=Load())]),
                            conversion=-1)])]))]),
            Return(
              value=Name(id='guidelines', ctx=Load()))],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='_validation_checks',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='job_profile',
                annotation=Subscript(
                  value=Name(id='Dict', ctx=Load()),
                  slice=Tuple(
                    elts=[
                      Name(id='str', ctx=Load()),
                      Name(id='Any', ctx=Load())],
                    ctx=Load()),
                  ctx=Load())),
              arg(
                arg='experiences',
                annotation=Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Subscript(
                    value=Name(id='Dict', ctx=Load()),
                    slice=Tuple(
                      elts=[
                        Name(id='str', ctx=Load()),
                        Name(id='Any', ctx=Load())],
                      ctx=Load()),
                    ctx=Load()),
                  ctx=Load()))]),
          body=[
            Assign(
              targets=[
                Name(id='checks', ctx=Store())],
              value=List(
                elts=[
                  Constant(value='Each bullet must cite a unique accomplishment'),
                  Constant(value='Avoid repeating the same metric more than once'),
                  Constant(value='Ensure bullets stay within 1 sentence')],
                ctx=Load())),
            If(
              test=Subscript(
                value=Name(id='job_profile', ctx=Load()),
                slice=Constant(value='company'),
