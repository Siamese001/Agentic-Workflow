              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='checks', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      JoinedStr(
                        values=[
                          Constant(value='Map at least one bullet to '),
                          FormattedValue(
                            value=Subscript(
                              value=Name(id='job_profile', ctx=Load()),
                              slice=Constant(value='company'),
                              ctx=Load()),
                            conversion=-1),
                          Constant(value=' priorities')])]))]),
            If(
              test=UnaryOp(
                op=Not(),
                operand=Name(id='experiences', ctx=Load())),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='checks', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Constant(value='Fallback to summary insights if experience is sparse')]))]),
            Return(
              value=Name(id='checks', ctx=Load()))],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load()))])])