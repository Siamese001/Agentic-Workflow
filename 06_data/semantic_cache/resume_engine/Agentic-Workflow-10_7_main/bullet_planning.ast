Module(
  body=[
    Expr(
      value=Constant(value='Deterministic Level-1 plan for bullet generation.')),
    ImportFrom(
      module='__future__',
      names=[
        alias(name='annotations')],
      level=0),
    ImportFrom(
      module='typing',
      names=[
