            ListComp(
              elt=Call(
                func=Attribute(
                  value=Name(id='pytest', ctx=Load()),
                  attr='param',
                  ctx=Load()),
                args=[
                  Name(id='flat', ctx=Load()),
                  Name(id='source', ctx=Load())],
                keywords=[
                  keyword(
                    arg='id',
