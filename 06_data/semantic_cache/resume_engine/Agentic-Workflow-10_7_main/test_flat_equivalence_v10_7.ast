          slice=Tuple(
            elts=[
              Name(id='Path', ctx=Load()),
              Name(id='Path', ctx=Load())],
            ctx=Load()),
          ctx=Load()),
        ctx=Load())),
    FunctionDef(
      name='test_flat_view_matches_source_files',
      args=arguments(
        args=[
          arg(
            arg='flat_rel_path',
            annotation=Name(id='Path', ctx=Load())),
          arg(
            arg='source_rel_path',
            annotation=Name(id='Path', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='Every flattened block must mirror the exact source test file content.')),
        Assign(
          targets=[
            Name(id='flat_path', ctx=Store())],
          value=BinOp(
            left=Name(id='REPO_ROOT', ctx=Load()),
            op=Div(),
            right=Name(id='flat_rel_path', ctx=Load()))),
        Assign(
          targets=[
            Name(id='source_path', ctx=Store())],
          value=BinOp(
            left=Name(id='REPO_ROOT', ctx=Load()),
            op=Div(),
            right=Name(id='source_rel_path', ctx=Load()))),
        Assign(
          targets=[
            Name(id='embedded', ctx=Store())],
          value=Call(
            func=Name(id='_extract_embedded_sources', ctx=Load()),
            args=[
              Name(id='flat_path', ctx=Load())])),
        Assign(
          targets=[
            Name(id='key', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='source_rel_path', ctx=Load()),
              attr='as_posix',
              ctx=Load()))),
        Assert(
          test=Compare(
            left=Name(id='key', ctx=Load()),
            ops=[
              In()],
            comparators=[
              Name(id='embedded', ctx=Load())]),
          msg=JoinedStr(
            values=[
              FormattedValue(
                value=Name(id='flat_rel_path', ctx=Load()),
                conversion=-1),
              Constant(value=' is missing embedded content for '),
              FormattedValue(
                value=Name(id='source_rel_path', ctx=Load()),
                conversion=-1)])),
        Assign(
          targets=[
            Name(id='flat_source', ctx=Store())],
          value=Subscript(
            value=Name(id='embedded', ctx=Load()),
            slice=Name(id='key', ctx=Load()),
            ctx=Load())),
        Assign(
          targets=[
            Name(id='source_text', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='source_path', ctx=Load()),
              attr='read_text',
              ctx=Load()),
            keywords=[
              keyword(
                arg='encoding',
                value=Constant(value='utf-8'))])),
        Assert(
          test=Compare(
            left=Name(id='flat_source', ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Name(id='source_text', ctx=Load())]),
          msg=JoinedStr(
            values=[
              Constant(value='Flattened block for '),
              FormattedValue(
                value=Name(id='source_rel_path', ctx=Load()),
                conversion=-1),
              Constant(value=' diverges from source file.')]))],
      decorator_list=[
        Call(
          func=Attribute(
            value=Attribute(
              value=Name(id='pytest', ctx=Load()),
              attr='mark',
              ctx=Load()),
            attr='parametrize',
            ctx=Load()),
          args=[
            Tuple(
              elts=[
