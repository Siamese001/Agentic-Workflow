Module(
  body=[
    Expr(
      value=Constant(value='Ensure the flattened test view stays synchronized with the source files.')),
    ImportFrom(
      module='__future__',
      names=[
        alias(name='annotations')],
      level=0),
    Import(
      names=[
        alias(name='ast')]),
    Import(
      names=[
        alias(name='json')]),
    ImportFrom(
      module='pathlib',
      names=[
        alias(name='Path')],
      level=0),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Dict'),
        alias(name='Iterable'),
        alias(name='List'),
        alias(name='Tuple')],
      level=0),
    Import(
      names=[
        alias(name='pytest')]),
    Assign(
      targets=[
        Name(id='REPO_ROOT', ctx=Store())],
      value=Subscript(
        value=Attribute(
          value=Call(
            func=Attribute(
              value=Call(
                func=Name(id='Path', ctx=Load()),
                args=[
                  Name(id='__file__', ctx=Load())]),
              attr='resolve',
              ctx=Load())),
          attr='parents',
          ctx=Load()),
        slice=Constant(value=1),
        ctx=Load())),
    Assign(
      targets=[
        Name(id='MANIFEST_PATH', ctx=Store())],
      value=BinOp(
        left=BinOp(
          left=Name(id='REPO_ROOT', ctx=Load()),
          op=Div(),
          right=Constant(value='tests_flat')),
        op=Div(),
        right=Constant(value='manifest.json'))),
    FunctionDef(
      name='_load_manifest',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='manifest', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='json', ctx=Load()),
              attr='loads',
              ctx=Load()),
            args=[
              Call(
                func=Attribute(
                  value=Name(id='MANIFEST_PATH', ctx=Load()),
                  attr='read_text',
                  ctx=Load()),
                keywords=[
                  keyword(
                    arg='encoding',
                    value=Constant(value='utf-8'))])])),
        Return(
          value=ListComp(
            elt=Tuple(
              elts=[
                Call(
                  func=Name(id='Path', ctx=Load()),
                  args=[
                    Subscript(
                      value=Name(id='entry', ctx=Load()),
                      slice=Constant(value='flat'),
                      ctx=Load())]),
                Call(
                  func=Name(id='Path', ctx=Load()),
                  args=[
                    Subscript(
                      value=Name(id='entry', ctx=Load()),
                      slice=Constant(value='source'),
                      ctx=Load())])],
              ctx=Load()),
            generators=[
              comprehension(
                target=Name(id='entry', ctx=Store()),
                iter=Name(id='manifest', ctx=Load()),
                is_async=0)]))],
      returns=Subscript(
        value=Name(id='List', ctx=Load()),
        slice=Subscript(
          value=Name(id='Tuple', ctx=Load()),
          slice=Tuple(
            elts=[
              Name(id='Path', ctx=Load()),
              Name(id='Path', ctx=Load())],
            ctx=Load()),
          ctx=Load()),
        ctx=Load())),
    FunctionDef(
      name='_extract_embedded_sources',
      args=arguments(
        args=[
          arg(
            arg='flat_path',
            annotation=Name(id='Path', ctx=Load()))]),
      body=[
        Assign(
          targets=[
            Name(id='module_ast', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='ast', ctx=Load()),
              attr='parse',
              ctx=Load()),
            args=[
              Call(
                func=Attribute(
                  value=Name(id='flat_path', ctx=Load()),
                  attr='read_text',
                  ctx=Load()),
                keywords=[
                  keyword(
                    arg='encoding',
                    value=Constant(value='utf-8'))])])),
        For(
          target=Name(id='node', ctx=Store()),
          iter=Attribute(
            value=Name(id='module_ast', ctx=Load()),
            attr='body',
            ctx=Load()),
          body=[
            If(
              test=UnaryOp(
                op=Not(),
                operand=Call(
                  func=Name(id='isinstance', ctx=Load()),
                  args=[
                    Name(id='node', ctx=Load()),
                    Attribute(
                      value=Name(id='ast', ctx=Load()),
                      attr='Assign',
                      ctx=Load())])),
              body=[
                Continue()]),
            For(
              target=Name(id='target', ctx=Store()),
              iter=Attribute(
                value=Name(id='node', ctx=Load()),
                attr='targets',
                ctx=Load()),
              body=[
                If(
                  test=BoolOp(
                    op=And(),
                    values=[
                      Call(
                        func=Name(id='isinstance', ctx=Load()),
                        args=[
                          Name(id='target', ctx=Load()),
                          Attribute(
                            value=Name(id='ast', ctx=Load()),
                            attr='Name',
                            ctx=Load())]),
                      Compare(
                        left=Attribute(
                          value=Name(id='target', ctx=Load()),
                          attr='id',
                          ctx=Load()),
                        ops=[
                          Eq()],
                        comparators=[
                          Constant(value='EMBEDDED_SOURCES')])]),
                  body=[
                    Assign(
                      targets=[
                        Name(id='embedded', ctx=Store())],
                      value=Call(
                        func=Attribute(
                          value=Name(id='ast', ctx=Load()),
                          attr='literal_eval',
                          ctx=Load()),
                        args=[
                          Attribute(
                            value=Name(id='node', ctx=Load()),
                            attr='value',
                            ctx=Load())])),
                    If(
                      test=UnaryOp(
                        op=Not(),
                        operand=Call(
                          func=Name(id='isinstance', ctx=Load()),
                          args=[
                            Name(id='embedded', ctx=Load()),
                            Name(id='dict', ctx=Load())])),
                      body=[
                        Raise(
                          exc=Call(
                            func=Name(id='AssertionError', ctx=Load()),
                            args=[
                              Constant(value='EMBEDDED_SOURCES must be a literal dictionary')]))]),
                    Return(
                      value=Name(id='embedded', ctx=Load()))])])]),
        Raise(
          exc=Call(
            func=Name(id='AssertionError', ctx=Load()),
            args=[
              Constant(value='Could not find EMBEDDED_SOURCES definition in flattened file')]))],
      returns=Subscript(
        value=Name(id='Dict', ctx=Load()),
        slice=Tuple(
          elts=[
            Name(id='str', ctx=Load()),
            Name(id='str', ctx=Load())],
          ctx=Load()),
        ctx=Load())),
    FunctionDef(
      name='_source_pairs',
      args=arguments(),
      body=[
        Return(
          value=Call(
            func=Name(id='_load_manifest', ctx=Load())))],
      returns=Subscript(
