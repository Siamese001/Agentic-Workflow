            generators=[
              comprehension(
                target=Name(id='entry', ctx=Store()),
                iter=Call(
                  func=Name(id='_load_manifest', ctx=Load())),
                is_async=0)])),
        Assign(
          targets=[
            Name(id='repo_sources', ctx=Store())],
          value=SetComp(
            elt=Call(
              func=Attribute(
                value=Call(
                  func=Attribute(
                    value=Name(id='path', ctx=Load()),
                    attr='relative_to',
                    ctx=Load()),
                  args=[
                    Name(id='REPO_ROOT', ctx=Load())]),
                attr='as_posix',
                ctx=Load())),
            generators=[
              comprehension(
                target=Name(id='path', ctx=Store()),
                iter=Call(
                  func=Attribute(
                    value=BinOp(
