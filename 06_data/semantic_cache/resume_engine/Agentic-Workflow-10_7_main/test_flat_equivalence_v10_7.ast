                        Constant(value='::'),
                        FormattedValue(
                          value=Name(id='source', ctx=Load()),
                          conversion=-1)]))]),
              generators=[
                comprehension(
                  target=Tuple(
                    elts=[
                      Name(id='flat', ctx=Store()),
                      Name(id='source', ctx=Store())],
                    ctx=Store()),
                  iter=Call(
                    func=Name(id='_source_pairs', ctx=Load())),
                  is_async=0)])])],
      returns=Constant(value=None)),
    FunctionDef(
      name='test_manifest_matches_repository_tree',
      args=arguments(),
      body=[
        Expr(
          value=Constant(value='If a new test is added to tests/, it must appear in the manifest.')),
        Assign(
          targets=[
            Name(id='manifest_sources', ctx=Store())],
          value=SetComp(
            elt=Call(
              func=Attribute(
                value=Subscript(
                  value=Name(id='entry', ctx=Load()),
                  slice=Constant(value=1),
                  ctx=Load()),
                attr='as_posix',
