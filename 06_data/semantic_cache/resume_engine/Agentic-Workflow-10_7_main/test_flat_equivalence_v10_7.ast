                      op=Div(),
                      right=Constant(value='tests')),
                    attr='rglob',
                    ctx=Load()),
                  args=[
                    Constant(value='*.py')]),
                ifs=[
                  Compare(
                    left=Constant(value='__pycache__'),
                    ops=[
                      NotIn()],
                    comparators=[
                      Attribute(
                        value=Name(id='path', ctx=Load()),
                        attr='parts',
                        ctx=Load())])],
                is_async=0)])),
        Assert(
          test=Compare(
            left=Name(id='manifest_sources', ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Name(id='repo_sources', ctx=Load())]),
          msg=Constant(value='Manifest is out of sync with tests/ tree'))],
      returns=Constant(value=None))])