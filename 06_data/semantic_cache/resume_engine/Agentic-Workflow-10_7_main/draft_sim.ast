Module(
  body=[
    Expr(
      value=Constant(value='Synthetic draft simulator.')),
    Import(
      names=[
        alias(name='random')]),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Any'),
        alias(name='Dict')],
      level=0),
    ImportFrom(
      module='simulations.models.draft_simulation',
      names=[
        alias(name='DraftSimMetrics'),
        alias(name='DraftSimRequest'),
        alias(name='DraftSimResult')],
      level=0),
    ImportFrom(
      module='simulations.utils',
      names=[
        alias(name='model_to_payload')],
      level=0),
    ClassDef(
      name='DraftSimulator',
      body=[
        Expr(
          value=Constant(value='Simulates draft-level properties.')),
        AsyncFunctionDef(
          name='run',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='request',
                annotation=Name(id='DraftSimRequest', ctx=Load()))]),
          body=[
            Assign(
              targets=[
                Name(id='section_count', ctx=Store())],
              value=Call(
                func=Name(id='len', ctx=Load()),
                args=[
                  Attribute(
                    value=Name(id='request', ctx=Load()),
                    attr='draft_sections',
                    ctx=Load())])),
            Assign(
              targets=[
                Name(id='entropy', ctx=Store())],
              value=Call(
                func=Name(id='round', ctx=Load()),
                args=[
                  Call(
                    func=Attribute(
                      value=Name(id='random', ctx=Load()),
                      attr='uniform',
                      ctx=Load()),
                    args=[
                      Constant(value=0.2),
                      Constant(value=0.9)]),
                  Constant(value=3)])),
            Assign(
              targets=[
                Name(id='cohesion', ctx=Store())],
              value=Call(
                func=Name(id='round', ctx=Load()),
                args=[
                  Call(
                    func=Name(id='max', ctx=Load()),
                    args=[
                      Constant(value=0.0),
                      Call(
                        func=Name(id='min', ctx=Load()),
                        args=[
                          Constant(value=1.0),
                          BinOp(
                            left=BinOp(
                              left=Constant(value=0.5),
                              op=Add(),
                              right=BinOp(
                                left=Name(id='section_count', ctx=Load()),
                                op=Mult(),
                                right=Constant(value=0.05))),
                            op=Add(),
                            right=Call(
                              func=Attribute(
                                value=Name(id='random', ctx=Load()),
                                attr='uniform',
                                ctx=Load()),
                              args=[
                                UnaryOp(
                                  op=USub(),
                                  operand=Constant(value=0.2)),
                                Constant(value=0.3)]))])]),
                  Constant(value=3)])),
            Assign(
              targets=[
                Name(id='rhythm_score', ctx=Store())],
              value=Call(
                func=Name(id='round', ctx=Load()),
                args=[
                  Call(
                    func=Attribute(
                      value=Name(id='random', ctx=Load()),
                      attr='uniform',
                      ctx=Load()),
                    args=[
                      Constant(value=0.3),
                      Constant(value=0.95)]),
                  Constant(value=3)])),
            Assign(
              targets=[
                Name(id='metrics', ctx=Store())],
              value=Call(
                func=Name(id='DraftSimMetrics', ctx=Load()),
                keywords=[
                  keyword(
                    arg='entropy',
                    value=Name(id='entropy', ctx=Load())),
                  keyword(
                    arg='cohesion',
                    value=Name(id='cohesion', ctx=Load())),
                  keyword(
                    arg='rhythm_score',
                    value=Name(id='rhythm_score', ctx=Load()))])),
            AnnAssign(
              target=Name(id='preview', ctx=Store()),
              annotation=Subscript(
                value=Name(id='Dict', ctx=Load()),
                slice=Tuple(
                  elts=[
                    Name(id='str', ctx=Load()),
                    Name(id='Any', ctx=Load())],
                  ctx=Load()),
                ctx=Load()),
              value=Dict(),
              simple=1),
            If(
              test=Attribute(
                value=Name(id='request', ctx=Load()),
                attr='draft_sections',
                ctx=Load()),
              body=[
                Assign(
                  targets=[
                    Name(id='first_key', ctx=Store())],
                  value=Call(
                    func=Name(id='next', ctx=Load()),
                    args=[
                      Call(
                        func=Name(id='iter', ctx=Load()),
                        args=[
                          Attribute(
                            value=Name(id='request', ctx=Load()),
                            attr='draft_sections',
                            ctx=Load())])])),
                Assign(
                  targets=[
                    Name(id='preview', ctx=Store())],
                  value=Dict(
                    keys=[
                      Name(id='first_key', ctx=Load())],
                    values=[
                      Subscript(
                        value=Attribute(
                          value=Name(id='request', ctx=Load()),
                          attr='draft_sections',
                          ctx=Load()),
                        slice=Name(id='first_key', ctx=Load()),
                        ctx=Load())]))]),
            Return(
              value=Call(
                func=Name(id='DraftSimResult', ctx=Load()),
                keywords=[
                  keyword(
                    arg='simulation_id',
                    value=Attribute(
                      value=Name(id='request', ctx=Load()),
                      attr='simulation_id',
                      ctx=Load())),
                  keyword(
                    arg='success',
                    value=Constant(value=True)),
                  keyword(
                    arg='metrics',
                    value=Call(
                      func=Name(id='model_to_payload', ctx=Load()),
                      args=[
                        Name(id='metrics', ctx=Load())])),
                  keyword(
                    arg='details',
                    value=Dict(
                      keys=[
                        Constant(value='section_preview')],
                      values=[
                        Name(id='preview', ctx=Load())]))]))],
          returns=Name(id='DraftSimResult', ctx=Load()))])])