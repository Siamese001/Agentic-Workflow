Module(
  body=[
    Import(
      names=[
        alias(name='subprocess'),
        alias(name='pytest')]),
    FunctionDef(
      name='test_no_dev_markers_in_repo',
      args=arguments(
        args=[
          arg(arg='needle')]),
      body=[
        Assign(
          targets=[
            Name(id='r', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='subprocess', ctx=Load()),
              attr='run',
              ctx=Load()),
            args=[
              List(
                elts=[
                  Constant(value='grep'),
                  Constant(value='-R'),
                  Name(id='needle', ctx=Load()),
                  Constant(value='agentic_workflow/')],
                ctx=Load())],
            keywords=[
              keyword(
                arg='capture_output',
                value=Constant(value=True)),
              keyword(
                arg='text',
                value=Constant(value=True))])),
        Assert(
          test=Compare(
            left=Name(id='needle', ctx=Load()),
            ops=[
              NotIn()],
            comparators=[
              Attribute(
                value=Name(id='r', ctx=Load()),
                attr='stdout',
                ctx=Load())]))],
      decorator_list=[
        Call(
          func=Attribute(
            value=Attribute(
              value=Name(id='pytest', ctx=Load()),
              attr='mark',
              ctx=Load()),
            attr='parametrize',
            ctx=Load()),
          args=[
            Constant(value='needle'),
            List(
              elts=[
                Constant(value='TODO'),
                Constant(value='MOCK'),
                Constant(value='FIXME')],
              ctx=Load())])]),
    FunctionDef(
      name='test_no_identity_or_placeholder_functions',
      args=arguments(
        args=[
          arg(arg='pattern')]),
      body=[
        Assign(
          targets=[
            Name(id='r', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='subprocess', ctx=Load()),
              attr='run',
              ctx=Load()),
            args=[
              List(
                elts=[
                  Constant(value='grep'),
                  Constant(value='-R'),
                  Name(id='pattern', ctx=Load()),
                  Constant(value='agentic_workflow/')],
                ctx=Load())],
            keywords=[
              keyword(
                arg='capture_output',
                value=Constant(value=True)),
              keyword(
                arg='text',
                value=Constant(value=True))])),
        Assert(
          test=Compare(
            left=Name(id='pattern', ctx=Load()),
            ops=[
              NotIn()],
            comparators=[
              Attribute(
                value=Name(id='r', ctx=Load()),
                attr='stdout',
                ctx=Load())]))],
      decorator_list=[
        Call(
          func=Attribute(
            value=Attribute(
              value=Name(id='pytest', ctx=Load()),
              attr='mark',
              ctx=Load()),
            attr='parametrize',
            ctx=Load()),
          args=[
            Constant(value='pattern'),
            List(
              elts=[
                Constant(value='return input'),
                Constant(value='pass # placeholder')],
              ctx=Load())])])])