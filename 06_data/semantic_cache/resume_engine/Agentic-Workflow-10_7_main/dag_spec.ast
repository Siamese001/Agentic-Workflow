Module(
  body=[
    Expr(
      value=Constant(value='Conceptual DAG specification for the v10.7 orchestration.')),
    ImportFrom(
      module='__future__',
      names=[
        alias(name='annotations')],
      level=0),
    ImportFrom(
      module='dataclasses',
      names=[
        alias(name='dataclass')],
      level=0),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Dict'),
        alias(name='Iterable'),
        alias(name='List'),
        alias(name='Set')],
      level=0),
    ClassDef(
      name='ConceptualNode',
      body=[
        Expr(
          value=Constant(value='Represents a conceptual workflow block and its concrete LangGraph nodes.')),
        AnnAssign(
          target=Name(id='name', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='concrete_nodes', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load()),
          simple=1)],
      decorator_list=[
        Call(
          func=Name(id='dataclass', ctx=Load()),
          keywords=[
            keyword(
              arg='frozen',
              value=Constant(value=True))])]),
    AnnAssign(
      target=Name(id='CONCEPTUAL_DAG', ctx=Store()),
      annotation=Subscript(
        value=Name(id='List', ctx=Load()),
        slice=Name(id='ConceptualNode', ctx=Load()),
        ctx=Load()),
      value=List(
        elts=[
          Call(
            func=Name(id='ConceptualNode', ctx=Load()),
            keywords=[
              keyword(
                arg='name',
                value=Constant(value='SafetyGuardStack')),
              keyword(
                arg='concrete_nodes',
                value=List(
                  elts=[
                    Constant(value='run_sanitize_pii'),
                    Constant(value='run_detect_prompt_injection')],
                  ctx=Load()))]),
          Call(
            func=Name(id='ConceptualNode', ctx=Load()),
            keywords=[
              keyword(
                arg='name',
                value=Constant(value='StrategyStack')),
              keyword(
                arg='concrete_nodes',
                value=List(
                  elts=[
                    Constant(value='run_classify_complexity'),
                    Constant(value='run_tot_strategy'),
                    Constant(value='run_arbitration_after_strategy'),
                    Constant(value='run_detect_ambiguity')],
                  ctx=Load()))]),
          Call(
            func=Name(id='ConceptualNode', ctx=Load()),
            keywords=[
              keyword(
                arg='name',
                value=Constant(value='RAGStack')),
              keyword(
                arg='concrete_nodes',
                value=List(
                  elts=[
                    Constant(value='prepare_parallel_run'),
                    Constant(value='run_prompt_engineering'),
                    Constant(value='run_rag_stack'),
                    Constant(value='join_rag_and_prompt'),
                    Constant(value='run_arbitration_after_join')],
                  ctx=Load()))]),
          Call(
            func=Name(id='ConceptualNode', ctx=Load()),
            keywords=[
              keyword(
                arg='name',
                value=Constant(value='BulletStack')),
              keyword(
                arg='concrete_nodes',
                value=List(
                  elts=[
                    Constant(value='run_generate_bullets'),
                    Constant(value='run_critique_bullets'),
                    Constant(value='run_arbitration_after_bullets')],
                  ctx=Load()))]),
          Call(
            func=Name(id='ConceptualNode', ctx=Load()),
            keywords=[
              keyword(
                arg='name',
                value=Constant(value='DraftingStack')),
              keyword(
                arg='concrete_nodes',
                value=List(
                  elts=[
                    Constant(value='run_drafting'),
                    Constant(value='run_arbitration_after_drafting')],
                  ctx=Load()))]),
          Call(
            func=Name(id='ConceptualNode', ctx=Load()),
            keywords=[
              keyword(
                arg='name',
                value=Constant(value='QAStack')),
              keyword(
                arg='concrete_nodes',
                value=List(
                  elts=[
                    Constant(value='run_qa_validation'),
                    Constant(value='run_arbitration_after_qa'),
                    Constant(value='run_constitutional_review')],
                  ctx=Load()))]),
          Call(
            func=Name(id='ConceptualNode', ctx=Load()),
            keywords=[
              keyword(
                arg='name',
                value=Constant(value='HILInteractionStack')),
              keyword(
                arg='concrete_nodes',
                value=List(
                  elts=[
                    Constant(value='HIL_PAUSE'),
                    Constant(value='run_feedback_router'),
                    Constant(value='run_prepare_hil_strategy_reentry'),
                    Constant(value='run_prepare_hil_drafting_reentry'),
                    Constant(value='run_reconcile_specialists'),
                    Constant(value='run_inject_hil_edit')],
                  ctx=Load()))])],
        ctx=Load()),
      simple=1),
    Assign(
      targets=[
        Name(id='CONCEPTUAL_EDGES', ctx=Store())],
      value=List(
        elts=[
          Tuple(
            elts=[
              Constant(value='SafetyGuardStack'),
              Constant(value='StrategyStack')],
            ctx=Load()),
          Tuple(
            elts=[
              Constant(value='StrategyStack'),
              Constant(value='RAGStack')],
            ctx=Load()),
          Tuple(
            elts=[
              Constant(value='RAGStack'),
