            ctx=Load()),
          Tuple(
            elts=[
              Constant(value='DraftingStack'),
              Constant(value='QAStack')],
            ctx=Load()),
          Tuple(
            elts=[
              Constant(value='QAStack'),
              Constant(value='HILInteractionStack')],
            ctx=Load())],
        ctx=Load())),
    FunctionDef(
      name='conceptual_node_map',
      args=arguments(),
      body=[
        Expr(
          value=Constant(value='Return a lookup dictionary for conceptual nodes by name.')),
        Return(
          value=DictComp(
            key=Attribute(
              value=Name(id='node', ctx=Load()),
              attr='name',
              ctx=Load()),
            value=Name(id='node', ctx=Load()),
            generators=[
              comprehension(
                target=Name(id='node', ctx=Store()),
                iter=Name(id='CONCEPTUAL_DAG', ctx=Load()),
                is_async=0)]))],
      returns=Subscript(
        value=Name(id='Dict', ctx=Load()),
        slice=Tuple(
          elts=[
            Name(id='str', ctx=Load()),
            Name(id='ConceptualNode', ctx=Load())],
          ctx=Load()),
        ctx=Load())),
    FunctionDef(
      name='all_concrete_nodes',
      args=arguments(),
      body=[
        Expr(
          value=Constant(value='Return the flattened set of concrete node names covered by the spec.')),
        Return(
          value=SetComp(
            elt=Name(id='concrete', ctx=Load()),
            generators=[
              comprehension(
                target=Name(id='node', ctx=Store()),
                iter=Name(id='CONCEPTUAL_DAG', ctx=Load()),
                is_async=0),
              comprehension(
                target=Name(id='concrete', ctx=Store()),
                iter=Attribute(
                  value=Name(id='node', ctx=Load()),
                  attr='concrete_nodes',
                  ctx=Load()),
                is_async=0)]))],
      returns=Subscript(
        value=Name(id='Set', ctx=Load()),
        slice=Name(id='str', ctx=Load()),
        ctx=Load())),
    FunctionDef(
      name='iter_concrete_nodes',
      args=arguments(
        args=[
          arg(
            arg='node_names',
            annotation=Subscript(
              value=Name(id='Iterable', ctx=Load()),
              slice=Name(id='str', ctx=Load()),
              ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='Iterate over all concrete nodes for the given conceptual node names.')),
        Assign(
          targets=[
            Name(id='lookup', ctx=Store())],
          value=Call(
            func=Name(id='conceptual_node_map', ctx=Load()))),
        For(
          target=Name(id='name', ctx=Store()),
          iter=Name(id='node_names', ctx=Load()),
          body=[
            Assign(
              targets=[
                Name(id='conceptual', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='lookup', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Name(id='name', ctx=Load())])),
            If(
              test=UnaryOp(
                op=Not(),
                operand=Name(id='conceptual', ctx=Load())),
              body=[
                Continue()]),
            Expr(
              value=YieldFrom(
                value=Attribute(
                  value=Name(id='conceptual', ctx=Load()),
                  attr='concrete_nodes',
                  ctx=Load())))])],
      returns=Subscript(
        value=Name(id='Iterable', ctx=Load()),
        slice=Name(id='str', ctx=Load()),
        ctx=Load())),
    Assign(
      targets=[
        Name(id='__all__', ctx=Store())],
      value=List(
        elts=[
          Constant(value='ConceptualNode'),
          Constant(value='CONCEPTUAL_DAG'),
          Constant(value='CONCEPTUAL_EDGES'),
          Constant(value='conceptual_node_map'),
          Constant(value='all_concrete_nodes'),
          Constant(value='iter_concrete_nodes')],
        ctx=Load()))])