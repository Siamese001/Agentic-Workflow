Module(
  body=[
    Expr(
      value=Constant(value='Tests for safety simulator.')),
    Import(
      names=[
        alias(name='pytest')]),
    ImportFrom(
      module='simulations.engines.safety_sim',
      names=[
        alias(name='SafetySimulator')],
      level=0),
    ImportFrom(
      module='simulations.models',
      names=[
        alias(name='SafetySimRequest')],
      level=0),
    AsyncFunctionDef(
      name='test_safety_simulator_returns_result',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='simulator', ctx=Store())],
          value=Call(
            func=Name(id='SafetySimulator', ctx=Load()))),
        Assign(
          targets=[
            Name(id='request', ctx=Store())],
          value=Call(
            func=Name(id='SafetySimRequest', ctx=Load()),
            keywords=[
              keyword(
                arg='simulation_id',
                value=Constant(value='sim-safety')),
              keyword(arg='payload', value=Dict()),
              keyword(
                arg='text',
                value=Constant(value='Some text that might contain pii.'))])),
        Assign(
          targets=[
            Name(id='result', ctx=Store())],
          value=Await(
            value=Call(
              func=Attribute(
                value=Name(id='simulator', ctx=Load()),
                attr='run',
                ctx=Load()),
              args=[
                Name(id='request', ctx=Load())]))),
        Assert(
          test=Compare(
            left=Attribute(
              value=Name(id='result', ctx=Load()),
              attr='success',
              ctx=Load()),
            ops=[
              Is()],
            comparators=[
              Constant(value=True)])),
        Assert(
          test=Compare(
            left=Constant(value=0.0),
            ops=[
              LtE(),
              LtE()],
            comparators=[
              Subscript(
                value=Attribute(
                  value=Name(id='result', ctx=Load()),
                  attr='metrics',
                  ctx=Load()),
                slice=Constant(value='pii_risk'),
                ctx=Load()),
              Constant(value=1.0)])),
        Assert(
          test=Compare(
            left=Constant(value=0.0),
            ops=[
              LtE(),
              LtE()],
            comparators=[
              Subscript(
                value=Attribute(
                  value=Name(id='result', ctx=Load()),
                  attr='metrics',
                  ctx=Load()),
                slice=Constant(value='injection_risk'),
                ctx=Load()),
              Constant(value=1.0)])),
        Assert(
          test=Compare(
            left=Constant(value=0.0),
            ops=[
              LtE(),
              LtE()],
            comparators=[
              Subscript(
                value=Attribute(
                  value=Name(id='result', ctx=Load()),
                  attr='metrics',
                  ctx=Load()),
                slice=Constant(value='bias_risk'),
                ctx=Load()),
              Constant(value=1.0)])),
        Assert(
          test=Compare(
            left=Constant(value='text_snippet'),
            ops=[
              In()],
            comparators=[
              Attribute(
                value=Name(id='result', ctx=Load()),
                attr='details',
                ctx=Load())]))],
      decorator_list=[
        Attribute(
          value=Attribute(
            value=Name(id='pytest', ctx=Load()),
            attr='mark',
            ctx=Load()),
          attr='asyncio',
          ctx=Load())]),
    FunctionDef(
      name='test_safety_request_validation',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='request', ctx=Store())],
          value=Call(
            func=Name(id='SafetySimRequest', ctx=Load()),
            keywords=[
              keyword(
                arg='simulation_id',
                value=Constant(value='sim-safety-validate')),
              keyword(arg='payload', value=Dict()),
              keyword(
                arg='text',
                value=Constant(value='abc'))])),
        Assert(
          test=Compare(
            left=Attribute(
              value=Name(id='request', ctx=Load()),
              attr='text',
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value='abc')]))])])