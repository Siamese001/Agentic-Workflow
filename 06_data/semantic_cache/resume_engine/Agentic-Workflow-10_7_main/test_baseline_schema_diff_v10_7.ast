Module(
  body=[
    Import(
      names=[
        alias(name='json')]),
    ImportFrom(
      module='pathlib',
      names=[
        alias(name='Path')],
      level=0),
    Assign(
      targets=[
        Name(id='HERE', ctx=Store())],
      value=Attribute(
        value=Call(
          func=Attribute(
            value=Call(
              func=Name(id='Path', ctx=Load()),
              args=[
                Name(id='__file__', ctx=Load())]),
            attr='resolve',
            ctx=Load())),
        attr='parent',
        ctx=Load())),
    Assign(
      targets=[
        Name(id='BASELINE_DIR', ctx=Store())],
      value=BinOp(
        left=BinOp(
          left=Subscript(
            value=Attribute(
              value=Name(id='HERE', ctx=Load()),
              attr='parents',
              ctx=Load()),
            slice=Constant(value=1),
            ctx=Load()),
          op=Div(),
          right=Constant(value='shared')),
        op=Div(),
        right=Constant(value='baselines'))),
    Assign(
      targets=[
        Name(id='PREVIOUS_BASELINE', ctx=Store())],
      value=BinOp(
        left=Name(id='BASELINE_DIR', ctx=Load()),
        op=Div(),
        right=Constant(value='baseline_outputs_previous.json'))),
    Assign(
      targets=[
        Name(id='V10_7_BASELINE', ctx=Store())],
      value=BinOp(
        left=Name(id='BASELINE_DIR', ctx=Load()),
        op=Div(),
        right=Constant(value='baseline_outputs_v10_7.json'))),
    FunctionDef(
      name='_load_baseline',
      args=arguments(
        args=[
          arg(
            arg='path',
            annotation=Name(id='Path', ctx=Load()))]),
      body=[
        Assert(
          test=Call(
            func=Attribute(
              value=Name(id='path', ctx=Load()),
              attr='exists',
              ctx=Load())),
          msg=JoinedStr(
            values=[
              Constant(value='Baseline file not found: '),
              FormattedValue(
                value=Name(id='path', ctx=Load()),
                conversion=-1)])),
        With(
          items=[
            withitem(
              context_expr=Call(
                func=Attribute(
                  value=Name(id='path', ctx=Load()),
                  attr='open',
                  ctx=Load()),
                args=[
                  Constant(value='r')],
                keywords=[
                  keyword(
                    arg='encoding',
                    value=Constant(value='utf-8'))]),
              optional_vars=Name(id='f', ctx=Store()))],
          body=[
            Return(
              value=Call(
                func=Attribute(
                  value=Name(id='json', ctx=Load()),
                  attr='load',
                  ctx=Load()),
                args=[
                  Name(id='f', ctx=Load())]))])],
      returns=Name(id='dict', ctx=Load())),
    FunctionDef(
      name='test_baseline_files_exist',
      args=arguments(),
      body=[
        Expr(
          value=Constant(value='\n    Sanity check so a missing baseline file fails with a clear message,\n    not a cryptic JSON/IO error.\n    ')),
        Assert(
          test=Call(
            func=Attribute(
              value=Name(id='PREVIOUS_BASELINE', ctx=Load()),
              attr='exists',
              ctx=Load())),
          msg=JoinedStr(
            values=[
              Constant(value='Missing: '),
              FormattedValue(
                value=Name(id='PREVIOUS_BASELINE', ctx=Load()),
                conversion=-1)])),
        Assert(
          test=Call(
            func=Attribute(
              value=Name(id='V10_7_BASELINE', ctx=Load()),
              attr='exists',
              ctx=Load())),
          msg=JoinedStr(
            values=[
              Constant(value='Missing: '),
              FormattedValue(
                value=Name(id='V10_7_BASELINE', ctx=Load()),
                conversion=-1)]))]),
    FunctionDef(
      name='test_top_level_sections_preserved',
      args=arguments(),
      body=[
        Expr(
          value=Constant(value='\n    API envelope invariant:\n    All top-level sections that existed previously must still exist in v10.7.\n\n    Example from your baselines:\n      previous: {"strategy": {...}, "qa": {...}}\n      v10.7:    {"strategy": {...}, "qa": {...}}\n    ')),
        Assign(
          targets=[
            Name(id='prev', ctx=Store())],
          value=Call(
            func=Name(id='_load_baseline', ctx=Load()),
            args=[
              Name(id='PREVIOUS_BASELINE', ctx=Load())])),
        Assign(
          targets=[
            Name(id='new', ctx=Store())],
          value=Call(
            func=Name(id='_load_baseline', ctx=Load()),
            args=[
              Name(id='V10_7_BASELINE', ctx=Load())])),
        Assign(
          targets=[
            Name(id='prev_keys', ctx=Store())],
          value=Call(
            func=Name(id='set', ctx=Load()),
            args=[
              Call(
                func=Attribute(
                  value=Name(id='prev', ctx=Load()),
                  attr='keys',
                  ctx=Load()))])),
        Assign(
          targets=[
            Name(id='new_keys', ctx=Store())],
          value=Call(
            func=Name(id='set', ctx=Load()),
            args=[
              Call(
                func=Attribute(
                  value=Name(id='new', ctx=Load()),
                  attr='keys',
                  ctx=Load()))])),
        Assign(
          targets=[
            Name(id='missing', ctx=Store())],
          value=BinOp(
            left=Name(id='prev_keys', ctx=Load()),
            op=Sub(),
            right=Name(id='new_keys', ctx=Load()))),
        Assert(
          test=UnaryOp(
            op=Not(),
            operand=Name(id='missing', ctx=Load())),
          msg=JoinedStr(
            values=[
              Constant(value='Top-level sections missing in v10.7: '),
              FormattedValue(
                value=Call(
                  func=Name(id='sorted', ctx=Load()),
                  args=[
                    Name(id='missing', ctx=Load())]),
                conversion=-1)]))]),
    FunctionDef(
      name='test_strategy_schema_evolution_superset',
      args=arguments(),
      body=[
        Expr(
          value=Constant(value='\n    Strategy schema evolution:\n\n    previous:\n      "strategy": {\n        "fields": ["steps", "goal"],\n        "version": "legacy"\n      }\n\n    v10.7:\n      "strategy": {\n        "fields": ["steps", "goal", "context"],\n        "version": "v10.7",\n        ...\n      }\n\n    Invariants:\n      - All previous fields are still present.\n      - New fields may be added (e.g., "context").\n      - Version must change (no accidental reuse of "legacy").\n    ')),
        Assign(
          targets=[
            Name(id='prev', ctx=Store())],
          value=Subscript(
            value=Call(
              func=Name(id='_load_baseline', ctx=Load()),
              args=[
                Name(id='PREVIOUS_BASELINE', ctx=Load())]),
            slice=Constant(value='strategy'),
            ctx=Load())),
        Assign(
          targets=[
            Name(id='new', ctx=Store())],
          value=Subscript(
            value=Call(
              func=Name(id='_load_baseline', ctx=Load()),
              args=[
                Name(id='V10_7_BASELINE', ctx=Load())]),
            slice=Constant(value='strategy'),
            ctx=Load())),
        Assign(
          targets=[
            Name(id='prev_fields', ctx=Store())],
          value=Call(
            func=Name(id='set', ctx=Load()),
            args=[
              Call(
                func=Attribute(
                  value=Name(id='prev', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='fields'),
                  List(ctx=Load())])])),
        Assign(
          targets=[
            Name(id='new_fields', ctx=Store())],
          value=Call(
            func=Name(id='set', ctx=Load()),
            args=[
              Call(
                func=Attribute(
                  value=Name(id='new', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='fields'),
                  List(ctx=Load())])])),
        Assign(
          targets=[
            Name(id='missing_fields', ctx=Store())],
          value=BinOp(
            left=Name(id='prev_fields', ctx=Load()),
            op=Sub(),
            right=Name(id='new_fields', ctx=Load()))),
        Assert(
          test=UnaryOp(
            op=Not(),
            operand=Name(id='missing_fields', ctx=Load())),
          msg=JoinedStr(
            values=[
              Constant(value="v10.7 'strategy.fields' is missing fields from previous baseline: "),
              FormattedValue(
                value=Call(
                  func=Name(id='sorted', ctx=Load()),
                  args=[
                    Name(id='missing_fields', ctx=Load())]),
                conversion=-1)])),
        Assert(
          test=Compare(
            left=Constant(value='context'),
            ops=[
              In()],
            comparators=[
              Name(id='new_fields', ctx=Load())]),
          msg=Constant(value="v10.7 'strategy.fields' must include the new 'context' field")),
        Assert(
          test=Compare(
            left=Call(
              func=Attribute(
                value=Name(id='prev', ctx=Load()),
                attr='get',
                ctx=Load()),
              args=[
                Constant(value='version')]),
            ops=[
              NotEq()],
            comparators=[
              Call(
                func=Attribute(
                  value=Name(id='new', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='version')])]),
          msg=Constant(value='Strategy version did not change between previous and v10.7 baselines'))]),
    FunctionDef(
      name='test_qa_schema_evolution_superset',
      args=arguments(),
      body=[
        Expr(
          value=Constant(value='\n    QA schema evolution:\n\n    previous:\n      "qa": {\n        "fields": ["confidence", "summary"],\n        "version": "legacy"\n      }\n\n    v10.7:\n      "qa": {\n        "fields": ["confidence", "summary", "issues"],\n        "version": "v10.7",\n        ...\n      }\n\n    Invariants:\n      - All previous fields are still present.\n      - New \'issues\' field is required in v10.7.\n      - Version must change.\n    ')),
        Assign(
          targets=[
            Name(id='prev', ctx=Store())],
          value=Subscript(
            value=Call(
              func=Name(id='_load_baseline', ctx=Load()),
              args=[
                Name(id='PREVIOUS_BASELINE', ctx=Load())]),
            slice=Constant(value='qa'),
            ctx=Load())),
        Assign(
          targets=[
            Name(id='new', ctx=Store())],
          value=Subscript(
            value=Call(
              func=Name(id='_load_baseline', ctx=Load()),
              args=[
                Name(id='V10_7_BASELINE', ctx=Load())]),
            slice=Constant(value='qa'),
            ctx=Load())),
        Assign(
          targets=[
            Name(id='prev_fields', ctx=Store())],
          value=Call(
            func=Name(id='set', ctx=Load()),
            args=[
              Call(
                func=Attribute(
                  value=Name(id='prev', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='fields'),
                  List(ctx=Load())])])),
        Assign(
          targets=[
            Name(id='new_fields', ctx=Store())],
          value=Call(
            func=Name(id='set', ctx=Load()),
            args=[
              Call(
                func=Attribute(
                  value=Name(id='new', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='fields'),
                  List(ctx=Load())])])),
        Assign(
          targets=[
            Name(id='missing_fields', ctx=Store())],
          value=BinOp(
            left=Name(id='prev_fields', ctx=Load()),
            op=Sub(),
            right=Name(id='new_fields', ctx=Load()))),
        Assert(
          test=UnaryOp(
            op=Not(),
            operand=Name(id='missing_fields', ctx=Load())),
          msg=JoinedStr(
            values=[
              Constant(value="v10.7 'qa.fields' is missing fields from previous baseline: "),
              FormattedValue(
                value=Call(
                  func=Name(id='sorted', ctx=Load()),
                  args=[
                    Name(id='missing_fields', ctx=Load())]),
                conversion=-1)])),
        Assert(
          test=Compare(
            left=Constant(value='issues'),
            ops=[
              In()],
            comparators=[
              Name(id='new_fields', ctx=Load())]),
          msg=Constant(value="v10.7 'qa.fields' must include the new 'issues' field")),
        Assert(
          test=Compare(
            left=Call(
              func=Attribute(
                value=Name(id='prev', ctx=Load()),
                attr='get',
                ctx=Load()),
              args=[
                Constant(value='version')]),
            ops=[
              NotEq()],
            comparators=[
              Call(
                func=Attribute(
                  value=Name(id='new', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='version')])]),
          msg=Constant(value='QA version did not change between previous and v10.7 baselines'))]),
    FunctionDef(
      name='test_no_contract_regression_on_fields',
      args=arguments(),
      body=[
        Expr(
          value=Constant(value="\n    Global contract check:\n\n    For every top-level section that has a 'fields' array in the previous\n    baseline, ensure that:\n\n      - v10.7 still has that section\n      - v10.7 still has all of those fields (superset)\n    ")),
        Assign(
          targets=[
            Name(id='prev', ctx=Store())],
          value=Call(
            func=Name(id='_load_baseline', ctx=Load()),
            args=[
              Name(id='PREVIOUS_BASELINE', ctx=Load())])),
        Assign(
          targets=[
            Name(id='new', ctx=Store())],
          value=Call(
            func=Name(id='_load_baseline', ctx=Load()),
            args=[
              Name(id='V10_7_BASELINE', ctx=Load())])),
        For(
          target=Tuple(
            elts=[
              Name(id='section_name', ctx=Store()),
              Name(id='prev_section', ctx=Store())],
            ctx=Store()),
          iter=Call(
            func=Attribute(
              value=Name(id='prev', ctx=Load()),
              attr='items',
              ctx=Load())),
          body=[
            Assign(
              targets=[
                Name(id='prev_fields', ctx=Store())],
              value=Call(
                func=Name(id='set', ctx=Load()),
                args=[
                  Call(
                    func=Attribute(
                      value=Name(id='prev_section', ctx=Load()),
                      attr='get',
                      ctx=Load()),
                    args=[
                      Constant(value='fields'),
                      List(ctx=Load())])])),
            If(
              test=UnaryOp(
                op=Not(),
                operand=Name(id='prev_fields', ctx=Load())),
              body=[
                Continue()]),
            Assert(
              test=Compare(
                left=Name(id='section_name', ctx=Load()),
                ops=[
                  In()],
                comparators=[
                  Name(id='new', ctx=Load())]),
              msg=JoinedStr(
                values=[
                  Constant(value="Section '"),
                  FormattedValue(
                    value=Name(id='section_name', ctx=Load()),
                    conversion=-1),
                  Constant(value="' missing from v10.7 baseline")])),
            Assign(
              targets=[
                Name(id='new_section', ctx=Store())],
              value=Subscript(
                value=Name(id='new', ctx=Load()),
                slice=Name(id='section_name', ctx=Load()),
                ctx=Load())),
            Assign(
              targets=[
                Name(id='new_fields', ctx=Store())],
              value=Call(
                func=Name(id='set', ctx=Load()),
                args=[
                  Call(
                    func=Attribute(
                      value=Name(id='new_section', ctx=Load()),
                      attr='get',
                      ctx=Load()),
                    args=[
                      Constant(value='fields'),
                      List(ctx=Load())])])),
            Assign(
              targets=[
                Name(id='missing', ctx=Store())],
              value=BinOp(
                left=Name(id='prev_fields', ctx=Load()),
                op=Sub(),
                right=Name(id='new_fields', ctx=Load()))),
            Assert(
              test=UnaryOp(
                op=Not(),
                operand=Name(id='missing', ctx=Load())),
              msg=JoinedStr(
                values=[
                  Constant(value="Section '"),
                  FormattedValue(
                    value=Name(id='section_name', ctx=Load()),
                    conversion=-1),
                  Constant(value="' in v10.7 is missing fields from previous baseline: "),
                  FormattedValue(
                    value=Call(
                      func=Name(id='sorted', ctx=Load()),
                      args=[
                        Name(id='missing', ctx=Load())]),
                    conversion=-1)]))])])])