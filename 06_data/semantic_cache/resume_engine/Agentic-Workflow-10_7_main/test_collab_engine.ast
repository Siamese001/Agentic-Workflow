Module(
  body=[
    Import(
      names=[
        alias(name='types')]),
    ImportFrom(
      module='core_v10_7.services',
      names=[
        alias(name='CollaborationEngine')],
      level=0),
    FunctionDef(
      name='_make_config',
      args=arguments(
        args=[
          arg(
            arg='enabled',
            annotation=Name(id='bool', ctx=Load()))]),
      body=[
        Assign(
          targets=[
            Name(id='cfg', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='types', ctx=Load()),
              attr='SimpleNamespace',
              ctx=Load()),
            keywords=[
              keyword(
                arg='enabled',
                value=Name(id='enabled', ctx=Load())),
              keyword(
                arg='max_team_size',
                value=Constant(value=4)),
              keyword(
                arg='allow_agent_feedback',
                value=Constant(value=True))])),
        Return(
          value=Call(
            func=Attribute(
              value=Name(id='types', ctx=Load()),
              attr='SimpleNamespace',
              ctx=Load()),
            keywords=[
              keyword(
                arg='collaboration_config',
                value=Name(id='cfg', ctx=Load()))]))]),
    FunctionDef(
      name='test_team_formation',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='config', ctx=Store())],
          value=Call(
            func=Name(id='_make_config', ctx=Load()),
            keywords=[
              keyword(
                arg='enabled',
                value=Constant(value=True))])),
        Assign(
          targets=[
            Name(id='engine', ctx=Store())],
          value=Call(
            func=Name(id='CollaborationEngine', ctx=Load()),
            args=[
              Name(id='config', ctx=Load())])),
        Assign(
          targets=[
            Name(id='team', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='engine', ctx=Load()),
              attr='form_team',
              ctx=Load()),
            args=[
              Constant(value='StrategyStack')])),
        Assert(
          test=Compare(
            left=Name(id='team', ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              List(
                elts=[
                  Constant(value='StrategyStack'),
                  Constant(value='StrategyStack_aux')],
                ctx=Load())]))]),
    FunctionDef(
      name='test_feedback_merge',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='config', ctx=Store())],
          value=Call(
            func=Name(id='_make_config', ctx=Load()),
            keywords=[
              keyword(
                arg='enabled',
                value=Constant(value=True))])),
        Assign(
          targets=[
            Name(id='engine', ctx=Store())],
          value=Call(
            func=Name(id='CollaborationEngine', ctx=Load()),
            args=[
              Name(id='config', ctx=Load())])),
        Assign(
          targets=[
            Name(id='messages', ctx=Store())],
          value=List(
            elts=[
              Dict(
                keys=[
                  Constant(value='content')],
                values=[
                  Constant(value='alpha')]),
              Dict(
                keys=[
                  Constant(value='content')],
                values=[
                  Constant(value='beta')])],
            ctx=Load())),
        Assign(
          targets=[
            Name(id='merged', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='engine', ctx=Load()),
              attr='merge_feedback',
              ctx=Load()),
            args=[
              Name(id='messages', ctx=Load())])),
        Assert(
          test=Compare(
            left=Name(id='merged', ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Dict(
                keys=[
                  Constant(value='merged_feedback_count')],
                values=[
                  Constant(value=2)])]))])])