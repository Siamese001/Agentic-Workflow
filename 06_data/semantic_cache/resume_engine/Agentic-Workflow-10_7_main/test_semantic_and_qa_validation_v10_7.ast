                  Constant(value='v10_7'),
                  Constant(value='ConfidenceTest'),
                  Constant(value='AI Exec')])])),
        Assign(
          targets=[
            Name(id='qa', ctx=Store())],
          value=Subscript(
            value=Subscript(
              value=Name(id='out', ctx=Load()),
              slice=Constant(value='resume'),
              ctx=Load()),
            slice=Constant(value='qa'),
            ctx=Load())),
        Assert(
          test=Compare(
            left=Constant(value='confidence'),
            ops=[
              In()],
            comparators=[
              Name(id='qa', ctx=Load())]),
          msg=Constant(value='QA missing confidence score')),
        Assign(
