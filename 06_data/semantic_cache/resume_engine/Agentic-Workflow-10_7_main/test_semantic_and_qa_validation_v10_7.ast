                          In()],
                        comparators=[
                          Call(
                            func=Attribute(
                              value=Call(
                                func=Name(id='str', ctx=Load()),
                                args=[
                                  Name(id='i', ctx=Load())]),
                              attr='lower',
                              ctx=Load()))])])],
                is_async=0)])),
        Assert(
