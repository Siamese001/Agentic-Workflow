            ctx=Load())),
        Assert(
          test=Call(
            func=Name(id='isinstance', ctx=Load()),
            args=[
              Name(id='conf', ctx=Load()),
              Tuple(
                elts=[
                  Name(id='int', ctx=Load()),
                  Name(id='float', ctx=Load())],
                ctx=Load())]),
          msg=JoinedStr(
            values=[
              Constant(value='Confidence must be numeric; got '),
              FormattedValue(
                value=Call(
                  func=Name(id='type', ctx=Load()),
                  args=[
                    Name(id='conf', ctx=Load())]),
                conversion=-1)])),
        Assert(
          test=Compare(
            left=Constant(value=0),
            ops=[
              LtE(),
              LtE()],
            comparators=[
              Name(id='conf', ctx=Load()),
              Constant(value=1)]),
          msg=JoinedStr(
            values=[
              Constant(value='Confidence must be in [0,1], got '),
              FormattedValue(
                value=Name(id='conf', ctx=Load()),
                conversion=-1)]))],
      decorator_list=[
        Attribute(
          value=Attribute(
            value=Name(id='pytest', ctx=Load()),
            attr='mark',
            ctx=Load()),
          attr='validation',
          ctx=Load())]),
    FunctionDef(
