    ClassDef(
      name='ArbitrationEngine',
      body=[
        Expr(
          value=Constant(value='Lightweight arbitration service for cross-stack decisions.\n\n    The engine produces :class:`ArbitrationReport` objects whose\n    ``suggested_route`` field is now normalized to a small, explicit set of\n    routing codes so orchestration layers can treat arbitration as the\n    authoritative policy plane. The canonical codes are:\n\n    * ``"ACCEPT"`` – continue forward; equivalent to no-op.\n    * ``"REPLAN_STRATEGY"`` – rerun the strategy stack.\n    * ``"RETRY_RAG"`` – re-run RAG / prompt-join logic.\n    * ``"RETRY_BULLETS"`` – retry bullet generation + critique.\n    * ``"RETRY_DRAFTING"`` – revisit drafting before QA.\n    * ``"RETRY_QA"`` – retry QA validation (may still branch through\n      drafting depending on orchestration wiring).\n    * ``"GLOBAL_REPLAN"`` – escalate to the global replanner / halt.\n\n    Future codes must be added here so downstream orchestration can continue\n    to rely on an explicit and finite routing vocabulary.\n    ')),
        Assign(
          targets=[
            Name(id='ROUTE_ACCEPT', ctx=Store())],
          value=Constant(value='ACCEPT')),
        Assign(
          targets=[
            Name(id='ROUTE_REPLAN_STRATEGY', ctx=Store())],
          value=Constant(value='REPLAN_STRATEGY')),
        Assign(
          targets=[
            Name(id='ROUTE_RETRY_RAG', ctx=Store())],
          value=Constant(value='RETRY_RAG')),
        Assign(
          targets=[
            Name(id='ROUTE_RETRY_BULLETS', ctx=Store())],
          value=Constant(value='RETRY_BULLETS')),
        Assign(
          targets=[
            Name(id='ROUTE_RETRY_DRAFTING', ctx=Store())],
          value=Constant(value='RETRY_DRAFTING')),
        Assign(
          targets=[
            Name(id='ROUTE_RETRY_QA', ctx=Store())],
          value=Constant(value='RETRY_QA')),
        Assign(
          targets=[
            Name(id='ROUTE_GLOBAL_REPLAN', ctx=Store())],
          value=Constant(value='GLOBAL_REPLAN')),
        FunctionDef(
          name='__init__',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='config',
                annotation=Name(id='ConfigV10_7', ctx=Load())),
              arg(
                arg='metrics',
                annotation=Name(id='MetricsCollector', ctx=Load()))]),
          body=[
            Assign(
