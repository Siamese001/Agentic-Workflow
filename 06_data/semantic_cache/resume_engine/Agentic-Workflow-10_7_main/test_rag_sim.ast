Module(
  body=[
    Expr(
      value=Constant(value='Tests for RAG simulator.')),
    Import(
      names=[
        alias(name='pytest')]),
    ImportFrom(
      module='simulations.engines.rag_sim',
      names=[
        alias(name='RAGSimulator')],
      level=0),
    ImportFrom(
      module='simulations.models',
      names=[
        alias(name='RAGSimRequest')],
      level=0),
    AsyncFunctionDef(
      name='test_rag_simulator_returns_result',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='simulator', ctx=Store())],
          value=Call(
            func=Name(id='RAGSimulator', ctx=Load()))),
        Assign(
          targets=[
            Name(id='request', ctx=Store())],
          value=Call(
            func=Name(id='RAGSimRequest', ctx=Load()),
            keywords=[
              keyword(
                arg='simulation_id',
                value=Constant(value='sim-rag')),
              keyword(arg='payload', value=Dict()),
              keyword(
                arg='query',
                value=Constant(value='test')),
              keyword(
                arg='documents',
                value=List(
                  elts=[
                    Constant(value='doc1'),
                    Constant(value='doc2'),
                    Constant(value='doc3')],
                  ctx=Load()))])),
        Assign(
          targets=[
            Name(id='result', ctx=Store())],
          value=Await(
            value=Call(
              func=Attribute(
                value=Name(id='simulator', ctx=Load()),
                attr='run',
                ctx=Load()),
              args=[
                Name(id='request', ctx=Load())]))),
        Assert(
          test=Compare(
            left=Attribute(
              value=Name(id='result', ctx=Load()),
              attr='success',
              ctx=Load()),
            ops=[
              Is()],
            comparators=[
              Constant(value=True)])),
        Assert(
          test=Compare(
            left=Constant(value=0.0),
            ops=[
              LtE(),
              LtE()],
            comparators=[
              Subscript(
                value=Attribute(
                  value=Name(id='result', ctx=Load()),
                  attr='metrics',
                  ctx=Load()),
                slice=Constant(value='recall'),
                ctx=Load()),
              Constant(value=1.0)])),
        Assert(
          test=Compare(
            left=Constant(value=0.0),
            ops=[
              LtE(),
              LtE()],
            comparators=[
              Subscript(
                value=Attribute(
                  value=Name(id='result', ctx=Load()),
                  attr='metrics',
                  ctx=Load()),
                slice=Constant(value='precision'),
                ctx=Load()),
              Constant(value=1.0)])),
        Assert(
          test=Compare(
            left=Constant(value=0.0),
            ops=[
              LtE(),
              LtE()],
            comparators=[
              Subscript(
                value=Attribute(
                  value=Name(id='result', ctx=Load()),
                  attr='metrics',
                  ctx=Load()),
                slice=Constant(value='redundancy'),
                ctx=Load()),
              Constant(value=1.0)])),
        Assert(
          test=Call(
            func=Name(id='isinstance', ctx=Load()),
            args=[
              Subscript(
                value=Attribute(
                  value=Name(id='result', ctx=Load()),
                  attr='details',
                  ctx=Load()),
                slice=Constant(value='top_documents'),
                ctx=Load()),
              Name(id='list', ctx=Load())]))],
      decorator_list=[
        Attribute(
          value=Attribute(
            value=Name(id='pytest', ctx=Load()),
            attr='mark',
            ctx=Load()),
          attr='asyncio',
          ctx=Load())]),
    FunctionDef(
      name='test_rag_request_validation',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='request', ctx=Store())],
          value=Call(
            func=Name(id='RAGSimRequest', ctx=Load()),
            keywords=[
              keyword(
                arg='simulation_id',
                value=Constant(value='sim-rag-validate')),
              keyword(arg='payload', value=Dict()),
              keyword(
                arg='query',
                value=Constant(value='hello')),
              keyword(
                arg='documents',
                value=List(
                  elts=[
                    Constant(value='a')],
                  ctx=Load()))])),
        Assert(
          test=Compare(
            left=Attribute(
              value=Name(id='request', ctx=Load()),
              attr='query',
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value='hello')])),
        Assert(
          test=Compare(
            left=Attribute(
              value=Name(id='request', ctx=Load()),
              attr='documents',
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              List(
                elts=[
                  Constant(value='a')],
                ctx=Load())]))])])