            ctx=Load()),
          args=[
            Constant(value='bad_jd'),
            List(
              elts=[
                Constant(value=None),
                Constant(value=''),
                Constant(value=0),
                List(ctx=Load()),
                Dict()],
              ctx=Load())])]),
    FunctionDef(
      name='test_no_stack_trace_leakage_on_bad_inputs',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='out', ctx=Store())],
          value=Call(
            func=Name(id='run_workflow', ctx=Load()),
            args=[
              Dict(
                keys=[
                  Constant(value='compat_mode'),
                  Constant(value='resume'),
                  Constant(value='jd')],
                values=[
                  Constant(value='v10_7'),
                  List(
                    elts=[
                      Constant(value='bad'),
                      Constant(value='format')],
                    ctx=Load()),
                  Constant(value='AI Exec')])])),
        Assign(
          targets=[
            Name(id='serialized', ctx=Store())],
          value=Call(
            func=Name(id='str', ctx=Load()),
            args=[
              Name(id='out', ctx=Load())])),
        Assert(
          test=UnaryOp(
            op=Not(),
            operand=Call(
              func=Name(id='_contains_trace', ctx=Load()),
              args=[
                Name(id='serialized', ctx=Load())])),
          msg=Constant(value='Raw stack trace leaked into output. Envelope normalization failed.')),
        Assert(
          test=Compare(
            left=Subscript(
              value=Name(id='out', ctx=Load()),
              slice=Constant(value='status'),
              ctx=Load()),
            ops=[
              In()],
            comparators=[
              Set(
                elts=[
                  Constant(value='fail'),
                  Constant(value='blocked')])]))],
      decorator_list=[
        Attribute(
          value=Attribute(
            value=Name(id='pytest', ctx=Load()),
            attr='mark',
            ctx=Load()),
          attr='routing',
          ctx=Load())]),
    FunctionDef(
      name='test_downstream_agents_never_run_after_safety_fail',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='out', ctx=Store())],
          value=Call(
            func=Name(id='run_workflow', ctx=Load()),
            args=[
              Dict(
                keys=[
                  Constant(value='compat_mode'),
                  Constant(value='resume'),
                  Constant(value='jd')],
                values=[
                  Constant(value='v10_7'),
                  Constant(value=None),
                  Constant(value='AI Exec')])])),
        Assign(
          targets=[
            Name(id='events', ctx=Store())],
          value=ListComp(
            elt=Call(
              func=Attribute(
                value=Call(
                  func=Name(id='str', ctx=Load()),
                  args=[
                    Name(id='e', ctx=Load())]),
                attr='lower',
                ctx=Load())),
            generators=[
              comprehension(
                target=Name(id='e', ctx=Store()),
                iter=Call(
                  func=Attribute(
                    value=Name(id='out', ctx=Load()),
                    attr='get',
                    ctx=Load()),
                  args=[
                    Constant(value='events'),
                    List(ctx=Load())]),
                is_async=0)])),
        Assert(
          test=Call(
            func=Name(id='any', ctx=Load()),
            args=[
              GeneratorExp(
                elt=Compare(
                  left=Constant(value='safety'),
                  ops=[
                    In()],
                  comparators=[
                    Name(id='e', ctx=Load())]),
                generators=[
                  comprehension(
                    target=Name(id='e', ctx=Store()),
                    iter=Name(id='events', ctx=Load()),
                    is_async=0)])]),
          msg=Constant(value='No Safety event on malformed input')),
        Assign(
          targets=[
            Name(id='forbidden', ctx=Store())],
          value=List(
            elts=[
              Constant(value='rag'),
              Constant(value='bullet'),
              Constant(value='draft'),
              Constant(value='qa'),
              Constant(value='hil')],
            ctx=Load())),
        For(
          target=Name(id='f', ctx=Store()),
          iter=Name(id='forbidden', ctx=Load()),
          body=[
            Assert(
              test=Call(
                func=Name(id='all', ctx=Load()),
                args=[
                  GeneratorExp(
                    elt=Compare(
                      left=Name(id='f', ctx=Load()),
                      ops=[
                        NotIn()],
                      comparators=[
                        Name(id='e', ctx=Load())]),
                    generators=[
                      comprehension(
                        target=Name(id='e', ctx=Store()),
                        iter=Name(id='events', ctx=Load()),
                        is_async=0)])]),
              msg=JoinedStr(
                values=[
                  Constant(value="Forbidden downstream agent '"),
                  FormattedValue(
                    value=Name(id='f', ctx=Load()),
                    conversion=-1),
                  Constant(value="' executed after SafetyGuard failure")]))])],
      decorator_list=[
        Attribute(
          value=Attribute(
            value=Name(id='pytest', ctx=Load()),
            attr='mark',
            ctx=Load()),
          attr='routing',
          ctx=Load())]),
    FunctionDef(
      name='test_retry_not_triggered_on_malformed_input',
      args=arguments(
        args=[
          arg(arg='bad')]),
      body=[
        If(
          test=Call(
            func=Name(id='isinstance', ctx=Load()),
            args=[
              Name(id='bad', ctx=Load()),
              Name(id='dict', ctx=Load())]),
          body=[
            Assign(
              targets=[
                Name(id='inp', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='compat_mode'),
                  Constant(value='resume'),
                  Constant(value='jd')],
                values=[
                  Constant(value='v10_7'),
                  Call(
                    func=Attribute(
                      value=Name(id='bad', ctx=Load()),
                      attr='get',
                      ctx=Load()),
                    args=[
                      Constant(value='resume')]),
                  Call(
                    func=Attribute(
                      value=Name(id='bad', ctx=Load()),
                      attr='get',
                      ctx=Load()),
                    args=[
                      Constant(value='jd')])]))],
          orelse=[
            Assign(
              targets=[
                Name(id='inp', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='compat_mode'),
                  Constant(value='resume'),
                  Constant(value='jd')],
                values=[
                  Constant(value='v10_7'),
                  Name(id='bad', ctx=Load()),
                  Constant(value='AI Exec')]))]),
        Assign(
          targets=[
            Name(id='out', ctx=Store())],
          value=Call(
            func=Name(id='run_workflow', ctx=Load()),
            args=[
              Name(id='inp', ctx=Load())])),
        Assign(
          targets=[
            Name(id='events', ctx=Store())],
          value=ListComp(
            elt=Call(
              func=Attribute(
                value=Call(
                  func=Name(id='str', ctx=Load()),
                  args=[
                    Name(id='e', ctx=Load())]),
                attr='lower',
                ctx=Load())),
            generators=[
              comprehension(
                target=Name(id='e', ctx=Store()),
                iter=Call(
                  func=Attribute(
                    value=Name(id='out', ctx=Load()),
                    attr='get',
                    ctx=Load()),
                  args=[
                    Constant(value='events'),
                    List(ctx=Load())]),
                is_async=0)])),
        Assert(
          test=UnaryOp(
            op=Not(),
            operand=Call(
              func=Name(id='any', ctx=Load()),
              args=[
                GeneratorExp(
                  elt=Compare(
                    left=Constant(value='retry'),
                    ops=[
                      In()],
                    comparators=[
                      Name(id='e', ctx=Load())]),
                  generators=[
                    comprehension(
                      target=Name(id='e', ctx=Store()),
                      iter=Name(id='events', ctx=Load()),
                      is_async=0)])])),
          msg=Constant(value='Retry loop incorrectly triggered on malformed input'))],
      decorator_list=[
        Attribute(
          value=Attribute(
            value=Name(id='pytest', ctx=Load()),
            attr='mark',
            ctx=Load()),
          attr='routing',
          ctx=Load()),
        Call(
          func=Attribute(
            value=Attribute(
              value=Name(id='pytest', ctx=Load()),
              attr='mark',
              ctx=Load()),
            attr='parametrize',
            ctx=Load()),
          args=[
            Constant(value='bad'),
            List(
              elts=[
                Constant(value=None),
                Dict(),
                Dict(
                  keys=[
                    Constant(value='jd')],
                  values=[
                    Constant(value='AI')]),
                Dict(
                  keys=[
                    Constant(value='resume')],
                  values=[
                    Constant(value='AI')])],
              ctx=Load())])]),
    FunctionDef(
      name='test_downstream_schema_violation_triggers_normalized_error',
      args=arguments(),
      body=[
        Expr(
          value=Constant(value='\n    Artificial scenario: \n    Some agents may return malformed downstream data under refactor\n    (e.g., Drafting returns a non-dict). The system must normalize\n    this to fail, not propagate a Python error.\n    ')),
        Assign(
          targets=[
            Name(id='out', ctx=Store())],
          value=Call(
            func=Name(id='run_workflow', ctx=Load()),
            args=[
              Dict(
                keys=[
                  Constant(value='compat_mode'),
                  Constant(value='resume'),
                  Constant(value='jd')],
                values=[
                  Constant(value='v10_7'),
                  Constant(value='BAD_DOWNSTREAM_SIM'),
                  Constant(value='simulate-downstream-error')])])),
        Assert(
          test=Call(
            func=Name(id='isinstance', ctx=Load()),
            args=[
              Name(id='out', ctx=Load()),
              Name(id='dict', ctx=Load())]),
          msg=Constant(value='Workflow crashed — returned no envelope')),
        Assert(
          test=Compare(
            left=Subscript(
              value=Name(id='out', ctx=Load()),
              slice=Constant(value='status'),
              ctx=Load()),
            ops=[
              In()],
            comparators=[
              Set(
                elts=[
                  Constant(value='fail'),
                  Constant(value='blocked')])]),
          msg=JoinedStr(
            values=[
              Constant(value='Downstream schema violation must trigger fail/blocked, not '),
              FormattedValue(
                value=Subscript(
                  value=Name(id='out', ctx=Load()),
                  slice=Constant(value='status'),
                  ctx=Load()),
                conversion=-1)])),
        Assign(
          targets=[
            Name(id='serialized', ctx=Store())],
          value=Call(
            func=Name(id='str', ctx=Load()),
            args=[
              Name(id='out', ctx=Load())])),
        Assert(
          test=BoolOp(
            op=Or(),
            values=[
              Compare(
                left=Constant(value='error'),
                ops=[
                  In()],
                comparators=[
                  Call(
                    func=Attribute(
                      value=Name(id='serialized', ctx=Load()),
                      attr='lower',
                      ctx=Load()))]),
              Compare(
                left=Constant(value='issues'),
                ops=[
                  In()],
                comparators=[
                  Call(
                    func=Attribute(
                      value=Name(id='serialized', ctx=Load()),
                      attr='lower',
                      ctx=Load()))])]),
          msg=Constant(value='Downstream schema error did not propagate into structured envelope'))],
      decorator_list=[
        Attribute(
          value=Attribute(
            value=Name(id='pytest', ctx=Load()),
            attr='mark',
            ctx=Load()),
          attr='routing',
          ctx=Load())]),
