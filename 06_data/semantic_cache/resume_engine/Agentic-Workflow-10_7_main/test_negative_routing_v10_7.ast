                  elt=Compare(
                    left=Constant(value='rag'),
                    ops=[
                      In()],
                    comparators=[
                      Name(id='e', ctx=Load())]),
                  generators=[
                    comprehension(
                      target=Name(id='e', ctx=Store()),
