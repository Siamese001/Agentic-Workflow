Module(
  body=[
    Import(
      names=[
        alias(name='pytest')]),
    ImportFrom(
      module='workflow.runner',
      names=[
        alias(name='run_workflow')],
      level=0),
    Import(
      names=[
        alias(name='re')]),
    Assign(
      targets=[
        Name(id='TRACE_PATTERNS', ctx=Store())],
      value=List(
        elts=[
          Constant(value='Traceback (most recent call last)'),
          Constant(value='File "'),
          Constant(value='Exception:'),
          Constant(value='ValueError:'),
          Constant(value='TypeError:'),
          Constant(value='KeyError:')],
        ctx=Load())),
    FunctionDef(
      name='_contains_trace',
      args=arguments(
        args=[
          arg(
            arg='text',
            annotation=Name(id='str', ctx=Load()))]),
      body=[
        Return(
          value=Call(
            func=Name(id='any', ctx=Load()),
            args=[
              GeneratorExp(
                elt=Compare(
                  left=Name(id='pat', ctx=Load()),
                  ops=[
                    In()],
                  comparators=[
                    Name(id='text', ctx=Load())]),
                generators=[
                  comprehension(
                    target=Name(id='pat', ctx=Store()),
                    iter=Name(id='TRACE_PATTERNS', ctx=Load()),
                    is_async=0)])]))],
      returns=Name(id='bool', ctx=Load())),
    FunctionDef(
      name='test_safetyguard_blocks_unsafe_inputs',
      args=arguments(
        args=[
          arg(arg='unsafe_payload')]),
      body=[
        Expr(
          value=Constant(value="\n    SafetyGuard must run FIRST and block invalid payloads with a\n    normalized {status:'blocked', error:{...}} envelope.\n    ")),
        If(
          test=Call(
            func=Name(id='isinstance', ctx=Load()),
            args=[
              Name(id='unsafe_payload', ctx=Load()),
              Name(id='dict', ctx=Load())]),
          body=[
            Assign(
              targets=[
                Name(id='inp', ctx=Store())],
              value=Dict(
                keys=[
                  None,
                  Constant(value='compat_mode')],
                values=[
                  Name(id='unsafe_payload', ctx=Load()),
                  Constant(value='v10_7')]))],
          orelse=[
            Assign(
              targets=[
                Name(id='inp', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='compat_mode'),
                  Constant(value='resume'),
                  Constant(value='jd')],
                values=[
                  Constant(value='v10_7'),
                  Name(id='unsafe_payload', ctx=Load()),
                  Constant(value='AI Exec')]))]),
        Assign(
          targets=[
            Name(id='out', ctx=Store())],
          value=Call(
            func=Name(id='run_workflow', ctx=Load()),
            args=[
              Name(id='inp', ctx=Load())])),
        Assert(
          test=Call(
            func=Name(id='isinstance', ctx=Load()),
            args=[
              Name(id='out', ctx=Load()),
              Name(id='dict', ctx=Load())]),
          msg=Constant(value='Workflow output must be dict')),
        Assert(
          test=Compare(
            left=Subscript(
              value=Name(id='out', ctx=Load()),
              slice=Constant(value='status'),
              ctx=Load()),
            ops=[
              In()],
            comparators=[
              Set(
                elts=[
                  Constant(value='blocked'),
                  Constant(value='fail')])]),
          msg=JoinedStr(
            values=[
              Constant(value='Unsafe payload should block early. Got status='),
              FormattedValue(
                value=Subscript(
                  value=Name(id='out', ctx=Load()),
                  slice=Constant(value='status'),
                  ctx=Load()),
                conversion=-1)])),
        Assign(
          targets=[
            Name(id='events', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='out', ctx=Load()),
              attr='get',
              ctx=Load()),
            args=[
              Constant(value='events'),
              List(ctx=Load())])),
        Assert(
          test=Call(
            func=Name(id='any', ctx=Load()),
            args=[
              GeneratorExp(
                elt=Compare(
                  left=Constant(value='safety'),
                  ops=[
                    In()],
                  comparators=[
                    Call(
                      func=Attribute(
                        value=Call(
                          func=Name(id='str', ctx=Load()),
                          args=[
                            Name(id='e', ctx=Load())]),
                        attr='lower',
                        ctx=Load()))]),
                generators=[
                  comprehension(
                    target=Name(id='e', ctx=Store()),
                    iter=Name(id='events', ctx=Load()),
                    is_async=0)])]),
          msg=Constant(value='SafetyGuard event missing despite unsafe input')),
        Assign(
          targets=[
            Name(id='forbidden', ctx=Store())],
          value=List(
            elts=[
              Constant(value='rag'),
              Constant(value='draft'),
              Constant(value='qa'),
              Constant(value='hil'),
              Constant(value='bullet')],
            ctx=Load())),
        Assert(
          test=UnaryOp(
            op=Not(),
            operand=Call(
              func=Name(id='any', ctx=Load()),
              args=[
                GeneratorExp(
                  elt=Compare(
                    left=Name(id='f', ctx=Load()),
                    ops=[
                      In()],
                    comparators=[
                      Call(
                        func=Attribute(
                          value=Call(
                            func=Name(id='str', ctx=Load()),
                            args=[
                              Name(id='e', ctx=Load())]),
                          attr='lower',
                          ctx=Load()))]),
                  generators=[
                    comprehension(
                      target=Name(id='f', ctx=Store()),
                      iter=Name(id='forbidden', ctx=Load()),
                      is_async=0),
                    comprehension(
                      target=Name(id='e', ctx=Store()),
                      iter=Name(id='events', ctx=Load()),
                      is_async=0)])])),
          msg=Constant(value='Downstream agents executed despite unsafe input'))],
      decorator_list=[
        Attribute(
          value=Attribute(
            value=Name(id='pytest', ctx=Load()),
            attr='mark',
            ctx=Load()),
          attr='routing',
          ctx=Load()),
        Call(
          func=Attribute(
            value=Attribute(
              value=Name(id='pytest', ctx=Load()),
              attr='mark',
              ctx=Load()),
            attr='parametrize',
            ctx=Load()),
          args=[
            Constant(value='unsafe_payload'),
            List(
              elts=[
                Constant(value=None),
                Constant(value=''),
                Constant(value=0),
                Constant(value=123),
                Dict(),
                Dict(
                  keys=[
                    Constant(value='resume'),
                    Constant(value='jd')],
                  values=[
                    Constant(value=None),
                    Constant(value='AI Exec')]),
                Dict(
                  keys=[
                    Constant(value='resume'),
                    Constant(value='jd')],
                  values=[
                    Constant(value='AI Exec'),
                    Constant(value=None)])],
              ctx=Load())])]),
    FunctionDef(
      name='test_invalid_jd_blocks_strategy_and_downstream',
      args=arguments(
        args=[
          arg(arg='bad_jd')]),
      body=[
        Assign(
          targets=[
            Name(id='out', ctx=Store())],
          value=Call(
            func=Name(id='run_workflow', ctx=Load()),
            args=[
              Dict(
                keys=[
                  Constant(value='compat_mode'),
                  Constant(value='resume'),
                  Constant(value='jd')],
                values=[
                  Constant(value='v10_7'),
                  Constant(value='Test Resume'),
                  Name(id='bad_jd', ctx=Load())])])),
        Assert(
          test=Compare(
            left=Subscript(
              value=Name(id='out', ctx=Load()),
              slice=Constant(value='status'),
              ctx=Load()),
            ops=[
              In()],
            comparators=[
              Set(
                elts=[
                  Constant(value='blocked'),
                  Constant(value='fail')])])),
        Assign(
          targets=[
            Name(id='events', ctx=Store())],
          value=ListComp(
            elt=Call(
              func=Attribute(
                value=Call(
                  func=Name(id='str', ctx=Load()),
                  args=[
                    Name(id='e', ctx=Load())]),
                attr='lower',
                ctx=Load())),
            generators=[
              comprehension(
                target=Name(id='e', ctx=Store()),
                iter=Call(
                  func=Attribute(
                    value=Name(id='out', ctx=Load()),
                    attr='get',
                    ctx=Load()),
                  args=[
                    Constant(value='events'),
                    List(ctx=Load())]),
                is_async=0)])),
        Assert(
          test=Call(
            func=Name(id='any', ctx=Load()),
            args=[
              GeneratorExp(
                elt=Compare(
                  left=Constant(value='strategy'),
                  ops=[
                    In()],
                  comparators=[
                    Name(id='e', ctx=Load())]),
                generators=[
                  comprehension(
                    target=Name(id='e', ctx=Store()),
                    iter=Name(id='events', ctx=Load()),
                    is_async=0)])]),
          msg=Constant(value='Strategy did not run on invalid JD')),
        Assert(
          test=UnaryOp(
            op=Not(),
            operand=Call(
              func=Name(id='any', ctx=Load()),
              args=[
                GeneratorExp(
                  elt=Compare(
                    left=Constant(value='rag'),
                    ops=[
                      In()],
                    comparators=[
                      Name(id='e', ctx=Load())]),
                  generators=[
                    comprehension(
                      target=Name(id='e', ctx=Store()),
                      iter=Name(id='events', ctx=Load()),
                      is_async=0)])]))),
        Assert(
          test=UnaryOp(
            op=Not(),
            operand=Call(
              func=Name(id='any', ctx=Load()),
              args=[
                GeneratorExp(
                  elt=Compare(
                    left=Constant(value='bullet'),
                    ops=[
                      In()],
                    comparators=[
                      Name(id='e', ctx=Load())]),
                  generators=[
                    comprehension(
                      target=Name(id='e', ctx=Store()),
                      iter=Name(id='events', ctx=Load()),
                      is_async=0)])]))),
        Assert(
          test=UnaryOp(
            op=Not(),
            operand=Call(
              func=Name(id='any', ctx=Load()),
              args=[
                GeneratorExp(
                  elt=Compare(
                    left=Constant(value='draft'),
                    ops=[
                      In()],
                    comparators=[
                      Name(id='e', ctx=Load())]),
                  generators=[
                    comprehension(
                      target=Name(id='e', ctx=Store()),
                      iter=Name(id='events', ctx=Load()),
                      is_async=0)])]))),
        Assert(
          test=UnaryOp(
            op=Not(),
            operand=Call(
              func=Name(id='any', ctx=Load()),
              args=[
                GeneratorExp(
                  elt=Compare(
                    left=Constant(value='qa'),
                    ops=[
                      In()],
                    comparators=[
                      Name(id='e', ctx=Load())]),
                  generators=[
                    comprehension(
                      target=Name(id='e', ctx=Store()),
                      iter=Name(id='events', ctx=Load()),
                      is_async=0)])]))),
        Assert(
          test=UnaryOp(
            op=Not(),
            operand=Call(
              func=Name(id='any', ctx=Load()),
              args=[
                GeneratorExp(
                  elt=Compare(
                    left=Constant(value='hil'),
                    ops=[
                      In()],
                    comparators=[
                      Name(id='e', ctx=Load())]),
                  generators=[
                    comprehension(
                      target=Name(id='e', ctx=Store()),
                      iter=Name(id='events', ctx=Load()),
                      is_async=0)])])))],
      decorator_list=[
        Attribute(
          value=Attribute(
            value=Name(id='pytest', ctx=Load()),
            attr='mark',
            ctx=Load()),
          attr='routing',
          ctx=Load()),
        Call(
          func=Attribute(
            value=Attribute(
              value=Name(id='pytest', ctx=Load()),
