      returns=Subscript(
        value=Name(id='List', ctx=Load()),
        slice=Subscript(
          value=Name(id='List', ctx=Load()),
          slice=Name(id='Path', ctx=Load()),
          ctx=Load()),
        ctx=Load())),
    FunctionDef(
      name='write_parts',
      args=arguments(
