                  attr='ceil',
                  ctx=Load()),
                args=[
                  BinOp(
                    left=Name(id='total_lines', ctx=Load()),
                    op=Div(),
                    right=Name(id='max_parts', ctx=Load()))])]))],
      returns=Name(id='int', ctx=Load())),
    FunctionDef(
      name='group_files',
      args=arguments(
        args=[
          arg(
