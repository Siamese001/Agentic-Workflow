            ctx=Load()),
          value=List(
            elts=[
              List(ctx=Load())],
            ctx=Load()),
          simple=1),
        Assign(
          targets=[
            Name(id='current_lines', ctx=Store())],
          value=Constant(value=0)),
        For(
          target=Name(id='path', ctx=Store()),
          iter=Name(id='paths', ctx=Load()),
          body=[
            With(
              items=[
                withitem(
                  context_expr=Call(
                    func=Attribute(
                      value=Name(id='path', ctx=Load()),
                      attr='open',
                      ctx=Load()),
                    args=[
                      Constant(value='r')],
                    keywords=[
                      keyword(
                        arg='encoding',
                        value=Constant(value='utf-8')),
                      keyword(
                        arg='errors',
                        value=Constant(value='replace'))]),
                  optional_vars=Name(id='fh', ctx=Store()))],
              body=[
                Assign(
                  targets=[
                    Name(id='line_count', ctx=Store())],
                  value=Call(
                    func=Name(id='sum', ctx=Load()),
                    args=[
                      GeneratorExp(
                        elt=Constant(value=1),
                        generators=[
                          comprehension(
                            target=Name(id='_', ctx=Store()),
                            iter=Name(id='fh', ctx=Load()),
                            is_async=0)])]))]),
            If(
              test=BoolOp(
                op=And(),
                values=[
                  Compare(
                    left=BinOp(
                      left=Name(id='current_lines', ctx=Load()),
                      op=Add(),
                      right=Name(id='line_count', ctx=Load())),
                    ops=[
                      Gt()],
                    comparators=[
                      Name(id='chunk_size', ctx=Load())]),
                  Compare(
                    left=Call(
                      func=Name(id='len', ctx=Load()),
                      args=[
                        Name(id='parts', ctx=Load())]),
                    ops=[
                      Lt()],
                    comparators=[
                      Name(id='max_parts', ctx=Load())])]),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='parts', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      List(ctx=Load())])),
                Assign(
                  targets=[
                    Name(id='current_lines', ctx=Store())],
                  value=Constant(value=0))]),
            Expr(
              value=Call(
                func=Attribute(
                  value=Subscript(
                    value=Name(id='parts', ctx=Load()),
