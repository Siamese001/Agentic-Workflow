          arg(
            arg='max_parts',
            annotation=Name(id='int', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='Group paths into parts so that total lines per part stay near chunk_size.')),
        AnnAssign(
          target=Name(id='parts', ctx=Store()),
