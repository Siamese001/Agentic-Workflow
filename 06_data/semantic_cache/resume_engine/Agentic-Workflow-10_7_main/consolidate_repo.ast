                    ctx=Load()),
                  attr='append',
                  ctx=Load()),
                args=[
                  Name(id='path', ctx=Load())])),
            AugAssign(
              target=Name(id='current_lines', ctx=Store()),
              op=Add(),
              value=Name(id='line_count', ctx=Load()))]),
        Return(
