Module(
  body=[
    Expr(
      value=Constant(value='Concatenate repository code into consolidated text bundles.\n\nThe script walks tracked text files in the repository and writes them into a\nhandful of consolidated parts for easier upload to ChatGPT. Files are grouped\nsequentially based on their line counts so that the total set fits into at most\n``max_parts`` outputs.\n')),
    ImportFrom(
      module='__future__',
      names=[
        alias(name='annotations')],
      level=0),
    Import(
      names=[
        alias(name='argparse')]),
    Import(
      names=[
        alias(name='math')]),
    Import(
      names=[
        alias(name='os')]),
    ImportFrom(
      module='pathlib',
      names=[
        alias(name='Path')],
      level=0),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Iterable'),
        alias(name='List')],
      level=0),
    Assign(
      targets=[
        Name(id='ROOT', ctx=Store())],
      value=Attribute(
        value=Attribute(
          value=Call(
            func=Attribute(
              value=Call(
                func=Name(id='Path', ctx=Load()),
                args=[
                  Name(id='__file__', ctx=Load())]),
              attr='resolve',
              ctx=Load())),
          attr='parent',
          ctx=Load()),
        attr='parent',
        ctx=Load())),
    FunctionDef(
      name='is_text_file',
      args=arguments(
        args=[
          arg(
            arg='path',
            annotation=Name(id='Path', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='Return True when the file appears to be text, False for binary files.')),
        Try(
          body=[
            With(
              items=[
                withitem(
                  context_expr=Call(
                    func=Attribute(
                      value=Name(id='path', ctx=Load()),
                      attr='open',
                      ctx=Load()),
                    args=[
                      Constant(value='rb')]),
                  optional_vars=Name(id='fh', ctx=Store()))],
              body=[
                Assign(
                  targets=[
                    Name(id='chunk', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='fh', ctx=Load()),
                      attr='read',
                      ctx=Load()),
                    args=[
                      Constant(value=2048)])),
                Return(
                  value=Compare(
                    left=Constant(value=b'\x00'),
                    ops=[
                      NotIn()],
                    comparators=[
                      Name(id='chunk', ctx=Load())]))])],
          handlers=[
            ExceptHandler(
              type=Name(id='OSError', ctx=Load()),
              body=[
                Return(
                  value=Constant(value=False))])])],
      returns=Name(id='bool', ctx=Load())),
    FunctionDef(
      name='iter_repo_files',
      args=arguments(),
      body=[
        Expr(
          value=Constant(value='Yield repo-tracked files under the root directory.')),
        Assign(
          targets=[
            Name(id='stream', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='os', ctx=Load()),
              attr='popen',
              ctx=Load()),
            args=[
              Constant(value='git ls-files')])),
        For(
          target=Name(id='line', ctx=Store()),
          iter=Name(id='stream', ctx=Load()),
          body=[
            Assign(
              targets=[
                Name(id='rel', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='line', ctx=Load()),
                  attr='strip',
                  ctx=Load()))),
            If(
              test=UnaryOp(
                op=Not(),
                operand=Name(id='rel', ctx=Load())),
              body=[
                Continue()]),
            Assign(
              targets=[
                Name(id='path', ctx=Store())],
              value=BinOp(
                left=Name(id='ROOT', ctx=Load()),
                op=Div(),
                right=Name(id='rel', ctx=Load()))),
            If(
              test=UnaryOp(
                op=Not(),
                operand=Call(
                  func=Attribute(
                    value=Name(id='path', ctx=Load()),
                    attr='exists',
                    ctx=Load()))),
              body=[
                Continue()]),
            If(
              test=Call(
                func=Attribute(
                  value=Name(id='rel', ctx=Load()),
                  attr='startswith',
                  ctx=Load()),
                args=[
                  Constant(value='consolidated/')]),
              body=[
                Continue()]),
            If(
              test=Call(
                func=Attribute(
                  value=Name(id='path', ctx=Load()),
                  attr='is_dir',
                  ctx=Load())),
              body=[
                Continue()]),
            If(
              test=UnaryOp(
                op=Not(),
                operand=Call(
                  func=Name(id='is_text_file', ctx=Load()),
                  args=[
                    Name(id='path', ctx=Load())])),
              body=[
                Continue()]),
            Expr(
              value=Yield(
                value=Name(id='path', ctx=Load())))])],
      returns=Subscript(
