              ctx=Load())),
          arg(
            arg='max_parts',
            annotation=Name(id='int', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='Compute a chunk size (lines per part) to stay within max_parts.')),
        Assign(
          targets=[
            Name(id='total_lines', ctx=Store())],
          value=Constant(value=0)),
        For(
          target=Name(id='path', ctx=Store()),
