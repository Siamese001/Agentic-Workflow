Module(
  body=[
    Expr(
      value=Constant(value='Utility helpers for simulation subsystem.')),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Any'),
        alias(name='Dict')],
      level=0),
    FunctionDef(
      name='model_to_payload',
      args=arguments(
        args=[
          arg(
            arg='model',
            annotation=Name(id='Any', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='Return a dict of public fields from a pydantic model.')),
        If(
          test=Compare(
            left=Name(id='model', ctx=Load()),
            ops=[
              Is()],
            comparators=[
              Constant(value=None)]),
          body=[
            Return(value=Dict())]),
        Assign(
          targets=[
            Name(id='data', ctx=Store())],
          value=Dict()),
        For(
          target=Tuple(
            elts=[
              Name(id='key', ctx=Store()),
              Name(id='value', ctx=Store())],
            ctx=Store()),
          iter=Call(
            func=Attribute(
              value=Call(
                func=Name(id='getattr', ctx=Load()),
                args=[
                  Name(id='model', ctx=Load()),
                  Constant(value='__dict__'),
                  Dict()]),
              attr='items',
              ctx=Load())),
          body=[
            If(
              test=Call(
                func=Attribute(
                  value=Name(id='key', ctx=Load()),
                  attr='startswith',
                  ctx=Load()),
                args=[
                  Constant(value='__')]),
              body=[
                Continue()]),
            Assign(
              targets=[
                Subscript(
                  value=Name(id='data', ctx=Load()),
                  slice=Name(id='key', ctx=Load()),
                  ctx=Store())],
              value=Name(id='value', ctx=Load()))]),
        Return(
          value=Name(id='data', ctx=Load()))],
      returns=Subscript(
        value=Name(id='Dict', ctx=Load()),
        slice=Tuple(
          elts=[
            Name(id='str', ctx=Load()),
            Name(id='Any', ctx=Load())],
          ctx=Load()),
        ctx=Load()))])