Module(
  body=[
    Expr(
      value=Constant(value='Safety simulation models.')),
    ImportFrom(
      module='pydantic',
      names=[
        alias(name='BaseModel')],
      level=0),
    ImportFrom(
      module='simulation_base',
      names=[
        alias(name='SimulationInput'),
        alias(name='SimulationResult')],
      level=1),
    ClassDef(
      name='SafetySimRequest',
      bases=[
        Name(id='SimulationInput', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Input payload for safety simulation.')),
        AnnAssign(
          target=Name(id='text', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1)]),
    ClassDef(
      name='SafetySimMetrics',
      bases=[
        Name(id='BaseModel', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Metrics produced by safety simulations.')),
        AnnAssign(
          target=Name(id='pii_risk', ctx=Store()),
          annotation=Name(id='float', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='injection_risk', ctx=Store()),
          annotation=Name(id='float', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='bias_risk', ctx=Store()),
          annotation=Name(id='float', ctx=Load()),
          simple=1)]),
    ClassDef(
      name='SafetySimResult',
      bases=[
        Name(id='SimulationResult', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Result model for safety simulations.')),
        Pass()])])