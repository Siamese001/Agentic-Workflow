Module(
  body=[
    Import(
      names=[
        alias(name='pytest')]),
    ImportFrom(
      module='agent_orchestration_v10_7',
      names=[
        alias(name='get_graph_app')],
      level=0),
    ImportFrom(
      module='agentic_workflow.workflow_v10_7.dag_spec',
      names=[
        alias(name='CONCEPTUAL_DAG'),
        alias(name='CONCEPTUAL_EDGES'),
        alias(name='all_concrete_nodes'),
        alias(name='conceptual_node_map')],
      level=0),
    Assign(
      targets=[
        Name(id='EXPECTED_NODES', ctx=Store())],
      value=List(
        elts=[
          Constant(value='SafetyGuardStack'),
          Constant(value='StrategyStack'),
          Constant(value='RAGStack'),
          Constant(value='BulletStack'),
          Constant(value='DraftingStack'),
          Constant(value='QAStack'),
          Constant(value='HILInteractionStack')],
        ctx=Load())),
    Assign(
      targets=[
        Name(id='EXPECTED_EDGES', ctx=Store())],
      value=List(
        elts=[
          Tuple(
            elts=[
              Constant(value='SafetyGuardStack'),
              Constant(value='StrategyStack')],
            ctx=Load()),
          Tuple(
            elts=[
              Constant(value='StrategyStack'),
              Constant(value='RAGStack')],
            ctx=Load()),
          Tuple(
            elts=[
              Constant(value='RAGStack'),
              Constant(value='BulletStack')],
            ctx=Load()),
          Tuple(
            elts=[
              Constant(value='BulletStack'),
              Constant(value='DraftingStack')],
            ctx=Load()),
          Tuple(
            elts=[
              Constant(value='DraftingStack'),
              Constant(value='QAStack')],
            ctx=Load()),
          Tuple(
            elts=[
              Constant(value='QAStack'),
              Constant(value='HILInteractionStack')],
            ctx=Load())],
        ctx=Load())),
    Assign(
      targets=[
        Name(id='EXPECTED_ORDER', ctx=Store())],
      value=List(
        elts=[
          Constant(value='SafetyGuardStack'),
          Constant(value='StrategyStack'),
          Constant(value='RAGStack'),
          Constant(value='BulletStack'),
          Constant(value='DraftingStack'),
          Constant(value='QAStack'),
          Constant(value='HILInteractionStack')],
        ctx=Load())),
    FunctionDef(
      name='compiled_workflow',
      args=arguments(
        args=[
          arg(arg='workflow_context')]),
      body=[
        Assign(
          targets=[
            Attribute(
              value=Attribute(
                value=Attribute(
                  value=Name(id='workflow_context', ctx=Load()),
                  attr='config',
                  ctx=Load()),
                attr='agent_stacks',
                ctx=Load()),
              attr='enable_hil_stack',
              ctx=Store())],
          value=Constant(value=True)),
        Assign(
          targets=[
            Name(id='workflow', ctx=Store())],
          value=Call(
            func=Name(id='get_graph_app', ctx=Load()),
            keywords=[
              keyword(
                arg='checkpointer',
                value=Constant(value=None)),
              keyword(
                arg='workflow_context',
                value=Name(id='workflow_context', ctx=Load())),
              keyword(
                arg='enable_hil',
                value=Constant(value=True))])),
        Return(
          value=Name(id='workflow', ctx=Load()))],
      decorator_list=[
        Call(
          func=Attribute(
            value=Name(id='pytest', ctx=Load()),
            attr='fixture',
            ctx=Load()))]),
    FunctionDef(
      name='_runtime_node_names',
      args=arguments(
        args=[
          arg(arg='compiled_workflow')]),
      body=[
        Return(
          value=Call(
            func=Name(id='set', ctx=Load()),
            args=[
              Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='compiled_workflow', ctx=Load()),
                    attr='nodes',
                    ctx=Load()),
                  attr='keys',
                  ctx=Load()))]))]),
    FunctionDef(
      name='test_conceptual_nodes_match_specification_order',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='names', ctx=Store())],
          value=ListComp(
            elt=Attribute(
              value=Name(id='node', ctx=Load()),
              attr='name',
              ctx=Load()),
            generators=[
              comprehension(
                target=Name(id='node', ctx=Store()),
                iter=Name(id='CONCEPTUAL_DAG', ctx=Load()),
                is_async=0)])),
        Assert(
          test=Compare(
            left=Name(id='names', ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Name(id='EXPECTED_ORDER', ctx=Load())]),
          msg=Constant(value='Conceptual DAG order drifted from spec'))],
      decorator_list=[
        Attribute(
          value=Attribute(
            value=Name(id='pytest', ctx=Load()),
            attr='mark',
            ctx=Load()),
          attr='design',
          ctx=Load())]),
    FunctionDef(
      name='test_conceptual_node_names_match_expected_set',
      args=arguments(),
      body=[
        Assert(
          test=Compare(
            left=Call(
              func=Name(id='set', ctx=Load()),
              args=[
                GeneratorExp(
                  elt=Attribute(
                    value=Name(id='node', ctx=Load()),
                    attr='name',
                    ctx=Load()),
                  generators=[
                    comprehension(
                      target=Name(id='node', ctx=Store()),
                      iter=Name(id='CONCEPTUAL_DAG', ctx=Load()),
                      is_async=0)])]),
            ops=[
              Eq()],
            comparators=[
              Call(
                func=Name(id='set', ctx=Load()),
                args=[
                  Name(id='EXPECTED_NODES', ctx=Load())])]),
          msg=Constant(value='Conceptual DAG names must match v10.7 design document'))],
      decorator_list=[
        Attribute(
          value=Attribute(
            value=Name(id='pytest', ctx=Load()),
            attr='mark',
            ctx=Load()),
          attr='design',
          ctx=Load())]),
    FunctionDef(
      name='test_conceptual_edges_match_design_doc',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='lookup', ctx=Store())],
          value=DictComp(
            key=Name(id='name', ctx=Load()),
            value=Name(id='idx', ctx=Load()),
            generators=[
              comprehension(
                target=Tuple(
                  elts=[
                    Name(id='idx', ctx=Store()),
                    Name(id='name', ctx=Store())],
                  ctx=Store()),
                iter=Call(
                  func=Name(id='enumerate', ctx=Load()),
                  args=[
                    Name(id='EXPECTED_ORDER', ctx=Load())]),
                is_async=0)])),
        For(
          target=Tuple(
            elts=[
              Name(id='src', ctx=Store()),
              Name(id='dst', ctx=Store())],
            ctx=Store()),
          iter=Name(id='EXPECTED_EDGES', ctx=Load()),
          body=[
            Assert(
              test=Compare(
                left=Subscript(
                  value=Name(id='lookup', ctx=Load()),
                  slice=Name(id='src', ctx=Load()),
                  ctx=Load()),
                ops=[
                  Lt()],
                comparators=[
                  Subscript(
                    value=Name(id='lookup', ctx=Load()),
                    slice=Name(id='dst', ctx=Load()),
                    ctx=Load())]),
              msg=JoinedStr(
                values=[
                  FormattedValue(
                    value=Name(id='src', ctx=Load()),
                    conversion=-1),
                  Constant(value=' must precede '),
                  FormattedValue(
                    value=Name(id='dst', ctx=Load()),
                    conversion=-1)]))])],
      decorator_list=[
        Attribute(
          value=Attribute(
            value=Name(id='pytest', ctx=Load()),
            attr='mark',
            ctx=Load()),
          attr='design',
          ctx=Load())]),
    FunctionDef(
      name='test_conceptual_edge_spec_matches_expected',
      args=arguments(),
      body=[
        Assert(
          test=Compare(
            left=Name(id='CONCEPTUAL_EDGES', ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Name(id='EXPECTED_EDGES', ctx=Load())]))],
      decorator_list=[
        Attribute(
          value=Attribute(
            value=Name(id='pytest', ctx=Load()),
            attr='mark',
            ctx=Load()),
          attr='design',
          ctx=Load())]),
    FunctionDef(
      name='test_all_conceptual_nodes_have_concrete_mappings',
      args=arguments(),
      body=[
        For(
          target=Name(id='node', ctx=Store()),
          iter=Name(id='CONCEPTUAL_DAG', ctx=Load()),
          body=[
            Assert(
              test=Attribute(
                value=Name(id='node', ctx=Load()),
                attr='concrete_nodes',
                ctx=Load()),
              msg=JoinedStr(
                values=[
                  Constant(value='Conceptual node '),
                  FormattedValue(
                    value=Attribute(
                      value=Name(id='node', ctx=Load()),
                      attr='name',
                      ctx=Load()),
                    conversion=-1),
                  Constant(value=' has no concrete mapping')]))])],
      decorator_list=[
        Attribute(
          value=Attribute(
            value=Name(id='pytest', ctx=Load()),
            attr='mark',
            ctx=Load()),
          attr='design',
          ctx=Load())]),
    FunctionDef(
      name='test_conceptual_nodes_exist_in_runtime',
      args=arguments(
        args=[
          arg(arg='compiled_workflow')]),
      body=[
        Assign(
          targets=[
            Name(id='runtime_nodes', ctx=Store())],
          value=Call(
            func=Name(id='_runtime_node_names', ctx=Load()),
            args=[
              Name(id='compiled_workflow', ctx=Load())])),
        For(
          target=Name(id='node', ctx=Store()),
          iter=Name(id='CONCEPTUAL_DAG', ctx=Load()),
          body=[
            Assign(
              targets=[
                Name(id='missing', ctx=Store())],
              value=BinOp(
                left=Call(
                  func=Name(id='set', ctx=Load()),
                  args=[
                    Attribute(
                      value=Name(id='node', ctx=Load()),
                      attr='concrete_nodes',
                      ctx=Load())]),
                op=Sub(),
                right=Name(id='runtime_nodes', ctx=Load()))),
            Assert(
              test=UnaryOp(
                op=Not(),
                operand=Name(id='missing', ctx=Load())),
              msg=JoinedStr(
                values=[
                  FormattedValue(
                    value=Attribute(
                      value=Name(id='node', ctx=Load()),
                      attr='name',
                      ctx=Load()),
                    conversion=-1),
                  Constant(value=' missing runtime nodes: '),
                  FormattedValue(
                    value=Call(
                      func=Name(id='sorted', ctx=Load()),
                      args=[
                        Name(id='missing', ctx=Load())]),
                    conversion=-1)]))])],
      decorator_list=[
        Attribute(
          value=Attribute(
            value=Name(id='pytest', ctx=Load()),
            attr='mark',
            ctx=Load()),
          attr='design',
          ctx=Load())]),
    FunctionDef(
      name='test_runtime_nodes_align_with_conceptual_spec',
      args=arguments(
        args=[
          arg(arg='compiled_workflow')]),
      body=[
        Assign(
          targets=[
            Name(id='runtime_nodes', ctx=Store())],
          value=Call(
            func=Name(id='_runtime_node_names', ctx=Load()),
            args=[
              Name(id='compiled_workflow', ctx=Load())])),
        Assign(
          targets=[
            Name(id='spec_nodes', ctx=Store())],
          value=Call(
            func=Name(id='all_concrete_nodes', ctx=Load()))),
        Assign(
          targets=[
            Name(id='missing', ctx=Store())],
          value=BinOp(
            left=Name(id='spec_nodes', ctx=Load()),
            op=Sub(),
            right=Name(id='runtime_nodes', ctx=Load()))),
        Assign(
          targets=[
            Name(id='extra', ctx=Store())],
          value=BinOp(
            left=Name(id='runtime_nodes', ctx=Load()),
            op=Sub(),
            right=Name(id='spec_nodes', ctx=Load()))),
        Assert(
          test=UnaryOp(
            op=Not(),
            operand=Name(id='missing', ctx=Load())),
          msg=JoinedStr(
            values=[
              Constant(value='Spec nodes not found in runtime graph: '),
              FormattedValue(
                value=Call(
                  func=Name(id='sorted', ctx=Load()),
                  args=[
                    Name(id='missing', ctx=Load())]),
                conversion=-1)])),
        Assert(
          test=UnaryOp(
            op=Not(),
            operand=Name(id='extra', ctx=Load())),
          msg=JoinedStr(
            values=[
              Constant(value='Runtime nodes missing from conceptual spec: '),
              FormattedValue(
                value=Call(
                  func=Name(id='sorted', ctx=Load()),
                  args=[
                    Name(id='extra', ctx=Load())]),
                conversion=-1)]))],
      decorator_list=[
        Attribute(
          value=Attribute(
            value=Name(id='pytest', ctx=Load()),
            attr='mark',
            ctx=Load()),
          attr='design',
          ctx=Load())]),
    FunctionDef(
      name='test_conceptual_lookup_contains_all_nodes',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='lookup', ctx=Store())],
          value=Call(
            func=Name(id='conceptual_node_map', ctx=Load()))),
        For(
          target=Name(id='name', ctx=Store()),
          iter=Name(id='EXPECTED_NODES', ctx=Load()),
          body=[
            Assert(
              test=Compare(
                left=Name(id='name', ctx=Load()),
                ops=[
                  In()],
                comparators=[
                  Name(id='lookup', ctx=Load())]),
              msg=JoinedStr(
                values=[
                  Constant(value='Missing conceptual node mapping for '),
                  FormattedValue(
                    value=Name(id='name', ctx=Load()),
                    conversion=-1)]))])],
      decorator_list=[
        Attribute(
          value=Attribute(
            value=Name(id='pytest', ctx=Load()),
            attr='mark',
            ctx=Load()),
          attr='design',
          ctx=Load())])])