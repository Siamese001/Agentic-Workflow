Module(
  body=[
    Import(
      names=[
        alias(name='pytest')]),
    ImportFrom(
      module='workflow.runner',
      names=[
        alias(name='run_workflow')],
      level=0),
    FunctionDef(
      name='_extract_rag_block',
      args=arguments(
        args=[
          arg(arg='out')]),
      body=[
        Return(
          value=BoolOp(
            op=Or(),
            values=[
              Call(
                func=Attribute(
                  value=Name(id='out', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='rag')]),
              Call(
                func=Attribute(
                  value=Call(
                    func=Attribute(
                      value=Name(id='out', ctx=Load()),
                      attr='get',
                      ctx=Load()),
                    args=[
                      Constant(value='resume'),
                      Dict()]),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='rag')]),
              Dict()]))]),
    FunctionDef(
      name='test_rag_not_query_echo',
      args=arguments(
        args=[
          arg(arg='query')]),
      body=[
        Assign(
          targets=[
            Name(id='out', ctx=Store())],
          value=Call(
            func=Name(id='run_workflow', ctx=Load()),
            args=[
              Dict(
                keys=[
                  Constant(value='compat_mode'),
                  Constant(value='resume'),
                  Constant(value='jd')],
                values=[
                  Constant(value='v10_7'),
                  Constant(value='RAG Test User'),
                  Name(id='query', ctx=Load())])])),
        Assign(
          targets=[
            Name(id='rag', ctx=Store())],
          value=Call(
            func=Name(id='_extract_rag_block', ctx=Load()),
            args=[
              Name(id='out', ctx=Load())])),
        Assert(
          test=Name(id='rag', ctx=Load()),
          msg=Constant(value='Missing RAG block')),
        Assign(
          targets=[
            Name(id='doc', ctx=Store())],
          value=BoolOp(
            op=Or(),
            values=[
              Call(
                func=Attribute(
                  value=Name(id='rag', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='document')]),
              Call(
                func=Attribute(
                  value=Name(id='rag', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='top_document')])])),
        Assert(
          test=Name(id='doc', ctx=Load()),
          msg=Constant(value='RAG output must contain a document')),
        Assert(
          test=Compare(
            left=Name(id='query', ctx=Load()),
            ops=[
              NotIn()],
            comparators=[
              Name(id='doc', ctx=Load())]),
          msg=Constant(value='RAG document must not simply echo the JD query'))],
      decorator_list=[
        Attribute(
          value=Attribute(
            value=Name(id='pytest', ctx=Load()),
            attr='mark',
            ctx=Load()),
          attr='rag',
          ctx=Load()),
        Call(
          func=Attribute(
            value=Attribute(
              value=Name(id='pytest', ctx=Load()),
              attr='mark',
              ctx=Load()),
            attr='parametrize',
            ctx=Load()),
          args=[
            Constant(value='query'),
            List(
              elts=[
                Constant(value='cloud infrastructure'),
                Constant(value='generative AI leadership'),
                Constant(value='risk modeling optimization')],
              ctx=Load())])]),
    FunctionDef(
      name='test_metadata_filtering_occurs',
      args=arguments(),
      body=[
        Expr(
          value=Constant(value='\n    The FakeCollection stub resolves documents only when metadata matches.\n    So the workflow must pass meaningful metadata queries.\n    ')),
        Assign(
          targets=[
            Name(id='out', ctx=Store())],
          value=Call(
            func=Name(id='run_workflow', ctx=Load()),
            args=[
              Dict(
                keys=[
                  Constant(value='compat_mode'),
                  Constant(value='resume'),
                  Constant(value='jd')],
                values=[
                  Constant(value='v10_7'),
                  Constant(value='meta-sensitive'),
                  Constant(value='AI Exec')])])),
        Assign(
          targets=[
            Name(id='rag', ctx=Store())],
          value=Call(
            func=Name(id='_extract_rag_block', ctx=Load()),
            args=[
              Name(id='out', ctx=Load())])),
        Assert(
          test=Name(id='rag', ctx=Load()),
          msg=Constant(value='RAG block missing')),
        Assert(
          test=Call(
            func=Attribute(
              value=Name(id='rag', ctx=Load()),
              attr='get',
              ctx=Load()),
            args=[
              Constant(value='document')]),
          msg=Constant(value='RAG did not retrieve document — metadata filtering may have failed'))],
      decorator_list=[
        Attribute(
          value=Attribute(
            value=Name(id='pytest', ctx=Load()),
            attr='mark',
            ctx=Load()),
          attr='rag',
          ctx=Load())]),
    FunctionDef(
      name='test_rag_block_structure',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='out', ctx=Store())],
          value=Call(
            func=Name(id='run_workflow', ctx=Load()),
            args=[
              Dict(
                keys=[
                  Constant(value='compat_mode'),
                  Constant(value='resume'),
                  Constant(value='jd')],
                values=[
                  Constant(value='v10_7'),
                  Constant(value='structure-test'),
                  Constant(value='Anthropic')])])),
        Assign(
          targets=[
            Name(id='rag', ctx=Store())],
          value=Call(
            func=Name(id='_extract_rag_block', ctx=Load()),
            args=[
              Name(id='out', ctx=Load())])),
        Assign(
          targets=[
            Name(id='required', ctx=Store())],
          value=List(
            elts=[
              Constant(value='document'),
              Constant(value='score'),
              Constant(value='source_uri')],
            ctx=Load())),
        For(
          target=Name(id='field', ctx=Store()),
          iter=Name(id='required', ctx=Load()),
          body=[
            Assert(
              test=Compare(
                left=Name(id='field', ctx=Load()),
                ops=[
                  In()],
                comparators=[
                  Name(id='rag', ctx=Load())]),
              msg=JoinedStr(
                values=[
                  Constant(value="RAG missing required field '"),
                  FormattedValue(
                    value=Name(id='field', ctx=Load()),
                    conversion=-1),
                  Constant(value="'")]))])],
      decorator_list=[
        Attribute(
          value=Attribute(
            value=Name(id='pytest', ctx=Load()),
            attr='mark',
            ctx=Load()),
          attr='rag',
          ctx=Load())]),
    FunctionDef(
      name='test_rerank_score_is_numeric',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='out', ctx=Store())],
          value=Call(
            func=Name(id='run_workflow', ctx=Load()),
            args=[
              Dict(
                keys=[
                  Constant(value='compat_mode'),
                  Constant(value='resume'),
                  Constant(value='jd')],
                values=[
                  Constant(value='v10_7'),
                  Constant(value='rerank-test'),
                  Constant(value='AWS')])])),
        Assign(
          targets=[
            Name(id='rag', ctx=Store())],
          value=Call(
            func=Name(id='_extract_rag_block', ctx=Load()),
            args=[
              Name(id='out', ctx=Load())])),
        Assign(
          targets=[
            Name(id='score', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='rag', ctx=Load()),
              attr='get',
              ctx=Load()),
            args=[
              Constant(value='score')])),
        Assert(
          test=Call(
            func=Name(id='isinstance', ctx=Load()),
            args=[
              Name(id='score', ctx=Load()),
              Tuple(
                elts=[
                  Name(id='int', ctx=Load()),
                  Name(id='float', ctx=Load())],
                ctx=Load())]),
          msg=JoinedStr(
            values=[
              Constant(value='RAG score must be numeric; got '),
              FormattedValue(
                value=Call(
                  func=Name(id='type', ctx=Load()),
                  args=[
                    Name(id='score', ctx=Load())]),
                conversion=-1)]))],
      decorator_list=[
        Attribute(
          value=Attribute(
            value=Name(id='pytest', ctx=Load()),
            attr='mark',
            ctx=Load()),
          attr='rag',
          ctx=Load())]),
    FunctionDef(
      name='test_hyde_activation_semantics',
      args=arguments(
        args=[
          arg(arg='should_trigger'),
          arg(arg='query')]),
      body=[
        Expr(
          value=Constant(value="\n    v10.7 HyDE logic should fire conditionally.\n    We infer activation from events containing 'hyde' or\n    RAG metadata indicating hypothetical doc generation.\n    ")),
        Assign(
          targets=[
            Name(id='out', ctx=Store())],
          value=Call(
            func=Name(id='run_workflow', ctx=Load()),
            args=[
              Dict(
                keys=[
                  Constant(value='compat_mode'),
                  Constant(value='resume'),
                  Constant(value='jd')],
                values=[
                  Constant(value='v10_7'),
                  Constant(value='HyDEUser'),
                  Name(id='query', ctx=Load())])])),
        Assign(
          targets=[
            Name(id='events', ctx=Store())],
          value=ListComp(
            elt=Call(
              func=Attribute(
                value=Call(
                  func=Name(id='str', ctx=Load()),
                  args=[
                    Name(id='e', ctx=Load())]),
                attr='lower',
                ctx=Load())),
            generators=[
              comprehension(
                target=Name(id='e', ctx=Store()),
                iter=Call(
                  func=Attribute(
                    value=Name(id='out', ctx=Load()),
                    attr='get',
                    ctx=Load()),
                  args=[
                    Constant(value='events'),
                    List(ctx=Load())]),
                is_async=0)])),
        Assign(
          targets=[
            Name(id='hyde_fired', ctx=Store())],
          value=Call(
            func=Name(id='any', ctx=Load()),
            args=[
              GeneratorExp(
                elt=Compare(
                  left=Constant(value='hyde'),
                  ops=[
                    In()],
                  comparators=[
                    Name(id='e', ctx=Load())]),
                generators=[
                  comprehension(
                    target=Name(id='e', ctx=Store()),
                    iter=Name(id='events', ctx=Load()),
                    is_async=0)])])),
        If(
          test=Name(id='should_trigger', ctx=Load()),
          body=[
            Assert(
              test=Name(id='hyde_fired', ctx=Load()),
              msg=Constant(value='HyDE should have activated but did not'))],
          orelse=[
            Assert(
              test=UnaryOp(
                op=Not(),
                operand=Name(id='hyde_fired', ctx=Load())),
              msg=Constant(value='HyDE activated unexpectedly'))])],
      decorator_list=[
        Attribute(
          value=Attribute(
            value=Name(id='pytest', ctx=Load()),
            attr='mark',
            ctx=Load()),
          attr='rag',
          ctx=Load()),
        Call(
          func=Attribute(
            value=Attribute(
              value=Name(id='pytest', ctx=Load()),
              attr='mark',
              ctx=Load()),
            attr='parametrize',
            ctx=Load()),
          args=[
            Constant(value='should_trigger, query'),
            List(
              elts=[
                Tuple(
                  elts=[
                    Constant(value=True),
                    Constant(value='simulate-hyde')],
                  ctx=Load()),
                Tuple(
                  elts=[
                    Constant(value=False),
                    Constant(value='regular query for resume')],
                  ctx=Load())],
              ctx=Load())])]),
    FunctionDef(
      name='test_refinement_loop_reenters_rag',
      args=arguments(
        args=[
          arg(arg='trigger')]),
      body=[
        Expr(
          value=Constant(value="\n    If confidence / coverage is low, v10.7 re-enters retrieval with refinement.\n    We detect refinement via multiple 'rag' events in the event list.\n    ")),
        Assign(
          targets=[
            Name(id='out', ctx=Store())],
          value=Call(
            func=Name(id='run_workflow', ctx=Load()),
            args=[
              Dict(
                keys=[
                  Constant(value='compat_mode'),
                  Constant(value='resume'),
                  Constant(value='jd')],
                values=[
                  Constant(value='v10_7'),
                  Constant(value='User'),
                  Name(id='trigger', ctx=Load())])])),
        Assign(
          targets=[
            Name(id='events', ctx=Store())],
          value=ListComp(
            elt=Call(
              func=Attribute(
                value=Call(
                  func=Name(id='str', ctx=Load()),
                  args=[
                    Name(id='e', ctx=Load())]),
                attr='lower',
                ctx=Load())),
            generators=[
              comprehension(
                target=Name(id='e', ctx=Store()),
                iter=Call(
                  func=Attribute(
                    value=Name(id='out', ctx=Load()),
                    attr='get',
                    ctx=Load()),
                  args=[
                    Constant(value='events'),
                    List(ctx=Load())]),
                is_async=0)])),
        Assign(
          targets=[
            Name(id='rag_count', ctx=Store())],
          value=Call(
            func=Name(id='sum', ctx=Load()),
            args=[
              GeneratorExp(
                elt=Compare(
                  left=Constant(value='rag'),
                  ops=[
                    In()],
                  comparators=[
                    Name(id='e', ctx=Load())]),
                generators=[
                  comprehension(
                    target=Name(id='e', ctx=Store()),
                    iter=Name(id='events', ctx=Load()),
                    is_async=0)])])),
        Assert(
          test=Compare(
            left=Name(id='rag_count', ctx=Load()),
            ops=[
              GtE()],
            comparators=[
              Constant(value=1)]),
          msg=Constant(value='RAG must run at least once')),
        If(
          test=Compare(
            left=Name(id='trigger', ctx=Load()),
            ops=[
              In()],
            comparators=[
              Set(
                elts=[
                  Constant(value='low_conf'),
                  Constant(value='refinement-needed')])]),
          body=[
            Assert(
              test=Compare(
                left=Name(id='rag_count', ctx=Load()),
                ops=[
                  GtE()],
                comparators=[
                  Constant(value=2)]),
              msg=Constant(value='Refinement path expected but RAG did not re-enter'))])],
      decorator_list=[
        Attribute(
          value=Attribute(
            value=Name(id='pytest', ctx=Load()),
            attr='mark',
            ctx=Load()),
          attr='rag',
          ctx=Load()),
        Call(
          func=Attribute(
            value=Attribute(
              value=Name(id='pytest', ctx=Load()),
              attr='mark',
              ctx=Load()),
            attr='parametrize',
            ctx=Load()),
          args=[
            Constant(value='trigger'),
            List(
              elts=[
                Constant(value='low_conf'),
                Constant(value='refinement-needed')],
              ctx=Load())])]),
    FunctionDef(
      name='test_rag_no_embedding_leakage',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='out', ctx=Store())],
          value=Call(
            func=Name(id='run_workflow', ctx=Load()),
            args=[
              Dict(
                keys=[
                  Constant(value='compat_mode'),
                  Constant(value='resume'),
                  Constant(value='jd')],
                values=[
                  Constant(value='v10_7'),
                  Constant(value='LeakTest'),
                  Constant(value='AI Exec')])])),
        Assign(
          targets=[
            Name(id='rag', ctx=Store())],
          value=Call(
            func=Name(id='_extract_rag_block', ctx=Load()),
            args=[
              Name(id='out', ctx=Load())])),
        Assign(
          targets=[
            Name(id='serialized', ctx=Store())],
          value=Call(
            func=Name(id='str', ctx=Load()),
            args=[
              Name(id='rag', ctx=Load())])),
        Assign(
          targets=[
            Name(id='forbidden', ctx=Store())],
          value=List(
            elts=[
              Constant(value='[0.'),
              Constant(value='[1.'),
              Constant(value='[2.'),
              Constant(value='embedding'),
              Constant(value='embedding_fn')],
            ctx=Load())),
        Assert(
          test=UnaryOp(
            op=Not(),
            operand=Call(
              func=Name(id='any', ctx=Load()),
              args=[
                GeneratorExp(
                  elt=Compare(
                    left=Name(id='f', ctx=Load()),
                    ops=[
                      In()],
                    comparators=[
                      Name(id='serialized', ctx=Load())]),
                  generators=[
                    comprehension(
                      target=Name(id='f', ctx=Store()),
                      iter=Name(id='forbidden', ctx=Load()),
                      is_async=0)])])),
          msg=JoinedStr(
            values=[
              Constant(value='RAG leaked embedding/debug info: '),
              FormattedValue(
                value=Name(id='serialized', ctx=Load()),
                conversion=-1)]))],
      decorator_list=[
        Attribute(
          value=Attribute(
            value=Name(id='pytest', ctx=Load()),
            attr='mark',
            ctx=Load()),
          attr='rag',
          ctx=Load())]),
    FunctionDef(
      name='test_rag_output_types_stable',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='out', ctx=Store())],
          value=Call(
            func=Name(id='run_workflow', ctx=Load()),
            args=[
              Dict(
                keys=[
                  Constant(value='compat_mode'),
                  Constant(value='resume'),
                  Constant(value='jd')],
                values=[
                  Constant(value='v10_7'),
                  Constant(value='TypeTest'),
                  Constant(value='Cloud')])])),
        Assign(
          targets=[
            Name(id='rag', ctx=Store())],
          value=Call(
            func=Name(id='_extract_rag_block', ctx=Load()),
            args=[
              Name(id='out', ctx=Load())])),
        Assert(
          test=Call(
            func=Name(id='isinstance', ctx=Load()),
            args=[
              Call(
                func=Attribute(
                  value=Name(id='rag', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='document')]),
              Name(id='str', ctx=Load())]),
          msg=Constant(value='RAG document must be string')),
        Assert(
          test=Call(
            func=Name(id='isinstance', ctx=Load()),
            args=[
              Call(
                func=Attribute(
                  value=Name(id='rag', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='score')]),
              Tuple(
                elts=[
                  Name(id='int', ctx=Load()),
                  Name(id='float', ctx=Load())],
                ctx=Load())]),
          msg=Constant(value='RAG score must be numeric')),
        Assert(
          test=Call(
            func=Name(id='isinstance', ctx=Load()),
            args=[
              Call(
                func=Attribute(
                  value=Name(id='rag', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='source_uri')]),
              Name(id='str', ctx=Load())]),
          msg=Constant(value='RAG source_uri must be string'))],
      decorator_list=[
        Attribute(
          value=Attribute(
            value=Name(id='pytest', ctx=Load()),
            attr='mark',
            ctx=Load()),
          attr='rag',
          ctx=Load())]),
    FunctionDef(
      name='test_rag_preserves_strategy_context',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='out', ctx=Store())],
          value=Call(
            func=Name(id='run_workflow', ctx=Load()),
            args=[
              Dict(
                keys=[
                  Constant(value='compat_mode'),
                  Constant(value='resume'),
                  Constant(value='jd')],
                values=[
                  Constant(value='v10_7'),
                  Constant(value='ContextKeepUser'),
                  Constant(value='Exec')])])),
        Assign(
          targets=[
            Name(id='resume', ctx=Store())],
          value=Subscript(
            value=Name(id='out', ctx=Load()),
            slice=Constant(value='resume'),
            ctx=Load())),
        Assign(
          targets=[
            Name(id='strat_ctx', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Subscript(
                value=Name(id='resume', ctx=Load()),
                slice=Constant(value='strategy'),
                ctx=Load()),
              attr='get',
              ctx=Load()),
            args=[
              Constant(value='context')])),
        Assert(
          test=Name(id='strat_ctx', ctx=Load()),
          msg=Constant(value='Strategy context was lost or cleared during RAG execution'))],
      decorator_list=[
        Attribute(
          value=Attribute(
            value=Name(id='pytest', ctx=Load()),
            attr='mark',
            ctx=Load()),
          attr='rag',
          ctx=Load())])])