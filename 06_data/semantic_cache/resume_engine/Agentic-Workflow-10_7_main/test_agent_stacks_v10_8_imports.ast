Module(
  body=[
    Expr(
      value=Constant(value='Smoke-tests for the v10.8 stack scaffolding.')),
    ImportFrom(
      module='__future__',
      names=[
        alias(name='annotations')],
      level=0),
    Import(
      names=[
        alias(name='pytest')]),
    ImportFrom(
      module='agent_stacks_v10_8',
      names=[
        alias(name='BulletExecutionStack'),
        alias(name='DraftingExecutionStack'),
        alias(name='HILStackV10_8'),
        alias(name='QAValidationStack'),
        alias(name='RAGExecutionStack'),
        alias(name='SafetyStackV10_8'),
        alias(name='StateAdapterStack'),
        alias(name='StrategyStackV10_8'),
        alias(name='RobustnessStack')],
      level=0),
    FunctionDef(
      name='test_stack_instantiation',
      args=arguments(
        args=[
          arg(arg='stack_cls'),
          arg(arg='mock_workflow_context')]),
      body=[
        Assign(
          targets=[
            Name(id='stack', ctx=Store())],
          value=Call(
            func=Name(id='stack_cls', ctx=Load()),
            args=[
              Name(id='mock_workflow_context', ctx=Load())])),
        Assert(
          test=Compare(
            left=Name(id='stack', ctx=Load()),
            ops=[
              IsNot()],
            comparators=[
              Constant(value=None)]))],
      decorator_list=[
        Call(
          func=Attribute(
            value=Attribute(
              value=Name(id='pytest', ctx=Load()),
              attr='mark',
              ctx=Load()),
            attr='parametrize',
            ctx=Load()),
          args=[
            Constant(value='stack_cls'),
            List(
              elts=[
                Name(id='RAGExecutionStack', ctx=Load()),
                Name(id='QAValidationStack', ctx=Load()),
                Name(id='DraftingExecutionStack', ctx=Load()),
                Name(id='BulletExecutionStack', ctx=Load()),
                Name(id='StrategyStackV10_8', ctx=Load()),
                Name(id='SafetyStackV10_8', ctx=Load()),
                Name(id='HILStackV10_8', ctx=Load()),
                Name(id='RobustnessStack', ctx=Load())],
              ctx=Load())])]),
    FunctionDef(
      name='test_state_adapter_stack_instantiation',
      args=arguments(
        args=[
          arg(arg='mock_workflow_context')]),
      body=[
        Assign(
          targets=[
            Name(id='adapter', ctx=Store())],
          value=Call(
            func=Name(id='StateAdapterStack', ctx=Load()),
            args=[
              Name(id='mock_workflow_context', ctx=Load())])),
        Assert(
          test=Compare(
            left=Attribute(
              value=Name(id='adapter', ctx=Load()),
              attr='context',
              ctx=Load()),
            ops=[
              Is()],
            comparators=[
              Name(id='mock_workflow_context', ctx=Load())]))])])