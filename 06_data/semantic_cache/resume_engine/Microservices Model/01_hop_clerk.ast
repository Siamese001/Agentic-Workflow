            ctx=Load()),
          attr='append',
          ctx=Load()),
        args=[
          Call(
            func=Name(id='str', ctx=Load()),
            args=[
              Name(id='project_root', ctx=Load())])])),
    ImportFrom(
      module='helpers',
      names=[
        alias(name='setup_workflow_logging'),
        alias(name='HopExecutionError'),
        alias(name='default_serializer'),
        alias(name='ValidationResult'),
        alias(name='ValidationSeverity'),
        alias(name='BulletProvenance')],
      level=0),
    ClassDef(
      name='EmbeddingClient',
      body=[
        Expr(
          value=Constant(value='Mock EmbeddingClient. In production, this uses a real model.')),
        FunctionDef(
          name='__init__',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(arg='config')],
            defaults=[
              Constant(value=None)]),
          body=[
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='logging', ctx=Load()),
                  attr='info',
                  ctx=Load()),
                args=[
                  Constant(value='Initialized MOCK EmbeddingClient for HOP-1')])),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='dimension',
                  ctx=Store())],
              value=Constant(value=768))]),
        FunctionDef(
          name='embed',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='text',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Generates a mock, deterministic embedding.')),
            If(
              test=UnaryOp(
                op=Not(),
                operand=Name(id='text', ctx=Load())),
              body=[
                Return(
                  value=BinOp(
                    left=List(
                      elts=[
                        Constant(value=0.0)],
                      ctx=Load()),
                    op=Mult(),
                    right=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='dimension',
                      ctx=Load())))]),
            Assign(
              targets=[
                Name(id='hash_val', ctx=Store())],
              value=Call(
                func=Name(id='hash', ctx=Load()),
                args=[
                  Name(id='text', ctx=Load())])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='np', ctx=Load()),
                    attr='random',
                    ctx=Load()),
                  attr='seed',
                  ctx=Load()),
                args=[
                  BinOp(
                    left=Name(id='hash_val', ctx=Load()),
                    op=Mod(),
                    right=BinOp(
                      left=BinOp(
                        left=Constant(value=2),
                        op=Pow(),
                        right=Constant(value=32)),
                      op=Sub(),
                      right=Constant(value=1)))])),
            Return(
              value=Call(
                func=Attribute(
                  value=Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='np', ctx=Load()),
                        attr='random',
                        ctx=Load()),
                      attr='rand',
                      ctx=Load()),
                    args=[
                      Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='dimension',
                        ctx=Load())]),
                  attr='tolist',
                  ctx=Load())))],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='float', ctx=Load()),
            ctx=Load()))]),
    ClassDef(
      name='HallucinationDetector',
      body=[
        FunctionDef(
          name='detect',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='bullets',
                annotation=Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Name(id='Dict', ctx=Load()),
                  ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value="\n         MOCK Hallucination Detector.\n         In a real system, this would validate bullets against\n         the user's 'ground truth' or look for factual inconsistencies.\n         ")),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='logging', ctx=Load()),
                  attr='warning',
                  ctx=Load()),
                args=[
                  Constant(value='Using MOCK HallucinationDetector')])),
            Assign(
              targets=[
                Name(id='results', ctx=Store())],
              value=List(ctx=Load())),
            For(
              target=Tuple(
                elts=[
                  Name(id='i', ctx=Store()),
                  Name(id='bullet_data', ctx=Store())],
                ctx=Store()),
              iter=Call(
                func=Name(id='enumerate', ctx=Load()),
                args=[
                  Name(id='bullets', ctx=Load())]),
              body=[
                If(
                  test=Compare(
                    left=Constant(value='[INSERT METRIC]'),
                    ops=[
                      In()],
                    comparators=[
                      Call(
                        func=Attribute(
                          value=Name(id='bullet_data', ctx=Load()),
                          attr='get',
                          ctx=Load()),
                        args=[
                          Constant(value='bullet_text'),
                          Constant(value='')])]),
                  body=[
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Name(id='results', ctx=Load()),
                          attr='append',
                          ctx=Load()),
                        args=[
                          Call(
                            func=Name(id='ValidationResult', ctx=Load()),
                            keywords=[
                              keyword(
                                arg='rule_id',
                                value=Constant(value='PLACEHOLDER_METRIC')),
                              keyword(
                                arg='passed',
                                value=Constant(value=False)),
                              keyword(
                                arg='severity',
                                value=Attribute(
                                  value=Name(id='ValidationSeverity', ctx=Load()),
                                  attr='WARNING',
                                  ctx=Load())),
                              keyword(
                                arg='message',
                                value=JoinedStr(
                                  values=[
                                    Constant(value='Bullet '),
                                    FormattedValue(
                                      value=Name(id='i', ctx=Load()),
                                      conversion=-1),
                                    Constant(value=' contains placeholder text.')])),
                              keyword(
                                arg='details',
                                value=Dict(
                                  keys=[
                                    Constant(value='bullet_text')],
                                  values=[
                                    Call(
                                      func=Attribute(
                                        value=Name(id='bullet_data', ctx=Load()),
                                        attr='get',
                                        ctx=Load()),
                                      args=[
                                        Constant(value='bullet_text')])]))])]))])]),
            Return(
              value=Name(id='results', ctx=Load()))],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='ValidationResult', ctx=Load()),
            ctx=Load()))]),
    ClassDef(
      name='ClerkExtractor',
      body=[
        Expr(
          value=Constant(value='\n    HOP-1: Pre-processes the master resume.\n    - Extracts all sections (header, experience, education, etc.)\n    - Extracts and structures competency map.\n    - Enriches every experience bullet with:\n        1. An Action Verb\n        2. Extracted Metrics (%, $, etc.)\n        3. Inferred Skills (cross-referenced with competencies)\n        4. A Vector Embedding (for HOP-2 semantic scoring)\n    ')),
        FunctionDef(
          name='__init__',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='master_resume',
                annotation=Name(id='Dict', ctx=Load()))]),
          body=[
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='master_resume',
                  ctx=Store())],
              value=Name(id='master_resume', ctx=Load())),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='_validate_master_resume_structure',
                  ctx=Load()))),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='embedding_client',
                  ctx=Store())],
              value=Call(
                func=Name(id='EmbeddingClient', ctx=Load()))),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='hallucination_detector',
                  ctx=Store())],
              value=Call(
                func=Name(id='HallucinationDetector', ctx=Load()))),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='verb_pattern',
                  ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='re', ctx=Load()),
                  attr='compile',
                  ctx=Load()),
                args=[
                  Constant(value='^(\\w+ed|Built|Led|Managed|Developed|Created|Drove|Launched|Scaled|Achieved|Optimized|Architected)\\b'),
                  Attribute(
                    value=Name(id='re', ctx=Load()),
                    attr='IGNORECASE',
                    ctx=Load())])),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='metric_pattern',
                  ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='re', ctx=Load()),
                  attr='compile',
                  ctx=Load()),
                args=[
                  Constant(value='(\\d{1,3}%|\\$\\d+(\\.\\d+)?[kKmMbB]?|\\d+ million|\\d+x|(?<=[Oo]f )\\d+)')]))]),
        FunctionDef(
          name='_validate_master_resume_structure',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Ensures the master resume has the expected top-level keys.')),
            If(
              test=UnaryOp(
                op=Not(),
                operand=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='master_resume',
                  ctx=Load())),
              body=[
                Raise(
                  exc=Call(
                    func=Name(id='ValueError', ctx=Load()),
                    args=[
                      Constant(value='MASTER_RESUME_JSON is empty or not provided.')]))]),
            Assign(
              targets=[
                Name(id='required_keys', ctx=Store())],
              value=List(
                elts=[
                  Constant(value='owner'),
                  Constant(value='professional_experience'),
                  Constant(value='education'),
                  Constant(value='certifications_and_credentials'),
                  Constant(value='strategic_and_technical_competencies')],
                ctx=Load())),
            Assign(
              targets=[
                Name(id='missing_keys', ctx=Store())],
              value=ListComp(
                elt=Name(id='key', ctx=Load()),
                generators=[
                  comprehension(
                    target=Name(id='key', ctx=Store()),
                    iter=Name(id='required_keys', ctx=Load()),
                    ifs=[
                      Compare(
                        left=Name(id='key', ctx=Load()),
                        ops=[
                          NotIn()],
                        comparators=[
                          Attribute(
                            value=Name(id='self', ctx=Load()),
                            attr='master_resume',
                            ctx=Load())])],
                    is_async=0)])),
            If(
              test=Name(id='missing_keys', ctx=Load()),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='logging', ctx=Load()),
                      attr='warning',
                      ctx=Load()),
                    args=[
                      JoinedStr(
                        values=[
                          Constant(value='Master resume snapshot missing keys: '),
                          FormattedValue(
                            value=Call(
                              func=Attribute(
                                value=Constant(value=', '),
                                attr='join',
                                ctx=Load()),
                              args=[
                                Name(id='missing_keys', ctx=Load())]),
                            conversion=-1)])]))])]),
        FunctionDef(
          name='extract_and_preprocess',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Main execution method.')),
            Assign(
              targets=[
                Name(id='validation_results', ctx=Store())],
              value=List(ctx=Load())),
            Assign(
              targets=[
                Name(id='competency_map', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='_build_competency_map',
                  ctx=Load()))),
            Assign(
              targets=[
                Tuple(
                  elts=[
                    Name(id='experience_sections', ctx=Store()),
                    Name(id='all_bullets_for_detection', ctx=Store())],
                  ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='_build_experience_sections',
                  ctx=Load()),
                args=[
                  Name(id='competency_map', ctx=Load())])),
            Assign(
              targets=[
                Name(id='hallucination_results', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='hallucination_detector',
                    ctx=Load()),
                  attr='detect',
                  ctx=Load()),
                args=[
                  Name(id='all_bullets_for_detection', ctx=Load())])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='validation_results', ctx=Load()),
                  attr='extend',
                  ctx=Load()),
                args=[
                  Name(id='hallucination_results', ctx=Load())])),
            Assign(
              targets=[
                Name(id='extracted_data', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='header'),
                  Constant(value='education'),
                  Constant(value='certifications'),
                  Constant(value='competency_map'),
                  Constant(value='experience_sections')],
                values=[
                  Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='master_resume',
                        ctx=Load()),
                      attr='get',
                      ctx=Load()),
                    args=[
                      Constant(value='header'),
                      Dict()]),
                  Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='master_resume',
                        ctx=Load()),
                      attr='get',
                      ctx=Load()),
                    args=[
                      Constant(value='education'),
                      List(ctx=Load())]),
                  Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='master_resume',
                        ctx=Load()),
                      attr='get',
                      ctx=Load()),
                    args=[
                      Constant(value='certifications_and_credentials'),
                      List(ctx=Load())]),
                  Name(id='competency_map', ctx=Load()),
                  Name(id='experience_sections', ctx=Load())])),
            Return(
              value=Tuple(
                elts=[
                  Name(id='extracted_data', ctx=Load()),
                  Name(id='validation_results', ctx=Load())],
                ctx=Load()))],
          returns=Subscript(
            value=Name(id='Tuple', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='Dict', ctx=Load()),
                Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Name(id='ValidationResult', ctx=Load()),
                  ctx=Load())],
              ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='_build_competency_map',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Parses the competencies into a structured map.')),
            Assign(
              targets=[
                Name(id='competency_map', ctx=Store())],
              value=Dict()),
            For(
              target=Name(id='category', ctx=Store()),
              iter=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='master_resume',
                    ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='strategic_and_technical_competencies'),
                  List(ctx=Load())]),
              body=[
                Assign(
                  targets=[
                    Name(id='category_name', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='category', ctx=Load()),
                      attr='get',
                      ctx=Load()),
                    args=[
                      Constant(value='category_name'),
                      Constant(value='Uncategorized')])),
                Assign(
                  targets=[
                    Name(id='skills', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='category', ctx=Load()),
                      attr='get',
                      ctx=Load()),
                    args=[
                      Constant(value='skills'),
                      List(ctx=Load())])),
                If(
                  test=Call(
                    func=Name(id='isinstance', ctx=Load()),
                    args=[
                      Name(id='skills', ctx=Load()),
                      Name(id='list', ctx=Load())]),
                  body=[
                    Assign(
                      targets=[
                        Subscript(
                          value=Name(id='competency_map', ctx=Load()),
                          slice=Name(id='category_name', ctx=Load()),
                          ctx=Store())],
                      value=Name(id='skills', ctx=Load()))])]),
            Return(
              value=Name(id='competency_map', ctx=Load()))],
          returns=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Name(id='str', ctx=Load()),
                  ctx=Load())],
              ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='_build_experience_sections',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='competency_map',
                annotation=Subscript(
                  value=Name(id='Dict', ctx=Load()),
                  slice=Tuple(
                    elts=[
                      Name(id='str', ctx=Load()),
                      Subscript(
                        value=Name(id='List', ctx=Load()),
                        slice=Name(id='str', ctx=Load()),
                        ctx=Load())],
                    ctx=Load()),
                  ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Builds structured experience, enriching each bullet with\n        verbs, metrics, inferred skills, and an embedding.\n        ')),
            Assign(
              targets=[
                Name(id='experience_sections', ctx=Store())],
              value=List(ctx=Load())),
            Assign(
              targets=[
                Name(id='all_bullets_for_detection', ctx=Store())],
              value=List(ctx=Load())),
            Assign(
              targets=[
                Name(id='all_skills', ctx=Store())],
              value=Call(
                func=Name(id='set', ctx=Load()),
                args=[
                  GeneratorExp(
                    elt=Call(
                      func=Attribute(
                        value=Name(id='skill', ctx=Load()),
                        attr='lower',
                        ctx=Load())),
                    generators=[
                      comprehension(
                        target=Name(id='skills', ctx=Store()),
                        iter=Call(
                          func=Attribute(
                            value=Name(id='competency_map', ctx=Load()),
                            attr='values',
                            ctx=Load())),
                        is_async=0),
                      comprehension(
                        target=Name(id='skill', ctx=Store()),
                        iter=Name(id='skills', ctx=Load()),
                        is_async=0)])])),
            For(
              target=Name(id='exp', ctx=Store()),
              iter=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='master_resume',
                    ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='professional_experience'),
                  List(ctx=Load())]),
              body=[
                Assign(
                  targets=[
                    Name(id='enriched_bullets', ctx=Store())],
                  value=List(ctx=Load())),
                Assign(
                  targets=[
                    Name(id='bullet_source', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='exp', ctx=Load()),
                      attr='get',
                      ctx=Load()),
                    args=[
                      Constant(value='bullet_pool'),
                      List(ctx=Load())])),
                If(
                  test=Call(
                    func=Name(id='isinstance', ctx=Load()),
                    args=[
                      Name(id='bullet_source', ctx=Load()),
                      Name(id='list', ctx=Load())]),
                  body=[
                    For(
                      target=Tuple(
                        elts=[
                          Name(id='i', ctx=Store()),
                          Name(id='bullet_text', ctx=Store())],
                        ctx=Store()),
                      iter=Call(
                        func=Name(id='enumerate', ctx=Load()),
                        args=[
                          Name(id='bullet_source', ctx=Load())]),
                      body=[
                        If(
                          test=BoolOp(
                            op=Or(),
                            values=[
                              UnaryOp(
                                op=Not(),
                                operand=Call(
                                  func=Name(id='isinstance', ctx=Load()),
                                  args=[
                                    Name(id='bullet_text', ctx=Load()),
                                    Name(id='str', ctx=Load())])),
                              UnaryOp(
                                op=Not(),
                                operand=Call(
                                  func=Attribute(
                                    value=Name(id='bullet_text', ctx=Load()),
                                    attr='strip',
                                    ctx=Load())))]),
                          body=[
                            Continue()]),
                        Assign(
                          targets=[
                            Name(id='action_verb', ctx=Store())],
                          value=Call(
                            func=Attribute(
                              value=Name(id='self', ctx=Load()),
                              attr='_extract_action_verb',
                              ctx=Load()),
                            args=[
                              Name(id='bullet_text', ctx=Load())])),
                        Assign(
                          targets=[
                            Name(id='metrics', ctx=Store())],
                          value=Call(
                            func=Attribute(
                              value=Name(id='self', ctx=Load()),
                              attr='_extract_metrics',
                              ctx=Load()),
                            args=[
                              Name(id='bullet_text', ctx=Load())])),
                        Assign(
                          targets=[
                            Name(id='inferred_skills', ctx=Store())],
                          value=Call(
                            func=Attribute(
                              value=Name(id='self', ctx=Load()),
                              attr='_infer_skills_from_bullet',
                              ctx=Load()),
                            args=[
                              Name(id='bullet_text', ctx=Load()),
                              Name(id='all_skills', ctx=Load())])),
                        Assign(
                          targets=[
                            Name(id='embedding', ctx=Store())],
                          value=Call(
                            func=Attribute(
                              value=Attribute(
                                value=Name(id='self', ctx=Load()),
                                attr='embedding_client',
                                ctx=Load()),
                              attr='embed',
                              ctx=Load()),
                            args=[
                              Name(id='bullet_text', ctx=Load())])),
                        Assign(
                          targets=[
                            Name(id='bullet_data', ctx=Store())],
                          value=Dict(
                            keys=[
                              Constant(value='id'),
                              Constant(value='bullet_text'),
                              Constant(value='provenance'),
                              Constant(value='action_verb'),
                              Constant(value='metrics'),
                              Constant(value='inferred_skills'),
                              Constant(value='embedding')],
                            values=[
                              JoinedStr(
                                values=[
                                  FormattedValue(
                                    value=Subscript(
                                      value=Call(
                                        func=Attribute(
                                          value=Name(id='exp', ctx=Load()),
                                          attr='get',
                                          ctx=Load()),
                                        args=[
                                          Constant(value='company'),
                                          Constant(value='comp')]),
                                      slice=Slice(
                                        upper=Constant(value=5)),
                                      ctx=Load()),
                                    conversion=-1),
                                  Constant(value='_'),
                                  FormattedValue(
                                    value=Name(id='i', ctx=Load()),
                                    conversion=-1)]),
                              Name(id='bullet_text', ctx=Load()),
                              Attribute(
                                value=Attribute(
                                  value=Name(id='BulletProvenance', ctx=Load()),
                                  attr='Verbatim',
                                  ctx=Load()),
                                attr='value',
                                ctx=Load()),
                              Name(id='action_verb', ctx=Load()),
                              Name(id='metrics', ctx=Load()),
                              Name(id='inferred_skills', ctx=Load()),
                              Name(id='embedding', ctx=Load())])),
                        Expr(
                          value=Call(
                            func=Attribute(
                              value=Name(id='enriched_bullets', ctx=Load()),
                              attr='append',
                              ctx=Load()),
                            args=[
                              Name(id='bullet_data', ctx=Load())])),
                        Expr(
                          value=Call(
                            func=Attribute(
                              value=Name(id='all_bullets_for_detection', ctx=Load()),
                              attr='append',
