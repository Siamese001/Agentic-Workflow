Module(
  body=[
    Expr(
      value=Constant(value='\nHop 1: Master Resume Pre-processing (Clerk).\nReads the master resume JSON, extracts all sections, and pre-processes\nexperience bullets by extracting action verbs, metrics, and generating\nembeddings for future semantic analysis.\n')),
    ImportFrom(
