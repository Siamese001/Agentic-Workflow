    ClassDef(
      name='EnhancedJobDescriptionAnalyzer',
      body=[
        Expr(
          value=Constant(value='\n    v1.1/v1.3: Agentic Orchestrator with Circuit Breaker Integration.\n    Manages the RAGState and executes the Execute-Critique-Replan loop.\n    ')),
        FunctionDef(
          name='__init__',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(arg='master_resume'),
              arg(
                arg='config',
                annotation=Name(id='RAGConfig', ctx=Load())),
              arg(
                arg='embedding_client',
                annotation=Name(id='EmbeddingClient', ctx=Load())),
              arg(
                arg='semantic_cache',
                annotation=Name(id='SemanticCacheManager', ctx=Load())),
              arg(arg='enable_web_search')],
            defaults=[
              Constant(value=True)]),
          body=[
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='master_resume',
                  ctx=Store())],
              value=Name(id='master_resume', ctx=Load())),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='config',
                  ctx=Store())],
              value=BoolOp(
                op=Or(),
                values=[
                  Name(id='config', ctx=Load()),
                  Call(
                    func=Name(id='RAGConfig', ctx=Load()))])),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='model_clients',
                  ctx=Store())],
              value=DictComp(
                key=Name(id='model', ctx=Load()),
                value=Call(
                  func=Name(id='GeminiWebSearchClient', ctx=Load()),
                  args=[
                    Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='config',
                      ctx=Load()),
                    Name(id='model', ctx=Load())]),
                generators=[
                  comprehension(
                    target=Name(id='model', ctx=Store()),
                    iter=Attribute(
                      value=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='config',
                        ctx=Load()),
                      attr='models',
                      ctx=Load()),
                    is_async=0)])),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='web_rag',
                  ctx=Store())],
              value=Call(
                func=Name(id='WebSearchRAG', ctx=Load()),
                args=[
                  Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='model_clients',
                    ctx=Load()),
                  Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='config',
                    ctx=Load())])),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='primary_client',
                  ctx=Store())],
              value=Subscript(
                value=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='model_clients',
                  ctx=Load()),
                slice=Subscript(
                  value=Attribute(
                    value=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='config',
                      ctx=Load()),
                    attr='models',
                    ctx=Load()),
                  slice=Constant(value=0),
                  ctx=Load()),
                ctx=Load())),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='embedding_client',
                  ctx=Store())],
              value=Name(id='embedding_client', ctx=Load())),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='semantic_cache',
                  ctx=Store())],
              value=Name(id='semantic_cache', ctx=Load())),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='telemetry_logger',
                  ctx=Store())],
              value=Constant(value=None)),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='total_api_calls_hop0',
                  ctx=Store())],
              value=Constant(value=0)),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='logger',
                  ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='logging', ctx=Load()),
                  attr='getLogger',
                  ctx=Load()),
                args=[
                  Name(id='__name__', ctx=Load())]))]),
        FunctionDef(
          name='analyze',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='job_description',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='v1.1/v1.3: Main orchestration entry point with circuit breaker protection.')),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='total_api_calls_hop0',
                  ctx=Store())],
              value=Constant(value=0)),
            Try(
              body=[
                Assign(
                  targets=[
                    Name(id='jd_embedding', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='embedding_client',
                        ctx=Load()),
                      attr='embed',
                      ctx=Load()),
                    args=[
                      Name(id='job_description', ctx=Load())])),
                Assign(
                  targets=[
                    Name(id='cached_result', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='semantic_cache',
                        ctx=Load()),
                      attr='get',
                      ctx=Load()),
                    args=[
                      Name(id='jd_embedding', ctx=Load())])),
                If(
                  test=Name(id='cached_result', ctx=Load()),
                  body=[
                    Assign(
                      targets=[
                        Tuple(
                          elts=[
                            Name(id='cached_analysis', ctx=Store()),
                            Name(id='similarity', ctx=Store())],
                          ctx=Store())],
                      value=Name(id='cached_result', ctx=Load())),
                    If(
                      test=Call(
                        func=Attribute(
                          value=Attribute(
                            value=Name(id='self', ctx=Load()),
                            attr='semantic_cache',
                            ctx=Load()),
                          attr='_verify_cache',
                          ctx=Load()),
                        args=[
                          Name(id='cached_analysis', ctx=Load())]),
                      body=[
                        Expr(
                          value=Call(
                            func=Attribute(
                              value=Attribute(
                                value=Name(id='self', ctx=Load()),
                                attr='logger',
                                ctx=Load()),
                              attr='info',
                              ctx=Load()),
                            args=[
                              JoinedStr(
                                values=[
                                  Constant(value='SEMANTIC CACHE HIT (Similarity: '),
                                  FormattedValue(
                                    value=Name(id='similarity', ctx=Load()),
                                    conversion=-1,
                                    format_spec=JoinedStr(
                                      values=[
                                        Constant(value='.4f')])),
                                  Constant(value='). Skipping HOP-0 execution.')])])),
                        Return(
                          value=Tuple(
                            elts=[
                              Name(id='cached_analysis', ctx=Load()),
                              Constant(value=0)],
                            ctx=Load()))])])],
              handlers=[
                ExceptHandler(
                  type=Name(id='Exception', ctx=Load()),
                  name='e',
                  body=[
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Attribute(
                            value=Name(id='self', ctx=Load()),
                            attr='logger',
                            ctx=Load()),
                          attr='error',
                          ctx=Load()),
                        args=[
                          JoinedStr(
                            values=[
                              Constant(value='Semantic cache check failed: '),
                              FormattedValue(
                                value=Name(id='e', ctx=Load()),
                                conversion=-1)])]))])]),
            Expr(
              value=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='logger',
                    ctx=Load()),
                  attr='info',
                  ctx=Load()),
                args=[
                  Constant(value='Semantic cache miss or invalid. Executing full HOP-0 workflow.')])),
            Assign(
              targets=[
                Name(id='mission', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='_execute_pre_rag_analysis',
                  ctx=Load()),
                args=[
                  Name(id='job_description', ctx=Load())])),
            Assign(
              targets=[
                Name(id='analysis', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='_analyze_with_agentic_orchestration',
                  ctx=Load()),
                args=[
                  Name(id='job_description', ctx=Load()),
                  Name(id='mission', ctx=Load())])),
            Assign(
              targets=[
                Name(id='analysis', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='_synthesize_final_analysis',
                  ctx=Load()),
                args=[
                  Name(id='analysis', ctx=Load())])),
            Try(
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='semantic_cache',
                        ctx=Load()),
                      attr='set',
                      ctx=Load()),
                    args=[
                      Name(id='jd_embedding', ctx=Load()),
                      Name(id='analysis', ctx=Load())]))],
              handlers=[
                ExceptHandler(
                  type=Name(id='Exception', ctx=Load()),
                  name='e',
                  body=[
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Attribute(
                            value=Name(id='self', ctx=Load()),
                            attr='logger',
                            ctx=Load()),
                          attr='error',
                          ctx=Load()),
                        args=[
                          JoinedStr(
                            values=[
                              Constant(value='Failed to write to semantic cache: '),
                              FormattedValue(
                                value=Name(id='e', ctx=Load()),
                                conversion=-1)])]))])]),
