    ClassDef(
      name='CircuitBreaker',
      body=[
        Expr(
          value=Constant(value='\n    v1.3: Full circuit breaker implementation for resilient RAG operations.\n    Tracks failures and transitions between CLOSED, OPEN, and HALF_OPEN states.\n    ')),
        FunctionDef(
          name='__init__',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='config',
                annotation=Name(id='RAGConfig', ctx=Load()))]),
          body=[
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='config',
                  ctx=Store())],
              value=Name(id='config', ctx=Load())),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='state',
                  ctx=Store())],
              value=Attribute(
                value=Name(id='CircuitState', ctx=Load()),
                attr='CLOSED',
                ctx=Load())),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='failure_count',
                  ctx=Store())],
              value=Constant(value=0)),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='last_failure_time',
                  ctx=Store())],
              value=Constant(value=None)),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='success_count',
                  ctx=Store())],
              value=Constant(value=0)),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='logger',
                  ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='logging', ctx=Load()),
                  attr='getLogger',
                  ctx=Load()),
                args=[
                  Name(id='__name__', ctx=Load())]))]),
        FunctionDef(
          name='call',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(arg='func')],
            vararg=arg(arg='args'),
            kwarg=arg(arg='kwargs')),
          body=[
            Expr(
              value=Constant(value='Execute function with circuit breaker protection')),
            If(
              test=Compare(
                left=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='state',
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Attribute(
                    value=Name(id='CircuitState', ctx=Load()),
                    attr='OPEN',
                    ctx=Load())]),
              body=[
                If(
                  test=Call(
                    func=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='_should_attempt_reset',
                      ctx=Load())),
                  body=[
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Attribute(
                            value=Name(id='self', ctx=Load()),
                            attr='logger',
                            ctx=Load()),
                          attr='info',
                          ctx=Load()),
                        args=[
                          Constant(value='Circuit breaker transitioning to HALF_OPEN')])),
                    Assign(
                      targets=[
                        Attribute(
                          value=Name(id='self', ctx=Load()),
                          attr='state',
                          ctx=Store())],
                      value=Attribute(
                        value=Name(id='CircuitState', ctx=Load()),
                        attr='HALF_OPEN',
                        ctx=Load()))],
                  orelse=[
                    Raise(
                      exc=Call(
                        func=Name(id='HopExecutionError', ctx=Load()),
                        args=[
                          JoinedStr(
                            values=[
                              Constant(value='Circuit breaker is OPEN. Too many failures ('),
                              FormattedValue(
                                value=Attribute(
                                  value=Name(id='self', ctx=Load()),
                                  attr='failure_count',
                                  ctx=Load()),
                                conversion=-1),
                              Constant(value='). Wait '),
                              FormattedValue(
                                value=Attribute(
                                  value=Attribute(
                                    value=Name(id='self', ctx=Load()),
                                    attr='config',
                                    ctx=Load()),
                                  attr='circuit_breaker_timeout',
                                  ctx=Load()),
                                conversion=-1),
                              Constant(value='s before retry.')])]))])]),
            Try(
              body=[
                Assign(
                  targets=[
                    Name(id='result', ctx=Store())],
                  value=Call(
                    func=Name(id='func', ctx=Load()),
                    args=[
                      Starred(
                        value=Name(id='args', ctx=Load()),
                        ctx=Load())],
                    keywords=[
                      keyword(
                        value=Name(id='kwargs', ctx=Load()))])),
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='_on_success',
                      ctx=Load()))),
                Return(
                  value=Name(id='result', ctx=Load()))],
              handlers=[
                ExceptHandler(
                  type=Name(id='Exception', ctx=Load()),
                  name='e',
                  body=[
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Name(id='self', ctx=Load()),
                          attr='_on_failure',
                          ctx=Load()))),
                    Raise()])])]),
        FunctionDef(
          name='_on_success',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Handle successful operation')),
            If(
              test=Compare(
                left=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='state',
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Attribute(
                    value=Name(id='CircuitState', ctx=Load()),
                    attr='HALF_OPEN',
                    ctx=Load())]),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='logger',
                        ctx=Load()),
                      attr='info',
                      ctx=Load()),
                    args=[
                      Constant(value='Circuit breaker recovering: HALF_OPEN -> CLOSED')])),
                Assign(
                  targets=[
                    Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='state',
                      ctx=Store())],
                  value=Attribute(
                    value=Name(id='CircuitState', ctx=Load()),
                    attr='CLOSED',
                    ctx=Load())),
                Assign(
                  targets=[
                    Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='failure_count',
                      ctx=Store())],
                  value=Constant(value=0)),
                Assign(
                  targets=[
                    Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='success_count',
                      ctx=Store())],
                  value=Constant(value=0))],
              orelse=[
                If(
                  test=Compare(
                    left=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='state',
                      ctx=Load()),
                    ops=[
                      Eq()],
                    comparators=[
                      Attribute(
                        value=Name(id='CircuitState', ctx=Load()),
                        attr='CLOSED',
                        ctx=Load())]),
                  body=[
                    Assign(
                      targets=[
                        Attribute(
                          value=Name(id='self', ctx=Load()),
                          attr='failure_count',
                          ctx=Store())],
                      value=Constant(value=0))])])]),
        FunctionDef(
          name='_on_failure',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Handle failed operation')),
            AugAssign(
              target=Attribute(
                value=Name(id='self', ctx=Load()),
                attr='failure_count',
                ctx=Store()),
              op=Add(),
              value=Constant(value=1)),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='last_failure_time',
                  ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='time', ctx=Load()),
                  attr='time',
                  ctx=Load()))),
            If(
              test=Compare(
                left=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='failure_count',
                  ctx=Load()),
                ops=[
                  GtE()],
                comparators=[
                  Attribute(
                    value=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='config',
                      ctx=Load()),
                    attr='circuit_breaker_threshold',
                    ctx=Load())]),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='logger',
                        ctx=Load()),
                      attr='error',
                      ctx=Load()),
                    args=[
                      JoinedStr(
                        values=[
                          Constant(value='Circuit breaker opening: '),
                          FormattedValue(
                            value=Attribute(
                              value=Name(id='self', ctx=Load()),
                              attr='failure_count',
                              ctx=Load()),
                            conversion=-1),
