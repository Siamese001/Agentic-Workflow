                  value=Name(id='self', ctx=Load()),
                  attr='_extract_all_text',
                  ctx=Load()),
                args=[
                  Name(id='staging_buffer', ctx=Load())])),
            Assign(
              targets=[
                Name(id='results', ctx=Store())],
              value=List(ctx=Load())),
            For(
              target=Name(id='rule', ctx=Store()),
              iter=Name(id='all_rules', ctx=Load()),
              body=[
                Try(
                  body=[
                    Expr(
                      value=Call(
