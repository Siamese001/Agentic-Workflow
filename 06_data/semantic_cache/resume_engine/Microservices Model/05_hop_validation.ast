        FunctionDef(
          name='check_thematic_alignment',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='buffer',
                annotation=Name(id='ImmutableStagingBuffer', ctx=Load())),
              arg(
                arg='all_text',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        [HIGH-SIGNAL] Checks if the K.1 Summary is semantically\n        aligned with the HOP-0 primary theme.\n        ')),
            Assign(
              targets=[
                Name(id='rule_id', ctx=Store())],
              value=Constant(value='THEMATIC_ALIGNMENT_SUMMARY')),
            If(
              test=Compare(
