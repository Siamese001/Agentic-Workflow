                      Constant(value=False),
                      Attribute(
                        value=Name(id='ValidationSeverity', ctx=Load()),
                        attr='HIGH',
                        ctx=Load()),
                      Constant(value='K.1 Executive Summary is missing.')]))]),
            Assign(
              targets=[
                Name(id='summary_embedding', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='embedding_client',
                    ctx=Load()),
                  attr='embed',
                  ctx=Load()),
                args=[
                  Name(id='summary_text', ctx=Load())])),
            Assign(
              targets=[
                Name(id='similarity_matrix', ctx=Store())],
