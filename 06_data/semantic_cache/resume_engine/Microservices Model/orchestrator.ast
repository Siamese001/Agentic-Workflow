                                  Constant(value=' is created by both '),
                                  FormattedValue(
                                    value=Subscript(
                                      value=Name(id='artifact_to_hop_map', ctx=Load()),
                                      slice=Attribute(
                                        value=Name(id='output', ctx=Load()),
                                        attr='artifact_id',
                                        ctx=Load()),
