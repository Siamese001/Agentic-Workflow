            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='theme_instructions', ctx=Load()),
                  attr='append',
                  ctx=Load()),
                args=[
                  Constant(value='- Strategic planning and partnership elements')]))]),
        If(
          test=Name(id='include_technical_theme', ctx=Load()),
          body=[
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='theme_instructions', ctx=Load()),
                  attr='append',
                  ctx=Load()),
                args=[
                  Constant(value='- Technical depth and platform expertise')]))]),
        Assign(
          targets=[
            Name(id='theme_prompt_section', ctx=Store())],
          value=IfExp(
            test=Name(id='theme_instructions', ctx=Load()),
            body=BinOp(
              left=Constant(value='**KEY THEMES TO INCORPORATE (if relevant and natural):**\n'),
              op=Add(),
              right=Call(
                func=Attribute(
                  value=Constant(value='\n'),
                  attr='join',
                  ctx=Load()),
                args=[
                  Name(id='theme_instructions', ctx=Load())])),
            orelse=Constant(value=''))),
        Return(
          value=Call(
            func=Attribute(
              value=Name(id='template', ctx=Load()),
              attr='format',
              ctx=Load()),
            keywords=[
              keyword(
                arg='bullet_summary_input',
                value=Name(id='bullet_summary_input', ctx=Load())),
              keyword(
                arg='theme_prompt_section',
                value=Name(id='theme_prompt_section', ctx=Load())),
              keyword(
                arg='min_wc',
                value=Name(id='min_wc', ctx=Load())),
              keyword(
                arg='max_wc',
                value=Name(id='max_wc', ctx=Load()))]))],
      returns=Name(id='str', ctx=Load())),
    FunctionDef(
      name='build_generation_prompt_with_reinforced_constraints',
      args=arguments(
        args=[
          arg(
            arg='base_prompt',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='constraints',
            annotation=Subscript(
              value=Name(id='Dict', ctx=Load()),
              slice=Tuple(
                elts=[
                  Name(id='str', ctx=Load()),
                  Name(id='Any', ctx=Load())],
                ctx=Load()),
              ctx=Load())),
          arg(
            arg='attempt_number',
            annotation=Name(id='int', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Reinforces constraints progressively across attempts.\n    V2: Used for progressive constraint enforcement in retry loops.\n    ')),
        Assign(
          targets=[
            Name(id='min_wc', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='constraints', ctx=Load()),
              attr='get',
              ctx=Load()),
            args=[
              Constant(value='min_wc'),
              Call(
                func=Attribute(
                  value=Name(id='constraints', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='min_word_count'),
                  Constant(value=0)])])),
        Assign(
          targets=[
            Name(id='max_wc', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='constraints', ctx=Load()),
              attr='get',
              ctx=Load()),
            args=[
              Constant(value='max_wc'),
              Call(
                func=Attribute(
                  value=Name(id='constraints', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='max_word_count'),
                  Constant(value=999)])])),
        If(
          test=Compare(
            left=Name(id='attempt_number', ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value=1)]),
          body=[
            Assign(
              targets=[
                Name(id='constraint_language', ctx=Store())],
              value=JoinedStr(
                values=[
                  Constant(value='\n\n**CONSTRAINTS (Strict Compliance Required):**\n- Word count: MUST be '),
                  FormattedValue(
                    value=Name(id='min_wc', ctx=Load()),
                    conversion=-1),
                  Constant(value='-'),
                  FormattedValue(
                    value=Name(id='max_wc', ctx=Load()),
                    conversion=-1),
                  Constant(value=' words (verify before output)\n- Format: MUST NOT start with "At [Company]" or "As [Title]"\n- Output: MUST be ONLY the requested content (no fences, no preamble)\n')]))],
          orelse=[
            If(
              test=Compare(
                left=Name(id='attempt_number', ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value=2)]),
              body=[
                Assign(
                  targets=[
                    Name(id='constraint_language', ctx=Store())],
                  value=JoinedStr(
                    values=[
                      Constant(value='\n\n**CRITICAL CONSTRAINTS (Validation Will Reject Non-Compliance):**\n❌ AUTOMATIC REJECTION if word count outside '),
                      FormattedValue(
                        value=Name(id='min_wc', ctx=Load()),
                        conversion=-1),
                      Constant(value='-'),
                      FormattedValue(
                        value=Name(id='max_wc', ctx=Load()),
                        conversion=-1),
                      Constant(value='\n❌ AUTOMATIC REJECTION if starts with "At", "As", "In my role"\n❌ AUTOMATIC REJECTION if contains markdown fences (```)\n\n✓ Count words before submitting\n✓ Review output format before submitting\n')]))],
              orelse=[
                If(
                  test=Compare(
                    left=Name(id='attempt_number', ctx=Load()),
                    ops=[
                      Eq()],
                    comparators=[
                      Constant(value=3)]),
                  body=[
                    Assign(
                      targets=[
                        Name(id='constraint_language', ctx=Store())],
                      value=JoinedStr(
                        values=[
                          Constant(value='\n\n**VALIDATION CHECKLIST (Execute Before Output):**\n[ ] Count words using MS Word rules: [actual_count]\n[ ] Verify: '),
                          FormattedValue(
                            value=Name(id='min_wc', ctx=Load()),
                            conversion=-1),
                          Constant(value=' ≤ [actual_count] ≤ '),
                          FormattedValue(
                            value=Name(id='max_wc', ctx=Load()),
                            conversion=-1),
                          Constant(value='\n[ ] Check first 3 words: NOT ["At", "As", "In", "The", "This"]\n[ ] Check last characters: NOT "```"\n[ ] If ANY box unchecked: REGENERATE\n\nOUTPUT ONLY AFTER ALL BOXES CHECKED.\n')]))],
                  orelse=[
                    Assign(
                      targets=[
                        Name(id='constraint_language', ctx=Store())],
                      value=JoinedStr(
                        values=[
                          Constant(value='\n\n**ALGORITHMIC CONSTRAINT ENFORCEMENT:**\n\nSTEP 1: Generate content naturally\nSTEP 2: Count words using: text.split()\nSTEP 3: IF count < '),
                          FormattedValue(
                            value=Name(id='min_wc', ctx=Load()),
                            conversion=-1),
                          Constant(value=': ADD content to shortest sentence\nSTEP 4: IF count > '),
                          FormattedValue(
                            value=Name(id='max_wc', ctx=Load()),
                            conversion=-1),
                          Constant(value=': REMOVE least-essential phrase\nSTEP 5: IF starts with forbidden pattern: DELETE first 2 words, RECAPITALIZE\nSTEP 6: VERIFY all constraints met\nSTEP 7: OUTPUT\n\nDO NOT output until STEP 7.\n')]))])])]),
        Return(
          value=BinOp(
            left=Name(id='base_prompt', ctx=Load()),
            op=Add(),
            right=Name(id='constraint_language', ctx=Load())))],
      returns=Name(id='str', ctx=Load())),
    FunctionDef(
      name='build_sc_synthesis_prompt',
      args=arguments(
        args=[
          arg(
            arg='original_prompt',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='candidate_responses',
            annotation=Subscript(
              value=Name(id='List', ctx=Load()),
              slice=Name(id='str', ctx=Load()),
              ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='Builds the prompt for self-consistency synthesis.')),
        Assign(
          targets=[
            Name(id='template', ctx=Store())],
          value=Call(
            func=Name(id='_get_prompt_template', ctx=Load()),
            args=[
              Constant(value='artist_sc_synthesis')])),
        Assign(
          targets=[
            Name(id='formatted_responses', ctx=Store())],
          value=Constant(value='')),
        For(
          target=Tuple(
            elts=[
              Name(id='i', ctx=Store()),
              Name(id='res', ctx=Store())],
            ctx=Store()),
          iter=Call(
            func=Name(id='enumerate', ctx=Load()),
            args=[
              Name(id='candidate_responses', ctx=Load())]),
          body=[
            AugAssign(
              target=Name(id='formatted_responses', ctx=Store()),
              op=Add(),
              value=JoinedStr(
                values=[
                  Constant(value='\n---\n**DRAFT '),
                  FormattedValue(
                    value=BinOp(
                      left=Name(id='i', ctx=Load()),
                      op=Add(),
                      right=Constant(value=1)),
                    conversion=-1),
                  Constant(value=':**\n'),
                  FormattedValue(
                    value=Name(id='res', ctx=Load()),
                    conversion=-1),
                  Constant(value='\n---\n')]))]),
        Return(
          value=Call(
            func=Attribute(
              value=Name(id='template', ctx=Load()),
              attr='format',
              ctx=Load()),
            keywords=[
              keyword(
                arg='original_prompt',
                value=Name(id='original_prompt', ctx=Load())),
              keyword(
                arg='candidate_responses',
                value=Name(id='formatted_responses', ctx=Load()))]))],
      returns=Name(id='str', ctx=Load())),
    FunctionDef(
      name='build_validator_factual_check_prompt',
      args=arguments(
