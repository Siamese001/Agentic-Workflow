    FunctionDef(
      name='build_critique_prompt',
      args=arguments(
        args=[
          arg(
            arg='draft',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='validation_results',
            annotation=Subscript(
              value=Name(id='List', ctx=Load()),
              slice=Constant(value='ValidationResult'),
              ctx=Load())),
          arg(
            arg='strategy',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='focus',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='emphasis',
            annotation=Name(id='str', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    V2 NEW: Builds prompt for LLM-based critique generation.\n    Used by CritiqueTool when advanced critique is needed.\n    \n    Args:\n        draft: The failed draft text\n        validation_results: List of validation failures\n        strategy: Strategy type (mechanical_fix, creative_rewrite, etc.)\n        focus: Focus area for improvement\n        emphasis: Emphasis directive\n        \n    Returns:\n        Formatted critique generation prompt\n    ')),
        Assign(
          targets=[
            Name(id='template', ctx=Store())],
          value=Call(
            func=Name(id='_get_prompt_template', ctx=Load()),
            args=[
              Constant(value='v2_critique_generation')])),
        Assign(
          targets=[
            Name(id='failures_text', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Constant(value='\n'),
              attr='join',
              ctx=Load()),
            args=[
              ListComp(
                elt=JoinedStr(
                  values=[
                    Constant(value='- '),
                    FormattedValue(
                      value=Attribute(
                        value=Name(id='vr', ctx=Load()),
                        attr='rule_id',
                        ctx=Load()),
                      conversion=-1),
                    Constant(value=': '),
                    FormattedValue(
                      value=Attribute(
                        value=Name(id='vr', ctx=Load()),
                        attr='message',
                        ctx=Load()),
                      conversion=-1)]),
                generators=[
                  comprehension(
                    target=Name(id='vr', ctx=Store()),
                    iter=Name(id='validation_results', ctx=Load()),
                    ifs=[
                      UnaryOp(
                        op=Not(),
                        operand=Attribute(
                          value=Name(id='vr', ctx=Load()),
                          attr='passed',
                          ctx=Load()))],
                    is_async=0)])])),
        Assign(
          targets=[
            Name(id='strategy_instructions', ctx=Store())],
          value=Dict(
            keys=[
              Constant(value='mechanical_fix'),
              Constant(value='strategic_reframe'),
              Constant(value='creative_rewrite'),
              Constant(value='creative_breakthrough')],
            values=[
              Constant(value='Focus on exact compliance with format, length, and structure constraints.'),
              Constant(value='Focus on thematic alignment and positioning strategy.'),
              Constant(value='Focus on quality, originality, and impact.'),
              Constant(value='Suggest a completely fresh approach and perspective.')])),
        Assign(
          targets=[
            Name(id='strategy_guidance', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='strategy_instructions', ctx=Load()),
              attr='get',
              ctx=Load()),
            args=[
              Name(id='strategy', ctx=Load()),
              Constant(value='Provide comprehensive improvement guidance.')])),
        Return(
          value=Call(
            func=Attribute(
              value=Name(id='template', ctx=Load()),
              attr='format',
              ctx=Load()),
            keywords=[
              keyword(
                arg='draft',
                value=Subscript(
                  value=Name(id='draft', ctx=Load()),
                  slice=Slice(
                    upper=Constant(value=800)),
                  ctx=Load())),
              keyword(
                arg='failures_text',
                value=Name(id='failures_text', ctx=Load())),
              keyword(
                arg='strategy_guidance',
                value=Name(id='strategy_guidance', ctx=Load())),
              keyword(
                arg='focus',
                value=Name(id='focus', ctx=Load())),
              keyword(
                arg='emphasis',
                value=Name(id='emphasis', ctx=Load()))]))],
      returns=Name(id='str', ctx=Load())),
