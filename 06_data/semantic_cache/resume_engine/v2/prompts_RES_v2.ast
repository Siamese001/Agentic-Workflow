                                  slice=Slice(
                                    upper=Constant(value=100)),
                                  ctx=Load()),
                                conversion=-1),
                              Constant(value='...')])]))])])]),
        If(
          test=BoolOp(
            op=And(),
            values=[
              UnaryOp(
                op=Not(),
                operand=Name(id='snippets', ctx=Load())),
              Name(id='master_resume', ctx=Load())]),
          body=[
