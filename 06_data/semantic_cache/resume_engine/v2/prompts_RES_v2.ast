                        conversion=-1),
                      Constant(value='\n'),
                      FormattedValue(
                        value=Name(id='linkedin', ctx=Load()),
                        conversion=-1)]))])])],
      returns=Name(id='str', ctx=Load())),
    FunctionDef(
      name='_extract_recent_achievements_text',
      args=arguments(
        args=[
          arg(
            arg='scaffold',
            annotation=Name(id='Dict', ctx=Load())),
          arg(
            arg='limit',
            annotation=Name(id='int', ctx=Load()))],
        defaults=[
          Constant(value=5)]),
      body=[
        Expr(
          value=Constant(value='Extract recent achievements from scaffold as formatted text.')),
        Assign(
          targets=[
            Name(id='experiences', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='scaffold', ctx=Load()),
              attr='get',
              ctx=Load()),
            args=[
              Constant(value='experience_sections'),
              List(ctx=Load())])),
        Assign(
          targets=[
            Name(id='achievements', ctx=Store())],
          value=List(ctx=Load())),
        For(
          target=Name(id='exp', ctx=Store()),
          iter=Subscript(
            value=Name(id='experiences', ctx=Load()),
            slice=Slice(
              upper=Constant(value=2)),
            ctx=Load()),
          body=[
            For(
              target=Name(id='bullet', ctx=Store()),
              iter=Subscript(
                value=Call(
                  func=Attribute(
                    value=Name(id='exp', ctx=Load()),
                    attr='get',
                    ctx=Load()),
                  args=[
                    Constant(value='bullets'),
                    List(ctx=Load())]),
                slice=Slice(
                  upper=Name(id='limit', ctx=Load())),
                ctx=Load()),
              body=[
                Assign(
                  targets=[
                    Name(id='text_to_add', ctx=Store())],
                  value=IfExp(
                    test=Call(
                      func=Name(id='isinstance', ctx=Load()),
                      args=[
                        Name(id='bullet', ctx=Load()),
                        Name(id='dict', ctx=Load())]),
                    body=Call(
                      func=Attribute(
                        value=Name(id='bullet', ctx=Load()),
                        attr='get',
                        ctx=Load()),
                      args=[
                        Constant(value='bullet_text'),
                        Constant(value='')]),
                    orelse=Call(
                      func=Name(id='str', ctx=Load()),
                      args=[
                        Name(id='bullet', ctx=Load())]))),
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='achievements', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Name(id='text_to_add', ctx=Load())]))])]),
        Return(
          value=IfExp(
            test=Name(id='achievements', ctx=Load()),
            body=Call(
              func=Attribute(
                value=Constant(value='\n'),
                attr='join',
                ctx=Load()),
              args=[
                GeneratorExp(
                  elt=JoinedStr(
                    values=[
                      Constant(value='- '),
                      FormattedValue(
                        value=Name(id='a', ctx=Load()),
                        conversion=-1)]),
                  generators=[
                    comprehension(
                      target=Name(id='a', ctx=Store()),
                      iter=Subscript(
                        value=Name(id='achievements', ctx=Load()),
                        slice=Slice(
                          upper=Name(id='limit', ctx=Load())),
                        ctx=Load()),
                      ifs=[
                        Name(id='a', ctx=Load())],
                      is_async=0)])]),
            orelse=Constant(value='Recent leadership in AI/ML platform development')))],
      returns=Name(id='str', ctx=Load())),
    FunctionDef(
      name='_extract_experience_for_section_text',
      args=arguments(
        args=[
          arg(
            arg='scaffold',
            annotation=Name(id='Dict', ctx=Load())),
          arg(
            arg='section_name',
            annotation=Name(id='str', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='Extract relevant experience data for a section as formatted text.')),
        Assign(
          targets=[
            Name(id='experiences', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='scaffold', ctx=Load()),
              attr='get',
              ctx=Load()),
            args=[
              Constant(value='experience_sections'),
              List(ctx=Load())])),
        Assign(
          targets=[
            Name(id='company_map', ctx=Store())],
          value=Dict(
            keys=[
              Constant(value='K2_UNIFY'),
              Constant(value='K3_IBM')],
            values=[
              Constant(value='Unify'),
              Constant(value='IBM')])),
        Assign(
          targets=[
            Name(id='target_company', ctx=Store())],
          value=Constant(value=None)),
        For(
          target=Tuple(
            elts=[
              Name(id='key', ctx=Store()),
              Name(id='company', ctx=Store())],
            ctx=Store()),
          iter=Call(
            func=Attribute(
              value=Name(id='company_map', ctx=Load()),
              attr='items',
              ctx=Load())),
          body=[
            If(
              test=Compare(
                left=Name(id='key', ctx=Load()),
                ops=[
                  In()],
                comparators=[
                  Name(id='section_name', ctx=Load())]),
              body=[
                Assign(
                  targets=[
                    Name(id='target_company', ctx=Store())],
                  value=Name(id='company', ctx=Load())),
                Break()])]),
        If(
          test=UnaryOp(
            op=Not(),
            operand=Name(id='target_company', ctx=Load())),
          body=[
            Return(
              value=Constant(value='Experience data for current role'))]),
        For(
          target=Name(id='exp', ctx=Store()),
          iter=Name(id='experiences', ctx=Load()),
          body=[
            If(
              test=Compare(
                left=Call(
                  func=Attribute(
                    value=Name(id='target_company', ctx=Load()),
                    attr='lower',
                    ctx=Load())),
                ops=[
                  In()],
                comparators=[
                  Call(
                    func=Attribute(
                      value=Call(
                        func=Attribute(
                          value=Name(id='exp', ctx=Load()),
                          attr='get',
                          ctx=Load()),
                        args=[
                          Constant(value='company'),
                          Constant(value='')]),
                      attr='lower',
                      ctx=Load()))]),
              body=[
                Assign(
                  targets=[
                    Name(id='bullets', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='exp', ctx=Load()),
                      attr='get',
                      ctx=Load()),
                    args=[
                      Constant(value='bullets'),
                      List(ctx=Load())])),
                Assign(
                  targets=[
                    Name(id='bullet_texts', ctx=Store())],
                  value=ListComp(
                    elt=IfExp(
                      test=Call(
                        func=Name(id='isinstance', ctx=Load()),
                        args=[
                          Name(id='b', ctx=Load()),
                          Name(id='dict', ctx=Load())]),
                      body=Call(
                        func=Attribute(
                          value=Name(id='b', ctx=Load()),
                          attr='get',
                          ctx=Load()),
                        args=[
                          Constant(value='bullet_text'),
                          Constant(value='')]),
                      orelse=Call(
                        func=Name(id='str', ctx=Load()),
                        args=[
                          Name(id='b', ctx=Load())])),
                    generators=[
                      comprehension(
