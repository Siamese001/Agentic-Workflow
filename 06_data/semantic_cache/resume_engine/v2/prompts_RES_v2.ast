            args=[
              Name(id='thematic_analysis', ctx=Load()),
              Constant(value='competitive_intelligence'),
              Constant(value=None)])),
        If(
          test=Name(id='comp_intel', ctx=Load()),
          body=[
            Assign(
              targets=[
                Name(id='diff_kw', ctx=Store())],
              value=Call(
                func=Name(id='getattr', ctx=Load()),
                args=[
                  Name(id='comp_intel', ctx=Load()),
                  Constant(value='differentiator_keywords'),
                  List(ctx=Load())])),
            If(
              test=Call(
                func=Name(id='isinstance', ctx=Load()),
                args=[
                  Name(id='diff_kw', ctx=Load()),
                  Name(id='list', ctx=Load())]),
              body=[
                Assign(
                  targets=[
                    Name(id='differentiators', ctx=Store())],
                  value=Subscript(
                    value=Name(id='diff_kw', ctx=Load()),
                    slice=Slice(
                      upper=Constant(value=5)),
                    ctx=Load()))])]),
        Return(
          value=Call(
            func=Attribute(
              value=Name(id='template', ctx=Load()),
              attr='format',
              ctx=Load()),
            keywords=[
              keyword(
                arg='section_name',
                value=Name(id='section_name', ctx=Load())),
              keyword(
                arg='section_content',
                value=Name(id='section_content', ctx=Load())),
              keyword(
                arg='primary_theme',
                value=Name(id='primary_theme', ctx=Load())),
              keyword(
                arg='differentiators_str',
                value=BoolOp(
                  op=Or(),
                  values=[
                    Call(
                      func=Attribute(
                        value=Constant(value=', '),
                        attr='join',
                        ctx=Load()),
                      args=[
                        Name(id='differentiators', ctx=Load())]),
                    Constant(value='N/A')])),
              keyword(
                arg='job_description',
                value=Subscript(
                  value=Name(id='job_description', ctx=Load()),
                  slice=Slice(
                    upper=Constant(value=800)),
                  ctx=Load()))]))],
      returns=Name(id='str', ctx=Load())),
    FunctionDef(
