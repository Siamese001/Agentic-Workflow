          value=Constant(value='\n    Builds prompt for Validator to perform high-signal factual checks.\n    Used in HOP-5 to detect strategic/factual failures that trigger Slow Loop.\n    ')),
        Assign(
          targets=[
            Name(id='template', ctx=Store())],
          value=Call(
            func=Name(id='_get_prompt_template', ctx=Load()),
            args=[
              Constant(value='validator_factual_check')])),
