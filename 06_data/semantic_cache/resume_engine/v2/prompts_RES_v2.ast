                      FormattedValue(
                        value=Call(
                          func=Attribute(
                            value=Constant(value=', '),
                            attr='join',
                            ctx=Load()),
                          args=[
                            Name(id='skills_list', ctx=Load())]),
                        conversion=-1)])]))]),
        If(
          test=BoolOp(
            op=And(),
            values=[
              Call(
                func=Name(id='hasattr', ctx=Load()),
                args=[
                  Name(id='index', ctx=Load()),
