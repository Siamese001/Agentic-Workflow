                  orelse=[
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Name(id='guidance', ctx=Load()),
                          attr='append',
                          ctx=Load()),
                        args=[
                          Constant(value='- Adjust length to meet specified constraints.')]))])]),
            If(
              test=Compare(
                left=Constant(value='Theme Alignment'),
                ops=[
                  In()],
                comparators=[
                  Name(id='categories', ctx=Load())]),
              body=[
                If(
                  test=Compare(
                    left=Constant(value='thematic'),
                    ops=[
