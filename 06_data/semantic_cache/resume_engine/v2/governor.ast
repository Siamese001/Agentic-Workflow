                    comparators=[
                      Call(
                        func=Attribute(
                          value=Name(id='emphasis', ctx=Load()),
                          attr='lower',
                          ctx=Load()))]),
                  body=[
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Name(id='guidance', ctx=Load()),
                          attr='append',
                          ctx=Load()),
                        args=[
                          Constant(value='- Reframe content around the primary theme. Every sentence must serve positioning.')]))],
                  orelse=[
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Name(id='guidance', ctx=Load()),
                          attr='append',
                          ctx=Load()),
                        args=[
                          Constant(value='- Incorporate missing keywords naturally into the narrative.')]))])]),
            If(
              test=Compare(
                left=Constant(value='Content Quality'),
                ops=[
                  In()],
                comparators=[
                  Name(id='categories', ctx=Load())]),
              body=[
                If(
                  test=Compare(
                    left=Constant(value='originality'),
                    ops=[
                      In()],
                    comparators=[
                      Call(
                        func=Attribute(
