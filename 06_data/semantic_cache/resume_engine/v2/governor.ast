                        func=Attribute(
                          value=Name(id='guidance', ctx=Load()),
                          attr='append',
                          ctx=Load()),
                        args=[
                          Constant(value='- Lead with unique insights that differentiate the candidate.')]))],
                  orelse=[
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Name(id='guidance', ctx=Load()),
                          attr='append',
                          ctx=Load()),
                        args=[
                          Constant(value='- Strengthen weak verbs and remove clichés.')]))])]),
            If(
