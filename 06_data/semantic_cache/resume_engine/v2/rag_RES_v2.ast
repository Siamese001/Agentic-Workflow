                                  value=Call(
                                    func=Attribute(
                                      value=Subscript(
                                        value=Name(id='lines', ctx=Load()),
                                        slice=BinOp(
                                          left=Name(id='i', ctx=Load()),
                                          op=Add(),
                                          right=Constant(value=1)),
                                        ctx=Load()),
                                      attr='strip',
                                      ctx=Load())))],
                              orelse=[
                                Assign(
                                  targets=[
                                    Name(id='theme_name', ctx=Store())],
                                  value=Constant(value='N/A'))])]),
                        Assign(
                          targets=[
                            Name(id='primary_theme', ctx=Store())],
                          value=Dict(
                            keys=[
                              Constant(value='name'),
                              Constant(value='keywords')],
                            values=[
                              Name(id='theme_name', ctx=Load()),
                              List(ctx=Load())]))],
                      orelse=[
                        If(
                          test=Compare(
                            left=Constant(value='Secondary Themes:'),
                            ops=[
                              In()],
                            comparators=[
                              Name(id='line', ctx=Load())]),
                          body=[
                            Assign(
                              targets=[
                                Name(id='j', ctx=Store())],
                              value=BinOp(
                                left=Name(id='i', ctx=Load()),
                                op=Add(),
                                right=Constant(value=1))),
                            While(
                              test=BoolOp(
                                op=And(),
                                values=[
                                  Compare(
                                    left=Name(id='j', ctx=Load()),
                                    ops=[
                                      Lt()],
                                    comparators=[
                                      Call(
                                        func=Name(id='len', ctx=Load()),
                                        args=[
                                          Name(id='lines', ctx=Load())])]),
                                  Call(
                                    func=Attribute(
                                      value=Subscript(
                                        value=Name(id='lines', ctx=Load()),
                                        slice=Name(id='j', ctx=Load()),
                                        ctx=Load()),
                                      attr='strip',
                                      ctx=Load())),
                                  UnaryOp(
                                    op=Not(),
                                    operand=Call(
                                      func=Attribute(
                                        value=Subscript(
                                          value=Name(id='lines', ctx=Load()),
                                          slice=Name(id='j', ctx=Load()),
                                          ctx=Load()),
                                        attr='startswith',
                                        ctx=Load()),
                                      args=[
                                        Constant(value='**')])),
                                  UnaryOp(
                                    op=Not(),
                                    operand=Compare(
                                      left=Constant(value=':'),
                                      ops=[
                                        In()],
                                      comparators=[
                                        Subscript(
                                          value=Name(id='lines', ctx=Load()),
                                          slice=Name(id='j', ctx=Load()),
                                          ctx=Load())]))]),
                              body=[
                                Expr(
                                  value=Call(
                                    func=Attribute(
                                      value=Name(id='secondary_themes', ctx=Load()),
                                      attr='append',
                                      ctx=Load()),
                                    args=[
                                      Dict(
                                        keys=[
                                          Constant(value='name'),
                                          Constant(value='keywords')],
                                        values=[
                                          Call(
                                            func=Attribute(
                                              value=Call(
                                                func=Attribute(
                                                  value=Subscript(
                                                    value=Name(id='lines', ctx=Load()),
                                                    slice=Name(id='j', ctx=Load()),
                                                    ctx=Load()),
                                                  attr='strip',
                                                  ctx=Load())),
                                              attr='lstrip',
                                              ctx=Load()),
                                            args=[
                                              Constant(value='- ')]),
                                          List(ctx=Load())])])),
                                AugAssign(
                                  target=Name(id='j', ctx=Store()),
                                  op=Add(),
                                  value=Constant(value=1))])])])]),
                Assign(
                  targets=[
                    Name(id='analysis', ctx=Store())],
                  value=Call(
                    func=Name(id='ThematicAnalysis', ctx=Load()),
                    keywords=[
                      keyword(
                        arg='primary_theme',
                        value=Name(id='primary_theme', ctx=Load())),
                      keyword(
