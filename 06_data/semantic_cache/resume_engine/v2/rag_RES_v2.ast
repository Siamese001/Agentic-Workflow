                      attr='info',
                      ctx=Load()),
                    args=[
                      Constant(value='No high-quality cache match found')])),
                Return(
                  value=Constant(value=None))],
              handlers=[
                ExceptHandler(
                  type=Name(id='Exception', ctx=Load()),
