                  iter=Call(
                    func=Name(id='enumerate', ctx=Load()),
                    args=[
                      Name(id='lines', ctx=Load())]),
                  body=[
                    If(
                      test=Compare(
                        left=Constant(value='Primary Theme:'),
                        ops=[
                          In()],
                        comparators=[
                          Name(id='line', ctx=Load())]),
                      body=[
                        Assign(
                          targets=[
                            Name(id='theme_name_match', ctx=Store())],
                          value=Call(
                            func=Attribute(
