                          ctx=Load()),
                        conversion=-1)])),
                Assign(
                  targets=[
                    Name(id='similar_missions', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='librarian',
                        ctx=Load()),
                      attr='query_similar_missions',
                      ctx=Load()),
                    keywords=[
                      keyword(
                        arg='query',
                        value=Name(id='query_text', ctx=Load())),
                      keyword(
                        arg='company_name',
                        value=Name(id='company_name', ctx=Load())),
                      keyword(
                        arg='n_results',
                        value=Constant(value=3))])),
                If(
                  test=UnaryOp(
                    op=Not(),
                    operand=Name(id='similar_missions', ctx=Load())),
                  body=[
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Name(id='logger', ctx=Load()),
                          attr='info',
                          ctx=Load()),
                        args=[
                          Constant(value='No similar missions found in cache')])),
                    Return(
                      value=Constant(value=None))]),
                For(
                  target=Name(id='mission_result', ctx=Store()),
                  iter=Name(id='similar_missions', ctx=Load()),
                  body=[
                    Assign(
                      targets=[
                        Name(id='distance', ctx=Store())],
