                                func=Attribute(
                                  value=Call(
                                    func=Attribute(
                                      value=Name(id='theme_name_match', ctx=Load()),
                                      attr='group',
                                      ctx=Load()),
                                    args=[
                                      Constant(value=1)]),
                                  attr='strip',
