                                  attr='collection',
                                  ctx=Load()),
                                attr='count',
                                ctx=Load()))])),
                      keyword(
                        arg='where',
                        value=Name(id='where_filter', ctx=Load()))])),
                Assign(
                  targets=[
                    Name(id='formatted_results', ctx=Store())],
                  value=List(ctx=Load())),
                If(
                  test=BoolOp(
                    op=And(),
                    values=[
                      Subscript(
                        value=Name(id='results', ctx=Load()),
                        slice=Constant(value='documents'),
                        ctx=Load()),
                      Subscript(
                        value=Subscript(
                          value=Name(id='results', ctx=Load()),
                          slice=Constant(value='documents'),
                          ctx=Load()),
                        slice=Constant(value=0),
                        ctx=Load())]),
                  body=[
                    For(
                      target=Tuple(
                        elts=[
                          Name(id='i', ctx=Store()),
                          Name(id='doc', ctx=Store())],
                        ctx=Store()),
                      iter=Call(
                        func=Name(id='enumerate', ctx=Load()),
                        args=[
                          Subscript(
                            value=Subscript(
                              value=Name(id='results', ctx=Load()),
                              slice=Constant(value='documents'),
                              ctx=Load()),
                            slice=Constant(value=0),
                            ctx=Load())]),
                      body=[
                        Expr(
                          value=Call(
                            func=Attribute(
                              value=Name(id='formatted_results', ctx=Load()),
                              attr='append',
                              ctx=Load()),
                            args=[
                              Dict(
                                keys=[
                                  Constant(value='content'),
                                  Constant(value='metadata'),
                                  Constant(value='distance')],
                                values=[
                                  Name(id='doc', ctx=Load()),
                                  IfExp(
                                    test=Subscript(
                                      value=Name(id='results', ctx=Load()),
                                      slice=Constant(value='metadatas'),
                                      ctx=Load()),
                                    body=Subscript(
                                      value=Subscript(
                                        value=Subscript(
                                          value=Name(id='results', ctx=Load()),
                                          slice=Constant(value='metadatas'),
                                          ctx=Load()),
                                        slice=Constant(value=0),
                                        ctx=Load()),
                                      slice=Name(id='i', ctx=Load()),
                                      ctx=Load()),
                                    orelse=Dict()),
                                  IfExp(
                                    test=Subscript(
                                      value=Name(id='results', ctx=Load()),
                                      slice=Constant(value='distances'),
                                      ctx=Load()),
                                    body=Subscript(
                                      value=Subscript(
                                        value=Subscript(
                                          value=Name(id='results', ctx=Load()),
                                          slice=Constant(value='distances'),
                                          ctx=Load()),
                                        slice=Constant(value=0),
                                        ctx=Load()),
                                      slice=Name(id='i', ctx=Load()),
                                      ctx=Load()),
                                    orelse=Constant(value=1.0))])]))])]),
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='logger', ctx=Load()),
                      attr='info',
                      ctx=Load()),
                    args=[
                      JoinedStr(
                        values=[
