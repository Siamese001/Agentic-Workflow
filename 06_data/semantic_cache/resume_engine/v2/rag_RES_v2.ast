                            values=[
                              Constant(value='Failed to extract ThematicAnalysis from cache: '),
                              FormattedValue(
                                value=Name(id='e', ctx=Load()),
                                conversion=-1)])])),
                    Return(
                      value=Constant(value=None))])])],
          returns=Subscript(
            value=Name(id='Optional', ctx=Load()),
            slice=Name(id='ThematicAnalysis', ctx=Load()),
            ctx=Load())),
