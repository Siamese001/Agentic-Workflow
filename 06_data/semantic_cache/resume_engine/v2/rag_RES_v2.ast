          returns=Constant(value=None)),
        FunctionDef(
          name='query_similar_missions',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='query',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='company_name',
                annotation=Subscript(
                  value=Name(id='Optional', ctx=Load()),
                  slice=Name(id='str', ctx=Load()),
                  ctx=Load())),
              arg(
                arg='n_results',
                annotation=Name(id='int', ctx=Load()))],
            defaults=[
              Constant(value=None),
              Constant(value=3)]),
          body=[
            Expr(
              value=Constant(value='\n        Queries for similar past missions to inform current extraction.\n        \n        Args:\n            query: Search query (e.g., job title or theme)\n            company_name: Optional company filter\n            n_results: Number of results to return\n            \n        Returns:\n            List of similar mission contexts\n        ')),
            If(
              test=BoolOp(
                op=Or(),
                values=[
                  UnaryOp(
                    op=Not(),
                    operand=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='enabled',
                      ctx=Load())),
                  Compare(
                    left=Call(
                      func=Attribute(
                        value=Attribute(
                          value=Name(id='self', ctx=Load()),
                          attr='collection',
                          ctx=Load()),
                        attr='count',
                        ctx=Load())),
                    ops=[
                      Eq()],
                    comparators=[
                      Constant(value=0)])]),
              body=[
                Return(
                  value=List(ctx=Load()))]),
            Try(
              body=[
                Assign(
                  targets=[
                    Name(id='where_filter', ctx=Store())],
                  value=Constant(value=None)),
                If(
                  test=Name(id='company_name', ctx=Load()),
                  body=[
                    Assign(
                      targets=[
                        Name(id='where_filter', ctx=Store())],
                      value=Dict(
                        keys=[
