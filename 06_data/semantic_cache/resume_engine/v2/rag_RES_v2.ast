                      Constant(value='\n')])),
                Assign(
                  targets=[
                    Name(id='primary_theme', ctx=Store())],
                  value=Dict()),
                Assign(
                  targets=[
                    Name(id='secondary_themes', ctx=Store())],
                  value=List(ctx=Load())),
                For(
                  target=Tuple(
                    elts=[
                      Name(id='i', ctx=Store()),
                      Name(id='line', ctx=Store())],
