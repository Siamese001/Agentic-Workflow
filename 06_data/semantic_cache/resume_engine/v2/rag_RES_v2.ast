        FunctionDef(
          name='_extract_thematic_analysis_from_cache',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='cached_document',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Extract ThematicAnalysis from a cached Librarian document.\n        \n        The document format is created by _format_mission_document.\n        We need to parse it back into a ThematicAnalysis object.\n        ')),
            Try(
              body=[
                Assign(
                  targets=[
                    Name(id='lines', ctx=Store())],
