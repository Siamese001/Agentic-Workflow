                                            FormattedValue(
                                              value=Name(id='cached_title', ctx=Load()),
                                              conversion=-1)]))])],
                                ctx=Load())),
                            Return(
                              value=Name(id='cached_analysis', ctx=Load()))])])]),
                Expr(
