          body=[
            Expr(
              value=Constant(value='\n        COST-OPTIMIZED: Check Librarian cache for similar missions.\n        \n        If a high-quality cached ThematicAnalysis is found for a similar role,\n        return it directly to skip expensive RAG phases (saves ~4-5 LLM calls).\n        \n        Args:\n            current_mission: The RAGMission just extracted\n            company_name: Target company\n            job_title: Target job title\n            similarity_threshold: Minimum similarity score (0-1) to use cache\n            \n        Returns:\n            Cached ThematicAnalysis if high-quality match found, else None\n        ')),
            If(
              test=UnaryOp(
                op=Not(),
                operand=Attribute(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='librarian',
                    ctx=Load()),
                  attr='enabled',
                  ctx=Load())),
              body=[
                Return(
                  value=Constant(value=None))]),
            Try(
              body=[
                Assign(
                  targets=[
                    Name(id='query_text', ctx=Store())],
                  value=JoinedStr(
                    values=[
                      FormattedValue(
                        value=Name(id='company_name', ctx=Load()),
                        conversion=-1),
                      Constant(value=' '),
                      FormattedValue(
                        value=Attribute(
                          value=Name(id='current_mission', ctx=Load()),
