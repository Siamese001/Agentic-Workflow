        FunctionDef(
          name='get_context_for_phase',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='phase_name',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='rag_mission',
                annotation=Name(id='RAGMission', ctx=Load())),
              arg(
                arg='company_name',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Gets relevant Librarian context for a specific RAG phase.\n        \n        Args:\n            phase_name: Name of RAG phase (phase1, phase2, etc.)\n            rag_mission: Current RAGMission\n            company_name: Target company\n            \n        Returns:\n            Formatted context string or None\n        ')),
            If(
              test=UnaryOp(
                op=Not(),
                operand=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='enabled',
                  ctx=Load())),
              body=[
                Return(
                  value=Constant(value=None))]),
            Try(
              body=[
                If(
                  test=Compare(
                    left=Constant(value='phase1'),
                    ops=[
                      In()],
                    comparators=[
                      Call(
                        func=Attribute(
                          value=Name(id='phase_name', ctx=Load()),
                          attr='lower',
                          ctx=Load()))]),
                  body=[
                    Assign(
                      targets=[
                        Name(id='query', ctx=Store())],
                      value=JoinedStr(
                        values=[
                          FormattedValue(
                            value=Attribute(
                              value=Name(id='rag_mission', ctx=Load()),
                              attr='precise_role_title',
                              ctx=Load()),
                            conversion=-1),
                          Constant(value=' '),
                          FormattedValue(
                            value=Name(id='company_name', ctx=Load()),
                            conversion=-1),
