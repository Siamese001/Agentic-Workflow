                          body=[
                            Assign(
                              targets=[
                                Name(id='theme_name', ctx=Store())],
                              value=Call(
                                func=Attribute(
                                  value=Call(
                                    func=Attribute(
                                      value=Name(id='theme_name_match', ctx=Load()),
                                      attr='group',
                                      ctx=Load()),
                                    args=[
                                      Constant(value=1)]),
                                  attr='strip',
                                  ctx=Load())))],
                          orelse=[
                            If(
                              test=Compare(
                                left=BinOp(
                                  left=Name(id='i', ctx=Load()),
                                  op=Add(),
                                  right=Constant(value=1)),
                                ops=[
                                  Lt()],
                                comparators=[
                                  Call(
                                    func=Name(id='len', ctx=Load()),
                                    args=[
                                      Name(id='lines', ctx=Load())])]),
                              body=[
                                Assign(
                                  targets=[
