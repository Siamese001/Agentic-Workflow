    ClassDef(
      name='SectionCoherenceScorer',
      body=[
        Expr(
          value=Constant(value='\n    Coherence validation using coefficient of variation (CV).\n    From v4.2 - ensures sections maintain consistent structure.\n    ')),
        FunctionDef(
          name='calculate_cv',
          args=arguments(
            args=[
              arg(
                arg='values',
                annotation=Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Name(id='float', ctx=Load()),
                  ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Calculate coefficient of variation.\n        CV = (std_dev / mean) * 100\n        ')),
            If(
              test=BoolOp(
                op=Or(),
                values=[
                  UnaryOp(
                    op=Not(),
                    operand=Name(id='values', ctx=Load())),
                  Compare(
                    left=Call(
                      func=Name(id='len', ctx=Load()),
                      args=[
                        Name(id='values', ctx=Load())]),
                    ops=[
                      Lt()],
                    comparators=[
                      Constant(value=2)])]),
              body=[
                Return(
                  value=Constant(value=0.0))]),
            Assign(
              targets=[
                Name(id='mean', ctx=Store())],
              value=BinOp(
                left=Call(
                  func=Name(id='sum', ctx=Load()),
                  args=[
                    Name(id='values', ctx=Load())]),
                op=Div(),
                right=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Name(id='values', ctx=Load())]))),
            If(
              test=Compare(
                left=Name(id='mean', ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value=0)]),
              body=[
                Return(
                  value=Constant(value=0.0))]),
            Assign(
              targets=[
                Name(id='variance', ctx=Store())],
              value=BinOp(
                left=Call(
                  func=Name(id='sum', ctx=Load()),
                  args=[
                    GeneratorExp(
                      elt=BinOp(
                        left=BinOp(
                          left=Name(id='x', ctx=Load()),
                          op=Sub(),
                          right=Name(id='mean', ctx=Load())),
                        op=Pow(),
                        right=Constant(value=2)),
                      generators=[
                        comprehension(
                          target=Name(id='x', ctx=Store()),
                          iter=Name(id='values', ctx=Load()),
                          is_async=0)])]),
                op=Div(),
                right=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
