                ctx=Store()),
              iter=Call(
                func=Attribute(
                  value=Name(id='section_signals', ctx=Load()),
                  attr='items',
                  ctx=Load())),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='lines', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      JoinedStr(
                        values=[
                          FormattedValue(
                            value=Name(id='section', ctx=Load()),
                            conversion=-1,
                            format_spec=JoinedStr(
                              values=[
                                Constant(value='25')])),
                          Constant(value=' | Signal: '),
                          FormattedValue(
                            value=Name(id='signal', ctx=Load()),
                            conversion=-1,
                            format_spec=JoinedStr(
                              values=[
                                Constant(value='.3f')]))])]))]),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='lines', ctx=Load()),
                  attr='append',
                  ctx=Load()),
                args=[
                  Constant(value='')])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='lines', ctx=Load()),
                  attr='append',
                  ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='WEIGHTED AVERAGE: '),
                      FormattedValue(
                        value=Call(
                          func=Attribute(
                            value=Name(id='hop5', ctx=Load()),
                            attr='get',
                            ctx=Load()),
                          args=[
                            Constant(value='weighted_average'),
                            Constant(value=0)]),
                        conversion=-1,
                        format_spec=JoinedStr(
                          values=[
                            Constant(value='.3f')]))])])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='lines', ctx=Load()),
                  attr='append',
                  ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='TARGET RANGE: 0.720 - 0.780')])])),
            Assign(
              targets=[
                Name(id='weighted', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='hop5', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='weighted_average'),
                  Constant(value=0)])),
            Assign(
              targets=[
                Name(id='status', ctx=Store())],
              value=IfExp(
                test=Compare(
                  left=Constant(value=0.72),
                  ops=[
                    LtE(),
                    LtE()],
                  comparators=[
                    Name(id='weighted', ctx=Load()),
                    Constant(value=0.78)]),
                body=Constant(value='✓ PASS'),
                orelse=Constant(value='✗ FAIL'))),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='lines', ctx=Load()),
                  attr='append',
                  ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='STATUS: '),
                      FormattedValue(
                        value=Name(id='status', ctx=Load()),
                        conversion=-1)])])),
            Return(
              value=Call(
                func=Attribute(
                  value=Constant(value='\n'),
                  attr='join',
                  ctx=Load()),
                args=[
                  Name(id='lines', ctx=Load())]))],
          returns=Name(id='str', ctx=Load())),
        FunctionDef(
          name='_format_validation_report',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='hop6',
                annotation=Name(id='Dict', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Format validation report with all 6 gates.')),
            Assign(
              targets=[
                Name(id='lines', ctx=Store())],
              value=List(ctx=Load())),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='lines', ctx=Load()),
                  attr='append',
                  ctx=Load()),
                args=[
                  Constant(value='VALIDATION REPORT (6 QA Gates from v4.2)')])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='lines', ctx=Load()),
                  attr='append',
                  ctx=Load()),
                args=[
                  BinOp(
                    left=Constant(value='='),
                    op=Mult(),
                    right=Constant(value=80))])),
            Assign(
              targets=[
                Name(id='gate_results', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Call(
                    func=Attribute(
                      value=Name(id='hop6', ctx=Load()),
                      attr='get',
                      ctx=Load()),
                    args=[
                      Constant(value='gate_results'),
                      Dict()]),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='gates'),
                  Dict()])),
            For(
              target=Tuple(
                elts=[
                  Name(id='gate_id', ctx=Store()),
                  Name(id='gate', ctx=Store())],
                ctx=Store()),
              iter=Call(
                func=Attribute(
                  value=Name(id='gate_results', ctx=Load()),
                  attr='items',
                  ctx=Load())),
              body=[
                Assign(
                  targets=[
                    Name(id='status', ctx=Store())],
                  value=IfExp(
                    test=Call(
                      func=Attribute(
                        value=Name(id='gate', ctx=Load()),
                        attr='get',
                        ctx=Load()),
                      args=[
                        Constant(value='pass'),
                        Constant(value=False)]),
                    body=Constant(value='✓ PASS'),
                    orelse=Constant(value='✗ FAIL'))),
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='lines', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      JoinedStr(
                        values=[
                          FormattedValue(
                            value=Subscript(
                              value=Name(id='gate', ctx=Load()),
                              slice=Constant(value='name'),
                              ctx=Load()),
                            conversion=-1,
                            format_spec=JoinedStr(
                              values=[
                                Constant(value='40')])),
                          Constant(value=' | '),
                          FormattedValue(
                            value=Name(id='status', ctx=Load()),
                            conversion=-1,
                            format_spec=JoinedStr(
                              values=[
                                Constant(value='8')])),
                          Constant(value=' | '),
                          FormattedValue(
                            value=Call(
                              func=Attribute(
                                value=Name(id='gate', ctx=Load()),
                                attr='get',
                                ctx=Load()),
                              args=[
                                Constant(value='severity'),
                                Constant(value='INFO')]),
                            conversion=-1)])])),
                If(
                  test=UnaryOp(
                    op=Not(),
                    operand=Call(
                      func=Attribute(
                        value=Name(id='gate', ctx=Load()),
                        attr='get',
                        ctx=Load()),
                      args=[
                        Constant(value='pass'),
                        Constant(value=False)])),
                  body=[
                    If(
                      test=Compare(
                        left=Constant(value='violations'),
                        ops=[
                          In()],
                        comparators=[
                          Name(id='gate', ctx=Load())]),
                      body=[
                        For(
                          target=Name(id='v', ctx=Store()),
                          iter=Subscript(
                            value=Name(id='gate', ctx=Load()),
                            slice=Constant(value='violations'),
                            ctx=Load()),
                          body=[
                            Expr(
                              value=Call(
                                func=Attribute(
                                  value=Name(id='lines', ctx=Load()),
                                  attr='append',
                                  ctx=Load()),
                                args=[
                                  JoinedStr(
                                    values=[
                                      Constant(value='  └─ '),
                                      FormattedValue(
                                        value=Name(id='v', ctx=Load()),
                                        conversion=-1)])]))])]),
                    If(
                      test=Compare(
                        left=Constant(value='low_elasticity_sections'),
                        ops=[
                          In()],
                        comparators=[
                          Name(id='gate', ctx=Load())]),
                      body=[
                        For(
                          target=Name(id='s', ctx=Store()),
                          iter=Subscript(
                            value=Name(id='gate', ctx=Load()),
                            slice=Constant(value='low_elasticity_sections'),
                            ctx=Load()),
                          body=[
                            Expr(
                              value=Call(
                                func=Attribute(
                                  value=Name(id='lines', ctx=Load()),
                                  attr='append',
                                  ctx=Load()),
                                args=[
                                  JoinedStr(
                                    values=[
                                      Constant(value='  └─ Low elasticity: '),
                                      FormattedValue(
                                        value=Name(id='s', ctx=Load()),
                                        conversion=-1)])]))])]),
                    If(
                      test=Compare(
                        left=Constant(value='high_cv_sections'),
                        ops=[
                          In()],
                        comparators=[
                          Name(id='gate', ctx=Load())]),
                      body=[
                        For(
                          target=Name(id='s', ctx=Store()),
                          iter=Subscript(
                            value=Name(id='gate', ctx=Load()),
                            slice=Constant(value='high_cv_sections'),
                            ctx=Load()),
                          body=[
                            Expr(
                              value=Call(
                                func=Attribute(
                                  value=Name(id='lines', ctx=Load()),
                                  attr='append',
                                  ctx=Load()),
                                args=[
                                  JoinedStr(
                                    values=[
                                      Constant(value='  └─ High CV: '),
                                      FormattedValue(
                                        value=Name(id='s', ctx=Load()),
                                        conversion=-1)])]))])]),
                    If(
                      test=Compare(
                        left=Constant(value='sub_checks'),
                        ops=[
                          In()],
                        comparators=[
                          Name(id='gate', ctx=Load())]),
                      body=[
                        For(
                          target=Tuple(
                            elts=[
                              Name(id='check', ctx=Store()),
                              Name(id='passed', ctx=Store())],
                            ctx=Store()),
                          iter=Call(
                            func=Attribute(
                              value=Subscript(
                                value=Name(id='gate', ctx=Load()),
                                slice=Constant(value='sub_checks'),
                                ctx=Load()),
                              attr='items',
                              ctx=Load())),
                          body=[
                            Assign(
                              targets=[
                                Name(id='check_status', ctx=Store())],
                              value=IfExp(
                                test=Name(id='passed', ctx=Load()),
                                body=Constant(value='✓'),
                                orelse=Constant(value='✗'))),
                            Expr(
                              value=Call(
                                func=Attribute(
                                  value=Name(id='lines', ctx=Load()),
                                  attr='append',
                                  ctx=Load()),
                                args=[
                                  JoinedStr(
                                    values=[
                                      Constant(value='  └─ '),
                                      FormattedValue(
                                        value=Name(id='check_status', ctx=Load()),
                                        conversion=-1),
                                      Constant(value=' '),
                                      FormattedValue(
                                        value=Name(id='check', ctx=Load()),
                                        conversion=-1)])]))])])])]),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='lines', ctx=Load()),
                  attr='append',
                  ctx=Load()),
                args=[
                  Constant(value='')])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='lines', ctx=Load()),
                  attr='append',
                  ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='SUMMARY: '),
                      FormattedValue(
                        value=Call(
                          func=Attribute(
                            value=Call(
                              func=Attribute(
                                value=Name(id='hop6', ctx=Load()),
                                attr='get',
                                ctx=Load()),
                              args=[
