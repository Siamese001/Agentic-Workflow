        Return(
          value=Name(id='resources', ctx=Load()))]),
    Assign(
      targets=[
        Name(id='JSON_RESOURCES', ctx=Store())],
      value=Call(
        func=Name(id='load_json_resources', ctx=Load()))),
    ClassDef(
      name='PerSectionTolerance',
      body=[
        Expr(
          value=Constant(value='\n    Per-section tolerance configuration with elasticity curves.\n    From v4.2 - provides granular control over each section.\n    ')),
        AnnAssign(
          target=Name(id='baseline_words', ctx=Store()),
          annotation=Name(id='int', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='tolerance_pct', ctx=Store()),
          annotation=Name(id='float', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='signal_floor', ctx=Store()),
          annotation=Name(id='float', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='signal_ceiling', ctx=Store()),
          annotation=Name(id='float', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='elasticity', ctx=Store()),
          annotation=Name(id='float', ctx=Load()),
          simple=1),
        FunctionDef(
          name='get_word_range',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Get allowed word count range.')),
            Assign(
              targets=[
                Name(id='delta', ctx=Store())],
              value=Call(
                func=Name(id='int', ctx=Load()),
                args=[
                  BinOp(
                    left=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='baseline_words',
                      ctx=Load()),
                    op=Mult(),
                    right=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='tolerance_pct',
                      ctx=Load()))])),
            Return(
              value=Tuple(
                elts=[
                  BinOp(
                    left=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='baseline_words',
                      ctx=Load()),
                    op=Sub(),
                    right=Name(id='delta', ctx=Load())),
                  BinOp(
                    left=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='baseline_words',
                      ctx=Load()),
                    op=Add(),
                    right=Name(id='delta', ctx=Load()))],
                ctx=Load()))],
          returns=Subscript(
            value=Name(id='Tuple', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='int', ctx=Load()),
                Name(id='int', ctx=Load())],
              ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='get_signal_range',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Get signal floor and ceiling.')),
            Return(
              value=Tuple(
                elts=[
                  Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='signal_floor',
                    ctx=Load()),
                  Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='signal_ceiling',
                    ctx=Load())],
                ctx=Load()))],
          returns=Subscript(
            value=Name(id='Tuple', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='float', ctx=Load()),
                Name(id='float', ctx=Load())],
              ctx=Load()),
            ctx=Load()))],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='SignalElasticityModel',
      body=[
        Expr(
          value=Constant(value='\n    Non-linear elasticity model for signal calculation.\n    From v4.2 - provides sophisticated signal curves based on word count deviation.\n    ')),
        FunctionDef(
          name='__init__',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='section_config',
                annotation=Name(id='PerSectionTolerance', ctx=Load()))]),
          body=[
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='config',
                  ctx=Store())],
              value=Name(id='section_config', ctx=Load())),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='baseline',
                  ctx=Store())],
              value=Attribute(
                value=Name(id='section_config', ctx=Load()),
                attr='baseline_words',
                ctx=Load())),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='elasticity',
                  ctx=Store())],
              value=Attribute(
                value=Name(id='section_config', ctx=Load()),
                attr='elasticity',
                ctx=Load())),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='signal_floor',
                  ctx=Store())],
              value=Attribute(
                value=Name(id='section_config', ctx=Load()),
                attr='signal_floor',
                ctx=Load())),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='signal_ceiling',
                  ctx=Store())],
              value=Attribute(
                value=Name(id='section_config', ctx=Load()),
                attr='signal_ceiling',
                ctx=Load()))]),
        FunctionDef(
          name='calculate_elasticity_multiplier',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='word_count',
                annotation=Name(id='int', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Calculate elasticity multiplier using non-linear curve.\n        Returns value between 0.0 and 1.0 representing signal degradation.\n        ')),
            If(
              test=Compare(
                left=Name(id='word_count', ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='baseline',
                    ctx=Load())]),
              body=[
                Return(
                  value=Constant(value=1.0))]),
            Assign(
              targets=[
                Name(id='deviation', ctx=Store())],
              value=BinOp(
                left=Call(
                  func=Name(id='abs', ctx=Load()),
                  args=[
                    BinOp(
                      left=Name(id='word_count', ctx=Load()),
                      op=Sub(),
                      right=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='baseline',
                        ctx=Load()))]),
                op=Div(),
                right=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='baseline',
                  ctx=Load()))),
            Assign(
              targets=[
                Name(id='multiplier', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='math', ctx=Load()),
                  attr='exp',
                  ctx=Load()),
                args=[
                  BinOp(
                    left=BinOp(
                      left=UnaryOp(
                        op=USub(),
                        operand=Attribute(
                          value=Name(id='self', ctx=Load()),
                          attr='elasticity',
                          ctx=Load())),
                      op=Mult(),
                      right=Name(id='deviation', ctx=Load())),
                    op=Mult(),
                    right=Constant(value=10))])),
            Return(
              value=Call(
                func=Name(id='max', ctx=Load()),
                args=[
                  Constant(value=0.5),
                  Call(
                    func=Name(id='min', ctx=Load()),
                    args=[
                      Constant(value=1.0),
                      Name(id='multiplier', ctx=Load())])]))],
          returns=Name(id='float', ctx=Load())),
        FunctionDef(
          name='calculate_signal',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='word_count',
                annotation=Name(id='int', ctx=Load())),
              arg(
                arg='base_signal',
                annotation=Name(id='float', ctx=Load()))],
            defaults=[
              Constant(value=0.75)]),
          body=[
            Expr(
              value=Constant(value='\n        Calculate final signal for a section based on word count.\n        \n        Args:\n            word_count: Actual word count\n            base_signal: Base signal strength (default 0.75)\n        \n        Returns:\n            Adjusted signal value\n        ')),
            Assign(
              targets=[
                Name(id='multiplier', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='calculate_elasticity_multiplier',
                  ctx=Load()),
                args=[
                  Name(id='word_count', ctx=Load())])),
            Assign(
              targets=[
                Name(id='adjusted_signal', ctx=Store())],
              value=BinOp(
                left=Name(id='base_signal', ctx=Load()),
                op=Mult(),
                right=Name(id='multiplier', ctx=Load()))),
            Return(
              value=Call(
                func=Name(id='max', ctx=Load()),
                args=[
                  Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='signal_floor',
                    ctx=Load()),
                  Call(
                    func=Name(id='min', ctx=Load()),
                    args=[
                      Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='signal_ceiling',
                        ctx=Load()),
                      Name(id='adjusted_signal', ctx=Load())])]))],
          returns=Name(id='float', ctx=Load()))]),
    ClassDef(
      name='SectionPriorityAllocator',
      body=[
        Expr(
          value=Constant(value='\n    Dynamic priority allocation matrix for word count distribution.\n    From v4.2 - intelligently distributes word budgets across sections.\n    ')),
        Assign(
          targets=[
            Name(id='BASE_PRIORITIES', ctx=Store())],
          value=Dict(
            keys=[
              Constant(value='headline'),
              Constant(value='executive_summary'),
              Constant(value='unify'),
              Constant(value='ibm'),
              Constant(value='tradersense'),
              Constant(value='ey'),
              Constant(value='early')],
            values=[
              Constant(value=0.08),
              Constant(value=0.15),
              Constant(value=0.38),
              Constant(value=0.27),
              Constant(value=0.05),
              Constant(value=0.04),
              Constant(value=0.03)])),
        FunctionDef(
          name='allocate_word_budget',
          args=arguments(
            args=[
              arg(arg='cls'),
              arg(
                arg='total_budget',
                annotation=Name(id='int', ctx=Load())),
              arg(
                arg='section_constraints',
                annotation=Subscript(
                  value=Name(id='Dict', ctx=Load()),
                  slice=Tuple(
                    elts=[
                      Name(id='str', ctx=Load()),
                      Name(id='PerSectionTolerance', ctx=Load())],
                    ctx=Load()),
                  ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Allocate word budget across sections based on priorities.\n        \n        Args:\n            total_budget: Total available words\n            section_constraints: Per-section tolerance configs\n        \n        Returns:\n            Dict mapping section to allocated words\n        ')),
            Assign(
              targets=[
                Name(id='allocation', ctx=Store())],
              value=Dict()),
            Assign(
              targets=[
                Name(id='remaining', ctx=Store())],
              value=Name(id='total_budget', ctx=Load())),
            For(
              target=Tuple(
                elts=[
                  Name(id='section', ctx=Store()),
                  Name(id='priority', ctx=Store())],
                ctx=Store()),
              iter=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='cls', ctx=Load()),
                    attr='BASE_PRIORITIES',
                    ctx=Load()),
                  attr='items',
                  ctx=Load())),
              body=[
                If(
                  test=Compare(
                    left=Name(id='section', ctx=Load()),
                    ops=[
                      In()],
                    comparators=[
                      Name(id='section_constraints', ctx=Load())]),
                  body=[
                    Assign(
                      targets=[
                        Name(id='target', ctx=Store())],
                      value=Call(
                        func=Name(id='int', ctx=Load()),
                        args=[
                          BinOp(
                            left=Name(id='total_budget', ctx=Load()),
                            op=Mult(),
                            right=Name(id='priority', ctx=Load()))])),
                    Assign(
                      targets=[
                        Name(id='config', ctx=Store())],
                      value=Subscript(
                        value=Name(id='section_constraints', ctx=Load()),
                        slice=Name(id='section', ctx=Load()),
                        ctx=Load())),
                    Assign(
                      targets=[
                        Tuple(
                          elts=[
                            Name(id='min_words', ctx=Store()),
                            Name(id='max_words', ctx=Store())],
                          ctx=Store())],
                      value=Call(
                        func=Attribute(
                          value=Name(id='config', ctx=Load()),
                          attr='get_word_range',
                          ctx=Load()))),
                    Assign(
                      targets=[
                        Name(id='allocated', ctx=Store())],
                      value=Call(
                        func=Name(id='max', ctx=Load()),
                        args=[
                          Name(id='min_words', ctx=Load()),
                          Call(
                            func=Name(id='min', ctx=Load()),
                            args=[
                              Name(id='max_words', ctx=Load()),
                              Name(id='target', ctx=Load())])])),
                    Assign(
                      targets=[
                        Subscript(
                          value=Name(id='allocation', ctx=Load()),
                          slice=Name(id='section', ctx=Load()),
                          ctx=Store())],
                      value=Name(id='allocated', ctx=Load())),
                    AugAssign(
                      target=Name(id='remaining', ctx=Store()),
                      op=Sub(),
                      value=Name(id='allocated', ctx=Load()))])]),
            If(
              test=Compare(
                left=Name(id='remaining', ctx=Load()),
                ops=[
                  Gt()],
                comparators=[
                  Constant(value=0)]),
              body=[
                For(
                  target=Name(id='section', ctx=Store()),
                  iter=Call(
                    func=Name(id='sorted', ctx=Load()),
                    args=[
                      Call(
                        func=Attribute(
                          value=Attribute(
                            value=Name(id='cls', ctx=Load()),
                            attr='BASE_PRIORITIES',
                            ctx=Load()),
                          attr='keys',
                          ctx=Load()))],
                    keywords=[
                      keyword(
                        arg='key',
                        value=Lambda(
                          args=arguments(
                            args=[
                              arg(arg='s')]),
                          body=Subscript(
                            value=Attribute(
                              value=Name(id='cls', ctx=Load()),
                              attr='BASE_PRIORITIES',
                              ctx=Load()),
                            slice=Name(id='s', ctx=Load()),
                            ctx=Load()))),
                      keyword(
                        arg='reverse',
                        value=Constant(value=True))]),
                  body=[
                    If(
                      test=BoolOp(
                        op=And(),
                        values=[
                          Compare(
                            left=Name(id='section', ctx=Load()),
                            ops=[
                              In()],
                            comparators=[
                              Name(id='section_constraints', ctx=Load())]),
                          Compare(
                            left=Name(id='remaining', ctx=Load()),
                            ops=[
                              Gt()],
                            comparators=[
                              Constant(value=0)])]),
                      body=[
                        Assign(
                          targets=[
                            Name(id='config', ctx=Store())],
                          value=Subscript(
                            value=Name(id='section_constraints', ctx=Load()),
                            slice=Name(id='section', ctx=Load()),
                            ctx=Load())),
                        Assign(
                          targets=[
                            Tuple(
                              elts=[
                                Name(id='_', ctx=Store()),
                                Name(id='max_words', ctx=Store())],
                              ctx=Store())],
                          value=Call(
                            func=Attribute(
                              value=Name(id='config', ctx=Load()),
                              attr='get_word_range',
                              ctx=Load()))),
                        Assign(
                          targets=[
                            Name(id='current', ctx=Store())],
                          value=Call(
                            func=Attribute(
                              value=Name(id='allocation', ctx=Load()),
                              attr='get',
                              ctx=Load()),
                            args=[
                              Name(id='section', ctx=Load()),
                              Constant(value=0)])),
                        If(
                          test=Compare(
                            left=Name(id='current', ctx=Load()),
                            ops=[
                              Lt()],
                            comparators=[
                              Name(id='max_words', ctx=Load())]),
                          body=[
                            Assign(
                              targets=[
                                Name(id='extra', ctx=Store())],
                              value=Call(
                                func=Name(id='min', ctx=Load()),
                                args=[
                                  Name(id='remaining', ctx=Load()),
                                  BinOp(
                                    left=Name(id='max_words', ctx=Load()),
                                    op=Sub(),
                                    right=Name(id='current', ctx=Load()))])),
                            AugAssign(
                              target=Subscript(
                                value=Name(id='allocation', ctx=Load()),
                                slice=Name(id='section', ctx=Load()),
                                ctx=Store()),
                              op=Add(),
                              value=Name(id='extra', ctx=Load())),
                            AugAssign(
                              target=Name(id='remaining', ctx=Store()),
                              op=Sub(),
                              value=Name(id='extra', ctx=Load()))])])])]),
            Return(
              value=Name(id='allocation', ctx=Load()))],
          decorator_list=[
            Name(id='classmethod', ctx=Load())],
          returns=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='int', ctx=Load())],
              ctx=Load()),
            ctx=Load()))]),
    ClassDef(
      name='SignalPreservationScorer',
      body=[
        Expr(
          value=Constant(value='\n    Smart bullet selection based on signal preservation.\n    From v4.2 - ranks bullets by signal strength and selects optimally.\n    ')),
        FunctionDef(
          name='score_bullet',
          args=arguments(
            args=[
              arg(
                arg='bullet_text',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='keywords',
                annotation=Subscript(
                  value=Name(id='Set', ctx=Load()),
                  slice=Name(id='str', ctx=Load()),
                  ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Score a bullet based on keyword density and quality metrics.\n        \n        Args:\n            bullet_text: The bullet text\n            keywords: Set of important keywords\n        \n        Returns:\n            Score between 0.0 and 1.0\n        ')),
