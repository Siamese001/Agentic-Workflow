                        func=Name(id='count_words_clean', ctx=Load()),
                        args=[
                          Name(id='comp', ctx=Load())])),
                    Assign(
                      targets=[
                        Subscript(
                          value=Name(id='component_details', ctx=Load()),
                          slice=JoinedStr(
                            values=[
                              Constant(value='component_'),
                              FormattedValue(
                                value=Name(id='i', ctx=Load()),
                                conversion=-1),
                              Constant(value='_words')]),
                          ctx=Store())],
                      value=Name(id='comp_words', ctx=Load())),
                    If(
                      test=UnaryOp(
                        op=Not(),
                        operand=Compare(
                          left=Name(id='min_comp_words', ctx=Load()),
                          ops=[
                            LtE(),
                            LtE()],
                          comparators=[
                            Name(id='comp_words', ctx=Load()),
                            Name(id='max_comp_words', ctx=Load())])),
                      body=[
                        Assign(
                          targets=[
                            Name(id='components_valid', ctx=Store())],
                          value=Constant(value=False))])])])]),
        Assign(
          targets=[
            Name(id='passed', ctx=Store())],
          value=BoolOp(
            op=And(),
            values=[
              Name(id='char_valid', ctx=Load()),
              Name(id='word_count_valid', ctx=Load()),
              Name(id='components_valid', ctx=Load())])),
        Assign(
          targets=[
            Name(id='issues', ctx=Store())],
          value=List(ctx=Load())),
        If(
          test=UnaryOp(
            op=Not(),
            operand=Name(id='char_valid', ctx=Load())),
          body=[
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='issues', ctx=Load()),
                  attr='append',
                  ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='chars: '),
                      FormattedValue(
                        value=Name(id='char_count', ctx=Load()),
                        conversion=-1),
                      Constant(value=' (need '),
                      FormattedValue(
                        value=Subscript(
                          value=Name(id='constraints', ctx=Load()),
                          slice=Constant(value='min_chars'),
