                        conversion=-1),
                      Constant(value='-'),
                      FormattedValue(
                        value=Subscript(
                          value=Name(id='constraints', ctx=Load()),
                          slice=Constant(value='max_chars'),
                          ctx=Load()),
                        conversion=-1),
                      Constant(value=')')])]))]),
        If(
          test=UnaryOp(
            op=Not(),
            operand=Name(id='word_count_valid', ctx=Load())),
          body=[
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='issues', ctx=Load()),
                  attr='append',
                  ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='words: '),
                      FormattedValue(
                        value=Name(id='word_count', ctx=Load()),
                        conversion=-1),
                      Constant(value=' (need '),
                      FormattedValue(
                        value=Subscript(
                          value=Subscript(
                            value=Name(id='constraints', ctx=Load()),
                            slice=Constant(value='word_count'),
                            ctx=Load()),
                          slice=Constant(value=0),
                          ctx=Load()),
                        conversion=-1),
                      Constant(value='-'),
                      FormattedValue(
                        value=Subscript(
                          value=Subscript(
                            value=Name(id='constraints', ctx=Load()),
                            slice=Constant(value='word_count'),
                            ctx=Load()),
                          slice=Constant(value=1),
                          ctx=Load()),
                        conversion=-1),
                      Constant(value=')')])]))]),
        If(
          test=UnaryOp(
            op=Not(),
            operand=Name(id='components_valid', ctx=Load())),
          body=[
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='issues', ctx=Load()),
                  attr='append',
                  ctx=Load()),
                args=[
                  Constant(value='X|Y|Z components must be 2-4 words each')]))]),
        Assign(
          targets=[
            Name(id='message', ctx=Store())],
          value=JoinedStr(
            values=[
              Constant(value='Headline: '),
              FormattedValue(
                value=Name(id='char_count', ctx=Load()),
                conversion=-1),
              Constant(value=' chars, '),
              FormattedValue(
                value=Name(id='word_count', ctx=Load()),
                conversion=-1),
              Constant(value=' words')])),
        If(
          test=Name(id='issues', ctx=Load()),
          body=[
            AugAssign(
              target=Name(id='message', ctx=Store()),
              op=Add(),
              value=JoinedStr(
                values=[
                  Constant(value=' - Issues: '),
                  FormattedValue(
                    value=Call(
                      func=Attribute(
                        value=Constant(value=', '),
                        attr='join',
                        ctx=Load()),
                      args=[
                        Name(id='issues', ctx=Load())]),
                    conversion=-1)]))]),
        Return(
          value=Call(
            func=Name(id='ValidationResult', ctx=Load()),
            keywords=[
              keyword(
                arg='rule_id',
                value=Constant(value='HEADLINE_CONSTRAINTS')),
              keyword(
                arg='passed',
                value=Name(id='passed', ctx=Load())),
              keyword(
                arg='severity',
                value=Attribute(
                  value=Name(id='ValidationSeverity', ctx=Load()),
                  attr='HIGH',
                  ctx=Load())),
              keyword(
