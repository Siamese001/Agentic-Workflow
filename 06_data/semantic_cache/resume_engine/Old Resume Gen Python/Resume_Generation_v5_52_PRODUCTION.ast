                                values=[
                                  Constant(value='⛔ BLOCKED: Invalid provenance category: '),
                                  FormattedValue(
                                    value=Name(id='marker', ctx=Load()),
                                    conversion=-1)])]))])])]),
            If(
              test=Compare(
                left=Constant(value='| API Call Verified |'),
                ops=[
                  In()],
                comparators=[
                  Name(id='output', ctx=Load())]),
              body=[
                If(
                  test=BoolOp(
                    op=Or(),
                    values=[
                      Compare(
                        left=Constant(value='⛔ No'),
                        ops=[
                          In()],
                        comparators=[
                          Name(id='output', ctx=Load())]),
