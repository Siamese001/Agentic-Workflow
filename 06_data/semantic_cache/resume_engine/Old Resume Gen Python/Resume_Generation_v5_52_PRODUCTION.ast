                      value=Name(id='metrics', ctx=Load()),
                      attr='extend',
                      ctx=Load()),
                    args=[
                      Name(id='matches', ctx=Load())]))]),
            Return(
              value=Name(id='metrics', ctx=Load()))],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load()))]),
    ClassDef(
      name='HallucinationDetector',
      body=[
        Expr(
          value=Constant(value='\n    Detect potential hallucinations in resume content.\n    Flags implausible metrics, temporal inconsistencies, etc.\n    ')),
        FunctionDef(
          name='detect',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='bullet_pool',
                annotation=Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Name(id='Dict', ctx=Load()),
                  ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Run hallucination detection on bullet pool.\n        Returns: List of validation results\n        ')),
            Assign(
              targets=[
                Name(id='results', ctx=Store())],
              value=List(ctx=Load())),
            For(
              target=Tuple(
                elts=[
                  Name(id='i', ctx=Store()),
                  Name(id='bullet', ctx=Store())],
                ctx=Store()),
              iter=Call(
                func=Name(id='enumerate', ctx=Load()),
                args=[
                  Name(id='bullet_pool', ctx=Load())]),
              body=[
                Assign(
                  targets=[
                    Name(id='text', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='bullet', ctx=Load()),
                      attr='get',
                      ctx=Load()),
                    args=[
                      Constant(value='bullet_text'),
                      Constant(value='')])),
                If(
                  test=Call(
                    func=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='_has_implausible_growth',
                      ctx=Load()),
                    args=[
                      Name(id='text', ctx=Load())]),
                  body=[
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Name(id='results', ctx=Load()),
                          attr='append',
                          ctx=Load()),
                        args=[
                          Call(
                            func=Name(id='ValidationResult', ctx=Load()),
                            keywords=[
                              keyword(
                                arg='rule_id',
                                value=Constant(value='HALLUCINATION_IMPLAUSIBLE_GROWTH')),
                              keyword(
                                arg='passed',
                                value=Constant(value=False)),
                              keyword(
                                arg='severity',
                                value=Attribute(
                                  value=Name(id='ValidationSeverity', ctx=Load()),
                                  attr='HIGH',
                                  ctx=Load())),
                              keyword(
                                arg='message',
                                value=JoinedStr(
                                  values=[
                                    Constant(value='Bullet '),
                                    FormattedValue(
                                      value=BinOp(
                                        left=Name(id='i', ctx=Load()),
                                        op=Add(),
                                        right=Constant(value=1)),
                                      conversion=-1),
                                    Constant(value=' may contain implausible growth rate')])),
                              keyword(
                                arg='details',
                                value=Dict(
                                  keys=[
                                    Constant(value='bullet_text')],
                                  values=[
                                    Subscript(
                                      value=Name(id='text', ctx=Load()),
                                      slice=Slice(
                                        upper=Constant(value=100)),
                                      ctx=Load())]))])]))]),
                If(
                  test=Call(
                    func=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='_has_excessive_superlatives',
                      ctx=Load()),
                    args=[
                      Name(id='text', ctx=Load())]),
                  body=[
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Name(id='results', ctx=Load()),
                          attr='append',
                          ctx=Load()),
                        args=[
                          Call(
                            func=Name(id='ValidationResult', ctx=Load()),
                            keywords=[
                              keyword(
                                arg='rule_id',
                                value=Constant(value='HALLUCINATION_EXCESSIVE_SUPERLATIVES')),
                              keyword(
                                arg='passed',
                                value=Constant(value=False)),
                              keyword(
                                arg='severity',
                                value=Attribute(
                                  value=Name(id='ValidationSeverity', ctx=Load()),
                                  attr='MEDIUM',
                                  ctx=Load())),
                              keyword(
                                arg='message',
                                value=JoinedStr(
                                  values=[
                                    Constant(value='Bullet '),
                                    FormattedValue(
                                      value=BinOp(
                                        left=Name(id='i', ctx=Load()),
                                        op=Add(),
                                        right=Constant(value=1)),
                                      conversion=-1),
                                    Constant(value=' contains excessive superlatives')])),
                              keyword(
                                arg='details',
                                value=Dict(
                                  keys=[
                                    Constant(value='bullet_text')],
                                  values=[
                                    Subscript(
                                      value=Name(id='text', ctx=Load()),
                                      slice=Slice(
                                        upper=Constant(value=100)),
                                      ctx=Load())]))])]))])]),
            If(
              test=UnaryOp(
                op=Not(),
                operand=Name(id='results', ctx=Load())),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='results', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Call(
                        func=Name(id='ValidationResult', ctx=Load()),
                        keywords=[
                          keyword(
                            arg='rule_id',
                            value=Constant(value='HALLUCINATION_CHECK')),
                          keyword(
                            arg='passed',
                            value=Constant(value=True)),
                          keyword(
                            arg='severity',
                            value=Attribute(
                              value=Name(id='ValidationSeverity', ctx=Load()),
                              attr='INFO',
                              ctx=Load())),
                          keyword(
                            arg='message',
                            value=JoinedStr(
                              values=[
                                Constant(value='No hallucinations detected in '),
                                FormattedValue(
                                  value=Call(
                                    func=Name(id='len', ctx=Load()),
                                    args=[
                                      Name(id='bullet_pool', ctx=Load())]),
                                  conversion=-1),
                                Constant(value=' bullets')]))])]))]),
            Return(
              value=Name(id='results', ctx=Load()))],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='ValidationResult', ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='_has_implausible_growth',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='text',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Check for implausibly high growth rates (>10x in short time).')),
            Assign(
              targets=[
                Name(id='growth_patterns', ctx=Store())],
              value=List(
                elts=[
                  Constant(value='\\d{3,}%'),
                  Constant(value='\\d+x')],
                ctx=Load())),
            For(
              target=Name(id='pattern', ctx=Store()),
              iter=Name(id='growth_patterns', ctx=Load()),
              body=[
                If(
                  test=Call(
                    func=Attribute(
                      value=Name(id='re', ctx=Load()),
                      attr='search',
                      ctx=Load()),
                    args=[
                      Name(id='pattern', ctx=Load()),
                      Name(id='text', ctx=Load())]),
                  body=[
                    If(
                      test=Call(
                        func=Name(id='any', ctx=Load()),
                        args=[
                          GeneratorExp(
                            elt=Compare(
                              left=Name(id='term', ctx=Load()),
                              ops=[
                                In()],
                              comparators=[
                                Call(
                                  func=Attribute(
                                    value=Name(id='text', ctx=Load()),
                                    attr='lower',
                                    ctx=Load()))]),
                            generators=[
                              comprehension(
                                target=Name(id='term', ctx=Store()),
                                iter=List(
                                  elts=[
                                    Constant(value='month'),
                                    Constant(value='quarter'),
                                    Constant(value='90 day')],
                                  ctx=Load()),
                                is_async=0)])]),
                      body=[
                        Return(
                          value=Constant(value=True))])])]),
            Return(
              value=Constant(value=False))],
          returns=Name(id='bool', ctx=Load())),
        FunctionDef(
          name='_has_excessive_superlatives',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='text',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Check for excessive use of superlatives.')),
            Assign(
              targets=[
                Name(id='superlatives', ctx=Store())],
              value=List(
                elts=[
                  Constant(value='revolutionary'),
                  Constant(value='groundbreaking'),
                  Constant(value='unprecedented'),
                  Constant(value='unparalleled'),
                  Constant(value='game-changing'),
                  Constant(value='world-class'),
                  Constant(value='best-in-class'),
                  Constant(value='cutting-edge')],
                ctx=Load())),
            Assign(
              targets=[
                Name(id='count', ctx=Store())],
              value=Call(
                func=Name(id='sum', ctx=Load()),
                args=[
                  GeneratorExp(
                    elt=Constant(value=1),
                    generators=[
                      comprehension(
                        target=Name(id='word', ctx=Store()),
                        iter=Name(id='superlatives', ctx=Load()),
                        ifs=[
                          Compare(
                            left=Name(id='word', ctx=Load()),
                            ops=[
                              In()],
                            comparators=[
                              Call(
                                func=Attribute(
                                  value=Name(id='text', ctx=Load()),
                                  attr='lower',
                                  ctx=Load()))])],
                        is_async=0)])])),
            Return(
              value=Compare(
                left=Name(id='count', ctx=Load()),
                ops=[
                  GtE()],
                comparators=[
                  Constant(value=2)]))],
          returns=Name(id='bool', ctx=Load()))]),
    ClassDef(
      name='DataEnricher',
      body=[
        Expr(
          value=Constant(value='\n    HOP-2: Enrich bullet pool with canonical verbs, deduplication, etc.\n    ')),
        FunctionDef(
          name='__init__',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='verb_canonicalizer',
                  ctx=Store())],
              value=Call(
                func=Name(id='VerbCanonicalizer', ctx=Load()))),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='duplicate_detector',
                  ctx=Store())],
              value=Call(
                func=Name(id='DuplicateDetector', ctx=Load())))]),
        FunctionDef(
          name='enrich',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='extracted_data',
                annotation=Name(id='Dict', ctx=Load())),
              arg(
                arg='thematic_analysis',
                annotation=Name(id='ThematicAnalysis', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Enrich extracted data with additional metadata.\n        v5.36: Updated to work with experience_sections structure.\n        Returns: (enriched_data, validation_results)\n        ')),
            Assign(
              targets=[
                Name(id='validation_results', ctx=Store())],
              value=List(ctx=Load())),
            Assign(
              targets=[
                Name(id='experience_sections', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='extracted_data', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='experience_sections'),
                  List(ctx=Load())])),
            Assign(
              targets=[
                Name(id='all_bullets', ctx=Store())],
              value=List(ctx=Load())),
            For(
              target=Name(id='section', ctx=Store()),
              iter=Name(id='experience_sections', ctx=Load()),
              body=[
                For(
                  target=Name(id='bullet', ctx=Store()),
                  iter=Call(
                    func=Attribute(
                      value=Name(id='section', ctx=Load()),
                      attr='get',
                      ctx=Load()),
                    args=[
                      Constant(value='bullets'),
                      List(ctx=Load())]),
                  body=[
                    Assign(
                      targets=[
                        Name(id='canonical_verbs', ctx=Store())],
                      value=Call(
                        func=Attribute(
                          value=Attribute(
                            value=Name(id='self', ctx=Load()),
                            attr='verb_canonicalizer',
                            ctx=Load()),
                          attr='canonicalize',
                          ctx=Load()),
                        args=[
                          Call(
                            func=Attribute(
                              value=Name(id='bullet', ctx=Load()),
                              attr='get',
                              ctx=Load()),
                            args=[
                              Constant(value='bullet_text'),
                              Constant(value='')])])),
                    Assign(
                      targets=[
                        Subscript(
                          value=Name(id='bullet', ctx=Load()),
                          slice=Constant(value='canonical_verbs'),
                          ctx=Store())],
                      value=Name(id='canonical_verbs', ctx=Load())),
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Name(id='all_bullets', ctx=Load()),
                          attr='append',
                          ctx=Load()),
                        args=[
                          Name(id='bullet', ctx=Load())]))])]),
            Assign(
              targets=[
                Name(id='duplicates', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='duplicate_detector',
                    ctx=Load()),
                  attr='find_duplicates',
                  ctx=Load()),
                args=[
                  Name(id='all_bullets', ctx=Load())])),
            If(
              test=Name(id='duplicates', ctx=Load()),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='validation_results', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Call(
                        func=Name(id='ValidationResult', ctx=Load()),
                        keywords=[
                          keyword(
                            arg='rule_id',
                            value=Constant(value='DUPLICATE_BULLETS')),
                          keyword(
                            arg='passed',
                            value=Constant(value=False)),
                          keyword(
                            arg='severity',
                            value=Attribute(
                              value=Name(id='ValidationSeverity', ctx=Load()),
                              attr='MEDIUM',
                              ctx=Load())),
                          keyword(
                            arg='message',
                            value=JoinedStr(
                              values=[
                                Constant(value='Found '),
                                FormattedValue(
                                  value=Call(
                                    func=Name(id='len', ctx=Load()),
                                    args=[
                                      Name(id='duplicates', ctx=Load())]),
                                  conversion=-1),
                                Constant(value=' potential duplicate bullets')])),
                          keyword(
                            arg='details',
                            value=Dict(
                              keys=[
                                Constant(value='duplicates')],
                              values=[
                                Subscript(
                                  value=Name(id='duplicates', ctx=Load()),
                                  slice=Slice(
                                    upper=Constant(value=5)),
                                  ctx=Load())]))])]))],
              orelse=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='validation_results', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Call(
                        func=Name(id='ValidationResult', ctx=Load()),
                        keywords=[
                          keyword(
                            arg='rule_id',
                            value=Constant(value='DUPLICATE_CHECK')),
                          keyword(
                            arg='passed',
                            value=Constant(value=True)),
                          keyword(
                            arg='severity',
                            value=Attribute(
                              value=Name(id='ValidationSeverity', ctx=Load()),
                              attr='INFO',
                              ctx=Load())),
                          keyword(
                            arg='message',
                            value=Constant(value='No duplicate bullets detected'))])]))]),
            Assign(
              targets=[
                Name(id='enriched_data', ctx=Store())],
              value=Dict(
                keys=[
                  None,
                  Constant(value='experience_sections')],
                values=[
                  Name(id='extracted_data', ctx=Load()),
                  Name(id='experience_sections', ctx=Load())])),
            Return(
              value=Tuple(
                elts=[
                  Name(id='enriched_data', ctx=Load()),
                  Name(id='validation_results', ctx=Load())],
                ctx=Load()))],
          returns=Subscript(
            value=Name(id='Tuple', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='Dict', ctx=Load()),
                Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Name(id='ValidationResult', ctx=Load()),
                  ctx=Load())],
              ctx=Load()),
            ctx=Load()))]),
    ClassDef(
      name='VerbCanonicalizer',
      body=[
        Expr(
          value=Constant(value='Canonicalize action verbs to approved list.')),
        Assign(
          targets=[
            Name(id='CANONICAL_VERBS', ctx=Store())],
          value=Dict(
            keys=[
              Constant(value='led'),
              Constant(value='built'),
              Constant(value='drove'),
              Constant(value='launched'),
              Constant(value='scaled'),
              Constant(value='delivered'),
              Constant(value='achieved'),
              Constant(value='established'),
              Constant(value='managed'),
              Constant(value='developed')],
            values=[
              List(
                elts=[
                  Constant(value='led'),
                  Constant(value='lead'),
                  Constant(value='leading')],
                ctx=Load()),
              List(
                elts=[
                  Constant(value='built'),
                  Constant(value='build'),
                  Constant(value='building')],
                ctx=Load()),
              List(
                elts=[
                  Constant(value='drove'),
                  Constant(value='drive'),
                  Constant(value='driving')],
                ctx=Load()),
              List(
                elts=[
                  Constant(value='launched'),
                  Constant(value='launch'),
                  Constant(value='launching')],
                ctx=Load()),
              List(
                elts=[
                  Constant(value='scaled'),
                  Constant(value='scale'),
                  Constant(value='scaling')],
                ctx=Load()),
              List(
                elts=[
                  Constant(value='delivered'),
                  Constant(value='deliver'),
                  Constant(value='delivering')],
                ctx=Load()),
              List(
                elts=[
                  Constant(value='achieved'),
                  Constant(value='achieve'),
                  Constant(value='achieving')],
                ctx=Load()),
              List(
                elts=[
                  Constant(value='established'),
                  Constant(value='establish'),
                  Constant(value='establishing')],
                ctx=Load()),
              List(
                elts=[
                  Constant(value='managed'),
                  Constant(value='manage'),
                  Constant(value='managing')],
                ctx=Load()),
              List(
                elts=[
                  Constant(value='developed'),
                  Constant(value='develop'),
                  Constant(value='developing')],
                ctx=Load())])),
        Assign(
          targets=[
            Name(id='FORBIDDEN_VERBS', ctx=Store())],
          value=List(
            elts=[
              Constant(value='pioneered'),
              Constant(value='spearheaded'),
              Constant(value='orchestrated'),
              Constant(value='architected'),
              Constant(value='revolutionized'),
              Constant(value='transformed')],
            ctx=Load())),
        FunctionDef(
          name='canonicalize',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='text',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Extract and canonicalize verbs from text.')),
            Assign(
              targets=[
                Name(id='canonical', ctx=Store())],
              value=List(ctx=Load())),
            Assign(
              targets=[
                Name(id='text_lower', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='text', ctx=Load()),
                  attr='lower',
                  ctx=Load()))),
            For(
              target=Tuple(
                elts=[
                  Name(id='canonical_form', ctx=Store()),
                  Name(id='variants', ctx=Store())],
                ctx=Store()),
              iter=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='CANONICAL_VERBS',
                    ctx=Load()),
                  attr='items',
                  ctx=Load())),
              body=[
                If(
                  test=Call(
                    func=Name(id='any', ctx=Load()),
                    args=[
                      GeneratorExp(
                        elt=Compare(
                          left=Name(id='variant', ctx=Load()),
                          ops=[
                            In()],
                          comparators=[
                            Name(id='text_lower', ctx=Load())]),
                        generators=[
                          comprehension(
                            target=Name(id='variant', ctx=Store()),
                            iter=Name(id='variants', ctx=Load()),
                            is_async=0)])]),
                  body=[
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Name(id='canonical', ctx=Load()),
                          attr='append',
                          ctx=Load()),
                        args=[
                          Name(id='canonical_form', ctx=Load())]))])]),
            Return(
              value=Name(id='canonical', ctx=Load()))],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load()))]),
    ClassDef(
      name='DuplicateDetector',
      body=[
        Expr(
          value=Constant(value='Detect duplicate or near-duplicate bullets using TF-IDF cosine similarity.')),
        FunctionDef(
          name='find_duplicates',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='bullets',
                annotation=Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Name(id='Dict', ctx=Load()),
                  ctx=Load())),
              arg(
                arg='threshold',
                annotation=Name(id='float', ctx=Load()))],
            defaults=[
              Constant(value=0.9)]),
          body=[
            Expr(
              value=Constant(value='\n        Find bullets with cosine similarity >= threshold.\n        Returns: List of (index1, index2, similarity_score)\n        ')),
            Assign(
              targets=[
                Name(id='duplicates', ctx=Store())],
              value=List(ctx=Load())),
            For(
              target=Name(id='i', ctx=Store()),
              iter=Call(
                func=Name(id='range', ctx=Load()),
                args=[
                  Call(
                    func=Name(id='len', ctx=Load()),
                    args=[
                      Name(id='bullets', ctx=Load())])]),
              body=[
                For(
                  target=Name(id='j', ctx=Store()),
                  iter=Call(
                    func=Name(id='range', ctx=Load()),
                    args=[
                      BinOp(
                        left=Name(id='i', ctx=Load()),
                        op=Add(),
                        right=Constant(value=1)),
                      Call(
                        func=Name(id='len', ctx=Load()),
                        args=[
                          Name(id='bullets', ctx=Load())])]),
                  body=[
                    Assign(
                      targets=[
                        Name(id='similarity', ctx=Store())],
                      value=Call(
                        func=Attribute(
                          value=Name(id='self', ctx=Load()),
                          attr='_calculate_cosine_similarity',
                          ctx=Load()),
                        args=[
                          Call(
                            func=Attribute(
                              value=Subscript(
                                value=Name(id='bullets', ctx=Load()),
                                slice=Name(id='i', ctx=Load()),
                                ctx=Load()),
                              attr='get',
                              ctx=Load()),
                            args=[
                              Constant(value='bullet_text'),
                              Constant(value='')]),
                          Call(
                            func=Attribute(
                              value=Subscript(
                                value=Name(id='bullets', ctx=Load()),
                                slice=Name(id='j', ctx=Load()),
                                ctx=Load()),
                              attr='get',
                              ctx=Load()),
                            args=[
                              Constant(value='bullet_text'),
                              Constant(value='')])])),
                    If(
