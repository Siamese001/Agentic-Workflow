    ClassDef(
      name='GateDecisionEngine',
      body=[
        Expr(
          value=Constant(value='\n    HOP-7: Gate decision logic.\n    Determines whether to PROCEED, ERROR_REPORT_ONLY, or HALT.\n    ')),
        FunctionDef(
          name='decide',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='validation_results',
                annotation=Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Name(id='ValidationResult', ctx=Load()),
                  ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Make gate decision based on validation results.\n        \n        Returns:\n            (decision, reason)\n        ')),
            Assign(
              targets=[
                Name(id='critical_failures', ctx=Store())],
              value=ListComp(
                elt=Name(id='vr', ctx=Load()),
                generators=[
                  comprehension(
                    target=Name(id='vr', ctx=Store()),
                    iter=Name(id='validation_results', ctx=Load()),
                    ifs=[
                      BoolOp(
                        op=And(),
                        values=[
                          UnaryOp(
                            op=Not(),
                            operand=Attribute(
                              value=Name(id='vr', ctx=Load()),
                              attr='passed',
                              ctx=Load())),
                          Compare(
                            left=Attribute(
                              value=Name(id='vr', ctx=Load()),
                              attr='severity',
                              ctx=Load()),
                            ops=[
                              Eq()],
                            comparators=[
                              Attribute(
                                value=Name(id='ValidationSeverity', ctx=Load()),
                                attr='CRITICAL',
                                ctx=Load())])])],
                    is_async=0)])),
            Assign(
              targets=[
                Name(id='high_failures', ctx=Store())],
              value=ListComp(
                elt=Name(id='vr', ctx=Load()),
                generators=[
                  comprehension(
                    target=Name(id='vr', ctx=Store()),
                    iter=Name(id='validation_results', ctx=Load()),
                    ifs=[
                      BoolOp(
                        op=And(),
                        values=[
                          UnaryOp(
                            op=Not(),
                            operand=Attribute(
                              value=Name(id='vr', ctx=Load()),
                              attr='passed',
                              ctx=Load())),
                          Compare(
                            left=Attribute(
                              value=Name(id='vr', ctx=Load()),
                              attr='severity',
                              ctx=Load()),
                            ops=[
                              Eq()],
                            comparators=[
                              Attribute(
                                value=Name(id='ValidationSeverity', ctx=Load()),
                                attr='HIGH',
                                ctx=Load())])])],
                    is_async=0)])),
            If(
              test=Compare(
                left=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Name(id='critical_failures', ctx=Load())]),
                ops=[
                  Gt()],
                comparators=[
                  Constant(value=0)]),
              body=[
                Return(
                  value=Tuple(
                    elts=[
                      Attribute(
                        value=Name(id='GateDecision', ctx=Load()),
                        attr='HALT',
                        ctx=Load()),
                      JoinedStr(
                        values=[
                          Constant(value='HALT: '),
                          FormattedValue(
                            value=Call(
                              func=Name(id='len', ctx=Load()),
                              args=[
                                Name(id='critical_failures', ctx=Load())]),
                            conversion=-1),
                          Constant(value=' CRITICAL failures detected')])],
                    ctx=Load()))],
              orelse=[
                If(
                  test=Compare(
                    left=Call(
                      func=Name(id='len', ctx=Load()),
                      args=[
                        Name(id='high_failures', ctx=Load())]),
                    ops=[
                      Gt()],
                    comparators=[
                      Constant(value=3)]),
                  body=[
                    Return(
                      value=Tuple(
                        elts=[
                          Attribute(
                            value=Name(id='GateDecision', ctx=Load()),
                            attr='ERROR_REPORT_ONLY',
                            ctx=Load()),
                          JoinedStr(
                            values=[
                              Constant(value='ERROR_REPORT_ONLY: '),
                              FormattedValue(
                                value=Call(
                                  func=Name(id='len', ctx=Load()),
                                  args=[
                                    Name(id='high_failures', ctx=Load())]),
                                conversion=-1),
                              Constant(value=' HIGH failures (threshold: 3)')])],
                        ctx=Load()))],
                  orelse=[
                    If(
                      test=Compare(
                        left=Call(
                          func=Name(id='len', ctx=Load()),
                          args=[
                            Name(id='high_failures', ctx=Load())]),
                        ops=[
                          Gt()],
                        comparators=[
                          Constant(value=0)]),
                      body=[
                        Return(
                          value=Tuple(
                            elts=[
                              Attribute(
                                value=Name(id='GateDecision', ctx=Load()),
                                attr='ERROR_REPORT_ONLY',
                                ctx=Load()),
                              JoinedStr(
                                values=[
                                  Constant(value='ERROR_REPORT_ONLY: '),
                                  FormattedValue(
                                    value=Call(
                                      func=Name(id='len', ctx=Load()),
                                      args=[
                                        Name(id='high_failures', ctx=Load())]),
                                    conversion=-1),
                                  Constant(value=' HIGH failures (tolerable)')])],
                            ctx=Load()))],
                      orelse=[
                        Return(
                          value=Tuple(
                            elts=[
                              Attribute(
                                value=Name(id='GateDecision', ctx=Load()),
                                attr='PROCEED',
                                ctx=Load()),
                              Constant(value='PROCEED: All validations passed')],
                            ctx=Load()))])])])],
          returns=Subscript(
            value=Name(id='Tuple', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='GateDecision', ctx=Load()),
                Name(id='str', ctx=Load())],
              ctx=Load()),
            ctx=Load()))]),
