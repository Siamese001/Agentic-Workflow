                    None],
                  values=[
                    Name(id='char_count', ctx=Load()),
                    Name(id='word_count', ctx=Load()),
                    Name(id='component_details', ctx=Load())]))]))],
      returns=Name(id='ValidationResult', ctx=Load())),
    FunctionDef(
      name='validate_overview_tolerance_v521',
      args=arguments(
        args=[
          arg(
            arg='tailored_overview',
            annotation=Name(id='str', ctx=Load())),
          arg(
