            func=Name(id='count_words_clean', ctx=Load()),
            args=[
              Name(id='headline', ctx=Load())])),
        Assign(
          targets=[
            Name(id='constraints', ctx=Store())],
          value=Subscript(
            value=Name(id='SECTION_CONSTRAINTS_V521', ctx=Load()),
            slice=Constant(value='headline'),
