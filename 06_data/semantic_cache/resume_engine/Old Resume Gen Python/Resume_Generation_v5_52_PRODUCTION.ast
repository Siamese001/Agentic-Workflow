    ClassDef(
      name='JDAlignmentScorer',
      body=[
        Expr(
          value=Constant(value='\n    v5.35: Score skills and competencies by JD alignment.\n    Used to order skills 1-12 and competencies 1-6 by relevance to JD.\n    ')),
        FunctionDef(
          name='__init__',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='job_description',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='parsed_jd',
                annotation=Name(id='Dict', ctx=Load()))]),
          body=[
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='jd_text',
                  ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='job_description', ctx=Load()),
                  attr='lower',
                  ctx=Load()))),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='jd_keywords',
                  ctx=Store())],
              value=Call(
                func=Name(id='set', ctx=Load()),
                args=[
                  Call(
                    func=Attribute(
                      value=Name(id='parsed_jd', ctx=Load()),
                      attr='get',
                      ctx=Load()),
                    args=[
                      Constant(value='required_skills'),
                      List(ctx=Load())])])),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='jd_requirements',
                  ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='parsed_jd', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='requirements'),
                  List(ctx=Load())]))]),
        FunctionDef(
          name='score_skill',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='skill',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Score a single skill by JD alignment (0.0 to 1.0).\n        Higher score = more aligned with JD.\n        ')),
            Assign(
              targets=[
                Name(id='score', ctx=Store())],
              value=Constant(value=0.0)),
            Assign(
              targets=[
                Name(id='skill_lower', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='skill', ctx=Load()),
                  attr='lower',
                  ctx=Load()))),
            If(
              test=Compare(
                left=Name(id='skill_lower', ctx=Load()),
                ops=[
                  In()],
                comparators=[
                  Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='jd_text',
                    ctx=Load())]),
              body=[
                AugAssign(
                  target=Name(id='score', ctx=Store()),
                  op=Add(),
                  value=Constant(value=0.5))]),
            Assign(
              targets=[
                Name(id='skill_words', ctx=Store())],
              value=Call(
                func=Name(id='set', ctx=Load()),
                args=[
                  Call(
                    func=Attribute(
                      value=Name(id='skill_lower', ctx=Load()),
                      attr='split',
                      ctx=Load()))])),
            Assign(
              targets=[
                Name(id='keyword_overlap', ctx=Store())],
              value=Call(
                func=Name(id='len', ctx=Load()),
                args=[
                  BinOp(
                    left=Name(id='skill_words', ctx=Load()),
                    op=BitAnd(),
                    right=SetComp(
                      elt=Call(
                        func=Attribute(
                          value=Name(id='kw', ctx=Load()),
                          attr='lower',
                          ctx=Load())),
                      generators=[
                        comprehension(
                          target=Name(id='kw', ctx=Store()),
                          iter=Attribute(
                            value=Name(id='self', ctx=Load()),
                            attr='jd_keywords',
                            ctx=Load()),
                          is_async=0)]))])),
            AugAssign(
              target=Name(id='score', ctx=Store()),
              op=Add(),
              value=Call(
                func=Name(id='min', ctx=Load()),
                args=[
                  BinOp(
                    left=Name(id='keyword_overlap', ctx=Load()),
                    op=Mult(),
                    right=Constant(value=0.2)),
                  Constant(value=0.3)])),
            For(
              target=Name(id='req', ctx=Store()),
              iter=Attribute(
                value=Name(id='self', ctx=Load()),
                attr='jd_requirements',
                ctx=Load()),
              body=[
                If(
                  test=Compare(
                    left=Name(id='skill_lower', ctx=Load()),
                    ops=[
                      In()],
                    comparators=[
                      Call(
                        func=Attribute(
                          value=Name(id='req', ctx=Load()),
                          attr='lower',
                          ctx=Load()))]),
                  body=[
                    AugAssign(
                      target=Name(id='score', ctx=Store()),
                      op=Add(),
                      value=Constant(value=0.2)),
                    Break()])]),
            Return(
              value=Call(
                func=Name(id='min', ctx=Load()),
                args=[
                  Name(id='score', ctx=Load()),
                  Constant(value=1.0)]))],
          returns=Name(id='float', ctx=Load())),
        FunctionDef(
          name='score_competency',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='competency',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Score a competency bullet by JD alignment (0.0 to 1.0).\n        ')),
            Assign(
              targets=[
                Name(id='score', ctx=Store())],
              value=Constant(value=0.0)),
            Assign(
              targets=[
                Name(id='comp_lower', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='competency', ctx=Load()),
                  attr='lower',
                  ctx=Load()))),
            Assign(
              targets=[
                Name(id='comp_words', ctx=Store())],
              value=Call(
                func=Name(id='set', ctx=Load()),
                args=[
                  Call(
                    func=Attribute(
                      value=Name(id='comp_lower', ctx=Load()),
                      attr='split',
                      ctx=Load()))])),
            Assign(
              targets=[
                Name(id='keyword_matches', ctx=Store())],
              value=Call(
                func=Name(id='sum', ctx=Load()),
                args=[
                  GeneratorExp(
                    elt=Constant(value=1),
                    generators=[
                      comprehension(
                        target=Name(id='kw', ctx=Store()),
                        iter=Attribute(
                          value=Name(id='self', ctx=Load()),
                          attr='jd_keywords',
                          ctx=Load()),
                        ifs=[
                          Compare(
                            left=Call(
                              func=Attribute(
                                value=Name(id='kw', ctx=Load()),
                                attr='lower',
                                ctx=Load())),
                            ops=[
                              In()],
                            comparators=[
                              Name(id='comp_lower', ctx=Load())])],
                        is_async=0)])])),
            AugAssign(
              target=Name(id='score', ctx=Store()),
              op=Add(),
              value=Call(
                func=Name(id='min', ctx=Load()),
                args=[
                  BinOp(
                    left=Name(id='keyword_matches', ctx=Load()),
                    op=Mult(),
                    right=Constant(value=0.15)),
                  Constant(value=0.5)])),
            Assign(
              targets=[
                Name(id='theme_keywords', ctx=Store())],
              value=List(
                elts=[
                  Constant(value='transform'),
                  Constant(value='lead'),
                  Constant(value='drive'),
                  Constant(value='scale'),
                  Constant(value='deliver'),
                  Constant(value='strategy')],
                ctx=Load())),
            Assign(
              targets=[
                Name(id='theme_matches', ctx=Store())],
              value=Call(
                func=Name(id='sum', ctx=Load()),
                args=[
                  GeneratorExp(
                    elt=Constant(value=1),
                    generators=[
                      comprehension(
                        target=Name(id='kw', ctx=Store()),
                        iter=Name(id='theme_keywords', ctx=Load()),
                        ifs=[
                          Compare(
                            left=Name(id='kw', ctx=Load()),
                            ops=[
                              In()],
                            comparators=[
                              Name(id='comp_lower', ctx=Load())])],
                        is_async=0)])])),
            AugAssign(
              target=Name(id='score', ctx=Store()),
              op=Add(),
              value=Call(
                func=Name(id='min', ctx=Load()),
                args=[
                  BinOp(
                    left=Name(id='theme_matches', ctx=Load()),
                    op=Mult(),
                    right=Constant(value=0.1)),
                  Constant(value=0.3)])),
            For(
              target=Name(id='req', ctx=Store()),
              iter=Attribute(
                value=Name(id='self', ctx=Load()),
                attr='jd_requirements',
                ctx=Load()),
              body=[
                Assign(
                  targets=[
                    Name(id='req_words', ctx=Store())],
                  value=Call(
                    func=Name(id='set', ctx=Load()),
                    args=[
                      Call(
                        func=Attribute(
                          value=Call(
                            func=Attribute(
                              value=Name(id='req', ctx=Load()),
                              attr='lower',
                              ctx=Load())),
                          attr='split',
                          ctx=Load()))])),
                Assign(
                  targets=[
                    Name(id='overlap', ctx=Store())],
                  value=Call(
                    func=Name(id='len', ctx=Load()),
                    args=[
                      BinOp(
                        left=Name(id='comp_words', ctx=Load()),
                        op=BitAnd(),
                        right=Name(id='req_words', ctx=Load()))])),
                If(
                  test=Compare(
                    left=Name(id='overlap', ctx=Load()),
                    ops=[
                      GtE()],
                    comparators=[
                      Constant(value=3)]),
                  body=[
                    AugAssign(
                      target=Name(id='score', ctx=Store()),
                      op=Add(),
                      value=Constant(value=0.2)),
                    Break()])]),
            Return(
              value=Call(
                func=Name(id='min', ctx=Load()),
                args=[
                  Name(id='score', ctx=Load()),
                  Constant(value=1.0)]))],
          returns=Name(id='float', ctx=Load())),
        FunctionDef(
          name='order_skills',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='skills',
                annotation=Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Name(id='str', ctx=Load()),
                  ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Order skills by JD alignment score.\n        Returns: List of (skill, score) tuples, sorted by score descending.\n        ')),
            Assign(
              targets=[
                Name(id='scored_skills', ctx=Store())],
              value=ListComp(
                elt=Tuple(
                  elts=[
                    Name(id='skill', ctx=Load()),
                    Call(
                      func=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='score_skill',
                        ctx=Load()),
                      args=[
                        Name(id='skill', ctx=Load())])],
                  ctx=Load()),
                generators=[
                  comprehension(
                    target=Name(id='skill', ctx=Store()),
                    iter=Name(id='skills', ctx=Load()),
                    is_async=0)])),
            Return(
              value=Call(
                func=Name(id='sorted', ctx=Load()),
                args=[
                  Name(id='scored_skills', ctx=Load())],
                keywords=[
                  keyword(
                    arg='key',
                    value=Lambda(
                      args=arguments(
                        args=[
                          arg(arg='x')]),
                      body=Subscript(
                        value=Name(id='x', ctx=Load()),
                        slice=Constant(value=1),
                        ctx=Load()))),
                  keyword(
                    arg='reverse',
                    value=Constant(value=True))]))],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Subscript(
              value=Name(id='Tuple', ctx=Load()),
              slice=Tuple(
                elts=[
                  Name(id='str', ctx=Load()),
                  Name(id='float', ctx=Load())],
                ctx=Load()),
              ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='order_competencies',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='competencies',
                annotation=Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Name(id='str', ctx=Load()),
                  ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Order competencies by JD alignment score.\n        Returns: List of (competency, score) tuples, sorted by score descending.\n        ')),
            Assign(
              targets=[
                Name(id='scored_comps', ctx=Store())],
              value=ListComp(
                elt=Tuple(
                  elts=[
                    Name(id='comp', ctx=Load()),
                    Call(
                      func=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='score_competency',
                        ctx=Load()),
                      args=[
                        Name(id='comp', ctx=Load())])],
                  ctx=Load()),
                generators=[
                  comprehension(
                    target=Name(id='comp', ctx=Store()),
                    iter=Name(id='competencies', ctx=Load()),
                    is_async=0)])),
            Return(
              value=Call(
                func=Name(id='sorted', ctx=Load()),
                args=[
                  Name(id='scored_comps', ctx=Load())],
                keywords=[
                  keyword(
                    arg='key',
                    value=Lambda(
                      args=arguments(
                        args=[
                          arg(arg='x')]),
                      body=Subscript(
                        value=Name(id='x', ctx=Load()),
                        slice=Constant(value=1),
                        ctx=Load()))),
                  keyword(
                    arg='reverse',
                    value=Constant(value=True))]))],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Subscript(
              value=Name(id='Tuple', ctx=Load()),
              slice=Tuple(
                elts=[
                  Name(id='str', ctx=Load()),
                  Name(id='float', ctx=Load())],
                ctx=Load()),
              ctx=Load()),
            ctx=Load()))]),
    ClassDef(
      name='BulletProvenanceData',
      body=[
        Expr(
          value=Constant(value='\n    Track provenance of generated bullets.\n    v5.36: Removed baseline/master avg comparisons.\n    ')),
        AnnAssign(
          target=Name(id='bullet_text', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='company', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='master_bullet_count', ctx=Store()),
          annotation=Name(id='int', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='derived_bullet_count', ctx=Store()),
          annotation=Name(id='int', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='net_new_count', ctx=Store()),
          annotation=Name(id='int', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='word_count', ctx=Store()),
          annotation=Name(id='int', ctx=Load()),
          simple=1),
        FunctionDef(
          name='format_provenance',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Format provenance as (M/D/N) notation.')),
            Return(
              value=JoinedStr(
                values=[
                  Constant(value='('),
                  FormattedValue(
                    value=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='master_bullet_count',
                      ctx=Load()),
                    conversion=-1),
                  Constant(value='/'),
                  FormattedValue(
                    value=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='derived_bullet_count',
                      ctx=Load()),
                    conversion=-1),
                  Constant(value='/'),
                  FormattedValue(
                    value=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='net_new_count',
                      ctx=Load()),
                    conversion=-1),
                  Constant(value=')')]))],
          returns=Name(id='str', ctx=Load()))],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='EnhancedQAValidator',
      body=[
        Expr(
          value=Constant(value='\n    v5.35: Enhanced QA Validator with provenance tracking.\n    Tracks Unify and IBM bullets with word count adherence.\n    ')),
        FunctionDef(
          name='__init__',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='master_resume',
                annotation=Name(id='Dict', ctx=Load()))]),
          body=[
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='master_resume',
                  ctx=Store())],
              value=Name(id='master_resume', ctx=Load())),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='provenance_data',
                  ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='Unify'),
                  Constant(value='IBM')],
                values=[
                  List(ctx=Load()),
                  List(ctx=Load())]))]),
        FunctionDef(
          name='track_bullet_provenance',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='bullet_text',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='company',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='provenance_notation',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='master_company_key',
                annotation=Name(id='str', ctx=Load()))],
            defaults=[
              Constant(value=None)]),
          body=[
            Expr(
              value=Constant(value='\n        Track provenance for a single bullet.\n        v5.36: Removed baseline/master avg comparisons.\n        \n        Args:\n            bullet_text: The generated bullet text\n            company: \'Unify\' or \'IBM\'\n            provenance_notation: Format "(M/D/N)" where:\n                M = master bullets referenced\n                D = derived bullets generated\n                N = net new bullets created\n            master_company_key: (Deprecated in v5.36)\n        ')),
            Assign(
              targets=[
                Name(id='match', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='re', ctx=Load()),
                  attr='match',
                  ctx=Load()),
                args=[
                  Constant(value='\\((\\d+)/(\\d+)/(\\d+)\\)'),
                  Name(id='provenance_notation', ctx=Load())])),
            If(
              test=UnaryOp(
                op=Not(),
                operand=Name(id='match', ctx=Load())),
              body=[
                Raise(
                  exc=Call(
                    func=Name(id='ValueError', ctx=Load()),
                    args=[
                      JoinedStr(
                        values=[
                          Constant(value='Invalid provenance notation: '),
                          FormattedValue(
                            value=Name(id='provenance_notation', ctx=Load()),
                            conversion=-1)])]))]),
            Assign(
              targets=[
                Tuple(
                  elts=[
                    Name(id='master_count', ctx=Store()),
                    Name(id='derived_count', ctx=Store()),
                    Name(id='net_new_count', ctx=Store())],
                  ctx=Store())],
              value=Call(
                func=Name(id='map', ctx=Load()),
                args=[
                  Name(id='int', ctx=Load()),
                  Call(
                    func=Attribute(
                      value=Name(id='match', ctx=Load()),
                      attr='groups',
                      ctx=Load()))])),
            Assign(
              targets=[
                Name(id='word_count', ctx=Store())],
              value=Call(
                func=Name(id='count_words_clean', ctx=Load()),
                args=[
                  Name(id='bullet_text', ctx=Load())])),
            Assign(
