            ops=[
              LtE(),
              LtE()],
            comparators=[
              Name(id='char_count', ctx=Load()),
              Subscript(
                value=Name(id='constraints', ctx=Load()),
                slice=Constant(value='max_chars'),
                ctx=Load())])),
        Assign(
          targets=[
            Name(id='word_count_valid', ctx=Store())],
          value=Compare(
            left=Subscript(
              value=Subscript(
                value=Name(id='constraints', ctx=Load()),
                slice=Constant(value='word_count'),
                ctx=Load()),
              slice=Constant(value=0),
              ctx=Load()),
            ops=[
              LtE(),
              LtE()],
            comparators=[
              Name(id='word_count', ctx=Load()),
              Subscript(
                value=Subscript(
                  value=Name(id='constraints', ctx=Load()),
                  slice=Constant(value='word_count'),
                  ctx=Load()),
                slice=Constant(value=1),
                ctx=Load())])),
        Assign(
          targets=[
            Name(id='components_valid', ctx=Store())],
          value=Constant(value=True)),
        Assign(
          targets=[
            Name(id='component_details', ctx=Store())],
          value=Dict()),
        If(
          test=Compare(
            left=Constant(value='|'),
            ops=[
              In()],
            comparators=[
              Name(id='headline', ctx=Load())]),
          body=[
            Assign(
              targets=[
                Name(id='components', ctx=Store())],
              value=ListComp(
                elt=Call(
                  func=Attribute(
                    value=Name(id='c', ctx=Load()),
                    attr='strip',
                    ctx=Load())),
                generators=[
                  comprehension(
                    target=Name(id='c', ctx=Store()),
                    iter=Call(
                      func=Attribute(
                        value=Name(id='headline', ctx=Load()),
                        attr='split',
                        ctx=Load()),
                      args=[
                        Constant(value='|')]),
