                elt=Call(
                  func=Attribute(
                    value=Name(id='kw', ctx=Load()),
                    attr='title',
                    ctx=Load())),
                generators=[
                  comprehension(
                    target=Name(id='kw', ctx=Store()),
                    iter=Subscript(
                      value=Name(id='keywords', ctx=Load()),
                      slice=Slice(
                        upper=Constant(value=6)),
                      ctx=Load()),
                    ifs=[
                      Compare(
                        left=Name(id='kw', ctx=Load()),
                        ops=[
                          NotIn()],
                        comparators=[
                          Name(id='skills', ctx=Load())])],
                    is_async=0)])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='skills', ctx=Load()),
                  attr='extend',
                  ctx=Load()),
                args=[
                  Name(id='jd_skills', ctx=Load())])),
