                  func=Attribute(
                    value=Name(id='bullet', ctx=Load()),
                    attr='get',
                    ctx=Load()),
                  args=[
                    Constant(value='bullet_text'),
                    Constant(value='')]),
                generators=[
                  comprehension(
                    target=Name(id='bullet', ctx=Store()),
                    iter=Name(id='selected', ctx=Load()),
                    is_async=0)]))],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
