              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='master_resume',
                  ctx=Store())],
              value=Name(id='master_resume', ctx=Load())),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='min_signal_threshold',
                  ctx=Store())],
              value=Constant(value=0.45))]),
        FunctionDef(
          name='analyze_with_rag',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='job_desc',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='company_name',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='retrieve_peer_jds',
                annotation=Name(id='bool', ctx=Load()))],
            defaults=[
              Constant(value=''),
              Constant(value=True)]),
          body=[
            Expr(
              value=Constant(value='\n        Full RAG analysis matching Job_Workflow v1.9.2 K.0 spec.\n        \n        Args:\n            job_desc: Job description text\n            company_name: Target company name for tier matching\n            retrieve_peer_jds: Whether to retrieve peer JDs (default True)\n        \n        Returns:\n            ThematicAnalysis with full RAG metadata\n        ')),
            Assign(
              targets=[
                Name(id='primary_theme', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='_extract_primary_theme',
                  ctx=Load()),
                args=[
                  Name(id='job_desc', ctx=Load())])),
            Assign(
              targets=[
                Name(id='secondary_themes', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='_extract_secondary_themes',
                  ctx=Load()),
                args=[
                  Name(id='job_desc', ctx=Load())])),
            Assign(
              targets=[
