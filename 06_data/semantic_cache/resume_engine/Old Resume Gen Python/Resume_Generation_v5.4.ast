                    args=[
                      Name(id='base_keywords', ctx=Load()),
                      Name(id='competitive_intel', ctx=Load())])),
                Return(
                  value=Name(id='boosted', ctx=Load()))]),
            Return(
              value=Name(id='base_keywords', ctx=Load()))],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='_extract_base_keywords',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='text',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Extract base keywords using TF-IDF-like approach.')),
            Assign(
              targets=[
                Name(id='words', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='re', ctx=Load()),
                  attr='findall',
                  ctx=Load()),
                args=[
                  Constant(value='\\b[A-Za-z]{3,}\\b'),
                  Call(
                    func=Attribute(
                      value=Name(id='text', ctx=Load()),
                      attr='lower',
                      ctx=Load()))])),
            Assign(
              targets=[
                Name(id='words', ctx=Store())],
              value=ListComp(
                elt=Name(id='w', ctx=Load()),
                generators=[
                  comprehension(
                    target=Name(id='w', ctx=Store()),
                    iter=Name(id='words', ctx=Load()),
                    ifs=[
                      Compare(
                        left=Name(id='w', ctx=Load()),
                        ops=[
                          NotIn()],
                        comparators=[
                          Attribute(
                            value=Name(id='self', ctx=Load()),
                            attr='stop_words',
                            ctx=Load())])],
                    is_async=0)])),
            Assign(
              targets=[
                Name(id='freq', ctx=Store())],
              value=Dict()),
            For(
              target=Name(id='word', ctx=Store()),
              iter=Name(id='words', ctx=Load()),
              body=[
                Assign(
                  targets=[
                    Subscript(
                      value=Name(id='freq', ctx=Load()),
                      slice=Name(id='word', ctx=Load()),
                      ctx=Store())],
                  value=BinOp(
                    left=Call(
                      func=Attribute(
                        value=Name(id='freq', ctx=Load()),
                        attr='get',
                        ctx=Load()),
                      args=[
                        Name(id='word', ctx=Load()),
                        Constant(value=0)]),
                    op=Add(),
                    right=Constant(value=1)))]),
            Assign(
              targets=[
                Name(id='sorted_keywords', ctx=Store())],
              value=Call(
                func=Name(id='sorted', ctx=Load()),
                args=[
                  Call(
                    func=Attribute(
                      value=Name(id='freq', ctx=Load()),
                      attr='items',
                      ctx=Load()))],
                keywords=[
                  keyword(
                    arg='key',
                    value=Lambda(
                      args=arguments(
                        args=[
                          arg(arg='x')]),
                      body=Subscript(
                        value=Name(id='x', ctx=Load()),
                        slice=Constant(value=1),
                        ctx=Load()))),
                  keyword(
                    arg='reverse',
                    value=Constant(value=True))])),
            Return(
              value=ListComp(
                elt=Subscript(
                  value=Name(id='kw', ctx=Load()),
                  slice=Constant(value=0),
                  ctx=Load()),
                generators=[
                  comprehension(
                    target=Name(id='kw', ctx=Store()),
                    iter=Subscript(
                      value=Name(id='sorted_keywords', ctx=Load()),
                      slice=Slice(
                        upper=Constant(value=30)),
                      ctx=Load()),
                    is_async=0)]))],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='_boost_with_competitive_intel',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='base_keywords',
                annotation=Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Name(id='str', ctx=Load()),
                  ctx=Load())),
              arg(
                arg='competitive_intel',
                annotation=Name(id='CompetitiveIntelligence', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Boost keywords using competitive intelligence differentiators.')),
            Assign(
              targets=[
                Name(id='differentiators', ctx=Store())],
              value=Call(
                func=Name(id='set', ctx=Load()),
                args=[
                  Subscript(
                    value=Attribute(
                      value=Name(id='competitive_intel', ctx=Load()),
                      attr='differentiator_keywords',
                      ctx=Load()),
                    slice=Slice(
                      upper=Constant(value=12)),
                    ctx=Load())])),
            Assign(
              targets=[
                Name(id='base_set', ctx=Store())],
              value=Call(
                func=Name(id='set', ctx=Load()),
                args=[
                  Subscript(
                    value=Name(id='base_keywords', ctx=Load()),
                    slice=Slice(
                      upper=Constant(value=20)),
                    ctx=Load())])),
            Assign(
              targets=[
                Name(id='boosted', ctx=Store())],
              value=BinOp(
                left=Call(
                  func=Name(id='list', ctx=Load()),
                  args=[
                    Name(id='differentiators', ctx=Load())]),
                op=Add(),
                right=ListComp(
                  elt=Name(id='kw', ctx=Load()),
                  generators=[
                    comprehension(
                      target=Name(id='kw', ctx=Store()),
                      iter=Name(id='base_keywords', ctx=Load()),
                      ifs=[
                        Compare(
                          left=Name(id='kw', ctx=Load()),
                          ops=[
                            NotIn()],
                          comparators=[
                            Name(id='differentiators', ctx=Load())])],
                      is_async=0)]))),
            Return(
              value=Subscript(
                value=Name(id='boosted', ctx=Load()),
                slice=Slice(
                  upper=Constant(value=25)),
                ctx=Load()))],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load()))]),
    ClassDef(
      name='BulletSelector',
      body=[
        Expr(
          value=Constant(value='Select bullets from master resume with RAG-enhanced scoring.')),
        FunctionDef(
          name='__init__',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='master_resume',
                annotation=Subscript(
                  value=Name(id='Dict', ctx=Load()),
                  slice=Tuple(
                    elts=[
                      Name(id='str', ctx=Load()),
                      Name(id='Any', ctx=Load())],
                    ctx=Load()),
                  ctx=Load()))]),
          body=[
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='master_resume',
                  ctx=Store())],
              value=Name(id='master_resume', ctx=Load()))]),
        FunctionDef(
          name='select_bullets_with_rag',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='company_bullets',
                annotation=Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Name(id='Dict', ctx=Load()),
                  ctx=Load())),
              arg(
                arg='keywords',
                annotation=Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Name(id='str', ctx=Load()),
                  ctx=Load())),
              arg(
                arg='competitive_intel',
                annotation=Subscript(
                  value=Name(id='Optional', ctx=Load()),
                  slice=Name(id='CompetitiveIntelligence', ctx=Load()),
                  ctx=Load())),
              arg(
                arg='count',
                annotation=Name(id='int', ctx=Load()))],
            defaults=[
              Constant(value=None),
              Constant(value=7)]),
          body=[
            Expr(
              value=Constant(value='\n        Select top bullets using composite scoring:\n        - 40% JD keyword match\n        - 35% competitive intelligence boost (K2)\n        - 25% master resume authenticity\n        \n        Matches Job_Workflow v1.9.2 K.11 ranking algorithm.\n        ')),
            Assign(
              targets=[
                Name(id='scored_bullets', ctx=Store())],
              value=List(ctx=Load())),
            For(
              target=Name(id='bullet', ctx=Store()),
              iter=Name(id='company_bullets', ctx=Load()),
              body=[
                Assign(
                  targets=[
                    Name(id='bullet_text', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Call(
                        func=Attribute(
                          value=Name(id='bullet', ctx=Load()),
                          attr='get',
                          ctx=Load()),
                        args=[
                          Constant(value='bullet_text'),
                          Constant(value='')]),
                      attr='lower',
                      ctx=Load()))),
                Assign(
                  targets=[
                    Name(id='jd_match_score', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='_calculate_jd_match',
                      ctx=Load()),
                    args=[
                      Name(id='bullet_text', ctx=Load()),
                      Name(id='keywords', ctx=Load())])),
                Assign(
                  targets=[
                    Name(id='k2_boost', ctx=Store())],
                  value=Constant(value=0.0)),
                If(
                  test=Name(id='competitive_intel', ctx=Load()),
                  body=[
                    Assign(
                      targets=[
                        Name(id='k2_boost', ctx=Store())],
                      value=Call(
                        func=Attribute(
                          value=Name(id='self', ctx=Load()),
                          attr='_calculate_k2_boost',
                          ctx=Load()),
                        args=[
                          Name(id='bullet_text', ctx=Load()),
                          Name(id='competitive_intel', ctx=Load())]))]),
                Assign(
                  targets=[
                    Name(id='authenticity_score', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='_calculate_authenticity',
                      ctx=Load()),
                    args=[
                      Name(id='bullet', ctx=Load())])),
                Assign(
                  targets=[
                    Name(id='composite', ctx=Store())],
                  value=BinOp(
                    left=BinOp(
                      left=BinOp(
                        left=Constant(value=0.4),
                        op=Mult(),
                        right=Name(id='jd_match_score', ctx=Load())),
                      op=Add(),
                      right=BinOp(
                        left=Constant(value=0.35),
                        op=Mult(),
                        right=Name(id='k2_boost', ctx=Load()))),
                    op=Add(),
                    right=BinOp(
                      left=Constant(value=0.25),
                      op=Mult(),
                      right=Name(id='authenticity_score', ctx=Load())))),
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='scored_bullets', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Dict(
                        keys=[
                          Constant(value='bullet'),
                          Constant(value='composite_score'),
                          Constant(value='jd_match'),
                          Constant(value='k2_boost'),
                          Constant(value='authenticity')],
                        values=[
                          Name(id='bullet', ctx=Load()),
                          Name(id='composite', ctx=Load()),
                          Name(id='jd_match_score', ctx=Load()),
                          Name(id='k2_boost', ctx=Load()),
                          Name(id='authenticity_score', ctx=Load())])]))]),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='scored_bullets', ctx=Load()),
                  attr='sort',
                  ctx=Load()),
                keywords=[
                  keyword(
                    arg='key',
                    value=Lambda(
                      args=arguments(
                        args=[
                          arg(arg='x')]),
                      body=Subscript(
                        value=Name(id='x', ctx=Load()),
                        slice=Constant(value='composite_score'),
                        ctx=Load()))),
                  keyword(
                    arg='reverse',
                    value=Constant(value=True))])),
            Return(
              value=ListComp(
                elt=Subscript(
                  value=Name(id='sb', ctx=Load()),
                  slice=Constant(value='bullet'),
                  ctx=Load()),
                generators=[
                  comprehension(
                    target=Name(id='sb', ctx=Store()),
                    iter=Subscript(
                      value=Name(id='scored_bullets', ctx=Load()),
                      slice=Slice(
                        upper=Name(id='count', ctx=Load())),
                      ctx=Load()),
                    is_async=0)]))],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='Dict', ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='_calculate_jd_match',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='bullet_text',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='keywords',
                annotation=Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Name(id='str', ctx=Load()),
                  ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Calculate JD keyword match score.')),
            Assign(
              targets=[
                Name(id='matches', ctx=Store())],
              value=Call(
                func=Name(id='sum', ctx=Load()),
                args=[
                  GeneratorExp(
                    elt=Constant(value=1),
                    generators=[
                      comprehension(
                        target=Name(id='kw', ctx=Store()),
                        iter=Name(id='keywords', ctx=Load()),
                        ifs=[
                          Compare(
                            left=Call(
                              func=Attribute(
                                value=Name(id='kw', ctx=Load()),
                                attr='lower',
                                ctx=Load())),
                            ops=[
                              In()],
                            comparators=[
                              Name(id='bullet_text', ctx=Load())])],
                        is_async=0)])])),
            Return(
              value=IfExp(
                test=Name(id='keywords', ctx=Load()),
                body=Call(
                  func=Name(id='min', ctx=Load()),
                  args=[
                    BinOp(
                      left=Name(id='matches', ctx=Load()),
                      op=Div(),
                      right=Call(
                        func=Name(id='len', ctx=Load()),
                        args=[
                          Name(id='keywords', ctx=Load())])),
                    Constant(value=1.0)]),
                orelse=Constant(value=0.0)))],
          returns=Name(id='float', ctx=Load())),
        FunctionDef(
          name='_calculate_k2_boost',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='bullet_text',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='competitive_intel',
                annotation=Name(id='CompetitiveIntelligence', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Calculate K2 competitive intelligence boost.')),
            Assign(
              targets=[
                Name(id='differentiators', ctx=Store())],
              value=Attribute(
                value=Name(id='competitive_intel', ctx=Load()),
                attr='differentiator_keywords',
                ctx=Load())),
            Assign(
              targets=[
                Name(id='matches', ctx=Store())],
              value=Call(
                func=Name(id='sum', ctx=Load()),
                args=[
                  GeneratorExp(
                    elt=Constant(value=1),
                    generators=[
                      comprehension(
                        target=Name(id='kw', ctx=Store()),
                        iter=Name(id='differentiators', ctx=Load()),
                        ifs=[
                          Compare(
                            left=Call(
                              func=Attribute(
                                value=Name(id='kw', ctx=Load()),
                                attr='lower',
                                ctx=Load())),
                            ops=[
                              In()],
                            comparators=[
                              Name(id='bullet_text', ctx=Load())])],
                        is_async=0)])])),
            Return(
              value=IfExp(
                test=Name(id='differentiators', ctx=Load()),
                body=Call(
                  func=Name(id='min', ctx=Load()),
                  args=[
                    BinOp(
                      left=Name(id='matches', ctx=Load()),
                      op=Div(),
                      right=Call(
                        func=Name(id='len', ctx=Load()),
                        args=[
                          Name(id='differentiators', ctx=Load())])),
                    Constant(value=1.0)]),
                orelse=Constant(value=0.0)))],
          returns=Name(id='float', ctx=Load())),
        FunctionDef(
          name='_calculate_authenticity',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='bullet',
                annotation=Name(id='Dict', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Calculate master resume authenticity score.')),
            Assign(
              targets=[
                Name(id='has_numbers', ctx=Store())],
              value=Call(
                func=Name(id='bool', ctx=Load()),
                args=[
                  Call(
                    func=Attribute(
                      value=Name(id='re', ctx=Load()),
                      attr='search',
                      ctx=Load()),
                    args=[
                      Constant(value='\\d+'),
                      Call(
                        func=Attribute(
                          value=Name(id='bullet', ctx=Load()),
                          attr='get',
                          ctx=Load()),
                        args=[
                          Constant(value='bullet_text'),
                          Constant(value='')])])])),
            Assign(
              targets=[
                Name(id='has_percentage', ctx=Store())],
              value=Compare(
                left=Constant(value='%'),
                ops=[
                  In()],
                comparators=[
                  Call(
                    func=Attribute(
                      value=Name(id='bullet', ctx=Load()),
                      attr='get',
                      ctx=Load()),
                    args=[
                      Constant(value='bullet_text'),
                      Constant(value='')])])),
            Assign(
              targets=[
                Name(id='has_dollar', ctx=Store())],
              value=Compare(
                left=Constant(value='$'),
                ops=[
                  In()],
                comparators=[
                  Call(
                    func=Attribute(
                      value=Name(id='bullet', ctx=Load()),
                      attr='get',
                      ctx=Load()),
                    args=[
                      Constant(value='bullet_text'),
                      Constant(value='')])])),
            Assign(
              targets=[
                Name(id='authenticity', ctx=Store())],
              value=Constant(value=0.0)),
            If(
              test=Name(id='has_numbers', ctx=Load()),
              body=[
                AugAssign(
                  target=Name(id='authenticity', ctx=Store()),
                  op=Add(),
                  value=Constant(value=0.4))]),
            If(
              test=Name(id='has_percentage', ctx=Load()),
              body=[
                AugAssign(
                  target=Name(id='authenticity', ctx=Store()),
                  op=Add(),
                  value=Constant(value=0.3))]),
            If(
              test=Name(id='has_dollar', ctx=Load()),
              body=[
                AugAssign(
                  target=Name(id='authenticity', ctx=Store()),
                  op=Add(),
                  value=Constant(value=0.3))]),
            Return(
              value=Call(
                func=Name(id='min', ctx=Load()),
                args=[
                  Name(id='authenticity', ctx=Load()),
                  Constant(value=1.0)]))],
          returns=Name(id='float', ctx=Load()))]),
    ClassDef(
      name='ResumeGenerator',
      body=[
        Expr(
          value=Constant(value='\n    Main resume generator with full Job_Workflow v1.9.2 RAG integration.\n    Implements K.0, HOP-2 data enrichment, and 4-output generation.\n    ')),
        FunctionDef(
          name='__init__',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='master_resume',
                annotation=Subscript(
                  value=Name(id='Dict', ctx=Load()),
                  slice=Tuple(
                    elts=[
                      Name(id='str', ctx=Load()),
                      Name(id='Any', ctx=Load())],
                    ctx=Load()),
                  ctx=Load()))]),
          body=[
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='master_resume',
                  ctx=Store())],
              value=Name(id='master_resume', ctx=Load())),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='jd_analyzer',
                  ctx=Store())],
              value=Call(
                func=Name(id='JobDescriptionAnalyzer', ctx=Load()),
                args=[
                  Name(id='master_resume', ctx=Load())])),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='keyword_extractor',
                  ctx=Store())],
              value=Call(
                func=Name(id='KeywordExtractor', ctx=Load()))),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='bullet_selector',
                  ctx=Store())],
              value=Call(
                func=Name(id='BulletSelector', ctx=Load()),
                args=[
                  Name(id='master_resume', ctx=Load())])),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='section_configs',
                  ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='K.1'),
                  Constant(value='K.5B'),
                  Constant(value='K.6B')],
                values=[
                  Call(
                    func=Name(id='PerSectionTolerance', ctx=Load()),
                    args=[
                      Constant(value=127),
                      Constant(value=0.065),
                      Constant(value=0.7),
                      Constant(value=0.95),
                      Constant(value=0.8)]),
                  Call(
                    func=Name(id='PerSectionTolerance', ctx=Load()),
                    args=[
                      Constant(value=31),
                      Constant(value=0.1),
                      Constant(value=0.65),
                      Constant(value=0.92),
                      Constant(value=0.9)]),
                  Call(
                    func=Name(id='PerSectionTolerance', ctx=Load()),
                    args=[
                      Constant(value=27),
                      Constant(value=0.092),
                      Constant(value=0.65),
                      Constant(value=0.9),
                      Constant(value=0.9)])]))]),
        FunctionDef(
          name='generate_resume',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='job_desc',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='company_name',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='job_title',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='enable_rag',
                annotation=Name(id='bool', ctx=Load()))],
            defaults=[
              Constant(value=''),
              Constant(value=''),
              Constant(value=True)]),
          body=[
            Expr(
              value=Constant(value='\n        Generate complete resume with RAG orchestration.\n        \n        Returns dict with:\n        - resume_text: Final resume\n        - cover_letter_text: Cover letter\n        - qa_report: QA validation report\n        - coc_ledger: Chain of custody ledger\n        - thematic_analysis: K.0 RAG metadata\n        ')),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  BinOp(
                    left=Constant(value='='),
                    op=Mult(),
                    right=Constant(value=80))])),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  Constant(value='RESUME GENERATION v5.4 - FULL RAG INTEGRATION')])),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  BinOp(
                    left=Constant(value='='),
                    op=Mult(),
                    right=Constant(value=80))])),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  Constant(value='\n[HOP-0] Source Integrity Check...')])),
            If(
              test=UnaryOp(
                op=Not(),
                operand=Attribute(
