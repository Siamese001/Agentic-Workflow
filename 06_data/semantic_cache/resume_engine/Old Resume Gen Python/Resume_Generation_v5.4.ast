              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='_classify_role',
                  ctx=Load()),
                args=[
                  Name(id='job_desc', ctx=Load())])),
            Assign(
              targets=[
                Name(id='competitive_intel', ctx=Store())],
              value=Constant(value=None)),
            Assign(
              targets=[
                Name(id='retrieval_method', ctx=Store())],
              value=Constant(value='FULL_MASTER')),
            If(
              test=Name(id='retrieve_peer_jds', ctx=Load()),
              body=[
                Assign(
                  targets=[
                    Name(id='competitive_intel', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='_retrieve_competitive_intelligence',
                      ctx=Load()),
                    args=[
                      Name(id='job_desc', ctx=Load()),
                      Name(id='company_name', ctx=Load()),
                      Name(id='primary_theme', ctx=Load())])),
                Assign(
                  targets=[
                    Name(id='retrieval_method', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='_determine_retrieval_method',
                      ctx=Load()),
                    args=[
                      Name(id='competitive_intel', ctx=Load())]))],
              orelse=[
                Assign(
                  targets=[
                    Name(id='competitive_intel', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='_get_fallback_intelligence',
                      ctx=Load()))),
                Assign(
                  targets=[
                    Name(id='retrieval_method', ctx=Store())],
                  value=Constant(value='FALLBACK'))]),
            Assign(
              targets=[
                Name(id='signal_score', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='_calculate_signal_quality',
                  ctx=Load()),
                args=[
                  Name(id='primary_theme', ctx=Load()),
                  Name(id='competitive_intel', ctx=Load())])),
            Assign(
              targets=[
                Name(id='authenticity_patterns', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='_build_authenticity_patterns',
                  ctx=Load()),
                args=[
                  Name(id='role_classification', ctx=Load()),
                  Name(id='signal_score', ctx=Load())])),
            Assign(
              targets=[
                Name(id='positioning_directives', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='_generate_positioning_directives',
                  ctx=Load()),
                args=[
                  Name(id='role_classification', ctx=Load()),
                  Name(id='authenticity_patterns', ctx=Load()),
                  Name(id='signal_score', ctx=Load())])),
            Assign(
              targets=[
                Name(id='retrieval_sources', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='_build_retrieval_sources',
                  ctx=Load()),
                args=[
                  Name(id='competitive_intel', ctx=Load()),
                  Name(id='retrieval_method', ctx=Load())])),
            Return(
              value=Call(
                func=Name(id='ThematicAnalysis', ctx=Load()),
                keywords=[
                  keyword(
                    arg='primary_theme',
                    value=Name(id='primary_theme', ctx=Load())),
                  keyword(
                    arg='secondary_themes',
                    value=Name(id='secondary_themes', ctx=Load())),
                  keyword(
                    arg='role_classification',
                    value=Name(id='role_classification', ctx=Load())),
                  keyword(
                    arg='positioning_directives',
                    value=Name(id='positioning_directives', ctx=Load())),
                  keyword(
                    arg='authenticity_patterns',
                    value=Name(id='authenticity_patterns', ctx=Load())),
                  keyword(
                    arg='competitive_intelligence',
                    value=Name(id='competitive_intel', ctx=Load())),
                  keyword(
                    arg='signal_quality_score',
                    value=Name(id='signal_score', ctx=Load())),
                  keyword(
                    arg='retrieval_method',
                    value=Name(id='retrieval_method', ctx=Load())),
                  keyword(
                    arg='retrieval_sources',
                    value=Name(id='retrieval_sources', ctx=Load()))]))],
          returns=Name(id='ThematicAnalysis', ctx=Load())),
        FunctionDef(
          name='_extract_primary_theme',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='job_desc',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Extract primary theme with confidence scoring.')),
            Assign(
              targets=[
                Name(id='keywords', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='re', ctx=Load()),
                  attr='findall',
                  ctx=Load()),
                args=[
                  Constant(value='\\b[A-Z][a-z]+(?:\\s+[A-Z][a-z]+)*\\b'),
                  Name(id='job_desc', ctx=Load())])),
            Assign(
              targets=[
                Name(id='keyword_freq', ctx=Store())],
              value=Dict()),
            For(
              target=Name(id='kw', ctx=Store()),
              iter=Name(id='keywords', ctx=Load()),
              body=[
                Assign(
                  targets=[
                    Subscript(
                      value=Name(id='keyword_freq', ctx=Load()),
                      slice=Name(id='kw', ctx=Load()),
                      ctx=Store())],
                  value=BinOp(
                    left=Call(
                      func=Attribute(
                        value=Name(id='keyword_freq', ctx=Load()),
                        attr='get',
                        ctx=Load()),
                      args=[
                        Name(id='kw', ctx=Load()),
                        Constant(value=0)]),
                    op=Add(),
                    right=Constant(value=1)))]),
            Assign(
              targets=[
                Name(id='top_theme', ctx=Store())],
              value=IfExp(
                test=Name(id='keyword_freq', ctx=Load()),
                body=Call(
                  func=Name(id='max', ctx=Load()),
                  args=[
                    Call(
                      func=Attribute(
                        value=Name(id='keyword_freq', ctx=Load()),
                        attr='items',
                        ctx=Load()))],
                  keywords=[
                    keyword(
                      arg='key',
                      value=Lambda(
                        args=arguments(
                          args=[
                            arg(arg='x')]),
                        body=Subscript(
                          value=Name(id='x', ctx=Load()),
                          slice=Constant(value=1),
                          ctx=Load())))]),
                orelse=Tuple(
                  elts=[
                    Constant(value='General'),
                    Constant(value=1)],
                  ctx=Load()))),
            Assign(
              targets=[
                Name(id='confidence', ctx=Store())],
              value=Call(
                func=Name(id='min', ctx=Load()),
                args=[
                  BinOp(
                    left=Subscript(
                      value=Name(id='top_theme', ctx=Load()),
                      slice=Constant(value=1),
                      ctx=Load()),
                    op=Div(),
                    right=Constant(value=10)),
                  Constant(value=1.0)])),
            Return(
              value=Dict(
                keys=[
                  Constant(value='value'),
                  Constant(value='confidence_score'),
                  Constant(value='retrieval_source'),
                  Constant(value='supporting_evidence')],
                values=[
                  Subscript(
                    value=Name(id='top_theme', ctx=Load()),
                    slice=Constant(value=0),
                    ctx=Load()),
                  Name(id='confidence', ctx=Load()),
                  List(
                    elts=[
                      Constant(value='JOB_DESCRIPTION')],
                    ctx=Load()),
                  Subscript(
                    value=Name(id='keywords', ctx=Load()),
                    slice=Slice(
                      upper=Constant(value=5)),
                    ctx=Load())]))],
          returns=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='Any', ctx=Load())],
              ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='_extract_secondary_themes',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='job_desc',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Extract secondary themes.')),
            Assign(
              targets=[
                Name(id='themes', ctx=Store())],
              value=List(ctx=Load())),
            Assign(
              targets=[
                Name(id='theme_patterns', ctx=Store())],
              value=List(
                elts=[
                  Constant(value='\\b(AI|ML|Machine Learning|Data Science|Analytics)\\b'),
                  Constant(value='\\b(Cloud|AWS|Azure|GCP)\\b'),
                  Constant(value='\\b(Leadership|Management|Strategy)\\b'),
                  Constant(value='\\b(Product|Engineering|Development)\\b'),
                  Constant(value='\\b(Revenue|Sales|GTM|Go-to-Market)\\b')],
                ctx=Load())),
            For(
              target=Name(id='pattern', ctx=Store()),
              iter=Name(id='theme_patterns', ctx=Load()),
              body=[
                Assign(
                  targets=[
                    Name(id='matches', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='re', ctx=Load()),
                      attr='findall',
                      ctx=Load()),
                    args=[
                      Name(id='pattern', ctx=Load()),
                      Name(id='job_desc', ctx=Load()),
                      Attribute(
                        value=Name(id='re', ctx=Load()),
                        attr='IGNORECASE',
                        ctx=Load())])),
                If(
                  test=Name(id='matches', ctx=Load()),
                  body=[
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Name(id='themes', ctx=Load()),
                          attr='append',
                          ctx=Load()),
                        args=[
                          Dict(
                            keys=[
                              Constant(value='value'),
                              Constant(value='confidence_score'),
                              Constant(value='retrieval_source')],
                            values=[
                              Subscript(
                                value=Name(id='matches', ctx=Load()),
                                slice=Constant(value=0),
                                ctx=Load()),
                              Call(
                                func=Name(id='min', ctx=Load()),
                                args=[
                                  BinOp(
                                    left=Call(
                                      func=Name(id='len', ctx=Load()),
                                      args=[
                                        Name(id='matches', ctx=Load())]),
                                    op=Div(),
                                    right=Constant(value=5)),
                                  Constant(value=1.0)]),
                              Constant(value='JOB_DESCRIPTION')])]))])]),
            Return(
              value=Subscript(
                value=Name(id='themes', ctx=Load()),
                slice=Slice(
                  upper=Constant(value=3)),
                ctx=Load()))],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Subscript(
              value=Name(id='Dict', ctx=Load()),
              slice=Tuple(
                elts=[
                  Name(id='str', ctx=Load()),
                  Name(id='Any', ctx=Load())],
                ctx=Load()),
              ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='_classify_role',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='job_desc',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Classify role type with language weight analysis.')),
            Assign(
              targets=[
                Name(id='business_terms', ctx=Store())],
              value=Call(
                func=Name(id='len', ctx=Load()),
                args=[
                  Call(
                    func=Attribute(
                      value=Name(id='re', ctx=Load()),
                      attr='findall',
                      ctx=Load()),
                    args=[
                      Constant(value='\\b(strategy|revenue|growth|market|business|executive|leadership)\\b'),
                      Name(id='job_desc', ctx=Load()),
                      Attribute(
                        value=Name(id='re', ctx=Load()),
                        attr='IGNORECASE',
                        ctx=Load())])])),
            Assign(
              targets=[
                Name(id='tech_terms', ctx=Store())],
              value=Call(
                func=Name(id='len', ctx=Load()),
                args=[
                  Call(
                    func=Attribute(
                      value=Name(id='re', ctx=Load()),
                      attr='findall',
                      ctx=Load()),
                    args=[
                      Constant(value='\\b(AI|ML|data|engineering|architecture|technical|platform|infrastructure)\\b'),
                      Name(id='job_desc', ctx=Load()),
                      Attribute(
                        value=Name(id='re', ctx=Load()),
                        attr='IGNORECASE',
                        ctx=Load())])])),
            Assign(
              targets=[
                Name(id='ops_terms', ctx=Store())],
              value=Call(
                func=Name(id='len', ctx=Load()),
                args=[
                  Call(
                    func=Attribute(
                      value=Name(id='re', ctx=Load()),
                      attr='findall',
                      ctx=Load()),
                    args=[
                      Constant(value='\\b(operations|delivery|process|implementation|execution)\\b'),
                      Name(id='job_desc', ctx=Load()),
                      Attribute(
                        value=Name(id='re', ctx=Load()),
                        attr='IGNORECASE',
                        ctx=Load())])])),
            Assign(
              targets=[
                Name(id='total', ctx=Store())],
              value=BinOp(
                left=BinOp(
                  left=BinOp(
                    left=Name(id='business_terms', ctx=Load()),
                    op=Add(),
                    right=Name(id='tech_terms', ctx=Load())),
                  op=Add(),
                  right=Name(id='ops_terms', ctx=Load())),
                op=Add(),
                right=Constant(value=1))),
            Assign(
              targets=[
                Name(id='business_pct', ctx=Store())],
              value=BinOp(
                left=Name(id='business_terms', ctx=Load()),
                op=Div(),
                right=Name(id='total', ctx=Load()))),
            Assign(
              targets=[
                Name(id='tech_pct', ctx=Store())],
              value=BinOp(
                left=Name(id='tech_terms', ctx=Load()),
                op=Div(),
                right=Name(id='total', ctx=Load()))),
            Assign(
              targets=[
                Name(id='ops_pct', ctx=Store())],
              value=BinOp(
                left=Name(id='ops_terms', ctx=Load()),
                op=Div(),
                right=Name(id='total', ctx=Load()))),
            If(
              test=Compare(
                left=Name(id='business_pct', ctx=Load()),
                ops=[
                  Gt()],
                comparators=[
                  Constant(value=0.4)]),
              body=[
                Assign(
                  targets=[
                    Name(id='classification', ctx=Store())],
                  value=Constant(value='INDUSTRY_EXECUTIVE')),
                Assign(
                  targets=[
                    Name(id='confidence', ctx=Store())],
                  value=Name(id='business_pct', ctx=Load()))],
              orelse=[
                If(
                  test=Compare(
                    left=Name(id='tech_pct', ctx=Load()),
                    ops=[
                      Gt()],
                    comparators=[
                      Constant(value=0.4)]),
                  body=[
                    Assign(
                      targets=[
                        Name(id='classification', ctx=Store())],
                      value=Constant(value='TECH_SPECIALIST')),
                    Assign(
                      targets=[
                        Name(id='confidence', ctx=Store())],
                      value=Name(id='tech_pct', ctx=Load()))],
                  orelse=[
                    Assign(
                      targets=[
                        Name(id='classification', ctx=Store())],
                      value=Constant(value='HYBRID_PROFILE')),
                    Assign(
                      targets=[
                        Name(id='confidence', ctx=Store())],
                      value=Call(
                        func=Name(id='max', ctx=Load()),
                        args=[
                          Name(id='business_pct', ctx=Load()),
                          Name(id='tech_pct', ctx=Load()),
                          Name(id='ops_pct', ctx=Load())]))])]),
            Return(
              value=Dict(
                keys=[
                  Constant(value='value'),
                  Constant(value='confidence_score'),
                  Constant(value='language_weight_analysis')],
                values=[
                  Name(id='classification', ctx=Load()),
                  Name(id='confidence', ctx=Load()),
                  Dict(
                    keys=[
                      Constant(value='business_transformation_pct'),
                      Constant(value='technology_pct'),
                      Constant(value='operations_pct')],
                    values=[
                      Name(id='business_pct', ctx=Load()),
                      Name(id='tech_pct', ctx=Load()),
                      Name(id='ops_pct', ctx=Load())])]))],
          returns=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='Any', ctx=Load())],
              ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='_retrieve_competitive_intelligence',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='job_desc',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='company_name',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='primary_theme',
                annotation=Name(id='Dict', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Retrieve peer JDs and extract competitive intelligence.\n        Matches Job_Workflow v1.9.2 HOP-2 data enrichment spec.\n        ')),
            Assign(
              targets=[
                Name(id='peer_jds', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='_identify_peer_jds',
                  ctx=Load()),
                args=[
                  Name(id='company_name', ctx=Load()),
                  Name(id='primary_theme', ctx=Load())])),
            Assign(
              targets=[
                Name(id='differentiator_keywords_raw', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='_extract_differentiator_keywords',
                  ctx=Load()),
                args=[
                  Name(id='job_desc', ctx=Load()),
                  Name(id='peer_jds', ctx=Load())])),
            Assign(
              targets=[
                Name(id='weighted_keywords', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='_weight_keywords',
                  ctx=Load()),
                args=[
                  Name(id='differentiator_keywords_raw', ctx=Load()),
                  Name(id='job_desc', ctx=Load())])),
            Assign(
              targets=[
                Name(id='table_stakes', ctx=Store())],
              value=Call(
                func=Attribute(
