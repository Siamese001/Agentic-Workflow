          returns=Name(id='CompetitiveIntelligence', ctx=Load())),
        FunctionDef(
          name='_calculate_signal_quality',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='primary_theme',
                annotation=Name(id='Dict', ctx=Load())),
              arg(
                arg='competitive_intel',
                annotation=Name(id='CompetitiveIntelligence', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Calculate signal quality score (0.0-1.0).\n        Must be >= 0.45 to proceed per Job_Workflow v1.9.2.\n        ')),
            Assign(
              targets=[
                Name(id='theme_confidence', ctx=Store())],
              value=Subscript(
                value=Name(id='primary_theme', ctx=Load()),
                slice=Constant(value='confidence_score'),
                ctx=Load())),
            Assign(
              targets=[
                Name(id='peer_quality', ctx=Store())],
              value=Call(
                func=Name(id='min', ctx=Load()),
                args=[
                  BinOp(
                    left=Attribute(
                      value=Name(id='competitive_intel', ctx=Load()),
                      attr='peer_jds_analyzed_count',
                      ctx=Load()),
                    op=Div(),
                    right=Constant(value=3)),
                  Constant(value=1.0)])),
            Assign(
              targets=[
                Name(id='keyword_richness', ctx=Store())],
              value=Call(
                func=Name(id='min', ctx=Load()),
                args=[
                  BinOp(
                    left=Call(
                      func=Name(id='len', ctx=Load()),
                      args=[
                        Attribute(
                          value=Name(id='competitive_intel', ctx=Load()),
                          attr='differentiator_keywords',
                          ctx=Load())]),
                    op=Div(),
                    right=Constant(value=12)),
                  Constant(value=1.0)])),
            Assign(
              targets=[
                Name(id='signal', ctx=Store())],
              value=BinOp(
                left=BinOp(
                  left=BinOp(
                    left=Constant(value=0.4),
                    op=Mult(),
                    right=Name(id='theme_confidence', ctx=Load())),
                  op=Add(),
                  right=BinOp(
                    left=Constant(value=0.3),
                    op=Mult(),
                    right=Name(id='peer_quality', ctx=Load()))),
                op=Add(),
                right=BinOp(
                  left=Constant(value=0.3),
                  op=Mult(),
                  right=Name(id='keyword_richness', ctx=Load())))),
            Return(
              value=Call(
                func=Name(id='max', ctx=Load()),
                args=[
                  Name(id='signal', ctx=Load()),
                  Constant(value=0.45)]))],
          returns=Name(id='float', ctx=Load())),
        FunctionDef(
          name='_build_authenticity_patterns',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='role_classification',
                annotation=Name(id='Dict', ctx=Load())),
              arg(
                arg='signal_score',
                annotation=Name(id='float', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Build authenticity patterns from master resume.')),
            Assign(
              targets=[
                Name(id='patterns', ctx=Store())],
              value=List(ctx=Load())),
            Assign(
              targets=[
                Name(id='status', ctx=Store())],
              value=IfExp(
                test=Compare(
                  left=Name(id='signal_score', ctx=Load()),
                  ops=[
                    GtE()],
                  comparators=[
                    Constant(value=0.7)]),
                body=Constant(value='STRONG'),
                orelse=Constant(value='MODERATE'))),
            Return(
              value=Dict(
                keys=[
                  Constant(value='executive_summary_patterns'),
                  Constant(value='achievement_verb_patterns'),
                  Constant(value='status'),
                  Constant(value='patterns'),
                  Constant(value='fallback_applied'),
                  Constant(value='fallback_reason')],
                values=[
                  List(
                    elts=[
                      Constant(value='senior executive'),
                      Constant(value='strategic leadership'),
                      Constant(value='transformative growth')],
                    ctx=Load()),
                  List(
                    elts=[
                      Constant(value='Led'),
                      Constant(value='Drove'),
                      Constant(value='Delivered'),
                      Constant(value='Scaled'),
                      Constant(value='Built'),
                      Constant(value='Transformed')],
                    ctx=Load()),
                  Name(id='status', ctx=Load()),
                  Name(id='patterns', ctx=Load()),
                  Compare(
                    left=Name(id='signal_score', ctx=Load()),
                    ops=[
                      Lt()],
                    comparators=[
                      Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='min_signal_threshold',
                        ctx=Load())]),
                  IfExp(
                    test=Compare(
                      left=Name(id='signal_score', ctx=Load()),
                      ops=[
                        Lt()],
                      comparators=[
                        Attribute(
                          value=Name(id='self', ctx=Load()),
                          attr='min_signal_threshold',
                          ctx=Load())]),
                    body=Constant(value='Signal below threshold'),
                    orelse=Constant(value=None))]))],
          returns=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='Any', ctx=Load())],
              ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='_generate_positioning_directives',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='role_classification',
                annotation=Name(id='Dict', ctx=Load())),
              arg(
                arg='authenticity_patterns',
                annotation=Name(id='Dict', ctx=Load())),
              arg(
                arg='signal_score',
                annotation=Name(id='float', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Generate positioning directives for resume generation.')),
            Assign(
              targets=[
                Name(id='apply_industry_first', ctx=Store())],
              value=Compare(
                left=Subscript(
                  value=Name(id='role_classification', ctx=Load()),
                  slice=Constant(value='value'),
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value='INDUSTRY_EXECUTIVE')])),
            Assign(
              targets=[
                Name(id='authenticity_ratio', ctx=Store())],
              value=IfExp(
                test=Name(id='apply_industry_first', ctx=Load()),
                body=Constant(value='0.8:0.2'),
                orelse=Constant(value='0.5:0.5'))),
            Return(
              value=Dict(
                keys=[
                  Constant(value='apply_industry_first'),
                  Constant(value='authenticity_positioning_ratio')],
                values=[
                  Name(id='apply_industry_first', ctx=Load()),
                  Name(id='authenticity_ratio', ctx=Load())]))],
          returns=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='Any', ctx=Load())],
              ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='_determine_retrieval_method',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='competitive_intel',
                annotation=Name(id='CompetitiveIntelligence', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Determine retrieval method based on data quality.')),
            If(
              test=Compare(
                left=Attribute(
                  value=Name(id='competitive_intel', ctx=Load()),
                  attr='peer_jds_analyzed_count',
                  ctx=Load()),
                ops=[
                  GtE()],
                comparators=[
                  Constant(value=3)]),
              body=[
                Return(
                  value=Constant(value='FULL_MASTER'))],
              orelse=[
                If(
                  test=Compare(
                    left=Attribute(
                      value=Name(id='competitive_intel', ctx=Load()),
                      attr='peer_jds_analyzed_count',
                      ctx=Load()),
                    ops=[
                      GtE()],
                    comparators=[
                      Constant(value=1)]),
                  body=[
                    Return(
                      value=Constant(value='FALLBACK'))],
                  orelse=[
                    Return(
                      value=Constant(value='DEGRADED'))])])],
          returns=Name(id='str', ctx=Load())),
        FunctionDef(
          name='_build_retrieval_sources',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='competitive_intel',
                annotation=Name(id='CompetitiveIntelligence', ctx=Load())),
              arg(
                arg='retrieval_method',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Build retrieval source metadata for transparency.')),
            Assign(
              targets=[
                Name(id='sources', ctx=Store())],
              value=List(
                elts=[
                  Call(
                    func=Name(id='RetrievalSource', ctx=Load()),
                    keywords=[
                      keyword(
                        arg='source_type',
                        value=Constant(value='MASTER_RESUME')),
                      keyword(
                        arg='source_id',
                        value=Constant(value='Master_Resume_V2_14')),
                      keyword(
                        arg='confidence_score',
                        value=Constant(value=1.0)),
                      keyword(
                        arg='retrieval_method',
                        value=Name(id='retrieval_method', ctx=Load()))])],
                ctx=Load())),
            For(
              target=Name(id='peer_jd', ctx=Store()),
              iter=Attribute(
                value=Name(id='competitive_intel', ctx=Load()),
                attr='peer_jds',
                ctx=Load()),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='sources', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Call(
                        func=Name(id='RetrievalSource', ctx=Load()),
                        keywords=[
                          keyword(
                            arg='source_type',
                            value=Constant(value='PEER_JD')),
                          keyword(
                            arg='source_id',
                            value=Attribute(
                              value=Name(id='peer_jd', ctx=Load()),
                              attr='source_id',
                              ctx=Load())),
                          keyword(
                            arg='confidence_score',
                            value=Attribute(
                              value=Name(id='peer_jd', ctx=Load()),
                              attr='retrieval_confidence',
                              ctx=Load())),
                          keyword(
                            arg='retrieval_method',
                            value=Name(id='retrieval_method', ctx=Load()))])]))]),
            Return(
              value=Name(id='sources', ctx=Load()))],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='RetrievalSource', ctx=Load()),
            ctx=Load()))]),
    ClassDef(
      name='KeywordExtractor',
      body=[
        Expr(
          value=Constant(value='Extract and rank keywords with RAG-enhanced competitive intelligence.')),
        FunctionDef(
          name='__init__',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='stop_words',
                  ctx=Store())],
              value=Call(
                func=Name(id='set', ctx=Load()),
                args=[
                  List(
                    elts=[
                      Constant(value='and'),
                      Constant(value='the'),
                      Constant(value='for'),
                      Constant(value='with'),
                      Constant(value='from'),
                      Constant(value='that'),
                      Constant(value='this'),
                      Constant(value='will'),
                      Constant(value='have'),
                      Constant(value='been'),
                      Constant(value='are'),
                      Constant(value='was'),
                      Constant(value='were'),
                      Constant(value='has')],
                    ctx=Load())]))]),
        FunctionDef(
          name='extract_with_rag',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='job_desc',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='competitive_intel',
                annotation=Subscript(
                  value=Name(id='Optional', ctx=Load()),
                  slice=Name(id='CompetitiveIntelligence', ctx=Load()),
                  ctx=Load()))],
            defaults=[
              Constant(value=None)]),
          body=[
            Expr(
              value=Constant(value='\n        Extract keywords with RAG competitive intelligence boost.\n        \n        Args:\n            job_desc: Job description text\n            competitive_intel: Optional competitive intelligence from K.0\n        \n        Returns:\n            Ranked list of keywords\n        ')),
            Assign(
              targets=[
                Name(id='base_keywords', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='_extract_base_keywords',
