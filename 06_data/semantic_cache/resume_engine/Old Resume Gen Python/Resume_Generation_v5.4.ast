          body=[
            Expr(
              value=Constant(value='\n        Identify peer job descriptions by company tier.\n        In production, would query external JD database.\n        For now, returns mock peer JDs.\n        ')),
            Assign(
              targets=[
                Name(id='mock_peers', ctx=Store())],
              value=List(
                elts=[
                  Dict(
                    keys=[
                      Constant(value='company'),
