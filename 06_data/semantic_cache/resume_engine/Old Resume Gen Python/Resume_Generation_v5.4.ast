                  Dict(
                    keys=[
                      Constant(value='company'),
                      Constant(value='tier'),
                      Constant(value='title')],
                    values=[
                      Constant(value='ServiceNow'),
                      Constant(value=0),
                      Constant(value='VP AI Strategy')]),
                  Dict(
                    keys=[
                      Constant(value='company'),
                      Constant(value='tier'),
                      Constant(value='title')],
                    values=[
                      Constant(value='Adobe'),
                      Constant(value=1),
                      Constant(value='Head of AI Innovation')]),
                  Dict(
                    keys=[
                      Constant(value='company'),
                      Constant(value='tier'),
                      Constant(value='title')],
                    values=[
                      Constant(value='Workday'),
                      Constant(value=1),
                      Constant(value='Director AI Products')]),
                  Dict(
                    keys=[
                      Constant(value='company'),
                      Constant(value='tier'),
                      Constant(value='title')],
                    values=[
                      Constant(value='Zendesk'),
                      Constant(value=2),
                      Constant(value='AI Product Lead')])],
                ctx=Load())),
            Assign(
              targets=[
                Name(id='peer_jds', ctx=Store())],
              value=List(ctx=Load())),
            For(
              target=Name(id='peer', ctx=Store()),
              iter=Subscript(
                value=Name(id='mock_peers', ctx=Load()),
                slice=Slice(
                  upper=Constant(value=5)),
                ctx=Load()),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='peer_jds', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Call(
                        func=Name(id='PeerJD', ctx=Load()),
                        keywords=[
                          keyword(
                            arg='source_id',
                            value=JoinedStr(
                              values=[
                                FormattedValue(
                                  value=Subscript(
                                    value=Name(id='peer', ctx=Load()),
                                    slice=Constant(value='company'),
                                    ctx=Load()),
                                  conversion=-1),
                                Constant(value='_JD_001')])),
                          keyword(
                            arg='company_name',
                            value=Subscript(
                              value=Name(id='peer', ctx=Load()),
                              slice=Constant(value='company'),
                              ctx=Load())),
                          keyword(
                            arg='company_tier',
                            value=Subscript(
                              value=Name(id='peer', ctx=Load()),
                              slice=Constant(value='tier'),
                              ctx=Load())),
                          keyword(
                            arg='retrieval_confidence',
                            value=BinOp(
                              left=Constant(value=0.85),
                              op=Sub(),
                              right=BinOp(
                                left=Subscript(
                                  value=Name(id='peer', ctx=Load()),
                                  slice=Constant(value='tier'),
                                  ctx=Load()),
                                op=Mult(),
                                right=Constant(value=0.1)))),
                          keyword(
                            arg='job_title',
                            value=Subscript(
                              value=Name(id='peer', ctx=Load()),
                              slice=Constant(value='title'),
                              ctx=Load())),
                          keyword(
                            arg='keywords',
                            value=Call(
                              func=Attribute(
                                value=Name(id='self', ctx=Load()),
                                attr='_extract_peer_keywords',
                                ctx=Load()),
                              args=[
                                Subscript(
                                  value=Name(id='peer', ctx=Load()),
                                  slice=Constant(value='company'),
                                  ctx=Load())]))])]))]),
            Return(
              value=Name(id='peer_jds', ctx=Load()))],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='PeerJD', ctx=Load()),
