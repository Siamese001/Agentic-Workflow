        FunctionDef(
          name='_extract_peer_keywords',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='company',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Extract keywords from peer JD (mock implementation).')),
            Return(
              value=List(
                elts=[
                  Constant(value='AI strategy'),
                  Constant(value='machine learning'),
                  Constant(value='data science'),
                  Constant(value='product development'),
                  Constant(value='team leadership'),
                  Constant(value='innovation')],
                ctx=Load()))],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='_extract_differentiator_keywords',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='job_desc',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='peer_jds',
                annotation=Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Name(id='PeerJD', ctx=Load()),
                  ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Extract keywords that differentiate from peer JDs.')),
            Assign(
              targets=[
                Name(id='target_keywords', ctx=Store())],
              value=Call(
                func=Name(id='set', ctx=Load()),
                args=[
                  Call(
                    func=Attribute(
                      value=Name(id='re', ctx=Load()),
                      attr='findall',
                      ctx=Load()),
                    args=[
                      Constant(value='\\b[A-Za-z]{4,}\\b'),
                      Call(
                        func=Attribute(
                          value=Name(id='job_desc', ctx=Load()),
                          attr='lower',
                          ctx=Load()))])])),
            Assign(
              targets=[
                Name(id='peer_keywords', ctx=Store())],
              value=Call(
                func=Name(id='set', ctx=Load()))),
            For(
              target=Name(id='peer', ctx=Store()),
              iter=Name(id='peer_jds', ctx=Load()),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='peer_keywords', ctx=Load()),
                      attr='update',
                      ctx=Load()),
                    args=[
                      Attribute(
                        value=Name(id='peer', ctx=Load()),
                        attr='keywords',
                        ctx=Load())]))]),
            Assign(
              targets=[
                Name(id='differentiators', ctx=Store())],
              value=BinOp(
                left=Name(id='target_keywords', ctx=Load()),
                op=Sub(),
                right=Name(id='peer_keywords', ctx=Load()))),
            Return(
              value=Subscript(
                value=Call(
                  func=Name(id='list', ctx=Load()),
                  args=[
                    Name(id='differentiators', ctx=Load())]),
                slice=Slice(
                  upper=Constant(value=50)),
                ctx=Load()))],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='_weight_keywords',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='keywords',
                annotation=Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Name(id='str', ctx=Load()),
                  ctx=Load())),
              arg(
                arg='job_desc',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Weight keywords by frequency and table stakes likelihood.')),
            Assign(
              targets=[
                Name(id='weighted', ctx=Store())],
              value=List(ctx=Load())),
            Assign(
              targets=[
                Name(id='job_desc_lower', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='job_desc', ctx=Load()),
                  attr='lower',
                  ctx=Load()))),
            For(
              target=Name(id='keyword', ctx=Store()),
              iter=Name(id='keywords', ctx=Load()),
              body=[
                Assign(
                  targets=[
                    Name(id='frequency', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='job_desc_lower', ctx=Load()),
                      attr='count',
                      ctx=Load()),
                    args=[
                      Call(
                        func=Attribute(
                          value=Name(id='keyword', ctx=Load()),
                          attr='lower',
                          ctx=Load()))])),
                Assign(
                  targets=[
                    Name(id='frequency_score', ctx=Store())],
                  value=Call(
                    func=Name(id='min', ctx=Load()),
                    args=[
                      BinOp(
                        left=Name(id='frequency', ctx=Load()),
                        op=Div(),
                        right=Constant(value=10)),
                      Constant(value=1.0)])),
                Assign(
                  targets=[
                    Name(id='table_stakes_score', ctx=Store())],
                  value=IfExp(
                    test=Compare(
                      left=Name(id='frequency', ctx=Load()),
                      ops=[
                        Gt()],
                      comparators=[
                        Constant(value=5)]),
                    body=Constant(value=0.3),
                    orelse=Constant(value=0.1))),
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='weighted', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Dict(
                        keys=[
                          Constant(value='keyword'),
                          Constant(value='frequency_score'),
                          Constant(value='table_stakes_likelihood')],
                        values=[
                          Name(id='keyword', ctx=Load()),
                          Name(id='frequency_score', ctx=Load()),
                          Name(id='table_stakes_score', ctx=Load())])]))]),
            Return(
              value=Call(
                func=Name(id='sorted', ctx=Load()),
                args=[
                  Name(id='weighted', ctx=Load())],
                keywords=[
                  keyword(
                    arg='key',
                    value=Lambda(
                      args=arguments(
                        args=[
                          arg(arg='x')]),
                      body=Subscript(
                        value=Name(id='x', ctx=Load()),
                        slice=Constant(value='frequency_score'),
                        ctx=Load()))),
                  keyword(
                    arg='reverse',
                    value=Constant(value=True))]))],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Subscript(
              value=Name(id='Dict', ctx=Load()),
              slice=Tuple(
                elts=[
                  Name(id='str', ctx=Load()),
                  Name(id='float', ctx=Load())],
                ctx=Load()),
              ctx=Load()),
            ctx=Load())),
