                    is_async=0)]))],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='_get_fallback_intelligence',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Fallback intelligence when peer JD retrieval disabled.')),
            Return(
              value=Call(
                func=Name(id='CompetitiveIntelligence', ctx=Load()),
                keywords=[
                  keyword(
                    arg='peer_jds_analyzed',
                    value=List(ctx=Load())),
                  keyword(
                    arg='peer_jds_analyzed_count',
                    value=Constant(value=0)),
                  keyword(
                    arg='peer_jds',
