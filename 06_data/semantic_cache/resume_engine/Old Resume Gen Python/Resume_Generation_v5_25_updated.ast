          arg(
            arg='tolerance',
            annotation=Name(id='float', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Validate section length against master resume with tolerance.\n    v5.21: All content counts (company/title/dates/location included).\n    ')),
        Assign(
          targets=[
            Name(id='master_words', ctx=Store())],
          value=Call(
            func=Name(id='calculate_section_words', ctx=Load()),
            args=[
              Name(id='master_section', ctx=Load())])),
        Assign(
          targets=[
            Name(id='tailored_words', ctx=Store())],
          value=Call(
            func=Name(id='calculate_section_words', ctx=Load()),
            args=[
              Name(id='tailored_section', ctx=Load())])),
        Assign(
          targets=[
            Name(id='min_words', ctx=Store())],
          value=Call(
            func=Name(id='int', ctx=Load()),
            args=[
              BinOp(
                left=Name(id='master_words', ctx=Load()),
                op=Mult(),
                right=BinOp(
                  left=Constant(value=1),
                  op=Sub(),
                  right=Name(id='tolerance', ctx=Load())))])),
        Assign(
          targets=[
            Name(id='max_words', ctx=Store())],
          value=Call(
            func=Name(id='int', ctx=Load()),
            args=[
              BinOp(
                left=Name(id='master_words', ctx=Load()),
                op=Mult(),
                right=BinOp(
                  left=Constant(value=1),
                  op=Add(),
                  right=Name(id='tolerance', ctx=Load())))])),
        Assign(
          targets=[
            Name(id='passed', ctx=Store())],
          value=Compare(
            left=Name(id='min_words', ctx=Load()),
            ops=[
              LtE(),
              LtE()],
            comparators=[
