                              Constant(value='Individual Contributor'),
                              Constant(value='Team Collaboration')],
                            ctx=Load())),
                        Assign(
                          targets=[
                            Name(id='confidence', ctx=Store())],
                          value=Constant(value=0.8))])])]),
            Return(
