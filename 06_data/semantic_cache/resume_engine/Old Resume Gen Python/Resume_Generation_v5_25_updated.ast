    ClassDef(
      name='EnhancedQuantitativeValidator',
      body=[
        Expr(
          value=Constant(value='\n    Enhanced quantitative claim validation (v1.9.2).\n    Catches generic claims like "multi-million dollar" without specifics.\n    ')),
        Assign(
          targets=[
            Name(id='FAIL_PATTERNS', ctx=Store())],
          value=List(
            elts=[
              Tuple(
                elts=[
                  Constant(value='\\bmulti-million\\s+dollar\\b(?!\\s+\\$\\d)'),
                  Constant(value='multi-million dollar without specifics')],
                ctx=Load()),
              Tuple(
                elts=[
                  Constant(value='\\bsignificant\\s+(growth|savings|impact)\\b(?!\\s+\\d)'),
                  Constant(value='significant X without metrics')],
                ctx=Load()),
              Tuple(
                elts=[
                  Constant(value='\\bsubstantial\\s+\\w+\\b(?!\\s+\\d)'),
                  Constant(value='substantial X without numbers')],
                ctx=Load()),
              Tuple(
                elts=[
                  Constant(value='\\blarge-scale\\b(?!\\s+\\d)'),
                  Constant(value='large-scale without size')],
                ctx=Load()),
              Tuple(
                elts=[
                  Constant(value='\\bmajor\\s+\\w+\\b(?!\\s+\\d)'),
                  Constant(value='major X without specifics')],
                ctx=Load())],
            ctx=Load())),
        Assign(
          targets=[
            Name(id='PASS_PATTERNS', ctx=Store())],
          value=List(
            elts=[
              Constant(value='\\$\\d+[MBK]\\+'),
              Constant(value='\\d+%'),
              Constant(value='\\d+x'),
              Constant(value='\\$\\d+\\.?\\d*\\s*(?:million|billion|thousand)')],
            ctx=Load())),
        FunctionDef(
          name='validate',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='text',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Validate quantitative claims in text.')),
            Assign(
              targets=[
                Name(id='results', ctx=Store())],
              value=List(ctx=Load())),
            For(
              target=Tuple(
                elts=[
                  Name(id='pattern', ctx=Store()),
                  Name(id='description', ctx=Store())],
                ctx=Store()),
              iter=Attribute(
                value=Name(id='self', ctx=Load()),
                attr='FAIL_PATTERNS',
                ctx=Load()),
              body=[
                Assign(
                  targets=[
                    Name(id='matches', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='re', ctx=Load()),
                      attr='finditer',
                      ctx=Load()),
                    args=[
                      Name(id='pattern', ctx=Load()),
                      Name(id='text', ctx=Load()),
                      Attribute(
                        value=Name(id='re', ctx=Load()),
                        attr='IGNORECASE',
                        ctx=Load())])),
                For(
                  target=Name(id='match', ctx=Store()),
                  iter=Name(id='matches', ctx=Load()),
                  body=[
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Name(id='results', ctx=Load()),
                          attr='append',
                          ctx=Load()),
                        args=[
                          Call(
                            func=Name(id='ValidationResult', ctx=Load()),
                            keywords=[
                              keyword(
                                arg='rule_id',
                                value=Constant(value='VG_QUANTITATIVE_ENHANCED')),
                              keyword(
                                arg='passed',
                                value=Constant(value=False)),
                              keyword(
                                arg='severity',
                                value=Attribute(
                                  value=Name(id='ValidationSeverity', ctx=Load()),
                                  attr='HIGH',
                                  ctx=Load())),
                              keyword(
                                arg='message',
                                value=JoinedStr(
                                  values=[
                                    Constant(value='Generic claim: '),
                                    FormattedValue(
                                      value=Name(id='description', ctx=Load()),
                                      conversion=-1)])),
                              keyword(
                                arg='details',
                                value=Dict(
                                  keys=[
                                    Constant(value='match'),
                                    Constant(value='position')],
                                  values=[
                                    Call(
                                      func=Attribute(
                                        value=Name(id='match', ctx=Load()),
                                        attr='group',
                                        ctx=Load())),
                                    Call(
                                      func=Attribute(
                                        value=Name(id='match', ctx=Load()),
                                        attr='span',
                                        ctx=Load()))]))])]))])]),
            Assign(
              targets=[
                Name(id='has_quantitative', ctx=Store())],
              value=Call(
                func=Name(id='any', ctx=Load()),
                args=[
                  GeneratorExp(
                    elt=Call(
                      func=Attribute(
                        value=Name(id='re', ctx=Load()),
                        attr='search',
                        ctx=Load()),
                      args=[
                        Name(id='p', ctx=Load()),
                        Name(id='text', ctx=Load())]),
                    generators=[
                      comprehension(
                        target=Name(id='p', ctx=Store()),
                        iter=Attribute(
                          value=Name(id='self', ctx=Load()),
                          attr='PASS_PATTERNS',
                          ctx=Load()),
                        is_async=0)])])),
            If(
              test=UnaryOp(
                op=Not(),
                operand=Name(id='results', ctx=Load())),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='results', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Call(
                        func=Name(id='ValidationResult', ctx=Load()),
                        keywords=[
                          keyword(
                            arg='rule_id',
                            value=Constant(value='VG_QUANTITATIVE_ENHANCED')),
                          keyword(
                            arg='passed',
                            value=Name(id='has_quantitative', ctx=Load())),
                          keyword(
                            arg='severity',
                            value=Attribute(
                              value=Name(id='ValidationSeverity', ctx=Load()),
                              attr='MEDIUM',
                              ctx=Load())),
                          keyword(
                            arg='message',
                            value=IfExp(
                              test=Name(id='has_quantitative', ctx=Load()),
                              body=Constant(value='Quantitative claims validated'),
                              orelse=Constant(value='Consider adding specific metrics')))])]))]),
            Return(
              value=Name(id='results', ctx=Load()))],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='ValidationResult', ctx=Load()),
            ctx=Load()))]),
