                      args=[
                        Constant(value='company')]),
                    ops=[
                      Eq()],
                    comparators=[
                      Constant(value='IBM')]),
                  body=[
                    AugAssign(
                      target=Name(id='ibm_words', ctx=Store()),
                      op=Add(),
                      value=Name(id='words', ctx=Load()))])])]),
        If(
          test=Compare(
            left=Name(id='total_words', ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value=0)]),
          body=[
            Return(
              value=Call(
                func=Name(id='ValidationResult', ctx=Load()),
                keywords=[
                  keyword(
                    arg='rule_id',
                    value=Constant(value='WORD_DISTRIBUTION_ERROR')),
