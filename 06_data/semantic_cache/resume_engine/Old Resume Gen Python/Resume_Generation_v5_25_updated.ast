                                func=Attribute(
                                  value=Name(id='text', ctx=Load()),
                                  attr='lower',
                                  ctx=Load()))])],
                        is_async=0)])])),
            Return(
              value=Compare(
                left=Name(id='count', ctx=Load()),
                ops=[
                  GtE()],
                comparators=[
                  Constant(value=2)]))],
          returns=Name(id='bool', ctx=Load()))]),
    ClassDef(
      name='DataEnricher',
      body=[
        Expr(
          value=Constant(value='\n    HOP-2: Enrich bullet pool with canonical verbs, deduplication, etc.\n    ')),
        FunctionDef(
          name='__init__',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='verb_canonicalizer',
                  ctx=Store())],
              value=Call(
                func=Name(id='VerbCanonicalizer', ctx=Load()))),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='duplicate_detector',
                  ctx=Store())],
              value=Call(
                func=Name(id='DuplicateDetector', ctx=Load())))]),
        FunctionDef(
          name='enrich',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='extracted_data',
                annotation=Name(id='Dict', ctx=Load())),
              arg(
                arg='thematic_analysis',
                annotation=Name(id='ThematicAnalysis', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Enrich extracted data with additional metadata.\n        Returns: (enriched_data, validation_results)\n        ')),
            Assign(
              targets=[
                Name(id='validation_results', ctx=Store())],
              value=List(ctx=Load())),
            Assign(
              targets=[
                Name(id='bullet_pool', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='extracted_data', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='bullet_pool'),
                  List(ctx=Load())])),
            For(
              target=Name(id='bullet', ctx=Store()),
              iter=Name(id='bullet_pool', ctx=Load()),
              body=[
                Assign(
                  targets=[
                    Name(id='canonical_verbs', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='verb_canonicalizer',
                        ctx=Load()),
                      attr='canonicalize',
                      ctx=Load()),
                    args=[
                      Call(
                        func=Attribute(
                          value=Name(id='bullet', ctx=Load()),
                          attr='get',
                          ctx=Load()),
                        args=[
                          Constant(value='bullet_text'),
                          Constant(value='')])])),
                Assign(
                  targets=[
                    Subscript(
                      value=Name(id='bullet', ctx=Load()),
                      slice=Constant(value='canonical_verbs'),
                      ctx=Store())],
                  value=Name(id='canonical_verbs', ctx=Load()))]),
            Assign(
              targets=[
                Name(id='duplicates', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='duplicate_detector',
                    ctx=Load()),
                  attr='find_duplicates',
                  ctx=Load()),
                args=[
                  Name(id='bullet_pool', ctx=Load())])),
            If(
              test=Name(id='duplicates', ctx=Load()),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='validation_results', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Call(
                        func=Name(id='ValidationResult', ctx=Load()),
                        keywords=[
                          keyword(
                            arg='rule_id',
                            value=Constant(value='DUPLICATE_BULLETS')),
                          keyword(
                            arg='passed',
                            value=Constant(value=False)),
                          keyword(
                            arg='severity',
                            value=Attribute(
                              value=Name(id='ValidationSeverity', ctx=Load()),
                              attr='MEDIUM',
                              ctx=Load())),
                          keyword(
                            arg='message',
                            value=JoinedStr(
                              values=[
                                Constant(value='Found '),
                                FormattedValue(
                                  value=Call(
                                    func=Name(id='len', ctx=Load()),
                                    args=[
                                      Name(id='duplicates', ctx=Load())]),
                                  conversion=-1),
                                Constant(value=' potential duplicate bullets')])),
                          keyword(
                            arg='details',
                            value=Dict(
                              keys=[
                                Constant(value='duplicates')],
                              values=[
                                Subscript(
                                  value=Name(id='duplicates', ctx=Load()),
                                  slice=Slice(
                                    upper=Constant(value=5)),
                                  ctx=Load())]))])]))],
              orelse=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='validation_results', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Call(
                        func=Name(id='ValidationResult', ctx=Load()),
                        keywords=[
                          keyword(
                            arg='rule_id',
                            value=Constant(value='DUPLICATE_CHECK')),
                          keyword(
                            arg='passed',
                            value=Constant(value=True)),
                          keyword(
                            arg='severity',
                            value=Attribute(
                              value=Name(id='ValidationSeverity', ctx=Load()),
                              attr='INFO',
                              ctx=Load())),
                          keyword(
                            arg='message',
                            value=Constant(value='No duplicate bullets detected'))])]))]),
            Assign(
              targets=[
                Name(id='enriched_data', ctx=Store())],
              value=Dict(
                keys=[
                  None,
                  Constant(value='bullet_pool')],
                values=[
                  Name(id='extracted_data', ctx=Load()),
                  Name(id='bullet_pool', ctx=Load())])),
            Return(
              value=Tuple(
                elts=[
                  Name(id='enriched_data', ctx=Load()),
                  Name(id='validation_results', ctx=Load())],
                ctx=Load()))],
          returns=Subscript(
            value=Name(id='Tuple', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='Dict', ctx=Load()),
                Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Name(id='ValidationResult', ctx=Load()),
                  ctx=Load())],
              ctx=Load()),
            ctx=Load()))]),
    ClassDef(
      name='VerbCanonicalizer',
      body=[
        Expr(
          value=Constant(value='Canonicalize action verbs to approved list.')),
        Assign(
          targets=[
            Name(id='CANONICAL_VERBS', ctx=Store())],
          value=Dict(
            keys=[
              Constant(value='led'),
              Constant(value='built'),
              Constant(value='drove'),
              Constant(value='launched'),
              Constant(value='scaled'),
              Constant(value='delivered'),
              Constant(value='achieved'),
              Constant(value='established'),
              Constant(value='managed'),
              Constant(value='developed')],
            values=[
              List(
                elts=[
                  Constant(value='led'),
                  Constant(value='lead'),
                  Constant(value='leading')],
                ctx=Load()),
              List(
                elts=[
                  Constant(value='built'),
                  Constant(value='build'),
                  Constant(value='building')],
                ctx=Load()),
              List(
                elts=[
                  Constant(value='drove'),
                  Constant(value='drive'),
                  Constant(value='driving')],
                ctx=Load()),
              List(
                elts=[
                  Constant(value='launched'),
                  Constant(value='launch'),
                  Constant(value='launching')],
                ctx=Load()),
              List(
                elts=[
                  Constant(value='scaled'),
                  Constant(value='scale'),
                  Constant(value='scaling')],
                ctx=Load()),
              List(
                elts=[
                  Constant(value='delivered'),
                  Constant(value='deliver'),
                  Constant(value='delivering')],
                ctx=Load()),
              List(
                elts=[
                  Constant(value='achieved'),
                  Constant(value='achieve'),
                  Constant(value='achieving')],
                ctx=Load()),
              List(
                elts=[
                  Constant(value='established'),
                  Constant(value='establish'),
                  Constant(value='establishing')],
                ctx=Load()),
              List(
                elts=[
                  Constant(value='managed'),
                  Constant(value='manage'),
                  Constant(value='managing')],
                ctx=Load()),
              List(
                elts=[
                  Constant(value='developed'),
                  Constant(value='develop'),
                  Constant(value='developing')],
                ctx=Load())])),
        Assign(
          targets=[
            Name(id='FORBIDDEN_VERBS', ctx=Store())],
          value=List(
            elts=[
              Constant(value='pioneered'),
              Constant(value='spearheaded'),
              Constant(value='orchestrated'),
              Constant(value='architected'),
              Constant(value='revolutionized'),
              Constant(value='transformed')],
            ctx=Load())),
        FunctionDef(
          name='canonicalize',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='text',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Extract and canonicalize verbs from text.')),
            Assign(
              targets=[
                Name(id='canonical', ctx=Store())],
              value=List(ctx=Load())),
            Assign(
              targets=[
                Name(id='text_lower', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='text', ctx=Load()),
                  attr='lower',
                  ctx=Load()))),
            For(
              target=Tuple(
                elts=[
                  Name(id='canonical_form', ctx=Store()),
                  Name(id='variants', ctx=Store())],
                ctx=Store()),
              iter=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='CANONICAL_VERBS',
                    ctx=Load()),
                  attr='items',
                  ctx=Load())),
              body=[
                If(
                  test=Call(
                    func=Name(id='any', ctx=Load()),
                    args=[
                      GeneratorExp(
                        elt=Compare(
                          left=Name(id='variant', ctx=Load()),
                          ops=[
                            In()],
                          comparators=[
                            Name(id='text_lower', ctx=Load())]),
                        generators=[
                          comprehension(
                            target=Name(id='variant', ctx=Store()),
                            iter=Name(id='variants', ctx=Load()),
                            is_async=0)])]),
                  body=[
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Name(id='canonical', ctx=Load()),
                          attr='append',
                          ctx=Load()),
                        args=[
                          Name(id='canonical_form', ctx=Load())]))])]),
            Return(
              value=Name(id='canonical', ctx=Load()))],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load()))]),
    ClassDef(
      name='DuplicateDetector',
      body=[
        Expr(
          value=Constant(value='Detect duplicate or near-duplicate bullets using TF-IDF cosine similarity.')),
        FunctionDef(
          name='find_duplicates',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='bullets',
                annotation=Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Name(id='Dict', ctx=Load()),
                  ctx=Load())),
              arg(
                arg='threshold',
                annotation=Name(id='float', ctx=Load()))],
            defaults=[
              Constant(value=0.9)]),
          body=[
            Expr(
              value=Constant(value='\n        Find bullets with cosine similarity >= threshold.\n        Returns: List of (index1, index2, similarity_score)\n        ')),
            Assign(
              targets=[
                Name(id='duplicates', ctx=Store())],
              value=List(ctx=Load())),
            For(
              target=Name(id='i', ctx=Store()),
              iter=Call(
                func=Name(id='range', ctx=Load()),
                args=[
                  Call(
                    func=Name(id='len', ctx=Load()),
                    args=[
                      Name(id='bullets', ctx=Load())])]),
              body=[
                For(
                  target=Name(id='j', ctx=Store()),
                  iter=Call(
                    func=Name(id='range', ctx=Load()),
                    args=[
                      BinOp(
                        left=Name(id='i', ctx=Load()),
                        op=Add(),
                        right=Constant(value=1)),
                      Call(
                        func=Name(id='len', ctx=Load()),
                        args=[
                          Name(id='bullets', ctx=Load())])]),
                  body=[
                    Assign(
                      targets=[
                        Name(id='similarity', ctx=Store())],
                      value=Call(
                        func=Attribute(
                          value=Name(id='self', ctx=Load()),
                          attr='_calculate_cosine_similarity',
                          ctx=Load()),
                        args=[
                          Call(
                            func=Attribute(
                              value=Subscript(
                                value=Name(id='bullets', ctx=Load()),
                                slice=Name(id='i', ctx=Load()),
                                ctx=Load()),
                              attr='get',
                              ctx=Load()),
                            args=[
                              Constant(value='bullet_text'),
                              Constant(value='')]),
                          Call(
                            func=Attribute(
                              value=Subscript(
                                value=Name(id='bullets', ctx=Load()),
                                slice=Name(id='j', ctx=Load()),
                                ctx=Load()),
                              attr='get',
                              ctx=Load()),
                            args=[
                              Constant(value='bullet_text'),
                              Constant(value='')])])),
                    If(
                      test=Compare(
                        left=Name(id='similarity', ctx=Load()),
                        ops=[
                          GtE()],
                        comparators=[
                          Name(id='threshold', ctx=Load())]),
                      body=[
                        Expr(
                          value=Call(
                            func=Attribute(
                              value=Name(id='duplicates', ctx=Load()),
                              attr='append',
                              ctx=Load()),
                            args=[
                              Tuple(
                                elts=[
                                  Name(id='i', ctx=Load()),
                                  Name(id='j', ctx=Load()),
                                  Name(id='similarity', ctx=Load())],
                                ctx=Load())]))])])]),
            Return(
              value=Name(id='duplicates', ctx=Load()))],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Subscript(
              value=Name(id='Tuple', ctx=Load()),
              slice=Tuple(
                elts=[
                  Name(id='int', ctx=Load()),
                  Name(id='int', ctx=Load()),
                  Name(id='float', ctx=Load())],
                ctx=Load()),
              ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='_calculate_cosine_similarity',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='text1',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='text2',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Calculate TF-IDF cosine similarity between two texts.')),
            If(
              test=BoolOp(
                op=Or(),
                values=[
                  UnaryOp(
                    op=Not(),
                    operand=Name(id='text1', ctx=Load())),
                  UnaryOp(
                    op=Not(),
                    operand=Name(id='text2', ctx=Load()))]),
              body=[
                Return(
                  value=Constant(value=0.0))]),
            Assign(
              targets=[
                Name(id='words1', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Call(
                    func=Attribute(
                      value=Name(id='text1', ctx=Load()),
                      attr='lower',
                      ctx=Load())),
                  attr='split',
                  ctx=Load()))),
            Assign(
              targets=[
                Name(id='words2', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Call(
                    func=Attribute(
                      value=Name(id='text2', ctx=Load()),
                      attr='lower',
                      ctx=Load())),
                  attr='split',
                  ctx=Load()))),
            If(
              test=BoolOp(
                op=Or(),
                values=[
                  UnaryOp(
                    op=Not(),
                    operand=Name(id='words1', ctx=Load())),
                  UnaryOp(
                    op=Not(),
                    operand=Name(id='words2', ctx=Load()))]),
              body=[
                Return(
                  value=Constant(value=0.0))]),
            Assign(
              targets=[
                Name(id='vocab', ctx=Store())],
              value=Call(
                func=Name(id='sorted', ctx=Load()),
                args=[
                  Call(
                    func=Name(id='set', ctx=Load()),
                    args=[
                      BinOp(
                        left=Name(id='words1', ctx=Load()),
                        op=Add(),
                        right=Name(id='words2', ctx=Load()))])])),
            Assign(
              targets=[
                Name(id='vec1', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='_tfidf_vector',
                  ctx=Load()),
                args=[
                  Name(id='words1', ctx=Load()),
                  Name(id='vocab', ctx=Load()),
                  List(
                    elts=[
                      Name(id='words1', ctx=Load()),
                      Name(id='words2', ctx=Load())],
                    ctx=Load())])),
            Assign(
              targets=[
                Name(id='vec2', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='_tfidf_vector',
                  ctx=Load()),
                args=[
                  Name(id='words2', ctx=Load()),
                  Name(id='vocab', ctx=Load()),
                  List(
                    elts=[
                      Name(id='words1', ctx=Load()),
                      Name(id='words2', ctx=Load())],
                    ctx=Load())])),
            Assign(
              targets=[
                Name(id='dot_product', ctx=Store())],
              value=Call(
                func=Name(id='sum', ctx=Load()),
                args=[
                  GeneratorExp(
                    elt=BinOp(
                      left=Name(id='v1', ctx=Load()),
                      op=Mult(),
                      right=Name(id='v2', ctx=Load())),
                    generators=[
                      comprehension(
                        target=Tuple(
                          elts=[
                            Name(id='v1', ctx=Store()),
                            Name(id='v2', ctx=Store())],
                          ctx=Store()),
                        iter=Call(
                          func=Name(id='zip', ctx=Load()),
                          args=[
                            Name(id='vec1', ctx=Load()),
                            Name(id='vec2', ctx=Load())]),
                        is_async=0)])])),
            Assign(
              targets=[
                Name(id='magnitude1', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='math', ctx=Load()),
                  attr='sqrt',
                  ctx=Load()),
                args=[
                  Call(
                    func=Name(id='sum', ctx=Load()),
                    args=[
                      GeneratorExp(
                        elt=BinOp(
                          left=Name(id='v', ctx=Load()),
                          op=Mult(),
                          right=Name(id='v', ctx=Load())),
                        generators=[
                          comprehension(
                            target=Name(id='v', ctx=Store()),
                            iter=Name(id='vec1', ctx=Load()),
                            is_async=0)])])])),
            Assign(
              targets=[
                Name(id='magnitude2', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='math', ctx=Load()),
                  attr='sqrt',
                  ctx=Load()),
                args=[
                  Call(
                    func=Name(id='sum', ctx=Load()),
                    args=[
                      GeneratorExp(
                        elt=BinOp(
                          left=Name(id='v', ctx=Load()),
                          op=Mult(),
                          right=Name(id='v', ctx=Load())),
                        generators=[
                          comprehension(
                            target=Name(id='v', ctx=Store()),
                            iter=Name(id='vec2', ctx=Load()),
                            is_async=0)])])])),
            If(
              test=BoolOp(
                op=Or(),
                values=[
                  Compare(
                    left=Name(id='magnitude1', ctx=Load()),
                    ops=[
                      Eq()],
                    comparators=[
                      Constant(value=0)]),
                  Compare(
                    left=Name(id='magnitude2', ctx=Load()),
                    ops=[
                      Eq()],
                    comparators=[
                      Constant(value=0)])]),
              body=[
                Return(
                  value=Constant(value=0.0))]),
            Return(
              value=BinOp(
                left=Name(id='dot_product', ctx=Load()),
                op=Div(),
                right=BinOp(
                  left=Name(id='magnitude1', ctx=Load()),
                  op=Mult(),
                  right=Name(id='magnitude2', ctx=Load()))))],
          returns=Name(id='float', ctx=Load())),
        FunctionDef(
          name='_tfidf_vector',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='words',
                annotation=Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Name(id='str', ctx=Load()),
                  ctx=Load())),
              arg(
                arg='vocab',
                annotation=Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Name(id='str', ctx=Load()),
                  ctx=Load())),
              arg(
                arg='corpus',
                annotation=Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Subscript(
                    value=Name(id='List', ctx=Load()),
                    slice=Name(id='str', ctx=Load()),
                    ctx=Load()),
                  ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Calculate TF-IDF vector for a document.')),
            Assign(
              targets=[
                Name(id='tf', ctx=Store())],
              value=DictComp(
                key=Name(id='word', ctx=Load()),
                value=BinOp(
                  left=Call(
                    func=Attribute(
                      value=Name(id='words', ctx=Load()),
                      attr='count',
                      ctx=Load()),
                    args=[
                      Name(id='word', ctx=Load())]),
                  op=Div(),
                  right=Call(
                    func=Name(id='len', ctx=Load()),
                    args=[
                      Name(id='words', ctx=Load())])),
                generators=[
                  comprehension(
                    target=Name(id='word', ctx=Store()),
                    iter=Name(id='vocab', ctx=Load()),
                    is_async=0)])),
            Assign(
              targets=[
                Name(id='idf', ctx=Store())],
              value=Dict()),
            For(
              target=Name(id='word', ctx=Store()),
              iter=Name(id='vocab', ctx=Load()),
              body=[
                Assign(
                  targets=[
                    Name(id='doc_count', ctx=Store())],
                  value=Call(
                    func=Name(id='sum', ctx=Load()),
                    args=[
                      GeneratorExp(
                        elt=Constant(value=1),
                        generators=[
                          comprehension(
                            target=Name(id='doc', ctx=Store()),
                            iter=Name(id='corpus', ctx=Load()),
                            ifs=[
                              Compare(
                                left=Name(id='word', ctx=Load()),
                                ops=[
                                  In()],
                                comparators=[
                                  Name(id='doc', ctx=Load())])],
                            is_async=0)])])),
                Assign(
                  targets=[
                    Subscript(
                      value=Name(id='idf', ctx=Load()),
                      slice=Name(id='word', ctx=Load()),
                      ctx=Store())],
                  value=BinOp(
                    left=Call(
                      func=Attribute(
                        value=Name(id='math', ctx=Load()),
                        attr='log',
                        ctx=Load()),
                      args=[
                        BinOp(
                          left=BinOp(
                            left=Constant(value=1),
                            op=Add(),
                            right=Call(
                              func=Name(id='len', ctx=Load()),
                              args=[
                                Name(id='corpus', ctx=Load())])),
                          op=Div(),
                          right=BinOp(
                            left=Constant(value=1),
                            op=Add(),
                            right=Name(id='doc_count', ctx=Load())))]),
                    op=Add(),
                    right=Constant(value=1)))]),
            Return(
              value=ListComp(
                elt=BinOp(
                  left=Call(
                    func=Attribute(
                      value=Name(id='tf', ctx=Load()),
                      attr='get',
                      ctx=Load()),
                    args=[
                      Name(id='word', ctx=Load()),
                      Constant(value=0)]),
                  op=Mult(),
                  right=Call(
                    func=Attribute(
                      value=Name(id='idf', ctx=Load()),
                      attr='get',
                      ctx=Load()),
                    args=[
                      Name(id='word', ctx=Load()),
                      Constant(value=0)])),
                generators=[
                  comprehension(
                    target=Name(id='word', ctx=Store()),
