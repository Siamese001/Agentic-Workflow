    FunctionDef(
      name='calculate_section_words',
      args=arguments(
        args=[
          arg(
            arg='section',
            annotation=Name(id='Dict', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Calculate word count for a section.\n    v5.21: Counts ALL content including company/title/dates/location.\n    ')),
        Assign(
          targets=[
            Name(id='total_words', ctx=Store())],
          value=Constant(value=0)),
        If(
          test=Compare(
            left=Constant(value='overview'),
            ops=[
              In()],
            comparators=[
              Name(id='section', ctx=Load())]),
          body=[
            AugAssign(
              target=Name(id='total_words', ctx=Store()),
              op=Add(),
              value=Call(
                func=Name(id='len', ctx=Load()),
                args=[
                  Call(
                    func=Attribute(
                      value=Subscript(
                        value=Name(id='section', ctx=Load()),
                        slice=Constant(value='overview'),
                        ctx=Load()),
                      attr='split',
                      ctx=Load()))]))]),
        For(
          target=Name(id='field', ctx=Store()),
          iter=List(
            elts=[
              Constant(value='company'),
              Constant(value='title'),
              Constant(value='location'),
              Constant(value='start_date'),
              Constant(value='end_date')],
            ctx=Load()),
          body=[
            If(
              test=Compare(
                left=Name(id='field', ctx=Load()),
                ops=[
                  In()],
                comparators=[
                  Name(id='section', ctx=Load())]),
              body=[
                AugAssign(
                  target=Name(id='total_words', ctx=Store()),
                  op=Add(),
                  value=Call(
                    func=Name(id='len', ctx=Load()),
                    args=[
                      Call(
                        func=Attribute(
                          value=Call(
                            func=Name(id='str', ctx=Load()),
                            args=[
                              Subscript(
                                value=Name(id='section', ctx=Load()),
                                slice=Name(id='field', ctx=Load()),
                                ctx=Load())]),
                          attr='split',
                          ctx=Load()))]))])]),
        If(
          test=Compare(
            left=Constant(value='bullets'),
            ops=[
              In()],
            comparators=[
              Name(id='section', ctx=Load())]),
          body=[
            For(
              target=Name(id='bullet', ctx=Store()),
              iter=Subscript(
                value=Name(id='section', ctx=Load()),
                slice=Constant(value='bullets'),
                ctx=Load()),
              body=[
                If(
                  test=Call(
                    func=Name(id='isinstance', ctx=Load()),
                    args=[
                      Name(id='bullet', ctx=Load()),
                      Name(id='str', ctx=Load())]),
                  body=[
                    AugAssign(
                      target=Name(id='total_words', ctx=Store()),
                      op=Add(),
                      value=Call(
                        func=Name(id='len', ctx=Load()),
                        args=[
                          Call(
                            func=Attribute(
                              value=Name(id='bullet', ctx=Load()),
                              attr='split',
                              ctx=Load()))]))])])]),
        Return(
          value=Name(id='total_words', ctx=Load()))],
      returns=Name(id='int', ctx=Load())),
    FunctionDef(
      name='validate_section_length_v57',
      args=arguments(
        args=[
          arg(
