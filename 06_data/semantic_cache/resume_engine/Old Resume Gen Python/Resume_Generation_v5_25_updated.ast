        FunctionDef(
          name='_extract_company_context',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Extract company information and context.')),
            Assign(
              targets=[
                Name(id='context', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='company_description'),
                  Constant(value='industry'),
                  Constant(value='stage'),
                  Constant(value='location')],
                values=[
                  Constant(value=''),
                  Constant(value=''),
                  Constant(value=''),
                  Constant(value='')])),
            Assign(
              targets=[
                Name(id='paragraphs', ctx=Store())],
              value=ListComp(
                elt=Call(
                  func=Attribute(
                    value=Name(id='p', ctx=Load()),
                    attr='strip',
                    ctx=Load())),
                generators=[
                  comprehension(
                    target=Name(id='p', ctx=Store()),
                    iter=Call(
                      func=Attribute(
                        value=Attribute(
                          value=Name(id='self', ctx=Load()),
                          attr='jd_text',
                          ctx=Load()),
                        attr='split',
                        ctx=Load()),
                      args=[
                        Constant(value='\n\n')]),
                    ifs=[
                      Compare(
                        left=Call(
                          func=Name(id='len', ctx=Load()),
                          args=[
                            Call(
                              func=Attribute(
                                value=Name(id='p', ctx=Load()),
                                attr='strip',
                                ctx=Load()))]),
                        ops=[
                          Gt()],
                        comparators=[
                          Constant(value=50)])],
                    is_async=0)])),
            If(
              test=Name(id='paragraphs', ctx=Load()),
              body=[
                Assign(
                  targets=[
                    Subscript(
                      value=Name(id='context', ctx=Load()),
                      slice=Constant(value='company_description'),
                      ctx=Store())],
                  value=Subscript(
                    value=Subscript(
                      value=Name(id='paragraphs', ctx=Load()),
                      slice=Constant(value=0),
                      ctx=Load()),
                    slice=Slice(
                      upper=Constant(value=500)),
                    ctx=Load()))]),
            Assign(
              targets=[
                Name(id='jd_lower', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='jd_text',
                    ctx=Load()),
                  attr='lower',
                  ctx=Load()))),
            If(
              test=Call(
                func=Attribute(
                  value=Name(id='re', ctx=Load()),
                  attr='search',
                  ctx=Load()),
                args=[
                  Constant(value='\\bai\\b|machine learning|artificial intelligence'),
                  Name(id='jd_lower', ctx=Load())]),
              body=[
                Assign(
                  targets=[
                    Subscript(
                      value=Name(id='context', ctx=Load()),
                      slice=Constant(value='industry'),
                      ctx=Store())],
                  value=Constant(value='AI/ML'))],
              orelse=[
                If(
                  test=Call(
                    func=Attribute(
                      value=Name(id='re', ctx=Load()),
                      attr='search',
                      ctx=Load()),
                    args=[
                      Constant(value='fintech|financial services|banking'),
                      Name(id='jd_lower', ctx=Load())]),
                  body=[
                    Assign(
                      targets=[
                        Subscript(
                          value=Name(id='context', ctx=Load()),
                          slice=Constant(value='industry'),
                          ctx=Store())],
                      value=Constant(value='FinTech'))],
                  orelse=[
                    If(
                      test=Call(
                        func=Attribute(
                          value=Name(id='re', ctx=Load()),
                          attr='search',
                          ctx=Load()),
                        args=[
                          Constant(value='healthcare|health tech|medical'),
                          Name(id='jd_lower', ctx=Load())]),
                      body=[
                        Assign(
                          targets=[
                            Subscript(
