                      value=Call(
                        func=Attribute(
                          value=Call(
                            func=Attribute(
                              value=Name(id='company', ctx=Load()),
                              attr='upper',
                              ctx=Load())),
                          attr='replace',
                          ctx=Load()),
                        args=[
                          Constant(value=' '),
                          Constant(value='_')]),
                      conversion=-1)])),
              keyword(
                arg='passed',
                value=Name(id='passed', ctx=Load())),
              keyword(
                arg='severity',
                value=Attribute(
                  value=Name(id='ValidationSeverity', ctx=Load()),
                  attr='HIGH',
                  ctx=Load())),
              keyword(
                arg='message',
                value=JoinedStr(
                  values=[
                    FormattedValue(
                      value=Name(id='company', ctx=Load()),
                      conversion=-1),
                    Constant(value=': '),
                    FormattedValue(
                      value=Name(id='tailored_words', ctx=Load()),
                      conversion=-1),
                    Constant(value=' words (target: '),
                    FormattedValue(
                      value=Name(id='min_words', ctx=Load()),
                      conversion=-1),
                    Constant(value='-'),
                    FormattedValue(
                      value=Name(id='max_words', ctx=Load()),
                      conversion=-1),
                    Constant(value=')')])),
              keyword(
                arg='details',
                value=Dict(
                  keys=[
