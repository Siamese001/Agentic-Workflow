                  value=List(
                    elts=[
                      Constant(value='\\b(mba|master|phd|certification)\\b'),
                      Constant(value='\\b(multilingual|spanish|portuguese|french|german)\\b'),
                      Constant(value='\\b(startup|scale-up|high[-\\s]?growth)\\b'),
                      Constant(value='\\b(saas|enterprise software|b2b)\\b'),
                      Constant(value='\\b(agile|scrum|kanban)\\b')],
