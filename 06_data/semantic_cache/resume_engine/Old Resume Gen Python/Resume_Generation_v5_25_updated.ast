            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load()))]),
    ClassDef(
      name='HallucinationDetector',
      body=[
        Expr(
          value=Constant(value='\n    Detect potential hallucinations in resume content.\n    Flags implausible metrics, temporal inconsistencies, etc.\n    ')),
        FunctionDef(
          name='detect',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='bullet_pool',
                annotation=Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Name(id='Dict', ctx=Load()),
                  ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Run hallucination detection on bullet pool.\n        Returns: List of validation results\n        ')),
            Assign(
              targets=[
                Name(id='results', ctx=Store())],
              value=List(ctx=Load())),
            For(
              target=Tuple(
                elts=[
                  Name(id='i', ctx=Store()),
                  Name(id='bullet', ctx=Store())],
                ctx=Store()),
              iter=Call(
                func=Name(id='enumerate', ctx=Load()),
                args=[
                  Name(id='bullet_pool', ctx=Load())]),
              body=[
                Assign(
                  targets=[
                    Name(id='text', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='bullet', ctx=Load()),
                      attr='get',
                      ctx=Load()),
                    args=[
                      Constant(value='bullet_text'),
                      Constant(value='')])),
                If(
                  test=Call(
                    func=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='_has_implausible_growth',
                      ctx=Load()),
                    args=[
                      Name(id='text', ctx=Load())]),
                  body=[
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Name(id='results', ctx=Load()),
                          attr='append',
                          ctx=Load()),
                        args=[
                          Call(
                            func=Name(id='ValidationResult', ctx=Load()),
                            keywords=[
                              keyword(
                                arg='rule_id',
                                value=Constant(value='HALLUCINATION_IMPLAUSIBLE_GROWTH')),
                              keyword(
                                arg='passed',
                                value=Constant(value=False)),
                              keyword(
                                arg='severity',
                                value=Attribute(
                                  value=Name(id='ValidationSeverity', ctx=Load()),
                                  attr='HIGH',
                                  ctx=Load())),
                              keyword(
                                arg='message',
                                value=JoinedStr(
                                  values=[
                                    Constant(value='Bullet '),
                                    FormattedValue(
                                      value=BinOp(
                                        left=Name(id='i', ctx=Load()),
                                        op=Add(),
                                        right=Constant(value=1)),
                                      conversion=-1),
                                    Constant(value=' may contain implausible growth rate')])),
                              keyword(
                                arg='details',
                                value=Dict(
                                  keys=[
                                    Constant(value='bullet_text')],
                                  values=[
                                    Subscript(
                                      value=Name(id='text', ctx=Load()),
                                      slice=Slice(
                                        upper=Constant(value=100)),
                                      ctx=Load())]))])]))]),
                If(
                  test=Call(
                    func=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='_has_excessive_superlatives',
                      ctx=Load()),
                    args=[
                      Name(id='text', ctx=Load())]),
                  body=[
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Name(id='results', ctx=Load()),
                          attr='append',
                          ctx=Load()),
                        args=[
                          Call(
                            func=Name(id='ValidationResult', ctx=Load()),
                            keywords=[
                              keyword(
                                arg='rule_id',
                                value=Constant(value='HALLUCINATION_EXCESSIVE_SUPERLATIVES')),
                              keyword(
                                arg='passed',
                                value=Constant(value=False)),
                              keyword(
                                arg='severity',
                                value=Attribute(
                                  value=Name(id='ValidationSeverity', ctx=Load()),
                                  attr='MEDIUM',
                                  ctx=Load())),
                              keyword(
                                arg='message',
                                value=JoinedStr(
                                  values=[
                                    Constant(value='Bullet '),
                                    FormattedValue(
                                      value=BinOp(
                                        left=Name(id='i', ctx=Load()),
                                        op=Add(),
                                        right=Constant(value=1)),
                                      conversion=-1),
                                    Constant(value=' contains excessive superlatives')])),
                              keyword(
                                arg='details',
                                value=Dict(
                                  keys=[
                                    Constant(value='bullet_text')],
                                  values=[
                                    Subscript(
                                      value=Name(id='text', ctx=Load()),
                                      slice=Slice(
                                        upper=Constant(value=100)),
                                      ctx=Load())]))])]))])]),
            If(
              test=UnaryOp(
                op=Not(),
                operand=Name(id='results', ctx=Load())),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='results', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Call(
                        func=Name(id='ValidationResult', ctx=Load()),
                        keywords=[
                          keyword(
                            arg='rule_id',
                            value=Constant(value='HALLUCINATION_CHECK')),
                          keyword(
                            arg='passed',
                            value=Constant(value=True)),
                          keyword(
                            arg='severity',
                            value=Attribute(
                              value=Name(id='ValidationSeverity', ctx=Load()),
                              attr='INFO',
                              ctx=Load())),
                          keyword(
                            arg='message',
                            value=JoinedStr(
                              values=[
                                Constant(value='No hallucinations detected in '),
                                FormattedValue(
                                  value=Call(
                                    func=Name(id='len', ctx=Load()),
                                    args=[
                                      Name(id='bullet_pool', ctx=Load())]),
                                  conversion=-1),
                                Constant(value=' bullets')]))])]))]),
            Return(
              value=Name(id='results', ctx=Load()))],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='ValidationResult', ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='_has_implausible_growth',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='text',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Check for implausibly high growth rates (>10x in short time).')),
            Assign(
              targets=[
                Name(id='growth_patterns', ctx=Store())],
              value=List(
                elts=[
                  Constant(value='\\d{3,}%'),
                  Constant(value='\\d+x')],
                ctx=Load())),
            For(
              target=Name(id='pattern', ctx=Store()),
              iter=Name(id='growth_patterns', ctx=Load()),
              body=[
                If(
                  test=Call(
                    func=Attribute(
                      value=Name(id='re', ctx=Load()),
                      attr='search',
                      ctx=Load()),
                    args=[
                      Name(id='pattern', ctx=Load()),
                      Name(id='text', ctx=Load())]),
                  body=[
                    If(
                      test=Call(
                        func=Name(id='any', ctx=Load()),
                        args=[
                          GeneratorExp(
                            elt=Compare(
                              left=Name(id='term', ctx=Load()),
                              ops=[
                                In()],
                              comparators=[
                                Call(
                                  func=Attribute(
                                    value=Name(id='text', ctx=Load()),
                                    attr='lower',
                                    ctx=Load()))]),
                            generators=[
                              comprehension(
                                target=Name(id='term', ctx=Store()),
                                iter=List(
                                  elts=[
                                    Constant(value='month'),
                                    Constant(value='quarter'),
                                    Constant(value='90 day')],
                                  ctx=Load()),
                                is_async=0)])]),
                      body=[
                        Return(
                          value=Constant(value=True))])])]),
            Return(
              value=Constant(value=False))],
          returns=Name(id='bool', ctx=Load())),
        FunctionDef(
          name='_has_excessive_superlatives',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='text',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Check for excessive use of superlatives.')),
            Assign(
              targets=[
                Name(id='superlatives', ctx=Store())],
              value=List(
                elts=[
                  Constant(value='revolutionary'),
                  Constant(value='groundbreaking'),
                  Constant(value='unprecedented'),
                  Constant(value='unparalleled'),
                  Constant(value='game-changing'),
                  Constant(value='world-class'),
                  Constant(value='best-in-class'),
                  Constant(value='cutting-edge')],
                ctx=Load())),
            Assign(
              targets=[
                Name(id='count', ctx=Store())],
              value=Call(
                func=Name(id='sum', ctx=Load()),
                args=[
                  GeneratorExp(
                    elt=Constant(value=1),
                    generators=[
                      comprehension(
                        target=Name(id='word', ctx=Store()),
                        iter=Name(id='superlatives', ctx=Load()),
                        ifs=[
                          Compare(
                            left=Name(id='word', ctx=Load()),
                            ops=[
                              In()],
                            comparators=[
