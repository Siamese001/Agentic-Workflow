          simple=1),
        FunctionDef(
          name='get_top_differentiators',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='n',
                annotation=Name(id='int', ctx=Load()))],
            defaults=[
              Constant(value=12)]),
          body=[
            Expr(
              value=Constant(value='Return top N differentiator keywords.')),
            Assign(
              targets=[
                Name(id='sorted_keywords', ctx=Store())],
              value=Call(
                func=Name(id='sorted', ctx=Load()),
                args=[
                  Attribute(
