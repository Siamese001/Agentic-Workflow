                                Subscript(
                                  value=Name(id='context', ctx=Load()),
                                  slice=Constant(value='industry'),
                                  ctx=Store())],
                              value=Constant(value='Technology'))])])])]),
            If(
              test=Call(
                func=Attribute(
                  value=Name(id='re', ctx=Load()),
                  attr='search',
                  ctx=Load()),
                args=[
                  Constant(value='series [a-d]|startup|scale[-\\s]?up'),
                  Name(id='jd_lower', ctx=Load())]),
              body=[
                Assign(
                  targets=[
                    Subscript(
                      value=Name(id='context', ctx=Load()),
                      slice=Constant(value='stage'),
                      ctx=Store())],
                  value=Constant(value='Growth-stage'))],
              orelse=[
                If(
                  test=Call(
                    func=Attribute(
                      value=Name(id='re', ctx=Load()),
                      attr='search',
