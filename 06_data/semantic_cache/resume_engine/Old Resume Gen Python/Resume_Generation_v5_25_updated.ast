                          right=Subscript(
                            value=Name(id='x', ctx=Load()),
                            slice=Constant(value='table_stakes_likelihood'),
                            ctx=Load()))))),
                  keyword(
                    arg='reverse',
                    value=Constant(value=True))])),
            Return(
              value=ListComp(
                elt=Subscript(
                  value=Name(id='kw', ctx=Load()),
                  slice=Constant(value='keyword'),
                  ctx=Load()),
                generators=[
                  comprehension(
                    target=Name(id='kw', ctx=Store()),
                    iter=Subscript(
                      value=Name(id='sorted_keywords', ctx=Load()),
                      slice=Slice(
                        upper=Name(id='n', ctx=Load())),
                      ctx=Load()),
                    is_async=0)]))],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load()))],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
