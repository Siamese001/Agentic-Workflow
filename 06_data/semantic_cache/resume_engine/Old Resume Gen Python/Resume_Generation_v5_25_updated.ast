                keywords=[
                  keyword(
                    arg='key',
                    value=Lambda(
                      args=arguments(
                        args=[
                          arg(arg='x')]),
                      body=BinOp(
                        left=Subscript(
                          value=Name(id='x', ctx=Load()),
                          slice=Constant(value='frequency_score'),
