            op=Mult(),
            right=Constant(value=100))),
        Assign(
          targets=[
            Tuple(
              elts=[
                Name(id='min_percent', ctx=Store()),
                Name(id='max_percent', ctx=Store())],
              ctx=Store())],
          value=Subscript(
            value=Subscript(
              value=Name(id='SECTION_CONSTRAINTS_V521', ctx=Load()),
              slice=Constant(value='word_distribution'),
              ctx=Load()),
            slice=Constant(value='unify_ibm_combined_percent'),
            ctx=Load())),
        Assign(
          targets=[
            Name(id='passed', ctx=Store())],
          value=Compare(
            left=Name(id='min_percent', ctx=Load()),
            ops=[
              LtE(),
              LtE()],
            comparators=[
              Name(id='combined_percent', ctx=Load()),
