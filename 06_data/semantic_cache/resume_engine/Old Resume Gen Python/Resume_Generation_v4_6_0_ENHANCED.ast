                      ctx=Load()),
                    args=[
                      BinOp(
                        left=BinOp(
                          left=Constant(value='\\b'),
                          op=Add(),
                          right=Name(id='jargon', ctx=Load())),
                        op=Add(),
                        right=Constant(value='\\b')),
                      Name(id='simple', ctx=Load()),
                      Name(id='text', ctx=Load())],
                    keywords=[
                      keyword(
                        arg='flags',
                        value=Attribute(
                          value=Name(id='re', ctx=Load()),
                          attr='IGNORECASE',
                          ctx=Load()))]))]),
            Return(
              value=Name(id='text', ctx=Load()))],
          decorator_list=[
            Name(id='classmethod', ctx=Load())],
          returns=Name(id='str', ctx=Load()))]),
