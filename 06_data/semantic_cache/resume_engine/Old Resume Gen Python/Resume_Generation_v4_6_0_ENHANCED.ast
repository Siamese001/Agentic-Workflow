          decorator_list=[
            Name(id='classmethod', ctx=Load())],
          returns=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='str', ctx=Load())],
              ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='validate_record',
          args=arguments(
            args=[
              arg(arg='cls'),
              arg(
                arg='record',
                annotation=Name(id='Dict', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Validate a record has all required fields.')),
            Assign(
              targets=[
                Name(id='errors', ctx=Store())],
              value=List(ctx=Load())),
            For(
              target=Name(id='field', ctx=Store()),
              iter=Attribute(
                value=Name(id='cls', ctx=Load()),
                attr='SCHEMA_FIELDS',
                ctx=Load()),
              body=[
                If(
                  test=Compare(
                    left=Name(id='field', ctx=Load()),
                    ops=[
                      NotIn()],
                    comparators=[
                      Name(id='record', ctx=Load())]),
                  body=[
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Name(id='errors', ctx=Load()),
                          attr='append',
                          ctx=Load()),
                        args=[
                          JoinedStr(
                            values=[
                              Constant(value='Missing field: '),
                              FormattedValue(
                                value=Name(id='field', ctx=Load()),
                                conversion=-1)])]))])]),
            Return(
              value=Tuple(
                elts=[
                  Compare(
                    left=Call(
                      func=Name(id='len', ctx=Load()),
