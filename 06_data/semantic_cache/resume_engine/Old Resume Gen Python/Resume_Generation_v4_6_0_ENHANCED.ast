            Assign(
              targets=[
                Name(id='headline', ctx=Store())],
              value=Constant(value='Chief AI Officer | LLM Product Launches | Strategic AI Partnerships')),
            If(
              test=Compare(
                left=Constant(value='presales'),
                ops=[
                  In()],
                comparators=[
                  Call(
                    func=Attribute(
                      value=Name(id='target_role', ctx=Load()),
                      attr='lower',
                      ctx=Load()))]),
              body=[
                Assign(
                  targets=[
                    Name(id='headline', ctx=Store())],
                  value=Constant(value='VP Pre-Sales Engineering | AI/ML Solutions | Enterprise Transformation'))],
