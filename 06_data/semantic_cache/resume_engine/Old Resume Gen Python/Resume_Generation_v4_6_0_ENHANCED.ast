        FunctionDef(
          name='fix_spacing',
          args=arguments(
            args=[
              arg(arg='cls'),
              arg(
                arg='text',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Fix spacing issues around punctuation.')),
            Assign(
              targets=[
                Name(id='text', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='re', ctx=Load()),
                  attr='sub',
                  ctx=Load()),
                args=[
                  Constant(value='\\s+([,.?!])'),
                  Constant(value='\\1'),
                  Name(id='text', ctx=Load())])),
            Assign(
              targets=[
                Name(id='text', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='re', ctx=Load()),
                  attr='sub',
                  ctx=Load()),
                args=[
                  Constant(value='([,.?!])(\\S)'),
                  Constant(value='\\1 \\2'),
                  Name(id='text', ctx=Load())])),
            Assign(
              targets=[
                Name(id='text', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='re', ctx=Load()),
