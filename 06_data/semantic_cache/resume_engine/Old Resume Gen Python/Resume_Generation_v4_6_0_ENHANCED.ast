                  Constant(value='encourage')])),
            For(
              target=Tuple(
                elts=[
                  Name(id='jargon', ctx=Store()),
                  Name(id='simple', ctx=Store())],
                ctx=Store()),
              iter=Call(
                func=Attribute(
                  value=Name(id='replacements', ctx=Load()),
                  attr='items',
                  ctx=Load())),
              body=[
                Assign(
                  targets=[
                    Name(id='text', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='re', ctx=Load()),
