              ctx=Load()),
            ctx=Load()))]),
    ClassDef(
      name='AppTrackerQA',
      body=[
        Expr(
          value=Constant(value='\n    Application Tracker QA v5 with R1-R23 validation rules.\n    Embedded from App_Tracker_QA_v5.json\n    ')),
        Assign(
          targets=[
            Name(id='CONTROLLED_ENUMS', ctx=Store())],
          value=Dict(
            keys=[
              Constant(value='Pipeline Status'),
              Constant(value='Outreach Channel'),
              Constant(value='Closure Reason')],
            values=[
              List(
                elts=[
                  Constant(value='Applied'),
                  Constant(value='Follow-Up'),
                  Constant(value='Interview'),
                  Constant(value='Rejected'),
                  Constant(value='Closed'),
                  Constant(value='Waiting')],
                ctx=Load()),
              List(
                elts=[
                  Constant(value='Recruiter Outreach'),
                  Constant(value='Contact Outreach'),
                  Constant(value='Blended Outreach'),
                  Constant(value='No Outreach'),
                  Constant(value='')],
                ctx=Load()),
              List(
                elts=[
                  Constant(value='Rejected'),
                  Constant(value='No Reply'),
                  Constant(value='Role Filled'),
                  Constant(value='On Hold'),
                  Constant(value='Withdrawn by Candidate'),
                  Constant(value='Internal Hire'),
                  Constant(value='Changed Scope'),
                  Constant(value='Role Too Junior'),
                  Constant(value='')],
                ctx=Load())])),
        Assign(
          targets=[
            Name(id='VALIDATION_RULES', ctx=Store())],
          value=Dict(
            keys=[
              Constant(value='R1'),
              Constant(value='R2'),
              Constant(value='R3'),
              Constant(value='R4'),
              Constant(value='R5a'),
              Constant(value='R5b'),
              Constant(value='R5c'),
              Constant(value='R5d'),
              Constant(value='R10'),
              Constant(value='R11'),
              Constant(value='R12'),
              Constant(value='R13'),
              Constant(value='R14'),
              Constant(value='R15'),
              Constant(value='R16'),
              Constant(value='R17'),
              Constant(value='R18'),
              Constant(value='R19'),
              Constant(value='R20'),
              Constant(value='R21'),
              Constant(value='R22'),
              Constant(value='R23')],
            values=[
              Constant(value='Schema must have exactly 54 fields in specified order'),
              Constant(value='Pipeline Status must be from controlled enum'),
              Constant(value='Outreach Channel must be from controlled enum'),
              Constant(value='Closure Reason must be from controlled enum'),
              Constant(value='Recruiter Outreach requires Recruiter/Contact 1 Name'),
              Constant(value='Contact Outreach requires Recruiter/Contact 1 Name'),
              Constant(value='Blended Outreach requires Recruiter/Contact 1 and 2 Names'),
              Constant(value='No Outreach allows all recruiter fields blank'),
              Constant(value='If JD URL present, Application Date required (MM/DD/YYYY)'),
              Constant(value='Date Communication Sent must be MM/DD/YYYY if present'),
              Constant(value='Follow-up dates must be after communication date'),
              Constant(value='Rejected status requires Closure Reason'),
              Constant(value='Closed status requires Closure Reason'),
              Constant(value='Applied/Interview/Waiting should not have Closure Reason'),
              Constant(value='Recruiter fields must be all-or-none per index'),
              Constant(value='JD URL must return HTTP 200'),
              Constant(value='LinkedIn URLs must be canonical format'),
              Constant(value='No duplicate Company+Job Title combinations'),
              Constant(value='Versioned Resume must match pattern'),
              Constant(value='Company name must be single value'),
              Constant(value='Job Title must be single value'),
              Constant(value='Include audit metadata (run_sha, actor_id, timestamp)')])),
        FunctionDef(
          name='validate_pipeline_status',
          args=arguments(
            args=[
              arg(arg='cls'),
              arg(
                arg='status',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Validate Pipeline Status (R2).')),
            If(
              test=Compare(
                left=Name(id='status', ctx=Load()),
                ops=[
                  NotIn()],
                comparators=[
                  Subscript(
                    value=Attribute(
                      value=Name(id='cls', ctx=Load()),
                      attr='CONTROLLED_ENUMS',
                      ctx=Load()),
                    slice=Constant(value='Pipeline Status'),
                    ctx=Load())]),
              body=[
                Return(
                  value=Tuple(
                    elts=[
                      Constant(value=False),
                      JoinedStr(
                        values=[
                          Constant(value='Invalid Pipeline Status: '),
                          FormattedValue(
                            value=Name(id='status', ctx=Load()),
                            conversion=-1)])],
                    ctx=Load()))]),
            Return(
              value=Tuple(
                elts=[
                  Constant(value=True),
                  Constant(value='Valid')],
                ctx=Load()))],
          decorator_list=[
            Name(id='classmethod', ctx=Load())],
          returns=Subscript(
            value=Name(id='Tuple', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='bool', ctx=Load()),
                Name(id='str', ctx=Load())],
              ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='validate_outreach_channel',
          args=arguments(
            args=[
              arg(arg='cls'),
              arg(
                arg='channel',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Validate Outreach Channel (R3).')),
            If(
              test=Compare(
                left=Name(id='channel', ctx=Load()),
                ops=[
                  NotIn()],
                comparators=[
                  Subscript(
                    value=Attribute(
                      value=Name(id='cls', ctx=Load()),
                      attr='CONTROLLED_ENUMS',
                      ctx=Load()),
                    slice=Constant(value='Outreach Channel'),
                    ctx=Load())]),
              body=[
                Return(
                  value=Tuple(
                    elts=[
                      Constant(value=False),
                      JoinedStr(
                        values=[
                          Constant(value='Invalid Outreach Channel: '),
                          FormattedValue(
                            value=Name(id='channel', ctx=Load()),
                            conversion=-1)])],
                    ctx=Load()))]),
            Return(
              value=Tuple(
                elts=[
                  Constant(value=True),
                  Constant(value='Valid')],
                ctx=Load()))],
          decorator_list=[
            Name(id='classmethod', ctx=Load())],
          returns=Subscript(
            value=Name(id='Tuple', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='bool', ctx=Load()),
                Name(id='str', ctx=Load())],
              ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='validate_closure_reason',
          args=arguments(
            args=[
              arg(arg='cls'),
              arg(
                arg='reason',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='status',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Validate Closure Reason based on Pipeline Status (R4, R13-R15).')),
            If(
              test=BoolOp(
                op=And(),
                values=[
                  Compare(
                    left=Name(id='status', ctx=Load()),
                    ops=[
                      In()],
                    comparators=[
                      List(
                        elts=[
                          Constant(value='Rejected'),
                          Constant(value='Closed')],
                        ctx=Load())]),
                  UnaryOp(
                    op=Not(),
                    operand=Name(id='reason', ctx=Load()))]),
              body=[
                Return(
                  value=Tuple(
                    elts=[
                      Constant(value=False),
                      JoinedStr(
                        values=[
                          Constant(value='Status '),
                          FormattedValue(
                            value=Name(id='status', ctx=Load()),
                            conversion=-1),
                          Constant(value=' requires Closure Reason')])],
                    ctx=Load()))]),
            If(
              test=BoolOp(
                op=And(),
                values=[
                  Compare(
                    left=Name(id='status', ctx=Load()),
                    ops=[
                      In()],
                    comparators=[
                      List(
                        elts=[
                          Constant(value='Applied'),
                          Constant(value='Interview'),
                          Constant(value='Waiting')],
                        ctx=Load())]),
                  Name(id='reason', ctx=Load())]),
              body=[
                Return(
                  value=Tuple(
                    elts=[
                      Constant(value=False),
                      JoinedStr(
                        values=[
                          Constant(value='Status '),
                          FormattedValue(
                            value=Name(id='status', ctx=Load()),
                            conversion=-1),
                          Constant(value=' should not have Closure Reason')])],
                    ctx=Load()))]),
            If(
              test=BoolOp(
                op=And(),
                values=[
                  Name(id='reason', ctx=Load()),
                  Compare(
                    left=Name(id='reason', ctx=Load()),
                    ops=[
                      NotIn()],
                    comparators=[
                      Subscript(
                        value=Attribute(
                          value=Name(id='cls', ctx=Load()),
                          attr='CONTROLLED_ENUMS',
                          ctx=Load()),
                        slice=Constant(value='Closure Reason'),
                        ctx=Load())])]),
              body=[
                Return(
                  value=Tuple(
                    elts=[
                      Constant(value=False),
                      JoinedStr(
                        values=[
                          Constant(value='Invalid Closure Reason: '),
                          FormattedValue(
                            value=Name(id='reason', ctx=Load()),
                            conversion=-1)])],
                    ctx=Load()))]),
            Return(
              value=Tuple(
                elts=[
                  Constant(value=True),
                  Constant(value='Valid')],
                ctx=Load()))],
          decorator_list=[
            Name(id='classmethod', ctx=Load())],
          returns=Subscript(
            value=Name(id='Tuple', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='bool', ctx=Load()),
                Name(id='str', ctx=Load())],
              ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='validate_date_format',
          args=arguments(
            args=[
              arg(arg='cls'),
              arg(
                arg='date_str',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Validate date format MM/DD/YYYY (R10-R12).')),
            If(
              test=UnaryOp(
                op=Not(),
                operand=Name(id='date_str', ctx=Load())),
              body=[
                Return(
                  value=Tuple(
                    elts=[
                      Constant(value=True),
                      Constant(value='Empty date allowed')],
                    ctx=Load()))]),
            Assign(
              targets=[
                Name(id='pattern', ctx=Store())],
              value=Constant(value='^\\d{2}/\\d{2}/\\d{4}$')),
            If(
              test=UnaryOp(
                op=Not(),
                operand=Call(
                  func=Attribute(
                    value=Name(id='re', ctx=Load()),
                    attr='match',
                    ctx=Load()),
                  args=[
                    Name(id='pattern', ctx=Load()),
                    Name(id='date_str', ctx=Load())])),
              body=[
                Return(
                  value=Tuple(
                    elts=[
                      Constant(value=False),
                      JoinedStr(
                        values=[
                          Constant(value='Invalid date format: '),
