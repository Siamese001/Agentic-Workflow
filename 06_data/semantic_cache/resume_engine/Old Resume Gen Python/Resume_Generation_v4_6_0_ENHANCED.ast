                    comparators=[
                      Call(
                        func=Attribute(
                          value=Name(id='target_role', ctx=Load()),
                          attr='lower',
                          ctx=Load()))]),
                  body=[
                    Assign(
                      targets=[
                        Name(id='headline', ctx=Store())],
                      value=Constant(value='VP Product | AI Platform Strategy | B2B SaaS Growth'))],
                  orelse=[
                    If(
                      test=BoolOp(
                        op=Or(),
                        values=[
                          Compare(
                            left=Constant(value='ai'),
                            ops=[
                              In()],
                            comparators=[
                              Call(
