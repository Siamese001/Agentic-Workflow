        FunctionDef(
          name='select_skills_for_jd',
          args=arguments(
            args=[
              arg(arg='cls'),
              arg(
                arg='jd_text',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='target_role',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='count',
                annotation=Name(id='int', ctx=Load()))],
            defaults=[
              Constant(value=12)]),
          body=[
            Expr(
              value=Constant(value='\n        Select top 12 skills based on JD keyword matching.\n        Returns numbered list (1-12) for K.11 section.\n        ')),
            Assign(
              targets=[
                Name(id='jd_lower', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='jd_text', ctx=Load()),
                  attr='lower',
                  ctx=Load()))),
            Assign(
              targets=[
                Name(id='skill_scores', ctx=Store())],
              value=Dict()),
            For(
              target=Tuple(
                elts=[
                  Name(id='category', ctx=Store()),
                  Name(id='skills', ctx=Store())],
                ctx=Store()),
              iter=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='cls', ctx=Load()),
                    attr='SKILLS_POOL',
                    ctx=Load()),
                  attr='items',
                  ctx=Load())),
              body=[
                Assign(
                  targets=[
                    Name(id='category_boost', ctx=Store())],
                  value=Constant(value=1.0)),
                If(
                  test=BoolOp(
                    op=And(),
                    values=[
                      Compare(
                        left=Constant(value='presales'),
                        ops=[
                          In()],
                        comparators=[
                          Call(
                            func=Attribute(
                              value=Name(id='target_role', ctx=Load()),
                              attr='lower',
                              ctx=Load()))]),
                      Compare(
                        left=Name(id='category', ctx=Load()),
                        ops=[
                          Eq()],
                        comparators=[
                          Constant(value='presales_tools')])]),
                  body=[
                    Assign(
                      targets=[
                        Name(id='category_boost', ctx=Store())],
                      value=Constant(value=2.0))],
                  orelse=[
                    If(
                      test=BoolOp(
                        op=And(),
                        values=[
                          Compare(
                            left=Constant(value='ai'),
                            ops=[
                              In()],
                            comparators=[
                              Call(
                                func=Attribute(
                                  value=Name(id='target_role', ctx=Load()),
                                  attr='lower',
                                  ctx=Load()))]),
                          Compare(
                            left=Name(id='category', ctx=Load()),
                            ops=[
                              Eq()],
                            comparators=[
                              Constant(value='ai_ml')])]),
                      body=[
                        Assign(
                          targets=[
                            Name(id='category_boost', ctx=Store())],
                          value=Constant(value=2.0))],
                      orelse=[
                        If(
                          test=BoolOp(
                            op=And(),
                            values=[
                              Compare(
                                left=Constant(value='data'),
                                ops=[
                                  In()],
                                comparators=[
                                  Call(
                                    func=Attribute(
                                      value=Name(id='target_role', ctx=Load()),
                                      attr='lower',
                                      ctx=Load()))]),
                              Compare(
                                left=Name(id='category', ctx=Load()),
                                ops=[
                                  Eq()],
                                comparators=[
                                  Constant(value='data_engineering')])]),
                          body=[
                            Assign(
                              targets=[
                                Name(id='category_boost', ctx=Store())],
                              value=Constant(value=1.5))])])]),
                For(
                  target=Name(id='skill', ctx=Store()),
                  iter=Name(id='skills', ctx=Load()),
                  body=[
                    Assign(
                      targets=[
                        Name(id='score', ctx=Store())],
                      value=Constant(value=0)),
                    Assign(
                      targets=[
                        Name(id='skill_lower', ctx=Store())],
                      value=Call(
                        func=Attribute(
                          value=Name(id='skill', ctx=Load()),
                          attr='lower',
                          ctx=Load()))),
                    If(
                      test=Compare(
                        left=Name(id='skill_lower', ctx=Load()),
                        ops=[
                          In()],
                        comparators=[
                          Name(id='jd_lower', ctx=Load())]),
                      body=[
                        AugAssign(
                          target=Name(id='score', ctx=Store()),
                          op=Add(),
                          value=Constant(value=3.0))]),
                    Assign(
                      targets=[
                        Name(id='skill_words', ctx=Store())],
                      value=Call(
                        func=Attribute(
                          value=Name(id='skill_lower', ctx=Load()),
                          attr='split',
                          ctx=Load()))),
                    For(
                      target=Name(id='word', ctx=Store()),
                      iter=Name(id='skill_words', ctx=Load()),
                      body=[
                        If(
                          test=BoolOp(
                            op=And(),
                            values=[
                              Compare(
                                left=Call(
                                  func=Name(id='len', ctx=Load()),
                                  args=[
                                    Name(id='word', ctx=Load())]),
                                ops=[
                                  Gt()],
                                comparators=[
                                  Constant(value=3)]),
                              Compare(
                                left=Name(id='word', ctx=Load()),
                                ops=[
                                  In()],
                                comparators=[
                                  Name(id='jd_lower', ctx=Load())])]),
                          body=[
                            AugAssign(
                              target=Name(id='score', ctx=Store()),
                              op=Add(),
                              value=Constant(value=1.0))])]),
                    AugAssign(
                      target=Name(id='score', ctx=Store()),
                      op=Mult(),
                      value=Name(id='category_boost', ctx=Load())),
                    If(
                      test=Compare(
                        left=Name(id='score', ctx=Load()),
                        ops=[
                          Gt()],
                        comparators=[
                          Constant(value=0)]),
                      body=[
                        Assign(
                          targets=[
                            Subscript(
                              value=Name(id='skill_scores', ctx=Load()),
                              slice=Name(id='skill', ctx=Load()),
                              ctx=Store())],
                          value=Name(id='score', ctx=Load()))])])]),
            Assign(
              targets=[
                Name(id='sorted_skills', ctx=Store())],
              value=Call(
                func=Name(id='sorted', ctx=Load()),
                args=[
                  Call(
                    func=Attribute(
                      value=Name(id='skill_scores', ctx=Load()),
                      attr='items',
                      ctx=Load()))],
                keywords=[
                  keyword(
                    arg='key',
                    value=Lambda(
                      args=arguments(
                        args=[
                          arg(arg='x')]),
                      body=Subscript(
                        value=Name(id='x', ctx=Load()),
                        slice=Constant(value=1),
                        ctx=Load()))),
                  keyword(
                    arg='reverse',
                    value=Constant(value=True))])),
            Assign(
              targets=[
                Name(id='selected', ctx=Store())],
              value=ListComp(
                elt=Name(id='skill', ctx=Load()),
                generators=[
                  comprehension(
                    target=Tuple(
                      elts=[
                        Name(id='skill', ctx=Store()),
                        Name(id='_', ctx=Store())],
                      ctx=Store()),
                    iter=Subscript(
                      value=Name(id='sorted_skills', ctx=Load()),
                      slice=Slice(
                        upper=Name(id='count', ctx=Load())),
                      ctx=Load()),
                    is_async=0)])),
            Assign(
              targets=[
                Name(id='essentials', ctx=Store())],
              value=List(
                elts=[
                  Constant(value='Python'),
                  Constant(value='AWS'),
                  Constant(value='SQL'),
                  Constant(value='Docker'),
                  Constant(value='Git/GitHub'),
                  Constant(value='Agile/Scrum')],
                ctx=Load())),
            For(
              target=Name(id='essential', ctx=Store()),
              iter=Name(id='essentials', ctx=Load()),
              body=[
                If(
                  test=BoolOp(
                    op=And(),
                    values=[
                      Compare(
                        left=Call(
                          func=Name(id='len', ctx=Load()),
                          args=[
                            Name(id='selected', ctx=Load())]),
                        ops=[
                          Lt()],
                        comparators=[
                          Name(id='count', ctx=Load())]),
                      Compare(
                        left=Name(id='essential', ctx=Load()),
                        ops=[
                          NotIn()],
                        comparators=[
                          Name(id='selected', ctx=Load())])]),
                  body=[
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Name(id='selected', ctx=Load()),
                          attr='append',
                          ctx=Load()),
                        args=[
                          Name(id='essential', ctx=Load())]))])]),
            Return(
              value=ListComp(
                elt=JoinedStr(
                  values=[
                    FormattedValue(
                      value=BinOp(
                        left=Name(id='i', ctx=Load()),
                        op=Add(),
                        right=Constant(value=1)),
                      conversion=-1),
                    Constant(value='. '),
                    FormattedValue(
                      value=Name(id='skill', ctx=Load()),
                      conversion=-1)]),
                generators=[
                  comprehension(
                    target=Tuple(
                      elts=[
                        Name(id='i', ctx=Store()),
                        Name(id='skill', ctx=Store())],
                      ctx=Store()),
                    iter=Call(
                      func=Name(id='enumerate', ctx=Load()),
                      args=[
                        Subscript(
                          value=Name(id='selected', ctx=Load()),
                          slice=Slice(
                            upper=Name(id='count', ctx=Load())),
                          ctx=Load())]),
                    is_async=0)]))],
          decorator_list=[
            Name(id='classmethod', ctx=Load())],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load()))]),
    FunctionDef(
      name='load_master_resume',
      args=arguments(),
      body=[
        Expr(
          value=Constant(value='Load the master resume from JSON file.')),
        Try(
          body=[
            With(
              items=[
                withitem(
                  context_expr=Call(
                    func=Name(id='open', ctx=Load()),
                    args=[
                      Constant(value='/mnt/user-data/uploads/Master_Resume_V2_14.json'),
                      Constant(value='r')]),
                  optional_vars=Name(id='f', ctx=Store()))],
              body=[
                Return(
                  value=Call(
                    func=Attribute(
                      value=Name(id='json', ctx=Load()),
                      attr='load',
                      ctx=Load()),
                    args=[
                      Name(id='f', ctx=Load())]))])],
          handlers=[
            ExceptHandler(
              type=Name(id='FileNotFoundError', ctx=Load()),
              body=[
                Return(
                  value=Dict(
                    keys=[
                      Constant(value='contact'),
                      Constant(value='experience'),
                      Constant(value='education'),
                      Constant(value='certifications'),
                      Constant(value='competencies')],
                    values=[
                      Dict(
                        keys=[
                          Constant(value='name'),
                          Constant(value='headline'),
                          Constant(value='email'),
                          Constant(value='phone')],
                        values=[
                          Constant(value='Amit Ayer'),
                          Constant(value='Chief AI Officer | LLM Product Launches | Strategic AI Partnerships'),
                          Constant(value='amitayer1@gmail.com'),
                          Constant(value='+1-917-239-3830')]),
                      Dict(),
                      List(ctx=Load()),
                      List(ctx=Load()),
                      List(ctx=Load())]))])])]),
    ClassDef(
      name='ResumeGenerationEngine',
      body=[
        Expr(
          value=Constant(value='\n    Main engine for generating customized resumes.\n    v4.6.0: Enhanced with embedded modules\n    ')),
        FunctionDef(
          name='__init__',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Initialize the engine with all components.')),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
