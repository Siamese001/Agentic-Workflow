                      attr='baseline_words',
                      ctx=Load()),
                    op=Sub(),
                    right=Name(id='delta', ctx=Load())),
                  BinOp(
                    left=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='baseline_words',
                      ctx=Load()),
                    op=Add(),
                    right=Name(id='delta', ctx=Load()))],
                ctx=Load()))],
          returns=Subscript(
            value=Name(id='Tuple', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='int', ctx=Load()),
