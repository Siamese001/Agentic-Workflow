Module(
  body=[
    Expr(
      value=Constant(value='\nResume Generation Engine v5.3 - AMIT AYER MASTER RESUME\n========================================================\nComplete destructive overwrite with Master_Resume_V2.14.json\n- All Gerald Brewer data replaced with Amit Ayer data\n- Uses uploaded JSON structure for all professional experience\n- Maintains v5.0 architecture (elasticity, signals, 4 outputs)\n- Dynamic bullet pool selection from JSON\n- Reduced to 4 outputs (removed app tracker)\n\nVersion: 5.3\nDate: October 2025\n')),
    Import(
      names=[
        alias(name='json')]),
    Import(
      names=[
        alias(name='re')]),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Dict'),
        alias(name='List'),
        alias(name='Tuple'),
        alias(name='Optional'),
        alias(name='Any'),
        alias(name='Set')],
      level=0),
    ImportFrom(
      module='enum',
      names=[
        alias(name='Enum')],
      level=0),
    ImportFrom(
      module='datetime',
      names=[
        alias(name='datetime')],
      level=0),
    ImportFrom(
      module='dataclasses',
      names=[
        alias(name='dataclass')],
      level=0),
    Import(
      names=[
        alias(name='math')]),
    Assign(
      targets=[
        Name(id='__version__', ctx=Store())],
      value=Constant(value='5.3')),
    FunctionDef(
      name='load_master_resume',
      args=arguments(),
      body=[
        Expr(
          value=Constant(value="Load Amit Ayer's master resume from uploaded JSON.")),
        Try(
          body=[
            With(
              items=[
                withitem(
                  context_expr=Call(
                    func=Name(id='open', ctx=Load()),
                    args=[
                      Constant(value='/mnt/user-data/uploads/Master_Resume_V2_14.json'),
                      Constant(value='r')]),
                  optional_vars=Name(id='f', ctx=Store()))],
              body=[
                Assign(
                  targets=[
                    Name(id='data', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='json', ctx=Load()),
                      attr='load',
                      ctx=Load()),
                    args=[
                      Name(id='f', ctx=Load())])),
                Expr(
                  value=Call(
                    func=Name(id='print', ctx=Load()),
                    args=[
                      JoinedStr(
                        values=[
                          Constant(value='✓ Loaded Master Resume v'),
                          FormattedValue(
                            value=Call(
                              func=Attribute(
                                value=Name(id='data', ctx=Load()),
                                attr='get',
                                ctx=Load()),
                              args=[
                                Constant(value='schema_version'),
                                Constant(value='unknown')]),
                            conversion=-1)])])),
                Return(
                  value=Name(id='data', ctx=Load()))])],
          handlers=[
            ExceptHandler(
              type=Name(id='Exception', ctx=Load()),
              name='e',
              body=[
                Expr(
                  value=Call(
                    func=Name(id='print', ctx=Load()),
                    args=[
                      JoinedStr(
                        values=[
                          Constant(value='⚠ Failed to load master resume: '),
                          FormattedValue(
                            value=Name(id='e', ctx=Load()),
                            conversion=-1)])])),
                Return(value=Dict())])])]),
    Assign(
      targets=[
        Name(id='MASTER_RESUME_JSON', ctx=Store())],
      value=Call(
        func=Name(id='load_master_resume', ctx=Load()))),
    ClassDef(
      name='PerSectionTolerance',
      body=[
        Expr(
          value=Constant(value='Per-section tolerance configuration with elasticity curves.')),
        AnnAssign(
          target=Name(id='baseline_words', ctx=Store()),
          annotation=Name(id='int', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='tolerance_pct', ctx=Store()),
          annotation=Name(id='float', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='signal_floor', ctx=Store()),
          annotation=Name(id='float', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='signal_ceiling', ctx=Store()),
          annotation=Name(id='float', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='elasticity', ctx=Store()),
          annotation=Name(id='float', ctx=Load()),
          simple=1),
        FunctionDef(
          name='get_word_range',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Get allowed word count range.')),
            Assign(
              targets=[
                Name(id='delta', ctx=Store())],
              value=Call(
                func=Name(id='int', ctx=Load()),
                args=[
                  BinOp(
                    left=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='baseline_words',
                      ctx=Load()),
                    op=Mult(),
                    right=Attribute(
                      value=Name(id='self', ctx=Load()),
