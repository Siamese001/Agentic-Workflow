            Return(
              value=Subscript(
                value=Call(
                  func=Name(id='list', ctx=Load()),
                  args=[
                    Call(
                      func=Name(id='set', ctx=Load()),
                      args=[
                        Name(id='skills', ctx=Load())])]),
                slice=Slice(
                  upper=Constant(value=15)),
                ctx=Load()))],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='_extract_preferred_skills',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Extract preferred/nice-to-have skills.')),
            Assign(
              targets=[
                Name(id='preferred', ctx=Store())],
              value=List(ctx=Load())),
            Assign(
              targets=[
                Name(id='pref_match', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='re', ctx=Load()),
                  attr='search',
                  ctx=Load()),
                args=[
                  Constant(value='(preferred|nice[-\\s]to[-\\s]have|bonus|plus).*?(?=\\n\\n|\\Z)'),
                  Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='jd_text',
                    ctx=Load()),
                  BinOp(
                    left=Attribute(
                      value=Name(id='re', ctx=Load()),
                      attr='IGNORECASE',
                      ctx=Load()),
                    op=BitOr(),
                    right=Attribute(
                      value=Name(id='re', ctx=Load()),
                      attr='DOTALL',
                      ctx=Load()))])),
            If(
              test=Name(id='pref_match', ctx=Load()),
              body=[
                Assign(
                  targets=[
                    Name(id='pref_section', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Call(
                        func=Attribute(
                          value=Name(id='pref_match', ctx=Load()),
                          attr='group',
                          ctx=Load()),
                        args=[
                          Constant(value=0)]),
                      attr='lower',
                      ctx=Load()))),
                Assign(
                  targets=[
                    Name(id='skill_patterns', ctx=Store())],
                  value=List(
                    elts=[
                      Constant(value='\\b(mba|master|phd|certification)\\b'),
                      Constant(value='\\b(multilingual|spanish|portuguese|french)\\b'),
                      Constant(value='\\b(startup|scale-up|high[-\\s]?growth)\\b'),
                      Constant(value='\\b(saas|enterprise software|b2b)\\b')],
                    ctx=Load())),
                For(
                  target=Name(id='pattern', ctx=Store()),
                  iter=Name(id='skill_patterns', ctx=Load()),
                  body=[
                    Assign(
                      targets=[
                        Name(id='matches', ctx=Store())],
                      value=Call(
                        func=Attribute(
                          value=Name(id='re', ctx=Load()),
                          attr='finditer',
                          ctx=Load()),
                        args=[
                          Name(id='pattern', ctx=Load()),
                          Name(id='pref_section', ctx=Load())])),
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Name(id='preferred', ctx=Load()),
                          attr='extend',
                          ctx=Load()),
                        args=[
                          ListComp(
                            elt=Call(
                              func=Attribute(
                                value=Call(
                                  func=Attribute(
                                    value=Name(id='m', ctx=Load()),
                                    attr='group',
                                    ctx=Load()),
                                  args=[
                                    Constant(value=0)]),
                                attr='title',
                                ctx=Load())),
                            generators=[
                              comprehension(
                                target=Name(id='m', ctx=Store()),
                                iter=Name(id='matches', ctx=Load()),
                                is_async=0)])]))])]),
            Return(
              value=Subscript(
                value=Call(
                  func=Name(id='list', ctx=Load()),
                  args=[
                    Call(
                      func=Name(id='set', ctx=Load()),
                      args=[
                        Name(id='preferred', ctx=Load())])]),
                slice=Slice(
                  upper=Constant(value=10)),
                ctx=Load()))],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='_classify_role',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Classify role type and seniority.')),
            Assign(
              targets=[
                Name(id='jd_lower', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='jd_text',
                    ctx=Load()),
                  attr='lower',
                  ctx=Load()))),
            If(
              test=Call(
                func=Attribute(
                  value=Name(id='re', ctx=Load()),
                  attr='search',
                  ctx=Load()),
                args=[
                  Constant(value='pre[-\\s]?sales|solutions? engineer'),
                  Name(id='jd_lower', ctx=Load())]),
              body=[
                Assign(
                  targets=[
                    Name(id='primary', ctx=Store())],
                  value=Constant(value='Pre-Sales Solutions'))],
              orelse=[
                If(
                  test=Call(
                    func=Attribute(
                      value=Name(id='re', ctx=Load()),
                      attr='search',
                      ctx=Load()),
                    args=[
                      Constant(value='engineering|software|development'),
                      Name(id='jd_lower', ctx=Load())]),
                  body=[
                    Assign(
                      targets=[
                        Name(id='primary', ctx=Store())],
                      value=Constant(value='Engineering'))],
                  orelse=[
                    If(
                      test=Call(
                        func=Attribute(
                          value=Name(id='re', ctx=Load()),
                          attr='search',
                          ctx=Load()),
                        args=[
                          Constant(value='product'),
                          Name(id='jd_lower', ctx=Load())]),
                      body=[
                        Assign(
                          targets=[
                            Name(id='primary', ctx=Store())],
                          value=Constant(value='Product'))],
                      orelse=[
                        If(
                          test=Call(
                            func=Attribute(
                              value=Name(id='re', ctx=Load()),
                              attr='search',
                              ctx=Load()),
                            args=[
                              Constant(value='sales'),
                              Name(id='jd_lower', ctx=Load())]),
                          body=[
                            Assign(
                              targets=[
                                Name(id='primary', ctx=Store())],
                              value=Constant(value='Sales'))],
                          orelse=[
                            Assign(
                              targets=[
                                Name(id='primary', ctx=Store())],
                              value=Constant(value='Technology Leadership'))])])])]),
            If(
              test=Call(
                func=Attribute(
                  value=Name(id='re', ctx=Load()),
                  attr='search',
                  ctx=Load()),
                args=[
                  Constant(value='vp|vice president|svp|chief'),
                  Name(id='jd_lower', ctx=Load())]),
              body=[
                Assign(
                  targets=[
                    Name(id='secondary', ctx=Store())],
                  value=List(
                    elts=[
                      Constant(value='Executive Leadership'),
                      Constant(value='Strategic Planning')],
                    ctx=Load())),
                Assign(
                  targets=[
                    Name(id='confidence', ctx=Store())],
                  value=Constant(value=0.95))],
              orelse=[
                If(
                  test=Call(
                    func=Attribute(
                      value=Name(id='re', ctx=Load()),
                      attr='search',
                      ctx=Load()),
                    args=[
                      Constant(value='director|head of'),
                      Name(id='jd_lower', ctx=Load())]),
                  body=[
                    Assign(
                      targets=[
                        Name(id='secondary', ctx=Store())],
                      value=List(
                        elts=[
                          Constant(value='Director-Level Leadership'),
                          Constant(value='Team Management')],
                        ctx=Load())),
                    Assign(
                      targets=[
                        Name(id='confidence', ctx=Store())],
                      value=Constant(value=0.9))],
                  orelse=[
                    Assign(
                      targets=[
                        Name(id='secondary', ctx=Store())],
                      value=List(
                        elts=[
                          Constant(value='Senior Leadership'),
                          Constant(value='Individual Contributor')],
                        ctx=Load())),
                    Assign(
                      targets=[
                        Name(id='confidence', ctx=Store())],
                      value=Constant(value=0.85))])]),
            Return(
              value=Dict(
                keys=[
                  Constant(value='primary_role'),
                  Constant(value='secondary_roles'),
                  Constant(value='confidence_score')],
                values=[
                  Name(id='primary', ctx=Load()),
                  Name(id='secondary', ctx=Load()),
                  Name(id='confidence', ctx=Load())]))],
          returns=Name(id='Dict', ctx=Load())),
        FunctionDef(
          name='_analyze_competitive_landscape',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Analyze competitive positioning needs.')),
            Assign(
              targets=[
                Name(id='jd_lower', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='jd_text',
                    ctx=Load()),
                  attr='lower',
                  ctx=Load()))),
            Assign(
              targets=[
                Name(id='differentiators', ctx=Store())],
              value=List(ctx=Load())),
            If(
              test=Call(
                func=Attribute(
                  value=Name(id='re', ctx=Load()),
                  attr='search',
                  ctx=Load()),
                args=[
                  Constant(value='best[-\\s]in[-\\s]class|industry[-\\s]leading|top'),
                  Name(id='jd_lower', ctx=Load())]),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='differentiators', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Constant(value='industry leadership')]))]),
