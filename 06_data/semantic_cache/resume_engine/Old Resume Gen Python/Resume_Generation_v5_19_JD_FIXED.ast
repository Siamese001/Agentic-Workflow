                  Constant(value='customer|client|account|relationship|partnership'),
                  Constant(value='strategy|strategic|vision|roadmap|planning'),
                  Constant(value='technical|architecture|solution|design|implementation'),
                  Constant(value='revenue|sales|growth|pipeline|quota|target'),
                  Constant(value='\\bai\\b|machine learning|\\bml\\b|artificial intelligence'),
                  Constant(value='cloud|aws|azure|gcp|saas|paas'),
                  Constant(value='enterprise|b2b|fortune|large accounts'),
                  Constant(value='product|platform|software|application'),
                  Constant(value='transformation|modernization|digital|innovation')])),
            For(
              target=Tuple(
