                        conversion=-1)])])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='report_lines', ctx=Load()),
                  attr='append',
                  ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='Overall Status: '),
                      FormattedValue(
                        value=IfExp(
                          test=Subscript(
                            value=Name(id='summary', ctx=Load()),
                            slice=Constant(value='all_enforcements_passed'),
                            ctx=Load()),
                          body=Constant(value='PASS'),
                          orelse=Constant(value='FAIL')),
                        conversion=-1)])])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='report_lines', ctx=Load()),
                  attr='append',
                  ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='Pass Rate: '),
                      FormattedValue(
                        value=Subscript(
                          value=Name(id='summary', ctx=Load()),
                          slice=Constant(value='pass_rate'),
                          ctx=Load()),
                        conversion=-1,
                        format_spec=JoinedStr(
                          values=[
                            Constant(value='.2f')])),
                      Constant(value='% ('),
                      FormattedValue(
                        value=Subscript(
                          value=Name(id='summary', ctx=Load()),
                          slice=Constant(value='passed'),
                          ctx=Load()),
                        conversion=-1),
                      Constant(value='/'),
                      FormattedValue(
                        value=Subscript(
                          value=Name(id='summary', ctx=Load()),
                          slice=Constant(value='total_enforcements_checked'),
                          ctx=Load()),
                        conversion=-1),
                      Constant(value=')')])])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='report_lines', ctx=Load()),
                  attr='append',
                  ctx=Load()),
                args=[
                  Constant(value='')])),
            If(
              test=Compare(
                left=Subscript(
                  value=Name(id='summary', ctx=Load()),
                  slice=Constant(value='failed'),
                  ctx=Load()),
                ops=[
                  Gt()],
                comparators=[
                  Constant(value=0)]),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='report_lines', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Constant(value='--- FAILED CHECKS ---')])),
                For(
                  target=Name(id='failure', ctx=Store()),
                  iter=Subscript(
                    value=Name(id='summary', ctx=Load()),
                    slice=Constant(value='failed_enforcements'),
                    ctx=Load()),
                  body=[
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Name(id='report_lines', ctx=Load()),
                          attr='append',
                          ctx=Load()),
                        args=[
                          JoinedStr(
                            values=[
                              Constant(value='  - ['),
                              FormattedValue(
                                value=Subscript(
                                  value=Name(id='failure', ctx=Load()),
                                  slice=Constant(value='gate'),
                                  ctx=Load()),
                                conversion=-1),
                              Constant(value='] '),
                              FormattedValue(
                                value=Subscript(
                                  value=Name(id='failure', ctx=Load()),
                                  slice=Constant(value='rule'),
                                  ctx=Load()),
                                conversion=-1),
                              Constant(value=': '),
                              FormattedValue(
                                value=Subscript(
                                  value=Name(id='failure', ctx=Load()),
                                  slice=Constant(value='details'),
                                  ctx=Load()),
                                conversion=-1)])]))]),
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='report_lines', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Constant(value='')]))]),
            Return(
              value=Call(
                func=Attribute(
                  value=Constant(value='\n'),
                  attr='join',
                  ctx=Load()),
                args=[
                  Name(id='report_lines', ctx=Load())]))],
          returns=Name(id='str', ctx=Load()))]),
