      body=[
        Expr(
          value=Constant(value='Handles defaults and clamps reasoning config values.')),
        Assign(
          targets=[
            Name(id='config', ctx=Store())],
          value=BoolOp(
            op=Or(),
            values=[
              Name(id='config', ctx=Load()),
