    FunctionDef(
      name='validate_overview_tolerance_v521',
      args=arguments(
        args=[
          arg(
            arg='tailored_overview',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='master_overview',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='company',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='tolerance',
            annotation=Name(id='float', ctx=Load()))],
        defaults=[
          Constant(value=0.2)]),
      body=[
        Expr(
          value=Constant(value='\n    v5.21: Validate overview word count against master ±tolerance%.\n    ')),
        Assign(
          targets=[
            Name(id='master_words', ctx=Store())],
          value=Call(
            func=Name(id='count_words_clean', ctx=Load()),
            args=[
              Name(id='master_overview', ctx=Load())])),
        Assign(
          targets=[
            Name(id='tailored_words', ctx=Store())],
          value=Call(
            func=Name(id='count_words_clean', ctx=Load()),
            args=[
              Name(id='tailored_overview', ctx=Load())])),
        Assign(
          targets=[
            Name(id='min_words', ctx=Store())],
          value=Call(
            func=Name(id='int', ctx=Load()),
            args=[
              BinOp(
                left=Name(id='master_words', ctx=Load()),
                op=Mult(),
                right=BinOp(
                  left=Constant(value=1),
                  op=Sub(),
                  right=Name(id='tolerance', ctx=Load())))])),
        Assign(
          targets=[
            Name(id='max_words', ctx=Store())],
          value=Call(
            func=Name(id='int', ctx=Load()),
            args=[
              BinOp(
                left=Name(id='master_words', ctx=Load()),
                op=Mult(),
                right=BinOp(
                  left=Constant(value=1),
                  op=Add(),
                  right=Name(id='tolerance', ctx=Load())))])),
        Assign(
          targets=[
            Name(id='passed', ctx=Store())],
          value=Compare(
            left=Name(id='min_words', ctx=Load()),
            ops=[
              LtE(),
              LtE()],
            comparators=[
              Name(id='tailored_words', ctx=Load()),
              Name(id='max_words', ctx=Load())])),
        Return(
          value=Call(
            func=Name(id='ValidationResult', ctx=Load()),
            keywords=[
              keyword(
                arg='rule_id',
                value=JoinedStr(
                  values=[
                    Constant(value='OVERVIEW_TOLERANCE_'),
                    FormattedValue(
                      value=Call(
                        func=Attribute(
                          value=Call(
                            func=Attribute(
                              value=Name(id='company', ctx=Load()),
                              attr='upper',
                              ctx=Load())),
                          attr='replace',
                          ctx=Load()),
                        args=[
                          Constant(value=' '),
                          Constant(value='_')]),
                      conversion=-1)])),
              keyword(
                arg='passed',
                value=Name(id='passed', ctx=Load())),
              keyword(
