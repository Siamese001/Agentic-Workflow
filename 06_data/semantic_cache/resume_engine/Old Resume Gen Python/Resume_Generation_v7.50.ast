          returns=Name(id='str', ctx=Load())),
        FunctionDef(
          name='_format_bullets_for_prompt',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='bullets',
                annotation=Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Name(id='Dict', ctx=Load()),
                  ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Format master resume bullets for prompt context.')),
            Assign(
              targets=[
                Name(id='formatted', ctx=Store())],
              value=List(ctx=Load())),
            For(
              target=Tuple(
                elts=[
                  Name(id='i', ctx=Store()),
                  Name(id='bullet', ctx=Store())],
                ctx=Store()),
              iter=Call(
                func=Name(id='enumerate', ctx=Load()),
                args=[
                  Name(id='bullets', ctx=Load()),
                  Constant(value=1)]),
              body=[
                Assign(
                  targets=[
                    Name(id='company', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='bullet', ctx=Load()),
                      attr='get',
                      ctx=Load()),
                    args=[
                      Constant(value='company'),
                      Constant(value='Unknown')])),
                Assign(
                  targets=[
                    Name(id='text', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='bullet', ctx=Load()),
                      attr='get',
                      ctx=Load()),
                    args=[
                      Constant(value='text'),
                      Constant(value='')])),
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='formatted', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      JoinedStr(
                        values=[
                          FormattedValue(
                            value=Name(id='i', ctx=Load()),
                            conversion=-1),
                          Constant(value='. ['),
                          FormattedValue(
                            value=Name(id='company', ctx=Load()),
                            conversion=-1),
                          Constant(value='] '),
                          FormattedValue(
                            value=Name(id='text', ctx=Load()),
                            conversion=-1)])]))]),
            Return(
              value=Call(
                func=Attribute(
                  value=Constant(value='\n'),
                  attr='join',
                  ctx=Load()),
                args=[
                  Name(id='formatted', ctx=Load())]))],
          returns=Name(id='str', ctx=Load())),
        FunctionDef(
          name='_generate_k2_skills',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='job_description',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='thematic_analysis',
                annotation=Name(id='ThematicAnalysis', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Generates 12 high-signal, 1-3 word skills.\n\n        This method uses the job analysis to generate a list of skills,\n        then robustly parses the LLM output to handle various formats\n        (newlines, commas, bullets) and ensures each skill is 1-3 words long.')),
            Try(
              body=[
                Assign(
                  targets=[
                    Name(id='primary_theme', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='thematic_analysis', ctx=Load()),
                        attr='primary_theme',
                        ctx=Load()),
                      attr='get',
                      ctx=Load()),
                    args=[
                      Constant(value='name'),
                      Constant(value='AI Leadership')])),
                Assign(
                  targets=[
                    Name(id='secondary_themes', ctx=Store())],
                  value=ListComp(
                    elt=Call(
                      func=Attribute(
                        value=Name(id='t', ctx=Load()),
                        attr='get',
                        ctx=Load()),
                      args=[
                        Constant(value='name'),
                        Constant(value='')]),
                    generators=[
                      comprehension(
                        target=Name(id='t', ctx=Store()),
                        iter=Subscript(
                          value=Attribute(
                            value=Name(id='thematic_analysis', ctx=Load()),
                            attr='secondary_themes',
                            ctx=Load()),
                          slice=Slice(
                            upper=Constant(value=4)),
                          ctx=Load()),
                        is_async=0)])),
                Assign(
                  targets=[
                    Name(id='differentiators', ctx=Store())],
                  value=List(ctx=Load())),
                If(
                  test=BoolOp(
                    op=And(),
                    values=[
                      Call(
                        func=Name(id='hasattr', ctx=Load()),
                        args=[
                          Name(id='thematic_analysis', ctx=Load()),
                          Constant(value='competitive_intelligence')]),
                      Attribute(
                        value=Name(id='thematic_analysis', ctx=Load()),
                        attr='competitive_intelligence',
                        ctx=Load())]),
                  body=[
                    Assign(
                      targets=[
                        Name(id='differentiators', ctx=Store())],
                      value=Subscript(
                        value=Attribute(
                          value=Attribute(
                            value=Name(id='thematic_analysis', ctx=Load()),
                            attr='competitive_intelligence',
                            ctx=Load()),
                          attr='differentiator_keywords',
                          ctx=Load()),
                        slice=Slice(
                          upper=Constant(value=10)),
                        ctx=Load()))]),
                Assign(
                  targets=[
                    Name(id='prompt', ctx=Store())],
                  value=JoinedStr(
                    values=[
                      Constant(value='You are an expert HR data analyst. Your task is to extract the 12 most critical skills from a job analysis and format them as 1-3 word keywords suitable for an HR database.\n\n**Job Description Analysis:**\n- Primary Theme: '),
                      FormattedValue(
                        value=Name(id='primary_theme', ctx=Load()),
                        conversion=-1),
                      Constant(value='\n- Secondary Themes: '),
                      FormattedValue(
                        value=Call(
                          func=Attribute(
                            value=Constant(value=', '),
                            attr='join',
                            ctx=Load()),
                          args=[
                            Name(id='secondary_themes', ctx=Load())]),
                        conversion=-1),
                      Constant(value='\n- Key Differentiator Keywords: '),
                      FormattedValue(
                        value=Call(
                          func=Attribute(
                            value=Constant(value=', '),
                            attr='join',
                            ctx=Load()),
                          args=[
                            Name(id='differentiators', ctx=Load())]),
                        conversion=-1),
                      Constant(value='\n\n**Full Job Description (for context):**\n'),
                      FormattedValue(
                        value=IfExp(
                          test=Name(id='job_description', ctx=Load()),
                          body=Subscript(
                            value=Name(id='job_description', ctx=Load()),
                            slice=Slice(
                              upper=Constant(value=2000)),
                            ctx=Load()),
                          orelse=Constant(value='Not provided')),
                        conversion=-1),
                      Constant(value="\n\n**TASK:**\n1. Identify the **12 most important skills** based on the provided analysis and JD.\n2. These skills must have 90%+ signal (directly supported by themes and keywords).\n3. Format **each** skill as a 1-3 word keyword (e.g., 'AI Strategy', 'Team Leadership', 'SaaS Delivery').\n4. The skills must be common terms found in HR recruiting databases.\n5. Return **only** the 12 skills, each on a new line.\n6. Do NOT add bullets, numbers, or any other commentary or preamble.\n")])),
                Assign(
                  targets=[
                    Name(id='api_key', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='os', ctx=Load()),
                        attr='environ',
                        ctx=Load()),
                      attr='get',
                      ctx=Load()),
                    args=[
                      Constant(value='GEMINI_API_KEY')])),
                If(
                  test=UnaryOp(
                    op=Not(),
                    operand=Name(id='api_key', ctx=Load())),
                  body=[
                    Return(
                      value=List(
                        elts=[
                          Constant(value='Error: GEMINI_API_KEY not set')],
                        ctx=Load()))]),
                If(
                  test=UnaryOp(
                    op=Not(),
                    operand=Name(id='GEMINI_AVAILABLE', ctx=Load())),
                  body=[
                    Return(
                      value=List(
                        elts=[
                          Constant(value='Error: google-generativeai library not available')],
                        ctx=Load()))]),
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='genai', ctx=Load()),
                      attr='configure',
                      ctx=Load()),
                    keywords=[
                      keyword(
                        arg='api_key',
                        value=Name(id='api_key', ctx=Load()))])),
                Assign(
                  targets=[
                    Name(id='reasoning_config', ctx=Store())],
                  value=Attribute(
                    value=Name(id='ReasoningConfig', ctx=Load()),
                    attr='K2_SKILLS_CONFIG',
                    ctx=Load())),
                Assign(
                  targets=[
                    Name(id='api_params', ctx=Store())],
                  value=Call(
                    func=Name(id='reasoning_config_to_api_params', ctx=Load()),
                    args=[
                      Name(id='reasoning_config', ctx=Load())])),
                Assign(
                  targets=[
                    Name(id='base_system', ctx=Store())],
                  value=Constant(value='You are an expert HR data analyst. You generate 1-3 word skills for HR databases. You follow formatting instructions perfectly.')),
                Assign(
                  targets=[
                    Name(id='enhanced_system', ctx=Store())],
                  value=Call(
                    func=Name(id='enhance_system_prompt_with_reasoning', ctx=Load()),
                    args=[
                      Name(id='base_system', ctx=Load()),
                      Name(id='reasoning_config', ctx=Load()),
                      Constant(value='K.2')])),
                Assign(
                  targets=[
                    Name(id='client', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='genai', ctx=Load()),
                      attr='GenerativeModel',
                      ctx=Load()),
                    args=[
                      Constant(value='gemini-1.5-flash')])),
                Assign(
                  targets=[
                    Name(id='response', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='client', ctx=Load()),
                      attr='generate_content',
                      ctx=Load()),
                    args=[
                      JoinedStr(
                        values=[
                          FormattedValue(
                            value=Name(id='enhanced_system', ctx=Load()),
                            conversion=-1),
                          Constant(value='\n\n'),
                          FormattedValue(
                            value=Name(id='prompt', ctx=Load()),
                            conversion=-1)])],
                    keywords=[
                      keyword(
                        arg='generation_config',
                        value=Subscript(
                          value=Name(id='api_params', ctx=Load()),
                          slice=Constant(value='generation_config'),
                          ctx=Load()))])),
                Assign(
                  targets=[
                    Name(id='skills_text', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='response', ctx=Load()),
                        attr='text',
                        ctx=Load()),
                      attr='strip',
                      ctx=Load()))),
                Assign(
                  targets=[
                    Name(id='skills_list_final', ctx=Store())],
                  value=List(ctx=Load())),
                Assign(
                  targets=[
                    Name(id='skills_intermediate', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='re', ctx=Load()),
                      attr='split',
                      ctx=Load()),
                    args=[
                      Constant(value='[\\n,]'),
                      Name(id='skills_text', ctx=Load())])),
                For(
                  target=Name(id='skill', ctx=Store()),
                  iter=Name(id='skills_intermediate', ctx=Load()),
                  body=[
                    Assign(
                      targets=[
                        Name(id='cleaned_skill', ctx=Store())],
                      value=Call(
                        func=Attribute(
                          value=Call(
                            func=Attribute(
                              value=Name(id='re', ctx=Load()),
                              attr='sub',
                              ctx=Load()),
                            args=[
                              Constant(value='^[•*\\-\\d\\.]+\\s*'),
                              Constant(value=''),
                              Name(id='skill', ctx=Load())]),
                          attr='strip',
                          ctx=Load()))),
                    If(
                      test=UnaryOp(
                        op=Not(),
                        operand=Name(id='cleaned_skill', ctx=Load())),
                      body=[
                        Continue()]),
                    Assign(
                      targets=[
                        Name(id='word_count', ctx=Store())],
                      value=Call(
                        func=Name(id='len', ctx=Load()),
                        args=[
                          Call(
                            func=Attribute(
                              value=Name(id='cleaned_skill', ctx=Load()),
                              attr='split',
                              ctx=Load()))])),
                    If(
                      test=Compare(
                        left=Constant(value=1),
                        ops=[
                          LtE(),
                          LtE()],
                        comparators=[
                          Name(id='word_count', ctx=Load()),
                          Constant(value=3)]),
                      body=[
                        Expr(
                          value=Call(
                            func=Attribute(
                              value=Name(id='skills_list_final', ctx=Load()),
                              attr='append',
                              ctx=Load()),
                            args=[
                              Name(id='cleaned_skill', ctx=Load())]))],
                      orelse=[
                        Expr(
                          value=Call(
                            func=Name(id='print', ctx=Load()),
                            args=[
                              JoinedStr(
                                values=[
                                  Constant(value="Warning: Discarding malformed skill '"),
                                  FormattedValue(
                                    value=Name(id='cleaned_skill', ctx=Load()),
                                    conversion=-1),
                                  Constant(value="' (word count: "),
                                  FormattedValue(
                                    value=Name(id='word_count', ctx=Load()),
                                    conversion=-1),
                                  Constant(value=')')])]))])]),
                If(
                  test=Compare(
                    left=Call(
                      func=Name(id='len', ctx=Load()),
                      args=[
                        Name(id='skills_list_final', ctx=Load())]),
                    ops=[
                      Lt()],
                    comparators=[
                      Constant(value=10)]),
                  body=[
                    Return(
                      value=List(
                        elts=[
                          JoinedStr(
                            values=[
                              Constant(value='Error: LLM failed to generate 12 valid 1-3 word skills. Output: '),
                              FormattedValue(
                                value=Name(id='skills_text', ctx=Load()),
                                conversion=-1)])],
                        ctx=Load()))]),
                Return(
                  value=Subscript(
                    value=Name(id='skills_list_final', ctx=Load()),
                    slice=Slice(
                      upper=Constant(value=12)),
                    ctx=Load()))],
              handlers=[
                ExceptHandler(
                  type=Name(id='Exception', ctx=Load()),
                  name='e',
                  body=[
                    Expr(
                      value=Call(
                        func=Name(id='print', ctx=Load()),
                        args=[
                          JoinedStr(
                            values=[
                              Constant(value='Warning: K.2_Skills LLM generation failed: '),
                              FormattedValue(
                                value=Name(id='e', ctx=Load()),
                                conversion=-1)])])),
                    Return(
                      value=List(
                        elts=[
                          JoinedStr(
                            values=[
                              Constant(value='Error: '),
                              FormattedValue(
                                value=Name(id='e', ctx=Load()),
                                conversion=-1)])],
                        ctx=Load()))])])],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='_generate_k0_headline',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='enriched_scaffold',
                annotation=Name(id='Dict', ctx=Load())),
              arg(
                arg='job_description',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='thematic_analysis',
                annotation=Name(id='ThematicAnalysis', ctx=Load())),
              arg(
                arg='previous_failures',
                annotation=Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Name(id='ValidationResult', ctx=Load()),
                  ctx=Load()))],
            defaults=[
              Constant(value=None)]),
          body=[
            Expr(
              value=Constant(value='\n        Generate K.4 Headline (15-20 words).\n        v5.58: NOW USES LLM TO GENERATE ROLE-SPECIFIC HEADLINE (was: static template).\n        ')),
            Assign(
              targets=[
                Name(id='recent_exp', ctx=Store())],
              value=Subscript(
                value=Subscript(
                  value=Name(id='MASTER_RESUME_JSON', ctx=Load()),
                  slice=Constant(value='professional_experience'),
                  ctx=Load()),
                slice=Constant(value=0),
                ctx=Load())),
            Assign(
              targets=[
                Name(id='current_title', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='recent_exp', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='title'),
                  Constant(value='Technology Leader')])),
            Assign(
              targets=[
                Name(id='current_company', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='recent_exp', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='company'),
                  Constant(value='Leading Company')])),
            Assign(
              targets=[
                Name(id='primary_theme', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='thematic_analysis', ctx=Load()),
                    attr='primary_theme',
                    ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='name'),
                  Constant(value='AI Leadership')])),
            Assign(
              targets=[
                Name(id='differentiators', ctx=Store())],
              value=Subscript(
                value=Attribute(
                  value=Attribute(
                    value=Name(id='thematic_analysis', ctx=Load()),
                    attr='competitive_intelligence',
                    ctx=Load()),
                  attr='differentiator_keywords',
                  ctx=Load()),
                slice=Slice(
                  upper=Constant(value=3)),
                ctx=Load())),
            Assign(
              targets=[
                Name(id='role_level', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='thematic_analysis', ctx=Load()),
                    attr='role_classification',
                    ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='level'),
                  Constant(value='senior')])),
            Assign(
              targets=[
                Name(id='prompt', ctx=Store())],
              value=JoinedStr(
                values=[
                  Constant(value='Create a professional resume headline for this candidate.\n\n**Current Role:** '),
                  FormattedValue(
                    value=Name(id='current_title', ctx=Load()),
                    conversion=-1),
                  Constant(value=' at '),
                  FormattedValue(
                    value=Name(id='current_company', ctx=Load()),
                    conversion=-1),
                  Constant(value='\n\n**Target Job Theme:** '),
                  FormattedValue(
                    value=Name(id='primary_theme', ctx=Load()),
                    conversion=-1),
                  Constant(value='\n\n**Key Differentiators:** '),
                  FormattedValue(
                    value=Call(
                      func=Attribute(
                        value=Constant(value=', '),
                        attr='join',
                        ctx=Load()),
                      args=[
                        Name(id='differentiators', ctx=Load())]),
                    conversion=-1),
                  Constant(value='\n\n**Role Level:** '),
                  FormattedValue(
                    value=Name(id='role_level', ctx=Load()),
                    conversion=-1),
                  Constant(value='\n\n**Instructions:**\n1. Create a headline that positions the candidate for: '),
                  FormattedValue(
                    value=Name(id='primary_theme', ctx=Load()),
                    conversion=-1),
                  Constant(value='\n2. Include 2-3 of these differentiators: '),
                  FormattedValue(
                    value=Call(
                      func=Attribute(
                        value=Constant(value=', '),
                        attr='join',
                        ctx=Load()),
                      args=[
                        Name(id='differentiators', ctx=Load())]),
                    conversion=-1),
                  Constant(value='\n3. Format: "[Title/Role] | [Key Strength 1] | [Key Strength 2]"\n4. Must be 15-20 words maximum\n5. Use professional, confident tone\n6. Return ONLY the headline text with no explanation\n\nExamples:\n- "Senior AI Architect | Enterprise ML Platform Leader | Scaled Teams Across Fortune 500"\n- "Technology Executive | Cloud Infrastructure Innovator | AI/ML Strategy & Implementation"\n- "Engineering Leader | Full-Stack Development Expert | SaaS Product Architecture"\n')])),
            Try(
              body=[
                Assign(
                  targets=[
                    Name(id='api_key', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='os', ctx=Load()),
                        attr='environ',
                        ctx=Load()),
                      attr='get',
