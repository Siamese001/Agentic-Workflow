                ctx=Load())),
            Assign(
              targets=[
                Name(id='contact_parts', ctx=Store())],
              value=ListComp(
                elt=Name(id='part', ctx=Load()),
                generators=[
                  comprehension(
                    target=Name(id='part', ctx=Store()),
                    iter=Name(id='contact_parts', ctx=Load()),
