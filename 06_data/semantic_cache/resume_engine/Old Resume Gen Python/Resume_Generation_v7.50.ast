        FunctionDef(
          name='generate_enforcement_report',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Generate comprehensive enforcement report.')),
            Assign(
              targets=[
                Name(id='passed', ctx=Store())],
              value=ListComp(
                elt=Name(id='r', ctx=Load()),
                generators=[
                  comprehension(
                    target=Name(id='r', ctx=Store()),
                    iter=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='enforcement_results',
                      ctx=Load()),
                    ifs=[
                      Attribute(
                        value=Name(id='r', ctx=Load()),
                        attr='passed',
                        ctx=Load())],
                    is_async=0)])),
            Assign(
              targets=[
                Name(id='failed', ctx=Store())],
              value=ListComp(
                elt=Name(id='r', ctx=Load()),
                generators=[
                  comprehension(
                    target=Name(id='r', ctx=Store()),
                    iter=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='enforcement_results',
                      ctx=Load()),
                    ifs=[
                      UnaryOp(
                        op=Not(),
                        operand=Attribute(
                          value=Name(id='r', ctx=Load()),
                          attr='passed',
                          ctx=Load()))],
                    is_async=0)])),
            Assign(
              targets=[
                Name(id='report', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='jd_hash'),
                  Constant(value='total_enforcements_checked'),
                  Constant(value='passed'),
                  Constant(value='failed'),
                  Constant(value='pass_rate'),
                  Constant(value='all_enforcements_passed'),
                  Constant(value='failed_enforcements'),
                  Constant(value='enforcement_summary_by_gate'),
                  Constant(value='jd_keywords_tracked')],
                values=[
                  Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='jd_hash',
                    ctx=Load()),
                  Call(
                    func=Name(id='len', ctx=Load()),
                    args=[
                      Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='enforcement_results',
                        ctx=Load())]),
                  Call(
                    func=Name(id='len', ctx=Load()),
                    args=[
                      Name(id='passed', ctx=Load())]),
                  Call(
                    func=Name(id='len', ctx=Load()),
                    args=[
                      Name(id='failed', ctx=Load())]),
                  IfExp(
                    test=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='enforcement_results',
                      ctx=Load()),
                    body=BinOp(
                      left=BinOp(
                        left=Call(
                          func=Name(id='len', ctx=Load()),
                          args=[
                            Name(id='passed', ctx=Load())]),
                        op=Div(),
                        right=Call(
                          func=Name(id='len', ctx=Load()),
                          args=[
                            Attribute(
                              value=Name(id='self', ctx=Load()),
                              attr='enforcement_results',
                              ctx=Load())])),
                      op=Mult(),
                      right=Constant(value=100)),
                    orelse=Constant(value=0)),
                  Compare(
                    left=Call(
                      func=Name(id='len', ctx=Load()),
                      args=[
                        Name(id='failed', ctx=Load())]),
                    ops=[
                      Eq()],
                    comparators=[
                      Constant(value=0)]),
                  ListComp(
                    elt=Dict(
                      keys=[
                        Constant(value='rule'),
                        Constant(value='details'),
                        Constant(value='gate'),
                        Constant(value='timestamp')],
                      values=[
                        Attribute(
                          value=Attribute(
                            value=Name(id='r', ctx=Load()),
                            attr='rule',
                            ctx=Load()),
                          attr='value',
                          ctx=Load()),
                        Attribute(
                          value=Name(id='r', ctx=Load()),
                          attr='details',
                          ctx=Load()),
                        Attribute(
                          value=Name(id='r', ctx=Load()),
                          attr='gate_id',
                          ctx=Load()),
                        Attribute(
                          value=Name(id='r', ctx=Load()),
                          attr='timestamp',
                          ctx=Load())]),
                    generators=[
                      comprehension(
                        target=Name(id='r', ctx=Store()),
                        iter=Name(id='failed', ctx=Load()),
                        is_async=0)]),
                  Call(
                    func=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='_summarize_by_gate',
                      ctx=Load())),
                  Call(
                    func=Name(id='len', ctx=Load()),
                    args=[
                      Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='jd_keywords',
                        ctx=Load())])])),
            Return(
              value=Name(id='report', ctx=Load()))],
          returns=Name(id='Dict', ctx=Load())),
        FunctionDef(
          name='_summarize_by_gate',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Summarize enforcement results by gate.')),
            Assign(
              targets=[
                Name(id='gates', ctx=Store())],
              value=Dict()),
            For(
              target=Name(id='result', ctx=Store()),
              iter=Attribute(
                value=Name(id='self', ctx=Load()),
                attr='enforcement_results',
                ctx=Load()),
              body=[
                If(
                  test=Compare(
                    left=Attribute(
                      value=Name(id='result', ctx=Load()),
                      attr='gate_id',
                      ctx=Load()),
                    ops=[
                      NotIn()],
                    comparators=[
                      Name(id='gates', ctx=Load())]),
                  body=[
                    Assign(
                      targets=[
                        Subscript(
                          value=Name(id='gates', ctx=Load()),
                          slice=Attribute(
                            value=Name(id='result', ctx=Load()),
                            attr='gate_id',
                            ctx=Load()),
                          ctx=Store())],
                      value=Dict(
                        keys=[
                          Constant(value='passed'),
                          Constant(value='failed'),
                          Constant(value='rules')],
                        values=[
                          Constant(value=0),
                          Constant(value=0),
                          List(ctx=Load())]))]),
                If(
                  test=Attribute(
                    value=Name(id='result', ctx=Load()),
                    attr='passed',
                    ctx=Load()),
                  body=[
                    AugAssign(
                      target=Subscript(
                        value=Subscript(
                          value=Name(id='gates', ctx=Load()),
                          slice=Attribute(
                            value=Name(id='result', ctx=Load()),
                            attr='gate_id',
                            ctx=Load()),
                          ctx=Load()),
                        slice=Constant(value='passed'),
                        ctx=Store()),
                      op=Add(),
                      value=Constant(value=1))],
                  orelse=[
                    AugAssign(
                      target=Subscript(
                        value=Subscript(
                          value=Name(id='gates', ctx=Load()),
                          slice=Attribute(
                            value=Name(id='result', ctx=Load()),
                            attr='gate_id',
                            ctx=Load()),
                          ctx=Load()),
                        slice=Constant(value='failed'),
                        ctx=Store()),
                      op=Add(),
                      value=Constant(value=1))]),
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Subscript(
                        value=Subscript(
                          value=Name(id='gates', ctx=Load()),
                          slice=Attribute(
                            value=Name(id='result', ctx=Load()),
                            attr='gate_id',
                            ctx=Load()),
                          ctx=Load()),
                        slice=Constant(value='rules'),
                        ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Dict(
                        keys=[
                          Constant(value='rule'),
                          Constant(value='passed')],
                        values=[
                          Attribute(
                            value=Attribute(
                              value=Name(id='result', ctx=Load()),
                              attr='rule',
                              ctx=Load()),
                            attr='name',
                            ctx=Load()),
                          Attribute(
                            value=Name(id='result', ctx=Load()),
                            attr='passed',
                            ctx=Load())])]))]),
            Return(
              value=Name(id='gates', ctx=Load()))],
          returns=Name(id='Dict', ctx=Load())),
        FunctionDef(
          name='get_final_report',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Generates a final, formatted string report of all enforcement checks.')),
            Assign(
              targets=[
                Name(id='report_lines', ctx=Store())],
              value=List(
                elts=[
                  BinOp(
                    left=Constant(value='='),
