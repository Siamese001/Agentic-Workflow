                ctx=Load()),
              ops=[
                IsNot()],
              comparators=[
                Constant(value=None)]),
            body=Attribute(
              value=Name(id='config', ctx=Load()),
              attr='reflexion',
              ctx=Load()),
            orelse=Constant(value=True))),
        Assign(
          targets=[
            Name(id='max_loops', ctx=Store())],
