                  value=Call(
                    func=Attribute(
                      value=Name(id='validation_results', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Call(
                        func=Name(id='ValidationResult', ctx=Load()),
                        keywords=[
                          keyword(
                            arg='rule_id',
                            value=Constant(value='DUPLICATE_CHECK')),
                          keyword(
                            arg='passed',
                            value=Constant(value=True)),
                          keyword(
                            arg='severity',
                            value=Attribute(
                              value=Name(id='ValidationSeverity', ctx=Load()),
                              attr='INFO',
                              ctx=Load())),
                          keyword(
                            arg='message',
                            value=Constant(value='No duplicate bullets detected'))])]))]),
            Assign(
              targets=[
                Name(id='enriched_data', ctx=Store())],
              value=Dict(
                keys=[
                  None,
                  Constant(value='experience_sections')],
                values=[
                  Name(id='extracted_data', ctx=Load()),
                  Name(id='experience_sections', ctx=Load())])),
            Return(
              value=Tuple(
                elts=[
                  Name(id='enriched_data', ctx=Load()),
                  Name(id='validation_results', ctx=Load())],
                ctx=Load()))],
          returns=Subscript(
            value=Name(id='Tuple', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='Dict', ctx=Load()),
                Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Name(id='ValidationResult', ctx=Load()),
                  ctx=Load())],
              ctx=Load()),
            ctx=Load()))]),
    ClassDef(
      name='VerbCanonicalizer',
      body=[
        Expr(
          value=Constant(value='Canonicalize action verbs to approved list.')),
        Assign(
          targets=[
            Name(id='CANONICAL_VERBS', ctx=Store())],
          value=Dict(
            keys=[
              Constant(value='led'),
              Constant(value='built'),
              Constant(value='drove'),
              Constant(value='launched'),
              Constant(value='scaled'),
              Constant(value='delivered'),
              Constant(value='achieved'),
              Constant(value='established'),
              Constant(value='managed'),
              Constant(value='developed')],
            values=[
              List(
                elts=[
                  Constant(value='led'),
                  Constant(value='lead'),
                  Constant(value='leading')],
                ctx=Load()),
              List(
                elts=[
                  Constant(value='built'),
                  Constant(value='build'),
                  Constant(value='building')],
                ctx=Load()),
              List(
                elts=[
                  Constant(value='drove'),
                  Constant(value='drive'),
                  Constant(value='driving')],
                ctx=Load()),
              List(
                elts=[
                  Constant(value='launched'),
                  Constant(value='launch'),
                  Constant(value='launching')],
                ctx=Load()),
              List(
                elts=[
                  Constant(value='scaled'),
                  Constant(value='scale'),
                  Constant(value='scaling')],
                ctx=Load()),
              List(
                elts=[
                  Constant(value='delivered'),
                  Constant(value='deliver'),
                  Constant(value='delivering')],
                ctx=Load()),
              List(
                elts=[
                  Constant(value='achieved'),
                  Constant(value='achieve'),
                  Constant(value='achieving')],
                ctx=Load()),
              List(
                elts=[
                  Constant(value='established'),
                  Constant(value='establish'),
                  Constant(value='establishing')],
                ctx=Load()),
              List(
                elts=[
                  Constant(value='managed'),
                  Constant(value='manage'),
                  Constant(value='managing')],
                ctx=Load()),
              List(
                elts=[
                  Constant(value='developed'),
                  Constant(value='develop'),
                  Constant(value='developing')],
                ctx=Load())])),
        Assign(
          targets=[
            Name(id='FORBIDDEN_VERBS', ctx=Store())],
          value=List(
            elts=[
              Constant(value='pioneered'),
              Constant(value='spearheaded'),
              Constant(value='orchestrated'),
              Constant(value='architected'),
              Constant(value='revolutionized'),
              Constant(value='transformed')],
            ctx=Load())),
        FunctionDef(
          name='canonicalize',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='text',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Extract and canonicalize verbs from text.')),
            Assign(
              targets=[
                Name(id='canonical', ctx=Store())],
              value=List(ctx=Load())),
            Assign(
              targets=[
                Name(id='text_lower', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='text', ctx=Load()),
                  attr='lower',
                  ctx=Load()))),
            For(
              target=Tuple(
                elts=[
                  Name(id='canonical_form', ctx=Store()),
                  Name(id='variants', ctx=Store())],
                ctx=Store()),
              iter=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='CANONICAL_VERBS',
                    ctx=Load()),
                  attr='items',
                  ctx=Load())),
              body=[
                If(
                  test=Call(
                    func=Name(id='any', ctx=Load()),
                    args=[
                      GeneratorExp(
                        elt=Compare(
                          left=Name(id='variant', ctx=Load()),
                          ops=[
                            In()],
                          comparators=[
                            Name(id='text_lower', ctx=Load())]),
                        generators=[
                          comprehension(
                            target=Name(id='variant', ctx=Store()),
                            iter=Name(id='variants', ctx=Load()),
                            is_async=0)])]),
                  body=[
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Name(id='canonical', ctx=Load()),
                          attr='append',
                          ctx=Load()),
                        args=[
                          Name(id='canonical_form', ctx=Load())]))])]),
            Return(
              value=Name(id='canonical', ctx=Load()))],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='check_for_forbidden_verbs',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='text',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Check for forbidden verbs in the text.')),
            Assign(
              targets=[
                Name(id='found_verbs', ctx=Store())],
              value=List(ctx=Load())),
            Assign(
              targets=[
                Name(id='text_lower', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='text', ctx=Load()),
                  attr='lower',
                  ctx=Load()))),
            For(
              target=Name(id='verb', ctx=Store()),
              iter=Attribute(
                value=Name(id='self', ctx=Load()),
                attr='FORBIDDEN_VERBS',
                ctx=Load()),
              body=[
                If(
                  test=Call(
                    func=Attribute(
                      value=Name(id='re', ctx=Load()),
                      attr='search',
                      ctx=Load()),
                    args=[
                      BinOp(
                        left=BinOp(
                          left=Constant(value='\\b'),
                          op=Add(),
                          right=Name(id='verb', ctx=Load())),
                        op=Add(),
                        right=Constant(value='\\b')),
                      Name(id='text_lower', ctx=Load())]),
                  body=[
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Name(id='found_verbs', ctx=Load()),
                          attr='append',
                          ctx=Load()),
                        args=[
                          Name(id='verb', ctx=Load())]))])]),
            Return(
              value=Name(id='found_verbs', ctx=Load()))],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load()))]),
    ClassDef(
      name='DuplicateDetector',
      body=[
        Expr(
          value=Constant(value='Detect duplicate or near-duplicate bullets using TF-IDF cosine similarity.')),
        FunctionDef(
          name='__init__',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            If(
              test=Name(id='SKLEARN_AVAILABLE', ctx=Load()),
              body=[
                Assign(
                  targets=[
                    Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='vectorizer',
                      ctx=Store())],
                  value=Call(
                    func=Name(id='TfidfVectorizer', ctx=Load()),
                    keywords=[
                      keyword(
                        arg='stop_words',
                        value=Constant(value='english')),
                      keyword(
                        arg='norm',
                        value=Constant(value='l2'))]))])]),
        FunctionDef(
          name='find_duplicates',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='bullets',
                annotation=Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Name(id='Dict', ctx=Load()),
                  ctx=Load())),
              arg(
                arg='threshold',
                annotation=Name(id='float', ctx=Load()))],
            defaults=[
              Constant(value=0.9)]),
          body=[
            Expr(
              value=Constant(value='\n        Find bullets with cosine similarity >= threshold.\n        Returns: List of (index1, index2, similarity_score)\n        ')),
            Assign(
              targets=[
                Name(id='duplicates', ctx=Store())],
              value=List(ctx=Load())),
            For(
              target=Name(id='i', ctx=Store()),
              iter=Call(
                func=Name(id='range', ctx=Load()),
                args=[
                  Call(
                    func=Name(id='len', ctx=Load()),
                    args=[
                      Name(id='bullets', ctx=Load())])]),
              body=[
                For(
                  target=Name(id='j', ctx=Store()),
                  iter=Call(
                    func=Name(id='range', ctx=Load()),
                    args=[
                      BinOp(
                        left=Name(id='i', ctx=Load()),
                        op=Add(),
                        right=Constant(value=1)),
                      Call(
                        func=Name(id='len', ctx=Load()),
                        args=[
                          Name(id='bullets', ctx=Load())])]),
                  body=[
                    Assign(
                      targets=[
                        Name(id='similarity', ctx=Store())],
                      value=Call(
                        func=Attribute(
                          value=Name(id='self', ctx=Load()),
                          attr='_calculate_cosine_similarity',
                          ctx=Load()),
                        args=[
                          Call(
                            func=Attribute(
                              value=Subscript(
                                value=Name(id='bullets', ctx=Load()),
                                slice=Name(id='i', ctx=Load()),
                                ctx=Load()),
                              attr='get',
                              ctx=Load()),
                            args=[
                              Constant(value='bullet_text'),
                              Constant(value='')]),
                          Call(
                            func=Attribute(
                              value=Subscript(
                                value=Name(id='bullets', ctx=Load()),
                                slice=Name(id='j', ctx=Load()),
                                ctx=Load()),
                              attr='get',
                              ctx=Load()),
                            args=[
                              Constant(value='bullet_text'),
                              Constant(value='')])])),
                    If(
                      test=Compare(
                        left=Name(id='similarity', ctx=Load()),
                        ops=[
                          GtE()],
                        comparators=[
                          Name(id='threshold', ctx=Load())]),
                      body=[
                        Expr(
                          value=Call(
                            func=Attribute(
                              value=Name(id='duplicates', ctx=Load()),
                              attr='append',
                              ctx=Load()),
                            args=[
                              Tuple(
                                elts=[
                                  Name(id='i', ctx=Load()),
                                  Name(id='j', ctx=Load()),
                                  Name(id='similarity', ctx=Load())],
                                ctx=Load())]))])])]),
            Return(
              value=Name(id='duplicates', ctx=Load()))],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Subscript(
              value=Name(id='Tuple', ctx=Load()),
              slice=Tuple(
                elts=[
                  Name(id='int', ctx=Load()),
                  Name(id='int', ctx=Load()),
                  Name(id='float', ctx=Load())],
                ctx=Load()),
              ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='_calculate_cosine_similarity_sklearn',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='text1',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='text2',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value="Calculate cosine similarity using scikit-learn's TfidfVectorizer.")),
            If(
              test=BoolOp(
                op=Or(),
                values=[
                  UnaryOp(
                    op=Not(),
                    operand=Name(id='text1', ctx=Load())),
                  UnaryOp(
                    op=Not(),
                    operand=Name(id='text2', ctx=Load()))]),
              body=[
                Return(
                  value=Constant(value=0.0))]),
            Try(
              body=[
                Assign(
                  targets=[
                    Name(id='tfidf_matrix', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='vectorizer',
                        ctx=Load()),
                      attr='fit_transform',
                      ctx=Load()),
                    args=[
                      List(
                        elts=[
                          Name(id='text1', ctx=Load()),
                          Name(id='text2', ctx=Load())],
                        ctx=Load())])),
                Return(
                  value=Subscript(
                    value=Subscript(
                      value=Call(
                        func=Name(id='cosine_similarity', ctx=Load()),
                        args=[
                          Subscript(
                            value=Name(id='tfidf_matrix', ctx=Load()),
                            slice=Slice(
                              lower=Constant(value=0),
                              upper=Constant(value=1)),
                            ctx=Load()),
                          Subscript(
                            value=Name(id='tfidf_matrix', ctx=Load()),
                            slice=Slice(
                              lower=Constant(value=1),
                              upper=Constant(value=2)),
                            ctx=Load())]),
                      slice=Constant(value=0),
                      ctx=Load()),
                    slice=Constant(value=0),
                    ctx=Load()))],
              handlers=[
                ExceptHandler(
                  type=Name(id='Exception', ctx=Load()),
                  body=[
                    Return(
                      value=Constant(value=0.0))])])],
          returns=Name(id='float', ctx=Load())),
        FunctionDef(
          name='_calculate_cosine_similarity',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='text1',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='text2',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Calculate TF-IDF cosine similarity between two texts.\n        Uses scikit-learn if available, otherwise falls back to a basic implementation.\n        ')),
            If(
              test=Name(id='SKLEARN_AVAILABLE', ctx=Load()),
              body=[
                Return(
                  value=Call(
                    func=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='_calculate_cosine_similarity_sklearn',
                      ctx=Load()),
                    args=[
                      Name(id='text1', ctx=Load()),
                      Name(id='text2', ctx=Load())]))],
              orelse=[
                If(
                  test=BoolOp(
                    op=Or(),
                    values=[
                      UnaryOp(
                        op=Not(),
                        operand=Name(id='text1', ctx=Load())),
                      UnaryOp(
                        op=Not(),
                        operand=Name(id='text2', ctx=Load()))]),
                  body=[
                    Return(
                      value=Constant(value=0.0))]),
                Assign(
                  targets=[
                    Name(id='words1', ctx=Store())],
                  value=Call(
                    func=Name(id='set', ctx=Load()),
                    args=[
                      Call(
                        func=Attribute(
                          value=Call(
                            func=Attribute(
                              value=Name(id='text1', ctx=Load()),
                              attr='lower',
                              ctx=Load())),
                          attr='split',
                          ctx=Load()))])),
                Assign(
                  targets=[
                    Name(id='words2', ctx=Store())],
                  value=Call(
                    func=Name(id='set', ctx=Load()),
                    args=[
                      Call(
                        func=Attribute(
                          value=Call(
                            func=Attribute(
                              value=Name(id='text2', ctx=Load()),
                              attr='lower',
                              ctx=Load())),
                          attr='split',
                          ctx=Load()))])),
                If(
                  test=BoolOp(
                    op=Or(),
                    values=[
                      UnaryOp(
                        op=Not(),
                        operand=Name(id='words1', ctx=Load())),
                      UnaryOp(
                        op=Not(),
                        operand=Name(id='words2', ctx=Load()))]),
                  body=[
                    Return(
                      value=Constant(value=0.0))]),
                Assign(
                  targets=[
                    Name(id='intersection', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='words1', ctx=Load()),
                      attr='intersection',
                      ctx=Load()),
                    args=[
                      Name(id='words2', ctx=Load())])),
                If(
                  test=UnaryOp(
                    op=Not(),
                    operand=Name(id='intersection', ctx=Load())),
                  body=[
                    Return(
                      value=Constant(value=0.0))]),
                Assign(
                  targets=[
                    Name(id='numerator', ctx=Store())],
                  value=Call(
                    func=Name(id='len', ctx=Load()),
                    args=[
                      Name(id='intersection', ctx=Load())])),
                Assign(
                  targets=[
                    Name(id='denominator', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='math', ctx=Load()),
                      attr='sqrt',
                      ctx=Load()),
                    args=[
                      BinOp(
                        left=Call(
                          func=Name(id='len', ctx=Load()),
                          args=[
                            Name(id='words1', ctx=Load())]),
                        op=Mult(),
                        right=Call(
                          func=Name(id='len', ctx=Load()),
                          args=[
                            Name(id='words2', ctx=Load())]))])),
                If(
                  test=Compare(
                    left=Name(id='denominator', ctx=Load()),
                    ops=[
                      Eq()],
                    comparators=[
                      Constant(value=0)]),
                  body=[
                    Return(
                      value=Constant(value=0.0))]),
                Return(
                  value=BinOp(
                    left=Name(id='numerator', ctx=Load()),
                    op=Div(),
                    right=Name(id='denominator', ctx=Load())))])],
          returns=Name(id='float', ctx=Load())),
        FunctionDef(
          name='compute_similarity_matrix',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='sections',
                annotation=Subscript(
                  value=Name(id='Dict', ctx=Load()),
                  slice=Tuple(
                    elts=[
                      Name(id='str', ctx=Load()),
                      Subscript(
                        value=Name(id='List', ctx=Load()),
                        slice=Name(id='str', ctx=Load()),
                        ctx=Load())],
                    ctx=Load()),
                  ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Compute 78-check pairwise similarity matrix across all sections.\n        Returns comprehensive matrix with all pairwise comparisons.\n        ')),
            Assign(
              targets=[
                Name(id='matrix_data', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='pairwise_checks'),
                  Constant(value='total_comparisons'),
                  Constant(value='duplicates_found'),
                  Constant(value='max_similarity'),
                  Constant(value='sections_analyzed')],
                values=[
                  List(ctx=Load()),
                  Constant(value=0),
                  List(ctx=Load()),
                  Constant(value=0.0),
                  Call(
                    func=Name(id='list', ctx=Load()),
                    args=[
                      Call(
                        func=Attribute(
                          value=Name(id='sections', ctx=Load()),
                          attr='keys',
                          ctx=Load()))])])),
            Assign(
              targets=[
                Name(id='all_bullets', ctx=Store())],
              value=List(ctx=Load())),
            For(
              target=Tuple(
                elts=[
                  Name(id='section_id', ctx=Store()),
                  Name(id='bullets', ctx=Store())],
                ctx=Store()),
              iter=Call(
                func=Attribute(
                  value=Name(id='sections', ctx=Load()),
                  attr='items',
                  ctx=Load())),
              body=[
                If(
                  test=Call(
                    func=Name(id='isinstance', ctx=Load()),
                    args=[
                      Name(id='bullets', ctx=Load()),
                      Name(id='list', ctx=Load())]),
                  body=[
                    For(
                      target=Tuple(
                        elts=[
                          Name(id='idx', ctx=Store()),
                          Name(id='bullet', ctx=Store())],
                        ctx=Store()),
                      iter=Call(
                        func=Name(id='enumerate', ctx=Load()),
                        args=[
                          Name(id='bullets', ctx=Load())]),
                      body=[
                        If(
                          test=BoolOp(
                            op=And(),
                            values=[
                              Call(
                                func=Name(id='isinstance', ctx=Load()),
                                args=[
                                  Name(id='bullet', ctx=Load()),
                                  Name(id='str', ctx=Load())]),
                              Call(
                                func=Attribute(
                                  value=Name(id='bullet', ctx=Load()),
                                  attr='strip',
                                  ctx=Load()))]),
                          body=[
                            Expr(
                              value=Call(
                                func=Attribute(
                                  value=Name(id='all_bullets', ctx=Load()),
                                  attr='append',
                                  ctx=Load()),
                                args=[
                                  Dict(
                                    keys=[
                                      Constant(value='section'),
                                      Constant(value='index'),
                                      Constant(value='text')],
                                    values=[
                                      Name(id='section_id', ctx=Load()),
                                      Name(id='idx', ctx=Load()),
                                      Call(
                                        func=Attribute(
                                          value=Name(id='bullet', ctx=Load()),
                                          attr='strip',
                                          ctx=Load()))])]))])])])]),
            For(
              target=Name(id='i', ctx=Store()),
              iter=Call(
                func=Name(id='range', ctx=Load()),
                args=[
                  Call(
                    func=Name(id='len', ctx=Load()),
                    args=[
                      Name(id='all_bullets', ctx=Load())])]),
              body=[
                For(
                  target=Name(id='j', ctx=Store()),
                  iter=Call(
                    func=Name(id='range', ctx=Load()),
                    args=[
                      BinOp(
                        left=Name(id='i', ctx=Load()),
                        op=Add(),
                        right=Constant(value=1)),
                      Call(
                        func=Name(id='len', ctx=Load()),
                        args=[
                          Name(id='all_bullets', ctx=Load())])]),
                  body=[
                    Assign(
                      targets=[
                        Name(id='b1', ctx=Store())],
                      value=Subscript(
                        value=Name(id='all_bullets', ctx=Load()),
                        slice=Name(id='i', ctx=Load()),
                        ctx=Load())),
                    Assign(
                      targets=[
                        Name(id='b2', ctx=Store())],
                      value=Subscript(
                        value=Name(id='all_bullets', ctx=Load()),
                        slice=Name(id='j', ctx=Load()),
                        ctx=Load())),
                    Assign(
                      targets=[
                        Name(id='similarity', ctx=Store())],
                      value=Call(
                        func=Attribute(
                          value=Name(id='self', ctx=Load()),
                          attr='_calculate_cosine_similarity',
                          ctx=Load()),
                        args=[
                          Subscript(
                            value=Name(id='b1', ctx=Load()),
                            slice=Constant(value='text'),
                            ctx=Load()),
                          Subscript(
                            value=Name(id='b2', ctx=Load()),
                            slice=Constant(value='text'),
                            ctx=Load())])),
                    Assign(
                      targets=[
                        Name(id='comparison', ctx=Store())],
                      value=Dict(
                        keys=[
                          Constant(value='bullet_1'),
                          Constant(value='bullet_2'),
                          Constant(value='similarity'),
                          Constant(value='cross_section')],
                        values=[
                          JoinedStr(
                            values=[
                              FormattedValue(
                                value=Subscript(
                                  value=Name(id='b1', ctx=Load()),
                                  slice=Constant(value='section'),
                                  ctx=Load()),
                                conversion=-1),
                              Constant(value='['),
                              FormattedValue(
                                value=Subscript(
                                  value=Name(id='b1', ctx=Load()),
                                  slice=Constant(value='index'),
                                  ctx=Load()),
                                conversion=-1),
                              Constant(value=']')]),
                          JoinedStr(
                            values=[
                              FormattedValue(
                                value=Subscript(
                                  value=Name(id='b2', ctx=Load()),
                                  slice=Constant(value='section'),
                                  ctx=Load()),
                                conversion=-1),
                              Constant(value='['),
                              FormattedValue(
                                value=Subscript(
                                  value=Name(id='b2', ctx=Load()),
                                  slice=Constant(value='index'),
                                  ctx=Load()),
                                conversion=-1),
                              Constant(value=']')]),
                          Call(
                            func=Name(id='round', ctx=Load()),
                            args=[
                              Name(id='similarity', ctx=Load()),
                              Constant(value=4)]),
                          Compare(
                            left=Subscript(
                              value=Name(id='b1', ctx=Load()),
                              slice=Constant(value='section'),
                              ctx=Load()),
                            ops=[
                              NotEq()],
                            comparators=[
                              Subscript(
                                value=Name(id='b2', ctx=Load()),
                                slice=Constant(value='section'),
                                ctx=Load())])])),
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Subscript(
                            value=Name(id='matrix_data', ctx=Load()),
                            slice=Constant(value='pairwise_checks'),
                            ctx=Load()),
                          attr='append',
                          ctx=Load()),
                        args=[
