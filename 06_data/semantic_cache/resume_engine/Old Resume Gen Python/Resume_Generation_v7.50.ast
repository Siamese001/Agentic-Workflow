                args=[
                  Constant(value=2),
                  Call(
                    func=Name(id='min', ctx=Load()),
                    args=[
                      Name(id='tot_d', ctx=Load()),
                      Constant(value=5)])]),
              Call(
                func=Name(id='max', ctx=Load()),
                args=[
                  Constant(value=1),
                  Call(
                    func=Name(id='min', ctx=Load()),
                    args=[
                      Name(id='sc', ctx=Load()),
                      Constant(value=30)])]),
              Name(id='reflexion', ctx=Load()),
              Call(
                func=Name(id='max', ctx=Load()),
                args=[
                  Constant(value=1),
                  Call(
                    func=Name(id='min', ctx=Load()),
                    args=[
                      Name(id='max_loops', ctx=Load()),
