                                  FormattedValue(
                                    value=Name(id='validator_ref', ctx=Load()),
                                    conversion=-1),
                                  Constant(value="' not found in "),
                                  FormattedValue(
                                    value=Attribute(
                                      value=Attribute(
                                        value=Name(id='self', ctx=Load()),
