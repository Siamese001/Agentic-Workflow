                                comparators=[
                                  Attribute(
                                    value=Name(id='ResumeSection', ctx=Load()),
                                    attr='K7_TRADERSENSE_BULLETS',
                                    ctx=Load())])]),
                          body=[
                            AugAssign(
                              target=Subscript(
