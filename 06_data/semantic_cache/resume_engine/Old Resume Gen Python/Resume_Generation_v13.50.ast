                  value=Name(id='List', ctx=Load()),
                  slice=Name(id='ValidationResult', ctx=Load()),
                  ctx=Load())],
              ctx=Load()),
            ctx=Load()))]),
    ClassDef(
      name='DuplicateDetector',
      body=[
        Expr(
          value=Constant(value='Detect duplicate or near-duplicate bullets using TF-IDF cosine similarity.')),
        FunctionDef(
          name='__init__',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            If(
              test=Name(id='SKLEARN_AVAILABLE', ctx=Load()),
              body=[
                Assign(
                  targets=[
                    Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='vectorizer',
                      ctx=Store())],
                  value=Call(
                    func=Name(id='TfidfVectorizer', ctx=Load()),
                    keywords=[
                      keyword(
                        arg='stop_words',
                        value=Constant(value='english')),
                      keyword(
                        arg='norm',
                        value=Constant(value='l2'))]))])]),
        FunctionDef(
          name='find_duplicates',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='bullets',
                annotation=Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Name(id='Dict', ctx=Load()),
                  ctx=Load())),
              arg(
                arg='threshold',
                annotation=Name(id='float', ctx=Load()))],
            defaults=[
              Constant(value=0.9)]),
          body=[
            Expr(
              value=Constant(value='\n        Find bullets with cosine similarity >= threshold.\n        Returns: List of (index1, index2, similarity_score)\n        ')),
            Assign(
              targets=[
                Name(id='duplicates', ctx=Store())],
              value=List(ctx=Load())),
            For(
              target=Name(id='i', ctx=Store()),
              iter=Call(
                func=Name(id='range', ctx=Load()),
                args=[
                  Call(
                    func=Name(id='len', ctx=Load()),
                    args=[
                      Name(id='bullets', ctx=Load())])]),
              body=[
                For(
                  target=Name(id='j', ctx=Store()),
                  iter=Call(
                    func=Name(id='range', ctx=Load()),
                    args=[
                      BinOp(
                        left=Name(id='i', ctx=Load()),
                        op=Add(),
                        right=Constant(value=1)),
                      Call(
                        func=Name(id='len', ctx=Load()),
                        args=[
                          Name(id='bullets', ctx=Load())])]),
                  body=[
                    Assign(
                      targets=[
                        Name(id='similarity', ctx=Store())],
                      value=Call(
                        func=Attribute(
                          value=Name(id='self', ctx=Load()),
                          attr='_calculate_cosine_similarity',
                          ctx=Load()),
                        args=[
                          Call(
                            func=Attribute(
                              value=Subscript(
                                value=Name(id='bullets', ctx=Load()),
                                slice=Name(id='i', ctx=Load()),
                                ctx=Load()),
                              attr='get',
                              ctx=Load()),
                            args=[
                              Constant(value='bullet_text'),
                              Constant(value='')]),
                          Call(
                            func=Attribute(
                              value=Subscript(
                                value=Name(id='bullets', ctx=Load()),
                                slice=Name(id='j', ctx=Load()),
                                ctx=Load()),
                              attr='get',
                              ctx=Load()),
                            args=[
                              Constant(value='bullet_text'),
                              Constant(value='')])])),
                    If(
                      test=Compare(
                        left=Name(id='similarity', ctx=Load()),
                        ops=[
                          GtE()],
                        comparators=[
                          Name(id='threshold', ctx=Load())]),
                      body=[
                        Expr(
                          value=Call(
                            func=Attribute(
                              value=Name(id='duplicates', ctx=Load()),
                              attr='append',
                              ctx=Load()),
                            args=[
                              Tuple(
                                elts=[
                                  Name(id='i', ctx=Load()),
                                  Name(id='j', ctx=Load()),
                                  Name(id='similarity', ctx=Load())],
                                ctx=Load())]))])])]),
            Return(
              value=Name(id='duplicates', ctx=Load()))],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Subscript(
              value=Name(id='Tuple', ctx=Load()),
              slice=Tuple(
                elts=[
                  Name(id='int', ctx=Load()),
                  Name(id='int', ctx=Load()),
                  Name(id='float', ctx=Load())],
                ctx=Load()),
              ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='_calculate_cosine_similarity_sklearn',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='text1',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='text2',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value="Calculate cosine similarity using scikit-learn's TfidfVectorizer.")),
            If(
              test=BoolOp(
                op=Or(),
                values=[
                  UnaryOp(
                    op=Not(),
                    operand=Name(id='text1', ctx=Load())),
                  UnaryOp(
                    op=Not(),
                    operand=Name(id='text2', ctx=Load()))]),
              body=[
                Return(
                  value=Constant(value=0.0))]),
            Try(
              body=[
                Assign(
                  targets=[
                    Name(id='tfidf_matrix', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='vectorizer',
                        ctx=Load()),
                      attr='fit_transform',
                      ctx=Load()),
                    args=[
                      List(
                        elts=[
                          Name(id='text1', ctx=Load()),
                          Name(id='text2', ctx=Load())],
                        ctx=Load())])),
                Return(
                  value=Subscript(
                    value=Subscript(
                      value=Call(
                        func=Name(id='cosine_similarity', ctx=Load()),
                        args=[
                          Subscript(
                            value=Name(id='tfidf_matrix', ctx=Load()),
                            slice=Slice(
                              lower=Constant(value=0),
                              upper=Constant(value=1)),
                            ctx=Load()),
                          Subscript(
                            value=Name(id='tfidf_matrix', ctx=Load()),
                            slice=Slice(
                              lower=Constant(value=1),
                              upper=Constant(value=2)),
                            ctx=Load())]),
                      slice=Constant(value=0),
                      ctx=Load()),
                    slice=Constant(value=0),
                    ctx=Load()))],
              handlers=[
                ExceptHandler(
                  type=Name(id='Exception', ctx=Load()),
                  body=[
                    Return(
                      value=Constant(value=0.0))])])],
          returns=Name(id='float', ctx=Load())),
        FunctionDef(
          name='_calculate_cosine_similarity',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='text1',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='text2',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Calculate TF-IDF cosine similarity between two texts.\n        Uses scikit-learn if available, otherwise falls back to a basic implementation.\n        ')),
            If(
              test=Name(id='SKLEARN_AVAILABLE', ctx=Load()),
              body=[
                Return(
                  value=Call(
                    func=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='_calculate_cosine_similarity_sklearn',
                      ctx=Load()),
                    args=[
                      Name(id='text1', ctx=Load()),
                      Name(id='text2', ctx=Load())]))],
              orelse=[
                If(
                  test=BoolOp(
                    op=Or(),
                    values=[
                      UnaryOp(
                        op=Not(),
                        operand=Name(id='text1', ctx=Load())),
                      UnaryOp(
                        op=Not(),
                        operand=Name(id='text2', ctx=Load()))]),
                  body=[
                    Return(
                      value=Constant(value=0.0))]),
                Assign(
                  targets=[
                    Name(id='words1', ctx=Store())],
                  value=Call(
                    func=Name(id='set', ctx=Load()),
                    args=[
                      Call(
                        func=Attribute(
                          value=Call(
                            func=Attribute(
                              value=Name(id='text1', ctx=Load()),
                              attr='lower',
                              ctx=Load())),
                          attr='split',
                          ctx=Load()))])),
                Assign(
                  targets=[
                    Name(id='words2', ctx=Store())],
                  value=Call(
                    func=Name(id='set', ctx=Load()),
                    args=[
                      Call(
                        func=Attribute(
                          value=Call(
                            func=Attribute(
                              value=Name(id='text2', ctx=Load()),
                              attr='lower',
                              ctx=Load())),
                          attr='split',
                          ctx=Load()))])),
                If(
                  test=BoolOp(
                    op=Or(),
                    values=[
                      UnaryOp(
                        op=Not(),
                        operand=Name(id='words1', ctx=Load())),
                      UnaryOp(
                        op=Not(),
                        operand=Name(id='words2', ctx=Load()))]),
                  body=[
                    Return(
                      value=Constant(value=0.0))]),
                Assign(
                  targets=[
                    Name(id='intersection', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='words1', ctx=Load()),
                      attr='intersection',
                      ctx=Load()),
                    args=[
                      Name(id='words2', ctx=Load())])),
                If(
                  test=UnaryOp(
                    op=Not(),
                    operand=Name(id='intersection', ctx=Load())),
                  body=[
                    Return(
                      value=Constant(value=0.0))]),
                Assign(
                  targets=[
                    Name(id='numerator', ctx=Store())],
                  value=Call(
                    func=Name(id='len', ctx=Load()),
                    args=[
                      Name(id='intersection', ctx=Load())])),
                Assign(
                  targets=[
                    Name(id='denominator', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='math', ctx=Load()),
                      attr='sqrt',
                      ctx=Load()),
                    args=[
                      BinOp(
                        left=Call(
                          func=Name(id='len', ctx=Load()),
                          args=[
                            Name(id='words1', ctx=Load())]),
                        op=Mult(),
                        right=Call(
                          func=Name(id='len', ctx=Load()),
                          args=[
                            Name(id='words2', ctx=Load())]))])),
                If(
                  test=Compare(
                    left=Name(id='denominator', ctx=Load()),
                    ops=[
                      Eq()],
                    comparators=[
                      Constant(value=0)]),
                  body=[
                    Return(
                      value=Constant(value=0.0))]),
                Return(
                  value=BinOp(
                    left=Name(id='numerator', ctx=Load()),
                    op=Div(),
                    right=Name(id='denominator', ctx=Load())))])],
          returns=Name(id='float', ctx=Load())),
        FunctionDef(
          name='compute_similarity_matrix',
          args=arguments(
            args=[
              arg(arg='self'),
