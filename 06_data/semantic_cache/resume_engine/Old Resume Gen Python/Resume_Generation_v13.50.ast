    FunctionDef(
      name='_get_normalized_reasoning_params',
      args=arguments(
        args=[
          arg(
            arg='config',
            annotation=Name(id='ReasoningConfig', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='Handles defaults and clamps reasoning config values.')),
        Assign(
          targets=[
            Name(id='config', ctx=Store())],
          value=BoolOp(
            op=Or(),
            values=[
              Name(id='config', ctx=Load()),
              Attribute(
                value=Name(id='ReasoningConfig', ctx=Load()),
                attr='DEFAULT',
                ctx=Load())])),
        Assign(
          targets=[
            Name(id='tot_b', ctx=Store())],
          value=IfExp(
            test=Compare(
              left=Attribute(
                value=Name(id='config', ctx=Load()),
                attr='tot_branches',
                ctx=Load()),
              ops=[
                IsNot()],
              comparators=[
                Constant(value=None)]),
            body=Attribute(
              value=Name(id='config', ctx=Load()),
              attr='tot_branches',
              ctx=Load()),
            orelse=Constant(value=3))),
        Assign(
          targets=[
            Name(id='tot_d', ctx=Store())],
          value=IfExp(
            test=Compare(
              left=Attribute(
                value=Name(id='config', ctx=Load()),
                attr='min_tot_depth',
                ctx=Load()),
              ops=[
                IsNot()],
              comparators=[
                Constant(value=None)]),
            body=Attribute(
              value=Name(id='config', ctx=Load()),
              attr='min_tot_depth',
              ctx=Load()),
            orelse=Constant(value=3))),
        Assign(
          targets=[
            Name(id='sc', ctx=Store())],
          value=IfExp(
            test=Compare(
              left=Attribute(
                value=Name(id='config', ctx=Load()),
                attr='self_consistency',
                ctx=Load()),
              ops=[
                IsNot()],
              comparators=[
                Constant(value=None)]),
            body=Attribute(
              value=Name(id='config', ctx=Load()),
              attr='self_consistency',
              ctx=Load()),
            orelse=Constant(value=12))),
        Assign(
          targets=[
            Name(id='reflexion', ctx=Store())],
          value=IfExp(
            test=Compare(
              left=Attribute(
                value=Name(id='config', ctx=Load()),
                attr='reflexion',
                ctx=Load()),
              ops=[
                IsNot()],
              comparators=[
                Constant(value=None)]),
            body=Attribute(
              value=Name(id='config', ctx=Load()),
              attr='reflexion',
              ctx=Load()),
            orelse=Constant(value=True))),
        Assign(
          targets=[
            Name(id='max_loops', ctx=Store())],
          value=IfExp(
            test=Compare(
              left=Attribute(
                value=Name(id='config', ctx=Load()),
                attr='max_reflexion_loops',
                ctx=Load()),
              ops=[
                IsNot()],
              comparators=[
                Constant(value=None)]),
            body=Attribute(
              value=Name(id='config', ctx=Load()),
              attr='max_reflexion_loops',
              ctx=Load()),
            orelse=Constant(value=2))),
        Assign(
          targets=[
            Name(id='sc_clamped', ctx=Store())],
          value=Call(
            func=Name(id='max', ctx=Load()),
            args=[
              Constant(value=1),
              Call(
                func=Name(id='min', ctx=Load()),
                args=[
                  Name(id='sc', ctx=Load()),
                  Constant(value=8)])])),
        Return(
          value=Dict(
            keys=[
              Constant(value='cot'),
              Constant(value='tot_b'),
              Constant(value='tot_d'),
              Constant(value='sc'),
              Constant(value='reflexion'),
              Constant(value='max_loops')],
            values=[
              Call(
                func=Name(id='max', ctx=Load()),
                args=[
                  Constant(value=2),
                  Call(
                    func=Name(id='min', ctx=Load()),
                    args=[
                      IfExp(
                        test=Compare(
                          left=Attribute(
                            value=Name(id='config', ctx=Load()),
                            attr='cot_min_paths',
                            ctx=Load()),
                          ops=[
                            IsNot()],
                          comparators=[
                            Constant(value=None)]),
                        body=Attribute(
                          value=Name(id='config', ctx=Load()),
                          attr='cot_min_paths',
                          ctx=Load()),
                        orelse=Constant(value=3)),
                      Constant(value=8)])]),
              Call(
                func=Name(id='max', ctx=Load()),
                args=[
                  Constant(value=2),
                  Call(
                    func=Name(id='min', ctx=Load()),
                    args=[
                      Name(id='tot_b', ctx=Load()),
                      Constant(value=6)])]),
              Call(
                func=Name(id='max', ctx=Load()),
                args=[
                  Constant(value=2),
                  Call(
                    func=Name(id='min', ctx=Load()),
                    args=[
                      Name(id='tot_d', ctx=Load()),
                      Constant(value=5)])]),
              Name(id='sc_clamped', ctx=Load()),
              Name(id='reflexion', ctx=Load()),
              Call(
                func=Name(id='max', ctx=Load()),
                args=[
                  Constant(value=1),
                  Call(
                    func=Name(id='min', ctx=Load()),
                    args=[
                      Name(id='max_loops', ctx=Load()),
                      Constant(value=5)])])]))],
      returns=Name(id='Dict', ctx=Load())),
    FunctionDef(
      name='_calculate_reasoning_intensity',
      args=arguments(
        args=[
          arg(
            arg='params',
            annotation=Name(id='Dict', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='Calculates a numeric intensity score and a qualitative level from reasoning parameters.')),
        Assign(
          targets=[
            Name(id='intensity', ctx=Store())],
          value=BinOp(
            left=BinOp(
              left=BinOp(
                left=BinOp(
                  left=Subscript(
                    value=Name(id='params', ctx=Load()),
                    slice=Constant(value='cot'),
                    ctx=Load()),
                  op=Mult(),
                  right=Constant(value=2.0)),
                op=Add(),
                right=BinOp(
                  left=Subscript(
                    value=Name(id='params', ctx=Load()),
                    slice=Constant(value='tot_b'),
                    ctx=Load()),
                  op=Mult(),
                  right=Constant(value=2.0))),
              op=Add(),
              right=BinOp(
                left=Subscript(
                  value=Name(id='params', ctx=Load()),
                  slice=Constant(value='tot_d'),
                  ctx=Load()),
                op=Mult(),
                right=Constant(value=2.0))),
            op=Add(),
            right=BinOp(
              left=Subscript(
                value=Name(id='params', ctx=Load()),
                slice=Constant(value='sc'),
                ctx=Load()),
              op=Div(),
              right=Constant(value=5.0)))),
        If(
          test=Compare(
            left=Name(id='intensity', ctx=Load()),
            ops=[
              GtE()],
            comparators=[
              Constant(value=35)]),
          body=[
            Assign(
              targets=[
                Name(id='level', ctx=Store())],
              value=Constant(value='VERY_HIGH'))],
          orelse=[
            If(
              test=Compare(
                left=Name(id='intensity', ctx=Load()),
                ops=[
                  GtE()],
                comparators=[
                  Constant(value=25)]),
              body=[
                Assign(
                  targets=[
                    Name(id='level', ctx=Store())],
                  value=Constant(value='HIGH'))],
              orelse=[
                If(
                  test=Compare(
                    left=Name(id='intensity', ctx=Load()),
                    ops=[
                      GtE()],
                    comparators=[
                      Constant(value=15)]),
                  body=[
                    Assign(
                      targets=[
                        Name(id='level', ctx=Store())],
                      value=Constant(value='MODERATE'))],
                  orelse=[
                    If(
                      test=Compare(
                        left=Name(id='intensity', ctx=Load()),
                        ops=[
                          GtE()],
                        comparators=[
                          Constant(value=8)]),
                      body=[
                        Assign(
                          targets=[
                            Name(id='level', ctx=Store())],
                          value=Constant(value='LOW'))],
                      orelse=[
                        Assign(
                          targets=[
                            Name(id='level', ctx=Store())],
                          value=Constant(value='MINIMAL'))])])])]),
        Return(
          value=Tuple(
            elts=[
              Name(id='intensity', ctx=Load()),
              Name(id='level', ctx=Load())],
            ctx=Load()))],
      returns=Subscript(
        value=Name(id='Tuple', ctx=Load()),
        slice=Tuple(
          elts=[
            Name(id='float', ctx=Load()),
            Name(id='str', ctx=Load())],
          ctx=Load()),
        ctx=Load())),
    FunctionDef(
      name='_get_generation_temperature',
      args=arguments(),
      body=[
        Expr(
          value=Constant(value="\n    [OPTIMIZED FOR CREATIVITY]\n    This version maximizes temperature to promote creative and unique output,\n    while the workflow's Reasoning Intensity (CoT, ToT) maintains signal/relevance.\n    The 'intensity' parameter was previously unused, so it has been removed.\n    ")),
        Return(
          value=Constant(value=0.9))],
      returns=Name(id='float', ctx=Load())),
    FunctionDef(
      name='_allocate_tokens_from_depth',
      args=arguments(
        args=[
          arg(
            arg='tot_d',
            annotation=Name(id='int', ctx=Load())),
          arg(
            arg='cot',
            annotation=Name(id='int', ctx=Load())),
          arg(
            arg='sc',
            annotation=Name(id='int', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    [REVISED FOR OPTION B]\n    Allocates max_tokens based on reasoning depth and complexity, providing\n    higher limits for more complex reasoning tasks.\n    ')),
        Assign(
          targets=[
            Name(id='base_limit', ctx=Store())],
          value=Constant(value=16384)),
        Assign(
          targets=[
            Name(id='high_sc_limit', ctx=Store())],
          value=Constant(value=24000)),
        Assign(
          targets=[
            Name(id='mid_complex_limit', ctx=Store())],
          value=Constant(value=26000)),
        Assign(
          targets=[
            Name(id='high_complex_limit', ctx=Store())],
          value=Constant(value=28000)),
        Assign(
          targets=[
            Name(id='max_complex_limit', ctx=Store())],
          value=Constant(value=30000)),
        If(
          test=Compare(
            left=Name(id='tot_d', ctx=Load()),
            ops=[
              GtE()],
            comparators=[
              Constant(value=4)]),
          body=[
            Assign(
              targets=[
                Name(id='max_tokens', ctx=Store())],
              value=Name(id='max_complex_limit', ctx=Load()))],
          orelse=[
            If(
              test=BoolOp(
                op=And(),
                values=[
                  Compare(
                    left=Name(id='tot_d', ctx=Load()),
                    ops=[
                      GtE()],
                    comparators=[
                      Constant(value=3)]),
                  Compare(
                    left=Name(id='cot', ctx=Load()),
                    ops=[
                      GtE()],
                    comparators=[
                      Constant(value=5)])]),
              body=[
                Assign(
                  targets=[
                    Name(id='max_tokens', ctx=Store())],
                  value=Name(id='high_complex_limit', ctx=Load()))],
              orelse=[
                If(
                  test=BoolOp(
                    op=Or(),
                    values=[
                      Compare(
                        left=Name(id='tot_d', ctx=Load()),
                        ops=[
                          GtE()],
                        comparators=[
                          Constant(value=3)]),
                      Compare(
                        left=Name(id='cot', ctx=Load()),
                        ops=[
                          GtE()],
                        comparators=[
                          Constant(value=5)])]),
                  body=[
                    Assign(
                      targets=[
                        Name(id='max_tokens', ctx=Store())],
                      value=Name(id='mid_complex_limit', ctx=Load()))],
                  orelse=[
                    If(
                      test=Compare(
                        left=Name(id='sc', ctx=Load()),
                        ops=[
                          GtE()],
                        comparators=[
                          Constant(value=15)]),
                      body=[
                        Assign(
                          targets=[
                            Name(id='max_tokens', ctx=Store())],
                          value=Name(id='high_sc_limit', ctx=Load()))],
                      orelse=[
                        Assign(
                          targets=[
                            Name(id='max_tokens', ctx=Store())],
                          value=Name(id='base_limit', ctx=Load()))])])])]),
        Assign(
          targets=[
            Name(id='rag_config_max', ctx=Store())],
          value=Constant(value=30000)),
        Return(
          value=Call(
            func=Name(id='max', ctx=Load()),
            args=[
              Name(id='base_limit', ctx=Load()),
              Call(
                func=Name(id='min', ctx=Load()),
                args=[
                  Name(id='max_tokens', ctx=Load()),
                  Name(id='rag_config_max', ctx=Load())])]))],
      returns=Name(id='int', ctx=Load())),
    FunctionDef(
      name='_build_reasoning_prompt_addendum',
      args=arguments(
        args=[
          arg(
            arg='params',
            annotation=Name(id='Dict', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='Constructs the system prompt addendum based on reasoning parameters.')),
        Assign(
          targets=[
            Name(id='p', ctx=Store())],
          value=Name(id='params', ctx=Load())),
        Assign(
          targets=[
            Name(id='addendum', ctx=Store())],
          value=JoinedStr(
            values=[
              Constant(value='\n\n**REASONING IMPLEMENTATION DIRECTIVES (v5.71):**\n')])),
        AugAssign(
          target=Name(id='addendum', ctx=Store()),
          op=Add(),
          value=JoinedStr(
            values=[
              Constant(value='(Configuration Level: '),
              FormattedValue(
                value=Subscript(
                  value=Name(id='p', ctx=Load()),
                  slice=Constant(value='reasoning_level'),
                  ctx=Load()),
                conversion=-1),
              Constant(value=', Intensity: '),
              FormattedValue(
                value=Subscript(
                  value=Name(id='p', ctx=Load()),
                  slice=Constant(value='intensity_score'),
                  ctx=Load()),
                conversion=-1,
                format_spec=JoinedStr(
                  values=[
                    Constant(value='.1f')])),
              Constant(value='/40)\n\n')])),
        If(
          test=Compare(
            left=Subscript(
              value=Name(id='p', ctx=Load()),
              slice=Constant(value='cot'),
              ctx=Load()),
            ops=[
              GtE()],
            comparators=[
              Constant(value=5)]),
          body=[
            AugAssign(
              target=Name(id='addendum', ctx=Store()),
              op=Add(),
              value=JoinedStr(
                values=[
                  Constant(value='• MANDATORY: Explore at least '),
                  FormattedValue(
                    value=Subscript(
                      value=Name(id='p', ctx=Load()),
                      slice=Constant(value='cot'),
                      ctx=Load()),
                    conversion=-1),
                  Constant(value=' distinct reasoning paths before reaching a conclusion.\n')]))],
          orelse=[
            If(
              test=Compare(
                left=Subscript(
                  value=Name(id='p', ctx=Load()),
                  slice=Constant(value='cot'),
                  ctx=Load()),
                ops=[
                  GtE()],
                comparators=[
                  Constant(value=4)]),
              body=[
                AugAssign(
                  target=Name(id='addendum', ctx=Store()),
                  op=Add(),
                  value=JoinedStr(
                    values=[
                      Constant(value='• Explore '),
                      FormattedValue(
                        value=Subscript(
                          value=Name(id='p', ctx=Load()),
                          slice=Constant(value='cot'),
                          ctx=Load()),
                        conversion=-1),
                      Constant(value=' different reasoning paths; compare and synthesize insights.\n')]))],
              orelse=[
                AugAssign(
                  target=Name(id='addendum', ctx=Store()),
                  op=Add(),
                  value=JoinedStr(
                    values=[
                      Constant(value='• Consider multiple reasoning approaches before concluding.\n')]))])]),
        If(
          test=Compare(
            left=Subscript(
              value=Name(id='p', ctx=Load()),
              slice=Constant(value='tot_b'),
              ctx=Load()),
            ops=[
              GtE()],
            comparators=[
              Constant(value=5)]),
          body=[
            AugAssign(
              target=Name(id='addendum', ctx=Store()),
              op=Add(),
              value=JoinedStr(
                values=[
                  Constant(value='• MANDATORY: At each decision point, systematically evaluate '),
                  FormattedValue(
                    value=Subscript(
                      value=Name(id='p', ctx=Load()),
                      slice=Constant(value='tot_b'),
                      ctx=Load()),
                    conversion=-1),
                  Constant(value=' different branches/alternatives.\n')]))],
          orelse=[
            If(
              test=Compare(
                left=Subscript(
                  value=Name(id='p', ctx=Load()),
                  slice=Constant(value='tot_b'),
                  ctx=Load()),
                ops=[
                  GtE()],
                comparators=[
                  Constant(value=4)]),
              body=[
                AugAssign(
                  target=Name(id='addendum', ctx=Store()),
                  op=Add(),
                  value=JoinedStr(
                    values=[
                      Constant(value='• Explore '),
                      FormattedValue(
                        value=Subscript(
                          value=Name(id='p', ctx=Load()),
                          slice=Constant(value='tot_b'),
                          ctx=Load()),
                        conversion=-1),
                      Constant(value=' decision branches at critical junctures; document tradeoffs.\n')]))],
              orelse=[
                AugAssign(
                  target=Name(id='addendum', ctx=Store()),
                  op=Add(),
                  value=JoinedStr(
                    values=[
                      Constant(value='• Consider multiple decision branches at key steps.\n')]))])]),
        If(
          test=Compare(
            left=Subscript(
              value=Name(id='p', ctx=Load()),
              slice=Constant(value='tot_d'),
              ctx=Load()),
            ops=[
