                  test=Call(
                    func=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='_has_implausible_growth',
                      ctx=Load()),
                    args=[
                      Name(id='text', ctx=Load())]),
                  body=[
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Name(id='results', ctx=Load()),
                          attr='append',
                          ctx=Load()),
                        args=[
                          Call(
                            func=Name(id='ValidationResult', ctx=Load()),
                            keywords=[
                              keyword(
                                arg='rule_id',
                                value=Constant(value='HALLUCINATION_IMPLAUSIBLE_GROWTH')),
                              keyword(
                                arg='passed',
                                value=Constant(value=False)),
                              keyword(
                                arg='severity',
                                value=Attribute(
                                  value=Name(id='ValidationSeverity', ctx=Load()),
                                  attr='HIGH',
                                  ctx=Load())),
                              keyword(
                                arg='message',
                                value=JoinedStr(
                                  values=[
                                    Constant(value='Bullet '),
                                    FormattedValue(
                                      value=BinOp(
                                        left=Name(id='i', ctx=Load()),
                                        op=Add(),
                                        right=Constant(value=1)),
                                      conversion=-1),
                                    Constant(value=' may contain implausible growth rate')])),
                              keyword(
                                arg='details',
                                value=Dict(
                                  keys=[
                                    Constant(value='bullet_text')],
                                  values=[
                                    Subscript(
                                      value=Name(id='text', ctx=Load()),
                                      slice=Slice(
                                        upper=Constant(value=100)),
                                      ctx=Load())]))])]))]),
                If(
                  test=Call(
                    func=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='_has_excessive_superlatives',
                      ctx=Load()),
                    args=[
                      Name(id='text', ctx=Load())]),
                  body=[
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Name(id='results', ctx=Load()),
                          attr='append',
                          ctx=Load()),
                        args=[
                          Call(
                            func=Name(id='ValidationResult', ctx=Load()),
                            keywords=[
                              keyword(
                                arg='rule_id',
                                value=Constant(value='HALLUCINATION_EXCESSIVE_SUPERLATIVES')),
                              keyword(
                                arg='passed',
                                value=Constant(value=False)),
                              keyword(
                                arg='severity',
                                value=Attribute(
                                  value=Name(id='ValidationSeverity', ctx=Load()),
                                  attr='HIGH',
                                  ctx=Load())),
                              keyword(
                                arg='message',
                                value=JoinedStr(
                                  values=[
                                    Constant(value='Bullet '),
                                    FormattedValue(
                                      value=BinOp(
                                        left=Name(id='i', ctx=Load()),
                                        op=Add(),
                                        right=Constant(value=1)),
                                      conversion=-1),
                                    Constant(value=' contains excessive superlatives')])),
                              keyword(
                                arg='details',
                                value=Dict(
                                  keys=[
                                    Constant(value='bullet_text')],
                                  values=[
                                    Subscript(
                                      value=Name(id='text', ctx=Load()),
                                      slice=Slice(
                                        upper=Constant(value=100)),
                                      ctx=Load())]))])]))])]),
            If(
              test=UnaryOp(
                op=Not(),
                operand=Name(id='results', ctx=Load())),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='results', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Call(
                        func=Name(id='ValidationResult', ctx=Load()),
                        keywords=[
                          keyword(
                            arg='rule_id',
                            value=Constant(value='HALLUCINATION_CHECK')),
                          keyword(
                            arg='passed',
                            value=Constant(value=True)),
                          keyword(
                            arg='severity',
                            value=Attribute(
                              value=Name(id='ValidationSeverity', ctx=Load()),
                              attr='INFO',
                              ctx=Load())),
                          keyword(
                            arg='message',
                            value=JoinedStr(
                              values=[
                                Constant(value='No hallucinations detected in '),
