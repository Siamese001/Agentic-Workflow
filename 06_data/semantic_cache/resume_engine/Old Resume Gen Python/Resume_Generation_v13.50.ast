                                    value=Name(id='BulletProvenance', ctx=Load()),
                                    attr='Verbatim',
                                    ctx=Load()),
                                  attr='value',
                                  ctx=Load()),
                                ctx=Store()),
                              op=Add(),
                              value=Constant(value=1))])])]),
                For(
                  target=Tuple(
                    elts=[
                      Name(id='prov_type', ctx=Store()),
                      Name(id='target_count', ctx=Store())],
