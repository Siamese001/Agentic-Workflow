                      op=Sub(),
                      right=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='target_cv',
                        ctx=Load())),
                    op=Mult(),
                    right=Constant(value=1.0))),
                Return(
                  value=Tuple(
                    elts=[
                      Name(id='cv', ctx=Load()),
                      Call(
                        func=Name(id='min', ctx=Load()),
                        args=[
                          Name(id='penalty', ctx=Load()),
                          Constant(value=0.05)])],
                    ctx=Load()))]),
            Return(
              value=Tuple(
                elts=[
                  Name(id='cv', ctx=Load()),
                  Constant(value=0.0)],
                ctx=Load()))],
          returns=Subscript(
