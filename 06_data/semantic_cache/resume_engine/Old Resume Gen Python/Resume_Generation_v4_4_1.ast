              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='target_cv',
                  ctx=Store())],
              value=Name(id='target_cv', ctx=Load()))]),
        FunctionDef(
          name='calculate_coherence_score',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='section_word_counts',
                annotation=Subscript(
                  value=Name(id='Dict', ctx=Load()),
                  slice=Tuple(
