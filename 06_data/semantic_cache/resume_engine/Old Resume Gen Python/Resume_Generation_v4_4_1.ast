                    test=Name(id='passed', ctx=Load()),
                    body=Constant(value='✓ PASS'),
                    orelse=Constant(value='✗ FAIL'))),
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='lines', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      JoinedStr(
                        values=[
                          FormattedValue(
                            value=Name(id='status', ctx=Load()),
                            conversion=-1),
                          Constant(value=': '),
                          FormattedValue(
                            value=Call(
                              func=Attribute(
                                value=Call(
                                  func=Attribute(
                                    value=Name(id='check', ctx=Load()),
                                    attr='replace',
                                    ctx=Load()),
                                  args=[
                                    Constant(value='_'),
                                    Constant(value=' ')]),
                                attr='title',
                                ctx=Load())),
                            conversion=-1)])]))]),
            Assign(
              targets=[
                Name(id='all_passed', ctx=Store())],
              value=Call(
                func=Name(id='all', ctx=Load()),
                args=[
                  Call(
                    func=Attribute(
                      value=Name(id='checks', ctx=Load()),
                      attr='values',
                      ctx=Load()))])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='lines', ctx=Load()),
                  attr='append',
                  ctx=Load()),
                args=[
                  BinOp(
                    left=Constant(value='='),
                    op=Mult(),
                    right=Constant(value=50))])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='lines', ctx=Load()),
                  attr='append',
                  ctx=Load()),
                args=[
                  IfExp(
                    test=Name(id='all_passed', ctx=Load()),
                    body=Constant(value='OVERALL: ✓ READY TO SUBMIT'),
                    orelse=Constant(value='OVERALL: ✗ NEEDS REVISION'))])),
            Return(
              value=Call(
                func=Attribute(
                  value=Constant(value='\n'),
                  attr='join',
                  ctx=Load()),
                args=[
                  Name(id='lines', ctx=Load())]))],
          decorator_list=[
            Name(id='staticmethod', ctx=Load())],
          returns=Name(id='str', ctx=Load()))]),
