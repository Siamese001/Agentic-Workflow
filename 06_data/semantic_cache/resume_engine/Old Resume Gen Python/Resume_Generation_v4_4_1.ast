    ClassDef(
      name='AppTrackerQA',
      body=[
        Expr(
          value=Constant(value='Quality assurance checks for application submissions.')),
        FunctionDef(
          name='validate_submission',
          args=arguments(
            args=[
              arg(
                arg='tracker',
                annotation=Name(id='AppTrackerSchema', ctx=Load())),
              arg(
                arg='resume_text',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Run pre-submission validation checks.')),
            Assign(
              targets=[
                Name(id='checks', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='has_contact_info'),
                  Constant(value='has_email'),
                  Constant(value='has_linkedin'),
                  Constant(value='word_count_valid'),
                  Constant(value='no_typos_in_name'),
                  Constant(value='company_mentioned')],
                values=[
                  Call(
                    func=Name(id='bool', ctx=Load()),
                    args=[
                      Call(
                        func=Attribute(
                          value=Name(id='re', ctx=Load()),
                          attr='search',
                          ctx=Load()),
                        args=[
                          Constant(value='\\+1-\\d{3}-\\d{3}-\\d{4}'),
                          Name(id='resume_text', ctx=Load())])]),
                  Call(
                    func=Name(id='bool', ctx=Load()),
                    args=[
                      Call(
                        func=Attribute(
                          value=Name(id='re', ctx=Load()),
                          attr='search',
                          ctx=Load()),
                        args=[
                          Constant(value='[a-z0-9._%+-]+@[a-z0-9.-]+\\.[a-z]{2,}'),
                          Name(id='resume_text', ctx=Load()),
                          Attribute(
                            value=Name(id='re', ctx=Load()),
                            attr='I',
                            ctx=Load())])]),
                  Compare(
                    left=Constant(value='linkedin.com'),
                    ops=[
                      In()],
                    comparators=[
                      Call(
                        func=Attribute(
                          value=Name(id='resume_text', ctx=Load()),
                          attr='lower',
                          ctx=Load()))]),
                  Compare(
                    left=Constant(value=400),
                    ops=[
                      LtE(),
                      LtE()],
                    comparators=[
                      Call(
                        func=Name(id='len', ctx=Load()),
                        args=[
                          Call(
                            func=Attribute(
                              value=Name(id='resume_text', ctx=Load()),
                              attr='split',
                              ctx=Load()))]),
                      Constant(value=1200)]),
                  Compare(
                    left=Constant(value='Amit Ayer'),
                    ops=[
                      In()],
                    comparators=[
                      Name(id='resume_text', ctx=Load())]),
                  IfExp(
                    test=Attribute(
                      value=Name(id='tracker', ctx=Load()),
                      attr='company',
                      ctx=Load()),
                    body=Compare(
                      left=Call(
                        func=Attribute(
                          value=Attribute(
                            value=Name(id='tracker', ctx=Load()),
                            attr='company',
                            ctx=Load()),
                          attr='lower',
                          ctx=Load())),
                      ops=[
                        In()],
                      comparators=[
                        Call(
                          func=Attribute(
                            value=Name(id='resume_text', ctx=Load()),
                            attr='lower',
                            ctx=Load()))]),
                    orelse=Constant(value=True))])),
            Return(
              value=Name(id='checks', ctx=Load()))],
          decorator_list=[
            Name(id='staticmethod', ctx=Load())],
          returns=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='bool', ctx=Load())],
              ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='format_qa_report',
          args=arguments(
            args=[
              arg(
                arg='checks',
                annotation=Subscript(
                  value=Name(id='Dict', ctx=Load()),
                  slice=Tuple(
                    elts=[
                      Name(id='str', ctx=Load()),
                      Name(id='bool', ctx=Load())],
                    ctx=Load()),
                  ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Format QA validation report.')),
            Assign(
              targets=[
                Name(id='lines', ctx=Store())],
              value=List(
                elts=[
                  Constant(value='QA VALIDATION REPORT'),
                  BinOp(
                    left=Constant(value='='),
                    op=Mult(),
                    right=Constant(value=50))],
                ctx=Load())),
            For(
              target=Tuple(
                elts=[
                  Name(id='check', ctx=Store()),
                  Name(id='passed', ctx=Store())],
                ctx=Store()),
              iter=Call(
                func=Attribute(
                  value=Name(id='checks', ctx=Load()),
                  attr='items',
                  ctx=Load())),
              body=[
                Assign(
                  targets=[
                    Name(id='status', ctx=Store())],
