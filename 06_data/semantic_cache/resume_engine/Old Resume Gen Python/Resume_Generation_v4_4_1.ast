            slice=Tuple(
              elts=[
                Name(id='float', ctx=Load()),
                Name(id='float', ctx=Load())],
              ctx=Load()),
            ctx=Load()))]),
    ClassDef(
      name='SignalPreservationScorer',
      body=[
        Expr(
          value=Constant(value='\n    OPT 8: Signal Preservation Scoring for bullet trimming.\n    \n    When trimming bullets, drop lowest signal_density bullets first.\n    Signal density = signal_score / word_count.\n    ')),
        FunctionDef(
          name='calculate_signal_density',
          args=arguments(
            args=[
              arg(
                arg='bullet_text',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='signal_score',
                annotation=Name(id='float', ctx=Load()))]),
          body=[
