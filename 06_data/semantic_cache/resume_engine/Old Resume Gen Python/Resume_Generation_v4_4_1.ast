              value=Constant(value='Calculate signal per word.')),
            Assign(
              targets=[
                Name(id='word_count', ctx=Store())],
              value=Call(
                func=Name(id='len', ctx=Load()),
                args=[
                  Call(
                    func=Attribute(
                      value=Name(id='bullet_text', ctx=Load()),
                      attr='split',
                      ctx=Load()))])),
            Return(
              value=IfExp(
                test=Compare(
                  left=Name(id='word_count', ctx=Load()),
                  ops=[
                    Gt()],
                  comparators=[
                    Constant(value=0)]),
                body=BinOp(
                  left=Name(id='signal_score', ctx=Load()),
                  op=Div(),
                  right=Name(id='word_count', ctx=Load())),
                orelse=Constant(value=0.0)))],
          decorator_list=[
            Name(id='staticmethod', ctx=Load())],
          returns=Name(id='float', ctx=Load())),
        FunctionDef(
          name='rank_bullets_for_trimming',
          args=arguments(
            args=[
              arg(
                arg='bullets',
                annotation=Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Name(id='Dict', ctx=Load()),
                  ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Rank bullets by signal density (ascending).\n        \n        Lowest density bullets should be trimmed first.\n        ')),
            For(
              target=Name(id='bullet', ctx=Store()),
              iter=Name(id='bullets', ctx=Load()),
              body=[
                Assign(
                  targets=[
                    Subscript(
                      value=Name(id='bullet', ctx=Load()),
                      slice=Constant(value='signal_density'),
                      ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='SignalPreservationScorer', ctx=Load()),
                      attr='calculate_signal_density',
                      ctx=Load()),
                    args=[
                      Subscript(
                        value=Name(id='bullet', ctx=Load()),
                        slice=Constant(value='text'),
                        ctx=Load()),
                      Subscript(
                        value=Name(id='bullet', ctx=Load()),
                        slice=Constant(value='signal_score'),
                        ctx=Load())]))]),
            Return(
              value=Call(
                func=Name(id='sorted', ctx=Load()),
                args=[
                  Name(id='bullets', ctx=Load())],
                keywords=[
                  keyword(
                    arg='key',
                    value=Lambda(
                      args=arguments(
                        args=[
                          arg(arg='x')]),
                      body=Subscript(
                        value=Name(id='x', ctx=Load()),
                        slice=Constant(value='signal_density'),
                        ctx=Load())))]))],
          decorator_list=[
            Name(id='staticmethod', ctx=Load())],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='Dict', ctx=Load()),
            ctx=Load()))]),
