    ClassDef(
      name='SignalElasticityModel',
      body=[
        Expr(
          value=Constant(value='\n    OPT 2: Signal-to-Word-Count Elasticity Curve.\n    \n    Signal increases logarithmically with word count up to a saturation point.\n    Beyond saturation, additional words yield diminishing returns (plateau effect).\n    ')),
        FunctionDef(
          name='__init__',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='saturation_points',
                  ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='exec_summary'),
                  Constant(value='unify_bullets'),
                  Constant(value='ibm_bullets'),
                  Constant(value='tradersense'),
                  Constant(value='ey_bullets'),
                  Constant(value='early_career'),
                  Constant(value='education'),
                  Constant(value='competencies')],
                values=[
                  Constant(value=150),
                  Constant(value=280),
                  Constant(value=240),
                  Constant(value=35),
                  Constant(value=70),
                  Constant(value=45),
                  Constant(value=22),
                  Constant(value=150)])),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='elasticity_coefficients',
                  ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='exec_summary'),
                  Constant(value='unify_bullets'),
                  Constant(value='ibm_bullets'),
                  Constant(value='tradersense'),
                  Constant(value='ey_bullets'),
                  Constant(value='early_career'),
                  Constant(value='education'),
                  Constant(value='competencies')],
                values=[
                  Constant(value=0.08),
                  Constant(value=0.06),
                  Constant(value=0.06),
                  Constant(value=0.04),
                  Constant(value=0.04),
                  Constant(value=0.03),
                  Constant(value=0.02),
                  Constant(value=0.05)]))]),
        FunctionDef(
          name='calculate_elasticity',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='section',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='word_count',
                annotation=Name(id='int', ctx=Load())),
              arg(
                arg='base_signal',
                annotation=Name(id='float', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Calculate signal adjustment based on word count.\n        \n        Returns elasticity multiplier (1.0 = no change, >1.0 = signal boost).\n        ')),
            Assign(
              targets=[
                Name(id='saturation', ctx=Store())],
              value=Subscript(
                value=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='saturation_points',
                  ctx=Load()),
                slice=Name(id='section', ctx=Load()),
                ctx=Load())),
            Assign(
              targets=[
                Name(id='k', ctx=Store())],
              value=Subscript(
                value=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='elasticity_coefficients',
                  ctx=Load()),
                slice=Name(id='section', ctx=Load()),
                ctx=Load())),
            If(
              test=Compare(
                left=Name(id='word_count', ctx=Load()),
                ops=[
                  LtE()],
                comparators=[
                  Name(id='saturation', ctx=Load())]),
              body=[
                Assign(
                  targets=[
                    Name(id='signal_boost', ctx=Store())],
                  value=BinOp(
                    left=Name(id='k', ctx=Load()),
                    op=Mult(),
                    right=Call(
                      func=Attribute(
                        value=Name(id='math', ctx=Load()),
                        attr='log',
                        ctx=Load()),
                      args=[
                        BinOp(
                          left=Constant(value=1),
                          op=Add(),
                          right=BinOp(
                            left=Name(id='word_count', ctx=Load()),
                            op=Div(),
                            right=Constant(value=10)))]))),
                Return(
                  value=Call(
                    func=Name(id='min', ctx=Load()),
                    args=[
                      BinOp(
                        left=Constant(value=1.0),
                        op=Add(),
                        right=Name(id='signal_boost', ctx=Load())),
                      Constant(value=1.15)]))],
              orelse=[
                Assign(
                  targets=[
                    Name(id='excess_words', ctx=Store())],
                  value=BinOp(
                    left=Name(id='word_count', ctx=Load()),
                    op=Sub(),
                    right=Name(id='saturation', ctx=Load()))),
                Assign(
                  targets=[
                    Name(id='penalty', ctx=Store())],
                  value=BinOp(
                    left=Constant(value=0.001),
                    op=Mult(),
                    right=Name(id='excess_words', ctx=Load()))),
                Return(
                  value=Call(
                    func=Name(id='max', ctx=Load()),
                    args=[
                      BinOp(
                        left=Constant(value=1.0),
                        op=Sub(),
                        right=Name(id='penalty', ctx=Load())),
                      Constant(value=0.95)]))])],
          returns=Name(id='float', ctx=Load()))]),
    ClassDef(
      name='SectionCoherenceScorer',
      body=[
        Expr(
          value=Constant(value='\n    OPT 5: Section-Length Coherence Score (CV <0.18 target).\n    \n    Measures variance in section lengths to ensure balanced resume structure.\n    High variance = choppy, unbalanced resume → apply penalty.\n    ')),
        FunctionDef(
          name='__init__',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='target_cv',
