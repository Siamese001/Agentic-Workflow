                      Name(id='str', ctx=Load()),
                      Name(id='int', ctx=Load())],
                    ctx=Load()),
                  ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Calculate coefficient of variation (CV) for section word counts.\n        \n        Returns: (cv_score, coherence_penalty)\n        ')),
            Assign(
              targets=[
                Name(id='relevant_sections', ctx=Store())],
              value=DictComp(
                key=Name(id='k', ctx=Load()),
                value=Name(id='v', ctx=Load()),
                generators=[
                  comprehension(
                    target=Tuple(
                      elts=[
                        Name(id='k', ctx=Store()),
                        Name(id='v', ctx=Store())],
                      ctx=Store()),
                    iter=Call(
                      func=Attribute(
                        value=Name(id='section_word_counts', ctx=Load()),
                        attr='items',
                        ctx=Load())),
                    ifs=[
                      Compare(
                        left=Name(id='k', ctx=Load()),
                        ops=[
                          NotIn()],
                        comparators=[
                          List(
                            elts=[
                              Constant(value='education'),
                              Constant(value='competencies')],
                            ctx=Load())])],
                    is_async=0)])),
            Assign(
              targets=[
                Name(id='word_counts', ctx=Store())],
              value=Call(
                func=Name(id='list', ctx=Load()),
                args=[
                  Call(
                    func=Attribute(
                      value=Name(id='relevant_sections', ctx=Load()),
                      attr='values',
                      ctx=Load()))])),
            If(
              test=Compare(
                left=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Name(id='word_counts', ctx=Load())]),
                ops=[
                  Lt()],
                comparators=[
                  Constant(value=2)]),
              body=[
                Return(
                  value=Tuple(
                    elts=[
                      Constant(value=0.0),
                      Constant(value=0.0)],
                    ctx=Load()))]),
            Assign(
              targets=[
                Name(id='mean_words', ctx=Store())],
              value=BinOp(
                left=Call(
                  func=Name(id='sum', ctx=Load()),
                  args=[
                    Name(id='word_counts', ctx=Load())]),
                op=Div(),
                right=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Name(id='word_counts', ctx=Load())]))),
            Assign(
              targets=[
                Name(id='variance', ctx=Store())],
              value=BinOp(
                left=Call(
                  func=Name(id='sum', ctx=Load()),
                  args=[
                    GeneratorExp(
                      elt=BinOp(
                        left=BinOp(
                          left=Name(id='x', ctx=Load()),
                          op=Sub(),
                          right=Name(id='mean_words', ctx=Load())),
                        op=Pow(),
                        right=Constant(value=2)),
                      generators=[
                        comprehension(
                          target=Name(id='x', ctx=Store()),
                          iter=Name(id='word_counts', ctx=Load()),
                          is_async=0)])]),
                op=Div(),
                right=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Name(id='word_counts', ctx=Load())]))),
            Assign(
              targets=[
                Name(id='std_dev', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='math', ctx=Load()),
                  attr='sqrt',
                  ctx=Load()),
                args=[
                  Name(id='variance', ctx=Load())])),
            Assign(
              targets=[
                Name(id='cv', ctx=Store())],
              value=IfExp(
                test=Compare(
                  left=Name(id='mean_words', ctx=Load()),
                  ops=[
                    Gt()],
                  comparators=[
                    Constant(value=0)]),
                body=BinOp(
                  left=Name(id='std_dev', ctx=Load()),
                  op=Div(),
                  right=Name(id='mean_words', ctx=Load())),
                orelse=Constant(value=0.0))),
            If(
              test=Compare(
                left=Name(id='cv', ctx=Load()),
                ops=[
                  Gt()],
                comparators=[
                  Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='target_cv',
                    ctx=Load())]),
              body=[
                Assign(
                  targets=[
                    Name(id='penalty', ctx=Store())],
                  value=BinOp(
                    left=BinOp(
