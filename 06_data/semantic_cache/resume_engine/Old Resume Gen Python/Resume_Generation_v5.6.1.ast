                  body=[
                    Assign(
                      targets=[
                        Name(id='mean_len', ctx=Store())],
                      value=BinOp(
                        left=Call(
                          func=Name(id='sum', ctx=Load()),
                          args=[
                            Name(id='sentence_lengths', ctx=Load())]),
                        op=Div(),
                        right=Call(
                          func=Name(id='len', ctx=Load()),
                          args=[
                            Name(id='sentence_lengths', ctx=Load())]))),
                    Assign(
                      targets=[
                        Name(id='variance', ctx=Store())],
                      value=BinOp(
                        left=Call(
                          func=Name(id='sum', ctx=Load()),
                          args=[
                            GeneratorExp(
                              elt=BinOp(
                                left=BinOp(
                                  left=Name(id='x', ctx=Load()),
                                  op=Sub(),
                                  right=Name(id='mean_len', ctx=Load())),
                                op=Pow(),
                                right=Constant(value=2)),
                              generators=[
                                comprehension(
