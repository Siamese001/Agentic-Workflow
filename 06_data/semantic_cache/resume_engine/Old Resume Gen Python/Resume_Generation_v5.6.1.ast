              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='master_resume',
                  ctx=Store())],
              value=Name(id='master_resume', ctx=Load())),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='known_companies',
                  ctx=Store())],
              value=Call(
                func=Name(id='set', ctx=Load()))),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='known_titles',
                  ctx=Store())],
              value=Call(
                func=Name(id='set', ctx=Load()))),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='known_dates',
                  ctx=Store())],
              value=Call(
                func=Name(id='set', ctx=Load()))),
            For(
              target=Name(id='exp', ctx=Store()),
              iter=Call(
                func=Attribute(
                  value=Name(id='master_resume', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='professional_experience'),
                  List(ctx=Load())]),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='known_companies',
                        ctx=Load()),
                      attr='add',
                      ctx=Load()),
                    args=[
                      Call(
                        func=Attribute(
                          value=Call(
                            func=Attribute(
                              value=Name(id='exp', ctx=Load()),
                              attr='get',
                              ctx=Load()),
                            args=[
                              Constant(value='company'),
                              Constant(value='')]),
                          attr='lower',
                          ctx=Load()))])),
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='known_titles',
                        ctx=Load()),
                      attr='add',
                      ctx=Load()),
                    args=[
                      Call(
                        func=Attribute(
                          value=Call(
                            func=Attribute(
                              value=Name(id='exp', ctx=Load()),
                              attr='get',
                              ctx=Load()),
                            args=[
                              Constant(value='title'),
                              Constant(value='')]),
                          attr='lower',
                          ctx=Load()))])),
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='known_dates',
                        ctx=Load()),
                      attr='add',
                      ctx=Load()),
                    args=[
                      Call(
                        func=Attribute(
                          value=Name(id='exp', ctx=Load()),
                          attr='get',
                          ctx=Load()),
                        args=[
                          Constant(value='start_date'),
                          Constant(value='')])])),
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='known_dates',
                        ctx=Load()),
                      attr='add',
                      ctx=Load()),
                    args=[
                      Call(
                        func=Attribute(
                          value=Name(id='exp', ctx=Load()),
                          attr='get',
                          ctx=Load()),
                        args=[
                          Constant(value='end_date'),
                          Constant(value='')])]))])]),
        FunctionDef(
          name='detect_hallucinated_company',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='company',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Check if company is hallucinated.')),
            If(
              test=Compare(
                left=Call(
                  func=Attribute(
                    value=Name(id='company', ctx=Load()),
                    attr='lower',
                    ctx=Load())),
                ops=[
                  NotIn()],
                comparators=[
                  Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='known_companies',
                    ctx=Load())]),
              body=[
                Return(
                  value=Tuple(
                    elts=[
                      Constant(value=True),
                      JoinedStr(
                        values=[
                          Constant(value="Company '"),
                          FormattedValue(
                            value=Name(id='company', ctx=Load()),
                            conversion=-1),
                          Constant(value="' not found in master resume")])],
                    ctx=Load()))]),
            Return(
              value=Tuple(
                elts=[
                  Constant(value=False),
                  Constant(value='')],
                ctx=Load()))],
          returns=Subscript(
            value=Name(id='Tuple', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='bool', ctx=Load()),
                Name(id='str', ctx=Load())],
              ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='detect_hallucinated_date',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='date_str',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Check if date is hallucinated.')),
            If(
              test=BoolOp(
                op=And(),
                values=[
                  Compare(
                    left=Name(id='date_str', ctx=Load()),
                    ops=[
                      NotIn()],
                    comparators=[
                      Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='known_dates',
                        ctx=Load())]),
                  Compare(
                    left=Name(id='date_str', ctx=Load()),
                    ops=[
                      NotEq()],
                    comparators=[
                      Constant(value='Present')])]),
              body=[
                Return(
                  value=Tuple(
                    elts=[
                      Constant(value=True),
                      JoinedStr(
                        values=[
                          Constant(value="Date '"),
                          FormattedValue(
                            value=Name(id='date_str', ctx=Load()),
                            conversion=-1),
                          Constant(value="' not found in master resume")])],
                    ctx=Load()))]),
            Return(
              value=Tuple(
                elts=[
                  Constant(value=False),
                  Constant(value='')],
                ctx=Load()))],
          returns=Subscript(
            value=Name(id='Tuple', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='bool', ctx=Load()),
                Name(id='str', ctx=Load())],
              ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='detect_all',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='extracted_data',
                annotation=Name(id='Dict', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Run all hallucination checks.')),
            Assign(
              targets=[
                Name(id='results', ctx=Store())],
              value=List(ctx=Load())),
            For(
              target=Name(id='exp', ctx=Store()),
              iter=Call(
                func=Attribute(
                  value=Name(id='extracted_data', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='professional_experience'),
                  List(ctx=Load())]),
              body=[
                Assign(
                  targets=[
                    Tuple(
                      elts=[
                        Name(id='is_hallucinated', ctx=Store()),
                        Name(id='msg', ctx=Store())],
                      ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='detect_hallucinated_company',
                      ctx=Load()),
                    args=[
                      Call(
                        func=Attribute(
                          value=Name(id='exp', ctx=Load()),
                          attr='get',
                          ctx=Load()),
                        args=[
                          Constant(value='company'),
                          Constant(value='')])])),
                If(
                  test=Name(id='is_hallucinated', ctx=Load()),
                  body=[
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Name(id='results', ctx=Load()),
                          attr='append',
                          ctx=Load()),
                        args=[
                          Call(
                            func=Name(id='ValidationResult', ctx=Load()),
                            keywords=[
                              keyword(
                                arg='rule_id',
                                value=Constant(value='R1-HALLUCINATION-001')),
                              keyword(
                                arg='passed',
                                value=Constant(value=False)),
                              keyword(
                                arg='severity',
                                value=Attribute(
                                  value=Name(id='ValidationSeverity', ctx=Load()),
                                  attr='CRITICAL',
                                  ctx=Load())),
                              keyword(
                                arg='message',
                                value=Name(id='msg', ctx=Load())),
                              keyword(
                                arg='details',
                                value=Dict(
                                  keys=[
                                    Constant(value='company')],
                                  values=[
                                    Call(
                                      func=Attribute(
                                        value=Name(id='exp', ctx=Load()),
                                        attr='get',
                                        ctx=Load()),
                                      args=[
                                        Constant(value='company')])]))])]))])]),
            Return(
              value=Name(id='results', ctx=Load()))],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='ValidationResult', ctx=Load()),
            ctx=Load()))]),
    ClassDef(
      name='ClerkExtractor',
      body=[
        Expr(
          value=Constant(value='\n    HOP-1: Clerk Extraction\n    Extracts factual data with entity validation (18 rules).\n    Flags hallucinations but continues.\n    ')),
        FunctionDef(
          name='__init__',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='master_resume',
                annotation=Subscript(
                  value=Name(id='Dict', ctx=Load()),
