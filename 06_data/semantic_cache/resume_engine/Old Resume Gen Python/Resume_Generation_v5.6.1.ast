      name='DuplicateDetector',
      body=[
        Expr(
          value=Constant(value='Detect duplicate bullets using cosine similarity.')),
        FunctionDef(
          name='__init__',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='threshold',
                annotation=Name(id='float', ctx=Load()))],
