                  ctx=Store())],
              value=Name(id='threshold', ctx=Load()))]),
        FunctionDef(
          name='calculate_cosine_similarity',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='text1',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='text2',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Calculate cosine similarity between two texts.')),
            Assign(
              targets=[
                Name(id='words1', ctx=Store())],
              value=Call(
                func=Name(id='set', ctx=Load()),
                args=[
                  Call(
                    func=Attribute(
                      value=Call(
                        func=Attribute(
                          value=Name(id='text1', ctx=Load()),
                          attr='lower',
                          ctx=Load())),
                      attr='split',
                      ctx=Load()))])),
            Assign(
              targets=[
                Name(id='words2', ctx=Store())],
              value=Call(
                func=Name(id='set', ctx=Load()),
                args=[
                  Call(
                    func=Attribute(
                      value=Call(
                        func=Attribute(
                          value=Name(id='text2', ctx=Load()),
                          attr='lower',
                          ctx=Load())),
                      attr='split',
                      ctx=Load()))])),
            Assign(
              targets=[
                Name(id='intersection', ctx=Store())],
              value=Call(
                func=Name(id='len', ctx=Load()),
                args=[
                  BinOp(
                    left=Name(id='words1', ctx=Load()),
                    op=BitAnd(),
                    right=Name(id='words2', ctx=Load()))])),
            If(
              test=BoolOp(
                op=Or(),
                values=[
                  UnaryOp(
                    op=Not(),
                    operand=Name(id='words1', ctx=Load())),
                  UnaryOp(
                    op=Not(),
                    operand=Name(id='words2', ctx=Load()))]),
