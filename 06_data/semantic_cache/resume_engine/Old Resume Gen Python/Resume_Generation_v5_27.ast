          body=[
            Expr(
              value=Constant(value='\n        Extract authenticity patterns from LinkedIn profiles.\n        \n        In production, this would:\n        1. Search for ≥10 senior executive profiles in similar roles\n        2. Extract language patterns from their profiles\n        3. Categorize patterns by type (summary, verbs, metrics, competencies)\n        4. Return authentic phrasing guidance\n        \n        Args:\n            job_description: JD text\n            thematic_results: Themes from phase 1\n            num_calls: Number of RAG calls (15)\n            min_profiles: Minimum profiles to analyze (10)\n        \n        Returns:\n            AuthenticityPatterns with learned patterns\n        ')),
            AugAssign(
              target=Attribute(
                value=Name(id='self', ctx=Load()),
                attr='rag_calls_made',
                ctx=Store()),
              op=Add(),
              value=Name(id='num_calls', ctx=Load())),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='linkedin_profiles_analyzed',
                  ctx=Store())],
              value=Name(id='min_profiles', ctx=Load())),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='logger', ctx=Load()),
                  attr='info',
                  ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='  → Analyzing '),
                      FormattedValue(
                        value=Name(id='min_profiles', ctx=Load()),
                        conversion=-1),
                      Constant(value='+ LinkedIn profiles...')])])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='logger', ctx=Load()),
                  attr='info',
                  ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='  → Making '),
                      FormattedValue(
                        value=Name(id='num_calls', ctx=Load()),
                        conversion=-1),
                      Constant(value=' RAG calls for pattern extraction')])])),
            Return(
              value=Call(
