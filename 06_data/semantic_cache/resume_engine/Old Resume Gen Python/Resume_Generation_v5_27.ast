    ClassDef(
      name='JDParser',
      body=[
        Expr(
          value=Constant(value='\n    Parse job description into structured analysis.\n    This provides fast initial parsing before K.0/K.2 agentic analysis.\n    ')),
        FunctionDef(
          name='__init__',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='jd_text',
                annotation=Name(id='str', ctx=Load()))]),
