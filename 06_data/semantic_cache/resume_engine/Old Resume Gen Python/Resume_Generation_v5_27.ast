        FunctionDef(
          name='_generate_k1_executive_summary',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='enriched_scaffold',
                annotation=Name(id='Dict', ctx=Load())),
              arg(
                arg='job_description',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='k0_output',
                annotation=Name(id='ThematicAnalysis', ctx=Load())),
              arg(
                arg='k2_output',
                annotation=Name(id='K2CompetitiveAnalysis', ctx=Load())),
              arg(
                arg='previous_failures',
                annotation=Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Name(id='ValidationResult', ctx=Load()),
                  ctx=Load()))],
            defaults=[
              Constant(value=None)]),
          body=[
            Expr(
              value=Constant(value='\n        Generate K.1 executive summary using Claude API with K.0 + K.2 context.\n        \n        v5.27 Config: COT=3, TOT=3, Depth=3, SC=12, Reflexion=True\n        (Upgraded from v5.26: 2/3/2/8/True)\n        ')),
            Assign(
              targets=[
                Name(id='prompt', ctx=Store())],
              value=JoinedStr(
                values=[
                  Constant(value='Generate an executive summary for this job:\n\n<job_description>\n'),
                  FormattedValue(
                    value=Name(id='job_description', ctx=Load()),
                    conversion=-1),
                  Constant(value='\n</job_description>\n\n<k0_thematic_analysis>\nPrimary Theme: '),
                  FormattedValue(
                    value=Subscript(
                      value=Attribute(
                        value=Name(id='k0_output', ctx=Load()),
                        attr='primary_theme',
                        ctx=Load()),
                      slice=Constant(value='value'),
                      ctx=Load()),
                    conversion=-1),
                  Constant(value='\nSecondary Themes: '),
                  FormattedValue(
                    value=Call(
                      func=Attribute(
                        value=Constant(value=', '),
                        attr='join',
                        ctx=Load()),
                      args=[
                        ListComp(
                          elt=Subscript(
                            value=Name(id='t', ctx=Load()),
                            slice=Constant(value='value'),
                            ctx=Load()),
                          generators=[
                            comprehension(
                              target=Name(id='t', ctx=Store()),
                              iter=Attribute(
                                value=Name(id='k0_output', ctx=Load()),
                                attr='secondary_themes',
                                ctx=Load()),
                              is_async=0)])]),
                    conversion=-1),
                  Constant(value='\nRelated Concepts: '),
                  FormattedValue(
                    value=Call(
                      func=Attribute(
                        value=Constant(value=', '),
                        attr='join',
                        ctx=Load()),
                      args=[
                        Subscript(
                          value=Attribute(
                            value=Name(id='k0_output', ctx=Load()),
                            attr='related_concepts',
                            ctx=Load()),
                          slice=Slice(
                            upper=Constant(value=5)),
                          ctx=Load())]),
                    conversion=-1),
                  Constant(value='\n</k0_thematic_analysis>\n\n<k0_authenticity_patterns>\nExecutive Summary Style: '),
                  FormattedValue(
                    value=Call(
                      func=Attribute(
                        value=Attribute(
                          value=Name(id='k0_output', ctx=Load()),
                          attr='authenticity_patterns',
                          ctx=Load()),
                        attr='get_exec_pattern',
                        ctx=Load())),
                    conversion=-1),
                  Constant(value='\nAchievement Verbs: '),
