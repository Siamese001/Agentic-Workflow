                    value=List(
                      elts=[
                        Constant(value='Expertise in X: Y description with Z impact'),
                        Constant(value='Strategic X leadership: Y outcomes through Z approach'),
                        Constant(value='Deep X capabilities: Y achievements across Z domains')],
                      ctx=Load()))]))],
          returns=Name(id='AuthenticityPatterns', ctx=Load())),
        FunctionDef(
          name='_extract_competitive_intelligence',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='job_description',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='thematic_results',
                annotation=Name(id='Dict', ctx=Load())),
              arg(
                arg='num_calls',
                annotation=Name(id='int', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Extract competitive intelligence from JD analysis.\n        \n        This provides initial competitive signals that K.2 will expand upon.\n        \n        Args:\n            job_description: JD text\n            thematic_results: Themes from phase 1\n            num_calls: Number of RAG calls (15)\n        \n        Returns:\n            CompetitiveIntelligence with initial signals\n        ')),
            AugAssign(
              target=Attribute(
                value=Name(id='self', ctx=Load()),
                attr='rag_calls_made',
                ctx=Store()),
              op=Add(),
              value=Name(id='num_calls', ctx=Load())),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='logger', ctx=Load()),
                  attr='info',
                  ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='  → Making '),
                      FormattedValue(
                        value=Name(id='num_calls', ctx=Load()),
                        conversion=-1),
                      Constant(value=' RAG calls for competitive signals')])])),
            Assign(
              targets=[
                Name(id='jd_lower', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='job_description', ctx=Load()),
                  attr='lower',
                  ctx=Load()))),
            Assign(
              targets=[
                Name(id='differentiators', ctx=Store())],
              value=List(ctx=Load())),
            If(
              test=Call(
                func=Attribute(
                  value=Name(id='re', ctx=Load()),
                  attr='search',
                  ctx=Load()),
                args=[
                  Constant(value='best[-\\s]in[-\\s]class|industry[-\\s]leading'),
                  Name(id='jd_lower', ctx=Load())]),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='differentiators', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Constant(value='industry leadership')]))]),
            If(
              test=Call(
                func=Attribute(
                  value=Name(id='re', ctx=Load()),
                  attr='search',
                  ctx=Load()),
                args=[
                  Constant(value='innovation|cutting[-\\s]edge'),
                  Name(id='jd_lower', ctx=Load())]),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='differentiators', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Constant(value='innovation')]))]),
            If(
              test=Call(
                func=Attribute(
                  value=Name(id='re', ctx=Load()),
                  attr='search',
                  ctx=Load()),
                args=[
                  Constant(value='scale|enterprise|fortune'),
                  Name(id='jd_lower', ctx=Load())]),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='differentiators', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Constant(value='enterprise scale')]))]),
            If(
              test=Call(
                func=Attribute(
                  value=Name(id='re', ctx=Load()),
                  attr='search',
                  ctx=Load()),
                args=[
                  Constant(value='customer obsession|customer[-\\s]centric'),
                  Name(id='jd_lower', ctx=Load())]),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='differentiators', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Constant(value='customer focus')]))]),
            If(
              test=Call(
                func=Attribute(
                  value=Name(id='re', ctx=Load()),
                  attr='search',
                  ctx=Load()),
                args=[
                  Constant(value='fast[-\\s]paced|agile'),
                  Name(id='jd_lower', ctx=Load())]),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='differentiators', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Constant(value='agility')]))]),
            Return(
              value=Call(
                func=Name(id='CompetitiveIntelligence', ctx=Load()),
                keywords=[
                  keyword(
                    arg='peer_jds_analyzed',
                    value=List(ctx=Load())),
                  keyword(
                    arg='peer_jds_count',
                    value=Constant(value=0)),
                  keyword(
                    arg='table_stakes_keywords',
                    value=List(
                      elts=[
                        Constant(value='leadership'),
                        Constant(value='strategy'),
                        Constant(value='growth'),
                        Constant(value='team building')],
                      ctx=Load())),
                  keyword(
                    arg='differentiator_keywords',
                    value=Name(id='differentiators', ctx=Load())),
                  keyword(
                    arg='theme_alignment_score',
                    value=Constant(value=0.85))]))],
          returns=Name(id='CompetitiveIntelligence', ctx=Load()))]),
    ClassDef(
      name='K2CompetitiveAnalyzer',
      body=[
        Expr(
          value=Constant(value='\n    K.2: Deep Competitive Analysis with Peer JD Discovery\n    \n    Configuration: COT=2, TOT=5, Depth=4, SC=12, Reflexion=True\n    RAG Calls: 24 total\n    \n    Capabilities:\n      - Discover ≥3 peer job descriptions\n      - Two-stage retrieval (BM25 → Cross-encoder reranking)\n      - Table stakes threshold: 0.8 (appears in 80%+ of peer JDs)\n      - Differentiator threshold: 0.2 (appears in <20% of peer JDs)\n      - Identify unique positioning angles\n    \n    Output Schema:\n      - peer_jds_analyzed: [string]\n      - peer_jds_count: int\n      - table_stakes_keywords: [string]\n      - differentiator_keywords: [string]\n      - table_stakes_threshold: float\n      - differentiator_threshold: float\n      - retrieval_relevance_score: float\n    ')),
