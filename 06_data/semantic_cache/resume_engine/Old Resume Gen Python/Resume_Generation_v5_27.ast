            slice=Name(id='str', ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='_extract_required_skills',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Extract required skills.')),
            Assign(
              targets=[
                Name(id='skills', ctx=Store())],
              value=List(ctx=Load())),
            Assign(
              targets=[
                Name(id='jd_lower', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='jd_text',
                    ctx=Load()),
                  attr='lower',
                  ctx=Load()))),
            Assign(
              targets=[
                Name(id='tech_patterns', ctx=Store())],
              value=List(
                elts=[
                  Constant(value='\\b(python|java|javascript|typescript|golang)\\b'),
                  Constant(value='\\b(aws|azure|gcp|kubernetes|docker)\\b'),
                  Constant(value='\\b(sql|nosql|postgresql|mongodb)\\b'),
                  Constant(value='\\b(ml|ai|machine learning|nlp)\\b')],
                ctx=Load())),
            For(
              target=Name(id='pattern', ctx=Store()),
              iter=Name(id='tech_patterns', ctx=Load()),
              body=[
                Assign(
                  targets=[
                    Name(id='matches', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='re', ctx=Load()),
                      attr='finditer',
                      ctx=Load()),
                    args=[
                      Name(id='pattern', ctx=Load()),
                      Name(id='jd_lower', ctx=Load())])),
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='skills', ctx=Load()),
                      attr='extend',
                      ctx=Load()),
                    args=[
                      ListComp(
                        elt=Call(
                          func=Attribute(
                            value=Call(
                              func=Attribute(
                                value=Name(id='m', ctx=Load()),
                                attr='group',
                                ctx=Load()),
                              args=[
                                Constant(value=0)]),
                            attr='upper',
                            ctx=Load())),
                        generators=[
                          comprehension(
                            target=Name(id='m', ctx=Store()),
                            iter=Name(id='matches', ctx=Load()),
                            is_async=0)])]))]),
            Return(
              value=Subscript(
                value=Call(
                  func=Name(id='list', ctx=Load()),
                  args=[
                    Call(
                      func=Name(id='set', ctx=Load()),
                      args=[
                        Name(id='skills', ctx=Load())])]),
                slice=Slice(
                  upper=Constant(value=15)),
                ctx=Load()))],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load())),
