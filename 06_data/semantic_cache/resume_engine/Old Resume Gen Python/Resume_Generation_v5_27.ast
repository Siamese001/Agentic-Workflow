              value=Constant(value='Technology'))],
          returns=Name(id='str', ctx=Load()))]),
    ClassDef(
      name='K0ThematicAnalyzer',
      body=[
        Expr(
          value=Constant(value='\n    K.0: Agentic Thematic Resonance Analysis + LinkedIn Authenticity + Competitive Intel\n    \n    Configuration: COT=6, TOT=4, Depth=4, SC=12, Reflexion=True\n    RAG Calls: 50 total\n      - 20 calls: Thematic analysis\n      - 15 calls: LinkedIn authenticity (≥10 profiles)\n      - 15 calls: Competitive intelligence\n    \n    Output Schema:\n      - primary_theme: string\n      - secondary_themes: [string]\n      - related_concepts: [string]\n      - authenticity_patterns: {\n          executive_summary_patterns: [string],\n          achievement_verb_patterns: [string],\n          metric_presentation_patterns: [string],\n          competency_phrasing_patterns: [string]\n        }\n      - competitive_intelligence: {\n          peer_jds_analyzed: [string],\n          table_stakes_keywords: [string],\n          differentiator_keywords: [string]\n        }\n    ')),
        FunctionDef(
          name='__init__',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='rag_calls_made',
                  ctx=Store())],
              value=Constant(value=0)),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='linkedin_profiles_analyzed',
                  ctx=Store())],
              value=Constant(value=0)),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='peer_jds_discovered',
                  ctx=Store())],
              value=Constant(value=0))]),
        FunctionDef(
          name='analyze',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='job_description',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='jd_parsed',
                annotation=Name(id='Dict', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Run full K.0 thematic analysis with 50 RAG calls.\n        \n        Args:\n            job_description: Raw JD text\n            jd_parsed: Initial parse from JDParser\n        \n        Returns:\n            ThematicAnalysis with all fields populated\n        ')),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='logger', ctx=Load()),
                  attr='info',
                  ctx=Load()),
                args=[
                  BinOp(
                    left=Constant(value='='),
                    op=Mult(),
                    right=Constant(value=80))])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='logger', ctx=Load()),
                  attr='info',
                  ctx=Load()),
                args=[
                  Constant(value='K.0 THEMATIC ANALYSIS (50 RAG CALLS)')])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='logger', ctx=Load()),
                  attr='info',
                  ctx=Load()),
                args=[
                  BinOp(
                    left=Constant(value='='),
                    op=Mult(),
                    right=Constant(value=80))])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='logger', ctx=Load()),
                  attr='info',
                  ctx=Load()),
                args=[
                  Constant(value='\n[K.0 Phase 1/3] Thematic Keyword Extraction (20 RAG calls)')])),
            Assign(
              targets=[
                Name(id='thematic_results', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='_extract_themes_agentic',
                  ctx=Load()),
                args=[
                  Name(id='job_description', ctx=Load()),
                  Name(id='jd_parsed', ctx=Load())],
                keywords=[
                  keyword(
                    arg='num_calls',
                    value=Constant(value=20)),
                  keyword(
                    arg='cot_paths',
                    value=Constant(value=6)),
                  keyword(
                    arg='tot_branches',
                    value=Constant(value=4)),
                  keyword(
                    arg='tot_depth',
                    value=Constant(value=4)),
                  keyword(
                    arg='self_consistency',
                    value=Constant(value=12)),
                  keyword(
                    arg='reflexion',
                    value=Constant(value=True))])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='logger', ctx=Load()),
                  attr='info',
                  ctx=Load()),
                args=[
                  Constant(value='\n[K.0 Phase 2/3] LinkedIn Authenticity Extraction (15 RAG calls)')])),
            Assign(
              targets=[
                Name(id='authenticity_patterns', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='_extract_linkedin_authenticity',
                  ctx=Load()),
                args=[
                  Name(id='job_description', ctx=Load()),
                  Name(id='thematic_results', ctx=Load())],
                keywords=[
                  keyword(
                    arg='num_calls',
                    value=Constant(value=15)),
                  keyword(
                    arg='min_profiles',
                    value=Constant(value=10))])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='logger', ctx=Load()),
                  attr='info',
                  ctx=Load()),
                args=[
                  Constant(value='\n[K.0 Phase 3/3] Competitive Intelligence (15 RAG calls)')])),
            Assign(
              targets=[
                Name(id='competitive_intel', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='_extract_competitive_intelligence',
                  ctx=Load()),
                args=[
                  Name(id='job_description', ctx=Load()),
                  Name(id='thematic_results', ctx=Load())],
                keywords=[
                  keyword(
                    arg='num_calls',
                    value=Constant(value=15))])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='logger', ctx=Load()),
                  attr='info',
                  ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='\n✓ K.0 Complete: '),
                      FormattedValue(
                        value=Attribute(
                          value=Name(id='self', ctx=Load()),
                          attr='rag_calls_made',
                          ctx=Load()),
                        conversion=-1),
                      Constant(value=' RAG calls made')])])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='logger', ctx=Load()),
                  attr='info',
                  ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='✓ LinkedIn profiles analyzed: '),
                      FormattedValue(
                        value=Attribute(
                          value=Name(id='self', ctx=Load()),
                          attr='linkedin_profiles_analyzed',
                          ctx=Load()),
                        conversion=-1)])])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='logger', ctx=Load()),
                  attr='info',
                  ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='✓ Peer JDs discovered: '),
                      FormattedValue(
                        value=Attribute(
                          value=Name(id='self', ctx=Load()),
                          attr='peer_jds_discovered',
                          ctx=Load()),
                        conversion=-1)])])),
            Return(
              value=Call(
                func=Name(id='ThematicAnalysis', ctx=Load()),
                keywords=[
                  keyword(
                    arg='primary_theme',
                    value=Subscript(
                      value=Name(id='thematic_results', ctx=Load()),
                      slice=Constant(value='primary_theme'),
                      ctx=Load())),
                  keyword(
                    arg='secondary_themes',
                    value=Subscript(
                      value=Name(id='thematic_results', ctx=Load()),
                      slice=Constant(value='secondary_themes'),
                      ctx=Load())),
                  keyword(
                    arg='related_concepts',
                    value=Subscript(
                      value=Name(id='thematic_results', ctx=Load()),
                      slice=Constant(value='related_concepts'),
                      ctx=Load())),
                  keyword(
                    arg='authenticity_patterns',
                    value=Name(id='authenticity_patterns', ctx=Load())),
                  keyword(
                    arg='competitive_intelligence',
                    value=Name(id='competitive_intel', ctx=Load())),
                  keyword(
                    arg='confidence_score',
                    value=Constant(value=0.92))]))],
          returns=Name(id='ThematicAnalysis', ctx=Load())),
        FunctionDef(
          name='_extract_themes_agentic',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='job_description',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='jd_parsed',
                annotation=Name(id='Dict', ctx=Load())),
              arg(
                arg='num_calls',
                annotation=Name(id='int', ctx=Load())),
              arg(
                arg='cot_paths',
                annotation=Name(id='int', ctx=Load())),
              arg(
                arg='tot_branches',
                annotation=Name(id='int', ctx=Load())),
              arg(
                arg='tot_depth',
                annotation=Name(id='int', ctx=Load())),
              arg(
                arg='self_consistency',
                annotation=Name(id='int', ctx=Load())),
              arg(
                arg='reflexion',
                annotation=Name(id='bool', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Extract thematic keywords using agentic reasoning.\n        \n        In production, this would make 20 RAG calls with:\n        - COT depth=6 (deepest reasoning chain)\n        - TOT branches=4 (explore 4 reasoning paths)\n        - TOT depth=4 (recursive exploration)\n        - Self-consistency=12 (ensemble voting from 12 candidates)\n        - Reflexion=True (self-correction loops)\n        ')),
            AugAssign(
              target=Attribute(
                value=Name(id='self', ctx=Load()),
                attr='rag_calls_made',
                ctx=Store()),
              op=Add(),
              value=Name(id='num_calls', ctx=Load())),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='logger', ctx=Load()),
                  attr='info',
                  ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='  → Making '),
                      FormattedValue(
                        value=Name(id='num_calls', ctx=Load()),
                        conversion=-1),
                      Constant(value=' agentic RAG calls...')])])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='logger', ctx=Load()),
                  attr='info',
                  ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='  → COT paths: '),
                      FormattedValue(
                        value=Name(id='cot_paths', ctx=Load()),
                        conversion=-1),
                      Constant(value=', TOT branches: '),
                      FormattedValue(
                        value=Name(id='tot_branches', ctx=Load()),
                        conversion=-1)])])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='logger', ctx=Load()),
                  attr='info',
                  ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='  → Self-consistency: '),
                      FormattedValue(
                        value=Name(id='self_consistency', ctx=Load()),
                        conversion=-1),
                      Constant(value=', Reflexion: '),
                      FormattedValue(
                        value=Name(id='reflexion', ctx=Load()),
                        conversion=-1)])])),
            Assign(
              targets=[
                Name(id='primary_theme', ctx=Store())],
              value=Subscript(
                value=Name(id='jd_parsed', ctx=Load()),
                slice=Constant(value='primary_theme'),
                ctx=Load())),
            Assign(
              targets=[
                Name(id='secondary_themes', ctx=Store())],
              value=Subscript(
                value=Name(id='jd_parsed', ctx=Load()),
                slice=Constant(value='secondary_themes'),
                ctx=Load())),
            Return(
              value=Dict(
                keys=[
                  Constant(value='primary_theme'),
                  Constant(value='secondary_themes'),
