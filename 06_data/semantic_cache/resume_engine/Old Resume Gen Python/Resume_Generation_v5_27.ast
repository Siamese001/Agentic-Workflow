                        is_async=0)]),
                  Subscript(
                    value=Name(id='jd_parsed', ctx=Load()),
                    slice=Constant(value='required_skills'),
                    ctx=Load())]))],
          returns=Name(id='Dict', ctx=Load())),
        FunctionDef(
          name='_extract_linkedin_authenticity',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='job_description',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='thematic_results',
