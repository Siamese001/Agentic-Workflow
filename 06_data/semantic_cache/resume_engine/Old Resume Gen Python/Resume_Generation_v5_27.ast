              arg(
                arg='num_calls',
                annotation=Name(id='int', ctx=Load())),
              arg(
                arg='min_peer_jds',
                annotation=Name(id='int', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Discover peer job descriptions using two-stage retrieval.\n        \n        In production, this would:\n        1. BM25 coarse retrieval (200 docs)\n        2. Cross-encoder reranking (top 20)\n        3. Final selection (top 5)\n        4. Min relevance score: 0.75\n        \n        Args:\n            job_description: JD text\n            k0_output: K.0 thematic analysis\n            num_calls: Number of RAG calls (12)\n            min_peer_jds: Minimum peer JDs to find (3)\n        \n        Returns:\n            List of peer JD identifiers\n        ')),
            AugAssign(
              target=Attribute(
                value=Name(id='self', ctx=Load()),
                attr='rag_calls_made',
                ctx=Store()),
              op=Add(),
              value=Name(id='num_calls', ctx=Load())),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='peer_jds_discovered',
                  ctx=Store())],
              value=Name(id='min_peer_jds', ctx=Load())),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='retrieval_docs_total',
                  ctx=Store())],
              value=Constant(value=200)),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='logger', ctx=Load()),
                  attr='info',
                  ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='  → Two-stage retrieval: BM25 (200 docs) → Cross-encoder (20 docs)')])])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='logger', ctx=Load()),
                  attr='info',
                  ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='  → Making '),
                      FormattedValue(
                        value=Name(id='num_calls', ctx=Load()),
                        conversion=-1),
                      Constant(value=' RAG calls for peer JD discovery')])])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='logger', ctx=Load()),
                  attr='info',
                  ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='  → Target: '),
                      FormattedValue(
                        value=Name(id='min_peer_jds', ctx=Load()),
                        conversion=-1),
                      Constant(value='+ similar job descriptions')])])),
            Return(
              value=List(
                elts=[
                  Constant(value='Senior AI Leader at Microsoft'),
                  Constant(value='VP of AI Products at Google'),
                  Constant(value='Director of ML at Amazon')],
                ctx=Load()))],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='_analyze_competitive_positioning',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='job_description',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='peer_jds',
                annotation=Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Name(id='str', ctx=Load()),
                  ctx=Load())),
              arg(
                arg='k0_output',
                annotation=Name(id='ThematicAnalysis', ctx=Load())),
              arg(
                arg='num_calls',
                annotation=Name(id='int', ctx=Load())),
              arg(
                arg='cot_paths',
                annotation=Name(id='int', ctx=Load())),
              arg(
                arg='tot_branches',
                annotation=Name(id='int', ctx=Load())),
              arg(
                arg='tot_depth',
                annotation=Name(id='int', ctx=Load())),
              arg(
                arg='self_consistency',
                annotation=Name(id='int', ctx=Load())),
              arg(
                arg='reflexion',
                annotation=Name(id='bool', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Analyze competitive positioning using peer JD comparison.\n        \n        In production, this would:\n        1. Extract keywords from all peer JDs\n        2. Calculate frequency distribution\n        3. Identify table stakes (≥80% frequency)\n        4. Identify differentiators (≤20% frequency)\n        5. Return positioning strategy\n        \n        Args:\n            job_description: Current JD\n            peer_jds: List of peer JDs\n            k0_output: K.0 output\n            num_calls: Number of RAG calls (12)\n            cot_paths: COT reasoning paths (2)\n            tot_branches: TOT branches (5)\n            tot_depth: TOT depth (4)\n            self_consistency: Self-consistency candidates (12)\n            reflexion: Enable self-correction (True)\n        \n        Returns:\n            Dict with table_stakes, differentiators, relevance_score\n        ')),
            AugAssign(
              target=Attribute(
                value=Name(id='self', ctx=Load()),
                attr='rag_calls_made',
                ctx=Store()),
              op=Add(),
              value=Name(id='num_calls', ctx=Load())),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='logger', ctx=Load()),
                  attr='info',
                  ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='  → Analyzing '),
                      FormattedValue(
                        value=Call(
                          func=Name(id='len', ctx=Load()),
                          args=[
                            Name(id='peer_jds', ctx=Load())]),
                        conversion=-1),
                      Constant(value=' peer JDs for positioning')])])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='logger', ctx=Load()),
                  attr='info',
                  ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='  → COT paths: '),
                      FormattedValue(
                        value=Name(id='cot_paths', ctx=Load()),
                        conversion=-1),
                      Constant(value=', TOT branches: '),
                      FormattedValue(
                        value=Name(id='tot_branches', ctx=Load()),
                        conversion=-1)])])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='logger', ctx=Load()),
                  attr='info',
                  ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='  → Self-consistency: '),
                      FormattedValue(
                        value=Name(id='self_consistency', ctx=Load()),
                        conversion=-1),
                      Constant(value=', Reflexion: '),
                      FormattedValue(
                        value=Name(id='reflexion', ctx=Load()),
                        conversion=-1)])])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='logger', ctx=Load()),
                  attr='info',
                  ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='  → Table stakes threshold: 80%, Differentiator threshold: 20%')])])),
            Return(
              value=Dict(
                keys=[
                  Constant(value='table_stakes'),
                  Constant(value='differentiators'),
                  Constant(value='relevance_score')],
                values=[
                  List(
                    elts=[
                      Constant(value='leadership'),
                      Constant(value='strategy'),
                      Constant(value='growth'),
                      Constant(value='team building'),
                      Constant(value='stakeholder management'),
                      Constant(value='innovation'),
                      Constant(value='execution')],
                    ctx=Load()),
                  List(
                    elts=[
                      Constant(value='enterprise AI transformation'),
                      Constant(value='measurable ROI focus'),
                      Constant(value='production ML systems at scale')],
                    ctx=Load()),
                  Constant(value=0.87)]))],
          returns=Name(id='Dict', ctx=Load()))]),
    ClassDef(
      name='ArtistGenerator',
      body=[
        Expr(
          value=Constant(value='\n    HOP-3: Generate resume content using Claude API.\n    Now consumes K.0 and K.2 outputs for enhanced context.\n    ')),
        FunctionDef(
