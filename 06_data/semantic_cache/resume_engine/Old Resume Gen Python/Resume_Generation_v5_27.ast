                                              orelse=[
                                                Return(
                                                  value=Constant(value='Generated content based on prompt analysis.'))])])])])])])])])])],
          returns=Name(id='str', ctx=Load())),
        FunctionDef(
          name='generate',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='enriched_scaffold',
                annotation=Name(id='Dict', ctx=Load())),
              arg(
                arg='job_description',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='k0_output',
                annotation=Name(id='ThematicAnalysis', ctx=Load())),
              arg(
                arg='k2_output',
                annotation=Name(id='K2CompetitiveAnalysis', ctx=Load())),
              arg(
                arg='feedback_results',
                annotation=Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Name(id='ValidationResult', ctx=Load()),
                  ctx=Load())),
              arg(
                arg='attempt',
                annotation=Name(id='int', ctx=Load()))],
            defaults=[
              Constant(value=None),
              Constant(value=1)]),
          body=[
            Expr(
              value=Constant(value='\n        Generate all resume content using LLM.\n        \n        Args:\n            enriched_scaffold: Enriched data from HOP-2\n            job_description: Original job description\n            k0_output: K.0 thematic analysis output\n            k2_output: K.2 competitive analysis output\n            feedback_results: Validation failures from previous attempt (if any)\n            attempt: Current generation attempt (1-5)\n        \n        Returns:\n            (artist_output, validation_results)\n        ')),
            Assign(
              targets=[
                Name(id='validation_results', ctx=Store())],
              value=List(ctx=Load())),
            Assign(
              targets=[
                Name(id='previous_failures', ctx=Store())],
              value=IfExp(
                test=Name(id='feedback_results', ctx=Load()),
                body=Name(id='feedback_results', ctx=Load()),
                orelse=List(ctx=Load()))),
            Try(
              body=[
                Assign(
                  targets=[
                    Name(id='artist_output', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='_generate_artist_output',
                      ctx=Load()),
                    args=[
                      Name(id='enriched_scaffold', ctx=Load()),
                      Name(id='job_description', ctx=Load()),
                      Name(id='k0_output', ctx=Load()),
                      Name(id='k2_output', ctx=Load()),
                      Name(id='previous_failures', ctx=Load())])),
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='validation_results', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Call(
                        func=Name(id='ValidationResult', ctx=Load()),
                        keywords=[
                          keyword(
                            arg='rule_id',
                            value=Constant(value='ARTIST_GENERATION')),
                          keyword(
                            arg='passed',
                            value=Constant(value=True)),
                          keyword(
                            arg='severity',
                            value=Attribute(
                              value=Name(id='ValidationSeverity', ctx=Load()),
                              attr='INFO',
                              ctx=Load())),
                          keyword(
                            arg='message',
                            value=JoinedStr(
                              values=[
                                Constant(value='Content generated successfully (attempt '),
                                FormattedValue(
                                  value=Name(id='attempt', ctx=Load()),
                                  conversion=-1),
                                Constant(value=')')]))])])),
                Return(
                  value=Tuple(
                    elts=[
                      Name(id='artist_output', ctx=Load()),
                      Name(id='validation_results', ctx=Load())],
                    ctx=Load()))],
              handlers=[
                ExceptHandler(
                  type=Name(id='Exception', ctx=Load()),
                  name='e',
                  body=[
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Name(id='validation_results', ctx=Load()),
                          attr='append',
                          ctx=Load()),
                        args=[
                          Call(
                            func=Name(id='ValidationResult', ctx=Load()),
                            keywords=[
                              keyword(
                                arg='rule_id',
                                value=Constant(value='ARTIST_GENERATION_ERROR')),
                              keyword(
                                arg='passed',
                                value=Constant(value=False)),
                              keyword(
                                arg='severity',
                                value=Attribute(
                                  value=Name(id='ValidationSeverity', ctx=Load()),
                                  attr='CRITICAL',
                                  ctx=Load())),
                              keyword(
                                arg='message',
                                value=JoinedStr(
                                  values=[
                                    Constant(value='Artist generation failed: '),
                                    FormattedValue(
                                      value=Call(
                                        func=Name(id='str', ctx=Load()),
                                        args=[
                                          Name(id='e', ctx=Load())]),
                                      conversion=-1)])),
                              keyword(
                                arg='details',
                                value=Dict(
                                  keys=[
                                    Constant(value='attempt'),
                                    Constant(value='error')],
                                  values=[
                                    Name(id='attempt', ctx=Load()),
                                    Call(
                                      func=Name(id='str', ctx=Load()),
                                      args=[
                                        Name(id='e', ctx=Load())])]))])])),
                    Return(
                      value=Tuple(
                        elts=[
                          Dict(),
                          Name(id='validation_results', ctx=Load())],
                        ctx=Load()))])])],
          returns=Subscript(
            value=Name(id='Tuple', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='Dict', ctx=Load()),
                Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Name(id='ValidationResult', ctx=Load()),
                  ctx=Load())],
              ctx=Load()),
            ctx=Load())),
