                  Constant(value='Transformation'),
                  Constant(value='Scalability'),
                  Constant(value='Collaboration')],
                values=[
                  Constant(value='team|hiring|talent|people'),
                  Constant(value='customer|client|account'),
                  Constant(value='strategy|strategic|vision'),
                  Constant(value='technical|architecture|solution'),
                  Constant(value='revenue|sales|growth|pipeline'),
                  Constant(value='\\bai\\b|machine learning|\\bml\\b'),
                  Constant(value='cloud|aws|azure|gcp'),
                  Constant(value='enterprise|b2b|fortune'),
                  Constant(value='product|platform|software'),
                  Constant(value='transformation|modernization'),
                  Constant(value='scale|scaling|expansion'),
                  Constant(value='collaboration|cross-functional')])),
            For(
              target=Tuple(
                elts=[
                  Name(id='theme', ctx=Store()),
                  Name(id='pattern', ctx=Store())],
                ctx=Store()),
              iter=Call(
