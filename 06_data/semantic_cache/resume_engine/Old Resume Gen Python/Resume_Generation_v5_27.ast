                  attr='lower',
                  ctx=Load()))),
            If(
              test=Call(
                func=Attribute(
                  value=Name(id='re', ctx=Load()),
                  attr='search',
                  ctx=Load()),
                args=[
                  Constant(value='vp|vice president|svp|chief'),
                  Name(id='jd_lower', ctx=Load())]),
              body=[
                Assign(
                  targets=[
                    Name(id='secondary', ctx=Store())],
                  value=List(
                    elts=[
                      Constant(value='Executive Leadership'),
                      Constant(value='Strategic Planning')],
                    ctx=Load())),
                Assign(
                  targets=[
                    Name(id='confidence', ctx=Store())],
                  value=Constant(value=0.95))],
              orelse=[
                If(
                  test=Call(
                    func=Attribute(
                      value=Name(id='re', ctx=Load()),
                      attr='search',
                      ctx=Load()),
                    args=[
                      Constant(value='director|head of'),
                      Name(id='jd_lower', ctx=Load())]),
                  body=[
                    Assign(
                      targets=[
                        Name(id='secondary', ctx=Store())],
                      value=List(
                        elts=[
                          Constant(value='Director-Level Leadership'),
                          Constant(value='Team Management')],
                        ctx=Load())),
                    Assign(
                      targets=[
                        Name(id='confidence', ctx=Store())],
                      value=Constant(value=0.9))],
                  orelse=[
                    Assign(
                      targets=[
                        Name(id='secondary', ctx=Store())],
                      value=List(
                        elts=[
                          Constant(value='Senior Leadership'),
                          Constant(value='Technical Leadership')],
                        ctx=Load())),
                    Assign(
                      targets=[
                        Name(id='confidence', ctx=Store())],
                      value=Constant(value=0.85))])]),
            Return(
              value=Dict(
                keys=[
                  Constant(value='primary_role'),
                  Constant(value='secondary_roles'),
                  Constant(value='confidence_score')],
                values=[
                  Constant(value='Technology Leadership'),
                  Name(id='secondary', ctx=Load()),
                  Name(id='confidence', ctx=Load())]))],
          returns=Name(id='Dict', ctx=Load())),
