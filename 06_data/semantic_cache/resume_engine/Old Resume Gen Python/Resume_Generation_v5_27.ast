                keywords=[
                  keyword(
                    arg='executive_summary_patterns',
                    value=List(
                      elts=[
                        Constant(value='Built X achieving Y impact with Z measurable outcome'),
                        Constant(value='Scaled operations from $XM to $YM through strategic initiatives'),
                        Constant(value='Led transformation delivering X% improvement in Y metric')],
                      ctx=Load())),
                  keyword(
                    arg='achievement_verb_patterns',
                    value=List(
                      elts=[
                        Constant(value='Built'),
                        Constant(value='Scaled'),
                        Constant(value='Led'),
                        Constant(value='Drove'),
                        Constant(value='Established'),
                        Constant(value='Launched'),
                        Constant(value='Achieved'),
                        Constant(value='Delivered'),
                        Constant(value='Transformed'),
                        Constant(value='Optimized')],
                      ctx=Load())),
                  keyword(
                    arg='metric_presentation_patterns',
                    value=List(
                      elts=[
                        Constant(value='$XM revenue'),
                        Constant(value='X% growth'),
                        Constant(value='X+ clients'),
                        Constant(value='X% improvement'),
                        Constant(value='$XM cost reduction'),
                        Constant(value='X-person team'),
                        Constant(value='X% efficiency gain')],
                      ctx=Load())),
                  keyword(
