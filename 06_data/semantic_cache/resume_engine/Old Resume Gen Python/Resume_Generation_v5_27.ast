          returns=Name(id='K2CompetitiveAnalysis', ctx=Load())),
        FunctionDef(
          name='_discover_peer_jds',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='job_description',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='k0_output',
