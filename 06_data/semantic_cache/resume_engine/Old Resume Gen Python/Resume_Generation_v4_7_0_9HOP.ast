        FunctionDef(
          name='select_skills_for_jd',
          args=arguments(
            args=[
              arg(arg='cls'),
              arg(
                arg='jd_text',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='target_role',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='count',
                annotation=Name(id='int', ctx=Load()))],
            defaults=[
              Constant(value=12)]),
          body=[
            Expr(
              value=Constant(value='Select top 12 skills based on JD keyword matching.')),
            Assign(
              targets=[
                Name(id='jd_lower', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='jd_text', ctx=Load()),
                  attr='lower',
                  ctx=Load()))),
            Assign(
              targets=[
                Name(id='skill_scores', ctx=Store())],
              value=Dict()),
            For(
              target=Tuple(
                elts=[
                  Name(id='category', ctx=Store()),
                  Name(id='skills', ctx=Store())],
                ctx=Store()),
              iter=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='cls', ctx=Load()),
                    attr='SKILLS_POOL',
                    ctx=Load()),
                  attr='items',
                  ctx=Load())),
              body=[
                Assign(
                  targets=[
                    Name(id='category_boost', ctx=Store())],
                  value=Constant(value=1.0)),
                If(
                  test=BoolOp(
                    op=And(),
                    values=[
                      Compare(
                        left=Constant(value='presales'),
                        ops=[
                          In()],
                        comparators=[
                          Call(
                            func=Attribute(
                              value=Name(id='target_role', ctx=Load()),
                              attr='lower',
                              ctx=Load()))]),
                      Compare(
                        left=Name(id='category', ctx=Load()),
                        ops=[
                          Eq()],
                        comparators=[
                          Constant(value='presales_tools')])]),
                  body=[
                    Assign(
                      targets=[
                        Name(id='category_boost', ctx=Store())],
                      value=Constant(value=2.0))],
                  orelse=[
                    If(
                      test=BoolOp(
                        op=And(),
                        values=[
                          Compare(
                            left=Constant(value='ai'),
                            ops=[
                              In()],
                            comparators=[
                              Call(
                                func=Attribute(
                                  value=Name(id='target_role', ctx=Load()),
                                  attr='lower',
                                  ctx=Load()))]),
                          Compare(
                            left=Name(id='category', ctx=Load()),
                            ops=[
                              Eq()],
                            comparators=[
                              Constant(value='ai_ml')])]),
                      body=[
                        Assign(
                          targets=[
                            Name(id='category_boost', ctx=Store())],
                          value=Constant(value=2.0))],
                      orelse=[
                        If(
                          test=BoolOp(
                            op=And(),
                            values=[
                              Compare(
                                left=Constant(value='data'),
                                ops=[
                                  In()],
                                comparators=[
                                  Call(
                                    func=Attribute(
                                      value=Name(id='target_role', ctx=Load()),
                                      attr='lower',
                                      ctx=Load()))]),
                              Compare(
                                left=Name(id='category', ctx=Load()),
                                ops=[
                                  Eq()],
                                comparators=[
                                  Constant(value='data_engineering')])]),
                          body=[
                            Assign(
                              targets=[
                                Name(id='category_boost', ctx=Store())],
                              value=Constant(value=1.5))])])]),
                For(
                  target=Name(id='skill', ctx=Store()),
                  iter=Name(id='skills', ctx=Load()),
                  body=[
                    Assign(
                      targets=[
                        Name(id='score', ctx=Store())],
                      value=Constant(value=0)),
                    Assign(
                      targets=[
                        Name(id='skill_lower', ctx=Store())],
                      value=Call(
                        func=Attribute(
                          value=Name(id='skill', ctx=Load()),
                          attr='lower',
                          ctx=Load()))),
                    If(
                      test=Compare(
                        left=Name(id='skill_lower', ctx=Load()),
                        ops=[
                          In()],
                        comparators=[
                          Name(id='jd_lower', ctx=Load())]),
                      body=[
                        AugAssign(
                          target=Name(id='score', ctx=Store()),
                          op=Add(),
                          value=Constant(value=3.0))]),
                    Assign(
                      targets=[
                        Name(id='skill_words', ctx=Store())],
                      value=Call(
                        func=Attribute(
                          value=Name(id='skill_lower', ctx=Load()),
                          attr='split',
                          ctx=Load()))),
                    For(
                      target=Name(id='word', ctx=Store()),
                      iter=Name(id='skill_words', ctx=Load()),
                      body=[
                        If(
                          test=BoolOp(
                            op=And(),
                            values=[
                              Compare(
                                left=Call(
                                  func=Name(id='len', ctx=Load()),
                                  args=[
                                    Name(id='word', ctx=Load())]),
                                ops=[
                                  Gt()],
                                comparators=[
                                  Constant(value=3)]),
                              Compare(
                                left=Name(id='word', ctx=Load()),
                                ops=[
                                  In()],
                                comparators=[
                                  Name(id='jd_lower', ctx=Load())])]),
                          body=[
                            AugAssign(
                              target=Name(id='score', ctx=Store()),
                              op=Add(),
                              value=Constant(value=1.0))])]),
                    AugAssign(
                      target=Name(id='score', ctx=Store()),
                      op=Mult(),
                      value=Name(id='category_boost', ctx=Load())),
                    If(
                      test=Compare(
