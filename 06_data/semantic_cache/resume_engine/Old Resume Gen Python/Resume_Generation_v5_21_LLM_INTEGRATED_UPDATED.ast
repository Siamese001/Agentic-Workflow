                    left=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='baseline_words',
                      ctx=Load()),
                    op=Mult(),
                    right=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='tolerance_pct',
                      ctx=Load()))])),
            Return(
              value=Tuple(
                elts=[
                  BinOp(
                    left=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='baseline_words',
                      ctx=Load()),
                    op=Sub(),
                    right=Name(id='delta', ctx=Load())),
                  BinOp(
                    left=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='baseline_words',
                      ctx=Load()),
                    op=Add(),
                    right=Name(id='delta', ctx=Load()))],
