        FunctionDef(
          name='_assemble_bullet_pool',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Assemble complete bullet pool from master resume.')),
            Assign(
              targets=[
