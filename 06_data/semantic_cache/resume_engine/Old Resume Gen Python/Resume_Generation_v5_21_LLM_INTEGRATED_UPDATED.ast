        FunctionDef(
          name='_extract_metrics',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='text',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Extract quantified metrics from bullet text.')),
            Assign(
              targets=[
                Name(id='metrics', ctx=Store())],
              value=List(ctx=Load())),
            Assign(
              targets=[
                Name(id='patterns', ctx=Store())],
              value=List(
                elts=[
                  Constant(value='\\$\\d+\\.?\\d*[MBK]\\+?'),
                  Constant(value='\\d+\\.?\\d*%'),
                  Constant(value='\\d+\\.?\\d*[MBK]\\+'),
                  Constant(value='\\d{1,3}(?:,\\d{3})+')],
                ctx=Load())),
            For(
              target=Name(id='pattern', ctx=Store()),
              iter=Name(id='patterns', ctx=Load()),
              body=[
                Assign(
                  targets=[
                    Name(id='matches', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='re', ctx=Load()),
