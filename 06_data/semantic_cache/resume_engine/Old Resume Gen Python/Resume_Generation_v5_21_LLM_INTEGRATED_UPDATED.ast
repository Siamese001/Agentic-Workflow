                right=BinOp(
                  left=Constant(value=1),
                  op=Add(),
                  right=Name(id='tolerance', ctx=Load())))])),
        Assign(
          targets=[
            Name(id='passed', ctx=Store())],
          value=Compare(
            left=Name(id='min_words', ctx=Load()),
