            ctx=Load()),
          simple=1),
        FunctionDef(
          name='get_top_differentiators',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='n',
                annotation=Name(id='int', ctx=Load()))],
            defaults=[
              Constant(value=5)]),
          body=[
            Expr(
              value=Constant(value='Return top N differentiator keywords.')),
            Assign(
              targets=[
                Name(id='sorted_keywords', ctx=Store())],
              value=Call(
                func=Name(id='sorted', ctx=Load()),
                args=[
                  Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='differentiator_keywords_weighted',
                    ctx=Load())],
                keywords=[
                  keyword(
                    arg='key',
                    value=Lambda(
                      args=arguments(
                        args=[
                          arg(arg='x')]),
                      body=Subscript(
                        value=Name(id='x', ctx=Load()),
                        slice=Constant(value='weight'),
                        ctx=Load()))),
                  keyword(
                    arg='reverse',
                    value=Constant(value=True))])),
            Return(
              value=ListComp(
                elt=Subscript(
                  value=Name(id='kw', ctx=Load()),
                  slice=Constant(value='keyword'),
                  ctx=Load()),
                generators=[
                  comprehension(
                    target=Name(id='kw', ctx=Store()),
                    iter=Subscript(
                      value=Name(id='sorted_keywords', ctx=Load()),
                      slice=Slice(
                        upper=Name(id='n', ctx=Load())),
                      ctx=Load()),
                    is_async=0)]))],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load()))],
