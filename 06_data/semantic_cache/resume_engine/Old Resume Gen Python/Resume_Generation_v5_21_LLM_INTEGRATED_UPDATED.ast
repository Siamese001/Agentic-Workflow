                      attr='extend',
                      ctx=Load()),
                    args=[
                      Name(id='matches', ctx=Load())]))]),
            Return(
              value=Name(id='metrics', ctx=Load()))],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load()))]),
    ClassDef(
      name='HallucinationDetector',
      body=[
        Expr(
          value=Constant(value='\n    Detect potential hallucinations in resume content.\n    Flags implausible metrics, temporal inconsistencies, etc.\n    ')),
        FunctionDef(
          name='detect',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='bullet_pool',
                annotation=Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Name(id='Dict', ctx=Load()),
                  ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Run hallucination detection on bullet pool.\n        Returns: List of validation results\n        ')),
            Assign(
              targets=[
                Name(id='results', ctx=Store())],
              value=List(ctx=Load())),
            For(
              target=Tuple(
                elts=[
                  Name(id='i', ctx=Store()),
                  Name(id='bullet', ctx=Store())],
                ctx=Store()),
              iter=Call(
                func=Name(id='enumerate', ctx=Load()),
                args=[
                  Name(id='bullet_pool', ctx=Load())]),
              body=[
                Assign(
                  targets=[
                    Name(id='text', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='bullet', ctx=Load()),
                      attr='get',
                      ctx=Load()),
                    args=[
                      Constant(value='bullet_text'),
                      Constant(value='')])),
                If(
                  test=Call(
                    func=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='_has_implausible_growth',
                      ctx=Load()),
                    args=[
                      Name(id='text', ctx=Load())]),
                  body=[
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Name(id='results', ctx=Load()),
                          attr='append',
                          ctx=Load()),
                        args=[
                          Call(
                            func=Name(id='ValidationResult', ctx=Load()),
                            keywords=[
                              keyword(
                                arg='rule_id',
                                value=Constant(value='HALLUCINATION_IMPLAUSIBLE_GROWTH')),
                              keyword(
                                arg='passed',
                                value=Constant(value=False)),
                              keyword(
                                arg='severity',
                                value=Attribute(
                                  value=Name(id='ValidationSeverity', ctx=Load()),
                                  attr='HIGH',
                                  ctx=Load())),
                              keyword(
                                arg='message',
                                value=JoinedStr(
                                  values=[
                                    Constant(value='Bullet '),
                                    FormattedValue(
                                      value=BinOp(
                                        left=Name(id='i', ctx=Load()),
                                        op=Add(),
                                        right=Constant(value=1)),
                                      conversion=-1),
                                    Constant(value=' may contain implausible growth rate')])),
                              keyword(
                                arg='details',
                                value=Dict(
                                  keys=[
                                    Constant(value='bullet_text')],
                                  values=[
                                    Subscript(
                                      value=Name(id='text', ctx=Load()),
                                      slice=Slice(
                                        upper=Constant(value=100)),
                                      ctx=Load())]))])]))]),
                If(
                  test=Call(
                    func=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='_has_excessive_superlatives',
                      ctx=Load()),
                    args=[
                      Name(id='text', ctx=Load())]),
                  body=[
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Name(id='results', ctx=Load()),
                          attr='append',
                          ctx=Load()),
                        args=[
                          Call(
                            func=Name(id='ValidationResult', ctx=Load()),
                            keywords=[
                              keyword(
                                arg='rule_id',
                                value=Constant(value='HALLUCINATION_EXCESSIVE_SUPERLATIVES')),
                              keyword(
                                arg='passed',
                                value=Constant(value=False)),
                              keyword(
                                arg='severity',
                                value=Attribute(
                                  value=Name(id='ValidationSeverity', ctx=Load()),
                                  attr='MEDIUM',
                                  ctx=Load())),
                              keyword(
                                arg='message',
                                value=JoinedStr(
                                  values=[
                                    Constant(value='Bullet '),
                                    FormattedValue(
                                      value=BinOp(
                                        left=Name(id='i', ctx=Load()),
                                        op=Add(),
                                        right=Constant(value=1)),
                                      conversion=-1),
                                    Constant(value=' contains excessive superlatives')])),
                              keyword(
                                arg='details',
                                value=Dict(
                                  keys=[
                                    Constant(value='bullet_text')],
                                  values=[
                                    Subscript(
                                      value=Name(id='text', ctx=Load()),
                                      slice=Slice(
                                        upper=Constant(value=100)),
                                      ctx=Load())]))])]))])]),
            If(
              test=UnaryOp(
                op=Not(),
                operand=Name(id='results', ctx=Load())),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='results', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Call(
                        func=Name(id='ValidationResult', ctx=Load()),
                        keywords=[
                          keyword(
                            arg='rule_id',
                            value=Constant(value='HALLUCINATION_CHECK')),
                          keyword(
                            arg='passed',
                            value=Constant(value=True)),
                          keyword(
                            arg='severity',
                            value=Attribute(
                              value=Name(id='ValidationSeverity', ctx=Load()),
                              attr='INFO',
                              ctx=Load())),
                          keyword(
                            arg='message',
                            value=JoinedStr(
                              values=[
                                Constant(value='No hallucinations detected in '),
                                FormattedValue(
                                  value=Call(
                                    func=Name(id='len', ctx=Load()),
                                    args=[
                                      Name(id='bullet_pool', ctx=Load())]),
                                  conversion=-1),
                                Constant(value=' bullets')]))])]))]),
            Return(
              value=Name(id='results', ctx=Load()))],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='ValidationResult', ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='_has_implausible_growth',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='text',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Check for implausibly high growth rates (>10x in short time).')),
            Assign(
              targets=[
                Name(id='growth_patterns', ctx=Store())],
              value=List(
                elts=[
                  Constant(value='\\d{3,}%'),
                  Constant(value='\\d+x')],
                ctx=Load())),
            For(
              target=Name(id='pattern', ctx=Store()),
              iter=Name(id='growth_patterns', ctx=Load()),
              body=[
                If(
                  test=Call(
                    func=Attribute(
                      value=Name(id='re', ctx=Load()),
                      attr='search',
                      ctx=Load()),
                    args=[
                      Name(id='pattern', ctx=Load()),
                      Name(id='text', ctx=Load())]),
                  body=[
                    If(
                      test=Call(
                        func=Name(id='any', ctx=Load()),
                        args=[
                          GeneratorExp(
                            elt=Compare(
                              left=Name(id='term', ctx=Load()),
                              ops=[
                                In()],
                              comparators=[
                                Call(
                                  func=Attribute(
                                    value=Name(id='text', ctx=Load()),
                                    attr='lower',
                                    ctx=Load()))]),
                            generators=[
                              comprehension(
                                target=Name(id='term', ctx=Store()),
                                iter=List(
                                  elts=[
                                    Constant(value='month'),
                                    Constant(value='quarter'),
                                    Constant(value='90 day')],
                                  ctx=Load()),
                                is_async=0)])]),
                      body=[
                        Return(
                          value=Constant(value=True))])])]),
            Return(
              value=Constant(value=False))],
          returns=Name(id='bool', ctx=Load())),
        FunctionDef(
          name='_has_excessive_superlatives',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='text',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Check for excessive use of superlatives.')),
            Assign(
              targets=[
                Name(id='superlatives', ctx=Store())],
              value=List(
                elts=[
                  Constant(value='revolutionary'),
                  Constant(value='groundbreaking'),
                  Constant(value='unprecedented'),
                  Constant(value='unparalleled'),
                  Constant(value='game-changing'),
                  Constant(value='world-class'),
                  Constant(value='best-in-class'),
                  Constant(value='cutting-edge')],
                ctx=Load())),
            Assign(
              targets=[
                Name(id='count', ctx=Store())],
              value=Call(
                func=Name(id='sum', ctx=Load()),
                args=[
                  GeneratorExp(
                    elt=Constant(value=1),
                    generators=[
                      comprehension(
                        target=Name(id='word', ctx=Store()),
                        iter=Name(id='superlatives', ctx=Load()),
                        ifs=[
                          Compare(
                            left=Name(id='word', ctx=Load()),
                            ops=[
                              In()],
                            comparators=[
                              Call(
                                func=Attribute(
                                  value=Name(id='text', ctx=Load()),
                                  attr='lower',
                                  ctx=Load()))])],
                        is_async=0)])])),
            Return(
              value=Compare(
                left=Name(id='count', ctx=Load()),
                ops=[
                  GtE()],
                comparators=[
                  Constant(value=2)]))],
          returns=Name(id='bool', ctx=Load()))]),
    ClassDef(
      name='DataEnricher',
      body=[
        Expr(
          value=Constant(value='\n    HOP-2: Enrich bullet pool with canonical verbs, deduplication, etc.\n    ')),
        FunctionDef(
          name='__init__',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='verb_canonicalizer',
                  ctx=Store())],
              value=Call(
                func=Name(id='VerbCanonicalizer', ctx=Load()))),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='duplicate_detector',
                  ctx=Store())],
              value=Call(
                func=Name(id='DuplicateDetector', ctx=Load())))]),
        FunctionDef(
          name='enrich',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='extracted_data',
                annotation=Name(id='Dict', ctx=Load())),
              arg(
                arg='thematic_analysis',
                annotation=Name(id='ThematicAnalysis', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Enrich extracted data with additional metadata.\n        Returns: (enriched_data, validation_results)\n        ')),
            Assign(
              targets=[
                Name(id='validation_results', ctx=Store())],
              value=List(ctx=Load())),
            Assign(
              targets=[
                Name(id='bullet_pool', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='extracted_data', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='bullet_pool'),
                  List(ctx=Load())])),
            For(
              target=Name(id='bullet', ctx=Store()),
              iter=Name(id='bullet_pool', ctx=Load()),
              body=[
                Assign(
                  targets=[
                    Name(id='canonical_verbs', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='verb_canonicalizer',
                        ctx=Load()),
                      attr='canonicalize',
                      ctx=Load()),
                    args=[
                      Call(
                        func=Attribute(
                          value=Name(id='bullet', ctx=Load()),
                          attr='get',
                          ctx=Load()),
                        args=[
                          Constant(value='bullet_text'),
                          Constant(value='')])])),
                Assign(
                  targets=[
                    Subscript(
                      value=Name(id='bullet', ctx=Load()),
                      slice=Constant(value='canonical_verbs'),
                      ctx=Store())],
                  value=Name(id='canonical_verbs', ctx=Load()))]),
            Assign(
              targets=[
                Name(id='duplicates', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='duplicate_detector',
                    ctx=Load()),
                  attr='find_duplicates',
                  ctx=Load()),
                args=[
                  Name(id='bullet_pool', ctx=Load())])),
            If(
              test=Name(id='duplicates', ctx=Load()),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='validation_results', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Call(
                        func=Name(id='ValidationResult', ctx=Load()),
                        keywords=[
                          keyword(
                            arg='rule_id',
                            value=Constant(value='DUPLICATE_BULLETS')),
                          keyword(
                            arg='passed',
                            value=Constant(value=False)),
                          keyword(
                            arg='severity',
                            value=Attribute(
                              value=Name(id='ValidationSeverity', ctx=Load()),
                              attr='MEDIUM',
                              ctx=Load())),
                          keyword(
                            arg='message',
                            value=JoinedStr(
                              values=[
                                Constant(value='Found '),
                                FormattedValue(
                                  value=Call(
                                    func=Name(id='len', ctx=Load()),
                                    args=[
                                      Name(id='duplicates', ctx=Load())]),
                                  conversion=-1),
                                Constant(value=' potential duplicate bullets')])),
                          keyword(
                            arg='details',
                            value=Dict(
                              keys=[
                                Constant(value='duplicates')],
                              values=[
                                Subscript(
                                  value=Name(id='duplicates', ctx=Load()),
                                  slice=Slice(
                                    upper=Constant(value=5)),
                                  ctx=Load())]))])]))],
              orelse=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='validation_results', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Call(
                        func=Name(id='ValidationResult', ctx=Load()),
                        keywords=[
                          keyword(
                            arg='rule_id',
                            value=Constant(value='DUPLICATE_CHECK')),
                          keyword(
                            arg='passed',
                            value=Constant(value=True)),
                          keyword(
                            arg='severity',
                            value=Attribute(
                              value=Name(id='ValidationSeverity', ctx=Load()),
                              attr='INFO',
                              ctx=Load())),
                          keyword(
                            arg='message',
                            value=Constant(value='No duplicate bullets detected'))])]))]),
            Assign(
              targets=[
                Name(id='enriched_data', ctx=Store())],
              value=Dict(
                keys=[
                  None,
                  Constant(value='bullet_pool')],
                values=[
                  Name(id='extracted_data', ctx=Load()),
                  Name(id='bullet_pool', ctx=Load())])),
            Return(
              value=Tuple(
                elts=[
                  Name(id='enriched_data', ctx=Load()),
                  Name(id='validation_results', ctx=Load())],
                ctx=Load()))],
          returns=Subscript(
            value=Name(id='Tuple', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='Dict', ctx=Load()),
                Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Name(id='ValidationResult', ctx=Load()),
                  ctx=Load())],
              ctx=Load()),
            ctx=Load()))]),
    ClassDef(
      name='VerbCanonicalizer',
      body=[
        Expr(
          value=Constant(value='Canonicalize action verbs to approved list.')),
        Assign(
          targets=[
            Name(id='CANONICAL_VERBS', ctx=Store())],
          value=Dict(
            keys=[
              Constant(value='led'),
              Constant(value='built'),
              Constant(value='drove'),
              Constant(value='launched'),
              Constant(value='scaled'),
              Constant(value='delivered'),
              Constant(value='achieved'),
              Constant(value='established'),
              Constant(value='managed'),
              Constant(value='developed')],
            values=[
              List(
                elts=[
                  Constant(value='led'),
                  Constant(value='lead'),
                  Constant(value='leading')],
                ctx=Load()),
              List(
                elts=[
                  Constant(value='built'),
                  Constant(value='build'),
                  Constant(value='building')],
                ctx=Load()),
              List(
                elts=[
                  Constant(value='drove'),
                  Constant(value='drive'),
                  Constant(value='driving')],
                ctx=Load()),
              List(
                elts=[
                  Constant(value='launched'),
                  Constant(value='launch'),
                  Constant(value='launching')],
                ctx=Load()),
              List(
                elts=[
                  Constant(value='scaled'),
                  Constant(value='scale'),
                  Constant(value='scaling')],
                ctx=Load()),
              List(
                elts=[
                  Constant(value='delivered'),
                  Constant(value='deliver'),
                  Constant(value='delivering')],
                ctx=Load()),
              List(
                elts=[
                  Constant(value='achieved'),
                  Constant(value='achieve'),
                  Constant(value='achieving')],
                ctx=Load()),
              List(
                elts=[
                  Constant(value='established'),
                  Constant(value='establish'),
                  Constant(value='establishing')],
                ctx=Load()),
              List(
                elts=[
                  Constant(value='managed'),
                  Constant(value='manage'),
                  Constant(value='managing')],
                ctx=Load()),
              List(
                elts=[
                  Constant(value='developed'),
                  Constant(value='develop'),
                  Constant(value='developing')],
                ctx=Load())])),
        Assign(
          targets=[
            Name(id='FORBIDDEN_VERBS', ctx=Store())],
          value=List(
            elts=[
              Constant(value='pioneered'),
              Constant(value='spearheaded'),
              Constant(value='orchestrated'),
              Constant(value='architected'),
              Constant(value='revolutionized'),
              Constant(value='transformed')],
            ctx=Load())),
        FunctionDef(
          name='canonicalize',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='text',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Extract and canonicalize verbs from text.')),
            Assign(
              targets=[
                Name(id='canonical', ctx=Store())],
              value=List(ctx=Load())),
            Assign(
              targets=[
                Name(id='text_lower', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='text', ctx=Load()),
                  attr='lower',
                  ctx=Load()))),
            For(
              target=Tuple(
                elts=[
                  Name(id='canonical_form', ctx=Store()),
                  Name(id='variants', ctx=Store())],
                ctx=Store()),
              iter=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='CANONICAL_VERBS',
                    ctx=Load()),
                  attr='items',
                  ctx=Load())),
              body=[
                If(
                  test=Call(
                    func=Name(id='any', ctx=Load()),
                    args=[
                      GeneratorExp(
                        elt=Compare(
                          left=Name(id='variant', ctx=Load()),
                          ops=[
                            In()],
                          comparators=[
                            Name(id='text_lower', ctx=Load())]),
                        generators=[
                          comprehension(
                            target=Name(id='variant', ctx=Store()),
                            iter=Name(id='variants', ctx=Load()),
                            is_async=0)])]),
                  body=[
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Name(id='canonical', ctx=Load()),
                          attr='append',
                          ctx=Load()),
                        args=[
                          Name(id='canonical_form', ctx=Load())]))])]),
            Return(
              value=Name(id='canonical', ctx=Load()))],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load()))]),
    ClassDef(
      name='DuplicateDetector',
      body=[
        Expr(
          value=Constant(value='Detect duplicate or near-duplicate bullets.')),
        FunctionDef(
          name='find_duplicates',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='bullets',
                annotation=Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Name(id='Dict', ctx=Load()),
                  ctx=Load())),
              arg(
                arg='threshold',
                annotation=Name(id='float', ctx=Load()))],
            defaults=[
              Constant(value=0.85)]),
          body=[
            Expr(
              value=Constant(value='\n        Find bullets with similarity >= threshold.\n        Returns: List of (index1, index2, similarity_score)\n        ')),
            Assign(
              targets=[
                Name(id='duplicates', ctx=Store())],
              value=List(ctx=Load())),
            For(
              target=Name(id='i', ctx=Store()),
              iter=Call(
                func=Name(id='range', ctx=Load()),
                args=[
                  Call(
                    func=Name(id='len', ctx=Load()),
                    args=[
                      Name(id='bullets', ctx=Load())])]),
              body=[
                For(
                  target=Name(id='j', ctx=Store()),
                  iter=Call(
                    func=Name(id='range', ctx=Load()),
                    args=[
                      BinOp(
                        left=Name(id='i', ctx=Load()),
                        op=Add(),
                        right=Constant(value=1)),
                      Call(
                        func=Name(id='len', ctx=Load()),
                        args=[
                          Name(id='bullets', ctx=Load())])]),
                  body=[
                    Assign(
                      targets=[
                        Name(id='similarity', ctx=Store())],
                      value=Call(
                        func=Attribute(
                          value=Name(id='self', ctx=Load()),
                          attr='_calculate_similarity',
                          ctx=Load()),
                        args=[
                          Call(
                            func=Attribute(
                              value=Subscript(
                                value=Name(id='bullets', ctx=Load()),
                                slice=Name(id='i', ctx=Load()),
                                ctx=Load()),
                              attr='get',
                              ctx=Load()),
                            args=[
                              Constant(value='bullet_text'),
                              Constant(value='')]),
                          Call(
                            func=Attribute(
                              value=Subscript(
                                value=Name(id='bullets', ctx=Load()),
                                slice=Name(id='j', ctx=Load()),
                                ctx=Load()),
                              attr='get',
                              ctx=Load()),
                            args=[
                              Constant(value='bullet_text'),
                              Constant(value='')])])),
                    If(
                      test=Compare(
                        left=Name(id='similarity', ctx=Load()),
                        ops=[
                          GtE()],
                        comparators=[
                          Name(id='threshold', ctx=Load())]),
                      body=[
                        Expr(
                          value=Call(
                            func=Attribute(
                              value=Name(id='duplicates', ctx=Load()),
                              attr='append',
                              ctx=Load()),
                            args=[
                              Tuple(
                                elts=[
                                  Name(id='i', ctx=Load()),
                                  Name(id='j', ctx=Load()),
                                  Name(id='similarity', ctx=Load())],
                                ctx=Load())]))])])]),
            Return(
              value=Name(id='duplicates', ctx=Load()))],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Subscript(
              value=Name(id='Tuple', ctx=Load()),
              slice=Tuple(
                elts=[
                  Name(id='int', ctx=Load()),
                  Name(id='int', ctx=Load()),
                  Name(id='float', ctx=Load())],
                ctx=Load()),
              ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='_calculate_similarity',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='text1',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='text2',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Calculate Jaccard similarity between two texts.')),
            Assign(
              targets=[
                Name(id='words1', ctx=Store())],
              value=Call(
                func=Name(id='set', ctx=Load()),
                args=[
                  Call(
                    func=Attribute(
                      value=Call(
                        func=Attribute(
                          value=Name(id='text1', ctx=Load()),
                          attr='lower',
                          ctx=Load())),
                      attr='split',
                      ctx=Load()))])),
            Assign(
              targets=[
                Name(id='words2', ctx=Store())],
              value=Call(
                func=Name(id='set', ctx=Load()),
                args=[
                  Call(
                    func=Attribute(
                      value=Call(
                        func=Attribute(
                          value=Name(id='text2', ctx=Load()),
                          attr='lower',
                          ctx=Load())),
                      attr='split',
                      ctx=Load()))])),
            Assign(
              targets=[
                Name(id='intersection', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='words1', ctx=Load()),
                  attr='intersection',
                  ctx=Load()),
                args=[
                  Name(id='words2', ctx=Load())])),
            Assign(
              targets=[
                Name(id='union', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='words1', ctx=Load()),
                  attr='union',
                  ctx=Load()),
                args=[
                  Name(id='words2', ctx=Load())])),
            If(
              test=UnaryOp(
                op=Not(),
                operand=Name(id='union', ctx=Load())),
              body=[
                Return(
                  value=Constant(value=0.0))]),
            Return(
              value=BinOp(
                left=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Name(id='intersection', ctx=Load())]),
                op=Div(),
                right=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Name(id='union', ctx=Load())])))],
          returns=Name(id='float', ctx=Load()))]),
    ClassDef(
      name='ArtistGenerator',
      body=[
        Expr(
          value=Constant(value='\n    HOP-3: Generate resume content using Claude API.\n    This is where the actual LLM calls happen.\n    ')),
        FunctionDef(
          name='__init__',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Pass()]),
        FunctionDef(
          name='_call_claude_api',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='prompt',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='system_prompt',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='temperature',
                annotation=Name(id='float', ctx=Load())),
              arg(
                arg='max_tokens',
                annotation=Name(id='int', ctx=Load())),
              arg(
                arg='reasoning_config',
                annotation=Name(id='Dict', ctx=Load()))],
            defaults=[
              Constant(value=''),
              Constant(value=0.7),
              Constant(value=500),
              Constant(value=None)]),
          body=[
            Expr(
              value=Constant(value='\n        Call Claude API with given prompt.\n        \n        In production, this would make actual API calls to Anthropic.\n        For now, returns mock responses that match expected format.\n        \n        Args:\n            prompt: User prompt\n            system_prompt: System prompt\n            temperature: Sampling temperature\n            max_tokens: Max tokens to generate\n            reasoning_config: Dict with cot_min_paths, tot_branches, self_consistency, etc.\n        \n        Returns:\n            Generated text\n        ')),
            If(
              test=Compare(
                left=Constant(value='executive summary'),
                ops=[
                  In()],
                comparators=[
                  Call(
                    func=Attribute(
                      value=Name(id='prompt', ctx=Load()),
                      attr='lower',
                      ctx=Load()))]),
              body=[
                Return(
                  value=Constant(value='Technology executive with 15+ years driving digital transformation and AI innovation across Fortune 500 enterprises. Built and scaled professional services organizations from $50M to $400M+ ARR through strategic vision, operational excellence, and client-centric delivery. Deep expertise in enterprise AI, cloud architecture, and revenue growth with proven track record leading global teams of 500+ professionals delivering measurable business outcomes.'))],
              orelse=[
                If(
                  test=Compare(
                    left=Constant(value='headline'),
                    ops=[
                      In()],
                    comparators=[
                      Call(
                        func=Attribute(
                          value=Name(id='prompt', ctx=Load()),
                          attr='lower',
                          ctx=Load()))]),
                  body=[
                    Return(
                      value=Constant(value='Enterprise AI Leader | Digital Transformation Executive | Revenue Growth Architect'))],
                  orelse=[
                    If(
                      test=BoolOp(
                        op=And(),
                        values=[
                          Compare(
                            left=Constant(value='overview'),
                            ops=[
                              In()],
                            comparators=[
                              Call(
                                func=Attribute(
                                  value=Name(id='prompt', ctx=Load()),
                                  attr='lower',
                                  ctx=Load()))]),
                          Compare(
                            left=Constant(value='unify'),
                            ops=[
                              In()],
                            comparators=[
                              Call(
                                func=Attribute(
                                  value=Name(id='prompt', ctx=Load()),
                                  attr='lower',
                                  ctx=Load()))])]),
                      body=[
                        Return(
                          value=Constant(value='Lead enterprise AI strategy and digital transformation initiatives across Fortune 500 clients, driving $200M+ annual revenue through innovative service delivery and strategic partnerships.'))],
                      orelse=[
                        If(
                          test=BoolOp(
                            op=And(),
                            values=[
                              Compare(
                                left=Constant(value='overview'),
                                ops=[
                                  In()],
                                comparators=[
                                  Call(
                                    func=Attribute(
                                      value=Name(id='prompt', ctx=Load()),
                                      attr='lower',
                                      ctx=Load()))]),
                              Compare(
                                left=Constant(value='ibm'),
                                ops=[
                                  In()],
                                comparators=[
                                  Call(
                                    func=Attribute(
                                      value=Name(id='prompt', ctx=Load()),
                                      attr='lower',
                                      ctx=Load()))])]),
                          body=[
                            Return(
                              value=Constant(value='Led global consulting practice across North America and EMEA, scaling operations from $50M to $220M ARR while maintaining 35%+ operating margins through disciplined growth and operational excellence.'))],
                          orelse=[
                            If(
                              test=BoolOp(
                                op=And(),
                                values=[
                                  Compare(
                                    left=Constant(value='bullets'),
                                    ops=[
                                      In()],
                                    comparators=[
                                      Call(
                                        func=Attribute(
                                          value=Name(id='prompt', ctx=Load()),
                                          attr='lower',
                                          ctx=Load()))]),
                                  Compare(
                                    left=Constant(value='unify'),
                                    ops=[
                                      In()],
                                    comparators=[
                                      Call(
                                        func=Attribute(
                                          value=Name(id='prompt', ctx=Load()),
                                          attr='lower',
                                          ctx=Load()))])]),
                              body=[
                                Return(
                                  value=Constant(value='1. Built AI Center of Excellence from ground up, scaling to 150+ data scientists and engineers delivering $85M ARR within 18 months through systematic capability development\n2. Launched AI-powered analytics platform serving 40+ Fortune 500 clients with 95% satisfaction rate, reducing decision-making time by 60%\n3. Drove $50M cost reduction across client portfolio through ML-driven process automation and intelligent workflow optimization\n4. Established strategic partnerships with Microsoft, Google Cloud, and AWS generating $30M incremental revenue through joint go-to-market programs\n5. Led digital transformation for global pharmaceutical client, migrating 200+ legacy applications to cloud-native architecture\n6. Designed enterprise-wide data governance framework for Fortune 100 financial services client, ensuring GDPR compliance\n7. Developed proprietary NLP solution processing 10M+ documents annually with 92% accuracy in contract analysis'))],
                              orelse=[
                                If(
                                  test=BoolOp(
                                    op=And(),
                                    values=[
                                      Compare(
                                        left=Constant(value='bullets'),
                                        ops=[
                                          In()],
                                        comparators=[
                                          Call(
                                            func=Attribute(
                                              value=Name(id='prompt', ctx=Load()),
                                              attr='lower',
                                              ctx=Load()))]),
                                      Compare(
                                        left=Constant(value='ibm'),
                                        ops=[
                                          In()],
                                        comparators=[
                                          Call(
                                            func=Attribute(
                                              value=Name(id='prompt', ctx=Load()),
                                              attr='lower',
                                              ctx=Load()))])]),
                                  body=[
                                    Return(
                                      value=Constant(value="1. Scaled global professional services practice from $50M to $220M ARR over 4 years, achieving 45% CAGR through strategic account expansion\n2. Built and led high-performing team of 300+ consultants across 8 global delivery centers, reducing attrition to 8%\n3. Secured $120M multi-year engagement with Fortune 50 retailer for enterprise cloud migration\n4. Established IBM's cloud center of excellence, developing repeatable methodologies reducing project delivery time by 35%\n5. Drove strategic M&A integration for PE-backed technology firm, achieving $25M in synergies within 18 months\n6. Led enterprise analytics transformation for global automotive manufacturer, enabling $180M annual inventory cost reduction"))],
                                  orelse=[
                                    If(
                                      test=Compare(
                                        left=Constant(value='competencies'),
                                        ops=[
                                          In()],
                                        comparators=[
                                          Call(
                                            func=Attribute(
                                              value=Name(id='prompt', ctx=Load()),
                                              attr='lower',
                                              ctx=Load()))]),
                                      body=[
                                        Return(
                                          value=Constant(value='1. Enterprise AI Strategy: Defining and executing AI transformation roadmaps across Fortune 500 organizations with measurable ROI\n2. Revenue Growth & P&L Management: Scaling professional services organizations from $50M to $400M+ ARR through disciplined growth\n3. Digital Transformation Leadership: Leading complex transformation programs achieving 40%+ cost reduction and 60%+ efficiency gains\n4. Cloud Architecture & Migration: Architecting large-scale cloud transformations across AWS, Azure, and GCP with zero disruption\n5. Strategic Partnerships & Alliances: Building ecosystem partnerships generating $100M+ incremental revenue through joint programs\n6. Team Leadership & Development: Leading high-performing global teams of 500+ professionals through coaching and mentorship'))],
                                      orelse=[
                                        If(
                                          test=Compare(
                                            left=Constant(value='cover letter'),
                                            ops=[
                                              In()],
                                            comparators=[
                                              Call(
                                                func=Attribute(
                                                  value=Name(id='prompt', ctx=Load()),
                                                  attr='lower',
                                                  ctx=Load()))]),
                                          body=[
                                            Return(
                                              value=Constant(value='October 18, 2025\n\nHiring Manager\nAcme Corp\n123 Business Avenue\n\nDear Hiring Manager,\n\nI am writing to express my strong interest in the Chief AI Officer position at Acme Corp. With over 15 years of experience driving enterprise AI strategy and digital transformation across Fortune 500 organizations, I am confident in my ability to lead your AI initiatives and deliver measurable business outcomes. My track record of scaling professional services organizations from $50M to $400M+ ARR while maintaining operational excellence aligns directly with your requirements for strategic leadership and revenue growth.\n\nAt Unify Consulting, I built an AI Center of Excellence from the ground up, scaling to 150+ data scientists and engineers delivering $85M ARR within 18 months. I launched an AI-powered analytics platform serving 40+ Fortune 500 clients with 95% satisfaction, while driving $50M in cost reduction through ML-driven process automation. My experience establishing strategic partnerships with Microsoft, Google Cloud, and AWS generated $30M in incremental revenue through joint go-to-market programs, demonstrating my ability to build and monetize ecosystem relationships at scale.\n\nI am excited about the opportunity to bring my expertise in enterprise AI, cloud architecture, and revenue growth to Acme Corp. I would welcome the chance to discuss how my background in scaling technology organizations and delivering transformative business outcomes can contribute to your continued success. Thank you for considering my application.\n\nSincerely,\n\nAmit Ayer\namit.ayer@example.com\n(555) 123-4567'))],
