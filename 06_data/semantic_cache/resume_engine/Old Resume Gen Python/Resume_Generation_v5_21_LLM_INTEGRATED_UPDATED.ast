    ClassDef(
      name='JobDescriptionAnalyzer',
      body=[
        Expr(
          value=Constant(value='\n    HOP-0: Complete JD Parser with RAG capabilities.\n    Analyzes job description to extract themes, requirements, and competitive intelligence.\n    ')),
        FunctionDef(
          name='__init__',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='master_resume',
                annotation=Name(id='Dict', ctx=Load()))]),
          body=[
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='master_resume',
                  ctx=Store())],
              value=Name(id='master_resume', ctx=Load()))]),
        FunctionDef(
          name='analyze',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='job_description',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Analyze job description and return comprehensive thematic analysis.\n        \n        In production, this would:\n        1. Parse JD using NLP\n        2. Retrieve peer JDs from database\n        3. Extract competitive differentiators\n        4. Calculate signal quality scores\n        \n        For now, returns structured mock analysis that matches real system output.\n        ')),
            Assign(
              targets=[
                Name(id='competitive_intel', ctx=Store())],
              value=Call(
                func=Name(id='CompetitiveIntelligence', ctx=Load()),
                keywords=[
                  keyword(
                    arg='peer_jds_analyzed_count',
                    value=Constant(value=25)),
                  keyword(
                    arg='differentiator_keywords',
                    value=List(
                      elts=[
                        Constant(value='enterprise AI'),
                        Constant(value='digital transformation'),
                        Constant(value='cloud architecture'),
                        Constant(value='P&L management'),
                        Constant(value='strategic partnerships'),
                        Constant(value='Fortune 500'),
