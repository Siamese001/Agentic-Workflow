            func=Name(id='calculate_section_words', ctx=Load()),
            args=[
              Name(id='tailored_section', ctx=Load())])),
        Assign(
          targets=[
            Name(id='min_words', ctx=Store())],
          value=Call(
            func=Name(id='int', ctx=Load()),
            args=[
              BinOp(
                left=Name(id='master_words', ctx=Load()),
                op=Mult(),
                right=BinOp(
                  left=Constant(value=1),
                  op=Sub(),
                  right=Name(id='tolerance', ctx=Load())))])),
        Assign(
          targets=[
            Name(id='max_words', ctx=Store())],
          value=Call(
            func=Name(id='int', ctx=Load()),
            args=[
              BinOp(
                left=Name(id='master_words', ctx=Load()),
