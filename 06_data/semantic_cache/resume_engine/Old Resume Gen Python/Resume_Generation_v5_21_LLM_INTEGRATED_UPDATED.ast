                          value=Call(
                            func=Attribute(
                              value=Name(id='company', ctx=Load()),
                              attr='upper',
                              ctx=Load())),
                          attr='replace',
                          ctx=Load()),
                        args=[
                          Constant(value=' '),
                          Constant(value='_')]),
                      conversion=-1)])),
              keyword(
                arg='passed',
                value=Name(id='passed', ctx=Load())),
              keyword(
                arg='severity',
                value=Attribute(
                  value=Name(id='ValidationSeverity', ctx=Load()),
                  attr='HIGH',
                  ctx=Load())),
