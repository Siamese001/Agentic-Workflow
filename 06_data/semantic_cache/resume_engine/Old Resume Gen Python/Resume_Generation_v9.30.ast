                annotation=Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Name(id='ValidationResult', ctx=Load()),
                  ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Builds Section 5 of the QA report: Word Count Compliance.')),
            Assign(
              targets=[
                Name(id='lines', ctx=Store())],
              value=List(
                elts=[
                  Constant(value=''),
                  Constant(value='5. WORD COUNT COMPLIANCE (Summary)'),
                  Constant(value='')],
                ctx=Load())),
            Assign(
              targets=[
                Name(id='wc_results', ctx=Store())],
              value=ListComp(
                elt=Name(id='vr', ctx=Load()),
                generators=[
                  comprehension(
                    target=Name(id='vr', ctx=Store()),
                    iter=Name(id='validation_results', ctx=Load()),
