                  value=Name(id='self', ctx=Load()),
                  attr='state',
                  ctx=Store())],
              value=Attribute(
                value=Name(id='CircuitState', ctx=Load()),
                attr='CLOSED',
                ctx=Load()))]),
        FunctionDef(
          name='call',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(arg='func')],
            vararg=arg(arg='args'),
            kwarg=arg(arg='kwargs')),
          body=[
            Expr(
              value=Constant(value='Execute function with circuit breaker protection.')),
            If(
              test=Compare(
                left=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='state',
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Attribute(
                    value=Name(id='CircuitState', ctx=Load()),
                    attr='OPEN',
                    ctx=Load())]),
              body=[
                If(
                  test=Compare(
                    left=BinOp(
                      left=Call(
                        func=Attribute(
                          value=Name(id='datetime', ctx=Load()),
                          attr='now',
                          ctx=Load())),
                      op=Sub(),
                      right=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='last_failure_time',
                        ctx=Load())),
                    ops=[
                      Gt()],
                    comparators=[
                      Call(
                        func=Name(id='timedelta', ctx=Load()),
                        keywords=[
