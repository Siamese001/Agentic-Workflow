      body=[
        Expr(
          value=Constant(value='Calculates a numeric intensity score and a qualitative level from reasoning parameters.')),
        Assign(
          targets=[
            Name(id='intensity', ctx=Store())],
          value=BinOp(
            left=BinOp(
