                              func=Name(id='len', ctx=Load()),
                              args=[
                                Name(id='candidate_responses', ctx=Load())]),
                            conversion=-1),
                          Constant(value=' different draft responses to the same prompt. Your job is to analyze all of them for accuracy, consistency, and quality, and then produce one single, synthesized, final answer that represents the best of all drafts.\n\n**ORIGINAL PROMPT (for context):**\n'),
                          FormattedValue(
