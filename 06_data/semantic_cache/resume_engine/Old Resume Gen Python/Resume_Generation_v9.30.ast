                    Name(id='api_params', ctx=Store())],
                  value=Call(
                    func=Name(id='reasoning_config_to_api_params', ctx=Load()),
                    args=[
                      Name(id='reasoning_config', ctx=Load())])),
                Assign(
                  targets=[
                    Name(id='generation_config', ctx=Store())],
