                        Constant(value='fallback_applied'),
                        Constant(value='fallback_reason')],
                      values=[
                        Constant(value='STRONG'),
                        List(ctx=Load()),
                        IfExp(
                          test=UnaryOp(
                            op=Not(),
                            operand=Attribute(
                              value=Name(id='self', ctx=Load()),
                              attr='enable_web_search',
                              ctx=Load())),
                          body=Constant(value=True),
                          orelse=Constant(value=False)),
                        IfExp(
                          test=UnaryOp(
                            op=Not(),
                            operand=Attribute(
                              value=Name(id='self', ctx=Load()),
                              attr='enable_web_search',
                              ctx=Load())),
                          body=Constant(value='Web search disabled'),
                          orelse=Constant(value=None))])),
                  keyword(
                    arg='competitive_intelligence',
                    value=Name(id='competitive_intel', ctx=Load())),
                  keyword(
                    arg='signal_quality_score',
