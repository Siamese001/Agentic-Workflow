                  test=UnaryOp(
                    op=Not(),
                    operand=Name(id='skills_list', ctx=Load())),
                  body=[
                    Return(
                      value=Constant(value='• Error: K.2_Skills list not found in staging buffer.\n• Generation step (HOP-3) may have failed.'))])]),
            If(
              test=BoolOp(
                op=And(),
                values=[
                  Call(
                    func=Name(id='isinstance', ctx=Load()),
                    args=[
                      Name(id='skills_list', ctx=Load()),
                      Name(id='list', ctx=Load())]),
                  Compare(
                    left=Call(
                      func=Name(id='len', ctx=Load()),
                      args=[
                        Name(id='skills_list', ctx=Load())]),
                    ops=[
                      Gt()],
                    comparators=[
                      Constant(value=0)]),
