                    args=[
                      List(
                        elts=[
                          Name(id='text1', ctx=Load()),
                          Name(id='text2', ctx=Load())],
                        ctx=Load())])),
                Return(
                  value=Subscript(
                    value=Subscript(
                      value=Call(
                        func=Name(id='cosine_similarity', ctx=Load()),
                        args=[
                          Subscript(
                            value=Name(id='tfidf_matrix', ctx=Load()),
                            slice=Slice(
                              lower=Constant(value=0),
                              upper=Constant(value=1)),
                            ctx=Load()),
                          Subscript(
                            value=Name(id='tfidf_matrix', ctx=Load()),
                            slice=Slice(
                              lower=Constant(value=1),
                              upper=Constant(value=2)),
                            ctx=Load())]),
                      slice=Constant(value=0),
                      ctx=Load()),
                    slice=Constant(value=0),
                    ctx=Load()))],
              handlers=[
                ExceptHandler(
                  type=Name(id='Exception', ctx=Load()),
                  body=[
                    Return(
                      value=Constant(value=0.0))])])],
          returns=Name(id='float', ctx=Load())),
        FunctionDef(
          name='_calculate_cosine_similarity',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='text1',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='text2',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Calculate TF-IDF cosine similarity between two texts.\n        Uses scikit-learn if available, otherwise falls back to a basic implementation.\n        ')),
            If(
              test=Name(id='SKLEARN_AVAILABLE', ctx=Load()),
              body=[
                Return(
                  value=Call(
                    func=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='_calculate_cosine_similarity_sklearn',
                      ctx=Load()),
                    args=[
                      Name(id='text1', ctx=Load()),
                      Name(id='text2', ctx=Load())]))],
              orelse=[
                If(
                  test=BoolOp(
                    op=Or(),
                    values=[
                      UnaryOp(
                        op=Not(),
                        operand=Name(id='text1', ctx=Load())),
                      UnaryOp(
                        op=Not(),
                        operand=Name(id='text2', ctx=Load()))]),
                  body=[
                    Return(
                      value=Constant(value=0.0))]),
                Assign(
                  targets=[
                    Name(id='words1', ctx=Store())],
                  value=Call(
                    func=Name(id='set', ctx=Load()),
                    args=[
                      Call(
                        func=Attribute(
                          value=Call(
                            func=Attribute(
                              value=Name(id='text1', ctx=Load()),
                              attr='lower',
                              ctx=Load())),
                          attr='split',
                          ctx=Load()))])),
                Assign(
                  targets=[
                    Name(id='words2', ctx=Store())],
                  value=Call(
                    func=Name(id='set', ctx=Load()),
                    args=[
                      Call(
                        func=Attribute(
                          value=Call(
                            func=Attribute(
                              value=Name(id='text2', ctx=Load()),
                              attr='lower',
                              ctx=Load())),
                          attr='split',
                          ctx=Load()))])),
                If(
                  test=BoolOp(
                    op=Or(),
                    values=[
                      UnaryOp(
                        op=Not(),
                        operand=Name(id='words1', ctx=Load())),
                      UnaryOp(
                        op=Not(),
                        operand=Name(id='words2', ctx=Load()))]),
                  body=[
                    Return(
                      value=Constant(value=0.0))]),
                Assign(
                  targets=[
                    Name(id='intersection', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='words1', ctx=Load()),
                      attr='intersection',
                      ctx=Load()),
                    args=[
                      Name(id='words2', ctx=Load())])),
                If(
                  test=UnaryOp(
                    op=Not(),
                    operand=Name(id='intersection', ctx=Load())),
                  body=[
                    Return(
                      value=Constant(value=0.0))]),
                Assign(
                  targets=[
                    Name(id='numerator', ctx=Store())],
                  value=Call(
                    func=Name(id='len', ctx=Load()),
                    args=[
                      Name(id='intersection', ctx=Load())])),
                Assign(
                  targets=[
                    Name(id='denominator', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='math', ctx=Load()),
                      attr='sqrt',
                      ctx=Load()),
                    args=[
                      BinOp(
                        left=Call(
                          func=Name(id='len', ctx=Load()),
                          args=[
                            Name(id='words1', ctx=Load())]),
                        op=Mult(),
                        right=Call(
                          func=Name(id='len', ctx=Load()),
                          args=[
                            Name(id='words2', ctx=Load())]))])),
                If(
                  test=Compare(
                    left=Name(id='denominator', ctx=Load()),
                    ops=[
                      Eq()],
                    comparators=[
                      Constant(value=0)]),
                  body=[
                    Return(
                      value=Constant(value=0.0))]),
                Return(
                  value=BinOp(
                    left=Name(id='numerator', ctx=Load()),
                    op=Div(),
                    right=Name(id='denominator', ctx=Load())))])],
          returns=Name(id='float', ctx=Load())),
        FunctionDef(
          name='compute_similarity_matrix',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='sections',
                annotation=Subscript(
                  value=Name(id='Dict', ctx=Load()),
                  slice=Tuple(
                    elts=[
                      Name(id='str', ctx=Load()),
                      Subscript(
                        value=Name(id='List', ctx=Load()),
                        slice=Name(id='str', ctx=Load()),
                        ctx=Load())],
                    ctx=Load()),
                  ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Compute 78-check pairwise similarity matrix across all sections.\n        Returns comprehensive matrix with all pairwise comparisons.\n        ')),
            Assign(
              targets=[
                Name(id='matrix_data', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='pairwise_checks'),
                  Constant(value='total_comparisons'),
                  Constant(value='duplicates_found'),
                  Constant(value='max_similarity'),
                  Constant(value='sections_analyzed')],
                values=[
                  List(ctx=Load()),
                  Constant(value=0),
                  List(ctx=Load()),
                  Constant(value=0.0),
                  Call(
                    func=Name(id='list', ctx=Load()),
                    args=[
                      Call(
                        func=Attribute(
                          value=Name(id='sections', ctx=Load()),
                          attr='keys',
                          ctx=Load()))])])),
            Assign(
              targets=[
                Name(id='all_bullets', ctx=Store())],
              value=List(ctx=Load())),
            For(
              target=Tuple(
                elts=[
                  Name(id='section_id', ctx=Store()),
                  Name(id='bullets', ctx=Store())],
                ctx=Store()),
              iter=Call(
                func=Attribute(
                  value=Name(id='sections', ctx=Load()),
                  attr='items',
                  ctx=Load())),
              body=[
                If(
                  test=Call(
                    func=Name(id='isinstance', ctx=Load()),
                    args=[
                      Name(id='bullets', ctx=Load()),
                      Name(id='list', ctx=Load())]),
                  body=[
                    For(
                      target=Tuple(
                        elts=[
                          Name(id='idx', ctx=Store()),
                          Name(id='bullet', ctx=Store())],
                        ctx=Store()),
                      iter=Call(
                        func=Name(id='enumerate', ctx=Load()),
                        args=[
                          Name(id='bullets', ctx=Load())]),
                      body=[
                        If(
                          test=BoolOp(
                            op=And(),
                            values=[
                              Call(
                                func=Name(id='isinstance', ctx=Load()),
                                args=[
                                  Name(id='bullet', ctx=Load()),
                                  Name(id='str', ctx=Load())]),
                              Call(
                                func=Attribute(
                                  value=Name(id='bullet', ctx=Load()),
                                  attr='strip',
                                  ctx=Load()))]),
                          body=[
                            Expr(
                              value=Call(
                                func=Attribute(
                                  value=Name(id='all_bullets', ctx=Load()),
                                  attr='append',
                                  ctx=Load()),
                                args=[
                                  Dict(
                                    keys=[
                                      Constant(value='section'),
                                      Constant(value='index'),
                                      Constant(value='text')],
                                    values=[
                                      Name(id='section_id', ctx=Load()),
                                      Name(id='idx', ctx=Load()),
                                      Call(
                                        func=Attribute(
                                          value=Name(id='bullet', ctx=Load()),
                                          attr='strip',
                                          ctx=Load()))])]))])])])]),
            For(
              target=Name(id='i', ctx=Store()),
              iter=Call(
                func=Name(id='range', ctx=Load()),
                args=[
                  Call(
                    func=Name(id='len', ctx=Load()),
                    args=[
                      Name(id='all_bullets', ctx=Load())])]),
              body=[
                For(
                  target=Name(id='j', ctx=Store()),
                  iter=Call(
                    func=Name(id='range', ctx=Load()),
                    args=[
                      BinOp(
                        left=Name(id='i', ctx=Load()),
                        op=Add(),
                        right=Constant(value=1)),
                      Call(
                        func=Name(id='len', ctx=Load()),
                        args=[
                          Name(id='all_bullets', ctx=Load())])]),
                  body=[
                    Assign(
                      targets=[
                        Name(id='b1', ctx=Store())],
                      value=Subscript(
                        value=Name(id='all_bullets', ctx=Load()),
                        slice=Name(id='i', ctx=Load()),
                        ctx=Load())),
                    Assign(
                      targets=[
                        Name(id='b2', ctx=Store())],
                      value=Subscript(
                        value=Name(id='all_bullets', ctx=Load()),
                        slice=Name(id='j', ctx=Load()),
                        ctx=Load())),
                    Assign(
                      targets=[
                        Name(id='similarity', ctx=Store())],
                      value=Call(
                        func=Attribute(
                          value=Name(id='self', ctx=Load()),
                          attr='_calculate_cosine_similarity',
                          ctx=Load()),
                        args=[
                          Subscript(
                            value=Name(id='b1', ctx=Load()),
                            slice=Constant(value='text'),
                            ctx=Load()),
                          Subscript(
                            value=Name(id='b2', ctx=Load()),
                            slice=Constant(value='text'),
                            ctx=Load())])),
                    Assign(
                      targets=[
                        Name(id='comparison', ctx=Store())],
                      value=Dict(
                        keys=[
                          Constant(value='bullet_1'),
                          Constant(value='bullet_2'),
                          Constant(value='similarity'),
                          Constant(value='cross_section')],
                        values=[
                          JoinedStr(
                            values=[
                              FormattedValue(
                                value=Subscript(
                                  value=Name(id='b1', ctx=Load()),
                                  slice=Constant(value='section'),
                                  ctx=Load()),
                                conversion=-1),
                              Constant(value='['),
                              FormattedValue(
                                value=Subscript(
                                  value=Name(id='b1', ctx=Load()),
                                  slice=Constant(value='index'),
                                  ctx=Load()),
                                conversion=-1),
                              Constant(value=']')]),
                          JoinedStr(
                            values=[
                              FormattedValue(
                                value=Subscript(
                                  value=Name(id='b2', ctx=Load()),
                                  slice=Constant(value='section'),
                                  ctx=Load()),
                                conversion=-1),
                              Constant(value='['),
                              FormattedValue(
                                value=Subscript(
                                  value=Name(id='b2', ctx=Load()),
                                  slice=Constant(value='index'),
                                  ctx=Load()),
                                conversion=-1),
                              Constant(value=']')]),
                          Call(
                            func=Name(id='round', ctx=Load()),
                            args=[
                              Name(id='similarity', ctx=Load()),
                              Constant(value=4)]),
                          Compare(
                            left=Subscript(
                              value=Name(id='b1', ctx=Load()),
                              slice=Constant(value='section'),
                              ctx=Load()),
                            ops=[
                              NotEq()],
                            comparators=[
                              Subscript(
                                value=Name(id='b2', ctx=Load()),
                                slice=Constant(value='section'),
                                ctx=Load())])])),
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Subscript(
                            value=Name(id='matrix_data', ctx=Load()),
                            slice=Constant(value='pairwise_checks'),
                            ctx=Load()),
                          attr='append',
                          ctx=Load()),
                        args=[
                          Name(id='comparison', ctx=Load())])),
                    AugAssign(
                      target=Subscript(
                        value=Name(id='matrix_data', ctx=Load()),
                        slice=Constant(value='total_comparisons'),
                        ctx=Store()),
                      op=Add(),
                      value=Constant(value=1)),
                    Assign(
                      targets=[
                        Subscript(
                          value=Name(id='matrix_data', ctx=Load()),
                          slice=Constant(value='max_similarity'),
                          ctx=Store())],
                      value=Call(
                        func=Name(id='max', ctx=Load()),
                        args=[
                          Subscript(
                            value=Name(id='matrix_data', ctx=Load()),
                            slice=Constant(value='max_similarity'),
                            ctx=Load()),
                          Name(id='similarity', ctx=Load())])),
                    If(
                      test=Compare(
                        left=Name(id='similarity', ctx=Load()),
                        ops=[
                          GtE()],
                        comparators=[
                          Constant(value=0.9)]),
                      body=[
                        Expr(
                          value=Call(
                            func=Attribute(
                              value=Subscript(
                                value=Name(id='matrix_data', ctx=Load()),
                                slice=Constant(value='duplicates_found'),
                                ctx=Load()),
                              attr='append',
                              ctx=Load()),
                            args=[
                              Name(id='comparison', ctx=Load())]))])])]),
            Return(
              value=Name(id='matrix_data', ctx=Load()))],
          returns=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='Any', ctx=Load())],
              ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='compute_overview_bullet_similarity',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='overview_text',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='bullets',
                annotation=Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Name(id='str', ctx=Load()),
                  ctx=Load())),
              arg(
                arg='section_id',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Compute cosine similarity between overview and each bullet.\n        Per v1.9.2: K.5B/K.6B must have cosine <0.6 to their bullets.\n        ')),
            Assign(
              targets=[
                Name(id='results', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='section'),
                  Constant(value='overview_length'),
                  Constant(value='bullet_count'),
                  Constant(value='similarities'),
                  Constant(value='max_similarity'),
                  Constant(value='threshold_violations')],
                values=[
                  Name(id='section_id', ctx=Load()),
                  IfExp(
                    test=Name(id='overview_text', ctx=Load()),
                    body=Call(
                      func=Name(id='count_words_clean', ctx=Load()),
                      args=[
                        Name(id='overview_text', ctx=Load())]),
                    orelse=Constant(value=0)),
                  Call(
                    func=Name(id='len', ctx=Load()),
                    args=[
                      Name(id='bullets', ctx=Load())]),
                  List(ctx=Load()),
                  Constant(value=0.0),
                  List(ctx=Load())])),
            If(
              test=BoolOp(
                op=Or(),
                values=[
                  UnaryOp(
                    op=Not(),
                    operand=Name(id='overview_text', ctx=Load())),
                  UnaryOp(
                    op=Not(),
                    operand=Name(id='bullets', ctx=Load()))]),
              body=[
                Return(
                  value=Name(id='results', ctx=Load()))]),
            For(
              target=Tuple(
                elts=[
                  Name(id='idx', ctx=Store()),
                  Name(id='bullet', ctx=Store())],
                ctx=Store()),
              iter=Call(
                func=Name(id='enumerate', ctx=Load()),
                args=[
                  Name(id='bullets', ctx=Load())]),
              body=[
                If(
                  test=BoolOp(
                    op=And(),
                    values=[
                      Call(
                        func=Name(id='isinstance', ctx=Load()),
                        args=[
                          Name(id='bullet', ctx=Load()),
                          Name(id='str', ctx=Load())]),
                      Call(
                        func=Attribute(
                          value=Name(id='bullet', ctx=Load()),
                          attr='strip',
                          ctx=Load()))]),
                  body=[
                    Assign(
                      targets=[
                        Name(id='similarity', ctx=Store())],
                      value=Call(
                        func=Attribute(
                          value=Name(id='self', ctx=Load()),
                          attr='_calculate_cosine_similarity',
                          ctx=Load()),
                        args=[
                          Name(id='overview_text', ctx=Load()),
                          Call(
                            func=Attribute(
                              value=Name(id='bullet', ctx=Load()),
                              attr='strip',
                              ctx=Load()))])),
                    Assign(
                      targets=[
                        Name(id='sim_data', ctx=Store())],
                      value=Dict(
                        keys=[
                          Constant(value='bullet_index'),
                          Constant(value='similarity'),
                          Constant(value='passes_threshold')],
                        values=[
                          Name(id='idx', ctx=Load()),
                          Call(
                            func=Name(id='round', ctx=Load()),
                            args=[
                              Name(id='similarity', ctx=Load()),
                              Constant(value=4)]),
                          Compare(
                            left=Name(id='similarity', ctx=Load()),
                            ops=[
                              Lt()],
                            comparators=[
                              Constant(value=0.6)])])),
                    Expr(
                      value=Call(
