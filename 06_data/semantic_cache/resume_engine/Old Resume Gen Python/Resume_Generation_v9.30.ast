                      value=Constant(value='\n\n'),
                      attr='join',
                      ctx=Load()),
                    args=[
                      Name(id='skills_list', ctx=Load())]))],
              orelse=[
                For(
                  target=Name(id='skill', ctx=Store()),
                  iter=Name(id='skills_list', ctx=Load()),
                  body=[
                    If(
                      test=Call(
                        func=Name(id='isinstance', ctx=Load()),
