                        ops=[
                          GtE()],
                        comparators=[
                          Name(id='threshold', ctx=Load())]),
                      body=[
                        Expr(
                          value=Call(
                            func=Attribute(
                              value=Name(id='duplicates', ctx=Load()),
                              attr='append',
                              ctx=Load()),
                            args=[
                              Tuple(
                                elts=[
                                  Name(id='i', ctx=Load()),
                                  Name(id='j', ctx=Load()),
                                  Name(id='similarity', ctx=Load())],
                                ctx=Load())]))])])]),
            Return(
              value=Name(id='duplicates', ctx=Load()))],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Subscript(
