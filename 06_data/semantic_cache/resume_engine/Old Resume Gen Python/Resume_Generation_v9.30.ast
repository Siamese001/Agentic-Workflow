                        op=Or(),
                        values=[
                          Call(
                            func=Attribute(
                              value=Attribute(
                                value=Name(id='vr', ctx=Load()),
                                attr='details',
                                ctx=Load()),
                              attr='get',
                              ctx=Load()),
                            args=[
