                    func=Name(id='enhance_system_prompt_with_reasoning', ctx=Load()),
                    args=[
                      Name(id='system_prompt', ctx=Load()),
                      Name(id='reasoning_config', ctx=Load()),
                      Name(id='section_id', ctx=Load())])),
                If(
                  test=Compare(
