            Assign(
              targets=[
                Name(id='rows', ctx=Store())],
              value=List(ctx=Load())),
            Assign(
              targets=[
                Name(id='rule_map', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='VG_TOTAL_WORD_COUNT'),
                  Constant(value='VG_WORD_COUNT_K1')],
                values=[
                  Tuple(
                    elts=[
                      Constant(value='Total Resume'),
                      JoinedStr(
                        values=[
                          FormattedValue(
                            value=Attribute(
                              value=Name(id='PreFlightValidator', ctx=Load()),
                              attr='WORD_COUNT_MIN',
                              ctx=Load()),
                            conversion=-1),
                          Constant(value='-'),
                          FormattedValue(
                            value=Attribute(
                              value=Name(id='PreFlightValidator', ctx=Load()),
                              attr='WORD_COUNT_MAX',
                              ctx=Load()),
                            conversion=-1)])],
                    ctx=Load()),
                  Tuple(
                    elts=[
                      Constant(value='K.1 Exec Summary'),
                      Constant(value='110-150')],
                    ctx=Load())])),
            For(
              target=Name(id='vr', ctx=Store()),
              iter=Name(id='wc_results', ctx=Load()),
              body=[
                If(
                  test=Compare(
                    left=Attribute(
                      value=Name(id='vr', ctx=Load()),
