                                func=Attribute(
                                  value=Name(id='skill', ctx=Load()),
                                  attr='split',
                                  ctx=Load()))])),
                        If(
                          test=Compare(
                            left=Constant(value=1),
                            ops=[
                              LtE(),
                              LtE()],
                            comparators=[
                              Name(id='word_count', ctx=Load()),
                              Constant(value=3)]),
                          body=[
                            Expr(
                              value=Call(
                                func=Attribute(
                                  value=Name(id='output_lines', ctx=Load()),
                                  attr='append',
