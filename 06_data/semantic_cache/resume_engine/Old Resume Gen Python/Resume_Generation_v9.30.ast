    FunctionDef(
      name='count_words_clean',
      args=arguments(
        args=[
          arg(
            arg='text',
            annotation=Name(id='str', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Helper to count words in a clean way, ignoring punctuation.\n    This is more accurate than a simple .split() as it handles cases like\n    "word." and standalone "--" which would otherwise be miscounted.\n    ')),
        If(
          test=UnaryOp(
            op=Not(),
            operand=Name(id='text', ctx=Load())),
          body=[
            Return(
              value=Constant(value=0))]),
        Return(
          value=Call(
            func=Name(id='len', ctx=Load()),
            args=[
              Call(
                func=Attribute(
                  value=Name(id='re', ctx=Load()),
                  attr='findall',
                  ctx=Load()),
                args=[
                  Constant(value='\\b\\w+\\b'),
                  Name(id='text', ctx=Load())])]))],
      returns=Name(id='int', ctx=Load())),
    FunctionDef(
      name='_count_sentences',
      args=arguments(
        args=[
          arg(
            arg='text',
            annotation=Name(id='str', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Helper to count sentences using a regex that handles common abbreviations.\n    It looks for sentence-ending punctuation (.!?) that is not preceded by\n    a known abbreviation (like Dr., Mr., e.g., i.e., etc.).\n    ')),
        If(
          test=UnaryOp(
            op=Not(),
            operand=Name(id='text', ctx=Load())),
          body=[
            Return(
              value=Constant(value=0))]),
        Return(
          value=Call(
            func=Name(id='len', ctx=Load()),
            args=[
              Call(
                func=Attribute(
                  value=Name(id='re', ctx=Load()),
                  attr='findall',
                  ctx=Load()),
                args=[
                  Constant(value='(?<!\\b(?:[Dd]r|[Mm]r|[Mm]rs|[Mm]s|[Jj]r|[Ss]r|vs|e\\.g|i\\.e))\\.(?!\\d)|[.!?]\\s'),
                  BinOp(
                    left=Name(id='text', ctx=Load()),
                    op=Add(),
                    right=Constant(value=' '))])]))],
      returns=Name(id='int', ctx=Load())),
