                      body=Constant(value='LOCAL_NLP'),
                      orelse=Constant(value='HYBRID'))),
                  keyword(
                    arg='retrieval_sources',
                    value=List(
                      elts=[
                        Call(
                          func=Name(id='RetrievalSource', ctx=Load()),
                          args=[
                            Constant(value='JD_ANALYSIS'),
                            Constant(value='NLP_Keyword_Extraction'),
                            Constant(value=1.0),
                            Constant(value='LOCAL_FALLBACK'),
                            Constant(value='LOCAL_NLP')])],
                      ctx=Load()))]))],
          returns=Constant(value='ThematicAnalysis')),
        FunctionDef(
          name='_extract_keywords',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='text',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Extract keywords with frequency counts.')),
            Assign(
              targets=[
                Name(id='text_lower', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='text', ctx=Load()),
                  attr='lower',
                  ctx=Load()))),
            Assign(
              targets=[
                Name(id='words', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='re', ctx=Load()),
                  attr='findall',
                  ctx=Load()),
                args=[
                  Constant(value='\\b[a-z]{3,}\\b'),
                  Name(id='text_lower', ctx=Load())])),
            Assign(
              targets=[
                Name(id='keyword_freq', ctx=Store())],
              value=Dict()),
            For(
              target=Name(id='word', ctx=Store()),
              iter=Name(id='words', ctx=Load()),
              body=[
                If(
                  test=BoolOp(
                    op=And(),
                    values=[
                      Compare(
                        left=Name(id='word', ctx=Load()),
                        ops=[
                          NotIn()],
                        comparators=[
                          Attribute(
                            value=Name(id='self', ctx=Load()),
                            attr='stopwords',
                            ctx=Load())]),
                      Compare(
                        left=Call(
                          func=Name(id='len', ctx=Load()),
                          args=[
                            Name(id='word', ctx=Load())]),
                        ops=[
                          GtE()],
                        comparators=[
                          Constant(value=3)])]),
                  body=[
                    Assign(
                      targets=[
                        Subscript(
                          value=Name(id='keyword_freq', ctx=Load()),
                          slice=Name(id='word', ctx=Load()),
                          ctx=Store())],
                      value=BinOp(
                        left=Call(
                          func=Attribute(
                            value=Name(id='keyword_freq', ctx=Load()),
                            attr='get',
                            ctx=Load()),
                          args=[
                            Name(id='word', ctx=Load()),
                            Constant(value=0)]),
                        op=Add(),
                        right=Constant(value=1)))])]),
            For(
              target=Tuple(
                elts=[
                  Name(id='domain', ctx=Store()),
                  Name(id='terms', ctx=Store())],
                ctx=Store()),
              iter=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='domain_themes',
                    ctx=Load()),
                  attr='items',
                  ctx=Load())),
              body=[
                For(
                  target=Name(id='term', ctx=Store()),
                  iter=Name(id='terms', ctx=Load()),
                  body=[
                    If(
                      test=BoolOp(
                        op=And(),
                        values=[
                          Compare(
                            left=Name(id='term', ctx=Load()),
                            ops=[
                              In()],
                            comparators=[
                              Name(id='text_lower', ctx=Load())]),
                          Compare(
                            left=Call(
                              func=Name(id='len', ctx=Load()),
                              args=[
                                Call(
                                  func=Attribute(
                                    value=Name(id='term', ctx=Load()),
                                    attr='split',
                                    ctx=Load()))]),
                            ops=[
                              Gt()],
                            comparators=[
                              Constant(value=1)])]),
                      body=[
                        Assign(
                          targets=[
                            Subscript(
                              value=Name(id='keyword_freq', ctx=Load()),
                              slice=Name(id='term', ctx=Load()),
                              ctx=Store())],
                          value=BinOp(
                            left=Call(
                              func=Attribute(
                                value=Name(id='text_lower', ctx=Load()),
                                attr='count',
                                ctx=Load()),
                              args=[
                                Name(id='term', ctx=Load())]),
                            op=Mult(),
                            right=Constant(value=2)))])])]),
            Return(
              value=Name(id='keyword_freq', ctx=Load()))],
          returns=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='int', ctx=Load())],
              ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='_calculate_theme_scores',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='keywords',
                annotation=Subscript(
                  value=Name(id='Dict', ctx=Load()),
                  slice=Tuple(
                    elts=[
                      Name(id='str', ctx=Load()),
                      Name(id='int', ctx=Load())],
                    ctx=Load()),
                  ctx=Load())),
              arg(
                arg='jd_text',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Calculate relevance scores for each theme.')),
            Assign(
              targets=[
                Name(id='theme_scores', ctx=Store())],
              value=Dict()),
            Assign(
              targets=[
                Name(id='jd_lower', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='jd_text', ctx=Load()),
                  attr='lower',
                  ctx=Load()))),
            For(
              target=Tuple(
                elts=[
                  Name(id='theme_name', ctx=Store()),
                  Name(id='theme_keywords', ctx=Store())],
                ctx=Store()),
              iter=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='domain_themes',
                    ctx=Load()),
                  attr='items',
                  ctx=Load())),
              body=[
                Assign(
                  targets=[
                    Name(id='score', ctx=Store())],
                  value=Constant(value=0.0)),
                Assign(
                  targets=[
                    Name(id='matched_keywords', ctx=Store())],
                  value=List(ctx=Load())),
                For(
                  target=Name(id='keyword', ctx=Store()),
                  iter=Name(id='theme_keywords', ctx=Load()),
                  body=[
                    If(
                      test=Compare(
                        left=Name(id='keyword', ctx=Load()),
                        ops=[
                          In()],
                        comparators=[
                          Name(id='jd_lower', ctx=Load())]),
                      body=[
                        Assign(
                          targets=[
                            Name(id='occurrences', ctx=Store())],
                          value=Call(
                            func=Attribute(
                              value=Name(id='jd_lower', ctx=Load()),
                              attr='count',
                              ctx=Load()),
                            args=[
                              Name(id='keyword', ctx=Load())])),
                        Assign(
                          targets=[
                            Name(id='importance', ctx=Store())],
                          value=Call(
                            func=Name(id='len', ctx=Load()),
                            args=[
                              Call(
                                func=Attribute(
                                  value=Name(id='keyword', ctx=Load()),
                                  attr='split',
                                  ctx=Load()))])),
                        AugAssign(
                          target=Name(id='score', ctx=Store()),
                          op=Add(),
                          value=BinOp(
                            left=Name(id='occurrences', ctx=Load()),
                            op=Mult(),
                            right=BinOp(
                              left=Constant(value=1.0),
                              op=Add(),
                              right=BinOp(
                                left=Name(id='importance', ctx=Load()),
                                op=Mult(),
                                right=Constant(value=0.5))))),
                        Expr(
                          value=Call(
                            func=Attribute(
                              value=Name(id='matched_keywords', ctx=Load()),
                              attr='append',
                              ctx=Load()),
                            args=[
                              Name(id='keyword', ctx=Load())]))])]),
                If(
                  test=Compare(
                    left=Name(id='score', ctx=Load()),
                    ops=[
                      Gt()],
                    comparators=[
                      Constant(value=0)]),
                  body=[
                    Assign(
                      targets=[
                        Name(id='normalized_score', ctx=Store())],
                      value=Call(
                        func=Name(id='min', ctx=Load()),
                        args=[
                          Constant(value=1.0),
                          BinOp(
                            left=Name(id='score', ctx=Load()),
                            op=Div(),
                            right=BinOp(
                              left=Call(
                                func=Name(id='len', ctx=Load()),
                                args=[
                                  Name(id='theme_keywords', ctx=Load())]),
                              op=Mult(),
                              right=Constant(value=0.5)))])),
                    Assign(
                      targets=[
                        Subscript(
                          value=Name(id='theme_scores', ctx=Load()),
                          slice=Name(id='theme_name', ctx=Load()),
                          ctx=Store())],
                      value=Dict(
                        keys=[
                          Constant(value='score'),
                          Constant(value='matched_keywords'),
                          Constant(value='match_count')],
                        values=[
                          Name(id='normalized_score', ctx=Load()),
                          Name(id='matched_keywords', ctx=Load()),
                          Call(
                            func=Name(id='len', ctx=Load()),
                            args=[
                              Name(id='matched_keywords', ctx=Load())])]))])]),
            Return(
              value=Name(id='theme_scores', ctx=Load()))],
          returns=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='float', ctx=Load())],
              ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='_generate_primary_theme',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='theme_scores',
                annotation=Subscript(
                  value=Name(id='Dict', ctx=Load()),
                  slice=Tuple(
                    elts=[
                      Name(id='str', ctx=Load()),
                      Name(id='dict', ctx=Load())],
                    ctx=Load()),
                  ctx=Load())),
              arg(
                arg='keywords',
                annotation=Subscript(
                  value=Name(id='Dict', ctx=Load()),
                  slice=Tuple(
                    elts=[
                      Name(id='str', ctx=Load()),
                      Name(id='int', ctx=Load())],
                    ctx=Load()),
                  ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Generate primary theme from highest scoring domain.')),
            If(
              test=UnaryOp(
                op=Not(),
                operand=Name(id='theme_scores', ctx=Load())),
              body=[
                Return(
                  value=Dict(
                    keys=[
                      Constant(value='name'),
                      Constant(value='confidence'),
                      Constant(value='keywords'),
                      Constant(value='market_signal')],
                    values=[
                      Constant(value='Professional Services'),
                      Constant(value=0.5),
                      Subscript(
                        value=Call(
                          func=Name(id='list', ctx=Load()),
                          args=[
                            Call(
                              func=Attribute(
                                value=Name(id='keywords', ctx=Load()),
                                attr='keys',
                                ctx=Load()))]),
                        slice=Slice(
                          upper=Constant(value=5)),
                        ctx=Load()),
                      Constant(value='MODERATE')]))]),
            Assign(
              targets=[
                Name(id='best_theme', ctx=Store())],
              value=Call(
                func=Name(id='max', ctx=Load()),
                args=[
                  Call(
                    func=Attribute(
                      value=Name(id='theme_scores', ctx=Load()),
                      attr='items',
                      ctx=Load()))],
                keywords=[
                  keyword(
                    arg='key',
                    value=Lambda(
                      args=arguments(
                        args=[
                          arg(arg='x')]),
                      body=Subscript(
                        value=Subscript(
                          value=Name(id='x', ctx=Load()),
                          slice=Constant(value=1),
