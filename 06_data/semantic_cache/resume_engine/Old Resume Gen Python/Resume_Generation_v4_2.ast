    ClassDef(
      name='BulletWordCountValidator',
      body=[
        Expr(
          value=Constant(value='Validate bullets against word count targets and signal preservation.')),
        FunctionDef(
          name='count_words',
          args=arguments(
            args=[
              arg(
                arg='text',
                annotation=Name(id='str', ctx=Load()))]),
