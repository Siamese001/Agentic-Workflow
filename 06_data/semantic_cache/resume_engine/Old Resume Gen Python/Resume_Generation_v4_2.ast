        FunctionDef(
          name='_calculate_ratio_penalty',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='unify_words',
                annotation=Name(id='int', ctx=Load())),
              arg(
                arg='ibm_words',
                annotation=Name(id='int', ctx=Load())),
              arg(
                arg='ratio_config',
                annotation=Name(id='Dict', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Calculate penalty for Unify/IBM ratio outside soft band (OPT 4).\n        \n        Ideal: 1.25 (no penalty)\n        Acceptable: 1.15–1.35 (−5 per 0.05 deviation)\n        Fail: <1.1 or >1.4\n        ')),
            If(
              test=Compare(
                left=Name(id='ibm_words', ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value=0)]),
              body=[
                Return(
                  value=UnaryOp(
                    op=USub(),
                    operand=Constant(value=100)))]),
            Assign(
              targets=[
                Name(id='ratio', ctx=Store())],
              value=BinOp(
                left=Name(id='unify_words', ctx=Load()),
                op=Div(),
                right=Name(id='ibm_words', ctx=Load()))),
            Assign(
              targets=[
                Name(id='ideal', ctx=Store())],
              value=Subscript(
                value=Name(id='ratio_config', ctx=Load()),
                slice=Constant(value='ideal_midpoint'),
                ctx=Load())),
            Assign(
              targets=[
                Name(id='acceptable_band', ctx=Store())],
              value=Subscript(
                value=Name(id='ratio_config', ctx=Load()),
                slice=Constant(value='acceptable_band'),
                ctx=Load())),
            Assign(
              targets=[
                Name(id='fail_band', ctx=Store())],
              value=Subscript(
                value=Name(id='ratio_config', ctx=Load()),
                slice=Constant(value='fail_band'),
                ctx=Load())),
            If(
              test=BoolOp(
                op=Or(),
                values=[
                  Compare(
                    left=Name(id='ratio', ctx=Load()),
                    ops=[
                      Lt()],
                    comparators=[
                      Subscript(
                        value=Name(id='fail_band', ctx=Load()),
                        slice=Constant(value=0),
                        ctx=Load())]),
                  Compare(
                    left=Name(id='ratio', ctx=Load()),
                    ops=[
                      Gt()],
                    comparators=[
                      Subscript(
                        value=Name(id='fail_band', ctx=Load()),
                        slice=Constant(value=1),
                        ctx=Load())])]),
              body=[
                Return(
                  value=UnaryOp(
                    op=USub(),
                    operand=Constant(value=0.05)))]),
            If(
              test=Compare(
                left=Subscript(
                  value=Name(id='acceptable_band', ctx=Load()),
                  slice=Constant(value=0),
                  ctx=Load()),
                ops=[
                  LtE(),
                  LtE()],
                comparators=[
                  Name(id='ratio', ctx=Load()),
                  Subscript(
                    value=Name(id='acceptable_band', ctx=Load()),
                    slice=Constant(value=1),
                    ctx=Load())]),
              body=[
                If(
                  test=Compare(
                    left=Name(id='ratio', ctx=Load()),
                    ops=[
                      Lt()],
                    comparators=[
                      Name(id='ideal', ctx=Load())]),
                  body=[
                    Assign(
                      targets=[
                        Name(id='deviation', ctx=Store())],
                      value=BinOp(
                        left=BinOp(
                          left=Name(id='ideal', ctx=Load()),
                          op=Sub(),
                          right=Name(id='ratio', ctx=Load())),
                        op=Div(),
                        right=Constant(value=0.05)))],
                  orelse=[
                    Assign(
                      targets=[
                        Name(id='deviation', ctx=Store())],
                      value=BinOp(
                        left=BinOp(
                          left=Name(id='ratio', ctx=Load()),
                          op=Sub(),
                          right=Name(id='ideal', ctx=Load())),
                        op=Div(),
                        right=Constant(value=0.05)))]),
                Assign(
                  targets=[
                    Name(id='penalty', ctx=Store())],
                  value=BinOp(
                    left=UnaryOp(
                      op=USub(),
                      operand=Constant(value=0.005)),
                    op=Mult(),
                    right=Call(
                      func=Name(id='max', ctx=Load()),
                      args=[
                        Constant(value=0),
                        BinOp(
                          left=Name(id='deviation', ctx=Load()),
                          op=Sub(),
                          right=Constant(value=1))]))),
                Return(
                  value=Name(id='penalty', ctx=Load()))]),
            Return(
              value=Constant(value=0.0))],
          returns=Name(id='float', ctx=Load())),
