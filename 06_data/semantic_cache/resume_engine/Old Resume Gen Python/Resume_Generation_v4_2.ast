                  LtE(),
                  LtE()],
                comparators=[
                  Name(id='word_count', ctx=Load()),
                  Name(id='upper', ctx=Load())]))],
          returns=Name(id='bool', ctx=Load()))],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='SignalElasticityModel',
      body=[
        Expr(
          value=Constant(value='Signal-to-word-count elasticity: words drive signal up to cap.')),
        AnnAssign(
          target=Name(id='baseline_signal', ctx=Store()),
          annotation=Name(id='float', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='baseline_words', ctx=Store()),
          annotation=Name(id='int', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='elasticity_multiplier', ctx=Store()),
          annotation=Name(id='float', ctx=Load()),
          value=Constant(value=0.15),
          simple=1),
        AnnAssign(
          target=Name(id='signal_ceiling', ctx=Store()),
          annotation=Name(id='float', ctx=Load()),
          value=Constant(value=1.0),
          simple=1),
        AnnAssign(
          target=Name(id='signal_floor', ctx=Store()),
          annotation=Name(id='float', ctx=Load()),
          value=Constant(value=0.0),
          simple=1),
        FunctionDef(
          name='calculate_elasticity_multiplier',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='current_words',
                annotation=Name(id='int', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Calculate elasticity multiplier based on words vs baseline.\n        \n        If Unify at baseline (203): multiplier = 1.0, signal = 0.74\n        If Unify at +20 words (223): multiplier = 1.03, signal = 0.762 (+2.9%)\n        If Unify at -20 words (183): multiplier = 0.97, signal = 0.718 (-3.0%)\n        ')),
            If(
              test=Compare(
                left=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='baseline_words',
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value=0)]),
              body=[
                Return(
                  value=Constant(value=1.0))]),
            Assign(
              targets=[
                Name(id='pct_change', ctx=Store())],
              value=BinOp(
                left=BinOp(
                  left=Name(id='current_words', ctx=Load()),
                  op=Sub(),
                  right=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='baseline_words',
                    ctx=Load())),
                op=Div(),
                right=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='baseline_words',
                  ctx=Load()))),
            Assign(
              targets=[
                Name(id='multiplier', ctx=Store())],
              value=BinOp(
                left=Constant(value=1.0),
                op=Add(),
                right=BinOp(
                  left=Name(id='pct_change', ctx=Load()),
                  op=Mult(),
                  right=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='elasticity_multiplier',
                    ctx=Load())))),
            Assign(
              targets=[
                Name(id='multiplier', ctx=Store())],
              value=Call(
                func=Name(id='max', ctx=Load()),
                args=[
                  Constant(value=0.85),
                  Call(
                    func=Name(id='min', ctx=Load()),
                    args=[
                      Constant(value=1.15),
                      Name(id='multiplier', ctx=Load())])])),
            Return(
              value=Name(id='multiplier', ctx=Load()))],
          returns=Name(id='float', ctx=Load())),
        FunctionDef(
          name='calculate_signal',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='current_words',
                annotation=Name(id='int', ctx=Load())),
              arg(
                arg='temperature_bonus',
                annotation=Name(id='float', ctx=Load()))],
            defaults=[
              Constant(value=0.0)]),
          body=[
            Expr(
              value=Constant(value='Calculate signal based on elasticity curve + temperature bonus.')),
            Assign(
              targets=[
                Name(id='multiplier', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='calculate_elasticity_multiplier',
                  ctx=Load()),
                args=[
                  Name(id='current_words', ctx=Load())])),
            Assign(
              targets=[
                Name(id='signal', ctx=Store())],
              value=BinOp(
                left=BinOp(
                  left=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='baseline_signal',
                    ctx=Load()),
                  op=Mult(),
                  right=Name(id='multiplier', ctx=Load())),
                op=Add(),
                right=Name(id='temperature_bonus', ctx=Load()))),
            Assign(
              targets=[
                Name(id='signal', ctx=Store())],
              value=Call(
                func=Name(id='max', ctx=Load()),
                args=[
                  Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='signal_floor',
                    ctx=Load()),
                  Call(
                    func=Name(id='min', ctx=Load()),
                    args=[
                      Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='signal_ceiling',
                        ctx=Load()),
                      Name(id='signal', ctx=Load())])])),
            Return(
              value=Name(id='signal', ctx=Load()))],
          returns=Name(id='float', ctx=Load()))],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='SectionCoherenceScorer',
      body=[
        Expr(
          value=Constant(value='Penalize outlier sections based on coefficient of variation.')),
        AnnAssign(
          target=Name(id='baseline_lengths', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='int', ctx=Load())],
              ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='cv_target', ctx=Store()),
          annotation=Name(id='float', ctx=Load()),
          value=Constant(value=0.18),
          simple=1),
        AnnAssign(
          target=Name(id='cv_penalty', ctx=Store()),
          annotation=Name(id='float', ctx=Load()),
          value=UnaryOp(
            op=USub(),
            operand=Constant(value=0.02)),
          simple=1),
        FunctionDef(
          name='calculate_cv',
