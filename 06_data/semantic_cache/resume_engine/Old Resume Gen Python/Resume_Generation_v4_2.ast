                        ctx=Load())))])),
            Assign(
              targets=[
                Name(id='upper', ctx=Store())],
              value=Call(
                func=Name(id='int', ctx=Load()),
                args=[
                  BinOp(
                    left=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='baseline_words',
                      ctx=Load()),
                    op=Mult(),
                    right=BinOp(
                      left=Constant(value=1),
                      op=Add(),
                      right=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='tolerance_pct',
                        ctx=Load())))])),
            Return(
              value=Tuple(
                elts=[
                  Name(id='lower', ctx=Load()),
                  Name(id='upper', ctx=Load())],
                ctx=Load()))],
          returns=Subscript(
