              value=Call(
                func=Name(id='int', ctx=Load()),
                args=[
                  BinOp(
                    left=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='baseline_words',
                      ctx=Load()),
                    op=Mult(),
                    right=BinOp(
