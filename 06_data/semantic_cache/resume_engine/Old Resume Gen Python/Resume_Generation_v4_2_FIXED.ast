Module(
  body=[
    Expr(
      value=Constant(value='\nResume Generation Engine v4.2 - FIXED: JD PARSING + EXEC SUMMARY + MASTER RESUME SOURCING\n============================================================================================\n\nFIXES FROM v4.1:\n✓ FIX 1: Now parses JD to extract key requirements\n✓ FIX 2: Generates executive summary from JD + candidate profile\n✓ FIX 3: Properly sources bullets from MasterResume.EXPERIENCE\n✓ FIX 4: Maps JD keywords to resume sections (skill-to-section matching)\n✓ FIX 5: Customizes headline based on JD role\n\nMAINTAINS ALL v4.1 FEATURES:\n✓ 8 Optimizations (Per-section tolerance, elasticity, priority allocation, etc.)\n✓ 5 v4.1 Fixes (QA gates, penalties, temperature modes)\n✓ 6 QA Validation Gates (Signal Health, Tolerance Bands, Elasticity, Production Ready, Metrics, Coherence)\n\nPRODUCES 6 HIGH-SIGNAL OUTPUTS (NEW: Executive Summary):\n1. Executive Summary (1 sentence JD-matched value prop)\n2. Complete Resume (formatted, customized for role)\n3. Word Count Table (per-section tolerance bands, delta analysis)\n4. Signal Calibration (role-specific, elasticity & temperature mode)\n5. QA Validation Tables (6 gates: ENFORCED)\n6. Optimization Report (elasticity, priority allocation, coherence analysis)\n\nArchitecture: 9-HOP execution engine with JD parsing + exec summary generation\nAuthor: Resume Generation Team (v4.2 fixes)\nVersion: 4.2.0-JD-PARSING-EXEC-SUMMARY\nDate: October 17, 2025\n')),
    Import(
      names=[
        alias(name='re')]),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Dict'),
        alias(name='List'),
        alias(name='Tuple'),
        alias(name='Optional')],
      level=0),
    ImportFrom(
      module='dataclasses',
      names=[
        alias(name='dataclass')],
      level=0),
    ImportFrom(
      module='datetime',
      names=[
        alias(name='datetime')],
      level=0),
    ImportFrom(
      module='enum',
      names=[
        alias(name='Enum')],
      level=0),
    Import(
      names=[
        alias(name='math')]),
    Assign(
      targets=[
        Name(id='__version__', ctx=Store())],
      value=Constant(value='4.2.0-JD-PARSING-EXEC-SUMMARY')),
    ClassDef(
      name='JDParser',
      body=[
        Expr(
          value=Constant(value='Extract key requirements and keywords from job description.')),
        FunctionDef(
          name='parse_jd',
          args=arguments(
            args=[
              arg(
                arg='jd_text',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Parse JD to extract role, requirements, and keywords.')),
            Assign(
              targets=[
                Name(id='jd_lower', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='jd_text', ctx=Load()),
                  attr='lower',
                  ctx=Load()))),
            Assign(
              targets=[
                Name(id='years_match', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='re', ctx=Load()),
                  attr='search',
                  ctx=Load()),
                args=[
                  Constant(value='(\\d+)\\+?\\s*years?'),
                  Name(id='jd_text', ctx=Load()),
                  Attribute(
                    value=Name(id='re', ctx=Load()),
                    attr='IGNORECASE',
                    ctx=Load())])),
            Assign(
              targets=[
                Name(id='years_required', ctx=Store())],
              value=IfExp(
                test=Name(id='years_match', ctx=Load()),
                body=Call(
                  func=Name(id='int', ctx=Load()),
                  args=[
                    Call(
                      func=Attribute(
                        value=Name(id='years_match', ctx=Load()),
                        attr='group',
                        ctx=Load()),
                      args=[
                        Constant(value=1)])]),
                orelse=Constant(value=5))),
            Assign(
              targets=[
                Name(id='role_match', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='re', ctx=Load()),
                  attr='search',
                  ctx=Load()),
                args=[
                  Constant(value='(VP|Director|Senior|Lead|Manager)\\s+([A-Za-z\\s&]+?)(?:\\s*[-–,]|\\s*\\()'),
                  Name(id='jd_text', ctx=Load())])),
            Assign(
              targets=[
                Name(id='role_title', ctx=Store())],
              value=IfExp(
                test=Name(id='role_match', ctx=Load()),
                body=Call(
                  func=Attribute(
                    value=Call(
                      func=Attribute(
                        value=Name(id='role_match', ctx=Load()),
                        attr='group',
                        ctx=Load()),
                      args=[
                        Constant(value=2)]),
                    attr='strip',
                    ctx=Load())),
                orelse=Constant(value='Strategic Role'))),
            Assign(
              targets=[
                Name(id='skills', ctx=Store())],
              value=List(ctx=Load())),
            Assign(
              targets=[
                Name(id='domain_keywords', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='pre-sales'),
                  Constant(value='leadership'),
                  Constant(value='saas'),
                  Constant(value='technical'),
                  Constant(value='client-facing')],
                values=[
                  List(
                    elts=[
                      Constant(value='pre-sales'),
                      Constant(value='presales'),
                      Constant(value='solution engineer'),
                      Constant(value='solutions engineer')],
                    ctx=Load()),
                  List(
                    elts=[
                      Constant(value='lead'),
                      Constant(value='manage'),
                      Constant(value='scale'),
                      Constant(value='team'),
                      Constant(value='director'),
                      Constant(value='vp')],
                    ctx=Load()),
                  List(
                    elts=[
                      Constant(value='saas'),
                      Constant(value='software'),
                      Constant(value='enterprise'),
                      Constant(value='cloud')],
                    ctx=Load()),
                  List(
                    elts=[
                      Constant(value='technical'),
                      Constant(value='architecture'),
                      Constant(value='infrastructure'),
                      Constant(value='deployment')],
                    ctx=Load()),
                  List(
                    elts=[
                      Constant(value='client'),
                      Constant(value='customer'),
                      Constant(value='stakeholder'),
                      Constant(value='relationship')],
                    ctx=Load())])),
            For(
              target=Tuple(
                elts=[
                  Name(id='domain', ctx=Store()),
                  Name(id='keywords_list', ctx=Store())],
                ctx=Store()),
              iter=Call(
                func=Attribute(
                  value=Name(id='domain_keywords', ctx=Load()),
                  attr='items',
                  ctx=Load())),
              body=[
                If(
                  test=Call(
                    func=Name(id='any', ctx=Load()),
                    args=[
                      GeneratorExp(
                        elt=Compare(
                          left=Name(id='kw', ctx=Load()),
                          ops=[
                            In()],
                          comparators=[
                            Name(id='jd_lower', ctx=Load())]),
                        generators=[
                          comprehension(
                            target=Name(id='kw', ctx=Store()),
                            iter=Name(id='keywords_list', ctx=Load()),
                            is_async=0)])]),
                  body=[
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Name(id='skills', ctx=Load()),
                          attr='append',
                          ctx=Load()),
                        args=[
                          Name(id='domain', ctx=Load())]))])]),
            Assign(
              targets=[
                Name(id='requirements', ctx=Store())],
              value=List(ctx=Load())),
            Assign(
              targets=[
                Name(id='requirement_patterns', ctx=Store())],
              value=List(
                elts=[
                  Constant(value='(?:required|must have|must|required:)(.*?)(?:\\n|$)'),
                  Constant(value='(?:responsibilities?|key.*?includ|deliverable)(.*?)(?:\\n|$)')],
                ctx=Load())),
            For(
              target=Name(id='pattern', ctx=Store()),
              iter=Name(id='requirement_patterns', ctx=Load()),
              body=[
                Assign(
                  targets=[
                    Name(id='matches', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='re', ctx=Load()),
                      attr='findall',
                      ctx=Load()),
                    args=[
                      Name(id='pattern', ctx=Load()),
                      Name(id='jd_text', ctx=Load()),
                      Attribute(
                        value=Name(id='re', ctx=Load()),
                        attr='IGNORECASE',
                        ctx=Load())])),
                For(
                  target=Name(id='match', ctx=Store()),
                  iter=Name(id='matches', ctx=Load()),
                  body=[
                    Assign(
                      targets=[
                        Name(id='req', ctx=Store())],
                      value=Call(
                        func=Attribute(
                          value=Name(id='match', ctx=Load()),
                          attr='strip',
                          ctx=Load()))),
                    If(
                      test=Compare(
                        left=Call(
                          func=Name(id='len', ctx=Load()),
                          args=[
                            Name(id='req', ctx=Load())]),
                        ops=[
                          Gt()],
                        comparators=[
                          Constant(value=5)]),
                      body=[
                        Expr(
                          value=Call(
                            func=Attribute(
                              value=Name(id='requirements', ctx=Load()),
                              attr='append',
                              ctx=Load()),
                            args=[
                              Subscript(
                                value=Name(id='req', ctx=Load()),
                                slice=Slice(
                                  upper=Constant(value=100)),
                                ctx=Load())]))])])]),
            Return(
              value=Dict(
                keys=[
                  Constant(value='years_required'),
                  Constant(value='role_title'),
                  Constant(value='skills'),
                  Constant(value='requirements'),
                  Constant(value='full_text')],
                values=[
                  Name(id='years_required', ctx=Load()),
                  Name(id='role_title', ctx=Load()),
                  Call(
                    func=Name(id='list', ctx=Load()),
                    args=[
                      Call(
                        func=Name(id='set', ctx=Load()),
                        args=[
                          Name(id='skills', ctx=Load())])]),
                  Subscript(
                    value=Name(id='requirements', ctx=Load()),
                    slice=Slice(
                      upper=Constant(value=5)),
                    ctx=Load()),
                  Name(id='jd_text', ctx=Load())]))],
          decorator_list=[
            Name(id='staticmethod', ctx=Load())],
          returns=Name(id='Dict', ctx=Load()))]),
    ClassDef(
      name='ExecutiveSummaryGenerator',
      body=[
        Expr(
          value=Constant(value='Generate concise exec summary matching JD.')),
        Assign(
          targets=[
            Name(id='CANDIDATE_PROFILE', ctx=Store())],
          value=Dict(
            keys=[
              Constant(value='name'),
              Constant(value='years_exp'),
              Constant(value='key_strength'),
              Constant(value='headline')],
            values=[
              Constant(value='Amit Ayer'),
              Constant(value=13),
              Constant(value='Chief AI Officer with proven track record scaling pre-sales teams and enterprise AI adoption'),
              Constant(value='AI Leader | Pre-Sales Strategy | Enterprise Solution Architecture')])),
        FunctionDef(
          name='generate_exec_summary',
          args=arguments(
            args=[
              arg(
                arg='jd_parsed',
                annotation=Name(id='Dict', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Generate 1-sentence exec summary matching JD to candidate.')),
            Assign(
              targets=[
                Name(id='role_title', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Call(
                    func=Attribute(
                      value=Name(id='jd_parsed', ctx=Load()),
                      attr='get',
                      ctx=Load()),
                    args=[
                      Constant(value='role_title'),
                      Constant(value='Strategic Leadership')]),
                  attr='lower',
                  ctx=Load()))),
            Assign(
              targets=[
                Name(id='years_req', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='jd_parsed', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='years_required'),
                  Constant(value=10)])),
            Assign(
              targets=[
                Name(id='skills', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='jd_parsed', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='skills'),
                  List(ctx=Load())])),
            Assign(
              targets=[
                Name(id='summary_parts', ctx=Store())],
              value=List(ctx=Load())),
            If(
              test=Compare(
                left=Constant(value='pre-sales'),
                ops=[
                  In()],
                comparators=[
                  Name(id='skills', ctx=Load())]),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='summary_parts', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Constant(value='pre-sales strategy & solution delivery')]))]),
            If(
              test=Compare(
                left=Constant(value='leadership'),
                ops=[
                  In()],
                comparators=[
                  Name(id='skills', ctx=Load())]),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='summary_parts', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Constant(value='team scaling & organizational leadership')]))]),
            If(
              test=Compare(
                left=Constant(value='saas'),
                ops=[
                  In()],
                comparators=[
                  Name(id='skills', ctx=Load())]),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='summary_parts', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Constant(value='enterprise SaaS growth')]))]),
            If(
              test=Compare(
                left=Constant(value='technical'),
                ops=[
                  In()],
                comparators=[
                  Name(id='skills', ctx=Load())]),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='summary_parts', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Constant(value='technical architecture')]))]),
            If(
              test=Compare(
                left=Constant(value='client-facing'),
                ops=[
                  In()],
                comparators=[
                  Name(id='skills', ctx=Load())]),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='summary_parts', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Constant(value='strategic customer partnerships')]))]),
            If(
              test=UnaryOp(
                op=Not(),
                operand=Name(id='summary_parts', ctx=Load())),
              body=[
                Assign(
                  targets=[
                    Name(id='summary_parts', ctx=Store())],
                  value=List(
                    elts=[
                      Constant(value='enterprise AI delivery'),
                      Constant(value='team leadership'),
                      Constant(value='strategic growth')],
                    ctx=Load()))]),
            Assign(
              targets=[
                Name(id='expertise', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Constant(value=' | '),
                  attr='join',
                  ctx=Load()),
                args=[
                  Subscript(
                    value=Name(id='summary_parts', ctx=Load()),
                    slice=Slice(
                      upper=Constant(value=3)),
                    ctx=Load())])),
            Assign(
              targets=[
                Name(id='exec_summary', ctx=Store())],
              value=JoinedStr(
                values=[
                  Constant(value='Delivered $100M+ in enterprise transformation through '),
                  FormattedValue(
                    value=Name(id='expertise', ctx=Load()),
                    conversion=-1),
                  Constant(value='; scaled teams 4x, accelerated time-to-production 37%, and drove Fortune 500 adoption at scale.')])),
            Return(
              value=Name(id='exec_summary', ctx=Load()))],
          decorator_list=[
            Name(id='staticmethod', ctx=Load())],
          returns=Name(id='str', ctx=Load()))]),
    ClassDef(
      name='MasterResume',
      body=[
        Expr(
          value=Constant(value="Amit Ayer's complete master resume.")),
        Assign(
          targets=[
            Name(id='CONTACT', ctx=Store())],
          value=Dict(
            keys=[
              Constant(value='name'),
              Constant(value='phone'),
              Constant(value='email'),
              Constant(value='linkedin'),
              Constant(value='location')],
            values=[
              Constant(value='Amit Ayer'),
              Constant(value='+1-917-239-3830'),
              Constant(value='amitayer1@gmail.com'),
              Constant(value='https://www.linkedin.com/in/amitayer1'),
              Constant(value='Boca Raton, FL')])),
        Assign(
          targets=[
            Name(id='EXPERIENCE', ctx=Store())],
          value=Dict(
            keys=[
              Constant(value='unify'),
              Constant(value='ibm'),
              Constant(value='ey'),
              Constant(value='early')],
            values=[
              Dict(
                keys=[
                  Constant(value='company'),
                  Constant(value='title'),
                  Constant(value='dates'),
                  Constant(value='bullets')],
                values=[
                  Constant(value='Unify Consulting'),
                  Constant(value='Chief AI Officer'),
                  Constant(value='February 2023 – Present'),
                  List(
                    elts=[
                      Constant(value='Recruited and scaled senior LLM and ML engineering practice from 5 to 18 members, delivering enterprise AI adoption for Fortune 500 financial clients and accelerating time-to-production by 37% across regulated programs.'),
                      Constant(value='Built and mentored 12-person professional services AI team, equipping delivery leads with production-grade LLM tools and code accelerators that reduced development sprint cycles by 27% and improved overall project delivery velocity.'),
                      Constant(value='Led multi-year strategic partnerships with leading AWS to co-develop platforms and go-to-market programs that scaled enterprise generative AI adoption, secured $18M in partnership revenue, and expanded professional services reach globally.'),
                      Constant(value='Designed and deployed context-engineering frameworks with retrieval-augmented pipelines on unified analytics platforms and semantic caching, improving generative AI accuracy by 33% while accelerating customer solution adoption across multiple Fortune 500 portfolio companies.'),
                      Constant(value='Architected LLM deployment pipelines with embedding stores, vector databases on cloud infrastructure, and inference optimization techniques, cutting latency by 38% and improving model throughput to meet production SLAs for regulated financial workloads.'),
                      Constant(value='Deployed agentic API frameworks using chain-of-thought prompting to automate complex workflows, reducing manual intervention in reporting and operations by 28% while improving audit traceability for regulatory compliance requirements across Fortune 500 clients.'),
                      Constant(value='Built senior engineering teams focused on transformer models and attention mechanisms, delivering low-latency inference optimization on cloud infrastructure and reducing fraud detection response times by 42% across client production deployments.'),
                      Constant(value='Partnered with C-suite executives to align AI strategy with business outcomes, co-developing generative AI products using cloud platforms that generated $32M in measurable client value and operational transformation initiatives across portfolio companies.')],
                    ctx=Load())]),
              Dict(
                keys=[
