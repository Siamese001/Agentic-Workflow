                  Constant(value='dates'),
                  Constant(value='bullets')],
                values=[
                  Constant(value='EY (Ernst & Young)'),
                  Constant(value='Senior Manager, AI & Advanced Analytics'),
                  Constant(value='January 2015 – March 2017'),
                  List(
                    elts=[
                      Constant(value='Led AI strategy and implementation for 12+ Fortune 500 clients, deploying machine learning models for risk prediction, fraud detection, and customer analytics across financial services industry.'),
                      Constant(value='Built and scaled AI consulting practice from 5 to 22 consultants, establishing delivery excellence standards and winning $23M in new client engagements.')],
                    ctx=Load())]),
              Dict(
                keys=[
                  Constant(value='company'),
                  Constant(value='title'),
                  Constant(value='dates'),
                  Constant(value='bullets')],
                values=[
                  Constant(value='Tradersense Analytics'),
                  Constant(value='Co-Founder & Chief Technology Officer'),
                  Constant(value='June 2012 – December 2014'),
                  List(
                    elts=[
                      Constant(value='Architected low-latency data infrastructure and backtesting framework enabling traders to execute strategies 40% faster and reduce infrastructure costs by $800K annually.')],
                    ctx=Load())])])),
        Assign(
          targets=[
            Name(id='EDUCATION', ctx=Store())],
          value=Constant(value='B.S. in Computer Science & Economics | University of Pennsylvania | May 2012'))]),
    ClassDef(
      name='HeadlineCustomizer',
      body=[
        Expr(
          value=Constant(value='Customize headline based on JD and role.')),
        Assign(
          targets=[
            Name(id='HEADLINES', ctx=Store())],
          value=Dict(
            keys=[
              Constant(value='pre-sales'),
              Constant(value='leadership'),
              Constant(value='saas'),
              Constant(value='technical'),
              Constant(value='default')],
            values=[
              Constant(value='Pre-Sales Leader | Enterprise AI | Solution Architecture & Deal Acceleration'),
              Constant(value='Strategic Leader | Team Building | Enterprise Transformation'),
              Constant(value='Enterprise SaaS Executive | Platform Scaling | Strategic Growth'),
              Constant(value='Technical Leader | Architecture & Infrastructure | System Design'),
              Constant(value='Chief AI Officer | Strategic Leadership | Enterprise Growth')])),
        FunctionDef(
          name='customize_headline',
          args=arguments(
            args=[
              arg(
                arg='jd_parsed',
                annotation=Name(id='Dict', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Return headline matching JD skills.')),
            Assign(
              targets=[
                Name(id='skills', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='jd_parsed', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='skills'),
                  List(ctx=Load())])),
            For(
              target=Name(id='skill', ctx=Store()),
              iter=Name(id='skills', ctx=Load()),
              body=[
                If(
                  test=Compare(
                    left=Name(id='skill', ctx=Load()),
                    ops=[
                      In()],
                    comparators=[
                      Attribute(
                        value=Name(id='HeadlineCustomizer', ctx=Load()),
                        attr='HEADLINES',
                        ctx=Load())]),
                  body=[
                    Return(
                      value=Subscript(
                        value=Attribute(
                          value=Name(id='HeadlineCustomizer', ctx=Load()),
                          attr='HEADLINES',
                          ctx=Load()),
                        slice=Name(id='skill', ctx=Load()),
                        ctx=Load()))])]),
            Return(
              value=Subscript(
                value=Attribute(
                  value=Name(id='HeadlineCustomizer', ctx=Load()),
                  attr='HEADLINES',
                  ctx=Load()),
                slice=Constant(value='default'),
                ctx=Load()))],
          decorator_list=[
            Name(id='staticmethod', ctx=Load())],
          returns=Name(id='str', ctx=Load()))]),
    ClassDef(
      name='ResumeFormatter',
      body=[
        Expr(
          value=Constant(value='Build formatted resume from master data.')),
        FunctionDef(
          name='format_resume',
          args=arguments(
            args=[
              arg(
                arg='exec_summary',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='master_resume',
                annotation=Name(id='MasterResume', ctx=Load())),
              arg(
                arg='headline',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='sections_to_include',
                annotation=Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Name(id='str', ctx=Load()),
                  ctx=Load()))],
            defaults=[
              Constant(value=None)]),
          body=[
            Expr(
              value=Constant(value='Format complete resume with all sections.')),
            If(
              test=Compare(
                left=Name(id='sections_to_include', ctx=Load()),
                ops=[
                  Is()],
                comparators=[
                  Constant(value=None)]),
              body=[
                Assign(
                  targets=[
                    Name(id='sections_to_include', ctx=Store())],
                  value=List(
                    elts=[
                      Constant(value='unify'),
                      Constant(value='ibm'),
                      Constant(value='ey'),
                      Constant(value='early')],
                    ctx=Load()))]),
            Assign(
              targets=[
                Name(id='lines', ctx=Store())],
              value=List(ctx=Load())),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='lines', ctx=Load()),
                  attr='append',
                  ctx=Load()),
                args=[
                  Subscript(
                    value=Attribute(
                      value=Name(id='master_resume', ctx=Load()),
                      attr='CONTACT',
                      ctx=Load()),
                    slice=Constant(value='name'),
                    ctx=Load())])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='lines', ctx=Load()),
                  attr='append',
                  ctx=Load()),
                args=[
                  Name(id='headline', ctx=Load())])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='lines', ctx=Load()),
                  attr='append',
                  ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      FormattedValue(
                        value=Subscript(
                          value=Attribute(
                            value=Name(id='master_resume', ctx=Load()),
                            attr='CONTACT',
                            ctx=Load()),
                          slice=Constant(value='phone'),
                          ctx=Load()),
                        conversion=-1),
                      Constant(value=' | '),
                      FormattedValue(
                        value=Subscript(
                          value=Attribute(
                            value=Name(id='master_resume', ctx=Load()),
                            attr='CONTACT',
                            ctx=Load()),
                          slice=Constant(value='email'),
                          ctx=Load()),
                        conversion=-1)])])),
            Expr(
              value=Call(
