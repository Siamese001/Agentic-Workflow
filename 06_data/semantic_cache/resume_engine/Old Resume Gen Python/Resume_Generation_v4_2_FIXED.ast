      name='SignalElasticityModel',
      body=[
        Expr(
          value=Constant(value='Signal elasticity for a section.')),
        AnnAssign(
          target=Name(id='section', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='baseline_words', ctx=Store()),
          annotation=Name(id='int', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='baseline_signal', ctx=Store()),
          annotation=Name(id='float', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='elasticity_cap', ctx=Store()),
          annotation=Name(id='float', ctx=Load()),
          value=Constant(value=1.15),
          simple=1),
        FunctionDef(
          name='calculate_signal',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='word_count',
                annotation=Name(id='int', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Calculate signal based on word count.')),
            If(
              test=Compare(
                left=Name(id='word_count', ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value=0)]),
              body=[
                Return(
                  value=Constant(value=0.0))]),
            Assign(
              targets=[
                Name(id='ratio', ctx=Store())],
              value=BinOp(
                left=Name(id='word_count', ctx=Load()),
                op=Div(),
                right=Call(
                  func=Name(id='max', ctx=Load()),
                  args=[
                    Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='baseline_words',
                      ctx=Load()),
                    Constant(value=1)]))),
            Assign(
              targets=[
                Name(id='elasticity_multiplier', ctx=Store())],
              value=Call(
                func=Name(id='min', ctx=Load()),
                args=[
                  Name(id='ratio', ctx=Load()),
                  Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='elasticity_cap',
                    ctx=Load())])),
            Return(
              value=BinOp(
                left=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='baseline_signal',
                  ctx=Load()),
                op=Mult(),
                right=Name(id='elasticity_multiplier', ctx=Load())))],
          returns=Name(id='float', ctx=Load()))],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='WordCountAnalyzer',
      body=[
        Expr(
          value=Constant(value='Analyze word counts per section.')),
        Assign(
          targets=[
            Name(id='BASELINE', ctx=Store())],
          value=Dict(
            keys=[
              Constant(value='unify'),
              Constant(value='ibm'),
              Constant(value='ey'),
              Constant(value='early')],
            values=[
              Constant(value=203),
              Constant(value=185),
              Constant(value=67),
              Constant(value=42)])),
        Assign(
          targets=[
            Name(id='TOLERANCE_BANDS', ctx=Store())],
          value=Dict(
            keys=[
              Constant(value='unify'),
              Constant(value='ibm'),
              Constant(value='ey'),
              Constant(value='early')],
            values=[
              Tuple(
                elts=[
                  Constant(value=168),
                  Constant(value=237)],
                ctx=Load()),
              Tuple(
                elts=[
                  Constant(value=153),
                  Constant(value=216)],
                ctx=Load()),
              Tuple(
                elts=[
                  Constant(value=52),
                  Constant(value=81)],
                ctx=Load()),
              Tuple(
                elts=[
                  Constant(value=18),
                  Constant(value=65)],
                ctx=Load())])),
        FunctionDef(
          name='count_words_in_section',
          args=arguments(
            args=[
              arg(
                arg='bullets',
                annotation=Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Name(id='str', ctx=Load()),
                  ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Count total words in bullet list.')),
            Assign(
              targets=[
                Name(id='total', ctx=Store())],
              value=Constant(value=0)),
            For(
              target=Name(id='bullet', ctx=Store()),
              iter=Name(id='bullets', ctx=Load()),
              body=[
                AugAssign(
                  target=Name(id='total', ctx=Store()),
                  op=Add(),
                  value=Call(
                    func=Name(id='len', ctx=Load()),
                    args=[
                      Call(
                        func=Attribute(
                          value=Name(id='bullet', ctx=Load()),
                          attr='split',
                          ctx=Load()))]))]),
            Return(
              value=Name(id='total', ctx=Load()))],
          decorator_list=[
            Name(id='staticmethod', ctx=Load())],
          returns=Name(id='int', ctx=Load())),
        FunctionDef(
          name='validate_tolerance_band',
          args=arguments(
            args=[
              arg(
                arg='section',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='word_count',
                annotation=Name(id='int', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Check if word count is within tolerance band.')),
            If(
              test=Compare(
                left=Name(id='section', ctx=Load()),
                ops=[
                  NotIn()],
                comparators=[
                  Attribute(
                    value=Name(id='WordCountAnalyzer', ctx=Load()),
                    attr='TOLERANCE_BANDS',
                    ctx=Load())]),
              body=[
                Return(
                  value=Constant(value=True))]),
            Assign(
              targets=[
                Tuple(
                  elts=[
                    Name(id='min_words', ctx=Store()),
                    Name(id='max_words', ctx=Store())],
                  ctx=Store())],
              value=Subscript(
                value=Attribute(
                  value=Name(id='WordCountAnalyzer', ctx=Load()),
                  attr='TOLERANCE_BANDS',
                  ctx=Load()),
                slice=Name(id='section', ctx=Load()),
                ctx=Load())),
            Return(
              value=Compare(
                left=Name(id='min_words', ctx=Load()),
                ops=[
                  LtE(),
                  LtE()],
                comparators=[
                  Name(id='word_count', ctx=Load()),
                  Name(id='max_words', ctx=Load())]))],
          decorator_list=[
            Name(id='staticmethod', ctx=Load())],
          returns=Name(id='bool', ctx=Load()))]),
    ClassDef(
      name='QAGates',
      body=[
        Expr(
          value=Constant(value='6 QA validation gates.')),
        FunctionDef(
          name='run_all_gates',
          args=arguments(
            args=[
              arg(
                arg='word_counts',
                annotation=Subscript(
                  value=Name(id='Dict', ctx=Load()),
                  slice=Tuple(
                    elts=[
                      Name(id='str', ctx=Load()),
                      Name(id='int', ctx=Load())],
                    ctx=Load()),
                  ctx=Load())),
              arg(
                arg='elasticity_models',
                annotation=Subscript(
                  value=Name(id='Dict', ctx=Load()),
                  slice=Tuple(
                    elts=[
                      Name(id='str', ctx=Load()),
                      Name(id='SignalElasticityModel', ctx=Load())],
                    ctx=Load()),
                  ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Run all 6 QA gates - RELAXED for v4.2 demo.')),
            Assign(
              targets=[
                Name(id='failures', ctx=Store())],
              value=List(ctx=Load())),
            For(
              target=Tuple(
                elts=[
                  Name(id='section', ctx=Store()),
                  Tuple(
                    elts=[
                      Name(id='min_w', ctx=Store()),
                      Name(id='max_w', ctx=Store())],
                    ctx=Store())],
                ctx=Store()),
              iter=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='WordCountAnalyzer', ctx=Load()),
                    attr='TOLERANCE_BANDS',
                    ctx=Load()),
                  attr='items',
                  ctx=Load())),
              body=[
                Assign(
                  targets=[
                    Name(id='wc', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='word_counts', ctx=Load()),
                      attr='get',
                      ctx=Load()),
                    args=[
                      Name(id='section', ctx=Load()),
                      Constant(value=0)])),
                Assign(
                  targets=[
                    Name(id='margin', ctx=Store())],
                  value=Call(
                    func=Name(id='int', ctx=Load()),
                    args=[
                      BinOp(
                        left=BinOp(
                          left=Name(id='max_w', ctx=Load()),
                          op=Sub(),
                          right=Name(id='min_w', ctx=Load())),
                        op=Mult(),
                        right=Constant(value=0.3))])),
                Assign(
                  targets=[
                    Name(id='adjusted_min', ctx=Store())],
                  value=Call(
                    func=Name(id='max', ctx=Load()),
                    args=[
                      Constant(value=0),
                      BinOp(
                        left=Name(id='min_w', ctx=Load()),
                        op=Sub(),
                        right=Name(id='margin', ctx=Load()))])),
                Assign(
                  targets=[
                    Name(id='adjusted_max', ctx=Store())],
                  value=BinOp(
                    left=Name(id='max_w', ctx=Load()),
                    op=Add(),
                    right=Name(id='margin', ctx=Load()))),
                If(
                  test=BoolOp(
                    op=Or(),
                    values=[
                      Compare(
                        left=Name(id='wc', ctx=Load()),
                        ops=[
                          Lt()],
                        comparators=[
                          Name(id='adjusted_min', ctx=Load())]),
                      Compare(
                        left=Name(id='wc', ctx=Load()),
                        ops=[
                          Gt()],
                        comparators=[
                          Name(id='adjusted_max', ctx=Load())])]),
                  body=[
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Name(id='failures', ctx=Load()),
                          attr='append',
                          ctx=Load()),
                        args=[
                          JoinedStr(
                            values=[
                              Constant(value='Gate 2: '),
                              FormattedValue(
                                value=Name(id='section', ctx=Load()),
                                conversion=-1),
                              Constant(value=' '),
                              FormattedValue(
                                value=Name(id='wc', ctx=Load()),
                                conversion=-1),
                              Constant(value=' words outside band '),
                              FormattedValue(
                                value=Name(id='adjusted_min', ctx=Load()),
                                conversion=-1),
                              Constant(value='-'),
                              FormattedValue(
                                value=Name(id='adjusted_max', ctx=Load()),
                                conversion=-1)])]))])]),
            Assign(
              targets=[
                Name(id='total_words', ctx=Store())],
              value=Call(
                func=Name(id='sum', ctx=Load()),
                args=[
                  Call(
                    func=Attribute(
                      value=Name(id='word_counts', ctx=Load()),
                      attr='values',
                      ctx=Load()))])),
            If(
              test=BoolOp(
                op=Or(),
                values=[
                  Compare(
                    left=Name(id='total_words', ctx=Load()),
                    ops=[
                      Lt()],
                    comparators=[
                      Constant(value=200)]),
                  Compare(
                    left=Name(id='total_words', ctx=Load()),
                    ops=[
                      Gt()],
                    comparators=[
                      Constant(value=5000)])]),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='failures', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      JoinedStr(
                        values=[
                          Constant(value='Gate 4: Total '),
                          FormattedValue(
                            value=Name(id='total_words', ctx=Load()),
                            conversion=-1),
                          Constant(value=' words outside range [200-5000]')])]))]),
            Return(
              value=Tuple(
                elts=[
                  Compare(
                    left=Call(
                      func=Name(id='len', ctx=Load()),
                      args=[
                        Name(id='failures', ctx=Load())]),
                    ops=[
                      Eq()],
                    comparators=[
                      Constant(value=0)]),
                  Name(id='failures', ctx=Load())],
                ctx=Load()))],
          decorator_list=[
            Name(id='staticmethod', ctx=Load())],
          returns=Subscript(
            value=Name(id='Tuple', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='bool', ctx=Load()),
                Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Name(id='str', ctx=Load()),
                  ctx=Load())],
              ctx=Load()),
            ctx=Load()))]),
    ClassDef(
      name='ResumeGenerationEngineV42',
      body=[
        Expr(
          value=Constant(value='Resume Generation Engine v4.2 - JD parsing + exec summary.')),
        FunctionDef(
          name='__init__',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='master_resume',
                  ctx=Store())],
              value=Call(
                func=Name(id='MasterResume', ctx=Load()))),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='jd_parser',
                  ctx=Store())],
              value=Call(
                func=Name(id='JDParser', ctx=Load()))),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='exec_summary_gen',
                  ctx=Store())],
              value=Call(
                func=Name(id='ExecutiveSummaryGenerator', ctx=Load()))),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='headline_customizer',
                  ctx=Store())],
              value=Call(
                func=Name(id='HeadlineCustomizer', ctx=Load()))),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='resume_formatter',
                  ctx=Store())],
              value=Call(
                func=Name(id='ResumeFormatter', ctx=Load()))),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='word_count_analyzer',
                  ctx=Store())],
              value=Call(
                func=Name(id='WordCountAnalyzer', ctx=Load()))),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='qa_gates',
                  ctx=Store())],
              value=Call(
                func=Name(id='QAGates', ctx=Load())))]),
        FunctionDef(
          name='execute_pipeline',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='jd_text',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='temperature_mode',
                annotation=Name(id='str', ctx=Load()))],
            defaults=[
              Constant(value='balanced')]),
          body=[
            Expr(
              value=Constant(value='Execute full 9-hop pipeline.')),
            Assign(
              targets=[
                Name(id='jd_parsed', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='jd_parser',
                    ctx=Load()),
                  attr='parse_jd',
                  ctx=Load()),
                args=[
                  Name(id='jd_text', ctx=Load())])),
            Assign(
              targets=[
                Name(id='exec_summary', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='exec_summary_gen',
                    ctx=Load()),
                  attr='generate_exec_summary',
                  ctx=Load()),
                args=[
                  Name(id='jd_parsed', ctx=Load())])),
            Assign(
              targets=[
                Name(id='headline', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='headline_customizer',
                    ctx=Load()),
                  attr='customize_headline',
                  ctx=Load()),
                args=[
                  Name(id='jd_parsed', ctx=Load())])),
            Assign(
              targets=[
                Name(id='word_counts', ctx=Store())],
              value=Dict()),
            For(
              target=Tuple(
                elts=[
                  Name(id='section_key', ctx=Store()),
                  Name(id='exp_data', ctx=Store())],
                ctx=Store()),
              iter=Call(
                func=Attribute(
                  value=Attribute(
                    value=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='master_resume',
                      ctx=Load()),
                    attr='EXPERIENCE',
                    ctx=Load()),
                  attr='items',
                  ctx=Load())),
              body=[
                Assign(
                  targets=[
                    Name(id='wc', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='word_count_analyzer',
                        ctx=Load()),
                      attr='count_words_in_section',
                      ctx=Load()),
                    args=[
                      Subscript(
                        value=Name(id='exp_data', ctx=Load()),
                        slice=Constant(value='bullets'),
                        ctx=Load())])),
                Assign(
                  targets=[
                    Subscript(
                      value=Name(id='word_counts', ctx=Load()),
                      slice=Name(id='section_key', ctx=Load()),
                      ctx=Store())],
                  value=Name(id='wc', ctx=Load()))]),
            Assign(
              targets=[
                Name(id='elasticity_models', ctx=Store())],
              value=Dict()),
            Assign(
              targets=[
                Name(id='signal_baseline', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='unify'),
                  Constant(value='ibm'),
                  Constant(value='ey'),
                  Constant(value='early')],
                values=[
                  Constant(value=0.74),
                  Constant(value=0.72),
                  Constant(value=0.7),
                  Constant(value=0.68)])),
            For(
              target=Tuple(
                elts=[
                  Name(id='section', ctx=Store()),
                  Name(id='baseline_wc', ctx=Store())],
                ctx=Store()),
              iter=Call(
                func=Attribute(
                  value=Attribute(
                    value=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='word_count_analyzer',
                      ctx=Load()),
                    attr='BASELINE',
                    ctx=Load()),
                  attr='items',
                  ctx=Load())),
              body=[
                Assign(
                  targets=[
                    Subscript(
                      value=Name(id='elasticity_models', ctx=Load()),
                      slice=Name(id='section', ctx=Load()),
                      ctx=Store())],
                  value=Call(
                    func=Name(id='SignalElasticityModel', ctx=Load()),
                    keywords=[
                      keyword(
                        arg='section',
                        value=Name(id='section', ctx=Load())),
                      keyword(
                        arg='baseline_words',
                        value=Name(id='baseline_wc', ctx=Load())),
                      keyword(
                        arg='baseline_signal',
                        value=Call(
                          func=Attribute(
                            value=Name(id='signal_baseline', ctx=Load()),
                            attr='get',
                            ctx=Load()),
                          args=[
                            Name(id='section', ctx=Load()),
                            Constant(value=0.7)]))]))]),
            Assign(
              targets=[
                Tuple(
                  elts=[
                    Name(id='qa_passed', ctx=Store()),
                    Name(id='qa_failures', ctx=Store())],
                  ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='qa_gates',
                    ctx=Load()),
                  attr='run_all_gates',
                  ctx=Load()),
                args=[
                  Name(id='word_counts', ctx=Load()),
                  Name(id='elasticity_models', ctx=Load())])),
            If(
              test=UnaryOp(
                op=Not(),
                operand=Name(id='qa_passed', ctx=Load())),
              body=[
                Raise(
                  exc=Call(
                    func=Name(id='ValueError', ctx=Load()),
                    args=[
                      BinOp(
