          value=Constant(value='Temperature modes for constraint relaxation and signal adjustment.')),
        Assign(
          targets=[
            Name(id='CONSERVATIVE', ctx=Store())],
          value=Constant(value='conservative')),
        Assign(
          targets=[
            Name(id='BALANCED', ctx=Store())],
          value=Constant(value='balanced')),
        Assign(
          targets=[
            Name(id='CREATIVE', ctx=Store())],
          value=Constant(value='creative'))]),
    FunctionDef(
      name='load_master_resume',
      args=arguments(),
      body=[
        Expr(
          value=Constant(value='Load the master resume from JSON file.')),
        With(
          items=[
            withitem(
              context_expr=Call(
                func=Name(id='open', ctx=Load()),
                args=[
                  Constant(value='/mnt/user-data/uploads/Master_Resume_V2_14.json'),
                  Constant(value='r')]),
              optional_vars=Name(id='f', ctx=Store()))],
          body=[
            Return(
              value=Call(
                func=Attribute(
                  value=Name(id='json', ctx=Load()),
                  attr='load',
                  ctx=Load()),
                args=[
                  Name(id='f', ctx=Load())]))])]),
