        FunctionDef(
          name='_generate_executive_summary',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='profile',
                annotation=Name(id='Dict', ctx=Load())),
              arg(
                arg='jd',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Generate role-specific executive summary (100-150 words).')),
            If(
              test=Compare(
                left=Constant(value='chief_ai'),
                ops=[
                  In()],
                comparators=[
                  Call(
                    func=Attribute(
                      value=Subscript(
                        value=Name(id='profile', ctx=Load()),
                        slice=Constant(value='title'),
                        ctx=Load()),
                      attr='lower',
                      ctx=Load()))]),
              body=[
                Assign(
                  targets=[
                    Name(id='summary', ctx=Store())],
                  value=Constant(value="Chief AI Officer scaling Fortune 500 LLM adoption through strategic AWS partnerships and engineering excellence. Led 18-person senior engineering practice delivering enterprise-grade generative AI solutions, securing $18M partnership revenue and accelerating regulated program delivery by 37%. Architected production RAG pipelines processing 100K+ documents monthly with 41% improved accuracy. Previously transformed IBM's AI capability as Lead Client Partner, building teams achieving 70% POC-to-production success rate and $50M+ platform renewals. Modernized Basel III and CCAR frameworks while establishing enterprise AI governance standards. Deep expertise in LLM deployment, MLOps automation, and regulated financial services delivery. Founded TraderSense algorithmic trading platform and held senior roles at Ernst & Young."))],
              orelse=[
                If(
                  test=BoolOp(
                    op=Or(),
                    values=[
                      Compare(
                        left=Constant(value='pre-sales'),
                        ops=[
                          In()],
                        comparators=[
                          Call(
                            func=Attribute(
                              value=Subscript(
                                value=Name(id='profile', ctx=Load()),
                                slice=Constant(value='title'),
                                ctx=Load()),
                              attr='lower',
                              ctx=Load()))]),
                      Compare(
                        left=Constant(value='presales'),
                        ops=[
                          In()],
                        comparators=[
                          Call(
                            func=Attribute(
                              value=Subscript(
                                value=Name(id='profile', ctx=Load()),
                                slice=Constant(value='title'),
                                ctx=Load()),
                              attr='lower',
                              ctx=Load()))])]),
                  body=[
                    Assign(
                      targets=[
                        Name(id='summary', ctx=Store())],
                      value=Constant(value="Pre-sales leader scaling Fortune 500 AI adoption through technical excellence and strategic solution design. Built 18-engineer practice delivering enterprise LLM implementations, achieving $18M AWS partnership revenue and 37% faster POC-to-production cycles. Expert in architecting complex RAG pipelines, multi-agent workflows, and regulated AI frameworks for financial services. Led IBM's pre-sales transformation as Lead Client Partner, managing 15-architect team with 70% POC success rate and $50M+ renewals. Accelerated enterprise sales cycles by 32% through standardized demo frameworks and technical accelerators. Specialized in Basel III/CCAR modernization and enterprise data platform migrations. Founded TraderSense algorithmic platform and maintains deep expertise in solution architecture and technical sales leadership."))],
                  orelse=[
                    Assign(
                      targets=[
                        Name(id='summary', ctx=Store())],
                      value=Constant(value="Sales engineering executive driving enterprise AI revenue through technical leadership and strategic partnerships. Scaled 18-engineer team delivering Fortune 500 LLM implementations, generating $18M AWS revenue and reducing deal cycles by 37%. Expert in technical sales motions, POC execution, and complex enterprise solution design for regulated industries. Transformed IBM's technical sales capability as Lead Client Partner, building team achieving 70% win rate and $50M+ platform renewals. Reduced sales cycles by 32% via SE-led demonstrations and technical accelerators. Specialized in financial services modernization including Basel III and CCAR framework implementations. Entrepreneurial background founding TraderSense trading platform with consistent track record of building high-performing technical sales organizations."))])]),
            Assign(
              targets=[
                Name(id='words', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='summary', ctx=Load()),
                  attr='split',
                  ctx=Load()))),
            If(
              test=Compare(
                left=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Name(id='words', ctx=Load())]),
                ops=[
                  Gt()],
                comparators=[
                  Constant(value=150)]),
              body=[
                Assign(
                  targets=[
                    Name(id='summary', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Constant(value=' '),
                      attr='join',
                      ctx=Load()),
                    args=[
                      Subscript(
                        value=Name(id='words', ctx=Load()),
                        slice=Slice(
                          upper=Constant(value=145)),
                        ctx=Load())]))],
              orelse=[
                If(
                  test=Compare(
                    left=Call(
                      func=Name(id='len', ctx=Load()),
                      args=[
                        Name(id='words', ctx=Load())]),
                    ops=[
                      Lt()],
                    comparators=[
                      Constant(value=100)]),
                  body=[
                    AugAssign(
                      target=Name(id='summary', ctx=Store()),
                      op=Add(),
                      value=Constant(value=' Proven track record of building high-performance teams and driving enterprise transformation.'))])]),
            Return(
              value=Name(id='summary', ctx=Load()))],
          returns=Name(id='str', ctx=Load())),
        FunctionDef(
          name='_select_bullets',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='bullet_pool',
                annotation=Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Name(id='str', ctx=Load()),
                  ctx=Load())),
              arg(
                arg='jd',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='profile',
                annotation=Name(id='Dict', ctx=Load())),
              arg(
                arg='count',
                annotation=Name(id='int', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Select top bullets based on relevance scoring.')),
            Assign(
              targets=[
                Name(id='scored_bullets', ctx=Store())],
              value=List(ctx=Load())),
            For(
              target=Name(id='bullet', ctx=Store()),
              iter=Name(id='bullet_pool', ctx=Load()),
              body=[
                Assign(
                  targets=[
                    Name(id='score', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='bullet_scorer',
                        ctx=Load()),
                      attr='score_bullet',
                      ctx=Load()),
                    args=[
                      Name(id='bullet', ctx=Load()),
                      Name(id='jd', ctx=Load()),
                      Subscript(
                        value=Name(id='profile', ctx=Load()),
                        slice=Constant(value='keywords'),
                        ctx=Load())])),
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='scored_bullets', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Tuple(
                        elts=[
                          Name(id='score', ctx=Load()),
                          Name(id='bullet', ctx=Load())],
                        ctx=Load())]))]),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='scored_bullets', ctx=Load()),
                  attr='sort',
                  ctx=Load()),
                keywords=[
                  keyword(
                    arg='reverse',
                    value=Constant(value=True))])),
            Return(
              value=ListComp(
                elt=Name(id='bullet', ctx=Load()),
                generators=[
                  comprehension(
                    target=Tuple(
                      elts=[
                        Name(id='_', ctx=Store()),
                        Name(id='bullet', ctx=Store())],
                      ctx=Store()),
                    iter=Subscript(
                      value=Name(id='scored_bullets', ctx=Load()),
                      slice=Slice(
                        upper=Name(id='count', ctx=Load())),
                      ctx=Load()),
                    is_async=0)]))],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='_extract_competencies',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='competencies_list',
                annotation=Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Name(id='str', ctx=Load()),
                  ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Extract key competency terms from verbose descriptions.')),
            Assign(
              targets=[
                Name(id='key_terms', ctx=Store())],
              value=List(ctx=Load())),
            For(
              target=Name(id='comp', ctx=Store()),
              iter=Subscript(
                value=Name(id='competencies_list', ctx=Load()),
                slice=Slice(
                  upper=Constant(value=3)),
                ctx=Load()),
              body=[
                Assign(
                  targets=[
                    Name(id='comp', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Call(
                        func=Attribute(
                          value=Call(
                            func=Attribute(
                              value=Name(id='comp', ctx=Load()),
                              attr='replace',
                              ctx=Load()),
                            args=[
                              Constant(value='**'),
                              Constant(value='')]),
                          attr='replace',
                          ctx=Load()),
                        args=[
                          Constant(value='•'),
                          Constant(value='')]),
                      attr='strip',
                      ctx=Load()))),
                If(
                  test=Compare(
                    left=Constant(value=':'),
                    ops=[
                      In()],
                    comparators=[
                      Name(id='comp', ctx=Load())]),
                  body=[
                    Assign(
                      targets=[
                        Name(id='key', ctx=Store())],
                      value=Call(
                        func=Attribute(
                          value=Subscript(
                            value=Call(
                              func=Attribute(
                                value=Name(id='comp', ctx=Load()),
                                attr='split',
                                ctx=Load()),
                              args=[
                                Constant(value=':')]),
                            slice=Constant(value=0),
                            ctx=Load()),
                          attr='strip',
                          ctx=Load()))),
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Name(id='key_terms', ctx=Load()),
                          attr='append',
                          ctx=Load()),
                        args=[
                          Name(id='key', ctx=Load())]))])]),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='key_terms', ctx=Load()),
                  attr='extend',
                  ctx=Load()),
                args=[
                  List(
                    elts=[
                      Constant(value='LLM'),
                      Constant(value='GenAI'),
                      Constant(value='RAG'),
                      Constant(value='MLOps'),
                      Constant(value='AWS'),
                      Constant(value='Python')],
                    ctx=Load())])),
            Return(
              value=BinOp(
                left=Constant(value='Key Competencies: '),
                op=Add(),
                right=Call(
                  func=Attribute(
                    value=Constant(value=', '),
                    attr='join',
                    ctx=Load()),
                  args=[
                    Subscript(
                      value=Name(id='key_terms', ctx=Load()),
                      slice=Slice(
                        upper=Constant(value=10)),
                      ctx=Load())])))],
          returns=Name(id='str', ctx=Load())),
        FunctionDef(
          name='_calculate_metrics',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='sections',
                annotation=Name(id='Dict', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Calculate word counts and other metrics.')),
            Assign(
              targets=[
                Name(id='metrics', ctx=Store())],
              value=Dict()),
            For(
              target=Tuple(
                elts=[
                  Name(id='key', ctx=Store()),
                  Name(id='value', ctx=Store())],
                ctx=Store()),
              iter=Call(
                func=Attribute(
                  value=Name(id='sections', ctx=Load()),
                  attr='items',
                  ctx=Load())),
              body=[
                If(
                  test=Call(
                    func=Name(id='isinstance', ctx=Load()),
                    args=[
                      Name(id='value', ctx=Load()),
                      Name(id='str', ctx=Load())]),
                  body=[
                    Assign(
                      targets=[
                        Subscript(
                          value=Name(id='metrics', ctx=Load()),
                          slice=JoinedStr(
                            values=[
                              FormattedValue(
                                value=Name(id='key', ctx=Load()),
                                conversion=-1),
                              Constant(value='_words')]),
                          ctx=Store())],
                      value=Call(
                        func=Name(id='len', ctx=Load()),
                        args=[
                          Call(
                            func=Attribute(
                              value=Name(id='value', ctx=Load()),
                              attr='split',
                              ctx=Load()))]))],
                  orelse=[
                    If(
                      test=Call(
                        func=Name(id='isinstance', ctx=Load()),
                        args=[
                          Name(id='value', ctx=Load()),
                          Name(id='list', ctx=Load())]),
                      body=[
                        Assign(
                          targets=[
                            Subscript(
                              value=Name(id='metrics', ctx=Load()),
                              slice=JoinedStr(
                                values=[
                                  FormattedValue(
                                    value=Name(id='key', ctx=Load()),
                                    conversion=-1),
                                  Constant(value='_words')]),
                              ctx=Store())],
                          value=Call(
                            func=Name(id='sum', ctx=Load()),
                            args=[
                              GeneratorExp(
                                elt=Call(
                                  func=Name(id='len', ctx=Load()),
                                  args=[
                                    Call(
                                      func=Attribute(
                                        value=Name(id='item', ctx=Load()),
                                        attr='split',
                                        ctx=Load()))]),
                                generators=[
                                  comprehension(
                                    target=Name(id='item', ctx=Store()),
                                    iter=Name(id='value', ctx=Load()),
                                    is_async=0)])]))])])]),
            Assign(
              targets=[
                Subscript(
                  value=Name(id='metrics', ctx=Load()),
                  slice=Constant(value='total_words'),
                  ctx=Store())],
              value=Call(
                func=Name(id='sum', ctx=Load()),
                args=[
                  GeneratorExp(
                    elt=Name(id='v', ctx=Load()),
                    generators=[
                      comprehension(
                        target=Tuple(
                          elts=[
                            Name(id='k', ctx=Store()),
                            Name(id='v', ctx=Store())],
                          ctx=Store()),
                        iter=Call(
                          func=Attribute(
                            value=Name(id='metrics', ctx=Load()),
                            attr='items',
                            ctx=Load())),
                        ifs=[
                          Call(
                            func=Attribute(
                              value=Name(id='k', ctx=Load()),
                              attr='endswith',
                              ctx=Load()),
                            args=[
                              Constant(value='_words')])],
                        is_async=0)])])),
            Assign(
              targets=[
                Name(id='unify_words', ctx=Store())],
              value=BinOp(
                left=Call(
                  func=Attribute(
                    value=Name(id='metrics', ctx=Load()),
                    attr='get',
                    ctx=Load()),
                  args=[
                    Constant(value='unify_bullets_words'),
                    Constant(value=0)]),
                op=Add(),
                right=Call(
                  func=Attribute(
                    value=Name(id='metrics', ctx=Load()),
                    attr='get',
                    ctx=Load()),
                  args=[
                    Constant(value='unify_intro_words'),
                    Constant(value=0)]))),
            Assign(
              targets=[
                Name(id='ibm_words', ctx=Store())],
              value=BinOp(
                left=Call(
                  func=Attribute(
                    value=Name(id='metrics', ctx=Load()),
                    attr='get',
                    ctx=Load()),
                  args=[
                    Constant(value='ibm_bullets_words'),
                    Constant(value=0)]),
                op=Add(),
                right=Call(
                  func=Attribute(
                    value=Name(id='metrics', ctx=Load()),
                    attr='get',
                    ctx=Load()),
                  args=[
                    Constant(value='ibm_intro_words'),
                    Constant(value=0)]))),
            Assign(
              targets=[
                Subscript(
                  value=Name(id='metrics', ctx=Load()),
                  slice=Constant(value='unify_ibm_ratio'),
                  ctx=Store())],
              value=IfExp(
                test=Compare(
                  left=Name(id='ibm_words', ctx=Load()),
                  ops=[
                    Gt()],
                  comparators=[
                    Constant(value=0)]),
                body=BinOp(
                  left=Name(id='unify_words', ctx=Load()),
                  op=Div(),
                  right=Name(id='ibm_words', ctx=Load())),
                orelse=Constant(value=0))),
            Assign(
              targets=[
                Subscript(
                  value=Name(id='metrics', ctx=Load()),
                  slice=Constant(value='signal_score'),
                  ctx=Store())],
              value=Constant(value=0.75)),
            Return(
              value=Name(id='metrics', ctx=Load()))],
          returns=Name(id='Dict', ctx=Load())),
        FunctionDef(
          name='_run_qa_validation',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='sections',
                annotation=Name(id='Dict', ctx=Load())),
              arg(
                arg='metrics',
                annotation=Name(id='Dict', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Run QA validation checks.')),
            Assign(
              targets=[
                Name(id='results', ctx=Store())],
              value=Dict()),
            Assign(
              targets=[
                Name(id='total', ctx=Store())],
              value=Subscript(
                value=Name(id='metrics', ctx=Load()),
                slice=Constant(value='total_words'),
                ctx=Load())),
            Assign(
              targets=[
                Name(id='target', ctx=Store())],
              value=Attribute(
