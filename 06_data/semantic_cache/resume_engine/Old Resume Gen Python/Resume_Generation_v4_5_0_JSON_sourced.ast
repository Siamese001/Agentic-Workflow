                  slice=Constant(value='unify_company'),
                  ctx=Store())],
              value=JoinedStr(
                values=[
                  FormattedValue(
                    value=Subscript(
                      value=Name(id='unify', ctx=Load()),
                      slice=Constant(value='company'),
                      ctx=Load()),
                    conversion=-1),
                  Constant(value=' | '),
                  FormattedValue(
                    value=Subscript(
                      value=Name(id='unify', ctx=Load()),
                      slice=Constant(value='title'),
                      ctx=Load()),
                    conversion=-1),
                  Constant(value=' | '),
                  FormattedValue(
                    value=Subscript(
                      value=Subscript(
                        value=Name(id='unify', ctx=Load()),
                        slice=Constant(value='dates'),
                        ctx=Load()),
                      slice=Constant(value='start'),
                      ctx=Load()),
                    conversion=-1),
                  Constant(value=' – '),
                  FormattedValue(
