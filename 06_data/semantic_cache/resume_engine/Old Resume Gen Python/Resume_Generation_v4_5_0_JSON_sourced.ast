    ClassDef(
      name='BulletScorer',
      body=[
        Expr(
          value=Constant(value='Score bullets based on relevance to JD and role.')),
        FunctionDef(
          name='score_bullet',
          args=arguments(
            args=[
              arg(
                arg='bullet',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='jd',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='role_keywords',
                annotation=Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Name(id='str', ctx=Load()),
                  ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Score a bullet based on keyword matches and metrics.')),
            Assign(
              targets=[
                Name(id='score', ctx=Store())],
              value=Constant(value=0.0)),
            Assign(
              targets=[
                Name(id='bullet_lower', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='bullet', ctx=Load()),
                  attr='lower',
                  ctx=Load()))),
            Assign(
              targets=[
                Name(id='jd_lower', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='jd', ctx=Load()),
                  attr='lower',
                  ctx=Load()))),
            For(
              target=Name(id='keyword', ctx=Store()),
              iter=Name(id='role_keywords', ctx=Load()),
              body=[
                If(
                  test=Compare(
                    left=Call(
                      func=Attribute(
                        value=Name(id='keyword', ctx=Load()),
                        attr='lower',
                        ctx=Load())),
                    ops=[
                      In()],
                    comparators=[
                      Name(id='bullet_lower', ctx=Load())]),
                  body=[
                    AugAssign(
                      target=Name(id='score', ctx=Store()),
                      op=Add(),
                      value=Constant(value=0.2))])]),
            Assign(
              targets=[
                Name(id='jd_keywords', ctx=Store())],
              value=List(
                elts=[
                  Constant(value='pre-sales'),
                  Constant(value='solution'),
                  Constant(value='architect'),
                  Constant(value='poc'),
                  Constant(value='demo'),
                  Constant(value='enterprise'),
                  Constant(value='fortune 500'),
                  Constant(value='saas'),
                  Constant(value='ai'),
                  Constant(value='llm'),
                  Constant(value='partnership'),
                  Constant(value='revenue'),
                  Constant(value='team'),
                  Constant(value='scale'),
                  Constant(value='lead'),
                  Constant(value='strategic')],
                ctx=Load())),
            For(
              target=Name(id='keyword', ctx=Store()),
              iter=Name(id='jd_keywords', ctx=Load()),
              body=[
                If(
                  test=BoolOp(
                    op=And(),
                    values=[
                      Compare(
                        left=Name(id='keyword', ctx=Load()),
                        ops=[
                          In()],
                        comparators=[
                          Name(id='jd_lower', ctx=Load())]),
                      Compare(
                        left=Name(id='keyword', ctx=Load()),
                        ops=[
                          In()],
                        comparators=[
                          Name(id='bullet_lower', ctx=Load())])]),
                  body=[
                    AugAssign(
                      target=Name(id='score', ctx=Store()),
                      op=Add(),
                      value=Constant(value=0.15))])]),
            If(
              test=Call(
                func=Attribute(
                  value=Name(id='re', ctx=Load()),
                  attr='search',
                  ctx=Load()),
                args=[
                  Constant(value='\\d+[%$MK]|\\$\\d+[MK]'),
                  Name(id='bullet', ctx=Load())]),
              body=[
                AugAssign(
                  target=Name(id='score', ctx=Store()),
                  op=Add(),
                  value=Constant(value=0.1))]),
            If(
              test=Call(
                func=Attribute(
                  value=Name(id='re', ctx=Load()),
                  attr='search',
                  ctx=Load()),
                args=[
                  Constant(value='\\d+-person|\\d+ person'),
                  Name(id='bullet', ctx=Load())]),
              body=[
                AugAssign(
                  target=Name(id='score', ctx=Store()),
                  op=Add(),
                  value=Constant(value=0.05))]),
            Return(
              value=Call(
                func=Name(id='min', ctx=Load()),
                args=[
                  Name(id='score', ctx=Load()),
                  Constant(value=1.0)]))],
          decorator_list=[
            Name(id='staticmethod', ctx=Load())],
          returns=Name(id='float', ctx=Load()))]),
    ClassDef(
      name='ResumeGenerationEngine',
      body=[
        Expr(
          value=Constant(value='Main engine for generating customized resumes from JSON master.')),
        FunctionDef(
          name='__init__',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='master_data',
                  ctx=Store())],
              value=Call(
                func=Name(id='load_master_resume', ctx=Load()))),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='baseline_metrics',
                  ctx=Store())],
              value=Call(
                func=Name(id='BaselineResumeMetrics', ctx=Load()))),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='role_profiles',
                  ctx=Store())],
              value=Call(
                func=Name(id='RoleProfiles', ctx=Load()))),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='bullet_scorer',
                  ctx=Store())],
              value=Call(
                func=Name(id='BulletScorer', ctx=Load())))]),
        FunctionDef(
          name='generate_resume',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='jd',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='role_type',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='temp_mode',
                annotation=Name(id='TemperatureMode', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Generate all 4 outputs for the resume.')),
            Assign(
              targets=[
                Name(id='profile', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Attribute(
                    value=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='role_profiles',
                      ctx=Load()),
                    attr='PROFILES',
                    ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Name(id='role_type', ctx=Load())])),
            If(
              test=UnaryOp(
                op=Not(),
                operand=Name(id='profile', ctx=Load())),
              body=[
                Raise(
                  exc=Call(
                    func=Name(id='ValueError', ctx=Load()),
                    args=[
                      JoinedStr(
                        values=[
                          Constant(value='Unknown role type: '),
                          FormattedValue(
                            value=Name(id='role_type', ctx=Load()),
                            conversion=-1)])]))]),
            Assign(
              targets=[
                Name(id='sections', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='_build_resume_sections',
                  ctx=Load()),
                args=[
                  Name(id='jd', ctx=Load()),
                  Name(id='profile', ctx=Load()),
                  Name(id='temp_mode', ctx=Load())])),
            Assign(
              targets=[
                Name(id='metrics', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='_calculate_metrics',
                  ctx=Load()),
                args=[
                  Name(id='sections', ctx=Load())])),
            Assign(
              targets=[
                Name(id='qa_results', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='_run_qa_validation',
                  ctx=Load()),
                args=[
                  Name(id='sections', ctx=Load()),
                  Name(id='metrics', ctx=Load())])),
            Assign(
              targets=[
                Name(id='outputs', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='output1_resume'),
                  Constant(value='output2_word_count'),
                  Constant(value='output3_signal_calibration'),
                  Constant(value='output4_qa_validation')],
                values=[
                  Call(
                    func=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='_format_resume',
                      ctx=Load()),
                    args=[
                      Name(id='sections', ctx=Load()),
                      Name(id='profile', ctx=Load())]),
                  Call(
                    func=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='_format_word_count_table',
                      ctx=Load()),
                    args=[
                      Name(id='sections', ctx=Load()),
                      Name(id='metrics', ctx=Load())]),
                  Call(
                    func=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='_format_signal_calibration',
                      ctx=Load()),
                    args=[
                      Name(id='metrics', ctx=Load())]),
                  Call(
                    func=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='_format_qa_validation',
                      ctx=Load()),
                    args=[
                      Name(id='qa_results', ctx=Load())])])),
            Return(
              value=Name(id='outputs', ctx=Load()))],
          returns=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='str', ctx=Load())],
              ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='_build_resume_sections',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='jd',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='profile',
                annotation=Name(id='Dict', ctx=Load())),
              arg(
                arg='temp_mode',
                annotation=Name(id='TemperatureMode', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Build customized resume sections from master data.')),
            Assign(
              targets=[
                Name(id='sections', ctx=Store())],
              value=Dict()),
            Assign(
              targets=[
                Name(id='owner', ctx=Store())],
              value=Subscript(
                value=Attribute(
                  value=Name(id='self', ctx=Load()),
