Module(
  body=[
    Expr(
      value=Constant(value='\nResume Generation Engine v4.5.0 - MASTER RESUME JSON SOURCED\n=============================================================\n\nMAJOR CHANGES FROM v4.4.4:\n- Now properly sources ALL content from Master_Resume_V2.14.json\n- Baseline resume ONLY used for word count targets (1,032 words)\n- Correct dates, titles, locations from JSON source\n- Proper company names and formatting\n- All bullets drawn from JSON bullet_pool\n- Certifications and competencies from JSON\n\nVersion: 4.5.0\nDate: October 2025\n')),
    Import(
      names=[
        alias(name='json')]),
    Import(
      names=[
        alias(name='re')]),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Dict'),
        alias(name='List'),
        alias(name='Tuple'),
        alias(name='Optional')],
      level=0),
    ImportFrom(
      module='enum',
      names=[
        alias(name='Enum')],
      level=0),
    Import(
      names=[
        alias(name='random')]),
    Assign(
      targets=[
        Name(id='__version__', ctx=Store())],
      value=Constant(value='4.5.0')),
    ClassDef(
      name='TemperatureMode',
      bases=[
        Name(id='Enum', ctx=Load())],
      body=[
