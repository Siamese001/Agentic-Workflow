                  value=Name(id='sections', ctx=Load()),
                  slice=Constant(value='executive_summary'),
                  ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='_generate_executive_summary',
                  ctx=Load()),
                args=[
                  Name(id='profile', ctx=Load()),
                  Name(id='jd', ctx=Load())])),
            Assign(
              targets=[
                Name(id='exp_data', ctx=Store())],
              value=Subscript(
