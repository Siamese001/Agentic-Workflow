                      Compare(
                        left=Call(
                          func=Name(id='len', ctx=Load()),
                          args=[
                            Name(id='word', ctx=Load())]),
                        ops=[
                          GtE()],
                        comparators=[
                          Constant(value=3)])]),
                  body=[
                    Assign(
                      targets=[
                        Subscript(
                          value=Name(id='keyword_freq', ctx=Load()),
                          slice=Name(id='word', ctx=Load()),
                          ctx=Store())],
                      value=BinOp(
                        left=Call(
                          func=Attribute(
                            value=Name(id='keyword_freq', ctx=Load()),
                            attr='get',
                            ctx=Load()),
                          args=[
                            Name(id='word', ctx=Load()),
                            Constant(value=0)]),
                        op=Add(),
                        right=Constant(value=1)))])]),
            For(
              target=Tuple(
                elts=[
                  Name(id='domain', ctx=Store()),
                  Name(id='terms', ctx=Store())],
