          value=IfExp(
            test=Attribute(
              value=Name(id='reasoning_config', ctx=Load()),
              attr='min_tot_depth',
              ctx=Load()),
            body=Attribute(
              value=Name(id='reasoning_config', ctx=Load()),
              attr='min_tot_depth',
              ctx=Load()),
            orelse=Constant(value=3))),
        Assign(
