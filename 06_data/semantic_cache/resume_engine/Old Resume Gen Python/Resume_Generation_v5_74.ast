        FunctionDef(
          name='validate_jd_enforcement',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(arg='data')]),
          body=[
            Expr(
              value=Constant(value='Validate JD enforcement (replaces JDEnforcementValidator).')),
            Assign(
              targets=[
                Name(id='results', ctx=Store())],
              value=List(ctx=Load())),
            If(
              test=Call(
                func=Name(id='isinstance', ctx=Load()),
                args=[
                  Name(id='data', ctx=Load()),
                  Name(id='dict', ctx=Load())]),
              body=[
                For(
                  target=Tuple(
                    elts=[
                      Name(id='key', ctx=Store()),
                      Name(id='value', ctx=Store())],
                    ctx=Store()),
                  iter=Call(
                    func=Attribute(
                      value=Name(id='data', ctx=Load()),
                      attr='items',
                      ctx=Load())),
                  body=[
                    If(
                      test=Call(
                        func=Name(id='isinstance', ctx=Load()),
                        args=[
                          Name(id='value', ctx=Load()),
                          Tuple(
                            elts=[
                              Name(id='int', ctx=Load()),
                              Name(id='float', ctx=Load())],
                            ctx=Load())]),
                      body=[
                        Assign(
                          targets=[
                            Name(id='passed', ctx=Store())],
                          value=Compare(
                            left=Name(id='value', ctx=Load()),
                            ops=[
                              GtE()],
                            comparators=[
                              Attribute(
                                value=Name(id='CONFIG', ctx=Load()),
                                attr='WARNING_THRESHOLD',
                                ctx=Load())])),
                        Expr(
                          value=Call(
                            func=Attribute(
                              value=Name(id='results', ctx=Load()),
                              attr='append',
                              ctx=Load()),
                            args=[
                              Dict(
                                keys=[
                                  Constant(value='check'),
                                  Constant(value='value'),
                                  Constant(value='threshold'),
                                  Constant(value='passed')],
                                values=[
                                  Name(id='key', ctx=Load()),
                                  Name(id='value', ctx=Load()),
                                  Attribute(
                                    value=Name(id='CONFIG', ctx=Load()),
                                    attr='WARNING_THRESHOLD',
                                    ctx=Load()),
                                  Name(id='passed', ctx=Load())])]))])])]),
            Return(
              value=Name(id='results', ctx=Load()))]),
        FunctionDef(
          name='validate_app_tracker',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(arg='data')]),
          body=[
            Expr(
              value=Constant(value='Validate app tracker data (replaces AppTrackerQAValidator).')),
            Assign(
              targets=[
                Name(id='results', ctx=Store())],
              value=List(ctx=Load())),
            If(
              test=Call(
                func=Name(id='isinstance', ctx=Load()),
                args=[
                  Name(id='data', ctx=Load()),
                  Name(id='dict', ctx=Load())]),
              body=[
                For(
                  target=Tuple(
                    elts=[
                      Name(id='key', ctx=Store()),
                      Name(id='value', ctx=Store())],
                    ctx=Store()),
                  iter=Call(
                    func=Attribute(
                      value=Name(id='data', ctx=Load()),
                      attr='items',
                      ctx=Load())),
                  body=[
                    If(
                      test=Call(
                        func=Name(id='isinstance', ctx=Load()),
                        args=[
                          Name(id='value', ctx=Load()),
                          Name(id='str', ctx=Load())]),
                      body=[
                        Assign(
                          targets=[
                            Name(id='passed', ctx=Store())],
                          value=Compare(
                            left=Call(
                              func=Name(id='len', ctx=Load()),
                              args=[
                                Name(id='value', ctx=Load())]),
                            ops=[
                              Gt()],
                            comparators=[
                              Constant(value=0)])),
                        Expr(
                          value=Call(
                            func=Attribute(
                              value=Name(id='results', ctx=Load()),
                              attr='append',
                              ctx=Load()),
                            args=[
                              Dict(
                                keys=[
                                  Constant(value='field'),
                                  Constant(value='present'),
                                  Constant(value='value')],
                                values=[
                                  Name(id='key', ctx=Load()),
                                  Name(id='passed', ctx=Load()),
                                  IfExp(
                                    test=Name(id='passed', ctx=Load()),
                                    body=Name(id='value', ctx=Load()),
                                    orelse=Constant(value='MISSING'))])]))])])]),
            Return(
              value=Name(id='results', ctx=Load()))]),
        FunctionDef(
          name='validate_preflight',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(arg='data')]),
          body=[
            Expr(
              value=Constant(value='Validate preflight checks (replaces PreFlightValidator).')),
            Assign(
              targets=[
                Name(id='results', ctx=Store())],
              value=List(ctx=Load())),
            If(
              test=Call(
                func=Name(id='isinstance', ctx=Load()),
                args=[
                  Name(id='data', ctx=Load()),
                  Name(id='dict', ctx=Load())]),
              body=[
                Assign(
                  targets=[
                    Name(id='required_fields', ctx=Store())],
                  value=List(
                    elts=[
                      Constant(value='resume'),
                      Constant(value='jd'),
                      Constant(value='metadata')],
                    ctx=Load())),
                For(
                  target=Name(id='field', ctx=Store()),
                  iter=Name(id='required_fields', ctx=Load()),
                  body=[
                    Assign(
                      targets=[
                        Name(id='passed', ctx=Store())],
                      value=BoolOp(
                        op=And(),
                        values=[
                          Compare(
                            left=Name(id='field', ctx=Load()),
                            ops=[
                              In()],
                            comparators=[
                              Name(id='data', ctx=Load())]),
                          Compare(
                            left=Subscript(
                              value=Name(id='data', ctx=Load()),
                              slice=Name(id='field', ctx=Load()),
                              ctx=Load()),
                            ops=[
                              IsNot()],
                            comparators=[
                              Constant(value=None)])])),
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Name(id='results', ctx=Load()),
                          attr='append',
                          ctx=Load()),
                        args=[
                          Dict(
                            keys=[
                              Constant(value='field'),
                              Constant(value='passed'),
                              Constant(value='severity')],
                            values=[
                              Name(id='field', ctx=Load()),
                              Name(id='passed', ctx=Load()),
                              IfExp(
                                test=UnaryOp(
                                  op=Not(),
                                  operand=Name(id='passed', ctx=Load())),
                                body=Constant(value='CRITICAL'),
                                orelse=Constant(value='INFO'))])]))])]),
            Return(
              value=Name(id='results', ctx=Load()))]),
        FunctionDef(
          name='execute_all',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(arg='data')]),
          body=[
            Expr(
              value=Constant(value='Execute all validation rule categories.')),
            Return(
              value=Dict(
                keys=[
                  Constant(value='jd_enforcement'),
                  Constant(value='app_tracker'),
                  Constant(value='preflight')],
                values=[
                  Call(
                    func=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='validate_jd_enforcement',
                      ctx=Load()),
                    args=[
                      Call(
                        func=Attribute(
                          value=Name(id='data', ctx=Load()),
                          attr='get',
                          ctx=Load()),
                        args=[
                          Constant(value='jd_data'),
                          Dict()])]),
                  Call(
                    func=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='validate_app_tracker',
                      ctx=Load()),
                    args=[
                      Call(
                        func=Attribute(
                          value=Name(id='data', ctx=Load()),
                          attr='get',
                          ctx=Load()),
                        args=[
                          Constant(value='app_data'),
                          Dict()])]),
                  Call(
                    func=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='validate_preflight',
                      ctx=Load()),
                    args=[
                      Call(
                        func=Attribute(
                          value=Name(id='data', ctx=Load()),
                          attr='get',
