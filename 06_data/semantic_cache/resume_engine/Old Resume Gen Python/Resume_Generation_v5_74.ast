            Name(id='E9_CONTENT_HAS_JD_KW', ctx=Store())],
          value=Constant(value='Generated content must contain JD keywords')),
        Assign(
          targets=[
            Name(id='E10_ENRICHMENT_USES_JD', ctx=Store())],
          value=Constant(value='Enrichment must use JD-derived data')),
        Assign(
          targets=[
            Name(id='E11_VALIDATION_CHECKS_JD', ctx=Store())],
          value=Constant(value='Validation must check JD keyword presence')),
        Assign(
          targets=[
            Name(id='E12_FILES_CONTAIN_JD', ctx=Store())],
          value=Constant(value='Output files must contain JD-derived content')),
        Assign(
          targets=[
            Name(id='E13_QA_VERIFIES_JD', ctx=Store())],
          value=Constant(value='QA report must verify JD usage')),
        Assign(
          targets=[
            Name(id='E14_NO_MOCK_DATA', ctx=Store())],
          value=Constant(value='No fallback/mock/default data allowed anywhere')),
        Assign(
          targets=[
            Name(id='E15_COMPLETE_AUDIT', ctx=Store())],
          value=Constant(value='Complete audit trail of JD data flow required'))]),
