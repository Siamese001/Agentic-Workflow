                      body=[
                        Assign(
                          targets=[
                            Attribute(
                              value=Name(id='self', ctx=Load()),
                              attr='similarity_matrix_data',
                              ctx=Store())],
                          value=Constant(value=None))])]),
                Try(
                  body=[
                    Assign(
                      targets=[
                        Name(id='overview', ctx=Store())],
