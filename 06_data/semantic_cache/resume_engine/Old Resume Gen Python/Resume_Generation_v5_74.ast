                                conversion=-1),
                              Constant(value='. Using local NLP.')])])),
                    Return(
                      value=Call(
                        func=Attribute(
                          value=Name(id='self', ctx=Load()),
                          attr='_analyze_local_nlp',
                          ctx=Load()),
                        args=[
                          Name(id='job_description', ctx=Load())]))])])],
          returns=Constant(value='ThematicAnalysis')),
        FunctionDef(
          name='_analyze_with_resilient_web_search',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='job_description',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        v5.59: Enhanced analysis with 4-tier fallback strategy and telemetry.\n        \n        Strategy:\n        1. Try full 3-phase RAG\n        2. On partial failure, synthesize with available phases\n        3. On full failure, try hybrid local+web\n        4. On all failure, pure local NLP\n        ')),
            Import(
              names=[
                alias(name='logging')]),
