                        ctx=Load()),
                      args=[
                        Constant(value='company')]),
                    ops=[
                      Eq()],
                    comparators=[
                      Constant(value='IBM')]),
                  body=[
                    AugAssign(
                      target=Name(id='ibm_words', ctx=Store()),
                      op=Add(),
                      value=Name(id='words', ctx=Load()))])])]),
        If(
          test=Compare(
            left=Name(id='total_words', ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value=0)]),
          body=[
            Return(
              value=Call(
                func=Name(id='ValidationResult', ctx=Load()),
                keywords=[
                  keyword(
                    arg='rule_id',
                    value=Constant(value='WORD_DISTRIBUTION_ERROR')),
                  keyword(
                    arg='passed',
                    value=Constant(value=False)),
                  keyword(
                    arg='severity',
                    value=Attribute(
                      value=Name(id='ValidationSeverity', ctx=Load()),
                      attr='CRITICAL',
                      ctx=Load())),
                  keyword(
                    arg='message',
                    value=Constant(value='No words found in resume'))]))]),
        Assign(
          targets=[
            Name(id='combined_words', ctx=Store())],
          value=BinOp(
            left=Name(id='unify_words', ctx=Load()),
            op=Add(),
            right=Name(id='ibm_words', ctx=Load()))),
        Assign(
          targets=[
            Name(id='combined_percent', ctx=Store())],
          value=BinOp(
            left=BinOp(
              left=Name(id='combined_words', ctx=Load()),
              op=Div(),
              right=Name(id='total_words', ctx=Load())),
            op=Mult(),
            right=Constant(value=100))),
        Assign(
          targets=[
            Tuple(
              elts=[
                Name(id='min_percent', ctx=Store()),
                Name(id='max_percent', ctx=Store())],
              ctx=Store())],
          value=Subscript(
            value=Subscript(
              value=Name(id='SECTION_CONSTRAINTS_V521', ctx=Load()),
              slice=Constant(value='word_distribution'),
              ctx=Load()),
            slice=Constant(value='unify_ibm_combined_percent'),
            ctx=Load())),
        Assign(
          targets=[
            Name(id='passed', ctx=Store())],
          value=Compare(
            left=Name(id='min_percent', ctx=Load()),
            ops=[
              LtE(),
              LtE()],
            comparators=[
              Name(id='combined_percent', ctx=Load()),
