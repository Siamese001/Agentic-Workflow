    FunctionDef(
      name='generate_section',
      args=arguments(
        args=[
          arg(arg='self'),
          arg(
            arg='section_key',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='data',
            annotation=Name(id='str', ctx=Load())),
          arg(arg='llm')]),
      body=[
        Expr(
          value=Constant(value='Unified method to generate any section using SECTION_PROMPTS config.')),
        If(
          test=Compare(
            left=Name(id='section_key', ctx=Load()),
            ops=[
              NotIn()],
            comparators=[
              Name(id='SECTION_PROMPTS', ctx=Load())]),
          body=[
            Raise(
              exc=Call(
                func=Name(id='ValueError', ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='Unknown section: '),
                      FormattedValue(
                        value=Name(id='section_key', ctx=Load()),
                        conversion=-1)])]))]),
        Assign(
          targets=[
            Name(id='section_cfg', ctx=Store())],
          value=Subscript(
            value=Name(id='SECTION_PROMPTS', ctx=Load()),
            slice=Name(id='section_key', ctx=Load()),
            ctx=Load())),
        Try(
          body=[
            Assign(
              targets=[
                Name(id='prompt', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Subscript(
                    value=Name(id='section_cfg', ctx=Load()),
                    slice=Constant(value='prompt'),
                    ctx=Load()),
                  attr='format',
                  ctx=Load()),
                keywords=[
                  keyword(
                    arg='data',
                    value=Name(id='data', ctx=Load()))])),
            Assign(
              targets=[
                Name(id='response', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='llm', ctx=Load()),
                  attr='generate',
                  ctx=Load()),
                keywords=[
                  keyword(
                    arg='prompt',
                    value=Name(id='prompt', ctx=Load())),
                  keyword(
                    arg='temperature',
                    value=Subscript(
                      value=Name(id='section_cfg', ctx=Load()),
                      slice=Constant(value='temperature'),
                      ctx=Load())),
                  keyword(
                    arg='max_tokens',
                    value=Subscript(
                      value=Name(id='section_cfg', ctx=Load()),
                      slice=Constant(value='max_tokens'),
                      ctx=Load()))])),
            Assign(
              targets=[
                Name(id='post_process', ctx=Store())],
              value=Subscript(
                value=Name(id='section_cfg', ctx=Load()),
                slice=Constant(value='post_process'),
                ctx=Load())),
            If(
              test=Compare(
                left=Name(id='post_process', ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value='strip')]),
              body=[
                Return(
                  value=Call(
                    func=Attribute(
                      value=Name(id='response', ctx=Load()),
                      attr='strip',
                      ctx=Load())))],
              orelse=[
                If(
                  test=Compare(
                    left=Name(id='post_process', ctx=Load()),
                    ops=[
                      Eq()],
                    comparators=[
                      Constant(value='split')]),
                  body=[
                    Return(
                      value=ListComp(
                        elt=Call(
                          func=Attribute(
                            value=Name(id='s', ctx=Load()),
                            attr='strip',
                            ctx=Load())),
                        generators=[
                          comprehension(
                            target=Name(id='s', ctx=Store()),
                            iter=Call(
                              func=Attribute(
                                value=Name(id='response', ctx=Load()),
                                attr='split',
                                ctx=Load()),
                              args=[
                                Constant(value=',')]),
                            is_async=0)]))],
                  orelse=[
                    Return(
                      value=Name(id='response', ctx=Load()))])])],
          handlers=[
            ExceptHandler(
              type=Name(id='Exception', ctx=Load()),
              name='e',
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='logging', ctx=Load()),
                      attr='error',
                      ctx=Load()),
                    args=[
                      JoinedStr(
                        values=[
                          Constant(value='Failed to generate '),
                          FormattedValue(
                            value=Name(id='section_key', ctx=Load()),
                            conversion=-1),
                          Constant(value=': '),
                          FormattedValue(
                            value=Call(
                              func=Name(id='str', ctx=Load()),
                              args=[
                                Name(id='e', ctx=Load())]),
                            conversion=-1)])])),
                Return(
                  value=Constant(value=''))])])]),
