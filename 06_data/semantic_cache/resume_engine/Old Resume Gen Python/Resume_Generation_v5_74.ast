          value=Constant(value='JD must be provided to workflow (not None/empty)')),
        Assign(
          targets=[
            Name(id='E3_JD_PARSING_SUCCESS', ctx=Store())],
          value=Constant(value='JD must parse successfully')),
        Assign(
