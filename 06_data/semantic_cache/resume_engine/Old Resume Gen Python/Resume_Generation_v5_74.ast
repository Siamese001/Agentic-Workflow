      name='CircuitBreaker',
      body=[
        Expr(
          value=Constant(value='\n    Circuit breaker to prevent cascading failures.\n    v5.59: Protects API from sustained retry storms.\n    ')),
        FunctionDef(
          name='__init__',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='config',
                annotation=Name(id='RAGConfig', ctx=Load()))]),
