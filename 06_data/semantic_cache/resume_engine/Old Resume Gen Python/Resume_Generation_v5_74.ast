        FunctionDef(
          name='analyze',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='job_description',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Analyze job description with resilient web-search intelligence.\n        v5.59: Enhanced with 4-tier fallback hierarchy and telemetry.\n        \n        Fallback Hierarchy:\n        1. Full web RAG (all 3 phases)\n        2. Partial web RAG (any successful phases)\n        3. Hybrid (web RAG phases + local NLP fill-in)\n        4. Local NLP only\n        ')),
            If(
              test=UnaryOp(
                op=Not(),
                operand=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='enable_web_search',
                  ctx=Load())),
              body=[
                Return(
                  value=Call(
                    func=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='_analyze_local_nlp',
                      ctx=Load()),
                    args=[
                      Name(id='job_description', ctx=Load())]))]),
            Try(
              body=[
                Return(
                  value=Call(
                    func=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='_analyze_with_resilient_web_search',
                      ctx=Load()),
                    args=[
                      Name(id='job_description', ctx=Load())]))],
              handlers=[
                ExceptHandler(
                  type=Name(id='Exception', ctx=Load()),
                  name='e',
                  body=[
                    Import(
                      names=[
                        alias(name='logging')]),
