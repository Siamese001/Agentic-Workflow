          arg(
            arg='tolerance',
            annotation=Name(id='float', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Validate section length against master resume with tolerance.\n    v5.21: All content counts (company/title/dates/location included).\n    ')),
        Assign(
          targets=[
            Name(id='master_words', ctx=Store())],
          value=Call(
            func=Name(id='calculate_section_words', ctx=Load()),
            args=[
              Name(id='master_section', ctx=Load())])),
        Assign(
          targets=[
            Name(id='tailored_words', ctx=Store())],
          value=Call(
            func=Name(id='calculate_section_words', ctx=Load()),
            args=[
              Name(id='tailored_section', ctx=Load())])),
        Assign(
          targets=[
            Name(id='min_words', ctx=Store())],
          value=Call(
            func=Name(id='int', ctx=Load()),
            args=[
              BinOp(
                left=Name(id='master_words', ctx=Load()),
                op=Mult(),
                right=BinOp(
                  left=Constant(value=1),
                  op=Sub(),
                  right=Name(id='tolerance', ctx=Load())))])),
        Assign(
          targets=[
            Name(id='max_words', ctx=Store())],
          value=Call(
            func=Name(id='int', ctx=Load()),
            args=[
              BinOp(
                left=Name(id='master_words', ctx=Load()),
                op=Mult(),
                right=BinOp(
                  left=Constant(value=1),
                  op=Add(),
                  right=Name(id='tolerance', ctx=Load())))])),
        Assign(
          targets=[
            Name(id='passed', ctx=Store())],
          value=Compare(
            left=Name(id='min_words', ctx=Load()),
            ops=[
              LtE(),
              LtE()],
            comparators=[
              Name(id='tailored_words', ctx=Load()),
              Name(id='max_words', ctx=Load())])),
        Return(
          value=Call(
            func=Name(id='ValidationResult', ctx=Load()),
            keywords=[
              keyword(
                arg='rule_id',
                value=JoinedStr(
                  values=[
                    Constant(value='SECTION_LENGTH_'),
                    FormattedValue(
                      value=Call(
                        func=Attribute(
                          value=Call(
                            func=Attribute(
                              value=Name(id='company', ctx=Load()),
                              attr='upper',
                              ctx=Load())),
                          attr='replace',
                          ctx=Load()),
                        args=[
                          Constant(value=' '),
                          Constant(value='_')]),
                      conversion=-1)])),
              keyword(
                arg='passed',
                value=Name(id='passed', ctx=Load())),
              keyword(
                arg='severity',
                value=Attribute(
                  value=Name(id='ValidationSeverity', ctx=Load()),
                  attr='HIGH',
                  ctx=Load())),
              keyword(
                arg='message',
                value=JoinedStr(
                  values=[
                    FormattedValue(
                      value=Name(id='company', ctx=Load()),
                      conversion=-1),
                    Constant(value=': '),
                    FormattedValue(
                      value=Name(id='tailored_words', ctx=Load()),
                      conversion=-1),
                    Constant(value=' words (target: '),
                    FormattedValue(
                      value=Name(id='min_words', ctx=Load()),
                      conversion=-1),
                    Constant(value='-'),
                    FormattedValue(
                      value=Name(id='max_words', ctx=Load()),
                      conversion=-1),
                    Constant(value=')')])),
              keyword(
                arg='details',
                value=Dict(
                  keys=[
                    Constant(value='master_words'),
                    Constant(value='tailored_words'),
                    Constant(value='min_allowed'),
                    Constant(value='max_allowed')],
                  values=[
                    Name(id='master_words', ctx=Load()),
                    Name(id='tailored_words', ctx=Load()),
                    Name(id='min_words', ctx=Load()),
                    Name(id='max_words', ctx=Load())]))]))],
      returns=Name(id='ValidationResult', ctx=Load())),
    FunctionDef(
