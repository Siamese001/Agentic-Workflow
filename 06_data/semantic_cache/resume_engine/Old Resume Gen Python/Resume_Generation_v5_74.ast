              arg(
                arg='section_id',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Compute cosine similarity between overview and each bullet.\n        Per v1.9.2: K.5B/K.6B must have cosine <0.6 to their bullets.\n        ')),
            Assign(
              targets=[
                Name(id='results', ctx=Store())],
