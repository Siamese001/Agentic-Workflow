          value=IfExp(
            test=Attribute(
              value=Name(id='reasoning_config', ctx=Load()),
              attr='tot_branches',
              ctx=Load()),
            body=Attribute(
              value=Name(id='reasoning_config', ctx=Load()),
              attr='tot_branches',
              ctx=Load()),
            orelse=Constant(value=3))),
        Assign(
          targets=[
