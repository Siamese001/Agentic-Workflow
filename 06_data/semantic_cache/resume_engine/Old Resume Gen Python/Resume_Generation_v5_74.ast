                Return(
                  value=Constant(value=0.0))]),
            Try(
              body=[
                Assign(
                  targets=[
                    Name(id='differentiators', ctx=Store())],
                  value=Call(
                    func=Name(id='set', ctx=Load()),
                    args=[
                      Attribute(
                        value=Attribute(
                          value=Name(id='thematic_analysis', ctx=Load()),
                          attr='competitive_intelligence',
                          ctx=Load()),
                        attr='differentiator_keywords',
                        ctx=Load())])),
                Assign(
                  targets=[
                    Name(id='primary_words', ctx=Store())],
                  value=Call(
                    func=Name(id='set', ctx=Load()),
                    args=[
                      Call(
                        func=Attribute(
                          value=Attribute(
                            value=Name(id='thematic_analysis', ctx=Load()),
                            attr='primary_theme',
                            ctx=Load()),
                          attr='get',
                          ctx=Load()),
                        args=[
                          Constant(value='keywords'),
                          List(ctx=Load())])])),
                Assign(
                  targets=[
                    Name(id='all_jd_words', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='differentiators', ctx=Load()),
                      attr='union',
