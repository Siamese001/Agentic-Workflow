    FunctionDef(
      name='reasoning_config_to_api_params',
      args=arguments(
        args=[
          arg(
            arg='reasoning_config',
            annotation=Name(id='ReasoningConfig', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Convert reasoning toggle configuration to Claude API parameters.\n    \n    Maps abstract reasoning concepts to concrete API parameters:\n    - cot_min_paths, tot_branches, min_tot_depth, self_consistency → temperature\n    - Intensity score → max_tokens allocation\n    - All toggles → system prompt directive enhancements\n    \n    Hardening: Gracefully handles None/missing values with sensible defaults.\n    \n    Args:\n        reasoning_config: ReasoningConfig instance with toggle values\n        \n    Returns:\n        dict with keys:\n        - temperature (float 0.0-2.0)\n        - max_tokens (int)\n        - system_prompt_addendum (str) - reasoning directives\n        - intensity_score (float) - for logging/debugging\n        - reasoning_level (str) - for logging ("MINIMAL", "LOW", "MODERATE", "HIGH", "VERY_HIGH")\n    ')),
        Import(
          names=[
            alias(name='logging')]),
        Assign(
          targets=[
            Name(id='logger', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='logging', ctx=Load()),
              attr='getLogger',
              ctx=Load()),
            args=[
              Name(id='__name__', ctx=Load())])),
        Assign(
          targets=[
            Name(id='cot', ctx=Store())],
          value=IfExp(
            test=Attribute(
              value=Name(id='reasoning_config', ctx=Load()),
              attr='cot_min_paths',
              ctx=Load()),
            body=Attribute(
              value=Name(id='reasoning_config', ctx=Load()),
              attr='cot_min_paths',
              ctx=Load()),
            orelse=Constant(value=3))),
        Assign(
          targets=[
