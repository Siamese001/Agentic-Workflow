                values=[
                  Constant(value=0.7),
                  Constant(value=0.8),
                  Constant(value=0.2)]),
              Dict(
                keys=[
                  Constant(value='min'),
                  Constant(value='max'),
                  Constant(value='weight')],
                values=[
                  Constant(value=0.68),
                  Constant(value=0.78),
                  Constant(value=0.18)]),
              Dict(
                keys=[
                  Constant(value='min'),
                  Constant(value='max'),
                  Constant(value='weight')],
                values=[
                  Constant(value=0.65),
                  Constant(value=0.75),
                  Constant(value=0.12)]),
              Dict(
                keys=[
                  Constant(value='min'),
                  Constant(value='max'),
                  Constant(value='weight')],
                values=[
                  Constant(value=0.6),
                  Constant(value=0.7),
                  Constant(value=0.1)]),
              Dict(
                keys=[
                  Constant(value='min'),
                  Constant(value='max'),
                  Constant(value='weight')],
                values=[
                  Constant(value=0.75),
                  Constant(value=0.9),
                  Constant(value=0.1)]),
              Dict(
                keys=[
                  Constant(value='min'),
                  Constant(value='max'),
                  Constant(value='weight')],
                values=[
                  Constant(value=0.8),
                  Constant(value=0.95),
                  Constant(value=0.07)])])),
        Assign(
          targets=[
            Name(id='CRITICAL_THRESHOLDS', ctx=Store())],
          value=Dict(
            keys=[
              Constant(value='minimum_acceptable'),
              Constant(value='good_range'),
              Constant(value='excellent_range'),
              Constant(value='ai_detection_risk')],
            values=[
              Constant(value=0.7),
              Constant(value=0.73),
              Constant(value=0.76),
              Constant(value=0.9)])),
        FunctionDef(
          name='calculate_weighted_signal',
          args=arguments(
            args=[
              arg(arg='section_signals')]),
          body=[
            Expr(
              value=Constant(value='Calculate weighted signal average.')),
            Assign(
              targets=[
                Name(id='total_weight', ctx=Store())],
              value=Constant(value=0)),
            Assign(
              targets=[
                Name(id='weighted_sum', ctx=Store())],
              value=Constant(value=0)),
            For(
              target=Tuple(
                elts=[
                  Name(id='section', ctx=Store()),
                  Name(id='signal', ctx=Store())],
                ctx=Store()),
              iter=Call(
                func=Attribute(
                  value=Name(id='section_signals', ctx=Load()),
                  attr='items',
                  ctx=Load())),
              body=[
                If(
                  test=Compare(
                    left=Name(id='section', ctx=Load()),
                    ops=[
                      In()],
                    comparators=[
                      Attribute(
                        value=Name(id='SignalCalibrationConfig', ctx=Load()),
                        attr='SIGNAL_TARGETS',
                        ctx=Load())]),
                  body=[
                    Assign(
                      targets=[
                        Name(id='target', ctx=Store())],
                      value=Subscript(
                        value=Attribute(
                          value=Name(id='SignalCalibrationConfig', ctx=Load()),
                          attr='SIGNAL_TARGETS',
                          ctx=Load()),
                        slice=Name(id='section', ctx=Load()),
                        ctx=Load())),
                    Assign(
                      targets=[
                        Name(id='weight', ctx=Store())],
                      value=Subscript(
                        value=Name(id='target', ctx=Load()),
                        slice=Constant(value='weight'),
                        ctx=Load())),
                    AugAssign(
                      target=Name(id='total_weight', ctx=Store()),
                      op=Add(),
                      value=Name(id='weight', ctx=Load())),
                    AugAssign(
                      target=Name(id='weighted_sum', ctx=Store()),
                      op=Add(),
                      value=BinOp(
                        left=Name(id='signal', ctx=Load()),
                        op=Mult(),
                        right=Name(id='weight', ctx=Load())))])]),
            Assign(
              targets=[
                Name(id='weighted_avg', ctx=Store())],
              value=IfExp(
                test=Compare(
                  left=Name(id='total_weight', ctx=Load()),
                  ops=[
                    Gt()],
                  comparators=[
                    Constant(value=0)]),
                body=BinOp(
                  left=Name(id='weighted_sum', ctx=Load()),
                  op=Div(),
                  right=Name(id='total_weight', ctx=Load())),
