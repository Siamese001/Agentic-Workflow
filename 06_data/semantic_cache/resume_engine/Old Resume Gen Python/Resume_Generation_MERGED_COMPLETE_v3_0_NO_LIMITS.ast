                  Constant(value='Applied again to related role'),
                  Constant(value='Rejection reason documented')],
                ctx=Load())])),
        FunctionDef(
          name='validate_application',
          args=arguments(
            args=[
              arg(arg='app_data')]),
          body=[
            Expr(
              value=Constant(value='Validate an application entry.')),
            Assign(
              targets=[
                Name(id='validation_results', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='valid'),
                  Constant(value='checks_passed'),
                  Constant(value='total_checks'),
                  Constant(value='failures')],
                values=[
                  Constant(value=True),
                  Constant(value=0),
                  Call(
                    func=Name(id='len', ctx=Load()),
                    args=[
                      Attribute(
                        value=Name(id='AppTrackerQA', ctx=Load()),
                        attr='VALIDATION_GATES',
                        ctx=Load())]),
                  List(ctx=Load())])),
            If(
              test=UnaryOp(
                op=Not(),
                operand=Call(
                  func=Attribute(
                    value=Name(id='app_data', ctx=Load()),
                    attr='get',
                    ctx=Load()),
                  args=[
                    Constant(value='company_name')])),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Subscript(
                        value=Name(id='validation_results', ctx=Load()),
                        slice=Constant(value='failures'),
                        ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Constant(value='Missing company name')])),
                Assign(
                  targets=[
                    Subscript(
                      value=Name(id='validation_results', ctx=Load()),
                      slice=Constant(value='valid'),
                      ctx=Store())],
                  value=Constant(value=False))],
              orelse=[
                AugAssign(
                  target=Subscript(
                    value=Name(id='validation_results', ctx=Load()),
                    slice=Constant(value='checks_passed'),
                    ctx=Store()),
                  op=Add(),
                  value=Constant(value=1))]),
            If(
              test=UnaryOp(
                op=Not(),
                operand=Call(
                  func=Attribute(
                    value=Name(id='app_data', ctx=Load()),
                    attr='get',
                    ctx=Load()),
                  args=[
                    Constant(value='job_title')])),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Subscript(
                        value=Name(id='validation_results', ctx=Load()),
                        slice=Constant(value='failures'),
                        ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Constant(value='Missing job title')])),
                Assign(
                  targets=[
                    Subscript(
                      value=Name(id='validation_results', ctx=Load()),
                      slice=Constant(value='valid'),
                      ctx=Store())],
                  value=Constant(value=False))],
              orelse=[
                AugAssign(
                  target=Subscript(
                    value=Name(id='validation_results', ctx=Load()),
                    slice=Constant(value='checks_passed'),
                    ctx=Store()),
                  op=Add(),
                  value=Constant(value=1))]),
            Assign(
              targets=[
                Name(id='signal', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='app_data', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='signal_percentage'),
                  Constant(value=0)])),
            If(
              test=Compare(
                left=Name(id='signal', ctx=Load()),
                ops=[
                  Lt()],
                comparators=[
                  Constant(value=65)]),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Subscript(
                        value=Name(id='validation_results', ctx=Load()),
                        slice=Constant(value='failures'),
                        ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      JoinedStr(
                        values=[
                          Constant(value='Signal too low: '),
                          FormattedValue(
                            value=Name(id='signal', ctx=Load()),
                            conversion=-1),
                          Constant(value='%')])])),
                Assign(
                  targets=[
                    Subscript(
                      value=Name(id='validation_results', ctx=Load()),
                      slice=Constant(value='valid'),
                      ctx=Store())],
                  value=Constant(value=False))],
              orelse=[
                AugAssign(
                  target=Subscript(
                    value=Name(id='validation_results', ctx=Load()),
                    slice=Constant(value='checks_passed'),
                    ctx=Store()),
                  op=Add(),
                  value=Constant(value=1))]),
            If(
              test=UnaryOp(
                op=Not(),
                operand=Call(
                  func=Attribute(
                    value=Name(id='app_data', ctx=Load()),
                    attr='get',
                    ctx=Load()),
                  args=[
                    Constant(value='date_applied')])),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Subscript(
                        value=Name(id='validation_results', ctx=Load()),
                        slice=Constant(value='failures'),
                        ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Constant(value='Missing application date')])),
                Assign(
                  targets=[
                    Subscript(
                      value=Name(id='validation_results', ctx=Load()),
                      slice=Constant(value='valid'),
                      ctx=Store())],
                  value=Constant(value=False))],
              orelse=[
                AugAssign(
                  target=Subscript(
                    value=Name(id='validation_results', ctx=Load()),
                    slice=Constant(value='checks_passed'),
                    ctx=Store()),
                  op=Add(),
                  value=Constant(value=1))]),
            Assign(
              targets=[
                Name(id='status', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='app_data', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='status')])),
            If(
              test=Compare(
                left=Name(id='status', ctx=Load()),
                ops=[
                  NotIn()],
                comparators=[
                  Attribute(
                    value=Name(id='AppTrackerSchema', ctx=Load()),
                    attr='STATUS_WORKFLOW',
                    ctx=Load())]),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Subscript(
                        value=Name(id='validation_results', ctx=Load()),
                        slice=Constant(value='failures'),
                        ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      JoinedStr(
                        values=[
                          Constant(value='Invalid status: '),
                          FormattedValue(
                            value=Name(id='status', ctx=Load()),
                            conversion=-1)])])),
                Assign(
                  targets=[
                    Subscript(
                      value=Name(id='validation_results', ctx=Load()),
                      slice=Constant(value='valid'),
                      ctx=Store())],
                  value=Constant(value=False))],
              orelse=[
                AugAssign(
                  target=Subscript(
                    value=Name(id='validation_results', ctx=Load()),
                    slice=Constant(value='checks_passed'),
                    ctx=Store()),
                  op=Add(),
                  value=Constant(value=1))]),
            Return(
              value=Name(id='validation_results', ctx=Load()))],
          decorator_list=[
            Name(id='staticmethod', ctx=Load())])]),
    ClassDef(
      name='HyphenationRules',
      body=[
        Expr(
          value=Constant(value='Formatting and hyphenation rules for consistent resume formatting.')),
        Assign(
          targets=[
            Name(id='PHONE_PATTERN', ctx=Store())],
          value=Constant(value='(\\d{3})(\\d{3})(\\d{4})')),
        Assign(
          targets=[
            Name(id='PHONE_FORMAT', ctx=Store())],
          value=Constant(value='+1-\\1-\\2-\\3')),
        Assign(
          targets=[
            Name(id='DATE_PATTERNS', ctx=Store())],
          value=Dict(
            keys=[
              Constant(value='month_year'),
              Constant(value='full_date')],
            values=[
              Constant(value='(?:January|February|March|April|May|June|July|August|September|October|November|December)\\s+\\d{4}'),
              Constant(value='(?:January|February|March|April|May|June|July|August|September|October|November|December)\\s+\\d{1,2},?\\s+\\d{4}')])),
        FunctionDef(
          name='format_phone',
          args=arguments(
            args=[
              arg(arg='phone_str')]),
          body=[
            Expr(
              value=Constant(value='Format phone number to +1-XXX-XXX-XXXX.')),
            Assign(
              targets=[
                Name(id='digits_only', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='re', ctx=Load()),
                  attr='sub',
                  ctx=Load()),
                args=[
                  Constant(value='\\D'),
                  Constant(value=''),
                  Name(id='phone_str', ctx=Load())])),
            If(
              test=Compare(
                left=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Name(id='digits_only', ctx=Load())]),
                ops=[
                  NotEq()],
                comparators=[
                  Constant(value=10)]),
              body=[
                Return(
                  value=Name(id='phone_str', ctx=Load()))]),
            Return(
              value=Call(
                func=Attribute(
                  value=Name(id='re', ctx=Load()),
                  attr='sub',
                  ctx=Load()),
                args=[
                  Attribute(
                    value=Name(id='HyphenationRules', ctx=Load()),
                    attr='PHONE_PATTERN',
                    ctx=Load()),
                  Attribute(
                    value=Name(id='HyphenationRules', ctx=Load()),
                    attr='PHONE_FORMAT',
                    ctx=Load()),
                  Name(id='digits_only', ctx=Load())]))],
          decorator_list=[
            Name(id='staticmethod', ctx=Load())]),
        FunctionDef(
          name='validate_phone',
          args=arguments(
            args=[
              arg(arg='phone_str')]),
          body=[
            Expr(
              value=Constant(value='Validate phone format.')),
            Return(
              value=Call(
                func=Name(id='bool', ctx=Load()),
                args=[
                  Call(
                    func=Attribute(
                      value=Name(id='re', ctx=Load()),
                      attr='match',
                      ctx=Load()),
                    args=[
                      Constant(value='^\\+1-\\d{3}-\\d{3}-\\d{4}$'),
                      Name(id='phone_str', ctx=Load())])]))],
          decorator_list=[
            Name(id='staticmethod', ctx=Load())]),
        FunctionDef(
          name='format_currency',
          args=arguments(
            args=[
              arg(arg='amount')]),
          body=[
            Expr(
              value=Constant(value='Format currency with commas.')),
            Return(
              value=JoinedStr(
                values=[
                  Constant(value='$'),
                  FormattedValue(
                    value=Name(id='amount', ctx=Load()),
                    conversion=-1,
                    format_spec=JoinedStr(
                      values=[
                        Constant(value=',.0f')]))]))],
          decorator_list=[
            Name(id='staticmethod', ctx=Load())]),
        FunctionDef(
          name='format_percentage',
          args=arguments(
            args=[
              arg(arg='value')]),
          body=[
            Expr(
              value=Constant(value='Format percentage.')),
            Return(
              value=JoinedStr(
                values=[
                  FormattedValue(
                    value=Name(id='value', ctx=Load()),
                    conversion=-1,
                    format_spec=JoinedStr(
                      values=[
                        Constant(value='.1%')]))]))],
          decorator_list=[
            Name(id='staticmethod', ctx=Load())]),
        FunctionDef(
          name='format_date',
          args=arguments(
            args=[
              arg(arg='date_str')]),
          body=[
            Expr(
              value=Constant(value="Format date to 'Month YYYY' format.")),
            If(
              test=Compare(
                left=Name(id='date_str', ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value='Present')]),
              body=[
                Return(
                  value=Constant(value='Present'))]),
            Return(
              value=Name(id='date_str', ctx=Load()))],
          decorator_list=[
            Name(id='staticmethod', ctx=Load())])]),
    ClassDef(
      name='SignalCalibrationConfig',
      body=[
        Expr(
          value=Constant(value='Signal calibration configuration with weighted targets.')),
        Assign(
          targets=[
            Name(id='SIGNAL_TARGETS', ctx=Store())],
          value=Dict(
            keys=[
              Constant(value='K1_exec_summary'),
              Constant(value='K4_headline'),
