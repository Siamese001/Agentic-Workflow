                ops=[
                  GtE()],
                comparators=[
                  Constant(value=4)]),
              body=[
                AugAssign(
                  target=Name(id='addendum', ctx=Store()),
                  op=Add(),
                  value=JoinedStr(
                    values=[
                      Constant(value='• Explore '),
