      returns=Name(id='str', ctx=Load())),
    FunctionDef(
      name='enhance_system_prompt_with_reasoning',
      args=arguments(
        args=[
          arg(
            arg='base_system_prompt',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='reasoning_config',
            annotation=Name(id='ReasoningConfig', ctx=Load())),
          arg(
            arg='section_id',
            annotation=Name(id='str', ctx=Load()))],
        defaults=[
          Constant(value='UNKNOWN')]),
      body=[
        Expr(
          value=Constant(value='\n    Enhance a system prompt with reasoning configuration directives.\n    \n    Args:\n        base_system_prompt: Original system prompt (e.g., "You are an expert...")\n        reasoning_config: ReasoningConfig instance\n        section_id: For logging (e.g., "K.1", "K.4")\n        \n    Returns:\n        Enhanced system prompt with reasoning directives appended\n    ')),
        Assign(
          targets=[
            Name(id='api_params', ctx=Store())],
          value=Call(
