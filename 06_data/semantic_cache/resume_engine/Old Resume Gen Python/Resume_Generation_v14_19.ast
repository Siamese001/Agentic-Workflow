    FunctionDef(
      name='_calculate_reasoning_intensity',
      args=arguments(
        args=[
          arg(
            arg='params',
            annotation=Name(id='Dict', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='Calculates a numeric intensity score and a qualitative level from reasoning parameters.')),
        Assign(
          targets=[
            Name(id='weights', ctx=Store())],
          value=Attribute(
            value=Name(id='REASONING_INTENSITY_CONFIG', ctx=Load()),
            attr='WEIGHTS',
            ctx=Load())),
        Assign(
          targets=[
            Name(id='intensity', ctx=Store())],
          value=BinOp(
            left=BinOp(
              left=BinOp(
                left=BinOp(
                  left=Call(
                    func=Attribute(
                      value=Name(id='params', ctx=Load()),
                      attr='get',
                      ctx=Load()),
                    args=[
                      Constant(value='cot'),
                      Constant(value=0)]),
                  op=Mult(),
                  right=Call(
                    func=Attribute(
                      value=Name(id='weights', ctx=Load()),
                      attr='get',
                      ctx=Load()),
                    args=[
                      Constant(value='cot'),
                      Constant(value=2.0)])),
                op=Add(),
                right=BinOp(
                  left=Call(
                    func=Attribute(
                      value=Name(id='params', ctx=Load()),
                      attr='get',
                      ctx=Load()),
                    args=[
                      Constant(value='tot_b'),
                      Constant(value=0)]),
                  op=Mult(),
                  right=Call(
                    func=Attribute(
                      value=Name(id='weights', ctx=Load()),
                      attr='get',
                      ctx=Load()),
                    args=[
                      Constant(value='tot_b'),
                      Constant(value=2.0)]))),
              op=Add(),
              right=BinOp(
                left=Call(
                  func=Attribute(
                    value=Name(id='params', ctx=Load()),
                    attr='get',
                    ctx=Load()),
                  args=[
                    Constant(value='tot_d'),
                    Constant(value=0)]),
                op=Mult(),
                right=Call(
                  func=Attribute(
                    value=Name(id='weights', ctx=Load()),
                    attr='get',
                    ctx=Load()),
                  args=[
                    Constant(value='tot_d'),
                    Constant(value=2.0)]))),
            op=Add(),
            right=BinOp(
              left=Call(
                func=Attribute(
                  value=Name(id='params', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='sc'),
                  Constant(value=0)]),
              op=Mult(),
              right=Call(
                func=Attribute(
                  value=Name(id='weights', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='sc'),
                  Constant(value=0.2)])))),
        Assign(
          targets=[
            Name(id='level', ctx=Store())],
          value=Constant(value='MINIMAL')),
        For(
          target=Tuple(
            elts=[
              Name(id='level_name', ctx=Store()),
              Name(id='threshold', ctx=Store())],
            ctx=Store()),
          iter=Attribute(
            value=Name(id='REASONING_INTENSITY_CONFIG', ctx=Load()),
            attr='THRESHOLDS',
            ctx=Load()),
          body=[
            If(
              test=Compare(
                left=Name(id='intensity', ctx=Load()),
                ops=[
                  GtE()],
                comparators=[
                  Name(id='threshold', ctx=Load())]),
              body=[
                Assign(
                  targets=[
                    Name(id='level', ctx=Store())],
                  value=Name(id='level_name', ctx=Load())),
                Break()])]),
        Return(
          value=Tuple(
            elts=[
              Name(id='intensity', ctx=Load()),
              Name(id='level', ctx=Load())],
            ctx=Load()))],
      returns=Subscript(
        value=Name(id='Tuple', ctx=Load()),
        slice=Tuple(
          elts=[
            Name(id='float', ctx=Load()),
            Name(id='str', ctx=Load())],
          ctx=Load()),
        ctx=Load())),
    FunctionDef(
      name='_get_generation_temperature',
      args=arguments(),
      body=[
        Expr(
          value=Constant(value="\n    [OPTIMIZED FOR CREATIVITY]\n    This version maximizes temperature to promote creative and unique output,\n    while the workflow's Reasoning Intensity (CoT, ToT) maintains signal/relevance.\n    The 'intensity' parameter was previously unused, so it has been removed.\n    ")),
        Return(
          value=Constant(value=0.9))],
      returns=Name(id='float', ctx=Load())),
    FunctionDef(
      name='_allocate_tokens_from_depth',
      args=arguments(
        args=[
          arg(
            arg='tot_d',
            annotation=Name(id='int', ctx=Load())),
          arg(
            arg='cot',
            annotation=Name(id='int', ctx=Load())),
          arg(
            arg='sc',
            annotation=Name(id='int', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    [REVISED FOR OPTION B]\n    Allocates max_tokens based on reasoning depth and complexity, providing\n    higher limits for more complex reasoning tasks.\n    ')),
        Assign(
          targets=[
            Name(id='base_limit', ctx=Store())],
          value=Constant(value=16384)),
        Assign(
          targets=[
            Name(id='high_sc_limit', ctx=Store())],
          value=Constant(value=24000)),
        Assign(
          targets=[
            Name(id='mid_complex_limit', ctx=Store())],
          value=Constant(value=26000)),
        Assign(
          targets=[
            Name(id='high_complex_limit', ctx=Store())],
          value=Constant(value=28000)),
        Assign(
          targets=[
            Name(id='max_complex_limit', ctx=Store())],
          value=Constant(value=30000)),
        If(
          test=Compare(
            left=Name(id='tot_d', ctx=Load()),
            ops=[
              GtE()],
            comparators=[
              Constant(value=4)]),
          body=[
            Assign(
              targets=[
                Name(id='max_tokens', ctx=Store())],
              value=Name(id='max_complex_limit', ctx=Load()))],
          orelse=[
            If(
              test=BoolOp(
                op=And(),
                values=[
                  Compare(
                    left=Name(id='tot_d', ctx=Load()),
                    ops=[
                      GtE()],
                    comparators=[
                      Constant(value=3)]),
                  Compare(
                    left=Name(id='cot', ctx=Load()),
                    ops=[
                      GtE()],
                    comparators=[
                      Constant(value=5)])]),
              body=[
                Assign(
                  targets=[
                    Name(id='max_tokens', ctx=Store())],
                  value=Name(id='high_complex_limit', ctx=Load()))],
              orelse=[
                If(
                  test=BoolOp(
                    op=Or(),
                    values=[
                      Compare(
                        left=Name(id='tot_d', ctx=Load()),
                        ops=[
                          GtE()],
                        comparators=[
                          Constant(value=3)]),
                      Compare(
                        left=Name(id='cot', ctx=Load()),
                        ops=[
                          GtE()],
                        comparators=[
                          Constant(value=5)])]),
                  body=[
                    Assign(
                      targets=[
                        Name(id='max_tokens', ctx=Store())],
                      value=Name(id='mid_complex_limit', ctx=Load()))],
                  orelse=[
                    If(
                      test=Compare(
                        left=Name(id='sc', ctx=Load()),
                        ops=[
                          GtE()],
                        comparators=[
                          Constant(value=15)]),
                      body=[
                        Assign(
                          targets=[
                            Name(id='max_tokens', ctx=Store())],
                          value=Name(id='high_sc_limit', ctx=Load()))],
                      orelse=[
                        Assign(
                          targets=[
                            Name(id='max_tokens', ctx=Store())],
                          value=Name(id='base_limit', ctx=Load()))])])])]),
        Assign(
          targets=[
            Name(id='rag_config_max', ctx=Store())],
          value=Constant(value=30000)),
        Return(
          value=Call(
            func=Name(id='max', ctx=Load()),
            args=[
              Name(id='base_limit', ctx=Load()),
              Call(
                func=Name(id='min', ctx=Load()),
                args=[
                  Name(id='max_tokens', ctx=Load()),
                  Name(id='rag_config_max', ctx=Load())])]))],
      returns=Name(id='int', ctx=Load())),
    FunctionDef(
      name='_build_reasoning_prompt_addendum',
      args=arguments(
        args=[
          arg(
            arg='params',
