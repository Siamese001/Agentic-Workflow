        FunctionDef(
          name='_calculate_cross_section_similarity_details',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Calculates pairwise similarity between key sections and caches details.')),
            Assign(
              targets=[
                Name(id='details', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='failures'),
                  Constant(value='checked_pairs'),
                  Constant(value='max_similarity'),
                  Constant(value='scores')],
                values=[
                  List(ctx=Load()),
                  Constant(value=0),
                  Constant(value=0.0),
                  Dict()])),
            Assign(
              targets=[
                Name(id='threshold', ctx=Store())],
              value=Constant(value=0.65)),
            Assign(
              targets=[
                Name(id='sections_to_compare', ctx=Store())],
              value=List(
                elts=[
                  Attribute(
                    value=Name(id='ResumeSection', ctx=Load()),
                    attr='K1_EXECUTIVE_SUMMARY',
                    ctx=Load()),
                  Attribute(
                    value=Name(id='ResumeSection', ctx=Load()),
                    attr='K2_UNIFY_OVERVIEW',
                    ctx=Load()),
                  Attribute(
                    value=Name(id='ResumeSection', ctx=Load()),
                    attr='K3_IBM_OVERVIEW',
                    ctx=Load()),
                  Attribute(
                    value=Name(id='ResumeSection', ctx=Load()),
                    attr='K4_TRADERSENSE_NARRATIVE',
                    ctx=Load()),
                  Attribute(
                    value=Name(id='ResumeSection', ctx=Load()),
                    attr='K5_EY_NARRATIVE',
                    ctx=Load()),
                  Attribute(
                    value=Name(id='ResumeSection', ctx=Load()),
                    attr='K6_EARLY_CAREER_NARRATIVE',
                    ctx=Load()),
                  Attribute(
                    value=Name(id='ResumeSection', ctx=Load()),
                    attr='K9_COMPETENCIES',
                    ctx=Load())],
                ctx=Load())),
            Assign(
              targets=[
                Name(id='section_content', ctx=Store())],
              value=Dict()),
            For(
              target=Name(id='section_enum', ctx=Store()),
              iter=Name(id='sections_to_compare', ctx=Load()),
              body=[
                Assign(
                  targets=[
                    Name(id='content', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='staging_buffer',
                        ctx=Load()),
                      attr='get',
                      ctx=Load()),
                    args=[
                      Attribute(
                        value=Name(id='section_enum', ctx=Load()),
                        attr='value',
                        ctx=Load())])),
                If(
                  test=BoolOp(
                    op=And(),
                    values=[
                      Call(
                        func=Name(id='isinstance', ctx=Load()),
                        args=[
                          Name(id='content', ctx=Load()),
                          Name(id='list', ctx=Load())]),
                      Compare(
                        left=Name(id='section_enum', ctx=Load()),
                        ops=[
                          Eq()],
                        comparators=[
                          Attribute(
                            value=Name(id='ResumeSection', ctx=Load()),
                            attr='K9_COMPETENCIES',
                            ctx=Load())])]),
                  body=[
                    Assign(
                      targets=[
                        Name(id='text_list', ctx=Store())],
                      value=ListComp(
                        elt=IfExp(
                          test=Call(
                            func=Name(id='isinstance', ctx=Load()),
                            args=[
                              Name(id='item', ctx=Load()),
                              Name(id='dict', ctx=Load())]),
                          body=Call(
                            func=Attribute(
                              value=Name(id='item', ctx=Load()),
                              attr='get',
                              ctx=Load()),
                            args=[
                              Constant(value='text'),
                              Call(
                                func=Name(id='str', ctx=Load()),
                                args=[
                                  Name(id='item', ctx=Load())])]),
                          orelse=Call(
                            func=Name(id='str', ctx=Load()),
                            args=[
                              Name(id='item', ctx=Load())])),
                        generators=[
                          comprehension(
                            target=Name(id='item', ctx=Store()),
                            iter=Name(id='content', ctx=Load()),
                            is_async=0)])),
                    Assign(
                      targets=[
                        Subscript(
                          value=Name(id='section_content', ctx=Load()),
                          slice=Name(id='section_enum', ctx=Load()),
                          ctx=Store())],
                      value=Call(
                        func=Attribute(
                          value=Constant(value='\n'),
                          attr='join',
                          ctx=Load()),
                        args=[
                          Name(id='text_list', ctx=Load())]))],
                  orelse=[
                    If(
                      test=Call(
                        func=Name(id='isinstance', ctx=Load()),
                        args=[
                          Name(id='content', ctx=Load()),
                          Name(id='str', ctx=Load())]),
                      body=[
                        Assign(
                          targets=[
                            Subscript(
                              value=Name(id='section_content', ctx=Load()),
                              slice=Name(id='section_enum', ctx=Load()),
                              ctx=Store())],
                          value=Name(id='content', ctx=Load()))])])]),
            Assign(
              targets=[
                Name(id='max_sim', ctx=Store())],
              value=Constant(value=0.0)),
            For(
              target=Name(id='i', ctx=Store()),
              iter=Call(
