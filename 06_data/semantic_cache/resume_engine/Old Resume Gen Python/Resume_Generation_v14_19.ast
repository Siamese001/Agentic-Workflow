        FunctionDef(
          name='_calculate_cover_letter_jd_similarity',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Calculates cosine similarity between cover letter (K.11) and JD.')),
            Assign(
              targets=[
                Name(id='cover_letter_text', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='staging_buffer',
                    ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Attribute(
                    value=Attribute(
                      value=Name(id='ResumeSection', ctx=Load()),
                      attr='K11_COVER_LETTER',
                      ctx=Load()),
                    attr='value',
                    ctx=Load()),
                  Constant(value='')])),
            Assign(
              targets=[
                Name(id='similarity', ctx=Store())],
              value=Constant(value=0.0)),
            If(
              test=BoolOp(
                op=And(),
                values=[
                  Name(id='cover_letter_text', ctx=Load()),
                  Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='job_description',
                    ctx=Load())]),
              body=[
                Try(
                  body=[
                    Assign(
                      targets=[
                        Name(id='similarity', ctx=Store())],
                      value=Call(
                        func=Attribute(
                          value=Attribute(
                            value=Name(id='self', ctx=Load()),
                            attr='dup_detector',
                            ctx=Load()),
                          attr='_calculate_cosine_similarity',
                          ctx=Load()),
                        args=[
                          Name(id='cover_letter_text', ctx=Load()),
                          Attribute(
                            value=Name(id='self', ctx=Load()),
                            attr='job_description',
                            ctx=Load())]))],
                  handlers=[
                    ExceptHandler(
                      type=Name(id='Exception', ctx=Load()),
                      name='e',
                      body=[
                        Expr(
                          value=Call(
                            func=Attribute(
                              value=Attribute(
                                value=Name(id='self', ctx=Load()),
                                attr='logger',
                                ctx=Load()),
                              attr='warning',
                              ctx=Load()),
                            args=[
                              JoinedStr(
                                values=[
                                  Constant(value='Error calculating cover letter similarity: '),
                                  FormattedValue(
                                    value=Name(id='e', ctx=Load()),
                                    conversion=-1)])])),
                        Assign(
                          targets=[
                            Name(id='similarity', ctx=Store())],
                          value=Constant(value=0.0))])])]),
            Assign(
              targets=[
                Name(id='details', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='cover_letter_jd_similarity'),
                  Constant(value='min_sim'),
                  Constant(value='max_sim')],
                values=[
                  Name(id='similarity', ctx=Load()),
                  Attribute(
                    value=Name(id='ContentConstraintsConfig', ctx=Load()),
                    attr='COVER_LETTER_JD_RELEVANCE_THRESHOLD',
                    ctx=Load()),
                  Attribute(
                    value=Name(id='SignalControlConfig', ctx=Load()),
                    attr='CL_MAX_JD_SIMILARITY',
                    ctx=Load())])),
            Assign(
              targets=[
                Subscript(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='_cache',
                    ctx=Load()),
                  slice=Constant(value='VG_COVER_LETTER_RELEVANCE_RANGE'),
                  ctx=Store())],
              value=Name(id='details', ctx=Load())),
            Return(
              value=Name(id='similarity', ctx=Load()))]),
        FunctionDef(
          name='_calculate_expected_signature',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Calculates the expected cover letter signature block.')),
            Assign(
              targets=[
                Name(id='owner_info', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='master_resume',
                    ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='owner'),
                  Dict()])),
            Assign(
              targets=[
                Name(id='contact_info', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='owner_info', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='contact'),
                  Dict()])),
            If(
              test=Compare(
                left=Constant(value='COVER_LETTER_SIGNATURE_TEMPLATE'),
                ops=[
                  NotIn()],
                comparators=[
                  Call(
                    func=Name(id='globals', ctx=Load()))]),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='logger',
                        ctx=Load()),
                      attr='error',
                      ctx=Load()),
                    args=[
                      Constant(value='COVER_LETTER_SIGNATURE_TEMPLATE not found!')])),
                Return(
                  value=Constant(value='[Signature Template Missing]'))]),
            Try(
              body=[
                Return(
                  value=Call(
                    func=Attribute(
                      value=Call(
                        func=Attribute(
                          value=Name(id='COVER_LETTER_SIGNATURE_TEMPLATE', ctx=Load()),
                          attr='format',
                          ctx=Load()),
                        keywords=[
                          keyword(
                            arg='name',
                            value=Call(
                              func=Attribute(
                                value=Name(id='owner_info', ctx=Load()),
                                attr='get',
                                ctx=Load()),
                              args=[
                                Constant(value='name'),
                                Constant(value='[Your Name]')])),
                          keyword(
                            arg='email',
                            value=Call(
