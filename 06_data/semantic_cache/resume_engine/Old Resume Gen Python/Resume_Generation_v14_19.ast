                ops=[
                  GtE()],
                comparators=[
                  Constant(value=4)]),
              body=[
                AugAssign(
                  target=Name(id='addendum', ctx=Store()),
                  op=Add(),
                  value=JoinedStr(
                    values=[
                      Constant(value='• Provide '),
                      FormattedValue(
                        value=Subscript(
                          value=Name(id='p', ctx=Load()),
                          slice=Constant(value='tot_d'),
                          ctx=Load()),
                        conversion=-1),
                      Constant(value='-level deep reasoning: foundation → intermediate → advanced → synthesis.\n')]))],
              orelse=[
                If(
                  test=Compare(
                    left=Subscript(
                      value=Name(id='p', ctx=Load()),
                      slice=Constant(value='tot_d'),
                      ctx=Load()),
                    ops=[
                      GtE()],
                    comparators=[
                      Constant(value=3)]),
                  body=[
                    AugAssign(
                      target=Name(id='addendum', ctx=Store()),
                      op=Add(),
                      value=JoinedStr(
                        values=[
                          Constant(value='• Provide '),
