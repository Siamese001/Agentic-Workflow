        FunctionDef(
          name='_build_pre_rag_analysis_prompt',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='job_description',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Builds the prompt for the HOP -0.5 LLM call to extract entities and find gaps.\n        ')),
            Assign(
              targets=[
                Name(id='resume_text', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='json', ctx=Load()),
                  attr='dumps',
                  ctx=Load()),
                args=[
                  Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='master_resume',
                        ctx=Load()),
                      attr='get',
                      ctx=Load()),
                    args=[
                      Constant(value='professional_experience'),
                      List(ctx=Load())])])),
            Return(
              value=JoinedStr(
                values=[
                  Constant(value="You are a hyper-efficient HR intelligence analyst. Your task is to perform a differential analysis between a job description (JD) and a candidate's master resume. Extract key entities and identify the signal gap and overlap.\n\n**JOB DESCRIPTION:**\n---\n"),
                  FormattedValue(
                    value=Subscript(
                      value=Name(id='job_description', ctx=Load()),
                      slice=Slice(
                        upper=Constant(value=2500)),
                      ctx=Load()),
                    conversion=-1),
                  Constant(value='\n---\n\n**CANDIDATE MASTER RESUME (Experience Section):**\n---\n'),
                  FormattedValue(
                    value=Subscript(
                      value=Name(id='resume_text', ctx=Load()),
                      slice=Slice(
                        upper=Constant(value=2500)),
                      ctx=Load()),
                    conversion=-1),
                  Constant(value='\n---\n\n**TASK:**\nAnalyze both texts and return a single, valid JSON object with the following structure.\n1.  **Extract entities from the JD:**\n    - `target_company_name`: The name of the hiring company.\n    - `precise_role_title`: The exact job title.\n    - `key_technologies`: Top 5-7 specific technologies, frameworks, or platforms mentioned (e.g., "Agentic platform", "GenAI engineering", "AWS Bedrock").\n    - `core_responsibilities`: Top 3-5 core duties or focus areas (e.g., "post-sales adoption", "customer retention", "strategic partnerships").\n2.  **Extract entities from the Resume:**\n    - `candidate_skills`: Top 10-15 skills and technologies the candidate emphasizes.\n3.  **Perform Differential Analysis:**\n    - `signal_gap_keywords`: Keywords from `key_technologies` that are **MISSING** from `candidate_skills`. This is the most important output.\n    - `signal_overlap_keywords`: Keywords that appear in **BOTH** `key_technologies` and `candidate_skills`.\n\n**OUTPUT FORMAT (JSON ONLY):**\n```json\n{\n  "jd_entities": {\n    "target_company_name": "<string>",\n    "precise_role_title": "<string>",\n    "key_technologies": ["<string>", ...],\n    "core_responsibilities": ["<string>", ...]\n  },\n  "resume_entities": {\n    "candidate_skills": ["<string>", ...]\n  },\n  "differential_analysis": {\n    "signal_gap_keywords": ["<string>", ...],\n    "signal_overlap_keywords": ["<string>", ...]\n  }\n}\n```\n\nCRITICAL: Return only the JSON object. Do not include any preamble, explanation, or markdown formatting outside of the JSON block.\n')]))],
          returns=Name(id='str', ctx=Load())),
        FunctionDef(
          name='_execute_pre_rag_analysis',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='job_description',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        HOP -0.5: Perform entity extraction and differential analysis.\n        v8.10: Uses a single, optimized LLM call for entity extraction.\n        NOTE: Assumes this makes 1 API call for simplicity in tracking for now.\n              Could be refined to get exact count from search_and_analyze if needed.\n        ')),
            Import(
              names=[
                alias(name='logging')]),
            Assign(
              targets=[
                Name(id='logger', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='logging', ctx=Load()),
                  attr='getLogger',
                  ctx=Load()),
                args=[
                  Name(id='__name__', ctx=Load())])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='logger', ctx=Load()),
                  attr='info',
                  ctx=Load()),
                args=[
                  Constant(value='Executing HOP -0.5: Pre-RAG Differential Analysis...')])),
            Assign(
              targets=[
                Name(id='prompt', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='_build_pre_rag_analysis_prompt',
                  ctx=Load()),
                args=[
                  Name(id='job_description', ctx=Load())])),
            Assign(
              targets=[
                Tuple(
                  elts=[
                    Name(id='analysis_json', ctx=Store()),
                    Name(id='pre_rag_calls', ctx=Store())],
                  ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='gemini_client',
                    ctx=Load()),
                  attr='search_and_analyze',
                  ctx=Load()),
                args=[
                  Name(id='prompt', ctx=Load()),
                  Constant(value='Pre-RAG Analysis')])),
            AugAssign(
              target=Attribute(
                value=Name(id='self', ctx=Load()),
                attr='total_api_calls_hop0',
                ctx=Store()),
              op=Add(),
              value=Name(id='pre_rag_calls', ctx=Load())),
            Assign(
              targets=[
                Name(id='mission', ctx=Store())],
              value=Call(
                func=Name(id='RAGMission', ctx=Load()),
                keywords=[
                  keyword(
                    arg='target_company_name',
                    value=Subscript(
                      value=Subscript(
                        value=Name(id='analysis_json', ctx=Load()),
                        slice=Constant(value='jd_entities'),
                        ctx=Load()),
                      slice=Constant(value='target_company_name'),
                      ctx=Load())),
                  keyword(
                    arg='precise_role_title',
                    value=Subscript(
                      value=Subscript(
                        value=Name(id='analysis_json', ctx=Load()),
                        slice=Constant(value='jd_entities'),
                        ctx=Load()),
                      slice=Constant(value='precise_role_title'),
                      ctx=Load())),
                  keyword(
                    arg='key_technologies',
                    value=Subscript(
                      value=Subscript(
                        value=Name(id='analysis_json', ctx=Load()),
                        slice=Constant(value='jd_entities'),
                        ctx=Load()),
                      slice=Constant(value='key_technologies'),
                      ctx=Load())),
                  keyword(
                    arg='core_responsibilities',
                    value=Subscript(
                      value=Subscript(
                        value=Name(id='analysis_json', ctx=Load()),
                        slice=Constant(value='jd_entities'),
                        ctx=Load()),
                      slice=Constant(value='core_responsibilities'),
                      ctx=Load())),
                  keyword(
                    arg='signal_gap_keywords',
                    value=Subscript(
                      value=Subscript(
                        value=Name(id='analysis_json', ctx=Load()),
                        slice=Constant(value='differential_analysis'),
                        ctx=Load()),
                      slice=Constant(value='signal_gap_keywords'),
                      ctx=Load())),
                  keyword(
                    arg='signal_overlap_keywords',
                    value=Subscript(
                      value=Subscript(
                        value=Name(id='analysis_json', ctx=Load()),
                        slice=Constant(value='differential_analysis'),
                        ctx=Load()),
                      slice=Constant(value='signal_overlap_keywords'),
                      ctx=Load()))])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='logger', ctx=Load()),
                  attr='info',
                  ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='  ✓ RAG Mission defined. Gap keywords: '),
                      FormattedValue(
                        value=Attribute(
                          value=Name(id='mission', ctx=Load()),
                          attr='signal_gap_keywords',
                          ctx=Load()),
                        conversion=-1)])])),
            Return(
              value=Name(id='mission', ctx=Load()))],
          returns=Name(id='RAGMission', ctx=Load())),
        FunctionDef(
          name='_analyze_with_resilient_web_search',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='job_description',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        v11.60 Final Fix: Added JSON roundtrip conversion before synthesis & caching.\n        NOW returns a tuple: (ThematicAnalysis, total_api_calls_this_hop)\n        ')),
            Import(
              names=[
