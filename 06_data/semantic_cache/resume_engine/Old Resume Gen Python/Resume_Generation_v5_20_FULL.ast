                      value=Call(
                        func=Attribute(
                          value=Name(id='lvl', ctx=Load()),
                          attr='title',
                          ctx=Load()))),
                    Break()])]),
            If(
              test=BoolOp(
                op=And(),
                values=[
                  Name(id='role_type', ctx=Load()),
                  Name(id='level', ctx=Load())]),
              body=[
                Return(
                  value=JoinedStr(
                    values=[
                      FormattedValue(
