                If(
                  test=Call(
                    func=Attribute(
                      value=Name(id='re', ctx=Load()),
                      attr='search',
                      ctx=Load()),
                    args=[
                      Constant(value='engineering|software|development'),
                      Name(id='jd_lower', ctx=Load())]),
