        FunctionDef(
          name='_classify_role',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Classify role type and seniority.')),
            Assign(
              targets=[
                Name(id='jd_lower', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='jd_text',
                    ctx=Load()),
                  attr='lower',
                  ctx=Load()))),
            If(
              test=Call(
                func=Attribute(
                  value=Name(id='re', ctx=Load()),
                  attr='search',
                  ctx=Load()),
                args=[
                  Constant(value='pre[-\\s]?sales|solutions? engineer'),
