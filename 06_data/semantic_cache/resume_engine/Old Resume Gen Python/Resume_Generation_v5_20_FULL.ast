                                  value=Name(id='re', ctx=Load()),
                                  attr='search',
                                  ctx=Load()),
                                args=[
                                  Constant(value='sales'),
                                  Name(id='jd_lower', ctx=Load())]),
                              body=[
                                Assign(
                                  targets=[
                                    Name(id='primary', ctx=Store())],
                                  value=Constant(value='Sales'))],
                              orelse=[
                                Assign(
                                  targets=[
                                    Name(id='primary', ctx=Store())],
                                  value=Constant(value='Technology Leadership'))])])])])]),
            If(
              test=Call(
                func=Attribute(
                  value=Name(id='re', ctx=Load()),
                  attr='search',
                  ctx=Load()),
                args=[
                  Constant(value='vp|vice president|svp|chief'),
