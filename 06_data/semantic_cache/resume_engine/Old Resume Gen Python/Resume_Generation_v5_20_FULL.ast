                      value=Call(
                        func=Attribute(
                          value=Name(id='re', ctx=Load()),
                          attr='finditer',
                          ctx=Load()),
                        args=[
                          Name(id='pattern', ctx=Load()),
                          Name(id='pref_section', ctx=Load())])),
