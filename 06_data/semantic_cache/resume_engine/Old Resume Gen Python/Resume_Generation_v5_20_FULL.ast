        FunctionDef(
          name='_extract_preferred_skills',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Extract preferred/nice-to-have skills.')),
            Assign(
              targets=[
                Name(id='preferred', ctx=Store())],
              value=List(ctx=Load())),
            Assign(
              targets=[
                Name(id='pref_match', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='re', ctx=Load()),
                  attr='search',
                  ctx=Load()),
                args=[
                  Constant(value='(preferred|nice[-\\s]to[-\\s]have|bonus|plus|ideal).*?(?=\\n\\n|\\Z)'),
                  Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='jd_text',
                    ctx=Load()),
                  BinOp(
                    left=Attribute(
                      value=Name(id='re', ctx=Load()),
                      attr='IGNORECASE',
                      ctx=Load()),
                    op=BitOr(),
                    right=Attribute(
                      value=Name(id='re', ctx=Load()),
