                      value=Call(
                        func=Attribute(
                          value=Call(
                            func=Attribute(
                              value=Name(id='rtype', ctx=Load()),
                              attr='replace',
                              ctx=Load()),
                            args=[
                              Constant(value='_'),
                              Constant(value=' ')]),
                          attr='title',
                          ctx=Load()))),
                    Break()])]),
            Assign(
              targets=[
                Name(id='level', ctx=Store())],
