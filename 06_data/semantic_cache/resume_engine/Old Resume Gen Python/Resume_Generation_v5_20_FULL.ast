                        attr='strip',
                        ctx=Load())),
                    slice=Slice(
                      upper=Constant(value=100)),
                    ctx=Load()))]),
            Return(
              value=Name(id='context', ctx=Load()))],
          returns=Name(id='Dict', ctx=Load())),
        FunctionDef(
          name='_extract_seniority_signals',
