              value=Call(
                func=Attribute(
                  value=Name(id='re', ctx=Load()),
                  attr='search',
                  ctx=Load()),
                args=[
                  Constant(value='(\\d+)\\+?\\s*years'),
                  Name(id='jd_lower', ctx=Load())])),
            Assign(
              targets=[
