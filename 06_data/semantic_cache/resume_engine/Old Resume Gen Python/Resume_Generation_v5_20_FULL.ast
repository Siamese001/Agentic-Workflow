                func=Attribute(
                  value=Name(id='re', ctx=Load()),
                  attr='search',
                  ctx=Load()),
                args=[
                  Constant(value='director|head of'),
                  Name(id='jd_lower', ctx=Load())]),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='leadership_scope', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Constant(value='Director')]))]),
            If(
              test=Call(
                func=Attribute(
                  value=Name(id='re', ctx=Load()),
                  attr='search',
                  ctx=Load()),
                args=[
                  Constant(value='manager|lead'),
                  Name(id='jd_lower', ctx=Load())]),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='leadership_scope', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Constant(value='Manager')]))]),
            Return(
              value=Dict(
                keys=[
                  Constant(value='years_required'),
                  Constant(value='team_size'),
                  Constant(value='has_pl_responsibility'),
                  Constant(value='leadership_scope')],
                values=[
                  Name(id='years_required', ctx=Load()),
                  Name(id='team_size', ctx=Load()),
                  Name(id='has_pl', ctx=Load()),
                  Name(id='leadership_scope', ctx=Load())]))],
          returns=Name(id='Dict', ctx=Load())),
        FunctionDef(
          name='_extract_industry_vertical',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Extract target industry vertical.')),
            Assign(
              targets=[
                Name(id='jd_lower', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='jd_text',
                    ctx=Load()),
                  attr='lower',
                  ctx=Load()))),
            Assign(
              targets=[
                Name(id='verticals', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='Financial Services'),
                  Constant(value='Healthcare'),
                  Constant(value='Retail'),
                  Constant(value='Manufacturing'),
                  Constant(value='Technology'),
                  Constant(value='Consulting')],
                values=[
                  Constant(value='financial services|banking|fintech|insurance|capital markets'),
                  Constant(value='healthcare|health tech|medical|pharma|biotech'),
                  Constant(value='retail|e-commerce|consumer|shopping'),
                  Constant(value='manufacturing|industrial|automotive|supply chain'),
                  Constant(value='technology|software|saas|platform'),
