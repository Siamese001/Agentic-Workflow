              value=List(ctx=Load())),
            If(
              test=Call(
                func=Attribute(
                  value=Name(id='re', ctx=Load()),
                  attr='search',
                  ctx=Load()),
                args=[
                  Constant(value='vp|vice president|executive'),
                  Name(id='jd_lower', ctx=Load())]),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='leadership_scope', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
