              value=Call(
                func=Attribute(
                  value=Name(id='re', ctx=Load()),
                  attr='search',
                  ctx=Load()),
                args=[
                  Constant(value='team of (\\d+)|(\\d+)[-\\s]person team'),
                  Name(id='jd_lower', ctx=Load())])),
            Assign(
              targets=[
                Name(id='team_size', ctx=Store())],
              value=IfExp(
                test=Name(id='team_match', ctx=Load()),
                body=Call(
                  func=Name(id='int', ctx=Load()),
                  args=[
                    BoolOp(
                      op=Or(),
                      values=[
                        Call(
                          func=Attribute(
                            value=Name(id='team_match', ctx=Load()),
                            attr='group',
                            ctx=Load()),
                          args=[
                            Constant(value=1)]),
                        Call(
                          func=Attribute(
                            value=Name(id='team_match', ctx=Load()),
                            attr='group',
                            ctx=Load()),
                          args=[
                            Constant(value=2)])])]),
                orelse=Constant(value=0))),
            Assign(
              targets=[
                Name(id='has_pl', ctx=Store())],
              value=Call(
                func=Name(id='bool', ctx=Load()),
                args=[
                  Call(
                    func=Attribute(
                      value=Name(id='re', ctx=Load()),
                      attr='search',
                      ctx=Load()),
                    args=[
                      Constant(value='p&l|p\\&l|budget|revenue target'),
                      Name(id='jd_lower', ctx=Load())])])),
            Assign(
              targets=[
