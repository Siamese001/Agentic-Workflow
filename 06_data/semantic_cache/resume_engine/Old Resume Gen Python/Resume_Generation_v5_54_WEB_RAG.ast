                      Constant(value='pipeline'),
                      Constant(value='etl'),
                      Constant(value='big data'),
                      Constant(value='reporting'),
                      Constant(value='visualization')],
                    ctx=Load())])),
            If(
              test=BoolOp(
                op=And(),
                values=[
                  Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='enable_web_search',
                    ctx=Load()),
                  Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='api_key',
                    ctx=Load())]),
              body=[
                Try(
                  body=[
                    Assign(
                      targets=[
                        Name(id='config', ctx=Store())],
                      value=Call(
                        func=Name(id='RAGConfig', ctx=Load()))),
                    Assign(
                      targets=[
                        Attribute(
                          value=Name(id='self', ctx=Load()),
                          attr='web_client',
                          ctx=Store())],
                      value=Call(
                        func=Name(id='ClaudeWebSearchClient', ctx=Load()),
                        args=[
                          Attribute(
                            value=Name(id='self', ctx=Load()),
                            attr='api_key',
                            ctx=Load()),
                          Name(id='config', ctx=Load())])),
                    Assign(
                      targets=[
                        Attribute(
                          value=Name(id='self', ctx=Load()),
                          attr='web_rag',
                          ctx=Store())],
                      value=Call(
                        func=Name(id='WebSearchRAG', ctx=Load()),
                        args=[
                          Attribute(
                            value=Name(id='self', ctx=Load()),
                            attr='web_client',
                            ctx=Load())])),
                    Assign(
                      targets=[
                        Attribute(
                          value=Name(id='self', ctx=Load()),
                          attr='cache_manager',
                          ctx=Store())],
                      value=Call(
                        func=Name(id='JDCacheManager', ctx=Load()),
                        args=[
                          Attribute(
                            value=Name(id='config', ctx=Load()),
                            attr='cache_dir',
                            ctx=Load()),
                          Attribute(
                            value=Name(id='config', ctx=Load()),
                            attr='cache_ttl_days',
                            ctx=Load())]))],
                  handlers=[
                    ExceptHandler(
                      type=Name(id='Exception', ctx=Load()),
                      name='e',
                      body=[
                        Import(
                          names=[
                            alias(name='logging')]),
                        Expr(
                          value=Call(
                            func=Attribute(
                              value=Call(
                                func=Attribute(
                                  value=Name(id='logging', ctx=Load()),
                                  attr='getLogger',
                                  ctx=Load()),
                                args=[
                                  Name(id='__name__', ctx=Load())]),
                              attr='warning',
                              ctx=Load()),
                            args=[
