                  ctx=Load())),
              arg(
                arg='jd_text',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Calculate relevance scores for each theme.')),
            Assign(
              targets=[
                Name(id='theme_scores', ctx=Store())],
              value=Dict()),
            Assign(
              targets=[
                Name(id='jd_lower', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='jd_text', ctx=Load()),
