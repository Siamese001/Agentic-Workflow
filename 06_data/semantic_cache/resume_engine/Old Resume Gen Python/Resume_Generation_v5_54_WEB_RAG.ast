                  attr='search_calls_made',
                  ctx=Store())],
              value=Constant(value=0)),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='stopwords',
                  ctx=Store())],
              value=Set(
                elts=[
