        FunctionDef(
          name='_extract_keywords',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='text',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Extract keywords with frequency counts.')),
            Assign(
              targets=[
                Name(id='text_lower', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='text', ctx=Load()),
                  attr='lower',
                  ctx=Load()))),
            Assign(
              targets=[
                Name(id='words', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='re', ctx=Load()),
                  attr='findall',
                  ctx=Load()),
                args=[
                  Constant(value='\\b[a-z]{3,}\\b'),
                  Name(id='text_lower', ctx=Load())])),
            Assign(
              targets=[
                Name(id='keyword_freq', ctx=Store())],
              value=Dict()),
            For(
              target=Name(id='word', ctx=Store()),
              iter=Name(id='words', ctx=Load()),
              body=[
                If(
                  test=BoolOp(
                    op=And(),
                    values=[
                      Compare(
                        left=Name(id='word', ctx=Load()),
                        ops=[
                          NotIn()],
                        comparators=[
                          Attribute(
                            value=Name(id='self', ctx=Load()),
                            attr='stopwords',
                            ctx=Load())]),
                      Compare(
                        left=Call(
                          func=Name(id='len', ctx=Load()),
                          args=[
                            Name(id='word', ctx=Load())]),
                        ops=[
                          GtE()],
                        comparators=[
                          Constant(value=3)])]),
                  body=[
                    Assign(
                      targets=[
                        Subscript(
                          value=Name(id='keyword_freq', ctx=Load()),
                          slice=Name(id='word', ctx=Load()),
                          ctx=Store())],
                      value=BinOp(
                        left=Call(
                          func=Attribute(
                            value=Name(id='keyword_freq', ctx=Load()),
                            attr='get',
                            ctx=Load()),
                          args=[
                            Name(id='word', ctx=Load()),
                            Constant(value=0)]),
                        op=Add(),
                        right=Constant(value=1)))])]),
            For(
              target=Tuple(
                elts=[
                  Name(id='domain', ctx=Store()),
                  Name(id='terms', ctx=Store())],
                ctx=Store()),
              iter=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='domain_themes',
                    ctx=Load()),
                  attr='items',
                  ctx=Load())),
              body=[
                For(
                  target=Name(id='term', ctx=Store()),
                  iter=Name(id='terms', ctx=Load()),
                  body=[
                    If(
                      test=BoolOp(
                        op=And(),
                        values=[
                          Compare(
                            left=Name(id='term', ctx=Load()),
                            ops=[
                              In()],
                            comparators=[
                              Name(id='text_lower', ctx=Load())]),
                          Compare(
                            left=Call(
                              func=Name(id='len', ctx=Load()),
                              args=[
                                Call(
                                  func=Attribute(
                                    value=Name(id='term', ctx=Load()),
                                    attr='split',
                                    ctx=Load()))]),
                            ops=[
                              Gt()],
                            comparators=[
                              Constant(value=1)])]),
                      body=[
                        Assign(
                          targets=[
                            Subscript(
                              value=Name(id='keyword_freq', ctx=Load()),
                              slice=Name(id='term', ctx=Load()),
                              ctx=Store())],
                          value=BinOp(
                            left=Call(
                              func=Attribute(
                                value=Name(id='text_lower', ctx=Load()),
                                attr='count',
                                ctx=Load()),
                              args=[
                                Name(id='term', ctx=Load())]),
                            op=Mult(),
                            right=Constant(value=2)))])])]),
            Return(
              value=Name(id='keyword_freq', ctx=Load()))],
          returns=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='int', ctx=Load())],
              ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='_calculate_theme_scores',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='keywords',
