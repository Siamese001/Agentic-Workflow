                    attr='domain_themes',
                    ctx=Load()),
                  attr='items',
                  ctx=Load())),
              body=[
                Assign(
                  targets=[
                    Name(id='score', ctx=Store())],
                  value=Constant(value=0.0)),
                Assign(
                  targets=[
                    Name(id='matched_keywords', ctx=Store())],
                  value=List(ctx=Load())),
                For(
                  target=Name(id='keyword', ctx=Store()),
                  iter=Name(id='theme_keywords', ctx=Load()),
                  body=[
                    If(
                      test=Compare(
                        left=Name(id='keyword', ctx=Load()),
                        ops=[
                          In()],
                        comparators=[
                          Name(id='jd_lower', ctx=Load())]),
                      body=[
                        Assign(
                          targets=[
                            Name(id='occurrences', ctx=Store())],
                          value=Call(
                            func=Attribute(
                              value=Name(id='jd_lower', ctx=Load()),
                              attr='count',
                              ctx=Load()),
                            args=[
                              Name(id='keyword', ctx=Load())])),
                        Assign(
                          targets=[
                            Name(id='importance', ctx=Store())],
                          value=Call(
                            func=Name(id='len', ctx=Load()),
                            args=[
                              Call(
                                func=Attribute(
                                  value=Name(id='keyword', ctx=Load()),
                                  attr='split',
                                  ctx=Load()))])),
                        AugAssign(
                          target=Name(id='score', ctx=Store()),
                          op=Add(),
                          value=BinOp(
                            left=Name(id='occurrences', ctx=Load()),
                            op=Mult(),
                            right=BinOp(
                              left=Constant(value=1.0),
                              op=Add(),
                              right=BinOp(
                                left=Name(id='importance', ctx=Load()),
                                op=Mult(),
                                right=Constant(value=0.5))))),
                        Expr(
                          value=Call(
                            func=Attribute(
                              value=Name(id='matched_keywords', ctx=Load()),
                              attr='append',
                              ctx=Load()),
                            args=[
                              Name(id='keyword', ctx=Load())]))])]),
                If(
                  test=Compare(
                    left=Name(id='score', ctx=Load()),
                    ops=[
                      Gt()],
                    comparators=[
                      Constant(value=0)]),
                  body=[
                    Assign(
                      targets=[
                        Name(id='normalized_score', ctx=Store())],
                      value=Call(
                        func=Name(id='min', ctx=Load()),
                        args=[
                          Constant(value=1.0),
                          BinOp(
                            left=Name(id='score', ctx=Load()),
                            op=Div(),
                            right=BinOp(
                              left=Call(
                                func=Name(id='len', ctx=Load()),
                                args=[
                                  Name(id='theme_keywords', ctx=Load())]),
                              op=Mult(),
                              right=Constant(value=0.5)))])),
                    Assign(
                      targets=[
                        Subscript(
                          value=Name(id='theme_scores', ctx=Load()),
                          slice=Name(id='theme_name', ctx=Load()),
                          ctx=Store())],
                      value=Dict(
                        keys=[
                          Constant(value='score'),
                          Constant(value='matched_keywords'),
                          Constant(value='match_count')],
                        values=[
                          Name(id='normalized_score', ctx=Load()),
                          Name(id='matched_keywords', ctx=Load()),
                          Call(
                            func=Name(id='len', ctx=Load()),
                            args=[
                              Name(id='matched_keywords', ctx=Load())])]))])]),
            Return(
              value=Name(id='theme_scores', ctx=Load()))],
          returns=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='float', ctx=Load())],
              ctx=Load()),
            ctx=Load())),
        FunctionDef(
