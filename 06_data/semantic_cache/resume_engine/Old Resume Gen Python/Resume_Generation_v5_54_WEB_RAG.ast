                      ops=[
                        Gt()],
                      comparators=[
                        Constant(value=0.7)]),
                    body=Constant(value='STRONG'),
                    orelse=Constant(value='MODERATE'))]))],
          returns=Name(id='Dict', ctx=Load())),
        FunctionDef(
