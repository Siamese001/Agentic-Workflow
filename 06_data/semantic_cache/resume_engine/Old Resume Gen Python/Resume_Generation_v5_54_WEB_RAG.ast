      body=[
        Expr(
          value=Constant(value='\n    Implements three-phase web search RAG strategy.\n    \n    Phase 1: Thematic Research (15-20 searches)\n    Phase 2: Authenticity Patterns (10-15 searches)\n    Phase 3: Competitive Positioning (10-15 searches)\n    ')),
        FunctionDef(
          name='__init__',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='client',
                annotation=Name(id='ClaudeWebSearchClient', ctx=Load()))]),
          body=[
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='client',
                  ctx=Store())],
              value=Name(id='client', ctx=Load()))]),
        FunctionDef(
          name='phase1_thematic_research',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='job_description',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Phase 1: Research market expectations and extract themes.')),
            Assign(
              targets=[
                Name(id='prompt', ctx=Store())],
              value=JoinedStr(
                values=[
                  Constant(value='You are a job market intelligence analyst. Research this role using web_search:\n\nJOB DESCRIPTION:\n'),
                  FormattedValue(
                    value=Subscript(
                      value=Name(id='job_description', ctx=Load()),
                      slice=Slice(
                        upper=Constant(value=1500)),
                      ctx=Load()),
                    conversion=-1),
                  Constant(value='\n\nTASK: Search for 15-20 similar job postings. Analyze:\n1. Primary theme (main skill focus)\n2. Secondary themes (4-5 supporting skills)\n3. Trending keywords\n4. Required vs preferred skills\n5. Role seniority level\n\nReturn ONLY this JSON structure:\n{\n  "search_summary": {\n    "searches_performed": <number of web_search calls>,\n    "jds_analyzed": <number of unique JDs>,\n    "sources": ["<url1>", "<url2>", ...]\n  },\n  "thematic_analysis": {\n    "primary_theme": {\n      "name": "<theme name>",\n      "confidence": <0.0-1.0>,\n      "keywords": ["<keyword1>", "<keyword2>", ...],\n      "market_prevalence": <0.0-1.0>\n    },\n    "secondary_themes": [\n      {\n        "name": "<theme name>",\n        "relevance": <0.0-1.0>,\n        "keywords": ["<keyword1>", ...]\n      }\n    ],\n    "trending_keywords": ["<keyword1>", ...],\n    "required_skills": ["<skill1>", ...],\n    "preferred_skills": ["<skill1>", ...]\n  },\n  "role_classification": {\n    "seniority": "<entry|mid|senior|executive>",\n    "function": "<function>",\n    "industry_focus": "<industry>"\n  }\n}\n\nCRITICAL: Return ONLY valid JSON. No text before or after.')])),
            Return(
              value=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='client',
                    ctx=Load()),
                  attr='search_and_analyze',
                  ctx=Load()),
                args=[
                  Name(id='prompt', ctx=Load()),
                  Constant(value='Phase 1: Thematic Research')]))],
          returns=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='Any', ctx=Load())],
              ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='phase2_authenticity_patterns',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='job_description',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='role_title',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Phase 2: Extract how real professionals present themselves.')),
            Assign(
              targets=[
                Name(id='industry', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='_infer_industry',
                  ctx=Load()),
                args=[
                  Name(id='job_description', ctx=Load())])),
            Assign(
              targets=[
                Name(id='prompt', ctx=Store())],
              value=JoinedStr(
                values=[
                  Constant(value='You are a LinkedIn profile analyst. Research this role using web_search:\n\nTARGET ROLE: '),
                  FormattedValue(
                    value=Name(id='role_title', ctx=Load()),
                    conversion=-1),
                  Constant(value='\nINDUSTRY: '),
                  FormattedValue(
                    value=Name(id='industry', ctx=Load()),
                    conversion=-1),
                  Constant(value='\n\nTASK: Search for 10-15 LinkedIn profiles and resumes. Extract:\n1. Executive summary patterns (with <PLACEHOLDERS>)\n2. Achievement verb patterns\n3. Metric presentation patterns\n4. Competency phrasing patterns\n\nReturn ONLY this JSON structure:\n{\n  "search_summary": {\n    "profiles_analyzed": <count>,\n    "sources": ["<url1>", "<url2>", ...]\n  },\n  "authenticity_patterns": {\n    "executive_summary_patterns": [\n      "Built <ACHIEVEMENT> resulting in <IMPACT>",\n      "Led <INITIATIVE> achieving <METRIC>",\n      ...\n    ],\n    "achievement_verb_patterns": [\n      "Drove", "Led", "Architected", ...\n    ],\n    "metric_presentation_patterns": [\n      "$<NUMBER>M revenue",\n      "<NUMBER>% growth",\n      ...\n    ],\n    "competency_phrasing": [\n      "<SKILL>: <CONTEXT>",\n      ...\n    ]\n  },\n  "pattern_confidence": {\n    "executive_summary": <0.0-1.0>,\n    "verbs": <0.0-1.0>,\n    "metrics": <0.0-1.0>,\n    "overall": <0.0-1.0>\n  }\n}\n\nCRITICAL: Return ONLY valid JSON. Extract REAL patterns from profiles.')])),
            Return(
              value=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='client',
                    ctx=Load()),
                  attr='search_and_analyze',
                  ctx=Load()),
                args=[
                  Name(id='prompt', ctx=Load()),
                  Constant(value='Phase 2: Authenticity Patterns')]))],
          returns=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='Any', ctx=Load())],
              ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='phase3_competitive_positioning',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='job_description',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='company_name',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='role_title',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Phase 3: Analyze competitive landscape and differentiators.')),
            Assign(
              targets=[
                Name(id='peer_companies', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='_infer_peer_companies',
                  ctx=Load()),
                args=[
                  Name(id='company_name', ctx=Load()),
                  Name(id='job_description', ctx=Load())])),
            Assign(
              targets=[
                Name(id='prompt', ctx=Store())],
              value=JoinedStr(
                values=[
                  Constant(value='You are a competitive intelligence analyst. Research using web_search:\n\nTARGET JD:\nCompany: '),
                  FormattedValue(
                    value=Name(id='company_name', ctx=Load()),
                    conversion=-1),
                  Constant(value='\nRole: '),
                  FormattedValue(
                    value=Name(id='role_title', ctx=Load()),
                    conversion=-1),
                  Constant(value='\nDescription: '),
                  FormattedValue(
                    value=Subscript(
                      value=Name(id='job_description', ctx=Load()),
                      slice=Slice(
                        upper=Constant(value=1000)),
                      ctx=Load()),
                    conversion=-1),
                  Constant(value='\n\nPEER COMPANIES: '),
                  FormattedValue(
                    value=Call(
                      func=Attribute(
                        value=Constant(value=', '),
                        attr='join',
                        ctx=Load()),
                      args=[
                        Name(id='peer_companies', ctx=Load())]),
                    conversion=-1),
                  Constant(value='\n\nTASK: Search for 10-15 similar roles at peer companies. Identify:\n1. Table stakes (requirements in >80% of JDs)\n2. Differentiators (unique requirements <30%)\n\nReturn ONLY this JSON structure:\n{\n  "search_summary": {\n    "peer_jds_analyzed": <count>,\n    "peer_companies": ["<company1>", ...],\n    "sources": ["<url1>", ...]\n  },\n  "competitive_analysis": {\n    "table_stakes_keywords": [\n      {\n        "keyword": "<keyword>",\n        "prevalence": <0.0-1.0>\n      }\n    ],\n    "differentiator_keywords": [\n      {\n        "keyword": "<keyword>",\n        "uniqueness_score": <0.0-1.0>\n      }\n    ]\n  },\n  "positioning_insight": "<2-3 sentence summary>"\n}\n\nCRITICAL: Return ONLY valid JSON.')])),
            Return(
              value=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='client',
                    ctx=Load()),
                  attr='search_and_analyze',
                  ctx=Load()),
                args=[
                  Name(id='prompt', ctx=Load()),
                  Constant(value='Phase 3: Competitive Positioning')]))],
          returns=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='Any', ctx=Load())],
              ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='_infer_industry',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='job_description',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Infer industry from JD keywords.')),
            Assign(
              targets=[
                Name(id='jd_lower', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='job_description', ctx=Load()),
                  attr='lower',
                  ctx=Load()))),
            If(
              test=BoolOp(
                op=Or(),
                values=[
                  Compare(
                    left=Constant(value='fintech'),
                    ops=[
                      In()],
                    comparators=[
                      Name(id='jd_lower', ctx=Load())]),
                  Compare(
                    left=Constant(value='banking'),
                    ops=[
                      In()],
                    comparators=[
                      Name(id='jd_lower', ctx=Load())])]),
              body=[
                Return(
                  value=Constant(value='Financial Technology'))],
              orelse=[
                If(
                  test=BoolOp(
                    op=Or(),
                    values=[
                      Compare(
                        left=Constant(value='healthcare'),
                        ops=[
                          In()],
                        comparators=[
                          Name(id='jd_lower', ctx=Load())]),
                      Compare(
                        left=Constant(value='medical'),
                        ops=[
                          In()],
                        comparators=[
                          Name(id='jd_lower', ctx=Load())])]),
                  body=[
                    Return(
                      value=Constant(value='Healthcare'))],
                  orelse=[
                    If(
                      test=BoolOp(
                        op=Or(),
                        values=[
                          Compare(
                            left=Constant(value='retail'),
                            ops=[
                              In()],
                            comparators=[
                              Name(id='jd_lower', ctx=Load())]),
                          Compare(
                            left=Constant(value='e-commerce'),
                            ops=[
                              In()],
                            comparators=[
                              Name(id='jd_lower', ctx=Load())])]),
                      body=[
                        Return(
                          value=Constant(value='Retail/E-Commerce'))],
                      orelse=[
                        If(
                          test=BoolOp(
                            op=Or(),
                            values=[
                              Compare(
                                left=Constant(value='saas'),
                                ops=[
                                  In()],
                                comparators=[
                                  Name(id='jd_lower', ctx=Load())]),
                              Compare(
                                left=Constant(value='software'),
                                ops=[
                                  In()],
                                comparators=[
                                  Name(id='jd_lower', ctx=Load())])]),
                          body=[
                            Return(
                              value=Constant(value='Software/SaaS'))],
                          orelse=[
                            Return(
                              value=Constant(value='Technology'))])])])])],
          returns=Name(id='str', ctx=Load())),
        FunctionDef(
          name='_infer_peer_companies',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='company_name',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='job_description',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Infer peer companies based on industry.')),
            Assign(
              targets=[
                Name(id='industry', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='_infer_industry',
                  ctx=Load()),
                args=[
                  Name(id='job_description', ctx=Load())])),
            Assign(
              targets=[
                Name(id='peers_by_industry', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='Financial Technology'),
                  Constant(value='Healthcare'),
                  Constant(value='Retail/E-Commerce'),
                  Constant(value='Software/SaaS'),
                  Constant(value='Technology')],
                values=[
                  List(
                    elts=[
                      Constant(value='JPMorgan'),
                      Constant(value='Goldman Sachs'),
                      Constant(value='Morgan Stanley'),
                      Constant(value='Stripe'),
                      Constant(value='Square')],
                    ctx=Load()),
                  List(
                    elts=[
                      Constant(value='UnitedHealth'),
                      Constant(value='CVS Health'),
                      Constant(value='Anthem'),
                      Constant(value='Cigna'),
                      Constant(value='Humana')],
                    ctx=Load()),
                  List(
                    elts=[
                      Constant(value='Amazon'),
                      Constant(value='Walmart'),
                      Constant(value='Target'),
                      Constant(value='Shopify'),
                      Constant(value='eBay')],
                    ctx=Load()),
                  List(
                    elts=[
                      Constant(value='Salesforce'),
                      Constant(value='Oracle'),
                      Constant(value='SAP'),
                      Constant(value='Adobe'),
                      Constant(value='Workday')],
                    ctx=Load()),
                  List(
                    elts=[
                      Constant(value='Google'),
                      Constant(value='Microsoft'),
                      Constant(value='Meta'),
                      Constant(value='Apple'),
                      Constant(value='Amazon')],
                    ctx=Load())])),
            Assign(
              targets=[
                Name(id='peers', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='peers_by_industry', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Name(id='industry', ctx=Load()),
                  Subscript(
                    value=Name(id='peers_by_industry', ctx=Load()),
                    slice=Constant(value='Technology'),
                    ctx=Load())])),
            Return(
              value=Subscript(
                value=ListComp(
                  elt=Name(id='p', ctx=Load()),
                  generators=[
                    comprehension(
                      target=Name(id='p', ctx=Store()),
                      iter=Name(id='peers', ctx=Load()),
                      ifs=[
                        Compare(
                          left=Call(
                            func=Attribute(
                              value=Name(id='p', ctx=Load()),
                              attr='lower',
                              ctx=Load())),
                          ops=[
                            NotIn()],
                          comparators=[
                            Call(
                              func=Attribute(
                                value=Name(id='company_name', ctx=Load()),
                                attr='lower',
                                ctx=Load()))])],
                      is_async=0)]),
                slice=Slice(
                  upper=Constant(value=5)),
                ctx=Load()))],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load()))]),
    ClassDef(
      name='EnhancedJobDescriptionAnalyzer',
      body=[
        Expr(
          value=Constant(value='\n    HOP-0: Enhanced Job Description Parser with Web-Search Intelligence.\n    \n    v5.54: WEB RAG FULLY IMPLEMENTED\n    - Phase 1: Thematic Research (15-20 searches)\n    - Phase 2: Authenticity Patterns (10-15 searches)\n    - Phase 3: Competitive Positioning (10-15 searches)\n    - Graceful fallback to v5.52 local NLP\n    ')),
        FunctionDef(
          name='__init__',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='master_resume',
                annotation=Name(id='Dict', ctx=Load())),
              arg(
                arg='enable_web_search',
                annotation=Name(id='bool', ctx=Load())),
              arg(
                arg='api_key',
                annotation=Subscript(
                  value=Name(id='Optional', ctx=Load()),
                  slice=Name(id='str', ctx=Load()),
                  ctx=Load()))],
            defaults=[
              Constant(value=True),
              Constant(value=None)]),
          body=[
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='master_resume',
                  ctx=Store())],
              value=Name(id='master_resume', ctx=Load())),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='enable_web_search',
                  ctx=Store())],
              value=BoolOp(
                op=And(),
                values=[
                  Name(id='enable_web_search', ctx=Load()),
                  Name(id='ANTHROPIC_AVAILABLE', ctx=Load())])),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='api_key',
                  ctx=Store())],
              value=BoolOp(
                op=Or(),
                values=[
                  Name(id='api_key', ctx=Load()),
                  Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='os', ctx=Load()),
                        attr='environ',
                        ctx=Load()),
                      attr='get',
                      ctx=Load()),
                    args=[
                      Constant(value='ANTHROPIC_API_KEY')])])),
            Assign(
              targets=[
                Attribute(
