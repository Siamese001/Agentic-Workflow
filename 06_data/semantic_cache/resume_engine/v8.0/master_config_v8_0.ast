              Constant(value='Strategy Brief:\n{strategy_brief}\n\nFull Master Resume (for context):\n{master_resume}\n\nTask: Generate {n_to_gen} new, synthetic bullets. They must be plausible, metrics-driven, and aligned with the strategy. Do not copy any bullets.\n\nRespond with JSON: {"synthetic_bullets": ["...", "..."]}'),
              Constant(value='You are a (MoE) drafting conductor. Your job is to create the optimal drafting plan by selecting from a list of experts. Your goal is quality and efficiency.'),
