                    attr='meta_loop_config',
                    ctx=Load()),
                  attr='feedback_log_path',
                  ctx=Load()))])),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='feedback_logger', ctx=Load()),
              attr='log',
              ctx=Load()),
            args=[
              Name(id='validation_summary', ctx=Load()),
              Subscript(
                value=Name(id='state', ctx=Load()),
                slice=Constant(value='workflow_id'),
                ctx=Load())])),
        Return(
          value=Dict(
            keys=[
              Constant(value='artifacts')],
            values=[
              Dict(
                keys=[
                  Constant(value='qa_llm_results'),
                  Constant(value='qa_logic_results'),
                  Constant(value='validation_results')],
                values=[
                  Name(id='llm_results', ctx=Load()),
                  Name(id='logic_results', ctx=Load()),
                  Name(id='validation_summary', ctx=Load())])]))],
      returns=Subscript(
        value=Name(id='Dict', ctx=Load()),
        slice=Tuple(
          elts=[
            Name(id='str', ctx=Load()),
            Name(id='Any', ctx=Load())],
          ctx=Load()),
        ctx=Load())),
    FunctionDef(
      name='run_replanner',
      args=arguments(
        args=[
          arg(
            arg='state',
            annotation=Constant(value='GraphState'))]),
      body=[
        Expr(
          value=Constant(value='Node: Runs Step 3 (SC Paths): Re-Planner')),
        Assign(
          targets=[
            Name(id='blackboard', ctx=Store())],
          value=Call(
            func=Name(id='get_blackboard', ctx=Load()),
            args=[
              Name(id='state', ctx=Load())])),
        Assign(
          targets=[
            Name(id='agent', ctx=Store())],
          value=Call(
            func=Name(id='WorkflowRePlannerAgent', ctx=Load()),
            args=[
              Name(id='blackboard', ctx=Load())],
            keywords=[
              keyword(
                arg='debug_mode',
                value=Constant(value=True))])),
        Assign(
          targets=[
            Name(id='failed_checks', ctx=Store())],
          value=Subscript(
            value=Subscript(
              value=Subscript(
                value=Name(id='state', ctx=Load()),
                slice=Constant(value='artifacts'),
                ctx=Load()),
              slice=Constant(value='validation_results'),
              ctx=Load()),
            slice=Constant(value='failed_checks'),
            ctx=Load())),
        Assign(
          targets=[
            Name(id='plan', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='agent', ctx=Load()),
              attr='run',
              ctx=Load()),
            keywords=[
              keyword(
                arg='failed_qa_results',
                value=Name(id='failed_checks', ctx=Load()))])),
        Assign(
          targets=[
            Name(id='new_replan_count', ctx=Store())],
          value=BinOp(
            left=Call(
              func=Attribute(
                value=Name(id='state', ctx=Load()),
                attr='get',
                ctx=Load()),
              args=[
                Constant(value='replan_count'),
                Constant(value=0)]),
            op=Add(),
            right=Constant(value=1))),
        Assign(
          targets=[
            Name(id='artifacts', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Subscript(
                value=Name(id='state', ctx=Load()),
                slice=Constant(value='artifacts'),
                ctx=Load()),
              attr='copy',
              ctx=Load()))),
        For(
          target=Name(id='key', ctx=Store()),
          iter=List(
            elts=[
              Constant(value='final_drafting_prompt'),
              Constant(value='generated_bullets'),
              Constant(value='final_draft'),
              Constant(value='qa_llm_results'),
              Constant(value='qa_logic_results'),
              Constant(value='validation_results'),
              Constant(value='recovery_plan')],
            ctx=Load()),
          body=[
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='artifacts', ctx=Load()),
                  attr='pop',
                  ctx=Load()),
                args=[
                  Name(id='key', ctx=Load()),
                  Constant(value=None)]))]),
        Assign(
          targets=[
            Subscript(
              value=Name(id='artifacts', ctx=Load()),
              slice=Constant(value='recovery_plan'),
              ctx=Store())],
          value=Name(id='plan', ctx=Load())),
        Return(
          value=Dict(
            keys=[
              Constant(value='artifacts'),
              Constant(value='replan_count')],
            values=[
              Name(id='artifacts', ctx=Load()),
              Name(id='new_replan_count', ctx=Load())]))],
      returns=Subscript(
        value=Name(id='Dict', ctx=Load()),
        slice=Tuple(
          elts=[
            Name(id='str', ctx=Load()),
            Name(id='Any', ctx=Load())],
          ctx=Load()),
        ctx=Load())),
    FunctionDef(
      name='human_review_pause',
      args=arguments(
        args=[
          arg(
            arg='state',
            annotation=Constant(value='GraphState'))]),
      body=[
        Expr(
          value=Constant(value="\n    Node: This node saves the final draft to the state for HIL diffing.\n    The graph will be configured to *interrupt* before this node,\n    allowing a human to review and provide the 'human_approved_draft'.\n    ")),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='logger', ctx=Load()),
              attr='info',
              ctx=Load()),
            args=[
              Constant(value='HIL Pause: Awaiting human approval/edits.')])),
        Return(
          value=Dict(
            keys=[
              Constant(value='original_draft')],
            values=[
              Subscript(
                value=Subscript(
                  value=Name(id='state', ctx=Load()),
                  slice=Constant(value='artifacts'),
                  ctx=Load()),
                slice=Constant(value='final_draft'),
                ctx=Load())]))],
      returns=Subscript(
        value=Name(id='Dict', ctx=Load()),
        slice=Tuple(
          elts=[
            Name(id='str', ctx=Load()),
            Name(id='Any', ctx=Load())],
          ctx=Load()),
        ctx=Load())),
    FunctionDef(
      name='run_preference_capture',
      args=arguments(
        args=[
          arg(
            arg='state',
            annotation=Constant(value='GraphState'))]),
      body=[
        Expr(
          value=Constant(value='Node: Runs Step 5: Preference Capture')),
        If(
          test=UnaryOp(
            op=Not(),
            operand=Attribute(
              value=Attribute(
                value=Name(id='CONFIG', ctx=Load()),
                attr='hil_config',
                ctx=Load()),
              attr='enable_preference_learning',
              ctx=Load())),
          body=[
            Return(
              value=Dict(
                keys=[
                  Constant(value='preference_insight')],
                values=[
                  Dict(
                    keys=[
                      Constant(value='status')],
                    values=[
                      Constant(value='disabled')])]))]),
        Assign(
          targets=[
            Name(id='blackboard', ctx=Store())],
          value=Call(
            func=Name(id='get_blackboard', ctx=Load()),
            args=[
              Name(id='state', ctx=Load())])),
        Assign(
          targets=[
            Name(id='agent', ctx=Store())],
          value=Call(
            func=Name(id='PreferenceCaptureAgent', ctx=Load()),
            args=[
              Name(id='blackboard', ctx=Load())],
            keywords=[
              keyword(
                arg='debug_mode',
                value=Constant(value=True))])),
        Assign(
          targets=[
            Name(id='ai_draft', ctx=Store())],
          value=Subscript(
            value=Name(id='state', ctx=Load()),
            slice=Constant(value='original_draft'),
            ctx=Load())),
        Assign(
          targets=[
            Name(id='human_draft', ctx=Store())],
          value=Subscript(
            value=Name(id='state', ctx=Load()),
            slice=Constant(value='human_approved_draft'),
            ctx=Load())),
        If(
          test=UnaryOp(
            op=Not(),
            operand=Name(id='human_draft', ctx=Load())),
          body=[
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='logger', ctx=Load()),
                  attr='warning',
                  ctx=Load()),
                args=[
                  Constant(value='No human_approved_draft found, skipping preference capture.')])),
            Return(
              value=Dict(
                keys=[
                  Constant(value='preference_insight')],
                values=[
                  Dict(
                    keys=[
                      Constant(value='status'),
                      Constant(value='reason')],
                    values=[
                      Constant(value='skipped'),
                      Constant(value='No human draft provided.')])]))]),
        Assign(
          targets=[
            Name(id='insight', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='agent', ctx=Load()),
              attr='run',
              ctx=Load()),
            keywords=[
              keyword(
                arg='ai_draft',
                value=Name(id='ai_draft', ctx=Load())),
              keyword(
                arg='human_draft',
                value=Name(id='human_draft', ctx=Load()))])),
        Return(
          value=Dict(
            keys=[
              Constant(value='preference_insight')],
            values=[
              Name(id='insight', ctx=Load())]))],
      returns=Subscript(
        value=Name(id='Dict', ctx=Load()),
        slice=Tuple(
          elts=[
            Name(id='str', ctx=Load()),
            Name(id='Any', ctx=Load())],
          ctx=Load()),
        ctx=Load())),
    FunctionDef(
      name='check_qa_results',
      args=arguments(
        args=[
          arg(
            arg='state',
            annotation=Constant(value='GraphState'))]),
      body=[
        Expr(
          value=Constant(value='\n    This is the "conditional edge" that replaces the Governor\'s while loop.\n    v7.5: On success, it routes to HIL, not END.\n    ')),
        Assign(
          targets=[
            Name(id='qa_passed', ctx=Store())],
          value=Subscript(
            value=Subscript(
              value=Subscript(
                value=Name(id='state', ctx=Load()),
                slice=Constant(value='artifacts'),
                ctx=Load()),
              slice=Constant(value='validation_results'),
              ctx=Load()),
            slice=Constant(value='overall_passed'),
            ctx=Load())),
        Assign(
          targets=[
            Name(id='replan_count', ctx=Store())],
          value=Subscript(
            value=Name(id='state', ctx=Load()),
            slice=Constant(value='replan_count'),
            ctx=Load())),
        Assign(
          targets=[
            Name(id='max_replan', ctx=Store())],
          value=Attribute(
            value=Attribute(
              value=Name(id='CONFIG', ctx=Load()),
              attr='planner_config',
              ctx=Load()),
            attr='max_replan_loops',
            ctx=Load())),
        If(
          test=Name(id='qa_passed', ctx=Load()),
          body=[
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='logger', ctx=Load()),
                  attr='info',
                  ctx=Load()),
                args=[
                  Constant(value='✅ QA Swarm Passed. Routing to Human-in-the-Loop (HIL) review.')])),
            Return(
              value=Constant(value='human_review_pause'))],
          orelse=[
            If(
              test=Compare(
                left=Name(id='replan_count', ctx=Load()),
                ops=[
                  GtE()],
                comparators=[
                  Name(id='max_replan', ctx=Load())]),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='logger', ctx=Load()),
                      attr='error',
                      ctx=Load()),
                    args=[
                      JoinedStr(
                        values=[
                          Constant(value='❌ QA Failed. Max replan loops ('),
                          FormattedValue(
                            value=Name(id='max_replan', ctx=Load()),
                            conversion=-1),
                          Constant(value=') reached. Halting.')])])),
                Return(
                  value=Constant(value='FAIL_HALT'))],
              orelse=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='logger', ctx=Load()),
                      attr='warning',
                      ctx=Load()),
                    args=[
                      JoinedStr(
                        values=[
                          Constant(value='⚠️ QA Failed. Triggering Re-Planner (Attempt '),
                          FormattedValue(
                            value=BinOp(
                              left=Name(id='replan_count', ctx=Load()),
                              op=Add(),
                              right=Constant(value=1)),
                            conversion=-1),
                          Constant(value=').')])])),
                Return(
                  value=Constant(value='REPLANNER'))])])],
      returns=Name(id='str', ctx=Load())),
    FunctionDef(
      name='get_graph_app',
      args=arguments(
        args=[
          arg(
            arg='checkpointer',
            annotation=Constant(value='RedisSaver')),
          arg(
            arg='enable_hil',
            annotation=Name(id='bool', ctx=Load()))],
        defaults=[
          Constant(value=True)]),
      body=[
        Expr(
          value=Constant(value='\n    Builds and compiles the persistent v8.0 StateGraph.\n    ')),
        ImportFrom(
          module='langgraph.graph',
          names=[
            alias(name='StateGraph'),
            alias(name='END')],
          level=0),
        ImportFrom(
          module='core_v8_0',
          names=[
            alias(name='GraphState')],
          level=0),
        Assign(
          targets=[
            Name(id='workflow', ctx=Store())],
          value=Call(
            func=Name(id='StateGraph', ctx=Load()),
            args=[
              Name(id='GraphState', ctx=Load())])),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='workflow', ctx=Load()),
              attr='add_node',
              ctx=Load()),
            args=[
              Constant(value='strategy'),
              Name(id='run_strategy', ctx=Load())])),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='workflow', ctx=Load()),
              attr='add_node',
              ctx=Load()),
            args=[
              Constant(value='rag_stack'),
              Name(id='run_rag_stack', ctx=Load())])),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='workflow', ctx=Load()),
              attr='add_node',
              ctx=Load()),
            args=[
              Constant(value='bullet_stack'),
              Name(id='run_bullet_stack', ctx=Load())])),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='workflow', ctx=Load()),
              attr='add_node',
              ctx=Load()),
            args=[
              Constant(value='drafting_stack'),
              Name(id='run_drafting_stack', ctx=Load())])),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='workflow', ctx=Load()),
              attr='add_node',
              ctx=Load()),
            args=[
              Constant(value='qa_swarm'),
              Name(id='run_qa_swarm', ctx=Load())])),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='workflow', ctx=Load()),
              attr='add_node',
              ctx=Load()),
            args=[
              Constant(value='replanner'),
              Name(id='run_replanner', ctx=Load())])),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='workflow', ctx=Load()),
              attr='set_entry_point',
              ctx=Load()),
            args=[
              Constant(value='strategy')])),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='workflow', ctx=Load()),
              attr='add_edge',
              ctx=Load()),
            args=[
              Constant(value='strategy'),
              Constant(value='rag_stack')])),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='workflow', ctx=Load()),
              attr='add_edge',
              ctx=Load()),
            args=[
              Constant(value='rag_stack'),
              Constant(value='bullet_stack')])),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='workflow', ctx=Load()),
              attr='add_edge',
              ctx=Load()),
            args=[
              Constant(value='bullet_stack'),
              Constant(value='drafting_stack')])),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='workflow', ctx=Load()),
              attr='add_edge',
              ctx=Load()),
            args=[
              Constant(value='drafting_stack'),
              Constant(value='qa_swarm')])),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='workflow', ctx=Load()),
              attr='add_edge',
              ctx=Load()),
            args=[
              Constant(value='replanner'),
              Constant(value='bullet_stack')])),
        If(
          test=BoolOp(
            op=And(),
            values=[
              Name(id='enable_hil', ctx=Load()),
              Attribute(
                value=Attribute(
                  value=Name(id='CONFIG', ctx=Load()),
                  attr='hil_config',
                  ctx=Load()),
                attr='enable_content_approval',
                ctx=Load())]),
          body=[
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='logger', ctx=Load()),
                  attr='info',
                  ctx=Load()),
                args=[
                  Constant(value='Building graph with HIL Content Approval ENABLED.')])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='workflow', ctx=Load()),
                  attr='add_node',
                  ctx=Load()),
                args=[
                  Constant(value='human_review_pause'),
                  Name(id='human_review_pause', ctx=Load())])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='workflow', ctx=Load()),
                  attr='add_node',
                  ctx=Load()),
                args=[
                  Constant(value='capture_preferences'),
                  Name(id='run_preference_capture', ctx=Load())])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='workflow', ctx=Load()),
                  attr='add_conditional_edges',
                  ctx=Load()),
                args=[
                  Constant(value='qa_swarm'),
                  Name(id='check_qa_results', ctx=Load()),
                  Dict(
                    keys=[
                      Constant(value='human_review_pause'),
                      Constant(value='FAIL_HALT'),
                      Constant(value='REPLANNER')],
                    values=[
                      Constant(value='human_review_pause'),
                      Name(id='END', ctx=Load()),
                      Constant(value='replanner')])])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='workflow', ctx=Load()),
                  attr='add_edge',
                  ctx=Load()),
                args=[
                  Constant(value='human_review_pause'),
                  Constant(value='capture_preferences')])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='workflow', ctx=Load()),
                  attr='add_edge',
                  ctx=Load()),
                args=[
                  Constant(value='capture_preferences'),
                  Name(id='END', ctx=Load())])),
            Assign(
              targets=[
                Name(id='interrupt_nodes', ctx=Store())],
              value=List(
                elts=[
                  Constant(value='human_review_pause')],
                ctx=Load()))],
          orelse=[
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='logger', ctx=Load()),
                  attr='info',
                  ctx=Load()),
                args=[
                  Constant(value='Building graph with HIL Content Approval DISABLED.')])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='workflow', ctx=Load()),
                  attr='add_conditional_edges',
                  ctx=Load()),
                args=[
                  Constant(value='qa_swarm'),
                  Name(id='check_qa_results', ctx=Load()),
                  Dict(
                    keys=[
                      Constant(value='human_review_pause'),
                      Constant(value='FAIL_HALT'),
                      Constant(value='REPLANNER')],
                    values=[
                      Name(id='END', ctx=Load()),
                      Name(id='END', ctx=Load()),
                      Constant(value='replanner')])])),
            Assign(
              targets=[
                Name(id='interrupt_nodes', ctx=Store())],
              value=List(ctx=Load()))]),
        Return(
          value=Call(
            func=Attribute(
              value=Name(id='workflow', ctx=Load()),
              attr='compile',
              ctx=Load()),
            keywords=[
              keyword(
                arg='checkpointer',
                value=Name(id='checkpointer', ctx=Load())),
              keyword(
                arg='interrupt_before',
                value=Name(id='interrupt_nodes', ctx=Load()))]))],
      returns=Constant(value='CompiledGraph')),
    Assign(
      targets=[
        Name(id='__all__', ctx=Store())],
      value=List(
        elts=[
          Constant(value='get_graph_app'),
          Constant(value='PreferenceCaptureAgent'),
          Constant(value='WorkflowSteps'),
          Constant(value='FeedbackLoggerAgent'),
          Constant(value='ThemeClassifierAgent'),
          Constant(value='RAG_QueryGeneratorAgent'),
          Constant(value='RAG_SearchAgent'),
          Constant(value='RAG_CritiqueAgent'),
          Constant(value='PromptStackAgent'),
          Constant(value='ProvenanceRouterAgent'),
          Constant(value='CustomizedBulletDrafterAgent'),
          Constant(value='SyntheticBulletDrafterAgent'),
          Constant(value='DraftingConductorAgent'),
          Constant(value='WorkflowRePlannerAgent'),
          Constant(value='QAConductorAgent'),
          Constant(value='AtomicQASwarmLogic')],
        ctx=Load()))])