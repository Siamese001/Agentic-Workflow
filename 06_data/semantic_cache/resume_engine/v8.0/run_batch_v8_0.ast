                                slice=Constant(value='title'),
                                ctx=Load()),
                              Subscript(
                                value=Name(id='summary', ctx=Load()),
                                slice=Constant(value='status'),
                                ctx=Load()),
                              Subscript(
                                value=Name(id='summary', ctx=Load()),
                                slice=Constant(value='workflow_id'),
                                ctx=Load()),
                              Subscript(
                                value=Name(id='summary', ctx=Load()),
                                slice=Constant(value='error'),
                                ctx=Load())],
                            ctx=Load())]))])]),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='logger', ctx=Load()),
                  attr='info',
                  ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='Batch summary CSV updated with '),
                      FormattedValue(
                        value=Call(
                          func=Name(id='len', ctx=Load()),
                          args=[
                            Name(id='all_results', ctx=Load())]),
                        conversion=-1),
                      Constant(value=' results.')])]))],
          handlers=[
            ExceptHandler(
              type=Name(id='Exception', ctx=Load()),
              name='e',
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='logger', ctx=Load()),
                      attr='error',
