    ClassDef(
      name='DAGExecutor',
      body=[
        Expr(
          value=Constant(value='\n    Deterministic executor for DAG nodes with:\n\n        • Parallel execution of independent nodes.\n        • Fallback-friendly error handling (DAG-level).\n        • Per-node retries according to DAGNode.max_retries.\n        • Predictive cache hinting (metadata only).\n        • NodeResult metadata emission.\n        • Route trace and correction journal surfaces.\n\n    All durable state writes must go through the provided StateAdapter\n    (L4). L3 does NOT mutate state directly.\n    ')),
        FunctionDef(
          name='__init__',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='state_adapter',
                annotation=Name(id='StateAdapter', ctx=Load())),
              arg(
                arg='l2_executor',
                annotation=Subscript(
                  value=Name(id='Callable', ctx=Load()),
                  slice=Tuple(
                    elts=[
                      List(
                        elts=[
                          Name(id='PlanObject', ctx=Load()),
                          Subscript(
                            value=Name(id='Dict', ctx=Load()),
                            slice=Tuple(
                              elts=[
                                Name(id='str', ctx=Load()),
                                Name(id='Any', ctx=Load())],
                              ctx=Load()),
                            ctx=Load())],
                        ctx=Load()),
                      Subscript(
                        value=Name(id='Awaitable', ctx=Load()),
                        slice=Subscript(
                          value=Name(id='ExecutionResult', ctx=Load()),
                          slice=Name(id='Any', ctx=Load()),
                          ctx=Load()),
                        ctx=Load())],
                    ctx=Load()),
                  ctx=Load()))],
            defaults=[
              Name(id='route_executor', ctx=Load())]),
          body=[
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='state_adapter',
                  ctx=Store())],
              value=Name(id='state_adapter', ctx=Load())),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='l2_executor',
                  ctx=Store())],
              value=Name(id='l2_executor', ctx=Load())),
            AnnAssign(
              target=Attribute(
                value=Name(id='self', ctx=Load()),
                attr='node_results',
                ctx=Store()),
              annotation=Subscript(
                value=Name(id='Dict', ctx=Load()),
                slice=Tuple(
                  elts=[
                    Name(id='str', ctx=Load()),
                    Name(id='NodeResult', ctx=Load())],
                  ctx=Load()),
                ctx=Load()),
              value=Dict(),
              simple=0),
            AnnAssign(
              target=Attribute(
                value=Name(id='self', ctx=Load()),
                attr='route_trace',
                ctx=Store()),
              annotation=Subscript(
                value=Name(id='List', ctx=Load()),
                slice=Name(id='RouteTraceEntry', ctx=Load()),
                ctx=Load()),
