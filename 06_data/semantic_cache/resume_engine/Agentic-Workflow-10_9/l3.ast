        alias(name='route_executor')],
      level=0),
    ImportFrom(
      module='meta_profile',
      names=[
        alias(name='get_routing_bias'),
        alias(name='get_safety_bias'),
        alias(name='get_meta_profile_snapshot')],
      level=0),
    ClassDef(
      name='DAGValidationError',
      bases=[
        Name(id='ValidationError', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Raised when a DAG is structurally invalid (missing nodes, cycles, etc.).'))]),
    ClassDef(
      name='ControlFlowError',
      bases=[
        Name(id='Exception', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Raised when orchestration cannot make progress due to misconfigured DAG.'))]),
    ClassDef(
      name='NodeExecutionError',
      bases=[
        Name(id='Exception', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Raised when a node fails irrecoverably after retries.'))]),
    ClassDef(
      name='DAGNode',
      body=[
        Expr(
          value=Constant(value='\n    Single node in the orchestration DAG.\n\n    Fields:\n        name:                  unique node identifier\n        mode:                  L2 executor mode (strategy, rag, etc.)\n        plan:                  PlanObject or plan dict for this node\n        depends_on:            upstream node names\n        fallback:              fallback node names (declared in DAG, not executed here)\n        parallel_group:        logical parallel group (metadata only)\n        max_retries:           max retries before marking node ERROR\n        predictive_cache_key:  hint for external caching (metadata only)\n        surfaces:              self-correction surfaces (for journaling)\n    ')),
        AnnAssign(
          target=Name(id='name', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='mode', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='plan', ctx=Store()),
          annotation=Name(id='PlanObject', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='depends_on', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load()),
          value=Call(
            func=Name(id='field', ctx=Load()),
            keywords=[
              keyword(
                arg='default_factory',
                value=Name(id='list', ctx=Load()))]),
          simple=1),
        AnnAssign(
          target=Name(id='fallback', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load()),
          value=Call(
            func=Name(id='field', ctx=Load()),
            keywords=[
              keyword(
                arg='default_factory',
                value=Name(id='list', ctx=Load()))]),
          simple=1),
        AnnAssign(
          target=Name(id='parallel_group', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Optional', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load()),
          value=Constant(value=None),
          simple=1),
        AnnAssign(
          target=Name(id='max_retries', ctx=Store()),
          annotation=Name(id='int', ctx=Load()),
          value=Constant(value=0),
          simple=1),
        AnnAssign(
          target=Name(id='predictive_cache_key', ctx=Store()),
          annotation=Subscript(
