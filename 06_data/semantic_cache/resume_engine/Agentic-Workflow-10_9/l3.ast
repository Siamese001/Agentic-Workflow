                  attr='strip',
                  ctx=Load()))),
            If(
              test=BoolOp(
                op=Or(),
                values=[
                  UnaryOp(
                    op=Not(),
                    operand=Name(id='name', ctx=Load())),
                  UnaryOp(
                    op=Not(),
                    operand=Name(id='mode', ctx=Load()))]),
              body=[
                Raise(
                  exc=Call(
                    func=Name(id='DAGValidationError', ctx=Load()),
                    args=[
                      Constant(value="Each DAG node must have non-empty 'name' and 'mode'.")]))]),
