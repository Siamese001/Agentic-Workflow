                          attr='get',
                          ctx=Load()),
                        args=[
                          Constant(value='name'),
                          Constant(value='')])]),
                  attr='strip',
                  ctx=Load()))),
            Assign(
              targets=[
                Name(id='mode', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Call(
                    func=Name(id='str', ctx=Load()),
                    args=[
                      Call(
                        func=Attribute(
                          value=Name(id='ns', ctx=Load()),
                          attr='get',
                          ctx=Load()),
                        args=[
                          Constant(value='mode'),
