          value=Call(
            func=Name(id='field', ctx=Load()),
            keywords=[
              keyword(
                arg='default_factory',
                value=Name(id='list', ctx=Load()))]),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='DAGModel',
      body=[
        Expr(
          value=Constant(value='\n    In-memory representation of a workflow DAG.\n\n    nodes: mapping of node_name -> DAGNode\n    ')),
        AnnAssign(
          target=Name(id='nodes', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='DAGNode', ctx=Load())],
              ctx=Load()),
            ctx=Load()),
          value=Call(
            func=Name(id='field', ctx=Load()),
            keywords=[
              keyword(
                arg='default_factory',
                value=Name(id='dict', ctx=Load()))]),
          simple=1),
        FunctionDef(
          name='validate',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='\n        Validate basic DAG invariants:\n\n            • Node keys must match node.name.\n            • All dependencies and fallback targets must exist.\n            • Graph must be acyclic.\n        ')),
            For(
              target=Tuple(
                elts=[
                  Name(id='node_name', ctx=Store()),
                  Name(id='node', ctx=Store())],
                ctx=Store()),
              iter=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='nodes',
                    ctx=Load()),
                  attr='items',
                  ctx=Load())),
              body=[
                If(
                  test=Compare(
                    left=Name(id='node_name', ctx=Load()),
                    ops=[
                      NotEq()],
                    comparators=[
                      Attribute(
                        value=Name(id='node', ctx=Load()),
                        attr='name',
                        ctx=Load())]),
                  body=[
                    Raise(
                      exc=Call(
                        func=Name(id='DAGValidationError', ctx=Load()),
                        args=[
                          JoinedStr(
                            values=[
                              Constant(value="Node key '"),
                              FormattedValue(
                                value=Name(id='node_name', ctx=Load()),
                                conversion=-1),
                              Constant(value="' does not match node name '"),
                              FormattedValue(
                                value=Attribute(
                                  value=Name(id='node', ctx=Load()),
                                  attr='name',
                                  ctx=Load()),
                                conversion=-1),
                              Constant(value="'.")])]))])]),
            For(
              target=Name(id='node', ctx=Store()),
              iter=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='nodes',
                    ctx=Load()),
                  attr='values',
                  ctx=Load())),
              body=[
                For(
                  target=Name(id='dep', ctx=Store()),
                  iter=Attribute(
                    value=Name(id='node', ctx=Load()),
                    attr='depends_on',
                    ctx=Load()),
                  body=[
                    If(
                      test=Compare(
                        left=Name(id='dep', ctx=Load()),
                        ops=[
                          NotIn()],
                        comparators=[
                          Attribute(
                            value=Name(id='self', ctx=Load()),
                            attr='nodes',
                            ctx=Load())]),
                      body=[
                        Raise(
                          exc=Call(
                            func=Name(id='DAGValidationError', ctx=Load()),
                            args=[
                              JoinedStr(
                                values=[
                                  Constant(value="Dependency '"),
                                  FormattedValue(
                                    value=Name(id='dep', ctx=Load()),
                                    conversion=-1),
                                  Constant(value="' for node '"),
                                  FormattedValue(
                                    value=Attribute(
                                      value=Name(id='node', ctx=Load()),
                                      attr='name',
                                      ctx=Load()),
                                    conversion=-1),
                                  Constant(value="' is not defined.")])]))])]),
                For(
                  target=Name(id='fb', ctx=Store()),
                  iter=Attribute(
                    value=Name(id='node', ctx=Load()),
                    attr='fallback',
                    ctx=Load()),
                  body=[
                    If(
                      test=Compare(
                        left=Name(id='fb', ctx=Load()),
                        ops=[
                          NotIn()],
                        comparators=[
                          Attribute(
                            value=Name(id='self', ctx=Load()),
                            attr='nodes',
                            ctx=Load())]),
                      body=[
                        Raise(
                          exc=Call(
                            func=Name(id='DAGValidationError', ctx=Load()),
                            args=[
                              JoinedStr(
                                values=[
                                  Constant(value="Fallback target '"),
                                  FormattedValue(
                                    value=Name(id='fb', ctx=Load()),
                                    conversion=-1),
                                  Constant(value="' for node '"),
                                  FormattedValue(
                                    value=Attribute(
                                      value=Name(id='node', ctx=Load()),
                                      attr='name',
                                      ctx=Load()),
                                    conversion=-1),
                                  Constant(value="' is not defined.")])]))])])]),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='_ensure_acyclic',
                  ctx=Load())))],
          returns=Constant(value=None)),
        FunctionDef(
          name='_ensure_acyclic',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            AnnAssign(
              target=Name(id='indegree', ctx=Store()),
              annotation=Subscript(
                value=Name(id='Dict', ctx=Load()),
                slice=Tuple(
                  elts=[
                    Name(id='str', ctx=Load()),
                    Name(id='int', ctx=Load())],
                  ctx=Load()),
                ctx=Load()),
              value=DictComp(
                key=Name(id='name', ctx=Load()),
                value=Constant(value=0),
                generators=[
                  comprehension(
                    target=Name(id='name', ctx=Store()),
                    iter=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='nodes',
                      ctx=Load()),
                    is_async=0)]),
              simple=1),
            For(
              target=Name(id='node', ctx=Store()),
              iter=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='nodes',
                    ctx=Load()),
                  attr='values',
                  ctx=Load())),
              body=[
                For(
                  target=Name(id='dep', ctx=Store()),
                  iter=Attribute(
                    value=Name(id='node', ctx=Load()),
                    attr='depends_on',
                    ctx=Load()),
                  body=[
                    AugAssign(
                      target=Subscript(
                        value=Name(id='indegree', ctx=Load()),
                        slice=Attribute(
                          value=Name(id='node', ctx=Load()),
                          attr='name',
                          ctx=Load()),
                        ctx=Store()),
                      op=Add(),
                      value=Constant(value=1))])]),
            AnnAssign(
              target=Name(id='queue', ctx=Store()),
              annotation=Subscript(
                value=Name(id='List', ctx=Load()),
                slice=Name(id='str', ctx=Load()),
                ctx=Load()),
              value=ListComp(
                elt=Name(id='n', ctx=Load()),
                generators=[
                  comprehension(
                    target=Tuple(
                      elts=[
                        Name(id='n', ctx=Store()),
                        Name(id='deg', ctx=Store())],
                      ctx=Store()),
                    iter=Call(
                      func=Attribute(
                        value=Name(id='indegree', ctx=Load()),
                        attr='items',
                        ctx=Load())),
                    ifs=[
                      Compare(
                        left=Name(id='deg', ctx=Load()),
                        ops=[
                          Eq()],
                        comparators=[
                          Constant(value=0)])],
                    is_async=0)]),
              simple=1),
            Assign(
              targets=[
                Name(id='visited_count', ctx=Store())],
              value=Constant(value=0)),
            While(
              test=Name(id='queue', ctx=Load()),
              body=[
                Assign(
                  targets=[
                    Name(id='current', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='queue', ctx=Load()),
                      attr='pop',
                      ctx=Load()))),
                AugAssign(
                  target=Name(id='visited_count', ctx=Store()),
                  op=Add(),
                  value=Constant(value=1)),
                For(
                  target=Name(id='neighbor', ctx=Store()),
                  iter=Call(
                    func=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='_dependents_of',
                      ctx=Load()),
                    args=[
                      Name(id='current', ctx=Load())]),
                  body=[
                    AugAssign(
                      target=Subscript(
                        value=Name(id='indegree', ctx=Load()),
                        slice=Name(id='neighbor', ctx=Load()),
                        ctx=Store()),
                      op=Sub(),
                      value=Constant(value=1)),
                    If(
                      test=Compare(
                        left=Subscript(
                          value=Name(id='indegree', ctx=Load()),
                          slice=Name(id='neighbor', ctx=Load()),
                          ctx=Load()),
                        ops=[
                          Eq()],
                        comparators=[
                          Constant(value=0)]),
                      body=[
                        Expr(
                          value=Call(
                            func=Attribute(
                              value=Name(id='queue', ctx=Load()),
                              attr='append',
                              ctx=Load()),
                            args=[
                              Name(id='neighbor', ctx=Load())]))])])]),
            If(
              test=Compare(
                left=Name(id='visited_count', ctx=Load()),
                ops=[
                  NotEq()],
                comparators=[
                  Call(
                    func=Name(id='len', ctx=Load()),
                    args=[
                      Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='nodes',
                        ctx=Load())])]),
              body=[
                Raise(
                  exc=Call(
                    func=Name(id='DAGValidationError', ctx=Load()),
                    args=[
                      Constant(value='DAG contains at least one cycle.')]))])],
          returns=Constant(value=None)),
        FunctionDef(
          name='_dependents_of',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='node_name',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            AnnAssign(
              target=Name(id='deps', ctx=Store()),
              annotation=Subscript(
                value=Name(id='List', ctx=Load()),
                slice=Name(id='str', ctx=Load()),
                ctx=Load()),
              value=List(ctx=Load()),
              simple=1),
            For(
              target=Name(id='n', ctx=Store()),
              iter=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='nodes',
                    ctx=Load()),
                  attr='values',
                  ctx=Load())),
              body=[
                If(
                  test=Compare(
                    left=Name(id='node_name', ctx=Load()),
