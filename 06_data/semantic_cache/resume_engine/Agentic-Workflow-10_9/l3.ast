                        ctx=Load())),
                    ifs=[
                      UnaryOp(
                        op=Not(),
                        operand=Attribute(
                          value=Name(id='n', ctx=Load()),
                          attr='depends_on',
                          ctx=Load()))],
                    is_async=0)]))],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='DAGNode', ctx=Load()),
            ctx=Load()))],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    FunctionDef(
      name='build_dag_from_plan',
      args=arguments(
        args=[
          arg(
            arg='plan',
            annotation=Name(id='PlanObject', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Construct a DAGModel from an L1 PlanObject.\n\n    Expected plan structure:\n\n        plan["dag"] = {\n            "nodes": [\n                {\n                    "name": "strategy",\n                    "mode": "strategy",\n                    "depends_on": [],\n                    "fallback": [],\n                    "parallel_group": null,\n                    "max_retries": 0,\n                    "predictive_cache_key": {...},\n                    "surfaces": [...]\n                },\n                ...\n            ]\n        }\n\n    If no "dag" block is present, we construct a minimal single-node DAG\n    representing the plan itself (backwards-compatible with simple flows).\n    ')),
        Assign(
          targets=[
            Name(id='dag_spec', ctx=Store())],
          value=BoolOp(
            op=Or(),
            values=[
              Call(
                func=Attribute(
                  value=Name(id='plan', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='dag')]),
              Dict()])),
        Assign(
          targets=[
            Name(id='nodes_spec', ctx=Store())],
          value=BoolOp(
            op=Or(),
            values=[
              Call(
                func=Attribute(
                  value=Name(id='dag_spec', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='nodes')]),
              List(ctx=Load())])),
        If(
          test=UnaryOp(
            op=Not(),
            operand=Name(id='nodes_spec', ctx=Load())),
          body=[
            Assign(
              targets=[
                Name(id='mode', ctx=Store())],
              value=BoolOp(
                op=Or(),
                values=[
                  Call(
                    func=Attribute(
                      value=Name(id='plan', ctx=Load()),
                      attr='get',
                      ctx=Load()),
                    args=[
                      Constant(value='mode')]),
                  Constant(value='unknown')])),
            Assign(
              targets=[
                Name(id='node', ctx=Store())],
              value=Call(
                func=Name(id='DAGNode', ctx=Load()),
                keywords=[
                  keyword(
                    arg='name',
                    value=Call(
                      func=Name(id='str', ctx=Load()),
                      args=[
                        Call(
                          func=Attribute(
                            value=Name(id='plan', ctx=Load()),
                            attr='get',
                            ctx=Load()),
                          args=[
                            Constant(value='name'),
                            Name(id='mode', ctx=Load())])])),
                  keyword(
                    arg='mode',
                    value=Call(
                      func=Name(id='str', ctx=Load()),
                      args=[
                        Name(id='mode', ctx=Load())])),
                  keyword(
                    arg='plan',
                    value=Name(id='plan', ctx=Load())),
                  keyword(
                    arg='depends_on',
                    value=List(ctx=Load())),
                  keyword(
                    arg='fallback',
                    value=List(ctx=Load())),
                  keyword(
                    arg='parallel_group',
                    value=Constant(value=None)),
                  keyword(
                    arg='max_retries',
                    value=Call(
                      func=Name(id='int', ctx=Load()),
                      args=[
                        Call(
                          func=Attribute(
                            value=Name(id='plan', ctx=Load()),
                            attr='get',
                            ctx=Load()),
                          args=[
                            Constant(value='max_retries'),
                            Constant(value=0)])])),
                  keyword(
                    arg='predictive_cache_key',
                    value=Call(
                      func=Attribute(
                        value=Name(id='plan', ctx=Load()),
                        attr='get',
                        ctx=Load()),
                      args=[
                        Constant(value='predictive_cache_key')])),
                  keyword(
                    arg='surfaces',
                    value=List(
                      elts=[
                        Constant(value='rag_retry'),
                        Constant(value='draft_retry'),
                        Constant(value='qa_recheck'),
                        Constant(value='safety_risk')],
                      ctx=Load()))])),
            Assign(
              targets=[
                Name(id='dag', ctx=Store())],
              value=Call(
                func=Name(id='DAGModel', ctx=Load()),
                keywords=[
                  keyword(
                    arg='nodes',
                    value=Dict(
                      keys=[
                        Attribute(
                          value=Name(id='node', ctx=Load()),
                          attr='name',
                          ctx=Load())],
                      values=[
                        Name(id='node', ctx=Load())]))])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='dag', ctx=Load()),
                  attr='validate',
                  ctx=Load()))),
            Return(
              value=Name(id='dag', ctx=Load()))]),
        AnnAssign(
          target=Name(id='nodes', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='DAGNode', ctx=Load())],
              ctx=Load()),
            ctx=Load()),
          value=Dict(),
          simple=1),
        For(
          target=Name(id='ns', ctx=Store()),
          iter=Name(id='nodes_spec', ctx=Load()),
          body=[
            Assign(
              targets=[
                Name(id='name', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Call(
                    func=Name(id='str', ctx=Load()),
                    args=[
                      Call(
                        func=Attribute(
