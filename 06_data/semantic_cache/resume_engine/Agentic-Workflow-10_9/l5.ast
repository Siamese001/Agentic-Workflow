            values=[
              Call(
                func=Attribute(
                  value=Name(id='safety_bias', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='heightened_caution')]),
              Call(
                func=Attribute(
                  value=Name(id='planning_bias', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='conservative')])]),
          body=[
            Return(
              value=Attribute(
                value=Name(id='SafetyMode', ctx=Load()),
                attr='STRICT',
                ctx=Load()))]),
        If(
          test=BoolOp(
            op=And(),
            values=[
              Compare(
                left=Name(id='base_mode', ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Attribute(
                    value=Name(id='SafetyMode', ctx=Load()),
                    attr='PERMISSIVE',
                    ctx=Load())]),
              Call(
                func=Attribute(
                  value=Name(id='safety_bias', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='human_review_important')])]),
          body=[
