                        attr='config',
                        ctx=Load()),
                      attr='get',
                      ctx=Load()),
                    args=[
                      Constant(value='tier'),
                      Constant(value='primary')])])),
            Assign(
              targets=[
                Name(id='base', ctx=Store())],
              value=Constant(value=0.5)),
            If(
              test=Compare(
                left=Name(id='severity', ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value='strict')]),
              body=[
                AugAssign(
                  target=Name(id='base', ctx=Store()),
                  op=Add(),
                  value=Constant(value=0.2))],
              orelse=[
                If(
                  test=Compare(
                    left=Name(id='severity', ctx=Load()),
                    ops=[
