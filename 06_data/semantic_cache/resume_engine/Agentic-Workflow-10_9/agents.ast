                      Attribute(
                        value=Name(id='node', ctx=Load()),
                        attr='role',
                        ctx=Load()),
                      Name(id='tier', ctx=Load()),
                      Name(id='score', ctx=Load()),
                      JoinedStr(
                        values=[
                          Constant(value='severity='),
                          FormattedValue(
                            value=Name(id='severity', ctx=Load()),
                            conversion=-1),
                          Constant(value=', issues='),
                          FormattedValue(
                            value=Name(id='issue_count', ctx=Load()),
                            conversion=-1),
                          Constant(value=', tier='),
                          FormattedValue(
                            value=Name(id='tier', ctx=Load()),
                            conversion=-1)])])]))]),
        Return(
