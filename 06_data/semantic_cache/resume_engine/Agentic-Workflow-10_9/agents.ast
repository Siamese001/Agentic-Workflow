              body=[
                AugAssign(
                  target=Name(id='base', ctx=Store()),
                  op=Add(),
                  value=Call(
                    func=Name(id='min', ctx=Load()),
                    args=[
                      Constant(value=0.3),
                      BinOp(
                        left=Name(id='issue_count', ctx=Load()),
                        op=Mult(),
                        right=Constant(value=0.05))]))]),
            If(
              test=Compare(
                left=Name(id='tier', ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value='primary')]),
              body=[
                AugAssign(
