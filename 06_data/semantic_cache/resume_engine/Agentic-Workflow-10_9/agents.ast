                              Constant(value='normal')])]),
                      attr='lower',
                      ctx=Load())))])]),
        Assign(
          targets=[
            Name(id='qa_result', ctx=Store())],
          value=BoolOp(
            op=Or(),
            values=[
              Call(
                func=Attribute(
                  value=Name(id='state', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='qa_result')]),
              Dict()])),
        Assign(
          targets=[
            Name(id='report', ctx=Store())],
          value=BoolOp(
            op=Or(),
            values=[
              Call(
                func=Attribute(
                  value=Name(id='qa_result', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='report')]),
              Name(id='qa_result', ctx=Load())])),
        Assign(
          targets=[
