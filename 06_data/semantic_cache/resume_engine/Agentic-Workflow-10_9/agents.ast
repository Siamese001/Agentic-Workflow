        ctx=Load())),
    FunctionDef(
      name='deterministic_vote',
      args=arguments(
        args=[
          arg(
            arg='candidates',
            annotation=Subscript(
              value=Name(id='List', ctx=Load()),
              slice=Subscript(
                value=Name(id='Dict', ctx=Load()),
                slice=Tuple(
                  elts=[
                    Name(id='str', ctx=Load()),
                    Name(id='Any', ctx=Load())],
                  ctx=Load()),
                ctx=Load()),
              ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='Highest score wins; ties broken by lowest agent_id.')),
        If(
          test=UnaryOp(
            op=Not(),
            operand=Name(id='candidates', ctx=Load())),
          body=[
            Return(
              value=Dict(
                keys=[
                  Constant(value='id'),
                  Constant(value='node_name'),
                  Constant(value='role'),
                  Constant(value='score'),
                  Constant(value='rationale')],
