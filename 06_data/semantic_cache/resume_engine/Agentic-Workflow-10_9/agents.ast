      body=[
        Expr(
          value=Constant(value='\n    Deterministic scoring for each meta-agent in a QA council.\n    Higher score → higher scrutiny / more conservative decision\n    depending on severity and findings.\n    ')),
        Assign(
          targets=[
            Name(id='severity', ctx=Store())],
          value=Constant(value='normal')),
        If(
          test=Call(
