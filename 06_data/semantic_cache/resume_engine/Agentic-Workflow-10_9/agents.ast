          value=Call(
            func=Name(id='len', ctx=Load()),
            args=[
              Name(id='issues', ctx=Load())])),
        Assign(
          targets=[
            Name(id='candidates', ctx=Store())],
          value=List(ctx=Load())),
        For(
          target=Tuple(
            elts=[
              Name(id='node_name', ctx=Store()),
