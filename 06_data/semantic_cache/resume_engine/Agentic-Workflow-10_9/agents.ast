              test=Call(
                func=Name(id='isinstance', ctx=Load()),
                args=[
                  Name(id='plan', ctx=Load()),
                  Name(id='dict', ctx=Load())]),
              body=[
                Assign(
                  targets=[
                    Name(id='severity', ctx=Store())],
                  value=Call(
                    func=Attribute(
