                                  Constant(value=0)])]))])]),
                AnnAssign(
                  target=Name(id='raw_docs', ctx=Store()),
                  annotation=Subscript(
                    value=Name(id='List', ctx=Load()),
                    slice=Subscript(
                      value=Name(id='Dict', ctx=Load()),
                      slice=Tuple(
