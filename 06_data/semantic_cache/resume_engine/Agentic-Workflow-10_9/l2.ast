                      op=Or(),
                      values=[
                        Call(
                          func=Name(id='str', ctx=Load()),
                          args=[
                            Call(
                              func=Attribute(
                                value=Name(id='plan', ctx=Load()),
                                attr='get',
                                ctx=Load()),
                              args=[
                                Constant(value='complexity'),
                                Constant(value='')])]),
                        Constant(value=None)])),
                  keyword(
