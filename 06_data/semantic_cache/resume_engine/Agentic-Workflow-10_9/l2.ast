Module(
  body=[
    Expr(
      value=Constant(value='\nUnified L2 Execution Layer (v10_9) — ENTERPRISE REFINEMENT (META-AWARE)\n\nThis module implements ALL L2 responsibilities for the v10_9 agentic\nworkflow. It is strictly *execution-only*:\n\n    • Executes PlanObjects produced by L1 (one domain per executor).\n    • Performs retrieval, ranking, and evidence fusion (RAG).\n    • Generates bullets based on planning hints and resume metrics.\n    • Produces drafting outputs (multi-section drafts, evidence-weighted).\n    • Runs QA checks according to L1 QA plans (including shadow validation).\n    • Performs safety evaluation (PII, forbidden content, toxicity).\n    • Prepares HIL prompts and consumes HIL responses.\n    • Prepares prompt envelope metadata for the prompt layer.\n    • Produces meta-learning snapshots from logs/state.\n    • Returns ExecutionResult[TypedPayload], never raw untyped blobs.\n\nL2 DOES NOT:\n\n    • Perform planning (L1 cognition).\n    • Own graph orchestration or control flow (L3).\n    • Mutate durable state (L4).\n    • Make final safety/policy decisions (L5).\n    • Call provider SDKs directly (OpenAI/Anthropic/Gemini, etc.).\n\nAdditionally, L2 is now **META-aware** via `meta_profile`:\n\n    • routing_bias    → influences RAG strategy, HYDE usage, speed vs robustness.\n    • planning_bias   → influences drafting depth and caution level.\n    • qa_bias         → influences QA strictness and additional checks.\n    • safety_bias     → influences safety evaluation intensity.\n\nThis refactor aligns L2 with:\n\n    • Full restoration of v10_8 execution behavior.\n    • Strict L1–L5 separation.\n    • Maximum scores across the 14 OpenAI agentic subdomains.\n')),
    ImportFrom(
      module='__future__',
      names=[
        alias(name='annotations')],
      level=0),
    Import(
      names=[
        alias(name='asyncio')]),
    Import(
      names=[
        alias(name='re')]),
    ImportFrom(
      module='abc',
      names=[
        alias(name='ABC'),
        alias(name='abstractmethod')],
      level=0),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Any'),
        alias(name='Dict'),
        alias(name='List'),
        alias(name='Optional'),
        alias(name='Callable'),
        alias(name='Awaitable'),
        alias(name='Sequence')],
      level=0),
    ImportFrom(
      module='models',
      names=[
        alias(name='PlanObject'),
        alias(name='ExecutionResult'),
        alias(name='StrategyExecutionPayload'),
        alias(name='StrategyBranch'),
        alias(name='RAGExecutionPayload'),
        alias(name='RAGDocument'),
        alias(name='RAGExternalStats'),
        alias(name='BulletExecutionPayload'),
        alias(name='DraftExecutionPayload'),
        alias(name='QAExecutionPayload'),
        alias(name='QAFinding'),
        alias(name='QAReport'),
        alias(name='SafetyExecutionPayload'),
        alias(name='SafetyIssue'),
        alias(name='SafetyReport'),
        alias(name='HILExecutionPayload'),
        alias(name='HILPrompt'),
        alias(name='HILResponse'),
        alias(name='MetaLearningExecutionPayload'),
        alias(name='MetaLearningSnapshot'),
        alias(name='MetaLearningFinding')],
      level=0),
    ImportFrom(
      module='exceptions',
      names=[
        alias(name='ValidationError'),
        alias(name='WorkflowTimeoutError'),
        alias(name='ToolExecutionError')],
      level=0),
    ImportFrom(
      module='retrieval',
      names=[
        alias(name='Retrieval')],
      level=0),
    ImportFrom(
      module='ranking',
      names=[
        alias(name='Ranking')],
      level=0),
    ImportFrom(
      module='meta_profile',
      names=[
        alias(name='get_routing_bias'),
        alias(name='get_planning_bias'),
        alias(name='get_qa_bias'),
        alias(name='get_safety_bias')],
      level=0),
    Assign(
      targets=[
        Name(id='AsyncExecutorFn', ctx=Store())],
      value=Subscript(
        value=Name(id='Callable', ctx=Load()),
        slice=Tuple(
          elts=[
            List(
              elts=[
                Name(id='PlanObject', ctx=Load()),
                Subscript(
                  value=Name(id='Dict', ctx=Load()),
                  slice=Tuple(
                    elts=[
                      Name(id='str', ctx=Load()),
                      Name(id='Any', ctx=Load())],
                    ctx=Load()),
                  ctx=Load())],
              ctx=Load()),
            Subscript(
              value=Name(id='Awaitable', ctx=Load()),
              slice=Subscript(
                value=Name(id='ExecutionResult', ctx=Load()),
                slice=Name(id='Any', ctx=Load()),
                ctx=Load()),
              ctx=Load())],
          ctx=Load()),
        ctx=Load())),
    ClassDef(
      name='ExecutionAgent',
      bases=[
        Name(id='ABC', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='\n    Abstract base class for all L2 executors.\n\n    Each executor is responsible for exactly ONE domain:\n\n        • StrategyExecutor           → "strategy"\n        • RAGExecutor                → "rag"\n        • BulletExecutor             → "bullets"\n        • DraftingExecutor           → "drafting"\n        • QAExecutor                 → "qa"\n        • SafetyExecutor             → "safety"\n        • PromptEngineeringExecutor  → "prompt_engineering"\n        • HILExecutor                → "hil"\n        • MetaLearningExecutor       → "meta_learning"\n\n    This satisfies the Agentic constraint that each agent owns at most\n    one–two capabilities and keeps domains well-separated.\n    ')),
        AsyncFunctionDef(
          name='execute',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='plan',
                annotation=Name(id='PlanObject', ctx=Load())),
              arg(
                arg='state',
                annotation=Subscript(
                  value=Name(id='Dict', ctx=Load()),
                  slice=Tuple(
                    elts=[
                      Name(id='str', ctx=Load()),
                      Name(id='Any', ctx=Load())],
                    ctx=Load()),
                  ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Execute a plan against the current state and return an ExecutionResult\n        with a typed payload.\n\n        Implementations MUST NOT:\n            • modify state\n            • call orchestrators\n            • make safety/policy decisions\n\n        They MAY:\n            • call provider-layer tools in future extensions\n            • perform deterministic local computations\n        ')),
            Raise(
              exc=Name(id='NotImplementedError', ctx=Load()))],
          decorator_list=[
            Name(id='abstractmethod', ctx=Load())],
          returns=Subscript(
            value=Name(id='ExecutionResult', ctx=Load()),
            slice=Name(id='Any', ctx=Load()),
            ctx=Load()))]),
    ClassDef(
      name='StrategyExecutor',
      bases=[
        Name(id='ExecutionAgent', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='\n    Execute a strategy plan by selecting a branch and returning a\n    StrategyExecutionPayload.\n\n    L1 supplies:\n        plan["branches"]            (list of strategy branches)\n        plan["complexity"]          (complexity hint)\n        plan["reasoning_strategy"]  (CoT / ToT hint)\n        plan["planning_hints"]      (QA/safety/context/optimization hints)\n\n    This executor focuses on:\n        • Normalizing strategy branches into StrategyBranch objects.\n        • Selecting a primary branch deterministically (or by hints).\n        • Exposing metadata for multi-agent councils and self-correction surfaces.\n    ')),
        AsyncFunctionDef(
          name='execute',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='plan',
                annotation=Name(id='PlanObject', ctx=Load())),
              arg(
