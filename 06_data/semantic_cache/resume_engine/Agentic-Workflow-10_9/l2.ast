          returns=Subscript(
            value=Name(id='ExecutionResult', ctx=Load()),
            slice=Name(id='StrategyExecutionPayload', ctx=Load()),
            ctx=Load()))]),
    ClassDef(
      name='RAGExecutor',
      bases=[
        Name(id='ExecutionAgent', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='\n    Execute a RAG plan:\n\n        • Interpret plan["retrieval"] (queries, filters, ranking, metadata).\n        • Simulate HYDE-like synthetic evidence and base evidence.\n        • Normalize documents.\n        • Run BM25/dense/hybrid ranking.\n        • Apply retrieval reranking and fusion.\n        • Return a RAGExecutionPayload.\n\n    META-aware behavior:\n\n        • routing_bias.prefer_fast → reduce HYDE and evidence volume.\n        • routing_bias.prefer_robust_retrieval → emphasize HYDE and hybrid ranking.\n    ')),
        AsyncFunctionDef(
          name='execute',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='plan',
                annotation=Name(id='PlanObject', ctx=Load())),
              arg(
                arg='state',
                annotation=Subscript(
                  value=Name(id='Dict', ctx=Load()),
