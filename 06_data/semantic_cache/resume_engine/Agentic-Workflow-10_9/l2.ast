                            Constant(value=0.0)])])),
                  keyword(
                    arg='aggregated_rationale',
                    value=Call(
                      func=Name(id='str', ctx=Load()),
                      args=[
                        Call(
                          func=Attribute(
                            value=Name(id='plan', ctx=Load()),
                            attr='get',
                            ctx=Load()),
                          args=[
