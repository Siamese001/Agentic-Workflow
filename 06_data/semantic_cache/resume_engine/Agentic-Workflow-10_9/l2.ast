                          Name(id='str', ctx=Load()),
                          Name(id='Any', ctx=Load())],
                        ctx=Load()),
                      ctx=Load()),
                    ctx=Load()),
                  value=List(ctx=Load()),
                  simple=1),
                For(
                  target=Name(id='q', ctx=Store()),
