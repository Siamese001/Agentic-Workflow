                    func=Attribute(
                      value=Name(id='plan', ctx=Load()),
                      attr='get',
                      ctx=Load()),
                    args=[
                      Constant(value='branches')]),
                  List(ctx=Load())])),
            AnnAssign(
              target=Name(id='branches', ctx=Store()),
              annotation=Subscript(
                value=Name(id='List', ctx=Load()),
                slice=Name(id='StrategyBranch', ctx=Load()),
                ctx=Load()),
              value=List(ctx=Load()),
              simple=1),
            For(
              target=Name(id='b', ctx=Store()),
              iter=Name(id='branches_data', ctx=Load()),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='branches', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Call(
                        func=Name(id='StrategyBranch', ctx=Load()),
                        keywords=[
                          keyword(
                            arg='branch_id',
                            value=Call(
                              func=Name(id='str', ctx=Load()),
                              args=[
                                Call(
                                  func=Attribute(
                                    value=Name(id='b', ctx=Load()),
                                    attr='get',
                                    ctx=Load()),
                                  args=[
                                    Constant(value='branch_id'),
                                    Constant(value='')])])),
                          keyword(
                            arg='strategy_name',
                            value=Call(
                              func=Name(id='str', ctx=Load()),
                              args=[
                                Call(
                                  func=Attribute(
                                    value=Name(id='b', ctx=Load()),
                                    attr='get',
                                    ctx=Load()),
                                  args=[
                                    Constant(value='strategy_name'),
                                    Constant(value='')])])),
                          keyword(
                            arg='focus_areas',
                            value=ListComp(
                              elt=Call(
                                func=Name(id='str', ctx=Load()),
                                args=[
                                  Name(id='x', ctx=Load())]),
                              generators=[
                                comprehension(
                                  target=Name(id='x', ctx=Store()),
                                  iter=Call(
                                    func=Attribute(
                                      value=Name(id='b', ctx=Load()),
                                      attr='get',
                                      ctx=Load()),
                                    args=[
                                      Constant(value='focus_areas'),
                                      List(ctx=Load())]),
                                  is_async=0)])),
                          keyword(
                            arg='key_achievements',
                            value=ListComp(
                              elt=Call(
                                func=Name(id='str', ctx=Load()),
                                args=[
                                  Name(id='x', ctx=Load())]),
                              generators=[
                                comprehension(
                                  target=Name(id='x', ctx=Store()),
                                  iter=Call(
                                    func=Attribute(
                                      value=Name(id='b', ctx=Load()),
                                      attr='get',
                                      ctx=Load()),
                                    args=[
                                      Constant(value='key_achievements'),
                                      List(ctx=Load())]),
                                  is_async=0)])),
                          keyword(
