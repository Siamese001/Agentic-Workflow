                      attr='get',
                      ctx=Load()),
                    args=[
                      Constant(value='enable_hyde'),
                      Constant(value=True)])])),
            If(
              test=Call(
                func=Attribute(
                  value=Name(id='routing_bias', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='prefer_fast')]),
              body=[
