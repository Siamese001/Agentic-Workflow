                generators=[
                  comprehension(
                    target=Name(id='q', ctx=Store()),
                    iter=Call(
                      func=Attribute(
                        value=Name(id='retrieval_cfg', ctx=Load()),
                        attr='get',
                        ctx=Load()),
                      args=[
                        Constant(value='queries'),
                        List(ctx=Load())]),
                    is_async=0)]),
              simple=1),
            Assign(
              targets=[
                Name(id='ranking_cfg', ctx=Store())],
              value=BoolOp(
                op=Or(),
                values=[
                  Call(
                    func=Attribute(
                      value=Name(id='retrieval_cfg', ctx=Load()),
                      attr='get',
                      ctx=Load()),
                    args=[
