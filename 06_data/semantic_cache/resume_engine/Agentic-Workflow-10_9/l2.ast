                            value=Call(
                              func=Name(id='str', ctx=Load()),
                              args=[
                                Call(
                                  func=Attribute(
                                    value=Name(id='b', ctx=Load()),
                                    attr='get',
                                    ctx=Load()),
                                  args=[
                                    Constant(value='rationale'),
                                    Constant(value='')])])),
                          keyword(
                            arg='complexity',
                            value=BoolOp(
                              op=Or(),
                              values=[
                                Call(
                                  func=Name(id='str', ctx=Load()),
                                  args=[
                                    Call(
                                      func=Attribute(
                                        value=Name(id='plan', ctx=Load()),
                                        attr='get',
                                        ctx=Load()),
                                      args=[
                                        Constant(value='complexity'),
                                        Constant(value='')])]),
                                Constant(value=None)])),
                          keyword(
                            arg='priority',
                            value=Call(
                              func=Attribute(
                                value=Name(id='b', ctx=Load()),
                                attr='get',
                                ctx=Load()),
                              args=[
                                Constant(value='priority')]))])]))]),
            Assign(
              targets=[
                Name(id='preferred_id', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Call(
                    func=Name(id='str', ctx=Load()),
                    args=[
