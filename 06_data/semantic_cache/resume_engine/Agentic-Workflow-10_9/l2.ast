                            value=Call(
                              func=Name(id='str', ctx=Load()),
                              args=[
                                Call(
                                  func=Attribute(
                                    value=Name(id='b', ctx=Load()),
                                    attr='get',
                                    ctx=Load()),
                                  args=[
