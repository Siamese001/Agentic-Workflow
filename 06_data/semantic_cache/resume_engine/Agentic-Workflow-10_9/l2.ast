                func=Attribute(
                  value=Name(id='routing_bias', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='prefer_robust_retrieval')]),
              body=[
                Assign(
                  targets=[
                    Name(id='strategy', ctx=Store())],
                  value=Constant(value='hybrid')),
                Assign(
                  targets=[
                    Name(id='enable_hyde', ctx=Store())],
                  value=Constant(value=True))]),
            Assign(
              targets=[
                Name(id='complexity', ctx=Store())],
              value=Call(
                func=Name(id='str', ctx=Load()),
                args=[
                  Call(
                    func=Attribute(
                      value=Name(id='plan', ctx=Load()),
                      attr='get',
                      ctx=Load()),
                    args=[
                      Constant(value='complexity'),
                      Constant(value='moderate')])])),
            FunctionDef(
              name='_run_once',
              args=arguments(
                args=[
                  arg(
                    arg='current_queries',
                    annotation=Subscript(
