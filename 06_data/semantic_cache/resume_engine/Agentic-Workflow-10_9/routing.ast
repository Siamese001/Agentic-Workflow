    FunctionDef(
      name='run_model_for_plan',
      args=arguments(
        args=[
          arg(
            arg='plan',
            annotation=BinOp(
              left=Name(id='PlanObject', ctx=Load()),
              op=BitOr(),
              right=Subscript(
                value=Name(id='Dict', ctx=Load()),
                slice=Tuple(
                  elts=[
                    Name(id='str', ctx=Load()),
                    Name(id='Any', ctx=Load())],
                  ctx=Load()),
                ctx=Load()))),
          arg(
            arg='state',
            annotation=Subscript(
              value=Name(id='Dict', ctx=Load()),
              slice=Tuple(
                elts=[
                  Name(id='str', ctx=Load()),
                  Name(id='Any', ctx=Load())],
                ctx=Load()),
              ctx=Load())),
          arg(
            arg='routing_cfg',
            annotation=Subscript(
              value=Name(id='Optional', ctx=Load()),
              slice=Name(id='RoutingConfig', ctx=Load()),
              ctx=Load()))],
        defaults=[
          Constant(value=None)]),
      body=[
        Expr(
          value=Constant(value='\n    End-to-end META routing pipeline:\n\n        1. Normalize plan\n        2. Build prompt envelope\n        3. Construct RoutingCriteria (meta-aware)\n        4. Ask L5.ModelRouter for model selection\n        5. Simulate model invocation\n        6. Return structured routing output\n\n    DOES NOT mutate state.\n    DOES NOT perform safety/policy.\n    ')),
        Assign(
          targets=[
            Name(id='plan_dict', ctx=Store())],
          value=IfExp(
            test=Call(
              func=Name(id='isinstance', ctx=Load()),
              args=[
                Name(id='plan', ctx=Load()),
                Name(id='PlanObject', ctx=Load())]),
            body=Call(
              func=Attribute(
                value=Name(id='plan', ctx=Load()),
                attr='to_dict',
                ctx=Load())),
            orelse=Call(
              func=Name(id='dict', ctx=Load()),
              args=[
                Name(id='plan', ctx=Load())]))),
        Assign(
          targets=[
            Name(id='prompt_bundle', ctx=Store())],
          value=Call(
            func=Name(id='_build_prompt_bundle', ctx=Load()),
            args=[
              Name(id='plan_dict', ctx=Load()),
              Name(id='state', ctx=Load())])),
        Assign(
          targets=[
            Name(id='cfg', ctx=Store())],
          value=BoolOp(
            op=Or(),
            values=[
              Name(id='routing_cfg', ctx=Load()),
              Call(
                func=Name(id='RoutingConfig', ctx=Load()))])),
        Assign(
          targets=[
            Name(id='criteria', ctx=Store())],
          value=Call(
            func=Name(id='_build_routing_criteria', ctx=Load()),
            args=[
              Name(id='plan_dict', ctx=Load()),
              Name(id='state', ctx=Load()),
              Name(id='cfg', ctx=Load())])),
        Assign(
          targets=[
            Name(id='router', ctx=Store())],
          value=Call(
            func=Name(id='ModelRouter', ctx=Load()))),
        Assign(
          targets=[
            Name(id='decision', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='router', ctx=Load()),
              attr='select',
              ctx=Load()),
            args=[
              Name(id='criteria', ctx=Load())])),
        Assign(
          targets=[
            Name(id='routing_info', ctx=Store())],
          value=Dict(
            keys=[
              Constant(value='selected_model'),
              Constant(value='endpoint'),
              Constant(value='rationale'),
              Constant(value='task_type'),
              Constant(value='complexity'),
              Constant(value='risk_level')],
            values=[
              Attribute(
                value=Name(id='decision', ctx=Load()),
                attr='model',
                ctx=Load()),
              Attribute(
                value=Name(id='decision', ctx=Load()),
                attr='endpoint',
                ctx=Load()),
              Attribute(
                value=Name(id='decision', ctx=Load()),
                attr='rationale',
                ctx=Load()),
              Attribute(
                value=Name(id='criteria', ctx=Load()),
                attr='task_type',
                ctx=Load()),
              Attribute(
                value=Name(id='criteria', ctx=Load()),
                attr='complexity',
                ctx=Load()),
              Attribute(
                value=Name(id='criteria', ctx=Load()),
                attr='risk_level',
                ctx=Load())])),
        Assign(
          targets=[
            Name(id='model_output', ctx=Store())],
          value=Call(
            func=Name(id='invoke_model', ctx=Load()),
            args=[
              Subscript(
                value=Name(id='prompt_bundle', ctx=Load()),
                slice=Constant(value='prompt'),
                ctx=Load()),
              Dict(
                keys=[
                  Constant(value='model'),
                  Constant(value='endpoint'),
                  Constant(value='route')],
                values=[
                  Attribute(
                    value=Name(id='decision', ctx=Load()),
                    attr='model',
                    ctx=Load()),
                  Attribute(
                    value=Name(id='decision', ctx=Load()),
                    attr='endpoint',
                    ctx=Load()),
                  Name(id='routing_info', ctx=Load())])])),
        Return(
          value=Dict(
            keys=[
              Constant(value='prompt'),
              Constant(value='runtime_context'),
              Constant(value='model_output'),
              Constant(value='routing')],
            values=[
              Subscript(
                value=Name(id='prompt_bundle', ctx=Load()),
                slice=Constant(value='prompt'),
                ctx=Load()),
              Subscript(
                value=Name(id='prompt_bundle', ctx=Load()),
                slice=Constant(value='runtime_context'),
                ctx=Load()),
              Name(id='model_output', ctx=Load()),
              Name(id='routing_info', ctx=Load())]))],
      returns=Subscript(
        value=Name(id='Dict', ctx=Load()),
        slice=Tuple(
          elts=[
            Name(id='str', ctx=Load()),
            Name(id='Any', ctx=Load())],
          ctx=Load()),
        ctx=Load()))])