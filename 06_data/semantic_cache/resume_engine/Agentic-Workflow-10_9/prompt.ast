Module(
  body=[
    Expr(
      value=Constant(value='\nUnified Observability Module (v10_9) — META / INFRASTRUCTURE LAYER (REFINED)\n\nThis module provides the entire observability subsystem for the v10_9\nagentic runtime. It sits strictly ABOVE L1–L5 and owns:\n\n    • Run-level tracing and metrics collection\n    • Span-based performance tracking\n    • Metric recording (counts, ratios, histograms – in memory)\n    • Structured run summaries for:\n        - Strategy\n        - RAG\n        - Bullets\n        - Drafting\n        - QA\n        - Safety\n        - HIL\n        - Meta-learning\n    • Async span decorators for instrumentation\n    • Telemetry aggregation for end-of-run summaries\n    • Meta-profile updates from spans + run_summary\n\nLayer Guardrails:\n\n    • NO L1 cognition\n    • NO L2 tool/LLM execution\n    • NO L3 orchestration logic\n    • NO L4 state mutation logic\n    • NO L5 safety/policy decisions\n    • NO provider SDK calls\n\nThis refactor additionally:\n\n    • Fixes mismatches with the refactored payload formats (l1–l2–l3).\n    • Integrates with meta_profile.update_from_spans and update_from_run_summary.\n    • Exposes meta_profile snapshot in the returned run_summary.\n')),
    ImportFrom(
      module='__future__',
      names=[
        alias(name='annotations')],
      level=0),
    Import(
      names=[
        alias(name='time')]),
    Import(
      names=[
        alias(name='functools')]),
    Import(
      names=[
        alias(name='asyncio')]),
    ImportFrom(
      module='dataclasses',
      names=[
        alias(name='dataclass'),
        alias(name='field'),
        alias(name='asdict')],
      level=0),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Any'),
        alias(name='Dict'),
        alias(name='List'),
        alias(name='Optional'),
        alias(name='Callable'),
        alias(name='Awaitable')],
      level=0),
    ImportFrom(
      module='runtime_utils',
      names=[
        alias(name='CostTracker'),
        alias(name='record_event')],
      level=0),
    ImportFrom(
      module='meta_profile',
      names=[
        alias(name='update_from_spans'),
        alias(name='update_from_run_summary'),
        alias(name='get_meta_profile_snapshot')],
      level=0),
    ClassDef(
      name='TraceSpan',
