    FunctionDef(
      name='summarize_run',
      args=arguments(
        args=[
          arg(
            arg='workflow_id',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='state',
            annotation=Subscript(
              value=Name(id='Dict', ctx=Load()),
              slice=Tuple(
                elts=[
                  Name(id='str', ctx=Load()),
                  Name(id='Any', ctx=Load())],
                ctx=Load()),
              ctx=Load())),
          arg(
            arg='phase_history',
            annotation=Subscript(
              value=Name(id='List', ctx=Load()),
              slice=Name(id='str', ctx=Load()),
              ctx=Load())),
          arg(
            arg='cost_tracker',
            annotation=Subscript(
              value=Name(id='Optional', ctx=Load()),
              slice=Name(id='CostTracker', ctx=Load()),
              ctx=Load()))],
        defaults=[
          Constant(value=None)]),
      body=[
        Expr(
          value=Constant(value='\n    Build a structured run summary for a workflow, combining:\n\n        • phase history\n        • timing spans (from CostTracker and TELEMETRY)\n        • domain metrics and issues\n        • meta_profile updates (from spans and run_summary)\n    ')),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='TELEMETRY', ctx=Load()),
              attr='record_phase_transition',
              ctx=Load()),
            args=[
              Name(id='workflow_id', ctx=Load()),
              Name(id='phase_history', ctx=Load())])),
        If(
          test=BoolOp(
            op=And(),
            values=[
              Compare(
                left=Name(id='cost_tracker', ctx=Load()),
                ops=[
                  IsNot()],
                comparators=[
                  Constant(value=None)]),
              Call(
                func=Name(id='hasattr', ctx=Load()),
                args=[
                  Name(id='cost_tracker', ctx=Load()),
                  Constant(value='snapshot')])]),
          body=[
            Assign(
              targets=[
                Name(id='snapshot', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='cost_tracker', ctx=Load()),
                  attr='snapshot',
                  ctx=Load()))),
            For(
              target=Name(id='span', ctx=Store()),
              iter=Call(
                func=Attribute(
                  value=Name(id='snapshot', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='spans'),
                  List(ctx=Load())]),
              body=[
                Assign(
                  targets=[
                    Name(id='name', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='span', ctx=Load()),
                      attr='get',
                      ctx=Load()),
                    args=[
                      Constant(value='name'),
                      Constant(value='')])),
                Assign(
                  targets=[
                    Name(id='duration_ms', ctx=Store())],
                  value=Call(
                    func=Name(id='float', ctx=Load()),
                    args=[
                      Call(
                        func=Attribute(
                          value=Name(id='span', ctx=Load()),
                          attr='get',
                          ctx=Load()),
                        args=[
                          Constant(value='duration_ms'),
                          Constant(value=0.0)])])),
                If(
                  test=Name(id='name', ctx=Load()),
                  body=[
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Name(id='TELEMETRY', ctx=Load()),
                          attr='record_timing',
                          ctx=Load()),
                        args=[
                          Name(id='workflow_id', ctx=Load()),
                          Name(id='name', ctx=Load()),
                          Name(id='duration_ms', ctx=Load())]))])])]),
        Expr(
          value=Call(
            func=Name(id='summarize_strategy', ctx=Load()),
            args=[
              Name(id='workflow_id', ctx=Load()),
              Name(id='state', ctx=Load())])),
        Expr(
          value=Call(
            func=Name(id='summarize_rag', ctx=Load()),
            args=[
              Name(id='workflow_id', ctx=Load()),
              Name(id='state', ctx=Load())])),
        Expr(
          value=Call(
            func=Name(id='summarize_bullets', ctx=Load()),
            args=[
              Name(id='workflow_id', ctx=Load()),
              Name(id='state', ctx=Load())])),
        Expr(
          value=Call(
            func=Name(id='summarize_draft', ctx=Load()),
            args=[
              Name(id='workflow_id', ctx=Load()),
              Name(id='state', ctx=Load())])),
        Expr(
          value=Call(
            func=Name(id='summarize_qa', ctx=Load()),
            args=[
              Name(id='workflow_id', ctx=Load()),
              Name(id='state', ctx=Load())])),
        Expr(
          value=Call(
            func=Name(id='summarize_safety', ctx=Load()),
            args=[
              Name(id='workflow_id', ctx=Load()),
              Name(id='state', ctx=Load())])),
        Expr(
          value=Call(
            func=Name(id='summarize_hil', ctx=Load()),
            args=[
              Name(id='workflow_id', ctx=Load()),
              Name(id='state', ctx=Load())])),
        Expr(
          value=Call(
            func=Name(id='summarize_meta_learning', ctx=Load()),
            args=[
              Name(id='workflow_id', ctx=Load()),
              Name(id='state', ctx=Load())])),
        Assign(
          targets=[
            Name(id='summary', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='TELEMETRY', ctx=Load()),
              attr='get_summary',
              ctx=Load()),
            args=[
              Name(id='workflow_id', ctx=Load())])),
        If(
          test=UnaryOp(
            op=Not(),
            operand=Name(id='summary', ctx=Load())),
          body=[
            Assign(
              targets=[
                Name(id='base_summary', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='workflow_id'),
                  Constant(value='phases'),
                  Constant(value='timings'),
                  Constant(value='counts'),
                  Constant(value='issues')],
                values=[
                  Name(id='workflow_id', ctx=Load()),
                  Call(
                    func=Name(id='list', ctx=Load()),
                    args=[
                      Name(id='phase_history', ctx=Load())]),
                  Dict(),
                  Dict(),
                  Dict()])),
            Assign(
              targets=[
                Name(id='spans_for_meta', ctx=Store())],
              value=ListComp(
                elt=Dict(
                  keys=[
                    Constant(value='name'),
                    Constant(value='duration_ms')],
                  values=[
                    Attribute(
                      value=Name(id='s', ctx=Load()),
                      attr='name',
                      ctx=Load()),
                    Call(
                      func=Attribute(
                        value=Name(id='s', ctx=Load()),
                        attr='duration_ms',
                        ctx=Load()))]),
                generators=[
                  comprehension(
                    target=Name(id='s', ctx=Store()),
                    iter=Call(
                      func=Attribute(
                        value=Name(id='TELEMETRY', ctx=Load()),
                        attr='get_spans',
                        ctx=Load())),
                    is_async=0)])),
            If(
              test=Name(id='spans_for_meta', ctx=Load()),
              body=[
                Expr(
                  value=Call(
                    func=Name(id='update_from_spans', ctx=Load()),
                    args=[
                      Name(id='spans_for_meta', ctx=Load())]))]),
            Expr(
              value=Call(
                func=Name(id='update_from_run_summary', ctx=Load()),
                args=[
                  Name(id='base_summary', ctx=Load())])),
            Assign(
              targets=[
                Subscript(
                  value=Name(id='base_summary', ctx=Load()),
                  slice=Constant(value='meta_profile'),
                  ctx=Store())],
              value=Call(
                func=Name(id='get_meta_profile_snapshot', ctx=Load()))),
            Return(
              value=Name(id='base_summary', ctx=Load()))]),
        Assign(
          targets=[
            Name(id='run_summary', ctx=Store())],
          value=Call(
            func=Name(id='asdict', ctx=Load()),
            args=[
              Name(id='summary', ctx=Load())])),
