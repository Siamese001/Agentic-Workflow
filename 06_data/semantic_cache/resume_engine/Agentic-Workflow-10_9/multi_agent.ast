                  keyword(arg='config', value=Dict())])])),
        For(
          target=Name(id='s', ctx=Store()),
          iter=Name(id='spokes', ctx=Load()),
          body=[
            Assign(
              targets=[
                Subscript(
                  value=Name(id='nodes', ctx=Load()),
                  slice=Name(id='s', ctx=Load()),
                  ctx=Store())],
              value=Call(
                func=Name(id='AgentNode', ctx=Load()),
                keywords=[
                  keyword(
                    arg='role',
                    value=Name(id='s', ctx=Load())),
                  keyword(arg='config', value=Dict())]))]),
        Assign(
          targets=[
            Name(id='edges', ctx=Store())],
          value=Dict()),
        For(
          target=Name(id='s', ctx=Store()),
          iter=Name(id='spokes', ctx=Load()),
          body=[
            Expr(
              value=Call(
                func=Attribute(
                  value=Call(
                    func=Attribute(
                      value=Name(id='edges', ctx=Load()),
                      attr='setdefault',
                      ctx=Load()),
                    args=[
                      Name(id='hub', ctx=Load()),
                      List(ctx=Load())]),
                  attr='append',
                  ctx=Load()),
                args=[
                  Name(id='s', ctx=Load())])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Call(
                    func=Attribute(
                      value=Name(id='edges', ctx=Load()),
                      attr='setdefault',
                      ctx=Load()),
                    args=[
                      Name(id='s', ctx=Load()),
                      List(ctx=Load())]),
                  attr='append',
                  ctx=Load()),
                args=[
                  Name(id='hub', ctx=Load())]))]),
        Return(
          value=Call(
            func=Name(id='AgentGraph', ctx=Load()),
            keywords=[
              keyword(
                arg='nodes',
                value=Name(id='nodes', ctx=Load())),
              keyword(
                arg='edges',
                value=Name(id='edges', ctx=Load())),
              keyword(
                arg='metadata',
                value=Dict(
                  keys=[
                    Constant(value='pattern')],
                  values=[
                    Constant(value='star_hub')]))]))],
      returns=Name(id='AgentGraph', ctx=Load())),
    FunctionDef(
      name='build_council',
      args=arguments(
        args=[
          arg(
            arg='role',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='size',
            annotation=Name(id='int', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Build a role-homogeneous council of size N.\n\n    Example:\n        build_council(AgentRole.QA, 3)\n    ')),
        Assign(
          targets=[
            Name(id='size', ctx=Store())],
          value=Call(
            func=Name(id='max', ctx=Load()),
            args=[
              Constant(value=1),
              Call(
                func=Name(id='int', ctx=Load()),
                args=[
                  Name(id='size', ctx=Load())])])),
        Assign(
          targets=[
            Name(id='nodes', ctx=Store())],
          value=Dict()),
        For(
          target=Name(id='i', ctx=Store()),
          iter=Call(
            func=Name(id='range', ctx=Load()),
            args=[
              Name(id='size', ctx=Load())]),
          body=[
            Assign(
              targets=[
                Name(id='name', ctx=Store())],
              value=JoinedStr(
                values=[
                  FormattedValue(
                    value=Name(id='role', ctx=Load()),
                    conversion=-1),
                  Constant(value='_'),
                  FormattedValue(
                    value=BinOp(
                      left=Name(id='i', ctx=Load()),
                      op=Add(),
                      right=Constant(value=1)),
                    conversion=-1)])),
            Assign(
              targets=[
                Subscript(
                  value=Name(id='nodes', ctx=Load()),
                  slice=Name(id='name', ctx=Load()),
                  ctx=Store())],
              value=Call(
                func=Name(id='AgentNode', ctx=Load()),
                keywords=[
                  keyword(
                    arg='role',
                    value=Call(
                      func=Name(id='str', ctx=Load()),
                      args=[
                        Name(id='role', ctx=Load())])),
                  keyword(
                    arg='config',
                    value=Dict(
                      keys=[
                        Constant(value='id'),
                        Constant(value='weight')],
                      values=[
                        BinOp(
                          left=Name(id='i', ctx=Load()),
                          op=Add(),
                          right=Constant(value=1)),
                        Constant(value=1.0)]))]))]),
        Return(
          value=Call(
            func=Name(id='AgentGraph', ctx=Load()),
            keywords=[
              keyword(
                arg='nodes',
                value=Name(id='nodes', ctx=Load())),
              keyword(arg='edges', value=Dict()),
              keyword(
                arg='metadata',
                value=Dict(
                  keys=[
                    Constant(value='pattern')],
                  values=[
                    Constant(value='council')]))]))],
      returns=Name(id='AgentGraph', ctx=Load())),
    FunctionDef(
      name='build_committee',
      args=arguments(
        args=[
          arg(
            arg='roles',
            annotation=Subscript(
              value=Name(id='List', ctx=Load()),
              slice=Name(id='str', ctx=Load()),
              ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Build a committee: each role appears once, no directed edges.\n    ')),
        Assign(
          targets=[
            Name(id='nodes', ctx=Store())],
          value=DictComp(
            key=Call(
              func=Name(id='str', ctx=Load()),
              args=[
                Name(id='r', ctx=Load())]),
            value=Call(
              func=Name(id='AgentNode', ctx=Load()),
              keywords=[
                keyword(
                  arg='role',
                  value=Call(
                    func=Name(id='str', ctx=Load()),
                    args=[
                      Name(id='r', ctx=Load())])),
                keyword(arg='config', value=Dict())]),
            generators=[
              comprehension(
                target=Name(id='r', ctx=Store()),
                iter=Name(id='roles', ctx=Load()),
                is_async=0)])),
        Return(
          value=Call(
            func=Name(id='AgentGraph', ctx=Load()),
            keywords=[
              keyword(
                arg='nodes',
                value=Name(id='nodes', ctx=Load())),
              keyword(arg='edges', value=Dict()),
              keyword(
                arg='metadata',
                value=Dict(
                  keys=[
                    Constant(value='pattern')],
                  values=[
                    Constant(value='committee')]))]))],
      returns=Name(id='AgentGraph', ctx=Load())),
    ClassDef(
      name='AgentMessage',
      body=[
        Expr(
          value=Constant(value='Meta-layer conceptual message exchanged between agent roles.')),
        AnnAssign(
          target=Name(id='sender', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='recipient', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='content', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
