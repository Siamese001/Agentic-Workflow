Module(
  body=[
    Expr(
      value=Constant(value='\nMulti-Agent Coordination Patterns (v10_9_REFACTORED) — META LAYER ONLY\n\nThis module provides reusable multi-agent coordination primitives\n(governance graphs, pipeline shapes, councils, committees) strictly\nwithin the META layer.\n\nSTRICT LAYER BOUNDARIES:\n    • NO L1 planning\n    • NO L2 execution\n    • NO L3 orchestration\n    • NO L4 state mutation\n    • NO L5 safety/policy decisions\n    • PURE advisory logic only\n    • SAFE to call anywhere\n\nThis refactor:\n    • Fixes broken node construction (original used AgentNode(role,...)\n      instead of AgentNode(role=<role_name>, config=...))\n    • Normalizes to use modern AgentNode + AgentGraph from agents.py\n    • Integrates fully with meta_profile (for future weighted patterns)\n    • Returns patch-ready structures for L4, but does not mutate\n    • Deterministic voting + routing consistent with agents.py\n    • Aligns committee, council, pipeline, star graphs to new schema\n')),
    ImportFrom(
      module='__future__',
      names=[
        alias(name='annotations')],
      level=0),
    ImportFrom(
      module='dataclasses',
      names=[
        alias(name='dataclass'),
        alias(name='field')],
      level=0),
    ImportFrom(
      module='enum',
      names=[
        alias(name='Enum')],
      level=0),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Any'),
        alias(name='Dict'),
        alias(name='List'),
        alias(name='Tuple'),
        alias(name='Optional')],
      level=0),
    ImportFrom(
      module='agents',
      names=[
        alias(name='AgentRole'),
        alias(name='AgentNode'),
        alias(name='AgentGraph'),
        alias(name='summarize_graph'),
        alias(name='deterministic_vote')],
      level=0),
    ImportFrom(
      module='models',
      names=[
        alias(name='MultiAgentVote'),
        alias(name='MultiAgentCouncilResult')],
      level=0),
    ImportFrom(
      module='meta_profile',
      names=[
        alias(name='get_planning_bias'),
        alias(name='get_routing_bias'),
        alias(name='get_safety_bias'),
        alias(name='get_qa_bias')],
      level=0),
    ClassDef(
      name='MultiAgentPattern',
      bases=[
        Name(id='str', ctx=Load()),
        Name(id='Enum', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Conceptual patterns for multi-agent coordination graphs.')),
        Assign(
          targets=[
            Name(id='LINEAR_PIPELINE', ctx=Store())],
          value=Constant(value='linear_pipeline')),
        Assign(
          targets=[
            Name(id='STAR_HUB', ctx=Store())],
          value=Constant(value='star_hub')),
        Assign(
          targets=[
            Name(id='COUNCIL', ctx=Store())],
          value=Constant(value='council')),
        Assign(
          targets=[
            Name(id='COMMITTEE', ctx=Store())],
          value=Constant(value='committee'))]),
    FunctionDef(
      name='build_linear_pipeline',
      args=arguments(
        args=[
          arg(
            arg='roles',
            annotation=Subscript(
              value=Name(id='List', ctx=Load()),
              slice=Name(id='str', ctx=Load()),
              ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Build a linear pipeline:\n        r0 → r1 → r2 → ...\n\n    Example:\n        build_linear_pipeline([\n            AgentRole.PLANNER,\n            AgentRole.RETRIEVER,\n            AgentRole.DRAFTER,\n            AgentRole.QA,\n            AgentRole.SAFETY,\n        ])\n    ')),
        Assign(
          targets=[
            Name(id='nodes', ctx=Store())],
          value=DictComp(
            key=Call(
              func=Name(id='str', ctx=Load()),
              args=[
                Name(id='r', ctx=Load())]),
            value=Call(
              func=Name(id='AgentNode', ctx=Load()),
              keywords=[
                keyword(
                  arg='role',
                  value=Call(
                    func=Name(id='str', ctx=Load()),
                    args=[
                      Name(id='r', ctx=Load())])),
                keyword(arg='config', value=Dict())]),
            generators=[
              comprehension(
                target=Name(id='r', ctx=Store()),
                iter=Name(id='roles', ctx=Load()),
                is_async=0)])),
        Assign(
          targets=[
            Name(id='edges', ctx=Store())],
          value=Dict()),
        For(
          target=Name(id='i', ctx=Store()),
          iter=Call(
            func=Name(id='range', ctx=Load()),
            args=[
              BinOp(
                left=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Name(id='roles', ctx=Load())]),
                op=Sub(),
                right=Constant(value=1))]),
          body=[
            Assign(
              targets=[
                Name(id='src', ctx=Store())],
              value=Call(
                func=Name(id='str', ctx=Load()),
                args=[
                  Subscript(
                    value=Name(id='roles', ctx=Load()),
                    slice=Name(id='i', ctx=Load()),
                    ctx=Load())])),
            Assign(
              targets=[
                Name(id='dst', ctx=Store())],
              value=Call(
                func=Name(id='str', ctx=Load()),
                args=[
                  Subscript(
                    value=Name(id='roles', ctx=Load()),
                    slice=BinOp(
                      left=Name(id='i', ctx=Load()),
                      op=Add(),
                      right=Constant(value=1)),
                    ctx=Load())])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Call(
                    func=Attribute(
                      value=Name(id='edges', ctx=Load()),
                      attr='setdefault',
                      ctx=Load()),
                    args=[
                      Name(id='src', ctx=Load()),
                      List(ctx=Load())]),
                  attr='append',
                  ctx=Load()),
                args=[
                  Name(id='dst', ctx=Load())]))]),
        Return(
          value=Call(
            func=Name(id='AgentGraph', ctx=Load()),
            keywords=[
              keyword(
                arg='nodes',
                value=Name(id='nodes', ctx=Load())),
              keyword(
                arg='edges',
                value=Name(id='edges', ctx=Load())),
              keyword(
                arg='metadata',
                value=Dict(
                  keys=[
                    Constant(value='pattern')],
                  values=[
                    Constant(value='linear_pipeline')]))]))],
      returns=Name(id='AgentGraph', ctx=Load())),
    FunctionDef(
      name='build_star_hub',
      args=arguments(
        args=[
          arg(
            arg='hub',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='spokes',
            annotation=Subscript(
              value=Name(id='List', ctx=Load()),
              slice=Name(id='str', ctx=Load()),
              ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Build a star-hub graph:\n        hub ↔ each spoke\n    ')),
        Assign(
          targets=[
            Name(id='nodes', ctx=Store())],
          value=Dict(
            keys=[
              Name(id='hub', ctx=Load())],
