              ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='metadata', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='Any', ctx=Load())],
              ctx=Load()),
            ctx=Load()),
          value=Call(
            func=Name(id='field', ctx=Load()),
            keywords=[
              keyword(
                arg='default_factory',
                value=Name(id='dict', ctx=Load()))]),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    FunctionDef(
      name='can_delegate',
      args=arguments(
        args=[
          arg(
            arg='from_role',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='to_role',
            annotation=Name(id='str', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Canonical deterministic delegation rules.\n    Mirrors (and extends) the logic from agents.py.\n    ')),
        If(
          test=Compare(
            left=Name(id='from_role', ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Attribute(
                value=Name(id='AgentRole', ctx=Load()),
                attr='PLANNER',
                ctx=Load())]),
          body=[
            Return(
              value=Compare(
                left=Name(id='to_role', ctx=Load()),
                ops=[
                  In()],
                comparators=[
                  Set(
                    elts=[
                      Attribute(
                        value=Name(id='AgentRole', ctx=Load()),
                        attr='RETRIEVER',
                        ctx=Load()),
                      Attribute(
                        value=Name(id='AgentRole', ctx=Load()),
                        attr='DRAFTER',
                        ctx=Load()),
                      Attribute(
                        value=Name(id='AgentRole', ctx=Load()),
                        attr='QA',
                        ctx=Load())])]))]),
        If(
          test=Compare(
            left=Name(id='from_role', ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Attribute(
                value=Name(id='AgentRole', ctx=Load()),
                attr='RETRIEVER',
                ctx=Load())]),
          body=[
            Return(
              value=Compare(
                left=Name(id='to_role', ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Attribute(
                    value=Name(id='AgentRole', ctx=Load()),
                    attr='DRAFTER',
                    ctx=Load())]))]),
        If(
          test=Compare(
            left=Name(id='from_role', ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Attribute(
                value=Name(id='AgentRole', ctx=Load()),
                attr='DRAFTER',
                ctx=Load())]),
          body=[
            Return(
              value=Compare(
                left=Name(id='to_role', ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Attribute(
                    value=Name(id='AgentRole', ctx=Load()),
                    attr='QA',
                    ctx=Load())]))]),
        If(
          test=Compare(
            left=Name(id='from_role', ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Attribute(
                value=Name(id='AgentRole', ctx=Load()),
                attr='QA',
                ctx=Load())]),
          body=[
            Return(
              value=Compare(
                left=Name(id='to_role', ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Attribute(
                    value=Name(id='AgentRole', ctx=Load()),
                    attr='SAFETY',
                    ctx=Load())]))]),
        If(
          test=Compare(
            left=Name(id='from_role', ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Attribute(
                value=Name(id='AgentRole', ctx=Load()),
                attr='SAFETY',
                ctx=Load())]),
          body=[
            Return(
              value=Compare(
                left=Name(id='to_role', ctx=Load()),
                ops=[
                  In()],
                comparators=[
                  Set(
                    elts=[
                      Attribute(
                        value=Name(id='AgentRole', ctx=Load()),
                        attr='HIL',
                        ctx=Load()),
                      Attribute(
                        value=Name(id='AgentRole', ctx=Load()),
                        attr='META',
                        ctx=Load())])]))]),
        Return(
          value=Constant(value=False))],
      returns=Name(id='bool', ctx=Load())),
    FunctionDef(
      name='delegation_metadata',
      args=arguments(
        args=[
          arg(
            arg='sender',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='recipient',
            annotation=Name(id='str', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='Return structured metadata describing permitted/blocked delegation.')),
        Return(
          value=Dict(
            keys=[
              Constant(value='from'),
              Constant(value='to'),
              Constant(value='allowed')],
            values=[
              Name(id='sender', ctx=Load()),
              Name(id='recipient', ctx=Load()),
              Call(
                func=Name(id='can_delegate', ctx=Load()),
                args=[
                  Name(id='sender', ctx=Load()),
                  Name(id='recipient', ctx=Load())])]))],
      returns=Subscript(
        value=Name(id='Dict', ctx=Load()),
        slice=Tuple(
          elts=[
            Name(id='str', ctx=Load()),
            Name(id='Any', ctx=Load())],
          ctx=Load()),
        ctx=Load())),
    FunctionDef(
      name='council_vote',
      args=arguments(
        args=[
          arg(
            arg='graph',
            annotation=Name(id='AgentGraph', ctx=Load())),
          arg(
            arg='role',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='candidates',
            annotation=Subscript(
              value=Name(id='List', ctx=Load()),
              slice=Subscript(
                value=Name(id='Dict', ctx=Load()),
                slice=Tuple(
                  elts=[
                    Name(id='str', ctx=Load()),
                    Name(id='Any', ctx=Load())],
                  ctx=Load()),
                ctx=Load()),
              ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Deterministic council voting given candidate scores.\n\n    Returns:\n        {\n          "selected": {...},\n          "candidates": [...],\n          "graph_summary": {...}\n        }\n    ')),
        If(
          test=UnaryOp(
            op=Not(),
            operand=Name(id='candidates', ctx=Load())),
          body=[
            Return(
              value=Dict(
                keys=[
                  Constant(value='selected'),
                  Constant(value='candidates'),
                  Constant(value='graph_summary')],
                values=[
                  Dict(
                    keys=[
                      Constant(value='id'),
                      Constant(value='score'),
                      Constant(value='rationale')],
                    values=[
                      Constant(value=None),
                      Constant(value=0.0),
                      Constant(value='no_candidates')]),
                  List(ctx=Load()),
                  Call(
                    func=Name(id='summarize_graph', ctx=Load()),
                    args=[
                      Name(id='graph', ctx=Load())])]))]),
        Assign(
          targets=[
            Name(id='winner', ctx=Store())],
          value=Call(
            func=Name(id='deterministic_vote', ctx=Load()),
            args=[
              Name(id='candidates', ctx=Load())])),
        Return(
          value=Dict(
            keys=[
              Constant(value='selected'),
              Constant(value='candidates'),
              Constant(value='graph_summary')],
            values=[
              Name(id='winner', ctx=Load()),
              Name(id='candidates', ctx=Load()),
              Call(
                func=Name(id='summarize_graph', ctx=Load()),
                args=[
                  Name(id='graph', ctx=Load())])]))],
      returns=Subscript(
        value=Name(id='Dict', ctx=Load()),
        slice=Tuple(
          elts=[
            Name(id='str', ctx=Load()),
            Name(id='Any', ctx=Load())],
          ctx=Load()),
        ctx=Load())),
    ClassDef(
      name='MultiAgentCoordinator',
      body=[
        Expr(
          value=Constant(value='\n    High-level meta-layer coordinator for multi-agent behaviors.\n\n    Responsibilities:\n        • route_message() — determine routing metadata\n        • council_vote()  — run role-specific councils\n        • build_patch()   — create L4-ready patch blocks (NOT applied)\n        • summarize()     — full graph summary\n\n    MUST NOT mutate state. MUST NOT call L1–L5.\n    ')),
        AnnAssign(
          target=Name(id='graph', ctx=Store()),
          annotation=Name(id='AgentGraph', ctx=Load()),
          simple=1),
        FunctionDef(
          name='summarize',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Return(
              value=Call(
                func=Name(id='summarize_graph', ctx=Load()),
                args=[
                  Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='graph',
                    ctx=Load())]))],
          returns=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='Any', ctx=Load())],
              ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='route_message',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='message',
                annotation=Name(id='AgentMessage', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Compute routing metadata for conceptual messages.\n        Validates delegation rules and embeds graph summary.\n        ')),
            Assign(
              targets=[
                Name(id='sender', ctx=Store())],
              value=Call(
                func=Name(id='str', ctx=Load()),
                args=[
                  Attribute(
                    value=Name(id='message', ctx=Load()),
                    attr='sender',
                    ctx=Load())])),
            Assign(
              targets=[
                Name(id='recipient', ctx=Store())],
              value=Call(
                func=Name(id='str', ctx=Load()),
                args=[
                  Attribute(
                    value=Name(id='message', ctx=Load()),
                    attr='recipient',
                    ctx=Load())])),
            Assign(
              targets=[
                Name(id='allowed', ctx=Store())],
              value=Call(
                func=Name(id='can_delegate', ctx=Load()),
                args=[
                  Name(id='sender', ctx=Load()),
                  Name(id='recipient', ctx=Load())])),
            Return(
              value=Dict(
                keys=[
                  Constant(value='last_message'),
                  Constant(value='delegation'),
                  Constant(value='graph_summary')],
                values=[
                  Dict(
                    keys=[
                      Constant(value='sender'),
                      Constant(value='recipient'),
                      Constant(value='content'),
                      Constant(value='metadata')],
                    values=[
                      Name(id='sender', ctx=Load()),
                      IfExp(
                        test=Name(id='allowed', ctx=Load()),
                        body=Name(id='recipient', ctx=Load()),
                        orelse=Constant(value=None)),
                      Attribute(
                        value=Name(id='message', ctx=Load()),
                        attr='content',
                        ctx=Load()),
                      Attribute(
                        value=Name(id='message', ctx=Load()),
                        attr='metadata',
                        ctx=Load())]),
                  Call(
                    func=Name(id='delegation_metadata', ctx=Load()),
                    args=[
                      Name(id='sender', ctx=Load()),
                      Name(id='recipient', ctx=Load())]),
                  Call(
                    func=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='summarize',
                      ctx=Load()))]))],
          returns=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='Any', ctx=Load())],
              ctx=Load()),
            ctx=Load())),
