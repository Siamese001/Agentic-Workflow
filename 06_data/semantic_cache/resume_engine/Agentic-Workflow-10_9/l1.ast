                    conversion=-1)]),
              attr='lower',
              ctx=Load()))),
        Assign(
          targets=[
            Name(id='senior_terms', ctx=Store())],
          value=Dict(
            keys=[
              Constant(value='executive'),
              Constant(value='director'),
              Constant(value='manager'),
              Constant(value='senior_ic'),
              Constant(value='junior')],
            values=[
              List(
                elts=[
                  Constant(value='chief'),
                  Constant(value='cxo'),
                  Constant(value='svp'),
                  Constant(value='evp'),
                  Constant(value='executive')],
                ctx=Load()),
              List(
                elts=[
                  Constant(value='director'),
                  Constant(value='head of'),
                  Constant(value='senior director')],
                ctx=Load()),
              List(
                elts=[
                  Constant(value='manager'),
                  Constant(value='lead'),
                  Constant(value='team lead')],
                ctx=Load()),
              List(
                elts=[
                  Constant(value='senior'),
                  Constant(value='staff'),
                  Constant(value='principal')],
                ctx=Load()),
              List(
                elts=[
                  Constant(value='junior'),
                  Constant(value='entry-level'),
                  Constant(value='associate')],
                ctx=Load())])),
        For(
          target=Tuple(
            elts=[
              Name(id='label', ctx=Store()),
              Name(id='terms', ctx=Store())],
            ctx=Store()),
          iter=Call(
            func=Attribute(
              value=Name(id='senior_terms', ctx=Load()),
              attr='items',
              ctx=Load())),
          body=[
            If(
              test=Call(
                func=Name(id='any', ctx=Load()),
                args=[
                  GeneratorExp(
                    elt=Compare(
                      left=Name(id='t', ctx=Load()),
                      ops=[
                        In()],
                      comparators=[
                        Name(id='combined', ctx=Load())]),
                    generators=[
                      comprehension(
                        target=Name(id='t', ctx=Store()),
                        iter=Name(id='terms', ctx=Load()),
                        is_async=0)])]),
              body=[
                Return(
                  value=Name(id='label', ctx=Load()))])]),
        Return(
          value=Constant(value='mid'))],
      returns=Name(id='str', ctx=Load())),
