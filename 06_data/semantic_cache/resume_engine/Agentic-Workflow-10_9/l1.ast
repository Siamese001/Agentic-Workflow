          value=Constant(value='\n    Public L1 planning entrypoint.\n\n    Supported modes:\n\n        • "strategy"\n        • "rag"\n        • "drafting"\n        • "bullets"\n        • "qa"\n        • "safety"\n        • "meta_learning"\n        • "prompt_engineering"\n    ')),
        Assign(
          targets=[
            Name(id='profile', ctx=Store())],
          value=Call(
            func=Name(id='infer_profile_signals', ctx=Load()),
            args=[
              Name(id='job_text', ctx=Load()),
              Name(id='resume_text', ctx=Load())])),
        Assign(
          targets=[
            Name(id='complexity', ctx=Store())],
          value=Call(
            func=Name(id='estimate_task_complexity', ctx=Load()),
            args=[
              Name(id='job_text', ctx=Load()),
              Name(id='resume_text', ctx=Load())])),
        Assign(
          targets=[
            Name(id='hints', ctx=Store())],
          value=Call(
            func=Name(id='build_planning_hints', ctx=Load()),
            args=[
              Name(id='profile', ctx=Load()),
              Name(id='complexity', ctx=Load()),
              Name(id='safety_profile', ctx=Load())])),
        Assign(
          targets=[
            Name(id='mode', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='mode', ctx=Load()),
              attr='lower',
              ctx=Load()))),
        If(
          test=Compare(
            left=Name(id='mode', ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value='strategy')]),
          body=[
            Return(
              value=Call(
                func=Name(id='build_strategy_plan', ctx=Load()),
                keywords=[
                  keyword(
                    arg='job_text',
                    value=Name(id='job_text', ctx=Load())),
                  keyword(
                    arg='resume_text',
                    value=Name(id='resume_text', ctx=Load())),
                  keyword(
                    arg='framing',
                    value=Name(id='framing_profile', ctx=Load())),
                  keyword(
                    arg='context_profile',
                    value=Name(id='context_profile', ctx=Load())),
                  keyword(
                    arg='tooling_profile',
                    value=Name(id='tooling_profile', ctx=Load())),
                  keyword(
                    arg='safety_profile',
                    value=Name(id='safety_profile', ctx=Load())),
                  keyword(
                    arg='access_policy',
                    value=Name(id='access_policy', ctx=Load()))]))]),
        If(
          test=Compare(
            left=Name(id='mode', ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value='rag')]),
          body=[
            Return(
              value=Call(
                func=Name(id='build_rag_plan', ctx=Load()),
                keywords=[
                  keyword(
                    arg='job_text',
                    value=Name(id='job_text', ctx=Load())),
                  keyword(
                    arg='resume_text',
                    value=Name(id='resume_text', ctx=Load())),
                  keyword(
                    arg='profile',
                    value=Name(id='profile', ctx=Load())),
                  keyword(
                    arg='complexity',
                    value=Name(id='complexity', ctx=Load())),
                  keyword(
                    arg='context_profile',
                    value=Name(id='context_profile', ctx=Load()))]))]),
        If(
          test=Compare(
            left=Name(id='mode', ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value='drafting')]),
          body=[
            Return(
              value=Call(
                func=Name(id='build_drafting_plan', ctx=Load()),
                keywords=[
                  keyword(
                    arg='job_text',
                    value=Name(id='job_text', ctx=Load())),
                  keyword(
                    arg='resume_text',
                    value=Name(id='resume_text', ctx=Load())),
                  keyword(
                    arg='profile',
                    value=Name(id='profile', ctx=Load())),
                  keyword(
                    arg='complexity',
                    value=Name(id='complexity', ctx=Load())),
                  keyword(
                    arg='framing',
                    value=Name(id='framing_profile', ctx=Load()))]))]),
        If(
          test=Compare(
            left=Name(id='mode', ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value='bullets')]),
          body=[
            Return(
              value=Call(
                func=Name(id='build_bullets_plan', ctx=Load()),
                keywords=[
                  keyword(
                    arg='profile',
                    value=Name(id='profile', ctx=Load())),
                  keyword(
                    arg='complexity',
                    value=Name(id='complexity', ctx=Load()))]))]),
        If(
          test=Compare(
            left=Name(id='mode', ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value='qa')]),
          body=[
            Return(
              value=Call(
                func=Name(id='build_qa_plan', ctx=Load()),
                keywords=[
                  keyword(
                    arg='profile',
                    value=Name(id='profile', ctx=Load())),
                  keyword(
                    arg='complexity',
                    value=Name(id='complexity', ctx=Load())),
                  keyword(
                    arg='hints',
                    value=Name(id='hints', ctx=Load()))]))]),
        If(
          test=Compare(
            left=Name(id='mode', ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value='safety')]),
          body=[
            Return(
              value=Call(
                func=Name(id='build_safety_plan', ctx=Load()),
                keywords=[
                  keyword(
                    arg='profile',
                    value=Name(id='profile', ctx=Load())),
                  keyword(
                    arg='safety_profile',
                    value=Name(id='safety_profile', ctx=Load())),
                  keyword(
                    arg='hints',
                    value=Name(id='hints', ctx=Load()))]))]),
        If(
          test=Compare(
            left=Name(id='mode', ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value='meta_learning')]),
          body=[
            Return(
              value=Call(
                func=Name(id='build_meta_learning_plan', ctx=Load()),
                keywords=[
                  keyword(
                    arg='profile',
                    value=Name(id='profile', ctx=Load())),
                  keyword(
                    arg='complexity',
                    value=Name(id='complexity', ctx=Load()))]))]),
        If(
          test=Compare(
            left=Name(id='mode', ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value='prompt_engineering')]),
          body=[
            Return(
              value=Call(
                func=Name(id='build_prompt_engineering_plan', ctx=Load()),
                keywords=[
                  keyword(
                    arg='framing',
                    value=Name(id='framing_profile', ctx=Load())),
                  keyword(
                    arg='context_profile',
                    value=Name(id='context_profile', ctx=Load()))]))]),
        Raise(
          exc=Call(
            func=Name(id='ValueError', ctx=Load()),
            args=[
              JoinedStr(
                values=[
                  Constant(value='Unsupported L1 planning mode: '),
                  FormattedValue(
                    value=Name(id='mode', ctx=Load()),
                    conversion=114)])]))],
      returns=Name(id='PlanObject', ctx=Load()))])