              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='risk_flags', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Constant(value='jd_alignment_low')]))])]),
        If(
          test=Call(
            func=Name(id='any', ctx=Load()),
            args=[
              GeneratorExp(
                elt=Compare(
                  left=Name(id='k', ctx=Load()),
                  ops=[
                    In()],
                  comparators=[
                    Name(id='jt', ctx=Load())]),
                generators=[
                  comprehension(
                    target=Name(id='k', ctx=Store()),
                    iter=List(
                      elts=[
                        Constant(value='pci'),
                        Constant(value='phi'),
                        Constant(value='hipaa'),
                        Constant(value='pii')],
                      ctx=Load()),
                    is_async=0)])]),
          body=[
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='risk_flags', ctx=Load()),
                  attr='append',
                  ctx=Load()),
                args=[
                  Constant(value='heavy_pii_risk')]))]),
        If(
          test=Call(
            func=Name(id='any', ctx=Load()),
            args=[
              GeneratorExp(
                elt=Compare(
                  left=Name(id='k', ctx=Load()),
                  ops=[
                    In()],
                  comparators=[
                    Name(id='jt', ctx=Load())]),
                generators=[
                  comprehension(
                    target=Name(id='k', ctx=Store()),
                    iter=List(
                      elts=[
                        Constant(value='immediately'),
                        Constant(value='asap'),
                        Constant(value='tight timeline')],
                      ctx=Load()),
                    is_async=0)])]),
          body=[
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='risk_flags', ctx=Load()),
                  attr='append',
                  ctx=Load()),
                args=[
                  Constant(value='aggressive_timeline')]))]),
        Return(
          value=Name(id='risk_flags', ctx=Load()))],
      returns=Subscript(
        value=Name(id='List', ctx=Load()),
        slice=Name(id='str', ctx=Load()),
        ctx=Load())),
    FunctionDef(
      name='infer_profile_signals',
      args=arguments(
        args=[
          arg(
            arg='job_text',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='resume_text',
            annotation=Name(id='str', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Public entry point for L1 profile inference.\n    ')),
        Assign(
          targets=[
            Name(id='seniority', ctx=Store())],
          value=Call(
            func=Name(id='_infer_seniority', ctx=Load()),
            args=[
              Name(id='job_text', ctx=Load()),
              Name(id='resume_text', ctx=Load())])),
        Assign(
          targets=[
            Name(id='domains', ctx=Store())],
          value=Call(
            func=Name(id='_infer_domains', ctx=Load()),
            args=[
              Name(id='job_text', ctx=Load()),
              Name(id='resume_text', ctx=Load())])),
        Assign(
          targets=[
            Name(id='skill_clusters', ctx=Store())],
          value=Call(
            func=Name(id='_infer_skill_clusters', ctx=Load()),
            args=[
              Name(id='job_text', ctx=Load()),
              Name(id='resume_text', ctx=Load())])),
        Assign(
          targets=[
            Name(id='risk_flags', ctx=Store())],
          value=Call(
            func=Name(id='_infer_risk_flags', ctx=Load()),
            args=[
              Name(id='job_text', ctx=Load()),
              Name(id='resume_text', ctx=Load())])),
        Return(
          value=Call(
            func=Name(id='ProfileSignals', ctx=Load()),
            keywords=[
              keyword(
                arg='seniority',
                value=Name(id='seniority', ctx=Load())),
              keyword(
                arg='domains',
                value=Name(id='domains', ctx=Load())),
              keyword(
                arg='skill_clusters',
                value=Name(id='skill_clusters', ctx=Load())),
              keyword(
                arg='risk_flags',
                value=Name(id='risk_flags', ctx=Load()))]))],
      returns=Name(id='ProfileSignals', ctx=Load())),
    FunctionDef(
      name='estimate_task_complexity',
      args=arguments(
        args=[
          arg(
            arg='job_text',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='resume_text',
            annotation=Name(id='str', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Estimate problem complexity from simple heuristics plus meta-biases.\n\n    Base heuristic: token count of job + resume.\n    Meta-bias adjustments (from meta_profile):\n\n        • planning_bias.conservative  → push complexity upward.\n        • planning_bias.exploratory   → pull complexity downward.\n        • routing_bias.prefer_fast    → lean toward lower complexity.\n    ')),
        Assign(
          targets=[
            Name(id='base_tokens', ctx=Store())],
          value=BinOp(
            left=Call(
              func=Name(id='len', ctx=Load()),
              args=[
                Call(
                  func=Attribute(
                    value=Name(id='job_text', ctx=Load()),
                    attr='split',
                    ctx=Load()))]),
            op=Add(),
            right=Call(
              func=Name(id='len', ctx=Load()),
              args=[
                Call(
                  func=Attribute(
                    value=Name(id='resume_text', ctx=Load()),
                    attr='split',
                    ctx=Load()))]))),
        If(
          test=Compare(
            left=Name(id='base_tokens', ctx=Load()),
            ops=[
              Lt()],
            comparators=[
              Constant(value=800)]),
          body=[
            AnnAssign(
              target=Name(id='level', ctx=Store()),
              annotation=Name(id='ComplexityLevel', ctx=Load()),
              value=Attribute(
                value=Name(id='ComplexityLevel', ctx=Load()),
                attr='SIMPLE',
                ctx=Load()),
              simple=1)],
          orelse=[
            If(
              test=Compare(
                left=Name(id='base_tokens', ctx=Load()),
                ops=[
                  Lt()],
                comparators=[
                  Constant(value=2500)]),
              body=[
                Assign(
                  targets=[
                    Name(id='level', ctx=Store())],
                  value=Attribute(
                    value=Name(id='ComplexityLevel', ctx=Load()),
                    attr='MODERATE',
                    ctx=Load()))],
              orelse=[
                Assign(
                  targets=[
                    Name(id='level', ctx=Store())],
                  value=Attribute(
                    value=Name(id='ComplexityLevel', ctx=Load()),
                    attr='COMPLEX',
                    ctx=Load()))])]),
        Assign(
          targets=[
            Name(id='planning_bias', ctx=Store())],
          value=Call(
            func=Name(id='get_planning_bias', ctx=Load()))),
        Assign(
          targets=[
            Name(id='routing_bias', ctx=Store())],
          value=Call(
            func=Name(id='get_routing_bias', ctx=Load()))),
        If(
          test=Call(
            func=Attribute(
              value=Name(id='planning_bias', ctx=Load()),
              attr='get',
              ctx=Load()),
            args=[
              Constant(value='conservative')]),
          body=[
            If(
              test=Compare(
                left=Name(id='level', ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Attribute(
                    value=Name(id='ComplexityLevel', ctx=Load()),
                    attr='SIMPLE',
                    ctx=Load())]),
              body=[
                Assign(
                  targets=[
                    Name(id='level', ctx=Store())],
                  value=Attribute(
                    value=Name(id='ComplexityLevel', ctx=Load()),
                    attr='MODERATE',
                    ctx=Load()))],
              orelse=[
                If(
                  test=Compare(
                    left=Name(id='level', ctx=Load()),
                    ops=[
                      Eq()],
                    comparators=[
                      Attribute(
                        value=Name(id='ComplexityLevel', ctx=Load()),
                        attr='MODERATE',
                        ctx=Load())]),
                  body=[
                    Assign(
                      targets=[
                        Name(id='level', ctx=Store())],
                      value=Attribute(
                        value=Name(id='ComplexityLevel', ctx=Load()),
                        attr='COMPLEX',
                        ctx=Load()))])])]),
        If(
          test=BoolOp(
            op=And(),
            values=[
              Call(
                func=Attribute(
                  value=Name(id='planning_bias', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='exploratory')]),
              Compare(
                left=Name(id='level', ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Attribute(
                    value=Name(id='ComplexityLevel', ctx=Load()),
                    attr='COMPLEX',
                    ctx=Load())])]),
          body=[
            Assign(
              targets=[
                Name(id='level', ctx=Store())],
              value=Attribute(
                value=Name(id='ComplexityLevel', ctx=Load()),
                attr='MODERATE',
                ctx=Load()))]),
        If(
          test=BoolOp(
            op=And(),
            values=[
              Call(
                func=Attribute(
                  value=Name(id='routing_bias', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='prefer_fast')]),
              Compare(
                left=Name(id='level', ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Attribute(
                    value=Name(id='ComplexityLevel', ctx=Load()),
                    attr='MODERATE',
                    ctx=Load())])]),
          body=[
            Assign(
              targets=[
                Name(id='level', ctx=Store())],
              value=Attribute(
                value=Name(id='ComplexityLevel', ctx=Load()),
                attr='SIMPLE',
                ctx=Load()))]),
        Return(
          value=Name(id='level', ctx=Load()))],
      returns=Name(id='ComplexityLevel', ctx=Load())),
    FunctionDef(
      name='select_reasoning_strategy',
      args=arguments(
        args=[
          arg(
            arg='complexity',
            annotation=Name(id='ComplexityLevel', ctx=Load())),
          arg(
            arg='risk_flags',
            annotation=Subscript(
              value=Name(id='Sequence', ctx=Load()),
              slice=Name(id='str', ctx=Load()),
              ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Map complexity + risk + meta-biases into a reasoning strategy hint.\n\n    Meta-bias influence:\n\n        • planning_bias.conservative     → prefer COT_WITH_CRITIQUE.\n        • planning_bias.exploratory      → prefer TOT_WITH_CRITIQUE.\n        • planning_bias.deterministic_recovery → prefer TOT_WITH_CRITIQUE.\n        • qa_bias.recent_failures        → prefer critique variants.\n    ')),
        Assign(
          targets=[
            Name(id='planning_bias', ctx=Store())],
          value=Call(
            func=Name(id='get_planning_bias', ctx=Load()))),
        Assign(
          targets=[
            Name(id='qa_bias', ctx=Store())],
          value=Call(
            func=Name(id='get_qa_bias', ctx=Load()))),
        Assign(
          targets=[
            Name(id='high_risk', ctx=Store())],
          value=BoolOp(
            op=Or(),
            values=[
              Call(
                func=Name(id='bool', ctx=Load()),
                args=[
                  Name(id='risk_flags', ctx=Load())]),
              Call(
                func=Attribute(
                  value=Name(id='qa_bias', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='recent_failures'),
                  Constant(value=False)])])),
        If(
          test=Call(
            func=Attribute(
              value=Name(id='planning_bias', ctx=Load()),
              attr='get',
              ctx=Load()),
            args=[
              Constant(value='exploratory')]),
          body=[
            Return(
              value=Attribute(
                value=Name(id='ReasoningStrategy', ctx=Load()),
                attr='TOT_WITH_CRITIQUE',
                ctx=Load()))]),
        If(
          test=Call(
            func=Attribute(
              value=Name(id='planning_bias', ctx=Load()),
              attr='get',
              ctx=Load()),
            args=[
              Constant(value='conservative')]),
          body=[
            Return(
              value=Attribute(
                value=Name(id='ReasoningStrategy', ctx=Load()),
                attr='COT_WITH_CRITIQUE',
                ctx=Load()))]),
        If(
          test=Call(
            func=Attribute(
              value=Name(id='planning_bias', ctx=Load()),
              attr='get',
              ctx=Load()),
            args=[
              Constant(value='deterministic_recovery')]),
          body=[
            Return(
              value=Attribute(
                value=Name(id='ReasoningStrategy', ctx=Load()),
                attr='TOT_WITH_CRITIQUE',
                ctx=Load()))]),
        If(
          test=BoolOp(
            op=And(),
            values=[
              Compare(
                left=Name(id='complexity', ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Attribute(
                    value=Name(id='ComplexityLevel', ctx=Load()),
                    attr='SIMPLE',
                    ctx=Load())]),
              UnaryOp(
                op=Not(),
                operand=Name(id='high_risk', ctx=Load()))]),
          body=[
            Return(
              value=Attribute(
                value=Name(id='ReasoningStrategy', ctx=Load()),
                attr='DIRECT',
                ctx=Load()))]),
        If(
          test=BoolOp(
            op=And(),
            values=[
              Compare(
                left=Name(id='complexity', ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Attribute(
                    value=Name(id='ComplexityLevel', ctx=Load()),
                    attr='MODERATE',
                    ctx=Load())]),
              UnaryOp(
                op=Not(),
                operand=Name(id='high_risk', ctx=Load()))]),
          body=[
            Return(
              value=Attribute(
                value=Name(id='ReasoningStrategy', ctx=Load()),
                attr='COT',
                ctx=Load()))]),
        If(
          test=BoolOp(
            op=And(),
            values=[
              Name(id='high_risk', ctx=Load()),
              Compare(
                left=Name(id='complexity', ctx=Load()),
                ops=[
                  NotEq()],
                comparators=[
                  Attribute(
                    value=Name(id='ComplexityLevel', ctx=Load()),
                    attr='SIMPLE',
                    ctx=Load())])]),
          body=[
            Return(
              value=Attribute(
                value=Name(id='ReasoningStrategy', ctx=Load()),
                attr='COT_WITH_CRITIQUE',
                ctx=Load()))]),
        Return(
          value=Attribute(
            value=Name(id='ReasoningStrategy', ctx=Load()),
            attr='TOT_WITH_CRITIQUE',
            ctx=Load()))],
      returns=Name(id='ReasoningStrategy', ctx=Load())),
    FunctionDef(
      name='build_planning_hints',
      args=arguments(
        args=[
          arg(
            arg='profile',
            annotation=Name(id='ProfileSignals', ctx=Load())),
          arg(
            arg='complexity',
            annotation=Name(id='ComplexityLevel', ctx=Load())),
          arg(
            arg='safety_profile',
            annotation=Name(id='SafetyOutputProfile', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Construct QA, safety, context, and optimization hints for downstream layers.\n\n    Hint sources:\n        • profile (seniority, domains, risk_flags)\n        • complexity\n        • safety_profile\n        • meta safety/planning biases\n    ')),
        Assign(
          targets=[
            Name(id='safety_bias', ctx=Store())],
          value=Call(
            func=Name(id='get_safety_bias', ctx=Load()))),
        AnnAssign(
          target=Name(id='qa_hints', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load()),
          value=List(ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='safety_hints', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load()),
          value=List(ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='context_hints', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load()),
          value=List(ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='optimization_hints', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load()),
          value=List(ctx=Load()),
          simple=1),
        If(
          test=Compare(
            left=Attribute(
              value=Name(id='profile', ctx=Load()),
              attr='seniority',
              ctx=Load()),
            ops=[
              In()],
            comparators=[
              Tuple(
                elts=[
                  Constant(value='executive'),
                  Constant(value='director')],
                ctx=Load())]),
          body=[
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='qa_hints', ctx=Load()),
                  attr='append',
                  ctx=Load()),
                args=[
                  Constant(value='validate_executive_outcomes_are_quantified')])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='qa_hints', ctx=Load()),
                  attr='append',
                  ctx=Load()),
                args=[
                  Constant(value='ensure_alignment_with_business_outcomes')]))],
          orelse=[
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='qa_hints', ctx=Load()),
                  attr='append',
                  ctx=Load()),
                args=[
                  Constant(value='enforce_action_metric_outcome_pattern')]))]),
        If(
          test=Attribute(
            value=Name(id='safety_profile', ctx=Load()),
            attr='enable_prompt_injection_detection',
            ctx=Load()),
          body=[
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='safety_hints', ctx=Load()),
                  attr='append',
                  ctx=Load()),
                args=[
                  Constant(value='run_prompt_injection_detector')]))]),
        If(
          test=Attribute(
            value=Name(id='safety_profile', ctx=Load()),
            attr='enable_pii_detection',
            ctx=Load()),
          body=[
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='safety_hints', ctx=Load()),
                  attr='append',
                  ctx=Load()),
                args=[
                  Constant(value='run_pii_scan_on_all_outputs')]))]),
        If(
          test=Call(
            func=Attribute(
              value=Name(id='safety_bias', ctx=Load()),
              attr='get',
              ctx=Load()),
            args=[
              Constant(value='heightened_caution')]),
          body=[
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='safety_hints', ctx=Load()),
                  attr='append',
                  ctx=Load()),
                args=[
                  Constant(value='tighten_safety_thresholds')]))]),
        If(
          test=Compare(
            left=Constant(value='insurance'),
            ops=[
              In()],
            comparators=[
              Attribute(
                value=Name(id='profile', ctx=Load()),
                attr='domains',
                ctx=Load())]),
          body=[
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='context_hints', ctx=Load()),
                  attr='append',
                  ctx=Load()),
                args=[
                  Constant(value='preserve_insurance_regulatory_language')]))]),
        If(
          test=Compare(
            left=Constant(value='foundation_models'),
            ops=[
              In()],
            comparators=[
              Attribute(
                value=Name(id='profile', ctx=Load()),
                attr='domains',
                ctx=Load())]),
          body=[
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='context_hints', ctx=Load()),
                  attr='append',
                  ctx=Load()),
                args=[
                  Constant(value='preserve_llm_and_rag_architecture_details')]))]),
        If(
          test=Compare(
            left=Name(id='complexity', ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Attribute(
                value=Name(id='ComplexityLevel', ctx=Load()),
                attr='SIMPLE',
                ctx=Load())]),
          body=[
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='optimization_hints', ctx=Load()),
                  attr='append',
                  ctx=Load()),
                args=[
                  Constant(value='prefer_low_cost_models_for_initial_pass')]))],
          orelse=[
            If(
              test=Compare(
                left=Name(id='complexity', ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Attribute(
                    value=Name(id='ComplexityLevel', ctx=Load()),
                    attr='COMPLEX',
                    ctx=Load())]),
              body=[
                Expr(
