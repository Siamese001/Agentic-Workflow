            annotation=Name(id='str', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Very small heuristic seniority inference.\n\n    This is intentionally simple but structured, so it can be easily\n    overridden or replaced by a more sophisticated classifier without\n    changing downstream contracts.\n    ')),
        Assign(
          targets=[
            Name(id='combined', ctx=Store())],
          value=Call(
            func=Attribute(
              value=JoinedStr(
                values=[
                  FormattedValue(
                    value=Name(id='job_text', ctx=Load()),
                    conversion=-1),
                  Constant(value=' '),
                  FormattedValue(
