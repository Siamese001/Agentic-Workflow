                    func=Name(id='_coerce_origin', ctx=Load()),
                    args=[
                      Call(
                        func=Attribute(
                          value=Name(id='item', ctx=Load()),
                          attr='get',
                          ctx=Load()),
                        args=[
                          Constant(value='origin')])])),
                Assign(
                  targets=[
                    Name(id='content', ctx=Store())],
                  value=Call(
                    func=Name(id='_coerce_content', ctx=Load()),
                    args=[
                      Call(
                        func=Attribute(
                          value=Name(id='item', ctx=Load()),
                          attr='get',
                          ctx=Load()),
                        args=[
