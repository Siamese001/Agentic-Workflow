                  value=Call(
                    func=Attribute(
                      value=Name(id='out', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Dict(
                        keys=[
                          Constant(value='category'),
                          Constant(value='origin'),
                          Constant(value='content')],
                        values=[
                          Name(id='category', ctx=Load()),
                          Name(id='origin', ctx=Load()),
                          Name(id='content', ctx=Load())])]))])]),
        Return(
          value=Name(id='out', ctx=Load()))],
      returns=Subscript(
