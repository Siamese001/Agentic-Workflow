Module(
  body=[
    Expr(
      value=Constant(value='\nMeta Profile & Adaptive Biases (v10_9) — META LAYER ONLY (REFINED)\n\nThis module defines the global meta-profile for the v10_9 agentic\narchitecture. It captures *soft preferences* and *learned biases* that\nare NOT part of the core L1–L5 logic, but are used by:\n\n    • Model routing (e.g., "prefer_fast" when planning dominates cost).\n    • L1 planners (e.g., "conservative" when QA repeatedly fails).\n    • Self-correction (e.g., bias toward replan vs retry vs escalate).\n    • Meta-learning (e.g., patterns inferred from prior runs).\n    • Observability (e.g., "enable more spans when failures accumulate").\n\nLayer constraints (Agentic Guardrails):\n\n    • NO L1 planning (no PlanObject creation).\n    • NO L2 execution (no tool/LLM calls).\n    • NO L3 DAG/orchestration.\n    • NO L4 state mutation (no StateAdapter usage).\n    • NO L5 safety decisions.\n\nThis module is a META layer “tuning brain” that keeps track of\nheuristics such as:\n\n    • "we\'re too slow, route fast"\n    • "QA failures are frequent, plan more conservatively"\n    • "safety blocks often, escalate sooner"\n\nwithout violating layer purity.\n')),
    ImportFrom(
      module='__future__',
      names=[
        alias(name='annotations')],
      level=0),
    ImportFrom(
      module='dataclasses',
      names=[
        alias(name='dataclass'),
        alias(name='field')],
      level=0),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Any'),
        alias(name='Dict'),
        alias(name='List')],
      level=0),
    ClassDef(
      name='RoutingBias',
      body=[
        Expr(
          value=Constant(value='\n    Routing-level preferences for L2/L5.\n\n    Fields:\n        prefer_fast:             prefer cheaper/faster models\n        prefer_robust_retrieval: bias toward more robust RAG settings\n        prefer_long_context:     bias toward long-context models\n    ')),
        AnnAssign(
          target=Name(id='prefer_fast', ctx=Store()),
          annotation=Name(id='bool', ctx=Load()),
          value=Constant(value=False),
          simple=1),
        AnnAssign(
          target=Name(id='prefer_robust_retrieval', ctx=Store()),
          annotation=Name(id='bool', ctx=Load()),
          value=Constant(value=False),
          simple=1),
        AnnAssign(
          target=Name(id='prefer_long_context', ctx=Store()),
          annotation=Name(id='bool', ctx=Load()),
          value=Constant(value=False),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='PlanningBias',
      body=[
        Expr(
          value=Constant(value='\n    Planning (L1 reasoning) preferences.\n\n    Fields:\n        conservative:           reduce branching / depth\n        exploratory:            allow more branches / alternatives\n        deterministic_recovery: bias toward structured recovery plans\n    ')),
        AnnAssign(
          target=Name(id='conservative', ctx=Store()),
          annotation=Name(id='bool', ctx=Load()),
          value=Constant(value=False),
          simple=1),
        AnnAssign(
          target=Name(id='exploratory', ctx=Store()),
          annotation=Name(id='bool', ctx=Load()),
          value=Constant(value=False),
          simple=1),
        AnnAssign(
          target=Name(id='deterministic_recovery', ctx=Store()),
          annotation=Name(id='bool', ctx=Load()),
          value=Constant(value=False),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='QaBias',
      body=[
        Expr(
          value=Constant(value='\n    QA-related preferences and signals.\n\n    Fields:\n        recent_failures:    QA has recently failed often\n        require_extra_pass: bias toward extra QA passes\n    ')),
        AnnAssign(
          target=Name(id='recent_failures', ctx=Store()),
          annotation=Name(id='bool', ctx=Load()),
          value=Constant(value=False),
          simple=1),
        AnnAssign(
          target=Name(id='require_extra_pass', ctx=Store()),
          annotation=Name(id='bool', ctx=Load()),
          value=Constant(value=False),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='SafetyBias',
      body=[
        Expr(
          value=Constant(value='\n    Safety-related preferences.\n\n    Fields:\n        heightened_caution:     bias toward stricter safety paths\n        human_review_important: HIL review is frequently beneficial\n    ')),
        AnnAssign(
          target=Name(id='heightened_caution', ctx=Store()),
          annotation=Name(id='bool', ctx=Load()),
          value=Constant(value=False),
          simple=1),
        AnnAssign(
          target=Name(id='human_review_important', ctx=Store()),
          annotation=Name(id='bool', ctx=Load()),
          value=Constant(value=False),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='MetaUpdate',
      body=[
        Expr(
          value=Constant(value='\n    Single meta-update record used in history.\n\n    Fields:\n        source:    "spans" | "self_correction" | "run_summary" | ...\n        payload:   arbitrary context information\n        deltas:    snapshot of bias fields that changed\n    ')),
        AnnAssign(
          target=Name(id='source', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='payload', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='Any', ctx=Load())],
              ctx=Load()),
            ctx=Load()),
          value=Call(
            func=Name(id='field', ctx=Load()),
            keywords=[
              keyword(
                arg='default_factory',
                value=Name(id='dict', ctx=Load()))]),
          simple=1),
        AnnAssign(
          target=Name(id='deltas', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='Any', ctx=Load())],
              ctx=Load()),
            ctx=Load()),
          value=Call(
            func=Name(id='field', ctx=Load()),
            keywords=[
              keyword(
                arg='default_factory',
                value=Name(id='dict', ctx=Load()))]),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='MetaProfile',
      body=[
        Expr(
          value=Constant(value='\n    Global meta-configuration for adaptive behavior.\n\n    Fields:\n        • routing_bias:    knobs influencing model routing.\n        • planning_bias:   knobs influencing L1 planners.\n        • qa_bias:         knobs based on QA outcomes.\n        • safety_bias:     knobs based on safety outcomes.\n        • history:         recent meta-updates (for inspection and tests).\n\n    All fields are *soft hints* only. L1–L3–L5 are free to ignore them.\n    This object is pure data; update_* helpers below mutate it.\n    ')),
        AnnAssign(
          target=Name(id='routing_bias', ctx=Store()),
          annotation=Name(id='RoutingBias', ctx=Load()),
          value=Call(
            func=Name(id='field', ctx=Load()),
            keywords=[
              keyword(
                arg='default_factory',
                value=Name(id='RoutingBias', ctx=Load()))]),
          simple=1),
        AnnAssign(
          target=Name(id='planning_bias', ctx=Store()),
          annotation=Name(id='PlanningBias', ctx=Load()),
          value=Call(
            func=Name(id='field', ctx=Load()),
            keywords=[
              keyword(
                arg='default_factory',
                value=Name(id='PlanningBias', ctx=Load()))]),
          simple=1),
        AnnAssign(
          target=Name(id='qa_bias', ctx=Store()),
          annotation=Name(id='QaBias', ctx=Load()),
          value=Call(
            func=Name(id='field', ctx=Load()),
            keywords=[
              keyword(
                arg='default_factory',
                value=Name(id='QaBias', ctx=Load()))]),
          simple=1),
        AnnAssign(
          target=Name(id='safety_bias', ctx=Store()),
          annotation=Name(id='SafetyBias', ctx=Load()),
          value=Call(
            func=Name(id='field', ctx=Load()),
            keywords=[
              keyword(
                arg='default_factory',
                value=Name(id='SafetyBias', ctx=Load()))]),
          simple=1),
        AnnAssign(
          target=Name(id='history', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='MetaUpdate', ctx=Load()),
            ctx=Load()),
          value=Call(
            func=Name(id='field', ctx=Load()),
            keywords=[
              keyword(
                arg='default_factory',
                value=Name(id='list', ctx=Load()))]),
          simple=1),
        FunctionDef(
          name='snapshot',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='\n        Return a snapshot safe for logging or inspection.\n        Only the last N history entries are preserved to bound size.\n        ')),
            Return(
              value=Dict(
                keys=[
                  Constant(value='routing_bias'),
                  Constant(value='planning_bias'),
                  Constant(value='qa_bias'),
                  Constant(value='safety_bias'),
                  Constant(value='history')],
                values=[
                  Call(
                    func=Name(id='dict', ctx=Load()),
                    args=[
                      Attribute(
                        value=Attribute(
                          value=Name(id='self', ctx=Load()),
                          attr='routing_bias',
                          ctx=Load()),
                        attr='__dict__',
                        ctx=Load())]),
                  Call(
                    func=Name(id='dict', ctx=Load()),
                    args=[
                      Attribute(
                        value=Attribute(
                          value=Name(id='self', ctx=Load()),
                          attr='planning_bias',
                          ctx=Load()),
                        attr='__dict__',
                        ctx=Load())]),
                  Call(
                    func=Name(id='dict', ctx=Load()),
                    args=[
                      Attribute(
                        value=Attribute(
                          value=Name(id='self', ctx=Load()),
                          attr='qa_bias',
                          ctx=Load()),
                        attr='__dict__',
                        ctx=Load())]),
                  Call(
                    func=Name(id='dict', ctx=Load()),
                    args=[
                      Attribute(
                        value=Attribute(
                          value=Name(id='self', ctx=Load()),
                          attr='safety_bias',
                          ctx=Load()),
                        attr='__dict__',
                        ctx=Load())]),
                  ListComp(
                    elt=Dict(
                      keys=[
                        Constant(value='source'),
                        Constant(value='payload'),
                        Constant(value='deltas')],
                      values=[
                        Attribute(
                          value=Name(id='h', ctx=Load()),
                          attr='source',
                          ctx=Load()),
                        Call(
                          func=Name(id='dict', ctx=Load()),
                          args=[
                            Attribute(
                              value=Name(id='h', ctx=Load()),
                              attr='payload',
                              ctx=Load())]),
                        Call(
                          func=Name(id='dict', ctx=Load()),
                          args=[
                            Attribute(
                              value=Name(id='h', ctx=Load()),
                              attr='deltas',
                              ctx=Load())])]),
                    generators=[
                      comprehension(
                        target=Name(id='h', ctx=Store()),
                        iter=Subscript(
                          value=Attribute(
                            value=Name(id='self', ctx=Load()),
                            attr='history',
                            ctx=Load()),
                          slice=Slice(
                            lower=UnaryOp(
                              op=USub(),
                              operand=Constant(value=10))),
                          ctx=Load()),
                        is_async=0)])]))],
          returns=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='Any', ctx=Load())],
              ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='_record_update',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='source',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='payload',
                annotation=Subscript(
                  value=Name(id='Dict', ctx=Load()),
                  slice=Tuple(
                    elts=[
                      Name(id='str', ctx=Load()),
                      Name(id='Any', ctx=Load())],
                    ctx=Load()),
                  ctx=Load())),
              arg(
                arg='deltas',
                annotation=Subscript(
                  value=Name(id='Dict', ctx=Load()),
                  slice=Tuple(
                    elts=[
                      Name(id='str', ctx=Load()),
                      Name(id='Any', ctx=Load())],
                    ctx=Load()),
                  ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Internal helper to append a MetaUpdate to history.\n        ')),
            Expr(
              value=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='history',
                    ctx=Load()),
                  attr='append',
                  ctx=Load()),
                args=[
                  Call(
                    func=Name(id='MetaUpdate', ctx=Load()),
                    keywords=[
                      keyword(
                        arg='source',
                        value=Name(id='source', ctx=Load())),
                      keyword(
                        arg='payload',
                        value=Call(
                          func=Name(id='dict', ctx=Load()),
                          args=[
                            Name(id='payload', ctx=Load())])),
                      keyword(
                        arg='deltas',
                        value=Call(
                          func=Name(id='dict', ctx=Load()),
                          args=[
                            Name(id='deltas', ctx=Load())]))])]))],
          returns=Constant(value=None))],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    Assign(
      targets=[
        Name(id='META_PROFILE', ctx=Store())],
      value=Call(
        func=Name(id='MetaProfile', ctx=Load()))),
    FunctionDef(
      name='update_from_spans',
      args=arguments(
        args=[
          arg(
            arg='spans',
            annotation=Subscript(
              value=Name(id='List', ctx=Load()),
              slice=Subscript(
                value=Name(id='Dict', ctx=Load()),
                slice=Tuple(
                  elts=[
                    Name(id='str', ctx=Load()),
                    Name(id='Any', ctx=Load())],
                  ctx=Load()),
                ctx=Load()),
              ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Update META_PROFILE from a list of span dicts, each of form:\n\n        {"name": "planning"|"execution"|..., "duration_ms": float}\n\n    Heuristics (restored from v10_8 behavior):\n\n        • If planning consistently slower than execution → routing_bias.prefer_fast = True.\n        • Else → routing_bias.prefer_fast = False.\n\n    This is a META-only adjustment; it does not mutate L1–L5 directly.\n    ')),
        If(
          test=UnaryOp(
            op=Not(),
            operand=Name(id='spans', ctx=Load())),
          body=[
            Return()]),
        Assign(
          targets=[
            Name(id='planning', ctx=Store())],
          value=Call(
            func=Name(id='next', ctx=Load()),
            args=[
              GeneratorExp(
                elt=Name(id='s', ctx=Load()),
                generators=[
                  comprehension(
                    target=Name(id='s', ctx=Store()),
                    iter=Name(id='spans', ctx=Load()),
                    ifs=[
                      Compare(
                        left=Call(
                          func=Attribute(
                            value=Name(id='s', ctx=Load()),
                            attr='get',
                            ctx=Load()),
                          args=[
                            Constant(value='name')]),
                        ops=[
                          Eq()],
                        comparators=[
                          Constant(value='planning')])],
                    is_async=0)]),
              Constant(value=None)])),
        Assign(
          targets=[
            Name(id='execution', ctx=Store())],
          value=Call(
            func=Name(id='next', ctx=Load()),
            args=[
              GeneratorExp(
                elt=Name(id='s', ctx=Load()),
                generators=[
                  comprehension(
                    target=Name(id='s', ctx=Store()),
                    iter=Name(id='spans', ctx=Load()),
                    ifs=[
                      Compare(
                        left=Call(
                          func=Attribute(
                            value=Name(id='s', ctx=Load()),
                            attr='get',
                            ctx=Load()),
                          args=[
                            Constant(value='name')]),
                        ops=[
                          Eq()],
                        comparators=[
                          Constant(value='execution')])],
                    is_async=0)]),
              Constant(value=None)])),
        Assign(
          targets=[
            Name(id='p_ms', ctx=Store())],
          value=IfExp(
            test=Name(id='planning', ctx=Load()),
            body=Call(
              func=Name(id='float', ctx=Load()),
              args=[
                Call(
                  func=Attribute(
                    value=Name(id='planning', ctx=Load()),
                    attr='get',
                    ctx=Load()),
                  args=[
                    Constant(value='duration_ms'),
                    Constant(value=0.0)])]),
            orelse=Constant(value=0.0))),
        Assign(
          targets=[
            Name(id='e_ms', ctx=Store())],
          value=IfExp(
            test=Name(id='execution', ctx=Load()),
            body=Call(
              func=Name(id='float', ctx=Load()),
              args=[
                Call(
                  func=Attribute(
                    value=Name(id='execution', ctx=Load()),
                    attr='get',
                    ctx=Load()),
                  args=[
                    Constant(value='duration_ms'),
                    Constant(value=0.0)])]),
            orelse=Constant(value=0.0))),
        AnnAssign(
          target=Name(id='payload', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='Any', ctx=Load())],
              ctx=Load()),
            ctx=Load()),
          value=Dict(
            keys=[
              Constant(value='planning_ms'),
              Constant(value='execution_ms')],
            values=[
              Name(id='p_ms', ctx=Load()),
              Name(id='e_ms', ctx=Load())]),
          simple=1),
        Assign(
          targets=[
            Name(id='prefer_fast_before', ctx=Store())],
          value=Attribute(
            value=Attribute(
              value=Name(id='META_PROFILE', ctx=Load()),
              attr='routing_bias',
              ctx=Load()),
            attr='prefer_fast',
            ctx=Load())),
        If(
          test=BoolOp(
            op=And(),
            values=[
              Compare(
                left=Name(id='p_ms', ctx=Load()),
                ops=[
                  Gt()],
                comparators=[
                  BinOp(
                    left=Name(id='e_ms', ctx=Load()),
                    op=Mult(),
                    right=Constant(value=1.1))]),
              Compare(
                left=Name(id='p_ms', ctx=Load()),
                ops=[
                  Gt()],
                comparators=[
                  Constant(value=0.0)])]),
          body=[
            Assign(
              targets=[
                Attribute(
                  value=Attribute(
                    value=Name(id='META_PROFILE', ctx=Load()),
                    attr='routing_bias',
                    ctx=Load()),
                  attr='prefer_fast',
                  ctx=Store())],
              value=Constant(value=True))],
          orelse=[
            Assign(
              targets=[
                Attribute(
                  value=Attribute(
                    value=Name(id='META_PROFILE', ctx=Load()),
                    attr='routing_bias',
                    ctx=Load()),
                  attr='prefer_fast',
                  ctx=Store())],
              value=Constant(value=False))]),
        AnnAssign(
          target=Name(id='deltas', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='Any', ctx=Load())],
              ctx=Load()),
            ctx=Load()),
          value=Dict(),
          simple=1),
        If(
          test=Compare(
            left=Attribute(
              value=Attribute(
                value=Name(id='META_PROFILE', ctx=Load()),
                attr='routing_bias',
                ctx=Load()),
              attr='prefer_fast',
              ctx=Load()),
            ops=[
              NotEq()],
            comparators=[
              Name(id='prefer_fast_before', ctx=Load())]),
          body=[
            Assign(
              targets=[
                Subscript(
                  value=Name(id='deltas', ctx=Load()),
                  slice=Constant(value='routing_bias.prefer_fast'),
                  ctx=Store())],
              value=Attribute(
                value=Attribute(
                  value=Name(id='META_PROFILE', ctx=Load()),
                  attr='routing_bias',
                  ctx=Load()),
                attr='prefer_fast',
                ctx=Load()))]),
        If(
          test=Name(id='deltas', ctx=Load()),
          body=[
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='META_PROFILE', ctx=Load()),
                  attr='_record_update',
                  ctx=Load()),
                keywords=[
                  keyword(
                    arg='source',
                    value=Constant(value='spans')),
                  keyword(
                    arg='payload',
                    value=Name(id='payload', ctx=Load())),
                  keyword(
                    arg='deltas',
                    value=Name(id='deltas', ctx=Load()))]))])],
      returns=Constant(value=None)),
    FunctionDef(
      name='update_from_self_correction',
      args=arguments(
        args=[
          arg(
            arg='self_correction_block',
            annotation=Subscript(
              value=Name(id='Dict', ctx=Load()),
              slice=Tuple(
                elts=[
                  Name(id='str', ctx=Load()),
                  Name(id='Any', ctx=Load())],
                ctx=Load()),
              ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Update META_PROFILE from a self_correction block, typically derived\n    from self_correction.CorrectionRecommendation.to_dict().\n\n    Example block:\n\n        {\n          "needed": True,\n          "surface": "qa_recheck",\n          "rationale": "...",\n          "metadata": {...}\n        }\n\n    Heuristics (restored v10_8 semantics, but typed):\n\n        • surface == "qa_recheck":\n            planning_bias.conservative = True\n            qa_bias.recent_failures = True\n\n        • surface == "strategy_replan":\n            planning_bias.exploratory = True\n\n        • surface == "hil_escalation":\n            safety_bias.human_review_important = True\n\n        • surface == "rag_retry":\n            routing_bias.prefer_robust_retrieval = True\n\n        • surface == "checkpoint_recovery":\n            planning_bias.deterministic_recovery = True\n    ')),
        If(
          test=UnaryOp(
            op=Not(),
            operand=Name(id='self_correction_block', ctx=Load())),
          body=[
            Return()]),
        Assign(
          targets=[
            Name(id='needed', ctx=Store())],
          value=Call(
            func=Name(id='bool', ctx=Load()),
            args=[
              Call(
                func=Attribute(
                  value=Name(id='self_correction_block', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='needed'),
                  Constant(value=False)])])),
        Assign(
          targets=[
            Name(id='surface', ctx=Store())],
          value=Call(
            func=Name(id='str', ctx=Load()),
            args=[
              BoolOp(
                op=Or(),
                values=[
                  Call(
                    func=Attribute(
                      value=Name(id='self_correction_block', ctx=Load()),
                      attr='get',
                      ctx=Load()),
                    args=[
                      Constant(value='surface')]),
                  Constant(value='')])])),
        If(
          test=BoolOp(
            op=Or(),
            values=[
              UnaryOp(
                op=Not(),
                operand=Name(id='needed', ctx=Load())),
              UnaryOp(
                op=Not(),
                operand=Name(id='surface', ctx=Load()))]),
          body=[
            Return()]),
        Assign(
          targets=[
            Name(id='payload', ctx=Store())],
          value=Dict(
            keys=[
              Constant(value='surface'),
              Constant(value='rationale'),
              Constant(value='metadata')],
            values=[
              Name(id='surface', ctx=Load()),
              Call(
                func=Attribute(
                  value=Name(id='self_correction_block', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='rationale'),
                  Constant(value='')]),
              Call(
                func=Attribute(
                  value=Name(id='self_correction_block', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='metadata'),
                  Dict()])])),
        AnnAssign(
          target=Name(id='deltas', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='Any', ctx=Load())],
              ctx=Load()),
            ctx=Load()),
          value=Dict(),
          simple=1),
        If(
          test=Compare(
            left=Name(id='surface', ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value='qa_recheck')]),
          body=[
            If(
              test=UnaryOp(
                op=Not(),
                operand=Attribute(
                  value=Attribute(
                    value=Name(id='META_PROFILE', ctx=Load()),
                    attr='planning_bias',
                    ctx=Load()),
                  attr='conservative',
                  ctx=Load())),
              body=[
                Assign(
                  targets=[
                    Attribute(
                      value=Attribute(
                        value=Name(id='META_PROFILE', ctx=Load()),
                        attr='planning_bias',
                        ctx=Load()),
                      attr='conservative',
                      ctx=Store())],
                  value=Constant(value=True)),
                Assign(
                  targets=[
                    Subscript(
                      value=Name(id='deltas', ctx=Load()),
