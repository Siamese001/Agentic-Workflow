    {
      "node_type": "function",
      "name": "normalize_world_facts",
      "line_number": 74,
      "docstring": "Normalize arbitrary world facts into a consistent schema.\n\nEach fact has the form:\n\n    {\n        \"category\": \"entity\" | \"event\" | \"relation\",\n        \"origin\": \"retrieval\" | \"user\" | \"system\",\n        \"content\": \"...\",\n    }\n\nThis is a pure function; it does not touch StateAdapter or phases.",
      "imports": [],
      "dependencies": [
        "_coerce_origin",
        "_coerce_content",
        "_coerce_category",
        "isinstance"
      ],
