        Assign(
          targets=[
            Name(id='s', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Call(
                func=Attribute(
                  value=BoolOp(
                    op=Or(),
                    values=[
                      Name(id='strategy', ctx=Load()),
                      Constant(value='hybrid')]),
                  attr='lower',
                  ctx=Load())),
              attr='strip',
              ctx=Load()))),
        If(
          test=Compare(
            left=Name(id='s', ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value='bm25')]),
          body=[
            Assign(
