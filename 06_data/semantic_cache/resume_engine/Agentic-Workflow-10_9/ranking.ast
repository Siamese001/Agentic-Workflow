                ctx=Load()),
              ctx=Load()),
            ctx=Load()),
          value=Call(
            func=Name(id='set', ctx=Load())),
          simple=1),
        For(
          target=Name(id='group', ctx=Store()),
          iter=BoolOp(
            op=Or(),
            values=[
              Name(id='groups', ctx=Load()),
              List(ctx=Load())]),
          body=[
