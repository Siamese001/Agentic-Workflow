    ClassDef(
      name='TextUtils',
      body=[
        Expr(
          value=Constant(value='Unified text manipulation utilities.')),
        FunctionDef(
          name='count_words',
          args=arguments(
            args=[
              arg(
                arg='text',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Count words in text.')),
            Return(
              value=Call(
                func=Name(id='len', ctx=Load()),
                args=[
                  Call(
                    func=Attribute(
                      value=Name(id='re', ctx=Load()),
                      attr='findall',
                      ctx=Load()),
                    args=[
                      Constant(value='\\b\\w+\\b'),
                      Name(id='text', ctx=Load())])]))],
          decorator_list=[
            Name(id='staticmethod', ctx=Load())],
          returns=Name(id='int', ctx=Load())),
        FunctionDef(
          name='sanitize_text',
          args=arguments(
            args=[
              arg(
                arg='text',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Remove special characters and normalize whitespace.')),
            Assign(
              targets=[
                Name(id='text', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='re', ctx=Load()),
                  attr='sub',
                  ctx=Load()),
                args=[
                  Constant(value='[^\\w\\s.,;:!?()-]'),
                  Constant(value=''),
                  Name(id='text', ctx=Load())])),
            Assign(
              targets=[
                Name(id='text', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='re', ctx=Load()),
                  attr='sub',
                  ctx=Load()),
                args=[
                  Constant(value='\\s+'),
                  Constant(value=' '),
                  Name(id='text', ctx=Load())])),
            Return(
              value=Call(
                func=Attribute(
                  value=Name(id='text', ctx=Load()),
                  attr='strip',
                  ctx=Load())))],
          decorator_list=[
            Name(id='staticmethod', ctx=Load())],
          returns=Name(id='str', ctx=Load())),
        FunctionDef(
          name='extract_keywords',
          args=arguments(
            args=[
              arg(
                arg='text',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='top_n',
                annotation=Name(id='int', ctx=Load()))],
            defaults=[
              Constant(value=10)]),
          body=[
            Expr(
              value=Constant(value='Extract top keywords from text.')),
            If(
              test=UnaryOp(
                op=Not(),
                operand=Name(id='SKLEARN_AVAILABLE', ctx=Load())),
              body=[
                Assign(
                  targets=[
                    Name(id='words', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='re', ctx=Load()),
                      attr='findall',
                      ctx=Load()),
                    args=[
                      Constant(value='\\b\\w+\\b'),
                      Call(
                        func=Attribute(
                          value=Name(id='text', ctx=Load()),
                          attr='lower',
                          ctx=Load()))])),
                Assign(
                  targets=[
                    Name(id='word_freq', ctx=Store())],
                  value=Call(
                    func=Name(id='defaultdict', ctx=Load()),
                    args=[
                      Name(id='int', ctx=Load())])),
                For(
                  target=Name(id='word', ctx=Store()),
                  iter=Name(id='words', ctx=Load()),
                  body=[
                    If(
                      test=Compare(
                        left=Call(
                          func=Name(id='len', ctx=Load()),
                          args=[
                            Name(id='word', ctx=Load())]),
                        ops=[
                          Gt()],
                        comparators=[
                          Constant(value=3)]),
                      body=[
                        AugAssign(
                          target=Subscript(
                            value=Name(id='word_freq', ctx=Load()),
                            slice=Name(id='word', ctx=Load()),
                            ctx=Store()),
                          op=Add(),
                          value=Constant(value=1))])]),
                Return(
                  value=Subscript(
                    value=Call(
                      func=Name(id='sorted', ctx=Load()),
                      args=[
                        Call(
                          func=Attribute(
                            value=Name(id='word_freq', ctx=Load()),
                            attr='keys',
                            ctx=Load()))],
                      keywords=[
                        keyword(
                          arg='key',
                          value=Lambda(
                            args=arguments(
                              args=[
                                arg(arg='x')]),
                            body=Subscript(
                              value=Name(id='word_freq', ctx=Load()),
                              slice=Name(id='x', ctx=Load()),
                              ctx=Load()))),
                        keyword(
                          arg='reverse',
                          value=Constant(value=True))]),
                    slice=Slice(
                      upper=Name(id='top_n', ctx=Load())),
                    ctx=Load()))]),
            Assign(
              targets=[
                Name(id='vectorizer', ctx=Store())],
              value=Call(
                func=Name(id='TfidfVectorizer', ctx=Load()),
                keywords=[
                  keyword(
                    arg='max_features',
                    value=Name(id='top_n', ctx=Load())),
                  keyword(
                    arg='stop_words',
                    value=Constant(value='english'))])),
            Try(
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='vectorizer', ctx=Load()),
                      attr='fit',
                      ctx=Load()),
                    args=[
                      List(
                        elts=[
                          Name(id='text', ctx=Load())],
                        ctx=Load())])),
                Return(
                  value=Call(
                    func=Attribute(
                      value=Call(
                        func=Attribute(
                          value=Name(id='vectorizer', ctx=Load()),
                          attr='get_feature_names_out',
                          ctx=Load())),
                      attr='tolist',
                      ctx=Load())))],
              handlers=[
                ExceptHandler(
                  body=[
                    Return(
                      value=List(ctx=Load()))])])],
          decorator_list=[
            Name(id='staticmethod', ctx=Load())],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='calculate_similarity',
          args=arguments(
            args=[
              arg(
                arg='text1',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='text2',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Calculate cosine similarity between two texts.')),
            If(
              test=UnaryOp(
                op=Not(),
                operand=Name(id='SKLEARN_AVAILABLE', ctx=Load())),
              body=[
                Assign(
                  targets=[
                    Name(id='words1', ctx=Store())],
                  value=Call(
                    func=Name(id='set', ctx=Load()),
                    args=[
                      Call(
                        func=Attribute(
                          value=Name(id='re', ctx=Load()),
                          attr='findall',
                          ctx=Load()),
                        args=[
                          Constant(value='\\b\\w+\\b'),
                          Call(
                            func=Attribute(
                              value=Name(id='text1', ctx=Load()),
                              attr='lower',
                              ctx=Load()))])])),
                Assign(
                  targets=[
                    Name(id='words2', ctx=Store())],
                  value=Call(
                    func=Name(id='set', ctx=Load()),
                    args=[
                      Call(
                        func=Attribute(
                          value=Name(id='re', ctx=Load()),
                          attr='findall',
                          ctx=Load()),
                        args=[
                          Constant(value='\\b\\w+\\b'),
                          Call(
                            func=Attribute(
                              value=Name(id='text2', ctx=Load()),
                              attr='lower',
                              ctx=Load()))])])),
                If(
                  test=BoolOp(
                    op=Or(),
                    values=[
                      UnaryOp(
                        op=Not(),
                        operand=Name(id='words1', ctx=Load())),
                      UnaryOp(
                        op=Not(),
                        operand=Name(id='words2', ctx=Load()))]),
                  body=[
                    Return(
                      value=Constant(value=0.0))]),
                Assign(
                  targets=[
                    Name(id='intersection', ctx=Store())],
                  value=Call(
                    func=Name(id='len', ctx=Load()),
                    args=[
                      BinOp(
                        left=Name(id='words1', ctx=Load()),
                        op=BitAnd(),
                        right=Name(id='words2', ctx=Load()))])),
                Assign(
                  targets=[
                    Name(id='union', ctx=Store())],
                  value=Call(
                    func=Name(id='len', ctx=Load()),
                    args=[
                      BinOp(
                        left=Name(id='words1', ctx=Load()),
                        op=BitOr(),
                        right=Name(id='words2', ctx=Load()))])),
                Return(
                  value=IfExp(
                    test=Compare(
                      left=Name(id='union', ctx=Load()),
                      ops=[
                        Gt()],
                      comparators=[
                        Constant(value=0)]),
                    body=BinOp(
                      left=Name(id='intersection', ctx=Load()),
                      op=Div(),
                      right=Name(id='union', ctx=Load())),
                    orelse=Constant(value=0.0)))]),
            Assign(
              targets=[
                Name(id='vectorizer', ctx=Store())],
              value=Call(
                func=Name(id='TfidfVectorizer', ctx=Load()))),
            Try(
              body=[
                Assign(
                  targets=[
                    Name(id='vectors', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='vectorizer', ctx=Load()),
                      attr='fit_transform',
                      ctx=Load()),
                    args=[
                      List(
                        elts=[
                          Name(id='text1', ctx=Load()),
                          Name(id='text2', ctx=Load())],
                        ctx=Load())])),
                Assign(
                  targets=[
                    Name(id='similarity', ctx=Store())],
                  value=Subscript(
                    value=Subscript(
                      value=Call(
                        func=Name(id='cosine_similarity', ctx=Load()),
                        args=[
                          Subscript(
                            value=Name(id='vectors', ctx=Load()),
                            slice=Slice(
                              lower=Constant(value=0),
                              upper=Constant(value=1)),
                            ctx=Load()),
                          Subscript(
                            value=Name(id='vectors', ctx=Load()),
                            slice=Slice(
                              lower=Constant(value=1),
                              upper=Constant(value=2)),
                            ctx=Load())]),
                      slice=Constant(value=0),
                      ctx=Load()),
                    slice=Constant(value=0),
                    ctx=Load())),
                Return(
                  value=Call(
                    func=Name(id='float', ctx=Load()),
                    args=[
                      Name(id='similarity', ctx=Load())]))],
              handlers=[
                ExceptHandler(
                  body=[
                    Return(
                      value=Constant(value=0.0))])])],
          decorator_list=[
            Name(id='staticmethod', ctx=Load())],
          returns=Name(id='float', ctx=Load()))]),
    Assign(
      targets=[
        Name(id='text_utils', ctx=Store())],
      value=Call(
        func=Name(id='TextUtils', ctx=Load()))),
    FunctionDef(
      name='fence_data',
      args=arguments(
        args=[
          arg(
            arg='data',
            annotation=Name(id='Any', ctx=Load())),
          arg(
            arg='tag',
            annotation=Name(id='str', ctx=Load()))],
        defaults=[
          Constant(value='context')]),
      body=[
        Expr(
          value=Constant(value='Fence data in XML tags for structured prompts.')),
        If(
          test=Call(
            func=Name(id='isinstance', ctx=Load()),
            args=[
              Name(id='data', ctx=Load()),
              Name(id='dict', ctx=Load())]),
          body=[
            Assign(
              targets=[
                Name(id='data_str', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='json', ctx=Load()),
                  attr='dumps',
                  ctx=Load()),
                args=[
                  Name(id='data', ctx=Load())],
                keywords=[
                  keyword(
                    arg='indent',
                    value=Constant(value=2))]))],
          orelse=[
            If(
              test=Call(
                func=Name(id='isinstance', ctx=Load()),
                args=[
                  Name(id='data', ctx=Load()),
                  Tuple(
                    elts=[
                      Name(id='list', ctx=Load()),
                      Name(id='tuple', ctx=Load())],
                    ctx=Load())]),
              body=[
                Assign(
                  targets=[
                    Name(id='data_str', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='json', ctx=Load()),
                      attr='dumps',
                      ctx=Load()),
                    args=[
                      Name(id='data', ctx=Load())],
                    keywords=[
                      keyword(
                        arg='indent',
                        value=Constant(value=2))]))],
