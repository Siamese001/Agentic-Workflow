    FunctionDef(
      name='format_prompt_with_context',
      args=arguments(
        args=[
          arg(
            arg='template_key',
            annotation=Name(id='str', ctx=Load()))],
        kwarg=arg(arg='kwargs')),
      body=[
        Expr(
          value=Constant(value='\n    Format a prompt template with provided context.\n    Handles both simple string formatting and complex context injection.\n    ')),
        Assign(
          targets=[
            Name(id='template', ctx=Store())],
          value=Call(
            func=Name(id='_get_prompt_template', ctx=Load()),
            args=[
              Name(id='template_key', ctx=Load())])),
        If(
          test=Compare(
            left=Constant(value='structured_data'),
            ops=[
              In()],
            comparators=[
              Name(id='kwargs', ctx=Load())]),
          body=[
            Assign(
              targets=[
                Subscript(
                  value=Name(id='kwargs', ctx=Load()),
                  slice=Constant(value='structured_context'),
                  ctx=Store())],
              value=Call(
                func=Name(id='fence_data', ctx=Load()),
                args=[
                  Subscript(
                    value=Name(id='kwargs', ctx=Load()),
                    slice=Constant(value='structured_data'),
                    ctx=Load())]))]),
        Try(
          body=[
            Return(
              value=Call(
                func=Attribute(
                  value=Name(id='template', ctx=Load()),
                  attr='format',
                  ctx=Load()),
                keywords=[
                  keyword(
                    value=Name(id='kwargs', ctx=Load()))]))],
          handlers=[
            ExceptHandler(
              type=Name(id='KeyError', ctx=Load()),
              name='e',
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='core_logger', ctx=Load()),
                      attr='error',
                      ctx=Load()),
                    args=[
                      JoinedStr(
                        values=[
                          Constant(value="Missing required parameter for template '"),
                          FormattedValue(
                            value=Name(id='template_key', ctx=Load()),
                            conversion=-1),
                          Constant(value="': "),
                          FormattedValue(
                            value=Name(id='e', ctx=Load()),
                            conversion=-1)])])),
                For(
                  target=Name(id='key', ctx=Store()),
                  iter=Call(
                    func=Attribute(
                      value=Name(id='re', ctx=Load()),
                      attr='findall',
                      ctx=Load()),
                    args=[
                      Constant(value='\\{(\\w+)\\}'),
