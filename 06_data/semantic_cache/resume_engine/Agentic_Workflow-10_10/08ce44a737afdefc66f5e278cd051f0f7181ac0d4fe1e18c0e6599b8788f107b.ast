    {
      "node_type": "function",
      "name": "_render_envelope_with_template",
      "line_number": 222,
      "docstring": "Merge a PromptEnvelope with the registry template into a final string.\n\nDefault templates follow the pattern:\n\n    \"## CONTEXT\\n\\n## INSTRUCTIONS\\n\\n## OUTPUT_FORMAT\\n\"\n\nThis helper injects the envelope contents into those anchors while\nalso adding the richer sections (Framing, Reasoning, Safety).",
      "imports": [],
      "dependencies": [],
      "responsibility_level": "L5",
      "children": []
    },
