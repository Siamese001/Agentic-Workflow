              attr='append',
              ctx=Load()),
            args=[
              Call(
                func=Name(id='DraftSectionPlan', ctx=Load()),
                keywords=[
                  keyword(
                    arg='id',
                    value=Constant(value='experience')),
                  keyword(
                    arg='title',
                    value=Constant(value='Experience')),
                  keyword(
                    arg='required',
                    value=Constant(value=True)),
                  keyword(
