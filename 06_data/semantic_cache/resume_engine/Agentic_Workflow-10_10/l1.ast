                  keyword(
                    arg='title',
                    value=Constant(value='Skills')),
                  keyword(
                    arg='required',
                    value=Constant(value=True)),
                  keyword(
                    arg='max_tokens',
                    value=Constant(value=256)),
                  keyword(
                    arg='priority',
                    value=Constant(value=0.8))])])),
        If(
          test=Compare(
            left=Name(id='complexity', ctx=Load()),
            ops=[
              Is()],
            comparators=[
              Attribute(
                value=Name(id='ComplexityLevel', ctx=Load()),
                attr='HIGH',
                ctx=Load())]),
          body=[
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='sections', ctx=Load()),
                  attr='append',
                  ctx=Load()),
                args=[
                  Call(
                    func=Name(id='DraftSectionPlan', ctx=Load()),
                    keywords=[
                      keyword(
                        arg='id',
