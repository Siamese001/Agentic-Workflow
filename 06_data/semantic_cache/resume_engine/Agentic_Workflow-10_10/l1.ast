Module(
  body=[
    Expr(
      value=Constant(value='\nUnified L1 Planning Layer (v10_10 · Phase 3 — FINAL)\n====================================================\n\nResponsibilities (L1 only):\n\n    • Interpret workflow inputs (job, resume, workflow config).\n    • Look up the active execution profile (G1–G3) using the meta-profile.\n    • Choose complexity and reasoning mode hints for downstream layers.\n    • Construct typed plans:\n\n        – StrategyPlan\n        – RAGPlan\n        – DraftingPlan\n        – QAPlan\n        – SafetyPlan\n\n    • Construct a RoutingHint that carries ExecutionProfile + MetaProfile\n      into L2/L3 without doing any execution.\n\nLayering constraints:\n\n    • NO LLM calls (L2 only, via cognitive_agents).\n    • NO tool calls or side effects.\n    • NO state mutation (WorkflowState is L4-only).\n    • NO safety enforcement (L5-only).\n\nThe result of this module is a WorkflowPlanBundle that fully describes\nwhat should happen in the workflow, but not how it is executed.\n')),
    ImportFrom(
      module='__future__',
      names=[
        alias(name='annotations')],
      level=0),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Any'),
        alias(name='Dict'),
        alias(name='List'),
        alias(name='Optional')],
      level=0),
    ImportFrom(
      module='models',
      names=[
        alias(name='ComplexityLevel'),
        alias(name='DraftingMode'),
        alias(name='ReasoningMode'),
        alias(name='JobInput'),
        alias(name='ResumeInput'),
        alias(name='WorkflowConfig'),
        alias(name='ExecutionProfile'),
        alias(name='RoutingHint'),
        alias(name='StrategyStep'),
        alias(name='StrategyPlan'),
        alias(name='RAGQueryHint'),
        alias(name='RAGPlan'),
        alias(name='DraftSectionPlan'),
        alias(name='DraftingPlan'),
        alias(name='QACheck'),
        alias(name='QAPlan'),
        alias(name='SafetyCheck'),
        alias(name='SafetyPlan'),
        alias(name='WorkflowPlanBundle')],
      level=0),
    ImportFrom(
      module='config_profiles_v10_10',
      names=[
        alias(name='ExecutionProfileSpec'),
        alias(name='get_profile')],
      level=0),
    ImportFrom(
      module='meta_profile',
      names=[
        alias(name='MetaProfileSnapshot')],
      level=0),
    FunctionDef(
      name='_normalize_text',
      args=arguments(
        args=[
          arg(
            arg='value',
            annotation=Subscript(
              value=Name(id='Optional', ctx=Load()),
              slice=Name(id='str', ctx=Load()),
              ctx=Load()))]),
      body=[
        If(
          test=UnaryOp(
            op=Not(),
            operand=Name(id='value', ctx=Load())),
          body=[
            Return(
              value=Constant(value=''))]),
        Return(
          value=Call(
            func=Attribute(
              value=Call(
                func=Name(id='str', ctx=Load()),
                args=[
                  Name(id='value', ctx=Load())]),
              attr='strip',
              ctx=Load())))],
      returns=Name(id='str', ctx=Load())),
    FunctionDef(
      name='_extract_job_text',
      args=arguments(
        args=[
          arg(
            arg='job',
            annotation=Name(id='JobInput', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Aggregate job fields into a single planning surface.\n    ')),
        AnnAssign(
          target=Name(id='parts', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load()),
          value=List(ctx=Load()),
          simple=1),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='parts', ctx=Load()),
              attr='append',
              ctx=Load()),
            args=[
              Call(
                func=Name(id='_normalize_text', ctx=Load()),
                args=[
                  Attribute(
                    value=Name(id='job', ctx=Load()),
                    attr='title',
                    ctx=Load())])])),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='parts', ctx=Load()),
              attr='append',
              ctx=Load()),
            args=[
              Call(
                func=Name(id='_normalize_text', ctx=Load()),
                args=[
                  Attribute(
                    value=Name(id='job', ctx=Load()),
                    attr='role_type',
                    ctx=Load())])])),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='parts', ctx=Load()),
              attr='append',
              ctx=Load()),
            args=[
              Call(
                func=Name(id='_normalize_text', ctx=Load()),
                args=[
                  Attribute(
                    value=Name(id='job', ctx=Load()),
                    attr='seniority',
                    ctx=Load())])])),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='parts', ctx=Load()),
              attr='append',
              ctx=Load()),
            args=[
              Call(
                func=Name(id='_normalize_text', ctx=Load()),
                args=[
                  Attribute(
                    value=Name(id='job', ctx=Load()),
                    attr='posting_text',
                    ctx=Load())])])),
        If(
          test=Attribute(
            value=Name(id='job', ctx=Load()),
            attr='requirements',
            ctx=Load()),
          body=[
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='parts', ctx=Load()),
                  attr='append',
                  ctx=Load()),
                args=[
                  Call(
                    func=Attribute(
                      value=Constant(value=' '),
                      attr='join',
                      ctx=Load()),
                    args=[
                      Attribute(
                        value=Name(id='job', ctx=Load()),
                        attr='requirements',
                        ctx=Load())])]))]),
        If(
          test=Attribute(
            value=Name(id='job', ctx=Load()),
            attr='tags',
            ctx=Load()),
          body=[
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='parts', ctx=Load()),
                  attr='append',
                  ctx=Load()),
                args=[
                  Call(
                    func=Attribute(
                      value=Constant(value=' '),
                      attr='join',
                      ctx=Load()),
                    args=[
                      Attribute(
                        value=Name(id='job', ctx=Load()),
                        attr='tags',
                        ctx=Load())])]))]),
        Return(
          value=Call(
            func=Attribute(
              value=Constant(value='\n'),
              attr='join',
              ctx=Load()),
            args=[
              GeneratorExp(
                elt=Name(id='p', ctx=Load()),
                generators=[
                  comprehension(
                    target=Name(id='p', ctx=Store()),
                    iter=Name(id='parts', ctx=Load()),
                    ifs=[
                      Name(id='p', ctx=Load())],
                    is_async=0)])]))],
      returns=Name(id='str', ctx=Load())),
    FunctionDef(
      name='_extract_resume_text',
      args=arguments(
        args=[
          arg(
            arg='resume',
            annotation=Name(id='ResumeInput', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Aggregate resume fields into a single planning surface.\n    ')),
        AnnAssign(
          target=Name(id='parts', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load()),
          value=List(ctx=Load()),
          simple=1),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='parts', ctx=Load()),
              attr='append',
              ctx=Load()),
            args=[
              Call(
                func=Name(id='_normalize_text', ctx=Load()),
                args=[
                  Attribute(
                    value=Name(id='resume', ctx=Load()),
                    attr='summary',
                    ctx=Load())])])),
        For(
          target=Name(id='section', ctx=Store()),
          iter=BoolOp(
            op=Or(),
            values=[
              Attribute(
                value=Name(id='resume', ctx=Load()),
                attr='experience_sections',
                ctx=Load()),
              List(ctx=Load())]),
          body=[
            For(
              target=Name(id='key', ctx=Store()),
              iter=Tuple(
                elts=[
                  Constant(value='impact_summary'),
                  Constant(value='summary'),
                  Constant(value='description'),
                  Constant(value='details')],
                ctx=Load()),
              body=[
                If(
                  test=BoolOp(
                    op=And(),
                    values=[
                      Compare(
                        left=Name(id='key', ctx=Load()),
                        ops=[
                          In()],
                        comparators=[
                          Name(id='section', ctx=Load())]),
                      Subscript(
                        value=Name(id='section', ctx=Load()),
                        slice=Name(id='key', ctx=Load()),
                        ctx=Load())]),
                  body=[
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Name(id='parts', ctx=Load()),
                          attr='append',
                          ctx=Load()),
                        args=[
                          Call(
                            func=Name(id='str', ctx=Load()),
                            args=[
                              Subscript(
                                value=Name(id='section', ctx=Load()),
                                slice=Name(id='key', ctx=Load()),
                                ctx=Load())])]))])])]),
        If(
          test=Attribute(
            value=Name(id='resume', ctx=Load()),
            attr='skills',
            ctx=Load()),
          body=[
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='parts', ctx=Load()),
                  attr='append',
                  ctx=Load()),
                args=[
                  Call(
                    func=Attribute(
                      value=Constant(value=' '),
                      attr='join',
                      ctx=Load()),
                    args=[
                      GeneratorExp(
                        elt=Call(
                          func=Name(id='str', ctx=Load()),
                          args=[
                            Name(id='s', ctx=Load())]),
                        generators=[
                          comprehension(
                            target=Name(id='s', ctx=Store()),
                            iter=Attribute(
                              value=Name(id='resume', ctx=Load()),
                              attr='skills',
                              ctx=Load()),
                            is_async=0)])])]))]),
        If(
          test=Attribute(
            value=Name(id='resume', ctx=Load()),
            attr='projects',
            ctx=Load()),
          body=[
            For(
              target=Name(id='proj', ctx=Store()),
              iter=Attribute(
                value=Name(id='resume', ctx=Load()),
                attr='projects',
                ctx=Load()),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='parts', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Call(
                        func=Name(id='_normalize_text', ctx=Load()),
                        args=[
                          Call(
                            func=Attribute(
                              value=Name(id='proj', ctx=Load()),
                              attr='get',
                              ctx=Load()),
                            args=[
                              Constant(value='summary')])])])),
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='parts', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Call(
                        func=Name(id='_normalize_text', ctx=Load()),
                        args=[
                          Call(
                            func=Attribute(
                              value=Name(id='proj', ctx=Load()),
                              attr='get',
                              ctx=Load()),
                            args=[
                              Constant(value='details')])])]))])]),
        Return(
          value=Call(
            func=Attribute(
              value=Constant(value='\n'),
              attr='join',
              ctx=Load()),
            args=[
              GeneratorExp(
                elt=Name(id='p', ctx=Load()),
                generators=[
                  comprehension(
                    target=Name(id='p', ctx=Store()),
                    iter=Name(id='parts', ctx=Load()),
                    ifs=[
                      Name(id='p', ctx=Load())],
                    is_async=0)])]))],
      returns=Name(id='str', ctx=Load())),
    FunctionDef(
      name='_map_meta_profile_to_routing_hint',
      args=arguments(
        args=[
          arg(
            arg='meta_profile',
            annotation=Subscript(
              value=Name(id='Optional', ctx=Load()),
              slice=Name(id='MetaProfileSnapshot', ctx=Load()),
              ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Convert MetaProfileSnapshot into a simple dict used as RoutingHint.metadata.\n    ')),
        If(
          test=Compare(
            left=Name(id='meta_profile', ctx=Load()),
            ops=[
              Is()],
            comparators=[
              Constant(value=None)]),
          body=[
            Return(value=Dict())]),
        Return(
          value=Dict(
            keys=[
              Constant(value='active_profile_id'),
              Constant(value='prefers_anthropic'),
              Constant(value='prefers_openai'),
              Constant(value='prefers_fast_models'),
              Constant(value='reasoning_mode_hint'),
              Constant(value='qa_failure_rate_last_10'),
              Constant(value='correction_rate_last_10'),
              Constant(value='extra_qa_passes'),
              Constant(value='reinforce_strictness'),
              Constant(value='elevated_caution'),
              Constant(value='hil_preferred')],
            values=[
              Attribute(
                value=Name(id='meta_profile', ctx=Load()),
                attr='active_profile_id',
                ctx=Load()),
              Attribute(
                value=Name(id='meta_profile', ctx=Load()),
                attr='prefers_anthropic',
                ctx=Load()),
              Attribute(
                value=Name(id='meta_profile', ctx=Load()),
                attr='prefers_openai',
                ctx=Load()),
              Attribute(
                value=Name(id='meta_profile', ctx=Load()),
                attr='prefers_fast_models',
                ctx=Load()),
              Attribute(
                value=Name(id='meta_profile', ctx=Load()),
                attr='reasoning_mode_hint',
                ctx=Load()),
              Attribute(
                value=Name(id='meta_profile', ctx=Load()),
                attr='qa_failure_rate_last_10',
                ctx=Load()),
              Attribute(
                value=Name(id='meta_profile', ctx=Load()),
                attr='correction_rate_last_10',
                ctx=Load()),
              Attribute(
                value=Name(id='meta_profile', ctx=Load()),
                attr='extra_qa_passes',
                ctx=Load()),
              Attribute(
                value=Name(id='meta_profile', ctx=Load()),
                attr='reinforce_strictness',
                ctx=Load()),
              Attribute(
                value=Name(id='meta_profile', ctx=Load()),
                attr='elevated_caution',
                ctx=Load()),
              Attribute(
                value=Name(id='meta_profile', ctx=Load()),
                attr='hil_preferred',
                ctx=Load())]))],
      returns=Subscript(
        value=Name(id='Dict', ctx=Load()),
        slice=Tuple(
          elts=[
            Name(id='str', ctx=Load()),
            Name(id='Any', ctx=Load())],
          ctx=Load()),
        ctx=Load())),
    FunctionDef(
      name='_classify_complexity',
      args=arguments(
        args=[
          arg(
            arg='job_text',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='resume_text',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='profile_spec',
            annotation=Name(id='ExecutionProfileSpec', ctx=Load())),
          arg(
            arg='meta_profile',
            annotation=Subscript(
              value=Name(id='Optional', ctx=Load()),
              slice=Name(id='MetaProfileSnapshot', ctx=Load()),
              ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Map the combined text + profile + meta-profile signals into LOW/MEDIUM/HIGH.\n    ')),
        Assign(
          targets=[
            Name(id='total_tokens', ctx=Store())],
          value=BinOp(
            left=Call(
              func=Name(id='len', ctx=Load()),
              args=[
                Call(
                  func=Attribute(
                    value=Name(id='job_text', ctx=Load()),
                    attr='split',
                    ctx=Load()))]),
            op=Add(),
            right=Call(
              func=Name(id='len', ctx=Load()),
              args=[
                Call(
                  func=Attribute(
                    value=Name(id='resume_text', ctx=Load()),
                    attr='split',
                    ctx=Load()))]))),
        If(
          test=Compare(
            left=Name(id='total_tokens', ctx=Load()),
            ops=[
              Lt()],
            comparators=[
              Constant(value=800)]),
          body=[
            AnnAssign(
              target=Name(id='level', ctx=Store()),
              annotation=Name(id='ComplexityLevel', ctx=Load()),
              value=Attribute(
                value=Name(id='ComplexityLevel', ctx=Load()),
                attr='LOW',
                ctx=Load()),
              simple=1)],
          orelse=[
            If(
              test=Compare(
                left=Name(id='total_tokens', ctx=Load()),
                ops=[
                  Lt()],
                comparators=[
                  Constant(value=2500)]),
              body=[
                Assign(
                  targets=[
                    Name(id='level', ctx=Store())],
                  value=Attribute(
                    value=Name(id='ComplexityLevel', ctx=Load()),
                    attr='MEDIUM',
                    ctx=Load()))],
              orelse=[
                Assign(
                  targets=[
                    Name(id='level', ctx=Store())],
                  value=Attribute(
                    value=Name(id='ComplexityLevel', ctx=Load()),
                    attr='HIGH',
                    ctx=Load()))])]),
        If(
          test=Compare(
            left=Name(id='meta_profile', ctx=Load()),
            ops=[
              IsNot()],
            comparators=[
              Constant(value=None)]),
          body=[
            If(
              test=BoolOp(
                op=Or(),
                values=[
                  Attribute(
                    value=Name(id='meta_profile', ctx=Load()),
                    attr='elevated_caution',
                    ctx=Load()),
                  Compare(
                    left=Attribute(
                      value=Name(id='meta_profile', ctx=Load()),
                      attr='correction_rate_last_10',
                      ctx=Load()),
                    ops=[
                      Gt()],
                    comparators=[
                      Constant(value=0.3)])]),
              body=[
                If(
                  test=Compare(
                    left=Name(id='level', ctx=Load()),
                    ops=[
                      Is()],
                    comparators=[
                      Attribute(
                        value=Name(id='ComplexityLevel', ctx=Load()),
                        attr='LOW',
                        ctx=Load())]),
                  body=[
                    Assign(
                      targets=[
                        Name(id='level', ctx=Store())],
                      value=Attribute(
                        value=Name(id='ComplexityLevel', ctx=Load()),
                        attr='MEDIUM',
                        ctx=Load()))],
                  orelse=[
                    If(
                      test=Compare(
                        left=Name(id='level', ctx=Load()),
                        ops=[
                          Is()],
                        comparators=[
                          Attribute(
                            value=Name(id='ComplexityLevel', ctx=Load()),
                            attr='MEDIUM',
                            ctx=Load())]),
                      body=[
                        Assign(
                          targets=[
                            Name(id='level', ctx=Store())],
                          value=Attribute(
                            value=Name(id='ComplexityLevel', ctx=Load()),
                            attr='HIGH',
                            ctx=Load()))])])])]),
        If(
          test=Compare(
            left=Attribute(
              value=Name(id='profile_spec', ctx=Load()),
              attr='min_complexity',
              ctx=Load()),
            ops=[
              IsNot()],
            comparators=[
              Constant(value=None)]),
          body=[
            If(
              test=Compare(
                left=Attribute(
                  value=Name(id='level', ctx=Load()),
                  attr='value',
                  ctx=Load()),
                ops=[
                  Lt()],
                comparators=[
                  Attribute(
                    value=Attribute(
                      value=Name(id='profile_spec', ctx=Load()),
                      attr='min_complexity',
                      ctx=Load()),
                    attr='value',
                    ctx=Load())]),
              body=[
                Assign(
                  targets=[
                    Name(id='level', ctx=Store())],
                  value=Attribute(
                    value=Name(id='profile_spec', ctx=Load()),
                    attr='min_complexity',
                    ctx=Load()))])]),
        Return(
          value=Name(id='level', ctx=Load()))],
      returns=Name(id='ComplexityLevel', ctx=Load())),
    FunctionDef(
      name='_choose_reasoning_mode',
      args=arguments(
        args=[
          arg(
            arg='profile_spec',
            annotation=Name(id='ExecutionProfileSpec', ctx=Load())),
          arg(
            arg='meta_profile',
            annotation=Subscript(
              value=Name(id='Optional', ctx=Load()),
              slice=Name(id='MetaProfileSnapshot', ctx=Load()),
              ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Choose the reasoning mode for this workflow.\n    ')),
        Assign(
          targets=[
            Name(id='mode', ctx=Store())],
          value=Attribute(
            value=Name(id='profile_spec', ctx=Load()),
            attr='reasoning_mode',
            ctx=Load())),
        If(
          test=Compare(
            left=Name(id='meta_profile', ctx=Load()),
            ops=[
              IsNot()],
            comparators=[
              Constant(value=None)]),
          body=[
            Assign(
              targets=[
                Name(id='hint', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=BoolOp(
                    op=Or(),
                    values=[
                      Attribute(
                        value=Name(id='meta_profile', ctx=Load()),
                        attr='reasoning_mode_hint',
                        ctx=Load()),
                      Constant(value='')]),
                  attr='lower',
                  ctx=Load()))),
            If(
              test=Compare(
                left=Name(id='hint', ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value='cot')]),
              body=[
                Assign(
                  targets=[
                    Name(id='mode', ctx=Store())],
                  value=Attribute(
                    value=Name(id='ReasoningMode', ctx=Load()),
                    attr='CHAIN_OF_THOUGHT',
                    ctx=Load()))],
              orelse=[
                If(
                  test=Compare(
                    left=Name(id='hint', ctx=Load()),
                    ops=[
                      Eq()],
                    comparators=[
                      Constant(value='tot')]),
                  body=[
                    Assign(
                      targets=[
                        Name(id='mode', ctx=Store())],
                      value=Attribute(
                        value=Name(id='ReasoningMode', ctx=Load()),
                        attr='TOT',
                        ctx=Load()))],
                  orelse=[
                    If(
                      test=Compare(
                        left=Name(id='hint', ctx=Load()),
                        ops=[
                          Eq()],
                        comparators=[
                          Constant(value='react')]),
                      body=[
                        Assign(
                          targets=[
                            Name(id='mode', ctx=Store())],
                          value=Attribute(
                            value=Name(id='ReasoningMode', ctx=Load()),
                            attr='REACT',
                            ctx=Load()))])])])]),
        Return(
          value=Name(id='mode', ctx=Load()))],
      returns=Name(id='ReasoningMode', ctx=Load())),
    FunctionDef(
      name='_to_execution_profile',
      args=arguments(
        args=[
          arg(
            arg='spec',
            annotation=Name(id='ExecutionProfileSpec', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Map an ExecutionProfileSpec (config) into the simpler ExecutionProfile\n    model used at L1 planning time.\n\n    This object (ExecutionProfile) is what gets carried inside RoutingHint,\n    and is the primary top-level knob carrier for Phase-3 features like:\n        • HYDE (rag_allow_hyde)\n        • RRF strategy\n        • QA council size\n        • Correction loop configuration\n        • Telemetry routing mode\n    ')),
        Return(
          value=Call(
            func=Name(id='ExecutionProfile', ctx=Load()),
            keywords=[
              keyword(
                arg='name',
                value=Attribute(
                  value=Name(id='spec', ctx=Load()),
                  attr='id',
                  ctx=Load())),
              keyword(
                arg='description',
                value=Attribute(
                  value=Name(id='spec', ctx=Load()),
                  attr='description',
                  ctx=Load())),
              keyword(
                arg='retrieval',
                value=Attribute(
                  value=Name(id='spec', ctx=Load()),
                  attr='retrieval',
                  ctx=Load())),
              keyword(
                arg='metadata',
                value=Dict(
                  keys=[
                    Constant(value='safety_tier'),
                    Constant(value='model_tier'),
                    Constant(value='max_cost_usd'),
                    Constant(value='max_latency_ms'),
                    Constant(value='qa_council_size'),
                    Constant(value='enable_correction_loop'),
                    Constant(value='max_corrections'),
                    Constant(value='rag_allow_hyde'),
                    Constant(value='hyde_model_tier'),
                    Constant(value='routing_telemetry_mode')],
                  values=[
                    Attribute(
                      value=Attribute(
                        value=Name(id='spec', ctx=Load()),
                        attr='safety_tier',
                        ctx=Load()),
                      attr='value',
                      ctx=Load()),
                    Attribute(
                      value=Attribute(
                        value=Name(id='spec', ctx=Load()),
                        attr='model_tier',
                        ctx=Load()),
                      attr='value',
                      ctx=Load()),
                    Attribute(
                      value=Name(id='spec', ctx=Load()),
                      attr='max_cost_usd',
                      ctx=Load()),
                    Attribute(
                      value=Name(id='spec', ctx=Load()),
                      attr='max_latency_ms',
                      ctx=Load()),
                    Attribute(
                      value=Name(id='spec', ctx=Load()),
                      attr='qa_council_size',
                      ctx=Load()),
                    Attribute(
                      value=Name(id='spec', ctx=Load()),
                      attr='enable_correction_loop',
                      ctx=Load()),
                    Attribute(
                      value=Name(id='spec', ctx=Load()),
                      attr='max_corrections',
                      ctx=Load()),
                    Attribute(
                      value=Name(id='spec', ctx=Load()),
                      attr='rag_allow_hyde',
                      ctx=Load()),
                    Attribute(
                      value=Name(id='spec', ctx=Load()),
                      attr='hyde_model_tier',
                      ctx=Load()),
                    Attribute(
                      value=Name(id='spec', ctx=Load()),
                      attr='routing_telemetry_mode',
                      ctx=Load())]))]))],
      returns=Name(id='ExecutionProfile', ctx=Load())),
    FunctionDef(
      name='_build_strategy_plan',
      args=arguments(
        args=[
          arg(
            arg='job',
