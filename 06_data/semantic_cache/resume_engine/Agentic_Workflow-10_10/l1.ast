    FunctionDef(
      name='_build_safety_plan',
      args=arguments(
        args=[
          arg(
            arg='profile_spec',
            annotation=Name(id='ExecutionProfileSpec', ctx=Load())),
          arg(
            arg='meta_profile',
            annotation=Subscript(
              value=Name(id='Optional', ctx=Load()),
              slice=Name(id='MetaProfileSnapshot', ctx=Load()),
              ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Build a SafetyPlan describing which safety checks to run.\n    ')),
        AnnAssign(
          target=Name(id='checks', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='SafetyCheck', ctx=Load()),
            ctx=Load()),
          value=List(ctx=Load()),
          simple=1),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='checks', ctx=Load()),
              attr='append',
              ctx=Load()),
            args=[
              Call(
                func=Name(id='SafetyCheck', ctx=Load()),
                keywords=[
                  keyword(
                    arg='id',
                    value=Constant(value='pii')),
                  keyword(
                    arg='description',
                    value=Constant(value='Detect and flag any PII or sensitive personal information.')),
                  keyword(
                    arg='severity',
                    value=Constant(value='high'))])])),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='checks', ctx=Load()),
              attr='append',
              ctx=Load()),
            args=[
              Call(
                func=Name(id='SafetyCheck', ctx=Load()),
                keywords=[
                  keyword(
                    arg='id',
                    value=Constant(value='policy_violations')),
                  keyword(
                    arg='description',
                    value=Constant(value='Detect potential policy violations (disallowed claims, discrimination, etc.).')),
                  keyword(
                    arg='severity',
                    value=Constant(value='high'))])])),
        If(
          test=Compare(
            left=Attribute(
              value=Attribute(
                value=Name(id='profile_spec', ctx=Load()),
                attr='safety_tier',
                ctx=Load()),
              attr='value',
              ctx=Load()),
            ops=[
              GtE()],
            comparators=[
              Constant(value=2)]),
