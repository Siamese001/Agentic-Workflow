    FunctionDef(
      name='_build_rag_plan',
      args=arguments(
        args=[
          arg(
            arg='job',
            annotation=Name(id='JobInput', ctx=Load())),
          arg(
            arg='resume',
            annotation=Name(id='ResumeInput', ctx=Load())),
          arg(
            arg='config',
            annotation=Name(id='WorkflowConfig', ctx=Load())),
          arg(
            arg='profile_spec',
            annotation=Name(id='ExecutionProfileSpec', ctx=Load())),
          arg(
            arg='complexity',
            annotation=Name(id='ComplexityLevel', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Build a RAGPlan describing which retrieval surfaces to use.\n\n    Phase-3 invariants:\n        • HYDE is controlled by config/profile flags (rag_allow_hyde).\n        • Hybrid vs non-hybrid is determined by RetrievalConfig.strategy.\n        • Hints describe job / resume / hybrid focus surfaces.\n        • strategy_hint links to the configured retrieval strategy, which\n          downstream retrieval/ranking can use.\n    ')),
        Assign(
          targets=[
            Name(id='max_hits', ctx=Store())],
          value=Attribute(
            value=Attribute(
              value=Name(id='profile_spec', ctx=Load()),
              attr='retrieval',
              ctx=Load()),
            attr='max_hits',
            ctx=Load())),
        Assign(
          targets=[
            Name(id='job_chunks', ctx=Store())],
          value=Call(
            func=Name(id='min', ctx=Load()),
            args=[
              Attribute(
                value=Name(id='config', ctx=Load()),
                attr='rag_max_job_chunks',
                ctx=Load()),
              Name(id='max_hits', ctx=Load())])),
        Assign(
          targets=[
            Name(id='resume_chunks', ctx=Store())],
          value=Call(
            func=Name(id='min', ctx=Load()),
            args=[
              Attribute(
                value=Name(id='config', ctx=Load()),
                attr='rag_max_resume_chunks',
                ctx=Load()),
              Name(id='max_hits', ctx=Load())])),
        Assign(
          targets=[
            Name(id='hybrid_chunks', ctx=Store())],
          value=Call(
            func=Name(id='min', ctx=Load()),
            args=[
              Attribute(
                value=Name(id='config', ctx=Load()),
                attr='rag_max_hybrid_chunks',
                ctx=Load()),
              Name(id='max_hits', ctx=Load())])),
        AnnAssign(
          target=Name(id='hints', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='RAGQueryHint', ctx=Load()),
            ctx=Load()),
          value=List(
            elts=[
              Call(
                func=Name(id='RAGQueryHint', ctx=Load()),
                keywords=[
                  keyword(
                    arg='id',
                    value=Constant(value='job_core')),
                  keyword(
                    arg='description',
                    value=Constant(value='Extract core job requirements and key phrases.')),
                  keyword(
                    arg='focus',
                    value=Constant(value='job')),
                  keyword(
                    arg='max_chunks',
                    value=Name(id='job_chunks', ctx=Load())),
                  keyword(
                    arg='importance',
                    value=Constant(value=1.0))]),
              Call(
                func=Name(id='RAGQueryHint', ctx=Load()),
                keywords=[
                  keyword(
                    arg='id',
                    value=Constant(value='resume_core')),
                  keyword(
                    arg='description',
                    value=Constant(value='Extract core resume experience and impact statements.')),
                  keyword(
                    arg='focus',
                    value=Constant(value='resume')),
                  keyword(
                    arg='max_chunks',
                    value=Name(id='resume_chunks', ctx=Load())),
                  keyword(
                    arg='importance',
                    value=Constant(value=1.0))]),
              Call(
                func=Name(id='RAGQueryHint', ctx=Load()),
                keywords=[
                  keyword(
                    arg='id',
                    value=Constant(value='hybrid_overlap')),
                  keyword(
                    arg='description',
                    value=Constant(value='Retrieve hybrid signals to align resume content tightly with the job.')),
                  keyword(
                    arg='focus',
                    value=Constant(value='hybrid')),
                  keyword(
                    arg='max_chunks',
                    value=Name(id='hybrid_chunks', ctx=Load())),
                  keyword(
                    arg='importance',
                    value=IfExp(
                      test=Compare(
                        left=Name(id='complexity', ctx=Load()),
                        ops=[
                          Is()],
                        comparators=[
                          Attribute(
                            value=Name(id='ComplexityLevel', ctx=Load()),
                            attr='HIGH',
                            ctx=Load())]),
                      body=Constant(value=1.1),
                      orelse=Constant(value=1.0)))])],
            ctx=Load()),
          simple=1),
        Assign(
          targets=[
            Name(id='allow_hyde', ctx=Store())],
          value=Attribute(
            value=Name(id='config', ctx=Load()),
            attr='rag_allow_hyde',
            ctx=Load())),
        Assign(
          targets=[
            Name(id='require_hybrid', ctx=Store())],
          value=BoolOp(
            op=Or(),
            values=[
              Call(
                func=Name(id='getattr', ctx=Load()),
                args=[
                  Name(id='config', ctx=Load()),
                  Constant(value='rag_require_hybrid'),
                  Constant(value=False)]),
              Compare(
                left=Attribute(
                  value=Attribute(
                    value=Name(id='profile_spec', ctx=Load()),
                    attr='retrieval',
                    ctx=Load()),
                  attr='strategy',
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value='hybrid')])])),
        Return(
          value=Call(
            func=Name(id='RAGPlan', ctx=Load()),
            keywords=[
              keyword(
                arg='hints',
                value=Name(id='hints', ctx=Load())),
              keyword(
                arg='allow_hyde',
                value=Name(id='allow_hyde', ctx=Load())),
              keyword(
                arg='require_hybrid',
                value=Name(id='require_hybrid', ctx=Load())),
              keyword(
                arg='strategy_hint',
                value=Attribute(
                  value=Attribute(
                    value=Name(id='profile_spec', ctx=Load()),
                    attr='retrieval',
                    ctx=Load()),
                  attr='strategy',
                  ctx=Load()))]))],
      returns=Name(id='RAGPlan', ctx=Load())),
    FunctionDef(
      name='_select_drafting_mode',
      args=arguments(
        args=[
          arg(
            arg='job',
            annotation=Name(id='JobInput', ctx=Load())),
          arg(
            arg='resume',
            annotation=Name(id='ResumeInput', ctx=Load())),
          arg(
            arg='complexity',
            annotation=Name(id='ComplexityLevel', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Choose drafting mode (e.g., bullet-heavy vs narrative).\n    ')),
        Assign(
          targets=[
            Name(id='seniority', ctx=Store())],
          value=Call(
            func=Attribute(
              value=BoolOp(
                op=Or(),
                values=[
                  Attribute(
                    value=Name(id='job', ctx=Load()),
                    attr='seniority',
                    ctx=Load()),
                  Constant(value='')]),
              attr='lower',
              ctx=Load()))),
        If(
          test=Call(
            func=Name(id='any', ctx=Load()),
            args=[
              GeneratorExp(
                elt=Compare(
                  left=Name(id='k', ctx=Load()),
                  ops=[
                    In()],
                  comparators=[
                    Name(id='seniority', ctx=Load())]),
                generators=[
                  comprehension(
                    target=Name(id='k', ctx=Store()),
                    iter=Tuple(
                      elts=[
                        Constant(value='director'),
                        Constant(value='vp'),
                        Constant(value='chief'),
                        Constant(value='head')],
                      ctx=Load()),
                    is_async=0)])]),
          body=[
            Return(
              value=Attribute(
                value=Name(id='DraftingMode', ctx=Load()),
                attr='NARRATIVE',
                ctx=Load()))]),
        If(
          test=Compare(
            left=Name(id='complexity', ctx=Load()),
            ops=[
              Is()],
            comparators=[
              Attribute(
                value=Name(id='ComplexityLevel', ctx=Load()),
                attr='LOW',
                ctx=Load())]),
          body=[
            Return(
              value=Attribute(
                value=Name(id='DraftingMode', ctx=Load()),
                attr='BULLET_HEAVY',
                ctx=Load()))]),
        Return(
          value=Attribute(
            value=Name(id='DraftingMode', ctx=Load()),
            attr='BALANCED',
            ctx=Load()))],
      returns=Name(id='DraftingMode', ctx=Load())),
    FunctionDef(
      name='_build_drafting_plan',
      args=arguments(
        args=[
          arg(
