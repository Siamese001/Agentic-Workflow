                        value=Constant(value=False)),
                      keyword(
                        arg='max_tokens',
                        value=Constant(value=512)),
                      keyword(
                        arg='priority',
                        value=Constant(value=0.7))])]))]),
        Assign(
          targets=[
            Name(id='mode', ctx=Store())],
          value=Call(
            func=Name(id='_select_drafting_mode', ctx=Load()),
            args=[
