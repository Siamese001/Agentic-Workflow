          arg(
            arg='rrf_k',
            annotation=Name(id='int', ctx=Load()))],
        kw_defaults=[
          Constant(value=None),
          Constant(value=None),
          Constant(value=60)]),
      body=[
        Expr(
          value=Constant(value='Wrapper used by retrieval.py for Evidence-level weighted RRF.\n\n    This function adapts the raw `rrf_weights` list (coming from\n    RetrievalConfig.rrf_weights) into a minimal RetrievalConfig instance\n    and delegates to `fuse_evidence_groups_rrf`.\n\n    It exists solely to preserve the existing retrieval.py call-site:\n\n        ranking.fuse_ranked_groups_rrf(\n            groups=groups,\n            rrf_weights=retrieval_cfg.rrf_weights,\n            workflow_id=workflow_id,\n        )\n\n    The `workflow_id` is accepted for signature compatibility but is\n    not used here; telemetry is emitted inside `fuse_evidence_groups_rrf`.\n    ')),
        AnnAssign(
          target=Name(id='cfg', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Optional', ctx=Load()),
            slice=Name(id='RetrievalConfig', ctx=Load()),
            ctx=Load()),
          value=Constant(value=None),
          simple=1),
        If(
          test=Compare(
            left=Name(id='rrf_weights', ctx=Load()),
            ops=[
              IsNot()],
            comparators=[
              Constant(value=None)]),
          body=[
            Assign(
              targets=[
                Name(id='cfg', ctx=Store())],
              value=Call(
                func=Name(id='RetrievalConfig', ctx=Load()))),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='cfg', ctx=Load()),
                  attr='rrf_weights',
                  ctx=Store())],
              value=Call(
                func=Name(id='list', ctx=Load()),
                args=[
                  Name(id='rrf_weights', ctx=Load())]))]),
        Return(
          value=Call(
            func=Name(id='fuse_evidence_groups_rrf', ctx=Load()),
            args=[
              Name(id='groups', ctx=Load())],
            keywords=[
              keyword(
                arg='cfg',
                value=Name(id='cfg', ctx=Load())),
