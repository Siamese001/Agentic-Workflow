Module(
  body=[
    Expr(
      value=Constant(value='\nMeta Profile & Adaptive Biases (v10_10 · Phase 3) — META LAYER ONLY\n===================================================================\n\nThis module defines the *meta-layer* profile for the agentic system.\n\nIt is **NOT** part of L1–L5. It provides SOFT BIASES and historical\nsignals that L1, L2, routing, and self-correction may consult:\n\n    • Model routing preferences (prefer fast vs robust).\n    • Planning preferences (conservative vs exploratory).\n    • QA-related hints (recent failure rates, extra passes).\n    • Safety-related hints (heightened caution, HIL bias).\n    • Rolling statistics (QA failures, correction usage).\n\nKey types:\n\n    • MetaProfile          – mutable, long-lived state across workflows.\n    • MetaProfileSnapshot  – frozen, per-workflow snapshot.\n    • MetaProfileUpdater   – updates MetaProfile and produces snapshots.\n\nThis module must remain PURE META:\n\n    • No LLM calls.\n    • No state mutation outside MetaProfile.\n    • No orchestration.\n    • No direct provider SDK calls.\n')),
    ImportFrom(
      module='__future__',
      names=[
        alias(name='annotations')],
      level=0),
    ImportFrom(
      module='dataclasses',
      names=[
        alias(name='dataclass'),
        alias(name='asdict')],
      level=0),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Dict'),
        alias(name='Any')],
      level=0),
    ImportFrom(
      module='models',
      names=[
        alias(name='ReasoningMode')],
      level=0),
    ClassDef(
      name='RoutingBias',
      body=[
        AnnAssign(
          target=Name(id='prefers_anthropic', ctx=Store()),
          annotation=Name(id='bool', ctx=Load()),
          value=Constant(value=False),
          simple=1),
        AnnAssign(
          target=Name(id='prefers_openai', ctx=Store()),
          annotation=Name(id='bool', ctx=Load()),
          value=Constant(value=True),
          simple=1),
        AnnAssign(
          target=Name(id='prefers_fast_models', ctx=Store()),
          annotation=Name(id='bool', ctx=Load()),
          value=Constant(value=False),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='PlanningBias',
      body=[
        AnnAssign(
          target=Name(id='reasoning_mode_hint', ctx=Store()),
          annotation=Name(id='ReasoningMode', ctx=Load()),
          value=Attribute(
            value=Name(id='ReasoningMode', ctx=Load()),
            attr='COT',
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='conservative_planning', ctx=Store()),
          annotation=Name(id='bool', ctx=Load()),
          value=Constant(value=False),
          simple=1),
        AnnAssign(
          target=Name(id='exploratory_planning', ctx=Store()),
          annotation=Name(id='bool', ctx=Load()),
          value=Constant(value=True),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='QABias',
      body=[
        AnnAssign(
          target=Name(id='extra_qa_passes', ctx=Store()),
          annotation=Name(id='bool', ctx=Load()),
          value=Constant(value=False),
          simple=1),
        AnnAssign(
          target=Name(id='reinforce_strictness', ctx=Store()),
          annotation=Name(id='bool', ctx=Load()),
          value=Constant(value=False),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='SafetyBias',
      body=[
        AnnAssign(
          target=Name(id='elevated_caution', ctx=Store()),
          annotation=Name(id='bool', ctx=Load()),
          value=Constant(value=False),
          simple=1),
        AnnAssign(
          target=Name(id='hil_preferred', ctx=Store()),
          annotation=Name(id='bool', ctx=Load()),
          value=Constant(value=False),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='MetaProfile',
      body=[
        Expr(
          value=Constant(value='\n    Full meta-profile state for the system (in-memory, mutable).\n\n    This is a long-lived object that accumulates rolling statistics\n    across workflows; snapshots are created per workflow.\n    ')),
        AnnAssign(
          target=Name(id='active_profile_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          value=Constant(value='RESUME_HIGH_QUALITY'),
          simple=1),
        AnnAssign(
          target=Name(id='routing_bias', ctx=Store()),
          annotation=Name(id='RoutingBias', ctx=Load()),
          value=Call(
            func=Name(id='RoutingBias', ctx=Load())),
          simple=1),
        AnnAssign(
          target=Name(id='planning_bias', ctx=Store()),
          annotation=Name(id='PlanningBias', ctx=Load()),
          value=Call(
            func=Name(id='PlanningBias', ctx=Load())),
          simple=1),
        AnnAssign(
          target=Name(id='qa_bias', ctx=Store()),
          annotation=Name(id='QABias', ctx=Load()),
          value=Call(
            func=Name(id='QABias', ctx=Load())),
          simple=1),
        AnnAssign(
          target=Name(id='safety_bias', ctx=Store()),
          annotation=Name(id='SafetyBias', ctx=Load()),
          value=Call(
            func=Name(id='SafetyBias', ctx=Load())),
          simple=1),
        AnnAssign(
          target=Name(id='qa_total_last_10', ctx=Store()),
          annotation=Name(id='int', ctx=Load()),
          value=Constant(value=0),
          simple=1),
        AnnAssign(
          target=Name(id='qa_failures_last_10', ctx=Store()),
          annotation=Name(id='int', ctx=Load()),
          value=Constant(value=0),
          simple=1),
        AnnAssign(
          target=Name(id='corrections_total_last_10', ctx=Store()),
          annotation=Name(id='int', ctx=Load()),
          value=Constant(value=0),
          simple=1),
        AnnAssign(
          target=Name(id='corrections_applied_last_10', ctx=Store()),
          annotation=Name(id='int', ctx=Load()),
          value=Constant(value=0),
          simple=1),
        FunctionDef(
          name='qa_failure_rate',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            If(
              test=Compare(
                left=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='qa_total_last_10',
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value=0)]),
              body=[
                Return(
                  value=Constant(value=0.0))]),
            Return(
              value=BinOp(
                left=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='qa_failures_last_10',
                  ctx=Load()),
                op=Div(),
                right=Call(
                  func=Name(id='float', ctx=Load()),
                  args=[
                    Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='qa_total_last_10',
                      ctx=Load())])))],
          returns=Name(id='float', ctx=Load())),
        FunctionDef(
          name='correction_apply_rate',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            If(
              test=Compare(
                left=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='corrections_total_last_10',
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value=0)]),
              body=[
                Return(
                  value=Constant(value=0.0))]),
            Return(
              value=BinOp(
                left=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='corrections_applied_last_10',
                  ctx=Load()),
                op=Div(),
                right=Call(
                  func=Name(id='float', ctx=Load()),
                  args=[
                    Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='corrections_total_last_10',
                      ctx=Load())])))],
          returns=Name(id='float', ctx=Load()))],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='MetaProfileSnapshot',
      body=[
        Expr(
          value=Constant(value='\n    Read-only snapshot of the MetaProfile, passed into ExecutionContext\n    and used by routing, L1, cognitive agents, etc.\n\n    Existing v10_10 callsites expect:\n        • prefers_anthropic / prefers_openai\n        • prefers_fast_models\n        • reasoning_mode_hint (string)\n        • qa_failure_rate_last_10\n        • correction_rate_last_10\n        • extra_qa_passes / reinforce_strictness\n        • elevated_caution / hil_preferred\n    ')),
        AnnAssign(
          target=Name(id='active_profile_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='prefers_anthropic', ctx=Store()),
          annotation=Name(id='bool', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='prefers_openai', ctx=Store()),
          annotation=Name(id='bool', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='prefers_fast_models', ctx=Store()),
          annotation=Name(id='bool', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='reasoning_mode_hint', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='qa_failure_rate_last_10', ctx=Store()),
          annotation=Name(id='float', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='correction_rate_last_10', ctx=Store()),
          annotation=Name(id='float', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='extra_qa_passes', ctx=Store()),
          annotation=Name(id='bool', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='reinforce_strictness', ctx=Store()),
          annotation=Name(id='bool', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='elevated_caution', ctx=Store()),
          annotation=Name(id='bool', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='hil_preferred', ctx=Store()),
          annotation=Name(id='bool', ctx=Load()),
          simple=1)],
      decorator_list=[
        Call(
          func=Name(id='dataclass', ctx=Load()),
          keywords=[
            keyword(
              arg='frozen',
              value=Constant(value=True))])]),
    ClassDef(
      name='MetaProfileUpdater',
      body=[
        Expr(
          value=Constant(value='\n    Handles mutation of MetaProfile and snapshot extraction.\n    ')),
        FunctionDef(
          name='__init__',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='profile',
                  ctx=Store())],
              value=Call(
                func=Name(id='MetaProfile', ctx=Load())))],
          returns=Constant(value=None)),
        FunctionDef(
          name='snapshot',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Assign(
              targets=[
                Name(id='p', ctx=Store())],
              value=Attribute(
                value=Name(id='self', ctx=Load()),
                attr='profile',
                ctx=Load())),
            Return(
              value=Call(
                func=Name(id='MetaProfileSnapshot', ctx=Load()),
                keywords=[
                  keyword(
                    arg='active_profile_id',
                    value=Attribute(
                      value=Name(id='p', ctx=Load()),
                      attr='active_profile_id',
                      ctx=Load())),
                  keyword(
                    arg='prefers_anthropic',
                    value=Attribute(
                      value=Attribute(
                        value=Name(id='p', ctx=Load()),
                        attr='routing_bias',
                        ctx=Load()),
                      attr='prefers_anthropic',
                      ctx=Load())),
                  keyword(
                    arg='prefers_openai',
                    value=Attribute(
                      value=Attribute(
                        value=Name(id='p', ctx=Load()),
                        attr='routing_bias',
                        ctx=Load()),
                      attr='prefers_openai',
                      ctx=Load())),
                  keyword(
                    arg='prefers_fast_models',
                    value=Attribute(
                      value=Attribute(
                        value=Name(id='p', ctx=Load()),
                        attr='routing_bias',
                        ctx=Load()),
                      attr='prefers_fast_models',
                      ctx=Load())),
                  keyword(
                    arg='reasoning_mode_hint',
                    value=Attribute(
                      value=Attribute(
                        value=Attribute(
                          value=Name(id='p', ctx=Load()),
                          attr='planning_bias',
                          ctx=Load()),
                        attr='reasoning_mode_hint',
                        ctx=Load()),
                      attr='value',
                      ctx=Load())),
                  keyword(
                    arg='qa_failure_rate_last_10',
                    value=Call(
                      func=Attribute(
                        value=Name(id='p', ctx=Load()),
                        attr='qa_failure_rate',
                        ctx=Load()))),
                  keyword(
                    arg='correction_rate_last_10',
                    value=Call(
                      func=Attribute(
                        value=Name(id='p', ctx=Load()),
                        attr='correction_apply_rate',
                        ctx=Load()))),
                  keyword(
                    arg='extra_qa_passes',
                    value=Attribute(
                      value=Attribute(
                        value=Name(id='p', ctx=Load()),
                        attr='qa_bias',
                        ctx=Load()),
                      attr='extra_qa_passes',
                      ctx=Load())),
                  keyword(
                    arg='reinforce_strictness',
                    value=Attribute(
                      value=Attribute(
                        value=Name(id='p', ctx=Load()),
                        attr='qa_bias',
                        ctx=Load()),
                      attr='reinforce_strictness',
                      ctx=Load())),
                  keyword(
                    arg='elevated_caution',
                    value=Attribute(
                      value=Attribute(
                        value=Name(id='p', ctx=Load()),
                        attr='safety_bias',
                        ctx=Load()),
                      attr='elevated_caution',
                      ctx=Load())),
                  keyword(
                    arg='hil_preferred',
                    value=Attribute(
                      value=Attribute(
                        value=Name(id='p', ctx=Load()),
                        attr='safety_bias',
                        ctx=Load()),
                      attr='hil_preferred',
                      ctx=Load()))]))],
          returns=Name(id='MetaProfileSnapshot', ctx=Load())),
        FunctionDef(
          name='set_active_profile',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='profile_id',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Assign(
              targets=[
                Attribute(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='profile',
                    ctx=Load()),
                  attr='active_profile_id',
                  ctx=Store())],
              value=Name(id='profile_id', ctx=Load()))],
          returns=Constant(value=None)),
        FunctionDef(
          name='register_qa_outcome',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='success',
                annotation=Name(id='bool', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Update QA rolling stats and QA/Safety bias hints.\n        ')),
            Assign(
              targets=[
                Name(id='p', ctx=Store())],
              value=Attribute(
                value=Name(id='self', ctx=Load()),
                attr='profile',
                ctx=Load())),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='p', ctx=Load()),
                  attr='qa_total_last_10',
                  ctx=Store())],
              value=Call(
                func=Name(id='min', ctx=Load()),
                args=[
                  Constant(value=10),
                  BinOp(
                    left=Attribute(
                      value=Name(id='p', ctx=Load()),
                      attr='qa_total_last_10',
                      ctx=Load()),
                    op=Add(),
                    right=Constant(value=1))])),
            If(
              test=UnaryOp(
                op=Not(),
                operand=Name(id='success', ctx=Load())),
              body=[
                Assign(
                  targets=[
                    Attribute(
                      value=Name(id='p', ctx=Load()),
                      attr='qa_failures_last_10',
                      ctx=Store())],
                  value=Call(
                    func=Name(id='min', ctx=Load()),
                    args=[
                      Constant(value=10),
                      BinOp(
                        left=Attribute(
                          value=Name(id='p', ctx=Load()),
                          attr='qa_failures_last_10',
                          ctx=Load()),
                        op=Add(),
                        right=Constant(value=1))]))]),
            If(
              test=Compare(
                left=Call(
                  func=Attribute(
                    value=Name(id='p', ctx=Load()),
                    attr='qa_failure_rate',
                    ctx=Load())),
                ops=[
                  Gt()],
                comparators=[
                  Constant(value=0.3)]),
              body=[
                Assign(
                  targets=[
                    Attribute(
                      value=Attribute(
                        value=Name(id='p', ctx=Load()),
                        attr='qa_bias',
                        ctx=Load()),
                      attr='extra_qa_passes',
                      ctx=Store())],
                  value=Constant(value=True)),
                Assign(
                  targets=[
                    Attribute(
                      value=Attribute(
                        value=Name(id='p', ctx=Load()),
                        attr='qa_bias',
                        ctx=Load()),
                      attr='reinforce_strictness',
                      ctx=Store())],
                  value=Constant(value=True)),
                Assign(
                  targets=[
                    Attribute(
                      value=Attribute(
                        value=Name(id='p', ctx=Load()),
                        attr='safety_bias',
                        ctx=Load()),
                      attr='elevated_caution',
                      ctx=Store())],
                  value=Constant(value=True))],
              orelse=[
                Assign(
                  targets=[
                    Attribute(
                      value=Attribute(
                        value=Name(id='p', ctx=Load()),
                        attr='qa_bias',
                        ctx=Load()),
                      attr='extra_qa_passes',
                      ctx=Store())],
                  value=Constant(value=False)),
                Assign(
                  targets=[
                    Attribute(
                      value=Attribute(
                        value=Name(id='p', ctx=Load()),
                        attr='qa_bias',
                        ctx=Load()),
                      attr='reinforce_strictness',
                      ctx=Store())],
                  value=Constant(value=False)),
                Assign(
                  targets=[
                    Attribute(
                      value=Attribute(
                        value=Name(id='p', ctx=Load()),
                        attr='safety_bias',
                        ctx=Load()),
                      attr='elevated_caution',
                      ctx=Store())],
                  value=Constant(value=False))])],
          returns=Constant(value=None)),
        FunctionDef(
          name='register_correction',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='applied',
                annotation=Name(id='bool', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Update correction stats and bias toward more conservative planning.\n        ')),
            Assign(
              targets=[
                Name(id='p', ctx=Store())],
              value=Attribute(
                value=Name(id='self', ctx=Load()),
                attr='profile',
                ctx=Load())),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='p', ctx=Load()),
                  attr='corrections_total_last_10',
                  ctx=Store())],
              value=Call(
                func=Name(id='min', ctx=Load()),
                args=[
                  Constant(value=10),
                  BinOp(
                    left=Attribute(
                      value=Name(id='p', ctx=Load()),
                      attr='corrections_total_last_10',
                      ctx=Load()),
                    op=Add(),
                    right=Constant(value=1))])),
            If(
              test=Name(id='applied', ctx=Load()),
              body=[
                Assign(
                  targets=[
                    Attribute(
                      value=Name(id='p', ctx=Load()),
                      attr='corrections_applied_last_10',
                      ctx=Store())],
                  value=Call(
                    func=Name(id='min', ctx=Load()),
                    args=[
                      Constant(value=10),
                      BinOp(
                        left=Attribute(
                          value=Name(id='p', ctx=Load()),
                          attr='corrections_applied_last_10',
                          ctx=Load()),
                        op=Add(),
                        right=Constant(value=1))]))]),
            If(
              test=Compare(
                left=Call(
                  func=Attribute(
                    value=Name(id='p', ctx=Load()),
                    attr='correction_apply_rate',
                    ctx=Load())),
                ops=[
                  Gt()],
                comparators=[
                  Constant(value=0.3)]),
              body=[
                Assign(
                  targets=[
                    Attribute(
                      value=Attribute(
                        value=Name(id='p', ctx=Load()),
                        attr='planning_bias',
                        ctx=Load()),
                      attr='conservative_planning',
                      ctx=Store())],
                  value=Constant(value=True)),
                Assign(
                  targets=[
                    Attribute(
                      value=Attribute(
                        value=Name(id='p', ctx=Load()),
                        attr='planning_bias',
                        ctx=Load()),
                      attr='exploratory_planning',
                      ctx=Store())],
                  value=Constant(value=False))],
              orelse=[
                Assign(
                  targets=[
                    Attribute(
                      value=Attribute(
                        value=Name(id='p', ctx=Load()),
                        attr='planning_bias',
                        ctx=Load()),
                      attr='conservative_planning',
                      ctx=Store())],
                  value=Constant(value=False))])],
          returns=Constant(value=None)),
        FunctionDef(
          name='register_provider_choice',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='provider',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Update routing bias based on provider choices.\n        ')),
            Assign(
              targets=[
                Name(id='p', ctx=Store())],
              value=Attribute(
                value=Name(id='self', ctx=Load()),
                attr='profile',
                ctx=Load())),
            Assign(
              targets=[
                Name(id='provider', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=BoolOp(
                    op=Or(),
                    values=[
                      Name(id='provider', ctx=Load()),
                      Constant(value='')]),
                  attr='lower',
                  ctx=Load()))),
            If(
              test=Call(
                func=Attribute(
                  value=Name(id='provider', ctx=Load()),
                  attr='startswith',
                  ctx=Load()),
                args=[
                  Constant(value='anthropic')]),
              body=[
                Assign(
                  targets=[
                    Attribute(
                      value=Attribute(
                        value=Name(id='p', ctx=Load()),
                        attr='routing_bias',
                        ctx=Load()),
                      attr='prefers_anthropic',
                      ctx=Store())],
                  value=Constant(value=True)),
                Assign(
                  targets=[
                    Attribute(
                      value=Attribute(
                        value=Name(id='p', ctx=Load()),
                        attr='routing_bias',
                        ctx=Load()),
                      attr='prefers_openai',
                      ctx=Store())],
                  value=Constant(value=False))],
              orelse=[
                If(
                  test=Call(
                    func=Attribute(
                      value=Name(id='provider', ctx=Load()),
                      attr='startswith',
                      ctx=Load()),
                    args=[
                      Constant(value='openai')]),
                  body=[
                    Assign(
                      targets=[
                        Attribute(
                          value=Attribute(
                            value=Name(id='p', ctx=Load()),
                            attr='routing_bias',
                            ctx=Load()),
                          attr='prefers_openai',
                          ctx=Store())],
                      value=Constant(value=True)),
                    Assign(
                      targets=[
                        Attribute(
                          value=Attribute(
                            value=Name(id='p', ctx=Load()),
                            attr='routing_bias',
                            ctx=Load()),
                          attr='prefers_anthropic',
                          ctx=Store())],
                      value=Constant(value=False))])])],
          returns=Constant(value=None)),
        FunctionDef(
          name='register_fast_model_usage',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='used_fast',
                annotation=Name(id='bool', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Update routing bias based on whether "fast" models were used.\n        ')),
            Assign(
              targets=[
                Name(id='p', ctx=Store())],
              value=Attribute(
                value=Name(id='self', ctx=Load()),
                attr='profile',
                ctx=Load())),
            If(
              test=Name(id='used_fast', ctx=Load()),
              body=[
                Assign(
                  targets=[
                    Attribute(
                      value=Attribute(
                        value=Name(id='p', ctx=Load()),
                        attr='routing_bias',
                        ctx=Load()),
                      attr='prefers_fast_models',
                      ctx=Store())],
                  value=Constant(value=True))])],
          returns=Constant(value=None))]),
    Assign(
      targets=[
        Name(id='_META_UPDATER', ctx=Store())],
      value=Call(
        func=Name(id='MetaProfileUpdater', ctx=Load()))),
    FunctionDef(
      name='get_meta_profile_snapshot',
      args=arguments(),
      body=[
        Expr(
          value=Constant(value='\n    Return a read-only snapshot of the current MetaProfile.\n    ')),
        Return(
          value=Call(
            func=Attribute(
              value=Name(id='_META_UPDATER', ctx=Load()),
              attr='snapshot',
              ctx=Load())))],
      returns=Name(id='MetaProfileSnapshot', ctx=Load())),
    FunctionDef(
      name='get_routing_bias',
      args=arguments(),
      body=[
        Return(
          value=Call(
            func=Name(id='asdict', ctx=Load()),
            args=[
              Attribute(
                value=Attribute(
                  value=Name(id='_META_UPDATER', ctx=Load()),
                  attr='profile',
                  ctx=Load()),
                attr='routing_bias',
                ctx=Load())]))],
      returns=Subscript(
        value=Name(id='Dict', ctx=Load()),
        slice=Tuple(
          elts=[
