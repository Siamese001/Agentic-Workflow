          arg(
            arg='profile_id',
            annotation=Name(id='str', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Return a validated ExecutionProfileSpec by ID.\n    Raises KeyError for unknown profiles.\n    ')),
        If(
          test=Compare(
            left=Name(id='profile_id', ctx=Load()),
            ops=[
              NotIn()],
            comparators=[
              Name(id='EXECUTION_PROFILES', ctx=Load())]),
          body=[
            Raise(
              exc=Call(
                func=Name(id='KeyError', ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='Unknown execution profile: '),
                      FormattedValue(
                        value=Name(id='profile_id', ctx=Load()),
                        conversion=-1)])]))]),
        Return(
          value=Subscript(
            value=Name(id='EXECUTION_PROFILES', ctx=Load()),
            slice=Name(id='profile_id', ctx=Load()),
            ctx=Load()))],
      returns=Name(id='ExecutionProfileSpec', ctx=Load()))])