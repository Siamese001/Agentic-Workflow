Module(
  body=[
    Expr(
      value=Constant(value="\nSafety Enforcement Layer · L5 (v10_10 · Phase 3)\n================================================\n\nResponsibilities:\n    • Enforce SafetyPolicy (PII, disallowed content, category violations).\n    • Consume:\n          – SafetyResult (from L2's ConstitutionalSafetyAgent)\n          – CouncilVote (from QA → deterministic heuristic)\n    • Produce:\n          – PolicyDecisionEvent (typed enforcement result)\n    • Emit safety audit events (G19–G23).\n    • Must NOT:\n          – call LLMs,\n          – mutate WorkflowState directly (L4-only),\n          – modify plans (L1/L3),\n          – perform retrieval/drafting/QA.\n\nPure decision + audit layer.\n")),
    ImportFrom(
      module='__future__',
      names=[
        alias(name='annotations')],
      level=0),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Optional'),
        alias(name='List')],
      level=0),
    ImportFrom(
      module='models',
      names=[
        alias(name='SafetyResult'),
        alias(name='SafetyFinding'),
        alias(name='CouncilVote'),
        alias(name='PolicyDecisionEvent'),
        alias(name='SafetyEnforcementVerdict'),
        alias(name='SafetyPolicy'),
        alias(name='ExecutionContext')],
      level=0),
    ImportFrom(
      module='observability',
      names=[
        alias(name='start_span'),
        alias(name='end_span'),
        alias(name='log_exception')],
      level=0),
    FunctionDef(
      name='_combine_findings',
      args=arguments(
        args=[
          arg(
            arg='safety_result',
            annotation=Name(id='SafetyResult', ctx=Load())),
          arg(
            arg='council_vote',
            annotation=Name(id='CouncilVote', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Merge LLM-based SafetyResult findings with structural QA-derived signals.\n    Downstream: deterministic final enforcement in L5.\n    ')),
        Assign(
          targets=[
            Name(id='findings', ctx=Store())],
          value=Call(
            func=Name(id='list', ctx=Load()),
            args=[
              BoolOp(
                op=Or(),
                values=[
                  Call(
                    func=Name(id='getattr', ctx=Load()),
                    args=[
                      Name(id='safety_result', ctx=Load()),
                      Constant(value='findings'),
                      List(ctx=Load())]),
                  List(ctx=Load())])])),
        If(
          test=Compare(
            left=Call(
              func=Name(id='getattr', ctx=Load()),
              args=[
                Name(id='council_vote', ctx=Load()),
                Constant(value='selected_id'),
                Constant(value='')]),
            ops=[
              Eq()],
            comparators=[
              Constant(value='block')]),
          body=[
            Assign(
              targets=[
                Name(id='synthetic', ctx=Store())],
              value=Call(
                func=Name(id='SafetyFinding', ctx=Load()),
                keywords=[
                  keyword(
                    arg='id',
                    value=Constant(value='council_block')),
                  keyword(
                    arg='text',
                    value=Constant(value='QA council voted BLOCK')),
                  keyword(
                    arg='severity',
                    value=Constant(value='high')),
                  keyword(
                    arg='category',
                    value=Constant(value='council'))])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='findings', ctx=Load()),
                  attr='append',
                  ctx=Load()),
                args=[
                  Name(id='synthetic', ctx=Load())]))]),
        Return(
          value=Name(id='findings', ctx=Load()))],
      returns=Subscript(
        value=Name(id='List', ctx=Load()),
        slice=Name(id='SafetyFinding', ctx=Load()),
        ctx=Load())),
    FunctionDef(
      name='_decide_verdict',
      args=arguments(
        args=[
          arg(
            arg='findings',
            annotation=Subscript(
              value=Name(id='List', ctx=Load()),
              slice=Name(id='SafetyFinding', ctx=Load()),
              ctx=Load())),
          arg(
            arg='policy',
            annotation=Name(id='SafetyPolicy', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Determine final SafetyEnforcementVerdict according to the SafetyPolicy.\n\n    Policy logic:\n        • If allow_generation = False → always BLOCK.\n        • If any high-severity finding contradicts policy.disallowed_categories → BLOCK.\n        • If PII is detected and policy.allow_pii = False → BLOCK.\n        • If only medium-severity → WARN.\n        • Otherwise → PASS.\n    ')),
        If(
          test=UnaryOp(
            op=Not(),
            operand=Call(
              func=Name(id='getattr', ctx=Load()),
              args=[
                Name(id='policy', ctx=Load()),
                Constant(value='allow_generation'),
                Constant(value=True)])),
          body=[
            Return(
              value=Call(
                func=Name(id='SafetyEnforcementVerdict', ctx=Load()),
                keywords=[
                  keyword(
                    arg='verdict',
                    value=Constant(value='block')),
                  keyword(
                    arg='reason',
                    value=Constant(value='policy_prohibits_generation'))]))]),
        Assign(
          targets=[
            Name(id='disallowed', ctx=Store())],
          value=Call(
            func=Name(id='set', ctx=Load()),
            args=[
              BoolOp(
                op=Or(),
                values=[
                  Call(
                    func=Name(id='getattr', ctx=Load()),
                    args=[
                      Name(id='policy', ctx=Load()),
                      Constant(value='disallowed_categories'),
                      List(ctx=Load())]),
                  List(ctx=Load())])])),
        Assign(
          targets=[
            Name(id='allow_pii', ctx=Store())],
          value=Call(
            func=Name(id='getattr', ctx=Load()),
            args=[
              Name(id='policy', ctx=Load()),
              Constant(value='allow_pii'),
              Constant(value=True)])),
        Assign(
          targets=[
            Name(id='has_high', ctx=Store())],
          value=Constant(value=False)),
        Assign(
          targets=[
            Name(id='has_medium', ctx=Store())],
          value=Constant(value=False)),
        For(
          target=Name(id='f', ctx=Store()),
          iter=Name(id='findings', ctx=Load()),
          body=[
            Assign(
              targets=[
                Name(id='severity', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=BoolOp(
                    op=Or(),
                    values=[
                      Call(
                        func=Name(id='getattr', ctx=Load()),
                        args=[
                          Name(id='f', ctx=Load()),
                          Constant(value='severity'),
                          Constant(value='')]),
                      Constant(value='')]),
                  attr='lower',
                  ctx=Load()))),
            Assign(
              targets=[
                Name(id='category', ctx=Store())],
              value=Call(
                func=Name(id='getattr', ctx=Load()),
                args=[
                  Name(id='f', ctx=Load()),
                  Constant(value='category'),
                  Constant(value=None)])),
            If(
              test=Compare(
                left=Name(id='severity', ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value='high')]),
              body=[
                Assign(
                  targets=[
                    Name(id='has_high', ctx=Store())],
                  value=Constant(value=True))]),
            If(
              test=Compare(
                left=Name(id='severity', ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value='medium')]),
              body=[
                Assign(
                  targets=[
                    Name(id='has_medium', ctx=Store())],
                  value=Constant(value=True))]),
            If(
              test=BoolOp(
                op=And(),
                values=[
                  Name(id='category', ctx=Load()),
                  Compare(
                    left=Name(id='category', ctx=Load()),
                    ops=[
                      In()],
                    comparators=[
                      Name(id='disallowed', ctx=Load())])]),
              body=[
                Return(
                  value=Call(
                    func=Name(id='SafetyEnforcementVerdict', ctx=Load()),
                    keywords=[
                      keyword(
                        arg='verdict',
                        value=Constant(value='block')),
                      keyword(
                        arg='reason',
                        value=JoinedStr(
                          values=[
                            Constant(value='disallowed_category:'),
                            FormattedValue(
                              value=Name(id='category', ctx=Load()),
                              conversion=-1)]))]))]),
            If(
              test=BoolOp(
                op=And(),
                values=[
                  Compare(
                    left=Name(id='category', ctx=Load()),
                    ops=[
                      Eq()],
                    comparators=[
                      Constant(value='pii')]),
                  UnaryOp(
                    op=Not(),
                    operand=Name(id='allow_pii', ctx=Load()))]),
              body=[
                Return(
                  value=Call(
                    func=Name(id='SafetyEnforcementVerdict', ctx=Load()),
                    keywords=[
                      keyword(
                        arg='verdict',
                        value=Constant(value='block')),
                      keyword(
                        arg='reason',
                        value=Constant(value='pii_disallowed'))]))])]),
        If(
          test=Name(id='has_high', ctx=Load()),
          body=[
            Return(
              value=Call(
                func=Name(id='SafetyEnforcementVerdict', ctx=Load()),
                keywords=[
                  keyword(
                    arg='verdict',
                    value=Constant(value='block')),
                  keyword(
                    arg='reason',
                    value=Constant(value='high_severity_findings'))]))]),
        If(
          test=Name(id='has_medium', ctx=Load()),
          body=[
            Return(
              value=Call(
                func=Name(id='SafetyEnforcementVerdict', ctx=Load()),
                keywords=[
                  keyword(
                    arg='verdict',
                    value=Constant(value='warn')),
                  keyword(
                    arg='reason',
                    value=Constant(value='medium_severity_findings'))]))]),
        Return(
          value=Call(
            func=Name(id='SafetyEnforcementVerdict', ctx=Load()),
            keywords=[
              keyword(
                arg='verdict',
                value=Constant(value='pass')),
              keyword(
                arg='reason',
                value=Constant(value='no_violations'))]))],
      returns=Name(id='SafetyEnforcementVerdict', ctx=Load())),
    FunctionDef(
      name='run_l5',
      args=arguments(
        args=[
          arg(
            arg='safety_result',
            annotation=Name(id='SafetyResult', ctx=Load())),
          arg(
            arg='council_vote',
            annotation=Name(id='CouncilVote', ctx=Load())),
          arg(
            arg='policy',
            annotation=Name(id='SafetyPolicy', ctx=Load())),
          arg(
            arg='ctx',
            annotation=Subscript(
              value=Name(id='Optional', ctx=Load()),
              slice=Name(id='ExecutionContext', ctx=Load()),
              ctx=Load()))],
        defaults=[
          Constant(value=None)]),
      body=[
        Expr(
          value=Constant(value='\n    Compute the final L5 enforcement decision:\n\n        INPUTS:\n            • SafetyResult  (LLM-based detection)\n            • CouncilVote   (heuristic QA-derived)\n            • SafetyPolicy  (Phase-3 policy registry)\n            • ctx           (ExecutionContext for telemetry)\n\n        OUTPUT:\n            • PolicyDecisionEvent\n    ')),
        Assign(
          targets=[
            Name(id='span', ctx=Store())],
          value=Call(
            func=Name(id='start_span', ctx=Load()),
            args=[
              Constant(value='l5.run')],
            keywords=[
              keyword(
                arg='ctx',
                value=IfExp(
                  test=Name(id='ctx', ctx=Load()),
                  body=Call(
                    func=Attribute(
                      value=Name(id='ctx', ctx=Load()),
                      attr='span_context',
                      ctx=Load())),
                  orelse=Constant(value=None)))])),
        Try(
          body=[
            Assign(
              targets=[
                Name(id='findings', ctx=Store())],
              value=Call(
                func=Name(id='_combine_findings', ctx=Load()),
                args=[
                  Name(id='safety_result', ctx=Load()),
                  Name(id='council_vote', ctx=Load())])),
            Assign(
              targets=[
                Name(id='verdict', ctx=Store())],
              value=Call(
                func=Name(id='_decide_verdict', ctx=Load()),
                args=[
                  Name(id='findings', ctx=Load()),
                  Name(id='policy', ctx=Load())])),
            Return(
              value=Call(
                func=Name(id='PolicyDecisionEvent', ctx=Load()),
                keywords=[
                  keyword(
                    arg='verdict',
                    value=Attribute(
                      value=Name(id='verdict', ctx=Load()),
                      attr='verdict',
                      ctx=Load())),
                  keyword(
                    arg='reason',
                    value=Attribute(
                      value=Name(id='verdict', ctx=Load()),
                      attr='reason',
                      ctx=Load())),
                  keyword(
                    arg='findings',
                    value=Name(id='findings', ctx=Load()))]))],
          handlers=[
            ExceptHandler(
              type=Name(id='Exception', ctx=Load()),
              name='exc',
              body=[
                Expr(
                  value=Call(
                    func=Name(id='log_exception', ctx=Load()),
                    args=[
                      Constant(value='l5.enforcement_error'),
                      Name(id='exc', ctx=Load())])),
                Return(
                  value=Call(
                    func=Name(id='PolicyDecisionEvent', ctx=Load()),
                    keywords=[
                      keyword(
                        arg='verdict',
                        value=Constant(value='pass')),
                      keyword(
                        arg='reason',
                        value=Constant(value='safety_enforcement_exception')),
                      keyword(
                        arg='findings',
                        value=List(ctx=Load()))]))])],
          finalbody=[
            Expr(
              value=Call(
                func=Name(id='end_span', ctx=Load()),
                args=[
                  Name(id='span', ctx=Load())]))])],
      returns=Name(id='PolicyDecisionEvent', ctx=Load()))])