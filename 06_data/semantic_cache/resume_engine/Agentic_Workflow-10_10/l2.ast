                      value=Attribute(
                        value=Name(id='ctx', ctx=Load()),
                        attr='resume',
                        ctx=Load())),
                    keyword(
                      arg='config',
                      value=Attribute(
                        value=Name(id='ctx', ctx=Load()),
                        attr='config',
                        ctx=Load()))]))),
            Assign(
              targets=[
                Name(id='reasoning_text', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=BoolOp(
                    op=Or(),
                    values=[
                      Name(id='reasoning_text', ctx=Load()),
                      Constant(value='')]),
                  attr='strip',
                  ctx=Load()))),
            If(
              test=UnaryOp(
                op=Not(),
                operand=Name(id='reasoning_text', ctx=Load())),
              body=[
