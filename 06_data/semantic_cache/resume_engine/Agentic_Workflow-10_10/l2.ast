                    value=Constant(value='rag_reasoning')),
                  keyword(
                    arg='metadata',
                    value=Dict(
                      keys=[
                        Constant(value='layer'),
                        Constant(value='agent')],
                      values=[
                        Constant(value='L2'),
                        Constant(value='rag_reasoning')]))])),
            Return(
              value=Call(
                func=Name(id='RAGResult', ctx=Load()),
                keywords=[
