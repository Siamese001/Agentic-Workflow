                      ctx=Load())),
                  keyword(
                    arg='sandbox',
                    value=Attribute(
                      value=Name(id='ctx', ctx=Load()),
                      attr='sandbox_config',
                      ctx=Load())),
                  keyword(
                    arg='meta_profile',
                    value=Attribute(
                      value=Name(id='ctx', ctx=Load()),
                      attr='meta_profile_snapshot',
                      ctx=Load()))])),
            Assign(
              targets=[
                Name(id='reasoning_text', ctx=Store())],
              value=Await(
                value=Call(
                  func=Attribute(
                    value=Name(id='agent', ctx=Load()),
                    attr='run_rag_reasoning',
                    ctx=Load()),
                  keywords=[
                    keyword(
                      arg='prompt',
                      value=Name(id='prompt', ctx=Load())),
                    keyword(
