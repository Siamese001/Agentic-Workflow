            annotation=Name(id='WorkflowPlanBundle', ctx=Load())),
          arg(
            arg='ctx',
            annotation=Name(id='ExecutionContext', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Execute all L2 stages for the workflow:\n\n        • Strategy\n        • Retrieval\n        • RAG reasoning\n        • Drafting\n        • QA (+ council heuristic)\n        • Safety\n\n    With concurrency:\n        • Strategy + Retrieval in parallel.\n        • RAG reasoning → Drafting → QA → Safety sequentially.\n    ')),
        Assign(
          targets=[
            Name(id='span', ctx=Store())],
          value=Call(
            func=Name(id='start_span', ctx=Load()),
            args=[
              Constant(value='l2.run')],
            keywords=[
              keyword(
                arg='ctx',
                value=Call(
                  func=Attribute(
                    value=Name(id='ctx', ctx=Load()),
                    attr='span_context',
                    ctx=Load())))])),
        Try(
          body=[
            Assign(
              targets=[
                Name(id='strategy_task', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='asyncio', ctx=Load()),
                  attr='create_task',
                  ctx=Load()),
                args=[
                  Call(
                    func=Name(id='_execute_strategy', ctx=Load()),
                    args=[
                      Name(id='plans', ctx=Load()),
                      Name(id='ctx', ctx=Load())])])),
            Assign(
              targets=[
                Name(id='rag_task', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='asyncio', ctx=Load()),
                  attr='create_task',
                  ctx=Load()),
                args=[
                  Call(
                    func=Name(id='_execute_retrieval', ctx=Load()),
                    args=[
                      Name(id='plans', ctx=Load()),
                      Name(id='ctx', ctx=Load())])])),
            Assign(
              targets=[
                Tuple(
                  elts=[
                    Name(id='strategy_result', ctx=Store()),
                    Name(id='rag_result', ctx=Store())],
                  ctx=Store())],
              value=Await(
                value=Call(
                  func=Attribute(
                    value=Name(id='asyncio', ctx=Load()),
                    attr='gather',
                    ctx=Load()),
                  args=[
                    Name(id='strategy_task', ctx=Load()),
                    Name(id='rag_task', ctx=Load())]))),
            Assign(
              targets=[
                Name(id='rag_result', ctx=Store())],
              value=Await(
                value=Call(
                  func=Name(id='_execute_rag_reasoning', ctx=Load()),
                  args=[
                    Name(id='plans', ctx=Load()),
                    Name(id='rag_result', ctx=Load()),
                    Name(id='ctx', ctx=Load())]))),
            Assign(
              targets=[
                Name(id='drafting_result', ctx=Store())],
              value=Await(
                value=Call(
                  func=Name(id='_execute_drafting', ctx=Load()),
                  args=[
                    Name(id='plans', ctx=Load()),
                    Name(id='strategy_result', ctx=Load()),
                    Name(id='rag_result', ctx=Load()),
                    Name(id='ctx', ctx=Load())]))),
            Assign(
              targets=[
