                  func=Attribute(
                    value=Name(id='ctx', ctx=Load()),
                    attr='span_context',
                    ctx=Load())))])),
        Try(
          body=[
            AnnAssign(
              target=Name(id='evidence_seq', ctx=Store()),
              annotation=Subscript(
                value=Name(id='Sequence', ctx=Load()),
                slice=Name(id='Evidence', ctx=Load()),
                ctx=Load()),
              value=Call(
                func=Name(id='list', ctx=Load()),
                args=[
                  BoolOp(
                    op=Or(),
                    values=[
                      Attribute(
                        value=Name(id='rag_result', ctx=Load()),
                        attr='evidence',
                        ctx=Load()),
                      List(ctx=Load())])]),
              simple=1),
            If(
              test=UnaryOp(
                op=Not(),
                operand=Name(id='evidence_seq', ctx=Load())),
              body=[
                Return(
                  value=Name(id='rag_result', ctx=Load()))]),
            AnnAssign(
              target=Name(id='rag_plan', ctx=Store()),
              annotation=Subscript(
                value=Name(id='Optional', ctx=Load()),
                slice=Name(id='RAGPlan', ctx=Load()),
                ctx=Load()),
              value=Call(
