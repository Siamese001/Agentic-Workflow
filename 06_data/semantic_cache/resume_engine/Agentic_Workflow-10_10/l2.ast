                  Constant(value='rag'),
                  Constant(value=None)]),
              simple=1),
            Assign(
              targets=[
                Name(id='prompt', ctx=Store())],
              value=Call(
                func=Name(id='build_rag_prompt', ctx=Load()),
                keywords=[
                  keyword(
                    arg='plan',
                    value=Name(id='rag_plan', ctx=Load())),
                  keyword(
                    arg='ctx',
                    value=Name(id='ctx', ctx=Load())),
                  keyword(
                    arg='evidence',
                    value=Name(id='evidence_seq', ctx=Load())),
                  keyword(
                    arg='prompt_id',
                    value=Constant(value='system.rag.reasoning')),
                  keyword(
                    arg='layer',
                    value=Constant(value='L2')),
                  keyword(
                    arg='agent',
                    value=Constant(value='rag')),
                  keyword(
