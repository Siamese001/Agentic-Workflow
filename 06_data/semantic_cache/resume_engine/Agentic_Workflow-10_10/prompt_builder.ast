Module(
  body=[
    Expr(
      value=Constant(value='\nPrompt Builder Layer (v10_10 · Phase 3)\n=======================================\n\nThis module builds PromptInstance objects for all major agents:\n\n    • Strategy reasoning\n    • Retrieval evidence / RAG reasoning\n    • HYDE query expansion\n    • Drafting\n    • QA\n    • Safety\n\nIt:\n\n    • Enforces prompt ACL metadata (layer / agent / model tier).\n    • Routes all prompt construction through the central prompt registry\n      defined in ``prompt_system_v10_10.py`` – no inline templates.\n    • Emits ``PromptInstance`` objects that L2 can hand off to\n      cognitive agents / LLM clients.\n\nDesign constraints:\n\n    • Pure L2: no LLM calls.\n    • Depends only on models + prompt_system for registry/ACL.\n    • No direct provider SDK or routing logic.\n')),
    ImportFrom(
      module='__future__',
      names=[
        alias(name='annotations')],
      level=0),
    ImportFrom(
      module='dataclasses',
      names=[
        alias(name='dataclass')],
      level=0),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Any'),
        alias(name='Dict'),
        alias(name='Iterable'),
        alias(name='List'),
        alias(name='Optional'),
        alias(name='Sequence'),
        alias(name='Tuple')],
      level=0),
    ImportFrom(
      module='models',
      names=[
        alias(name='ContextBudget'),
        alias(name='DraftingPlan'),
        alias(name='DraftingResult'),
        alias(name='Evidence'),
        alias(name='ExecutionContext'),
        alias(name='QAPlan'),
        alias(name='QAResult'),
        alias(name='RAGPlan'),
        alias(name='RAGResult'),
        alias(name='SafetyPlan'),
        alias(name='SafetyResult'),
        alias(name='StrategyPlan'),
        alias(name='StrategyResult'),
        alias(name='WorkflowPlanBundle'),
        alias(name='PromptDefinition'),
        alias(name='PromptVersion')],
      level=0),
    ImportFrom(
      module='prompt_system_v10_10',
      names=[
        alias(name='PROMPT_ACLS'),
        alias(name='PROMPT_REGISTRY'),
        alias(name='PromptACL'),
        alias(name='get_prompt')],
      level=0),
    ClassDef(
      name='PromptEnvelope',
      body=[
        Expr(
          value=Constant(value='\n    Structured container for deterministic prompt assembly.\n\n    Sections map directly to the v10_8 envelope design, with explicit\n    naming so that downstream rendering and logging can reason about\n    each component separately.\n    ')),
        AnnAssign(
          target=Name(id='framing', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          value=Constant(value=''),
          simple=1),
        AnnAssign(
          target=Name(id='context', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          value=Constant(value=''),
          simple=1),
        AnnAssign(
          target=Name(id='reasoning', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          value=Constant(value=''),
          simple=1),
        AnnAssign(
          target=Name(id='instructions', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          value=Constant(value=''),
          simple=1),
        AnnAssign(
          target=Name(id='safety_signals', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          value=Constant(value=''),
          simple=1),
        AnnAssign(
          target=Name(id='output_schema', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          value=Constant(value=''),
          simple=1),
        FunctionDef(
          name='to_sections',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='\n        Return an ordered mapping of envelope sections.\n\n        The order is semantic; callers that render a textual prompt\n        should iterate using SECTION_ORDER.\n        ')),
            Return(
              value=Dict(
                keys=[
                  Constant(value='Framing'),
                  Constant(value='Context'),
                  Constant(value='Reasoning'),
                  Constant(value='Instructions'),
                  Constant(value='Safety Signals'),
                  Constant(value='Output Schema')],
                values=[
                  Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='framing',
                        ctx=Load()),
                      attr='strip',
                      ctx=Load())),
                  Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='context',
                        ctx=Load()),
                      attr='strip',
                      ctx=Load())),
                  Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='reasoning',
                        ctx=Load()),
                      attr='strip',
                      ctx=Load())),
                  Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='instructions',
                        ctx=Load()),
                      attr='strip',
                      ctx=Load())),
                  Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='safety_signals',
                        ctx=Load()),
                      attr='strip',
                      ctx=Load())),
                  Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='output_schema',
                        ctx=Load()),
                      attr='strip',
                      ctx=Load()))]))],
          returns=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='str', ctx=Load())],
              ctx=Load()),
            ctx=Load()))],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    AnnAssign(
      target=Name(id='SECTION_ORDER', ctx=Store()),
      annotation=Subscript(
        value=Name(id='Tuple', ctx=Load()),
        slice=Tuple(
          elts=[
            Name(id='str', ctx=Load()),
            Constant(value=Ellipsis)],
          ctx=Load()),
        ctx=Load()),
      value=Tuple(
        elts=[
          Constant(value='Framing'),
          Constant(value='Context'),
          Constant(value='Reasoning'),
          Constant(value='Instructions'),
          Constant(value='Safety Signals'),
          Constant(value='Output Schema')],
        ctx=Load()),
      simple=1),
    ClassDef(
      name='PromptInstance',
      body=[
        Expr(
          value=Constant(value='\n    Concrete prompt ready for LLM invocation.\n    ')),
        AnnAssign(
          target=Name(id='prompt_id', ctx=Store()),
