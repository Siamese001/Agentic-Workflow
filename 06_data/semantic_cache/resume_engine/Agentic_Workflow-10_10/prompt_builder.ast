    FunctionDef(
      name='build_strategy_prompt',
      args=arguments(
        args=[
          arg(
            arg='plan',
            annotation=Name(id='StrategyPlan', ctx=Load())),
          arg(
            arg='ctx',
            annotation=Name(id='ExecutionContext', ctx=Load()))],
        kwonlyargs=[
          arg(
            arg='prompt_id',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='layer',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='agent',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='model_tier',
            annotation=Name(id='str', ctx=Load()))],
        kw_defaults=[
          Constant(value='system.resume.planner'),
          Constant(value='L2'),
          Constant(value='strategy'),
          Constant(value='balanced')]),
      body=[
        Expr(
          value=Constant(value='\n    Build a strategy planning prompt.\n    ')),
        Assign(
          targets=[
            Name(id='envelope', ctx=Store())],
          value=Call(
            func=Name(id='PromptEnvelope', ctx=Load()),
            keywords=[
              keyword(
                arg='framing',
                value=Call(
                  func=Attribute(
                    value=Constant(value='You are the Strategy Planning agent (Layer {layer}). You design a plan to tailor the resume to the job.'),
                    attr='format',
                    ctx=Load()),
                  keywords=[
                    keyword(
                      arg='layer',
                      value=Name(id='layer', ctx=Load()))])),
              keyword(
                arg='context',
                value=Call(
                  func=Name(id='_summarize_job_and_resume', ctx=Load()),
                  args=[
                    Name(id='ctx', ctx=Load())])),
              keyword(
                arg='reasoning',
                value=Constant(value='Propose several strategy branches and select the best one.')),
              keyword(
                arg='instructions',
                value=Constant(value='Produce a small set of strategy branches and then select a single branch id as the chosen strategy.')),
              keyword(
                arg='safety_signals',
                value=Constant(value='Avoid fabricating experience or skills.')),
              keyword(
                arg='output_schema',
                value=Constant(value='Return structured branches with ids and rationales.'))])),
        Assign(
          targets=[
            Name(id='variables', ctx=Store())],
          value=Dict(
            keys=[
              Constant(value='plan'),
              Constant(value='job'),
              Constant(value='resume'),
              Constant(value='config')],
            values=[
              Name(id='plan', ctx=Load()),
              Attribute(
                value=Name(id='ctx', ctx=Load()),
                attr='job',
                ctx=Load()),
              Attribute(
                value=Name(id='ctx', ctx=Load()),
                attr='resume',
                ctx=Load()),
              Attribute(
                value=Name(id='ctx', ctx=Load()),
                attr='config',
                ctx=Load())])),
        Return(
          value=Call(
            func=Name(id='_make_prompt_instance', ctx=Load()),
            keywords=[
              keyword(
                arg='prompt_id',
                value=Name(id='prompt_id', ctx=Load())),
              keyword(
                arg='layer',
                value=Name(id='layer', ctx=Load())),
              keyword(
                arg='agent',
                value=Name(id='agent', ctx=Load())),
              keyword(
                arg='model_tier',
                value=Name(id='model_tier', ctx=Load())),
              keyword(
                arg='envelope',
                value=Name(id='envelope', ctx=Load())),
              keyword(
                arg='variables',
                value=Name(id='variables', ctx=Load()))]))],
      returns=Name(id='PromptInstance', ctx=Load())),
    FunctionDef(
      name='build_rag_prompt',
      args=arguments(
        args=[
          arg(
            arg='plan',
            annotation=Name(id='RAGPlan', ctx=Load())),
          arg(
            arg='ctx',
            annotation=Name(id='ExecutionContext', ctx=Load())),
          arg(
            arg='evidence',
            annotation=Subscript(
              value=Name(id='Sequence', ctx=Load()),
              slice=Name(id='Evidence', ctx=Load()),
              ctx=Load()))],
        kwonlyargs=[
          arg(
            arg='prompt_id',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='layer',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='agent',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='model_tier',
            annotation=Name(id='str', ctx=Load()))],
        kw_defaults=[
          Constant(value='system.resume.drafter'),
          Constant(value='L2'),
          Constant(value='rag'),
          Constant(value='balanced')]),
      body=[
        Expr(
          value=Constant(value='\n    Build a retrieval / evidence fusion prompt.\n\n    Used by the Phase-3 RAG reasoning stage between retrieval and drafting.\n    ')),
        Assign(
          targets=[
            Name(id='envelope', ctx=Store())],
          value=Call(
            func=Name(id='PromptEnvelope', ctx=Load()),
            keywords=[
              keyword(
                arg='framing',
                value=Call(
                  func=Attribute(
                    value=Constant(value='You are the Retrieval & Evidence Fusion agent (Layer {layer}). You summarize and interpret retrieval results to support downstream drafting and QA.'),
                    attr='format',
                    ctx=Load()),
                  keywords=[
                    keyword(
                      arg='layer',
                      value=Name(id='layer', ctx=Load()))])),
              keyword(
                arg='context',
                value=BinOp(
                  left=BinOp(
                    left=Call(
                      func=Name(id='_summarize_job_and_resume', ctx=Load()),
                      args=[
                        Name(id='ctx', ctx=Load())]),
                    op=Add(),
                    right=Constant(value='\n\nRetrieved Evidence:\n')),
                  op=Add(),
                  right=Call(
                    func=Name(id='_format_evidence', ctx=Load()),
                    args=[
                      Name(id='evidence', ctx=Load())]))),
              keyword(
                arg='reasoning',
                value=Constant(value='Identify which evidence items are most relevant for tailoring the resume to this job. Highlight overlaps between job requirements and candidate experience.')),
              keyword(
                arg='instructions',
                value=Constant(value='Analyze the evidence and produce a concise reasoning summary that captures the most important overlaps and gaps. Do not rewrite the resume; instead, describe what the drafting agent should focus on.')),
              keyword(
                arg='safety_signals',
                value=Constant(value='Do not infer skills or experience not supported by evidence.')),
              keyword(
                arg='output_schema',
                value=Constant(value='Return a short reasoning summary plus a bullet list of key evidence references (by index) the drafting agent should respect.'))])),
        Assign(
          targets=[
            Name(id='variables', ctx=Store())],
          value=Dict(
            keys=[
              Constant(value='plan'),
              Constant(value='job'),
              Constant(value='resume'),
              Constant(value='config'),
              Constant(value='evidence')],
            values=[
              Name(id='plan', ctx=Load()),
              Attribute(
                value=Name(id='ctx', ctx=Load()),
                attr='job',
                ctx=Load()),
              Attribute(
                value=Name(id='ctx', ctx=Load()),
                attr='resume',
                ctx=Load()),
              Attribute(
                value=Name(id='ctx', ctx=Load()),
                attr='config',
                ctx=Load()),
              Call(
                func=Name(id='list', ctx=Load()),
                args=[
                  BoolOp(
                    op=Or(),
                    values=[
                      Name(id='evidence', ctx=Load()),
                      List(ctx=Load())])])])),
        Return(
          value=Call(
            func=Name(id='_make_prompt_instance', ctx=Load()),
            keywords=[
              keyword(
                arg='prompt_id',
                value=Name(id='prompt_id', ctx=Load())),
              keyword(
                arg='layer',
                value=Name(id='layer', ctx=Load())),
              keyword(
                arg='agent',
                value=Name(id='agent', ctx=Load())),
              keyword(
                arg='model_tier',
                value=Name(id='model_tier', ctx=Load())),
              keyword(
                arg='envelope',
                value=Name(id='envelope', ctx=Load())),
              keyword(
                arg='variables',
                value=Name(id='variables', ctx=Load()))]))],
      returns=Name(id='PromptInstance', ctx=Load())),
    FunctionDef(
      name='build_hyde_prompt',
      args=arguments(
        args=[
          arg(
            arg='plan',
            annotation=Name(id='RAGPlan', ctx=Load())),
          arg(
            arg='ctx',
            annotation=Name(id='ExecutionContext', ctx=Load()))],
        kwonlyargs=[
          arg(
            arg='prompt_id',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='layer',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='agent',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='model_tier',
            annotation=Name(id='str', ctx=Load()))],
        kw_defaults=[
          Constant(value='system.rag.hyde_query'),
          Constant(value='L2'),
          Constant(value='rag'),
          Constant(value='balanced')]),
      body=[
        Expr(
          value=Constant(value="\n    Build a HYDE prompt: generate an ideal answer for use as a retrieval proxy.\n\n    The output is a synthetic, idealized answer to the user's (implicit) query\n    for the job/resume pair, which retrieval.py will treat as a dense query.\n    ")),
        Assign(
          targets=[
            Name(id='envelope', ctx=Store())],
          value=Call(
            func=Name(id='PromptEnvelope', ctx=Load()),
            keywords=[
              keyword(
                arg='framing',
                value=Constant(value='You are the HYDE (Hypothetical Document) generator for retrieval.')),
              keyword(
                arg='context',
                value=Call(
                  func=Name(id='_summarize_job_and_resume', ctx=Load()),
                  args=[
                    Name(id='ctx', ctx=Load())])),
              keyword(
                arg='reasoning',
                value=Constant(value='Imagine the ideal, well-written answer that would perfectly match this job and candidate. This answer will be used as a semantic query to retrieve similar documents.')),
              keyword(
                arg='instructions',
                value=Constant(value="Write a single, coherent paragraph that describes the ideal candidate's experience and impact for this role, grounded in the provided job and resume information.")),
              keyword(
                arg='safety_signals',
                value=Constant(value='Do not fabricate credentials or experience not hinted in the resume.')),
              keyword(
                arg='output_schema',
                value=Constant(value='Return only the hypothetical answer paragraph.'))])),
        Assign(
          targets=[
            Name(id='variables', ctx=Store())],
          value=Dict(
            keys=[
              Constant(value='plan'),
              Constant(value='job'),
              Constant(value='resume'),
