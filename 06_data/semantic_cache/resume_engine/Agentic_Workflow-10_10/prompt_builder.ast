          simple=1),
        AnnAssign(
          target=Name(id='envelope', ctx=Store()),
          annotation=Name(id='PromptEnvelope', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='variables', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='Any', ctx=Load())],
              ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='layer', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='agent', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='model_tier', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='context_budget_hints', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='Any', ctx=Load())],
              ctx=Load()),
            ctx=Load()),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    FunctionDef(
      name='_extract_acl_metadata',
      args=arguments(
        args=[
          arg(
            arg='defn',
            annotation=Name(id='PromptDefinition', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Extract ACL metadata from a PromptDefinition.\n\n    Expected shape (stored in defn.metadata["acl"]):\n\n        {\n            "layers": ["L1", "L2", ...],\n            "agents": ["strategy", "rag", "drafting", "qa", "safety"],\n            "model_tiers": ["cheap", "balanced", "premium"],\n        }\n\n    All fields are optional; missing fields are treated as "no restriction".\n    ')),
        Assign(
          targets=[
            Name(id='raw_acl', ctx=Store())],
          value=Dict()),
        Try(
          body=[
            Assign(
              targets=[
                Name(id='raw_acl', ctx=Store())],
              value=BoolOp(
                op=Or(),
                values=[
                  Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='defn', ctx=Load()),
                        attr='metadata',
                        ctx=Load()),
                      attr='get',
                      ctx=Load()),
                    args=[
                      Constant(value='acl'),
                      Dict()]),
                  Dict()]))],
          handlers=[
            ExceptHandler(
              type=Name(id='Exception', ctx=Load()),
              body=[
                Assign(
                  targets=[
                    Name(id='raw_acl', ctx=Store())],
                  value=Dict())])]),
        Assign(
          targets=[
            Name(id='layers', ctx=Store())],
          value=Call(
            func=Name(id='list', ctx=Load()),
            args=[
              Call(
                func=Attribute(
                  value=Name(id='raw_acl', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='layers'),
                  List(ctx=Load())])])),
        Assign(
          targets=[
            Name(id='agents', ctx=Store())],
          value=Call(
            func=Name(id='list', ctx=Load()),
            args=[
              Call(
                func=Attribute(
                  value=Name(id='raw_acl', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='agents'),
                  List(ctx=Load())])])),
        Assign(
          targets=[
            Name(id='tiers', ctx=Store())],
          value=Call(
            func=Name(id='list', ctx=Load()),
            args=[
              Call(
                func=Attribute(
                  value=Name(id='raw_acl', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='model_tiers'),
                  List(ctx=Load())])])),
        Return(
          value=Dict(
            keys=[
              Constant(value='layers'),
              Constant(value='agents'),
              Constant(value='model_tiers')],
            values=[
              Name(id='layers', ctx=Load()),
              Name(id='agents', ctx=Load()),
              Name(id='tiers', ctx=Load())]))],
      returns=Subscript(
        value=Name(id='Dict', ctx=Load()),
        slice=Tuple(
          elts=[
            Name(id='str', ctx=Load()),
            Subscript(
              value=Name(id='List', ctx=Load()),
              slice=Name(id='str', ctx=Load()),
              ctx=Load())],
          ctx=Load()),
        ctx=Load())),
    FunctionDef(
      name='_get_prompt_definition',
      args=arguments(
        args=[
          arg(
            arg='prompt_id',
            annotation=Name(id='str', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Retrieve a PromptDefinition from the central registry.\n\n    This is a thin wrapper around ``PROMPT_REGISTRY`` / ``get_prompt``\n    so that all lookups live in one place.\n    ')),
        Try(
          body=[
            Return(
              value=Call(
                func=Name(id='get_prompt', ctx=Load()),
                args=[
                  Name(id='prompt_id', ctx=Load())]))],
          handlers=[
            ExceptHandler(
              type=Name(id='Exception', ctx=Load()),
              body=[
                If(
                  test=Compare(
                    left=Name(id='prompt_id', ctx=Load()),
                    ops=[
                      NotIn()],
                    comparators=[
                      Name(id='PROMPT_REGISTRY', ctx=Load())]),
                  body=[
                    Raise(
                      exc=Call(
                        func=Name(id='KeyError', ctx=Load()),
                        args=[
                          JoinedStr(
                            values=[
                              Constant(value='Unknown prompt id: '),
                              FormattedValue(
                                value=Name(id='prompt_id', ctx=Load()),
                                conversion=-1)])]))]),
                Return(
                  value=Subscript(
                    value=Name(id='PROMPT_REGISTRY', ctx=Load()),
                    slice=Name(id='prompt_id', ctx=Load()),
                    ctx=Load()))])])],
      returns=Name(id='PromptDefinition', ctx=Load())),
    FunctionDef(
      name='_check_prompt_acl',
      args=arguments(
        kwonlyargs=[
          arg(
            arg='prompt_id',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='layer',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='agent',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='model_tier',
            annotation=Name(id='str', ctx=Load()))],
        kw_defaults=[
          None,
          None,
          None,
          None]),
      body=[
        Expr(
          value=Constant(value='\n    Enforce both registry-level ACLs and per-prompt ACL metadata.\n\n    This function is intentionally side-effect free; it either returns\n    or raises PermissionError.\n    ')),
        Assign(
          targets=[
            Name(id='acl_obj', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='PROMPT_ACLS', ctx=Load()),
              attr='get',
              ctx=Load()),
            args=[
              Name(id='prompt_id', ctx=Load())])),
        If(
          test=Call(
            func=Name(id='isinstance', ctx=Load()),
            args=[
              Name(id='acl_obj', ctx=Load()),
              Name(id='PromptACL', ctx=Load())]),
          body=[
            If(
              test=UnaryOp(
                op=Not(),
                operand=Attribute(
                  value=Name(id='acl_obj', ctx=Load()),
                  attr='engine_can_use',
                  ctx=Load())),
              body=[
                Raise(
                  exc=Call(
                    func=Name(id='PermissionError', ctx=Load()),
                    args=[
                      JoinedStr(
                        values=[
                          Constant(value="Engine is not allowed to use prompt '"),
                          FormattedValue(
                            value=Name(id='prompt_id', ctx=Load()),
                            conversion=-1),
                          Constant(value="'")])]))])]),
        Assign(
          targets=[
            Name(id='defn', ctx=Store())],
          value=Call(
            func=Name(id='_get_prompt_definition', ctx=Load()),
            args=[
              Name(id='prompt_id', ctx=Load())])),
        Assign(
          targets=[
            Name(id='acl_meta', ctx=Store())],
          value=Call(
            func=Name(id='_extract_acl_metadata', ctx=Load()),
            args=[
              Name(id='defn', ctx=Load())])),
        Assign(
          targets=[
            Name(id='allowed_layers', ctx=Store())],
          value=BoolOp(
            op=Or(),
            values=[
              Call(
                func=Attribute(
                  value=Name(id='acl_meta', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='layers')]),
              List(ctx=Load())])),
        Assign(
          targets=[
            Name(id='allowed_agents', ctx=Store())],
          value=BoolOp(
            op=Or(),
            values=[
              Call(
                func=Attribute(
                  value=Name(id='acl_meta', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='agents')]),
              List(ctx=Load())])),
        Assign(
          targets=[
            Name(id='allowed_tiers', ctx=Store())],
          value=BoolOp(
            op=Or(),
            values=[
              Call(
                func=Attribute(
                  value=Name(id='acl_meta', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='model_tiers')]),
              List(ctx=Load())])),
        If(
          test=BoolOp(
            op=And(),
            values=[
              Name(id='allowed_layers', ctx=Load()),
              Compare(
                left=Name(id='layer', ctx=Load()),
                ops=[
                  NotIn()],
                comparators=[
                  Name(id='allowed_layers', ctx=Load())])]),
          body=[
            Raise(
              exc=Call(
                func=Name(id='PermissionError', ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value="Prompt '"),
                      FormattedValue(
                        value=Name(id='prompt_id', ctx=Load()),
                        conversion=-1),
                      Constant(value="' not allowed for layer '"),
                      FormattedValue(
                        value=Name(id='layer', ctx=Load()),
                        conversion=-1),
                      Constant(value="' (allowed: "),
                      FormattedValue(
                        value=Name(id='allowed_layers', ctx=Load()),
                        conversion=-1),
                      Constant(value=')')])]))]),
        If(
          test=BoolOp(
            op=And(),
            values=[
              Name(id='allowed_agents', ctx=Load()),
              Compare(
                left=Name(id='agent', ctx=Load()),
                ops=[
                  NotIn()],
                comparators=[
                  Name(id='allowed_agents', ctx=Load())])]),
          body=[
            Raise(
              exc=Call(
                func=Name(id='PermissionError', ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value="Prompt '"),
                      FormattedValue(
                        value=Name(id='prompt_id', ctx=Load()),
                        conversion=-1),
                      Constant(value="' not allowed for agent '"),
                      FormattedValue(
                        value=Name(id='agent', ctx=Load()),
                        conversion=-1),
                      Constant(value="' (allowed: "),
                      FormattedValue(
                        value=Name(id='allowed_agents', ctx=Load()),
                        conversion=-1),
                      Constant(value=')')])]))]),
        If(
          test=BoolOp(
            op=And(),
            values=[
              Name(id='allowed_tiers', ctx=Load()),
              Compare(
                left=Name(id='model_tier', ctx=Load()),
                ops=[
                  NotIn()],
                comparators=[
                  Name(id='allowed_tiers', ctx=Load())])]),
          body=[
            Raise(
              exc=Call(
                func=Name(id='PermissionError', ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value="Prompt '"),
                      FormattedValue(
                        value=Name(id='prompt_id', ctx=Load()),
                        conversion=-1),
                      Constant(value="' not allowed for model tier '"),
                      FormattedValue(
                        value=Name(id='model_tier', ctx=Load()),
                        conversion=-1),
                      Constant(value="' (allowed: "),
                      FormattedValue(
                        value=Name(id='allowed_tiers', ctx=Load()),
                        conversion=-1),
                      Constant(value=')')])]))])],
      returns=Constant(value=None)),
    FunctionDef(
      name='_render_envelope_with_template',
      args=arguments(
        args=[
          arg(
            arg='defn',
            annotation=Name(id='PromptDefinition', ctx=Load())),
          arg(
            arg='envelope',
            annotation=Name(id='PromptEnvelope', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Merge a PromptEnvelope with the registry template into a final string.\n\n    Default templates follow the pattern:\n\n        "## CONTEXT\\n\\n## INSTRUCTIONS\\n\\n## OUTPUT_FORMAT\\n"\n\n    This helper injects the envelope contents into those anchors while\n    also adding the richer sections (Framing, Reasoning, Safety).\n    ')),
        Assign(
          targets=[
            Name(id='template', ctx=Store())],
          value=Call(
            func=Attribute(
              value=BoolOp(
                op=Or(),
                values=[
                  Attribute(
                    value=Name(id='defn', ctx=Load()),
                    attr='text',
                    ctx=Load()),
                  Constant(value='')]),
              attr='strip',
              ctx=Load()))),
        Assign(
          targets=[
            Name(id='sections', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='envelope', ctx=Load()),
              attr='to_sections',
              ctx=Load()))),
        Assign(
          targets=[
            Name(id='body', ctx=Store())],
          value=Name(id='template', ctx=Load())),
        If(
          test=Compare(
            left=Constant(value='## CONTEXT'),
            ops=[
              In()],
            comparators=[
              Name(id='body', ctx=Load())]),
          body=[
            Assign(
              targets=[
                Name(id='body', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='body', ctx=Load()),
                  attr='replace',
                  ctx=Load()),
                args=[
                  Constant(value='## CONTEXT'),
                  IfExp(
                    test=Subscript(
                      value=Name(id='sections', ctx=Load()),
                      slice=Constant(value='Context'),
                      ctx=Load()),
                    body=BinOp(
                      left=Constant(value='## CONTEXT\n'),
                      op=Add(),
                      right=Subscript(
                        value=Name(id='sections', ctx=Load()),
                        slice=Constant(value='Context'),
                        ctx=Load())),
                    orelse=Constant(value='## CONTEXT'))]))]),
        If(
          test=Compare(
            left=Constant(value='## INSTRUCTIONS'),
            ops=[
              In()],
            comparators=[
              Name(id='body', ctx=Load())]),
          body=[
            Assign(
              targets=[
                Name(id='body', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='body', ctx=Load()),
                  attr='replace',
                  ctx=Load()),
                args=[
                  Constant(value='## INSTRUCTIONS'),
                  IfExp(
                    test=Subscript(
                      value=Name(id='sections', ctx=Load()),
                      slice=Constant(value='Instructions'),
                      ctx=Load()),
                    body=BinOp(
                      left=Constant(value='## INSTRUCTIONS\n'),
                      op=Add(),
                      right=Subscript(
                        value=Name(id='sections', ctx=Load()),
                        slice=Constant(value='Instructions'),
                        ctx=Load())),
                    orelse=Constant(value='## INSTRUCTIONS'))]))]),
        If(
          test=Compare(
            left=Constant(value='## OUTPUT_FORMAT'),
            ops=[
              In()],
            comparators=[
              Name(id='body', ctx=Load())]),
          body=[
            Assign(
              targets=[
                Name(id='body', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='body', ctx=Load()),
                  attr='replace',
                  ctx=Load()),
                args=[
                  Constant(value='## OUTPUT_FORMAT'),
                  IfExp(
                    test=Subscript(
                      value=Name(id='sections', ctx=Load()),
                      slice=Constant(value='Output Schema'),
                      ctx=Load()),
                    body=BinOp(
                      left=Constant(value='## OUTPUT_FORMAT\n'),
                      op=Add(),
                      right=Subscript(
                        value=Name(id='sections', ctx=Load()),
                        slice=Constant(value='Output Schema'),
                        ctx=Load())),
                    orelse=Constant(value='## OUTPUT_FORMAT'))]))]),
        AnnAssign(
          target=Name(id='prefix_parts', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load()),
          value=List(ctx=Load()),
          simple=1),
        If(
          test=Subscript(
            value=Name(id='sections', ctx=Load()),
            slice=Constant(value='Framing'),
            ctx=Load()),
          body=[
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='prefix_parts', ctx=Load()),
                  attr='append',
                  ctx=Load()),
                args=[
                  BinOp(
                    left=Constant(value='### FRAMING\n'),
                    op=Add(),
                    right=Subscript(
                      value=Name(id='sections', ctx=Load()),
                      slice=Constant(value='Framing'),
                      ctx=Load()))]))]),
        If(
          test=Subscript(
            value=Name(id='sections', ctx=Load()),
            slice=Constant(value='Reasoning'),
            ctx=Load()),
          body=[
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='prefix_parts', ctx=Load()),
                  attr='append',
                  ctx=Load()),
                args=[
                  BinOp(
                    left=Constant(value='### REASONING\n'),
                    op=Add(),
                    right=Subscript(
                      value=Name(id='sections', ctx=Load()),
                      slice=Constant(value='Reasoning'),
                      ctx=Load()))]))]),
        If(
          test=Subscript(
            value=Name(id='sections', ctx=Load()),
            slice=Constant(value='Safety Signals'),
            ctx=Load()),
          body=[
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='prefix_parts', ctx=Load()),
                  attr='append',
                  ctx=Load()),
                args=[
                  BinOp(
                    left=Constant(value='### SAFETY\n'),
                    op=Add(),
                    right=Subscript(
                      value=Name(id='sections', ctx=Load()),
                      slice=Constant(value='Safety Signals'),
                      ctx=Load()))]))]),
        If(
          test=Name(id='prefix_parts', ctx=Load()),
          body=[
            Return(
              value=Call(
                func=Attribute(
                  value=Constant(value='\n\n'),
                  attr='join',
                  ctx=Load()),
                args=[
                  BinOp(
                    left=Name(id='prefix_parts', ctx=Load()),
                    op=Add(),
                    right=List(
                      elts=[
                        Name(id='body', ctx=Load())],
