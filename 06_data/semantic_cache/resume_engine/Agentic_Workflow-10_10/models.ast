Module(
  body=[
    Expr(
      value=Constant(value='\nUnified Runtime Models (v10_10 · Phase 3 — FINAL)\n=================================================\n\nThis file defines all structured dataclasses and Pydantic models\nused throughout the v10_10 agentic runtime:\n\n    • Core workflow dataclasses\n    • Plans / Results (Strategy, RAG, Drafting, QA, Safety)\n    • RetrievalConfig\n    • PromptDefinition / PromptVersion\n    • ExecutionProfile\n    • Telemetry models (Phase 3 typed events)\n    • CostSnapshot\n    • PolicyDecisionEvent\n    • Skill / Domain classifier results\n    • CouncilVote + CorrectionLoopState (Phase-3 DAG)\n\nDesign constraints:\n\n    1. This module is *data-only* (no I/O, no business logic).\n    2. Models are intentionally verbose and explicit.\n    3. All cross-layer contracts must be defined here (or imported here).\n')),
    ImportFrom(
      module='__future__',
      names=[
        alias(name='annotations')],
      level=0),
    ImportFrom(
      module='dataclasses',
      names=[
        alias(name='dataclass')],
      level=0),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Any'),
        alias(name='Dict'),
        alias(name='List'),
        alias(name='Optional')],
      level=0),
    ImportFrom(
      module='pydantic',
      names=[
        alias(name='BaseModel'),
        alias(name='Field')],
      level=0),
