              simple=1),
            Try(
              body=[
                Assign(
                  targets=[
                    Name(id='data', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='json', ctx=Load()),
                      attr='loads',
                      ctx=Load()),
                    args=[
                      Name(id='text', ctx=Load())])),
                If(
                  test=Call(
                    func=Name(id='isinstance', ctx=Load()),
                    args=[
                      Name(id='data', ctx=Load()),
                      Name(id='list', ctx=Load())]),
                  body=[
                    For(
                      target=Name(id='item', ctx=Store()),
                      iter=Name(id='data', ctx=Load()),
                      body=[
                        Try(
                          body=[
                            Expr(
                              value=Call(
                                func=Attribute(
                                  value=Name(id='branches', ctx=Load()),
                                  attr='append',
                                  ctx=Load()),
                                args=[
                                  Call(
                                    func=Name(id='StrategyBranch', ctx=Load()),
                                    keywords=[
                                      keyword(
                                        arg='id',
                                        value=Call(
                                          func=Name(id='str', ctx=Load()),
                                          args=[
                                            BoolOp(
                                              op=Or(),
                                              values=[
                                                Call(
                                                  func=Attribute(
                                                    value=Name(id='item', ctx=Load()),
                                                    attr='get',
                                                    ctx=Load()),
                                                  args=[
                                                    Constant(value='id')]),
                                                Call(
                                                  func=Name(id='len', ctx=Load()),
                                                  args=[
                                                    Name(id='branches', ctx=Load())])])])),
                                      keyword(
                                        arg='description',
                                        value=Call(
                                          func=Name(id='str', ctx=Load()),
                                          args=[
                                            BoolOp(
                                              op=Or(),
                                              values=[
                                                Call(
                                                  func=Attribute(
                                                    value=Name(id='item', ctx=Load()),
                                                    attr='get',
                                                    ctx=Load()),
                                                  args=[
                                                    Constant(value='description')]),
                                                Constant(value='')])])),
                                      keyword(
                                        arg='weight',
                                        value=Call(
