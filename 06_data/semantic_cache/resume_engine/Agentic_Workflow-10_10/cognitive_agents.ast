                                attr='layer',
                                ctx=Load()),
                              Attribute(
                                value=Name(id='prompt', ctx=Load()),
                                attr='agent',
                                ctx=Load())])])),
                    Raise()])])],
          returns=Name(id='str', ctx=Load()))]),
    ClassDef(
      name='StrategyLLMAgent',
      bases=[
        Name(id='LLMBaseAgent', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='\n    Strategy agent responsible for high-level reasoning.\n\n    Outputs:\n        • StrategyResult\n        • StrategyBranch list (internally)\n    ')),
        AsyncFunctionDef(
          name='run_strategy',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='strategy_plan',
                annotation=Name(id='Any', ctx=Load())),
