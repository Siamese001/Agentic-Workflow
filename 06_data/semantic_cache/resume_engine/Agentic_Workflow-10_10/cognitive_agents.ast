                ctx=Load()),
              value=List(ctx=Load()),
              simple=1),
            Try(
              body=[
                Assign(
                  targets=[
                    Name(id='data', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='json', ctx=Load()),
                      attr='loads',
                      ctx=Load()),
                    args=[
                      Name(id='text', ctx=Load())])),
                If(
                  test=UnaryOp(
                    op=Not(),
                    operand=Call(
                      func=Name(id='isinstance', ctx=Load()),
                      args=[
                        Name(id='data', ctx=Load()),
                        Name(id='list', ctx=Load())])),
                  body=[
                    Raise(
                      exc=Call(
