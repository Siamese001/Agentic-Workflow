                  keyword(
                    arg='ctx',
                    value=Name(id='ctx', ctx=Load())),
                  keyword(
                    arg='strategy',
                    value=Name(id='strategy_result', ctx=Load())),
                  keyword(
                    arg='rag',
                    value=Name(id='rag_result', ctx=Load())),
                  keyword(
                    arg='layer',
                    value=Constant(value='L2')),
                  keyword(
                    arg='agent',
                    value=Constant(value='drafting')),
                  keyword(
                    arg='model_tier',
                    value=Constant(value='balanced'))])),
            Assign(
              targets=[
                Name(id='raw', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='_call_llm',
                  ctx=Load()),
                args=[
