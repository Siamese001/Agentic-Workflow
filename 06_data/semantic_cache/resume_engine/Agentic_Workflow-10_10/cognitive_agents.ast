                                      args=[
                                        BoolOp(
                                          op=Or(),
                                          values=[
                                            Call(
                                              func=Attribute(
                                                value=Name(id='item', ctx=Load()),
                                                attr='get',
                                                ctx=Load()),
                                              args=[
                                                Constant(value='body')]),
                                            Constant(value='')])])),
                                  keyword(
