Module(
  body=[
    Expr(
      value=Constant(value='\nUnified Cognitive Agents (v10_10 · Phase 3 — FINAL)\n===================================================\n\nThis module implements ALL LLM-based cognition for the v10_10 workflow.\n\nL2 is the only layer allowed to call these agents.\n\nAgents (L2 cognition only):\n    • StrategyLLMAgent            – strategy reasoning\n    • DraftingGuild              – resume drafting\n    • SemanticQAAgent            – QA reasoning + RAG reasoning\n    • ConstitutionalSafetyAgent  – safety / policy review\n    • HYDEQueryAgent             – HYDE synthetic query generation\n    • QACouncilAgent             – QA council aggregation\n\nDesign constraints:\n    • Only this module may invoke LLMs.\n    • No planning (L1), orchestration (L3), state mutation (L4),\n      or safety policy enforcement (L5).\n    • All calls use PromptInstance + ACL from prompt_builder.\n    • All model selection goes through RoutingPolicy.\n    • All LLM calls go through runtime_utils.invoke_model.\n')),
    ImportFrom(
      module='__future__',
      names=[
        alias(name='annotations')],
      level=0),
    Import(
      names=[
        alias(name='json')]),
    ImportFrom(
      module='dataclasses',
      names=[
        alias(name='dataclass')],
      level=0),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Any'),
        alias(name='Dict'),
        alias(name='List'),
        alias(name='Optional'),
        alias(name='Sequence')],
      level=0),
    ImportFrom(
      module='models',
      names=[
        alias(name='StrategyResult'),
        alias(name='StrategyBranch'),
        alias(name='RAGResult'),
        alias(name='DraftingResult'),
        alias(name='DraftSection'),
        alias(name='QAResult'),
        alias(name='QAFinding'),
        alias(name='SafetyResult'),
        alias(name='SafetyFinding'),
        alias(name='Evidence'),
        alias(name='RAGPlan'),
        alias(name='CouncilVote')],
      level=0),
    ImportFrom(
      module='routing',
      names=[
        alias(name='RoutingPolicy')],
      level=0),
    ImportFrom(
      module='runtime_utils',
      names=[
        alias(name='invoke_model'),
        alias(name='SandboxConfig')],
      level=0),
    ImportFrom(
      module='observability',
      names=[
        alias(name='record_event'),
        alias(name='record_exception')],
      level=0),
    ImportFrom(
      module='meta_profile',
      names=[
        alias(name='MetaProfileSnapshot')],
      level=0),
    ImportFrom(
      module='prompt_builder',
      names=[
        alias(name='PromptInstance'),
        alias(name='build_strategy_prompt'),
        alias(name='build_drafting_prompt'),
        alias(name='build_rag_prompt'),
        alias(name='build_qa_prompt'),
        alias(name='build_safety_prompt'),
        alias(name='build_hyde_prompt')],
      level=0),
    ClassDef(
      name='_PromptContext',
      body=[
        Expr(
          value=Constant(value='\n    Lightweight context object passed to prompt_builder.\n\n    We intentionally avoid depending on models.ExecutionContext here;\n    prompt_builder only needs job, resume, config, which we expose\n    directly.\n    ')),
        AnnAssign(
          target=Name(id='job', ctx=Store()),
          annotation=Name(id='Any', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='resume', ctx=Store()),
          annotation=Name(id='Any', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='config', ctx=Store()),
          annotation=Name(id='Any', ctx=Load()),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='LLMBaseAgent',
      body=[
        Expr(
          value=Constant(value='\n    Base class for all L2 cognitive agents.\n\n    This class centralizes:\n        • RoutingPolicy-based model selection.\n        • SandboxConfig usage.\n        • invoke_model() calls.\n        • Basic observability events.\n\n    This class must remain **L2-only** and must not perform:\n        • planning (L1),\n        • orchestration / retries (L3),\n        • state mutation (L4),\n        • safety policy enforcement (L5).\n    ')),
        AnnAssign(
          target=Name(id='routing_policy', ctx=Store()),
          annotation=Name(id='RoutingPolicy', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='sandbox', ctx=Store()),
          annotation=Name(id='SandboxConfig', ctx=Load()),
          simple=1),
        AnnAssign(
