                      Call(
                        func=Name(id='len', ctx=Load()),
                        args=[
                          Name(id='text', ctx=Load())])])])),
            Return(
              value=Name(id='result', ctx=Load()))],
          returns=Name(id='StrategyResult', ctx=Load()))]),
    ClassDef(
      name='DraftingGuild',
      bases=[
        Name(id='LLMBaseAgent', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='\n    Drafting agent that turns strategy + evidence into resume content.\n\n    Phase 3 implementation:\n        • Uses a single drafting prompt envelope per call.\n        • Emits a DraftingResult with at least one DraftSection.\n        • Parsing is robust to both JSON and free-form text output.\n    ')),
        AsyncFunctionDef(
          name='run_drafting',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
