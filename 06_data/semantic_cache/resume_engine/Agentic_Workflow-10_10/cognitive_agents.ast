                arg='job',
                annotation=Name(id='Any', ctx=Load())),
              arg(
                arg='resume',
                annotation=Name(id='Any', ctx=Load())),
              arg(
                arg='config',
                annotation=Name(id='Any', ctx=Load()))]),
          body=[
            Assign(
              targets=[
                Name(id='ctx', ctx=Store())],
              value=Call(
                func=Name(id='_PromptContext', ctx=Load()),
                keywords=[
                  keyword(
                    arg='job',
                    value=Name(id='job', ctx=Load())),
                  keyword(
                    arg='resume',
                    value=Name(id='resume', ctx=Load())),
                  keyword(
                    arg='config',
                    value=Name(id='config', ctx=Load()))])),
            Assign(
              targets=[
                Name(id='prompt', ctx=Store())],
              value=Call(
                func=Name(id='build_strategy_prompt', ctx=Load()),
                keywords=[
                  keyword(
                    arg='plan',
                    value=Name(id='strategy_plan', ctx=Load())),
                  keyword(
                    arg='ctx',
                    value=Name(id='ctx', ctx=Load())),
                  keyword(
                    arg='layer',
                    value=Constant(value='L2')),
                  keyword(
                    arg='agent',
                    value=Constant(value='strategy')),
                  keyword(
                    arg='model_tier',
                    value=Constant(value='balanced'))])),
            Assign(
              targets=[
                Name(id='raw', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='_call_llm',
                  ctx=Load()),
                args=[
                  Name(id='prompt', ctx=Load())])),
            Assign(
              targets=[
                Name(id='text', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=BoolOp(
                    op=Or(),
                    values=[
                      Name(id='raw', ctx=Load()),
                      Constant(value='')]),
                  attr='strip',
                  ctx=Load()))),
            AnnAssign(
              target=Name(id='branches', ctx=Store()),
              annotation=Subscript(
                value=Name(id='List', ctx=Load()),
