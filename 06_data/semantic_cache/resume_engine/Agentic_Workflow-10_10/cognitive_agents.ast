            slice=Name(id='MetaProfileSnapshot', ctx=Load()),
            ctx=Load()),
          value=Constant(value=None),
          simple=1),
        FunctionDef(
          name='__init__',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='routing_policy',
                annotation=Name(id='RoutingPolicy', ctx=Load())),
              arg(
                arg='sandbox',
                annotation=Name(id='SandboxConfig', ctx=Load())),
              arg(
                arg='meta_profile',
                annotation=Subscript(
                  value=Name(id='Optional', ctx=Load()),
                  slice=Name(id='MetaProfileSnapshot', ctx=Load()),
                  ctx=Load()))],
            defaults=[
              Constant(value=None)]),
          body=[
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='routing_policy',
                  ctx=Store())],
              value=Name(id='routing_policy', ctx=Load())),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='sandbox',
                  ctx=Store())],
              value=Name(id='sandbox', ctx=Load())),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='meta_profile',
                  ctx=Store())],
              value=Name(id='meta_profile', ctx=Load()))],
          returns=Constant(value=None)),
        FunctionDef(
          name='_call_llm',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='prompt',
                annotation=Name(id='PromptInstance', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Execute a single LLM call for the given prompt instance.\n        ')),
            AnnAssign(
              target=Name(id='complexity', ctx=Store()),
              annotation=Subscript(
                value=Name(id='Optional', ctx=Load()),
                slice=Name(id='str', ctx=Load()),
                ctx=Load()),
              value=Constant(value=None),
              simple=1),
            Assign(
              targets=[
                Name(id='plan', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='prompt', ctx=Load()),
                    attr='variables',
                    ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='plan')])),
            If(
              test=BoolOp(
                op=And(),
                values=[
                  Compare(
                    left=Name(id='plan', ctx=Load()),
                    ops=[
                      IsNot()],
                    comparators=[
                      Constant(value=None)]),
                  Call(
                    func=Name(id='hasattr', ctx=Load()),
                    args=[
                      Name(id='plan', ctx=Load()),
                      Constant(value='complexity')])]),
              body=[
                Assign(
                  targets=[
                    Name(id='complexity', ctx=Store())],
                  value=Call(
                    func=Name(id='getattr', ctx=Load()),
                    args=[
                      Name(id='plan', ctx=Load()),
                      Constant(value='complexity'),
                      Constant(value=None)]))]),
            Try(
              body=[
                Assign(
                  targets=[
                    Name(id='model', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='routing_policy',
                        ctx=Load()),
                      attr='select_model',
                      ctx=Load()),
                    keywords=[
                      keyword(
                        arg='task',
                        value=Attribute(
                          value=Name(id='prompt', ctx=Load()),
                          attr='prompt_id',
                          ctx=Load())),
                      keyword(
                        arg='complexity',
                        value=Name(id='complexity', ctx=Load())),
                      keyword(
                        arg='meta_profile',
                        value=Attribute(
                          value=Name(id='self', ctx=Load()),
                          attr='meta_profile',
                          ctx=Load()))]))],
              handlers=[
                ExceptHandler(
                  type=Name(id='Exception', ctx=Load()),
                  name='exc',
                  body=[
                    Expr(
                      value=Call(
                        func=Name(id='record_exception', ctx=Load()),
                        args=[
                          Constant(value='routing_policy_error'),
                          Name(id='exc', ctx=Load())])),
                    Raise()])]),
            Expr(
              value=Call(
                func=Name(id='record_event', ctx=Load()),
                args=[
                  Constant(value='llm_call_start'),
                  Dict(
                    keys=[
                      Constant(value='prompt_id'),
                      Constant(value='model'),
                      Constant(value='layer'),
                      Constant(value='agent')],
                    values=[
                      Attribute(
                        value=Name(id='prompt', ctx=Load()),
                        attr='prompt_id',
                        ctx=Load()),
                      Call(
                        func=Name(id='getattr', ctx=Load()),
                        args=[
                          Name(id='model', ctx=Load()),
                          Constant(value='name'),
                          Call(
                            func=Name(id='str', ctx=Load()),
                            args=[
                              Name(id='model', ctx=Load())])]),
                      Attribute(
                        value=Name(id='prompt', ctx=Load()),
                        attr='layer',
                        ctx=Load()),
                      Attribute(
                        value=Name(id='prompt', ctx=Load()),
                        attr='agent',
                        ctx=Load())])])),
            Try(
              body=[
                Assign(
                  targets=[
                    Name(id='raw', ctx=Store())],
                  value=Call(
                    func=Name(id='invoke_model', ctx=Load()),
                    keywords=[
                      keyword(
                        arg='model',
                        value=Name(id='model', ctx=Load())),
                      keyword(
                        arg='prompt',
                        value=Name(id='prompt', ctx=Load())),
                      keyword(
                        arg='sandbox',
                        value=Attribute(
                          value=Name(id='self', ctx=Load()),
                          attr='sandbox',
                          ctx=Load()))])),
                Expr(
                  value=Call(
                    func=Name(id='record_event', ctx=Load()),
                    args=[
                      Constant(value='llm_call_success'),
                      Dict(
                        keys=[
                          Constant(value='prompt_id'),
                          Constant(value='model'),
                          Constant(value='layer'),
                          Constant(value='agent')],
                        values=[
                          Attribute(
                            value=Name(id='prompt', ctx=Load()),
                            attr='prompt_id',
                            ctx=Load()),
                          Call(
                            func=Name(id='getattr', ctx=Load()),
                            args=[
                              Name(id='model', ctx=Load()),
                              Constant(value='name'),
                              Call(
                                func=Name(id='str', ctx=Load()),
                                args=[
                                  Name(id='model', ctx=Load())])]),
                          Attribute(
                            value=Name(id='prompt', ctx=Load()),
                            attr='layer',
                            ctx=Load()),
                          Attribute(
                            value=Name(id='prompt', ctx=Load()),
                            attr='agent',
                            ctx=Load())])])),
                Return(
