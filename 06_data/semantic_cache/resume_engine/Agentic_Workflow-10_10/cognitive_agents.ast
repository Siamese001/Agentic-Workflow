                              value=Name(id='sections', ctx=Load()),
                              attr='append',
                              ctx=Load()),
                            args=[
                              Call(
                                func=Name(id='DraftSection', ctx=Load()),
                                keywords=[
                                  keyword(
                                    arg='id',
                                    value=Call(
                                      func=Name(id='str', ctx=Load()),
                                      args=[
                                        BoolOp(
                                          op=Or(),
                                          values=[
                                            Call(
                                              func=Attribute(
                                                value=Name(id='item', ctx=Load()),
                                                attr='get',
                                                ctx=Load()),
                                              args=[
                                                Constant(value='id')]),
                                            Call(
                                              func=Name(id='len', ctx=Load()),
                                              args=[
                                                Name(id='sections', ctx=Load())])])])),
                                  keyword(
                                    arg='title',
                                    value=Call(
                                      func=Name(id='str', ctx=Load()),
                                      args=[
                                        BoolOp(
