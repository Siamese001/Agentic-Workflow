                                Attribute(
                                  value=Name(id='correction', ctx=Load()),
                                  attr='surface',
                                  ctx=Load()),
                                Attribute(
                                  value=Name(id='correction', ctx=Load()),
                                  attr='severity',
                                  ctx=Load()),
                                Attribute(
                                  value=Name(id='correction', ctx=Load()),
                                  attr='recommended_action',
                                  ctx=Load())]))]))],
                  handlers=[
