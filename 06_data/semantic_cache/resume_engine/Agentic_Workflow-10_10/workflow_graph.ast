                  value=Call(
                    func=Attribute(
                      value=Name(id='asyncio', ctx=Load()),
                      attr='create_task',
                      ctx=Load()),
                    args=[
                      Call(
                        func=Name(id='_run_node', ctx=Load()),
                        args=[
                          Attribute(
