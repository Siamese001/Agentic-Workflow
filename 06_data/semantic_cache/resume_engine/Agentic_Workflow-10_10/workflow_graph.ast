      body=[
        Expr(
          value=Constant(value='\n    Wraps each node call with:\n        • deterministic spans\n        • node lifecycle events\n        • structured failure handling\n        • typed node metadata\n\n    Returns:\n        - The result of fn() OR\n        - None on error (caller is responsible for fallback behavior).\n    ')),
        Assign(
          targets=[
            Name(id='span', ctx=Store())],
          value=Call(
            func=Name(id='start_span', ctx=Load()),
            args=[
              JoinedStr(
                values=[
                  Constant(value='workflow.'),
                  FormattedValue(
                    value=Name(id='node_name', ctx=Load()),
                    conversion=-1)])],
            keywords=[
              keyword(
                arg='ctx',
                value=Call(
                  func=Attribute(
                    value=Name(id='ctx', ctx=Load()),
                    attr='span_context',
                    ctx=Load())))])),
        Expr(
          value=Call(
            func=Name(id='emit_node_event', ctx=Load()),
            keywords=[
              keyword(
                arg='node',
