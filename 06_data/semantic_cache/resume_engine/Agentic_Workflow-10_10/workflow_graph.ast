                        Name(id='ctx', ctx=Load()),
                        Name(id='_execute_drafting', ctx=Load()),
                        Name(id='plans', ctx=Load()),
                        Name(id='strategy_result', ctx=Load()),
                        Name(id='rag_result', ctx=Load()),
                        Name(id='ctx', ctx=Load())]))),
                If(
                  test=Compare(
                    left=Name(id='drafting_result', ctx=Load()),
                    ops=[
                      Is()],
                    comparators=[
                      Constant(value=None)]),
                  body=[
                    Assign(
                      targets=[
                        Name(id='drafting_result', ctx=Store())],
                      value=Call(
                        func=Name(id='DraftingResult', ctx=Load()),
                        keywords=[
                          keyword(
                            arg='sections',
                            value=List(ctx=Load()))]))]),
                Assign(
                  targets=[
                    Name(id='qa_result', ctx=Store())],
                  value=Await(
                    value=Call(
                      func=Name(id='_run_node', ctx=Load()),
                      args=[
                        Attribute(
                          value=Name(id='Node', ctx=Load()),
                          attr='QA',
                          ctx=Load()),
                        Name(id='ctx', ctx=Load()),
                        Name(id='_execute_qa', ctx=Load()),
                        Name(id='plans', ctx=Load()),
                        Name(id='drafting_result', ctx=Load()),
                        Name(id='rag_result', ctx=Load()),
                        Name(id='ctx', ctx=Load())]))),
                If(
                  test=Compare(
                    left=Name(id='qa_result', ctx=Load()),
                    ops=[
                      Is()],
                    comparators=[
                      Constant(value=None)]),
                  body=[
                    Assign(
                      targets=[
                        Name(id='qa_result', ctx=Store())],
                      value=Call(
                        func=Name(id='QAResult', ctx=Load()),
                        keywords=[
                          keyword(
                            arg='findings',
                            value=List(ctx=Load()))]))]),
                Assign(
                  targets=[
                    Name(id='safety_result', ctx=Store())],
                  value=Await(
                    value=Call(
                      func=Name(id='_run_node', ctx=Load()),
                      args=[
                        Attribute(
                          value=Name(id='Node', ctx=Load()),
                          attr='SAFETY',
                          ctx=Load()),
                        Name(id='ctx', ctx=Load()),
                        Name(id='_execute_safety', ctx=Load()),
                        Name(id='plans', ctx=Load()),
                        Name(id='drafting_result', ctx=Load()),
                        Name(id='qa_result', ctx=Load()),
                        Name(id='ctx', ctx=Load())]))),
                If(
                  test=Compare(
                    left=Name(id='safety_result', ctx=Load()),
                    ops=[
                      Is()],
                    comparators=[
                      Constant(value=None)]),
                  body=[
                    Assign(
                      targets=[
                        Name(id='safety_result', ctx=Store())],
                      value=Call(
                        func=Name(id='SafetyResult', ctx=Load()),
                        keywords=[
                          keyword(
                            arg='findings',
                            value=List(ctx=Load()))]))]),
                Try(
                  body=[
                    Assign(
                      targets=[
                        Name(id='signals', ctx=Store())],
                      value=Call(
                        func=Name(id='evaluate_all_surfaces', ctx=Load()),
                        keywords=[
                          keyword(
                            arg='strategy',
                            value=Name(id='strategy_result', ctx=Load())),
                          keyword(
                            arg='rag',
                            value=Name(id='rag_result', ctx=Load())),
                          keyword(
                            arg='drafting',
                            value=Name(id='drafting_result', ctx=Load())),
                          keyword(
                            arg='qa',
                            value=Name(id='qa_result', ctx=Load())),
                          keyword(
                            arg='safety',
                            value=Name(id='safety_result', ctx=Load()))])),
                    Assign(
                      targets=[
                        Name(id='correction', ctx=Store())],
                      value=Call(
                        func=Name(id='aggregate_correction_signals', ctx=Load()),
                        args=[
