                            func=Name(id='log_exception', ctx=Load()),
                            args=[
                              Constant(value='workflow.correction_evaluation_error'),
                              Name(id='exc', ctx=Load())])),
                        Break()])])]),
            Return(
              value=Call(
                func=Name(id='L2ResultBundle', ctx=Load()),
                keywords=[
                  keyword(
                    arg='strategy',
                    value=Name(id='strategy_result', ctx=Load())),
                  keyword(
                    arg='rag',
                    value=Name(id='rag_result', ctx=Load())),
                  keyword(
                    arg='drafting',
                    value=Name(id='drafting_result', ctx=Load())),
                  keyword(
                    arg='qa',
                    value=Name(id='qa_result', ctx=Load())),
                  keyword(
                    arg='safety',
                    value=Name(id='safety_result', ctx=Load()))]))],
          handlers=[
            ExceptHandler(
              type=Name(id='Exception', ctx=Load()),
              name='exc',
              body=[
                Expr(
                  value=Call(
                    func=Name(id='log_exception', ctx=Load()),
                    args=[
                      Constant(value='workflow.run.fatal'),
                      Name(id='exc', ctx=Load())])),
                Return(
                  value=Call(
                    func=Attribute(
                      value=Name(id='L2ResultBundle', ctx=Load()),
                      attr='empty_with_error',
                      ctx=Load()),
                    args=[
                      Call(
                        func=Name(id='str', ctx=Load()),
                        args=[
                          Name(id='exc', ctx=Load())])]))])],
          finalbody=[
            Expr(
              value=Call(
                func=Name(id='end_span', ctx=Load()),
                args=[
                  Name(id='root_span', ctx=Load())]))])],
      returns=Name(id='L2ResultBundle', ctx=Load()))])