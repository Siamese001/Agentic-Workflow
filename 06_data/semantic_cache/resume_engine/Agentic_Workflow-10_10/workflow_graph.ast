                          Name(id='ctx', ctx=Load()),
                          Name(id='_execute_retrieval', ctx=Load()),
                          Name(id='plans', ctx=Load()),
                          Name(id='ctx', ctx=Load())])])),
                Assign(
                  targets=[
                    Name(id='strategy_result', ctx=Store())],
                  value=Await(
                    value=Name(id='strategy_task', ctx=Load()))),
                Assign(
