            arg='ctx',
            annotation=Name(id='ExecutionContext', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Phase-3 canonical workflow graph with bounded correction loop:\n\n          ┌───────────────┐\n          │   STRATEGY    │\n          └──────┬────────┘\n                 │\n                 │   (parallel)\n                 │\n          ┌──────▼────────┐\n          │   RETRIEVAL   │\n          └──────┬────────┘\n                 │  (fan-in: waits for strategy + retrieval)\n          ┌──────▼────────┐\n          │   DRAFTING    │\n          └──────┬────────┘\n                 │\n          ┌──────▼────────┐\n          │      QA       │\n          └──────┬────────┘\n                 │\n          ┌──────▼────────┐\n          │    SAFETY     │\n          └───────────────┘\n\n    Correction loop (meta-level):\n\n        1. Run full pass: Strategy + Retrieval → Drafting → QA → Safety.\n        2. Evaluate correction surfaces via self_correction.evaluate_all_surfaces.\n        3. Aggregate into a single CorrectionSignal.\n        4. If no correction needed, or max corrections reached: stop.\n        5. Otherwise, re-run the full pass (bounded by max_corrections).\n\n    Notes:\n        • No state mutation happens here; this is orchestration-only.\n        • Correction loop is bounded by ctx.config.max_corrections (if present).\n        • On any fatal failure, returns L2ResultBundle.empty_with_error(...).\n    ')),
        Assign(
          targets=[
            Name(id='root_span', ctx=Store())],
          value=Call(
            func=Name(id='start_span', ctx=Load()),
            args=[
              Constant(value='workflow.run')],
            keywords=[
              keyword(
                arg='ctx',
                value=Call(
                  func=Attribute(
                    value=Name(id='ctx', ctx=Load()),
                    attr='span_context',
                    ctx=Load())))])),
        Try(
          body=[
            Assign(
              targets=[
                Name(id='max_corrections', ctx=Store())],
              value=Constant(value=0)),
            Assign(
              targets=[
                Name(id='cfg', ctx=Store())],
              value=Call(
                func=Name(id='getattr', ctx=Load()),
                args=[
                  Name(id='ctx', ctx=Load()),
                  Constant(value='config'),
                  Constant(value=None)])),
            If(
              test=Compare(
                left=Name(id='cfg', ctx=Load()),
                ops=[
                  IsNot()],
                comparators=[
                  Constant(value=None)]),
              body=[
                Assign(
                  targets=[
                    Name(id='max_corrections', ctx=Store())],
                  value=Call(
                    func=Name(id='int', ctx=Load()),
                    args=[
                      BoolOp(
                        op=Or(),
                        values=[
                          Call(
                            func=Name(id='getattr', ctx=Load()),
                            args=[
                              Name(id='cfg', ctx=Load()),
                              Constant(value='max_corrections'),
                              Constant(value=0)]),
                          Constant(value=0)])]))]),
            Assign(
              targets=[
                Name(id='iterations', ctx=Store())],
              value=BinOp(
                left=Constant(value=1),
                op=Add(),
                right=Call(
                  func=Name(id='max', ctx=Load()),
                  args=[
                    Constant(value=0),
                    Name(id='max_corrections', ctx=Load())]))),
            AnnAssign(
              target=Name(id='strategy_result', ctx=Store()),
              annotation=Subscript(
                value=Name(id='Optional', ctx=Load()),
                slice=Name(id='StrategyResult', ctx=Load()),
                ctx=Load()),
              value=Constant(value=None),
              simple=1),
            AnnAssign(
              target=Name(id='rag_result', ctx=Store()),
              annotation=Subscript(
                value=Name(id='Optional', ctx=Load()),
                slice=Name(id='RAGResult', ctx=Load()),
                ctx=Load()),
              value=Constant(value=None),
              simple=1),
            AnnAssign(
              target=Name(id='drafting_result', ctx=Store()),
              annotation=Subscript(
                value=Name(id='Optional', ctx=Load()),
                slice=Name(id='DraftingResult', ctx=Load()),
                ctx=Load()),
              value=Constant(value=None),
              simple=1),
            AnnAssign(
              target=Name(id='qa_result', ctx=Store()),
              annotation=Subscript(
                value=Name(id='Optional', ctx=Load()),
                slice=Name(id='QAResult', ctx=Load()),
                ctx=Load()),
              value=Constant(value=None),
              simple=1),
            AnnAssign(
              target=Name(id='safety_result', ctx=Store()),
              annotation=Subscript(
                value=Name(id='Optional', ctx=Load()),
                slice=Name(id='SafetyResult', ctx=Load()),
                ctx=Load()),
              value=Constant(value=None),
              simple=1),
            For(
              target=Name(id='iteration', ctx=Store()),
              iter=Call(
                func=Name(id='range', ctx=Load()),
                args=[
                  Constant(value=1),
                  BinOp(
                    left=Name(id='iterations', ctx=Load()),
                    op=Add(),
                    right=Constant(value=1))]),
              body=[
                Expr(
                  value=Call(
                    func=Name(id='emit_node_event', ctx=Load()),
                    keywords=[
                      keyword(
                        arg='node',
