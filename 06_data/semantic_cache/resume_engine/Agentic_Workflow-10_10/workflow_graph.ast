                    If(
                      test=BoolOp(
                        op=Or(),
                        values=[
                          Compare(
                            left=Name(id='correction', ctx=Load()),
                            ops=[
                              Is()],
                            comparators=[
                              Constant(value=None)]),
                          UnaryOp(
                            op=Not(),
                            operand=Attribute(
