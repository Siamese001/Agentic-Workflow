                        comparators=[
                          Name(id='max_corrections', ctx=Load())]),
                      body=[
                        Break()]),
                    Expr(
                      value=Call(
                        func=Name(id='emit_node_event', ctx=Load()),
                        keywords=[
                          keyword(
                            arg='node',
                            value=Constant(value='workflow_correction')),
                          keyword(
                            arg='status',
                            value=Constant(value='requested')),
                          keyword(
                            arg='details',
                            value=Dict(
                              keys=[
                                Constant(value='iteration'),
                                Constant(value='surface'),
                                Constant(value='severity'),
                                Constant(value='recommended_action')],
                              values=[
