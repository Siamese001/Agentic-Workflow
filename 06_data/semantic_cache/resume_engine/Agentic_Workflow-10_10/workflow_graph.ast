                        value=Dict(
                          keys=[
                            Constant(value='iteration'),
                            Constant(value='max_corrections')],
                          values=[
                            Name(id='iteration', ctx=Load()),
                            Name(id='max_corrections', ctx=Load())]))])),
                Assign(
                  targets=[
                    Name(id='strategy_task', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='asyncio', ctx=Load()),
                      attr='create_task',
                      ctx=Load()),
