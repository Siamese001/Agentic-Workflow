Module(
  body=[
    Expr(
      value=Constant(value='\nL3 Orchestration Layer (v10_10 · Phase 3 — FINAL)\n==================================================\n\nResponsibilities (strict L3-only):\n\n    • Orchestrate the end-to-end workflow at the L3 layer.\n    • Delegate all DAG execution and correction-loop logic to workflow_graph.\n    • Wrap orchestration in deterministic spans and node-level telemetry.\n    • Coordinate with L2 (execution) and L4/L5 (state, safety) through typed\n      result bundles only.\n\nThis module MUST NOT:\n    • Call LLMs directly (L2-only, via cognitive_agents).\n    • Perform retrieval, ranking, or prompting (RAG stack only).\n    • Mutate persisted state (L4-only via StateTransitionEvent).\n    • Enforce safety policies (L5-only via SafetyPolicy / PolicyDecisionEvent).\n\nPublic API:\n\n    async def orchestrate_execution(plans, ctx) -> L2ResultBundle\n        Canonical Phase-3 orchestration entrypoint.\n\n    async def run_l3_workflow(plans, ctx) -> L2ResultBundle\n        Backward-compatible alias preserved for older call sites.\n\nAll detailed DAG semantics (node-level parallelism, failure modes,\ncorrection loop) live in workflow_graph.run_workflow_graph.\n')),
    ImportFrom(
      module='__future__',
      names=[
        alias(name='annotations')],
      level=0),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Optional')],
      level=0),
    ImportFrom(
      module='models',
      names=[
        alias(name='WorkflowPlanBundle'),
        alias(name='ExecutionContext'),
        alias(name='L2ResultBundle')],
      level=0),
    ImportFrom(
      module='observability',
      names=[
        alias(name='start_span'),
        alias(name='end_span'),
        alias(name='emit_node_event'),
        alias(name='log_exception')],
      level=0),
    ImportFrom(
      module='workflow_graph',
      names=[
        alias(name='run_workflow_graph')],
      level=0),
    AsyncFunctionDef(
      name='orchestrate_execution',
      args=arguments(
        args=[
          arg(
            arg='plans',
            annotation=Name(id='WorkflowPlanBundle', ctx=Load())),
          arg(
            arg='ctx',
            annotation=Name(id='ExecutionContext', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Orchestrate the full L2 workflow using the Phase-3 DAG + correction loop.\n\n    Steps:\n        1. Start an L3-level span ("l3.orchestrate").\n        2. Emit high-level L3 node events (start/success/error).\n        3. Delegate to workflow_graph.run_workflow_graph for actual DAG\n           execution and correction-loop handling.\n        4. Catch any fatal errors and return\n           L2ResultBundle.empty_with_error(message).\n    ')),
        Assign(
          targets=[
            Name(id='span', ctx=Store())],
          value=Call(
            func=Name(id='start_span', ctx=Load()),
            args=[
              Constant(value='l3.orchestrate')],
            keywords=[
              keyword(
                arg='ctx',
                value=Call(
                  func=Attribute(
                    value=Name(id='ctx', ctx=Load()),
                    attr='span_context',
                    ctx=Load())))])),
        Expr(
          value=Call(
            func=Name(id='emit_node_event', ctx=Load()),
            args=[
              Constant(value='l3_orchestrator'),
              Constant(value='start')],
            keywords=[
              keyword(
                arg='details',
                value=Constant(value=None))])),
        Try(
          body=[
            Assign(
              targets=[
                Name(id='results', ctx=Store())],
              value=Await(
                value=Call(
                  func=Name(id='run_workflow_graph', ctx=Load()),
                  args=[
                    Name(id='plans', ctx=Load()),
                    Name(id='ctx', ctx=Load())]))),
            Expr(
              value=Call(
                func=Name(id='emit_node_event', ctx=Load()),
                args=[
                  Constant(value='l3_orchestrator'),
                  Constant(value='success')],
                keywords=[
                  keyword(
                    arg='details',
                    value=Constant(value=None))])),
            Return(
              value=Name(id='results', ctx=Load()))],
          handlers=[
            ExceptHandler(
              type=Name(id='Exception', ctx=Load()),
              name='exc',
              body=[
                Expr(
                  value=Call(
                    func=Name(id='log_exception', ctx=Load()),
                    args=[
                      Constant(value='l3.run_fatal'),
                      Name(id='exc', ctx=Load())])),
                Expr(
                  value=Call(
                    func=Name(id='emit_node_event', ctx=Load()),
                    args=[
                      Constant(value='l3_orchestrator'),
                      Constant(value='error')],
                    keywords=[
                      keyword(
                        arg='details',
                        value=Call(
                          func=Name(id='str', ctx=Load()),
                          args=[
                            Name(id='exc', ctx=Load())]))])),
                Return(
                  value=Call(
                    func=Attribute(
                      value=Name(id='L2ResultBundle', ctx=Load()),
                      attr='empty_with_error',
                      ctx=Load()),
                    args=[
                      Call(
                        func=Name(id='str', ctx=Load()),
                        args=[
                          Name(id='exc', ctx=Load())])]))])],
          finalbody=[
            Expr(
              value=Call(
                func=Name(id='end_span', ctx=Load()),
                args=[
                  Name(id='span', ctx=Load())]))])],
      returns=Name(id='L2ResultBundle', ctx=Load())),
    AsyncFunctionDef(
      name='run_l3_workflow',
      args=arguments(
        args=[
          arg(
            arg='plans',
            annotation=Name(id='WorkflowPlanBundle', ctx=Load())),
          arg(
            arg='ctx',
            annotation=Name(id='ExecutionContext', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Backward-compatible alias for orchestrate_execution.\n\n    Older callers (e.g., earlier L4/state adapter or entrypoint code) may\n    still refer to run_l3_workflow; this function keeps that surface stable\n    while delegating all orchestration to orchestrate_execution.\n    ')),
        Return(
          value=Await(
            value=Call(
              func=Name(id='orchestrate_execution', ctx=Load()),
              args=[
                Name(id='plans', ctx=Load()),
                Name(id='ctx', ctx=Load())])))],
      returns=Name(id='L2ResultBundle', ctx=Load()))])