                keywords=[
                  keyword(
                    arg='sort_keys',
                    value=Constant(value=True)),
                  keyword(
                    arg='default',
                    value=Name(id='str', ctx=Load()))])),
            Assign(
              targets=[
                Name(id='digest', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Call(
                    func=Attribute(
                      value=Name(id='hashlib', ctx=Load()),
                      attr='sha256',
                      ctx=Load()),
                    args=[
                      Call(
