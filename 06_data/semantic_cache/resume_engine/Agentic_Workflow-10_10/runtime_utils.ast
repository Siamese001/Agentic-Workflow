                                attr='getenv',
                                ctx=Load()),
                              args=[
                                Constant(value='ANTHROPIC_API_KEY')]))])),
                    Assign(
                      targets=[
                        Name(id='resp', ctx=Store())],
                      value=Call(
                        func=Attribute(
                          value=Attribute(
                            value=Name(id='client', ctx=Load()),
                            attr='messages',
                            ctx=Load()),
                          attr='create',
                          ctx=Load()),
                        keywords=[
                          keyword(
                            arg='model',
                            value=Name(id='model', ctx=Load())),
                          keyword(
                            arg='messages',
                            value=List(
                              elts=[
                                Dict(
                                  keys=[
