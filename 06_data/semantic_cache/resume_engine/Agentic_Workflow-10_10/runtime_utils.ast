    ClassDef(
      name='SandboxConfig',
      body=[
        Expr(
          value=Constant(value='\n    Logical sandbox configuration for tool/LLM invocations.\n\n    Actual isolation is provided by the surrounding environment (e.g.,\n    container). This object provides *logical* constraints:\n\n        • allow_network: whether network calls are permitted.\n        • request_timeout_s: per-call timeout.\n        • max_tokens_per_call: cap on LLM token generation.\n    ')),
        AnnAssign(
          target=Name(id='name', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          value=Constant(value='default'),
          simple=1),
        AnnAssign(
          target=Name(id='allow_network', ctx=Store()),
          annotation=Name(id='bool', ctx=Load()),
          value=Constant(value=True),
          simple=1),
        AnnAssign(
          target=Name(id='request_timeout_s', ctx=Store()),
          annotation=Name(id='int', ctx=Load()),
          value=Constant(value=60),
          simple=1),
        AnnAssign(
          target=Name(id='max_tokens_per_call', ctx=Store()),
          annotation=Name(id='int', ctx=Load()),
          value=Constant(value=2048),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    FunctionDef(
      name='get_sandbox',
      args=arguments(
        args=[
          arg(
