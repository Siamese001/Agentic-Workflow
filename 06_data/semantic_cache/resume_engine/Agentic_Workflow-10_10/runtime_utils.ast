Module(
  body=[
    Expr(
      value=Constant(value='\nUnified Runtime Utilities (v10_10) — INFRASTRUCTURE LAYER\n=========================================================\n\nThis module is the v10_10 runtime utility layer.\n\nResponsibilities:\n    1. Exception hierarchy for runtime surfaces.\n    2. SandboxConfig + get_sandbox() for logical isolation.\n    3. PredictiveCacheManager for in-memory predictive/semantic caching.\n    4. invoke_model() unified LLM gateway (OpenAI + Anthropic).\n\nDesign constraints:\n    • No planning (L1).\n    • No tool logic besides LLM call wrappers (L2).\n    • No DAG/orchestration (L3).\n    • No state mutation of WorkflowState (L4).\n    • No safety/policy decisions (L5).\n    • No meta-learning or telemetry aggregation (telemetry is delegated\n      to observability.py via record_event / record_exception).\n')),
    ImportFrom(
      module='__future__',
      names=[
        alias(name='annotations')],
      level=0),
    Import(
      names=[
        alias(name='hashlib')]),
    Import(
      names=[
        alias(name='json')]),
    Import(
      names=[
        alias(name='os')]),
    Import(
      names=[
        alias(name='time')]),
    ImportFrom(
      module='dataclasses',
      names=[
        alias(name='dataclass'),
        alias(name='field')],
      level=0),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Any'),
        alias(name='Dict'),
        alias(name='Optional'),
        alias(name='Tuple')],
      level=0),
    ImportFrom(
      module='observability',
      names=[
        alias(name='record_event'),
        alias(name='record_exception')],
      level=0),
    ClassDef(
      name='ValidationError',
      bases=[
        Name(id='Exception', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Malformed state, plan, or configuration (runtime-level).'))]),
    ClassDef(
      name='ToolExecutionError',
      bases=[
        Name(id='Exception', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Execution error during tool / sandboxed operation.'))]),
