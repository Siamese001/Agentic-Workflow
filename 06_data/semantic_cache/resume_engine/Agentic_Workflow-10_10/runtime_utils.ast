                          value=Name(id='raw', ctx=Load()),
                          attr='encode',
                          ctx=Load()),
                        args=[
                          Constant(value='utf-8')])]),
                  attr='hexdigest',
                  ctx=Load()))),
            Return(
              value=JoinedStr(
                values=[
                  FormattedValue(
                    value=Name(id='domain', ctx=Load()),
                    conversion=-1),
                  Constant(value=':'),
                  FormattedValue(
                    value=Name(id='digest', ctx=Load()),
                    conversion=-1)]))],
          returns=Name(id='str', ctx=Load())),
        FunctionDef(
          name='_safe_serialize',
          args=arguments(
            args=[
              arg(
                arg='obj',
                annotation=Name(id='Any', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Convert objects into a JSON-serializable structure where possible.\n        ')),
            If(
              test=Compare(
                left=Name(id='obj', ctx=Load()),
                ops=[
                  Is()],
                comparators=[
                  Constant(value=None)]),
              body=[
                Return(
                  value=Constant(value=None))]),
            If(
              test=Call(
                func=Name(id='isinstance', ctx=Load()),
                args=[
                  Name(id='obj', ctx=Load()),
                  Tuple(
                    elts=[
                      Name(id='str', ctx=Load()),
                      Name(id='int', ctx=Load()),
                      Name(id='float', ctx=Load()),
                      Name(id='bool', ctx=Load())],
                    ctx=Load())]),
              body=[
                Return(
                  value=Name(id='obj', ctx=Load()))]),
            If(
              test=Call(
                func=Name(id='isinstance', ctx=Load()),
