              targets=[
                Name(id='max_tokens', ctx=Store())],
              value=Attribute(
                value=Name(id='sandbox', ctx=Load()),
                attr='max_tokens_per_call',
                ctx=Load()))]),
        Assign(
          targets=[
            Name(id='provider', ctx=Store())],
          value=Call(
            func=Name(id='_infer_provider', ctx=Load()),
            args=[
              Name(id='model', ctx=Load())])),
        Expr(
          value=Call(
            func=Name(id='record_event', ctx=Load()),
