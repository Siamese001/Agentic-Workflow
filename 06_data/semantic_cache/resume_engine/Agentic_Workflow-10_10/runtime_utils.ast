            Assign(
              targets=[
                Name(id='entry', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='_store',
                    ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
