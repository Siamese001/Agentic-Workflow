            annotation=Subscript(
              value=Name(id='Optional', ctx=Load()),
              slice=Name(id='SandboxConfig', ctx=Load()),
              ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Return a non-None SandboxConfig, falling back to defaults.\n    ')),
        Return(
          value=BoolOp(
            op=Or(),
            values=[
              Name(id='config', ctx=Load()),
              Call(
                func=Name(id='SandboxConfig', ctx=Load()))]))],
      returns=Name(id='SandboxConfig', ctx=Load())),
    ClassDef(
      name='PredictiveCacheManager',
      body=[
        Expr(
          value=Constant(value='\n    Lightweight in-memory predictive/semantic cache.\n\n    Intended use:\n        • Cache expensive L2 operations (RAG, cognitive agent calls).\n        • Keyed by (domain, plan, context signature).\n\n    Behavior:\n        • In-memory only.\n        • Evicts oldest entry when capacity exceeded.\n    ')),
        AnnAssign(
          target=Name(id='max_entries', ctx=Store()),
          annotation=Name(id='int', ctx=Load()),
          value=Constant(value=1024),
          simple=1),
        AnnAssign(
          target=Name(id='_store', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
