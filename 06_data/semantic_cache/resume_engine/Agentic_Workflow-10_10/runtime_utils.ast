              value=Constant(value='\n        Build a stable cache key based on:\n            - domain         (e.g., "rag", "strategy", "drafting")\n            - plan           (serialized in a stable way)\n            - selected ctx fields (e.g., job id, resume id)\n        ')),
            Assign(
