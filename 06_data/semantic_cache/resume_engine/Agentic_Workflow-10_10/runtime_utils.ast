                              keys=[
                                Constant(value='role'),
                                Constant(value='content')],
                              values=[
                                Constant(value='user'),
                                Name(id='prompt', ctx=Load())])],
                          ctx=Load())),
                      keyword(
                        arg='temperature',
                        value=Name(id='temperature', ctx=Load())),
                      keyword(
                        arg='max_tokens',
                        value=Name(id='max_tokens', ctx=Load())),
                      keyword(
                        arg='timeout',
                        value=Attribute(
                          value=Name(id='sandbox', ctx=Load()),
                          attr='request_timeout_s',
                          ctx=Load()))])),
                Assign(
