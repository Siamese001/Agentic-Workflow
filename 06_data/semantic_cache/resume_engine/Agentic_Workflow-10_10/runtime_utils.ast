                    Name(id='text', ctx=Store())],
                  value=BoolOp(
                    op=Or(),
                    values=[
                      Attribute(
                        value=Attribute(
                          value=Subscript(
                            value=Attribute(
                              value=Name(id='resp', ctx=Load()),
                              attr='choices',
                              ctx=Load()),
                            slice=Constant(value=0),
                            ctx=Load()),
                          attr='message',
                          ctx=Load()),
                        attr='content',
                        ctx=Load()),
                      Constant(value='')]))],
              orelse=[
                If(
                  test=Compare(
                    left=Name(id='provider', ctx=Load()),
                    ops=[
                      Eq()],
