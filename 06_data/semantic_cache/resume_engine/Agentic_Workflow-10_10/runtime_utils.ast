    FunctionDef(
      name='_infer_provider',
      args=arguments(
        args=[
          arg(
            arg='model',
            annotation=Name(id='str', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Infer provider from model string.\n\n    Heuristics (deterministic):\n\n        • If "claude" in model → "anthropic"\n        • Else → "openai"\n    ')),
        Assign(
          targets=[
            Name(id='m', ctx=Store())],
          value=Call(
