                          attr='chat',
                          ctx=Load()),
                        attr='completions',
                        ctx=Load()),
                      attr='create',
                      ctx=Load()),
                    keywords=[
                      keyword(
                        arg='model',
                        value=Name(id='model', ctx=Load())),
                      keyword(
                        arg='messages',
                        value=List(
                          elts=[
