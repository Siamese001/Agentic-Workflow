                    Name(id='value', ctx=Store())],
                  ctx=Store())],
              value=Name(id='entry', ctx=Load())),
            Expr(
              value=Call(
                func=Name(id='record_event', ctx=Load()),
                args=[
                  Constant(value='predictive_cache_hit'),
                  Dict(
                    keys=[
                      Constant(value='key'),
                      Constant(value='age_s')],
                    values=[
