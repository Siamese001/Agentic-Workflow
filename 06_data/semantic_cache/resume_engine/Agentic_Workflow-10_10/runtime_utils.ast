                        Name(id='parts', ctx=Store())],
                      value=List(ctx=Load())),
                    For(
                      target=Name(id='block', ctx=Store()),
                      iter=Attribute(
                        value=Name(id='resp', ctx=Load()),
                        attr='content',
                        ctx=Load()),
                      body=[
                        If(
                          test=Compare(
