      returns=Constant(value=None)),
    FunctionDef(
      name='record_event',
      args=arguments(
        args=[
          arg(
            arg='name',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='attributes',
            annotation=Subscript(
              value=Name(id='Dict', ctx=Load()),
              slice=Tuple(
                elts=[
                  Name(id='str', ctx=Load()),
                  Name(id='Any', ctx=Load())],
                ctx=Load()),
              ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Convenience wrapper so infrastructure code can call record_event(...)\n    without depending on TelemetryEvent directly.\n    ')),
        Expr(
          value=Call(
            func=Name(id='emit_telemetry_event', ctx=Load()),
            args=[
              Name(id='name', ctx=Load()),
              Name(id='attributes', ctx=Load())]))],
      returns=Constant(value=None)),
    FunctionDef(
