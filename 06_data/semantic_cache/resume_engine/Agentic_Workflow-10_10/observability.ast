                  Name(id='str', ctx=Load()),
                  Name(id='Any', ctx=Load())],
                ctx=Load()),
              ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Close a previously-started span.\n\n    If the span is not in the stack (already closed or unknown), this\n    is a no-op.\n    ')),
        If(
          test=Compare(
            left=Name(id='span_record', ctx=Load()),
            ops=[
              NotIn()],
            comparators=[
              Name(id='_span_stack', ctx=Load())]),
          body=[
            Return()]),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='_span_stack', ctx=Load()),
              attr='remove',
              ctx=Load()),
            args=[
              Name(id='span_record', ctx=Load())])),
        Assign(
          targets=[
            Name(id='end_ms', ctx=Store())],
          value=Call(
            func=Name(id='_now_ms', ctx=Load()))),
        Assign(
          targets=[
            Name(id='duration', ctx=Store())],
          value=BinOp(
            left=Name(id='end_ms', ctx=Load()),
            op=Sub(),
            right=Subscript(
              value=Name(id='span_record', ctx=Load()),
              slice=Constant(value='start_ms'),
              ctx=Load()))),
        Expr(
          value=Call(
            func=Name(id='_log', ctx=Load()),
            args=[
              Call(
                func=Name(id='TelemetryEvent', ctx=Load()),
                keywords=[
                  keyword(
                    arg='name',
                    value=Subscript(
                      value=Name(id='span_record', ctx=Load()),
                      slice=Constant(value='name'),
                      ctx=Load())),
                  keyword(
                    arg='span_id',
                    value=Subscript(
                      value=Name(id='span_record', ctx=Load()),
                      slice=Constant(value='span_id'),
                      ctx=Load())),
                  keyword(
                    arg='ts_ms',
                    value=Name(id='end_ms', ctx=Load())),
                  keyword(
                    arg='attributes',
                    value=Dict(
                      keys=[
                        Constant(value='event_type'),
                        Constant(value='span_id'),
                        Constant(value='duration_ms'),
                        Constant(value='ctx')],
                      values=[
                        Constant(value='span_end'),
                        Subscript(
                          value=Name(id='span_record', ctx=Load()),
                          slice=Constant(value='span_id'),
                          ctx=Load()),
                        Name(id='duration', ctx=Load()),
                        Call(
                          func=Attribute(
                            value=Name(id='span_record', ctx=Load()),
                            attr='get',
                            ctx=Load()),
                          args=[
                            Constant(value='ctx'),
                            Dict()])]))])]))],
      returns=Constant(value=None)),
    FunctionDef(
      name='emit_node_event',
      args=arguments(
        args=[
          arg(
            arg='node',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='status',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='details',
            annotation=Subscript(
              value=Name(id='Optional', ctx=Load()),
              slice=Name(id='str', ctx=Load()),
              ctx=Load()))],
        defaults=[
          Constant(value=None)]),
      body=[
        Expr(
          value=Constant(value='\n    Node-level events for L3 orchestration visibility.\n\n    Example:\n        emit_node_event("strategy", "start")\n        emit_node_event("strategy", "success")\n    ')),
        Expr(
          value=Call(
            func=Name(id='_log', ctx=Load()),
            args=[
              Call(
                func=Name(id='TelemetryEvent', ctx=Load()),
                keywords=[
                  keyword(
                    arg='name',
                    value=Name(id='node', ctx=Load())),
                  keyword(
                    arg='ts_ms',
                    value=Call(
                      func=Name(id='_now_ms', ctx=Load()))),
                  keyword(
                    arg='attributes',
                    value=Dict(
                      keys=[
                        Constant(value='event_type'),
                        Constant(value='status'),
                        Constant(value='details')],
                      values=[
                        Constant(value='node'),
                        Name(id='status', ctx=Load()),
                        Name(id='details', ctx=Load())]))])]))],
      returns=Constant(value=None)),
    FunctionDef(
      name='emit_telemetry_event',
      args=arguments(
        args=[
          arg(
            arg='name',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='attributes',
            annotation=Subscript(
              value=Name(id='Dict', ctx=Load()),
              slice=Tuple(
                elts=[
                  Name(id='str', ctx=Load()),
                  Name(id='Any', ctx=Load())],
                ctx=Load()),
              ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    General-purpose event emission for arbitrary telemetry use cases.\n    ')),
