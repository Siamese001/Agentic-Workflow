            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='exc',
            annotation=Name(id='Exception', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Emit an error-level telemetry event for exceptions.\n    ')),
        Expr(
          value=Call(
            func=Name(id='_log', ctx=Load()),
            args=[
