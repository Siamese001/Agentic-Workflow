        Expr(
          value=Call(
            func=Name(id='log_exception', ctx=Load()),
            args=[
              Name(id='name', ctx=Load()),
              Name(id='exc', ctx=Load())]))],
      returns=Constant(value=None)),
    FunctionDef(
