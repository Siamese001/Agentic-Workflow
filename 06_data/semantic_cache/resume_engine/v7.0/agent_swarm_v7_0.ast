                    Constant(value='results'),
                    List(ctx=Load())]))])),
        Return(
          value=Dict(
            keys=[
              Constant(value='artifacts')],
            values=[
              Dict(
                keys=[
                  Constant(value='rag_queries'),
                  Constant(value='rag_search_results'),
                  Constant(value='rag_critique')],
                values=[
                  Name(id='queries', ctx=Load()),
                  Call(
                    func=Attribute(
                      value=Name(id='search_results', ctx=Load()),
                      attr='get',
                      ctx=Load()),
                    args=[
                      Constant(value='results'),
                      List(ctx=Load())]),
                  Name(id='critique_result', ctx=Load())])]))],
      returns=Subscript(
        value=Name(id='Dict', ctx=Load()),
        slice=Tuple(
          elts=[
            Name(id='str', ctx=Load()),
            Name(id='Any', ctx=Load())],
          ctx=Load()),
        ctx=Load())),
    FunctionDef(
      name='run_drafting_stack',
      args=arguments(
        args=[
          arg(
            arg='state',
            annotation=Constant(value='GraphState'))]),
      body=[
        Expr(
          value=Constant(value='Node: Runs Step 3: Drafting (Prompt, Bullets, Adversarial)')),
        Assign(
          targets=[
            Name(id='blackboard', ctx=Store())],
          value=Call(
            func=Name(id='get_blackboard', ctx=Load()),
            args=[
              Name(id='state', ctx=Load())])),
        Assign(
          targets=[
            Name(id='prompt_agent', ctx=Store())],
          value=Call(
            func=Name(id='PromptStackAgent', ctx=Load()),
            args=[
              Name(id='blackboard', ctx=Load())],
            keywords=[
              keyword(
                arg='debug_mode',
                value=Constant(value=True))])),
        Assign(
          targets=[
            Name(id='prompt_result', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='prompt_agent', ctx=Load()),
              attr='run',
              ctx=Load()))),
        Assign(
          targets=[
            Name(id='bullet_agent', ctx=Store())],
          value=Call(
            func=Name(id='BulletSwarmAgent', ctx=Load()),
            args=[
              Name(id='blackboard', ctx=Load())],
            keywords=[
              keyword(
                arg='debug_mode',
                value=Constant(value=True))])),
        Assign(
          targets=[
            Name(id='bullets', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='bullet_agent', ctx=Load()),
              attr='run',
              ctx=Load()))),
        Assign(
          targets=[
            Name(id='drafting_agent', ctx=Store())],
          value=Call(
            func=Name(id='AdversarialDraftingRouter', ctx=Load()),
            args=[
              Name(id='blackboard', ctx=Load())],
            keywords=[
              keyword(
                arg='debug_mode',
                value=Constant(value=True))])),
        Assign(
          targets=[
            Name(id='final_draft', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='drafting_agent', ctx=Load()),
              attr='run',
              ctx=Load()))),
        Return(
          value=Dict(
            keys=[
              Constant(value='artifacts')],
            values=[
              Dict(
                keys=[
                  Constant(value='final_drafting_prompt'),
                  Constant(value='generated_bullets'),
                  Constant(value='final_draft')],
                values=[
                  Call(
                    func=Attribute(
                      value=Name(id='prompt_result', ctx=Load()),
                      attr='get',
                      ctx=Load()),
                    args=[
                      Constant(value='final_prompt')]),
                  Name(id='bullets', ctx=Load()),
                  Name(id='final_draft', ctx=Load())])]))],
      returns=Subscript(
        value=Name(id='Dict', ctx=Load()),
        slice=Tuple(
          elts=[
            Name(id='str', ctx=Load()),
            Name(id='Any', ctx=Load())],
          ctx=Load()),
        ctx=Load())),
    FunctionDef(
      name='run_qa_swarm',
      args=arguments(
        args=[
          arg(
            arg='state',
            annotation=Constant(value='GraphState'))]),
      body=[
        Expr(
          value=Constant(value='Node: Runs Step 4: QA (LLM and Logic)')),
        Assign(
          targets=[
            Name(id='blackboard', ctx=Store())],
          value=Call(
            func=Name(id='get_blackboard', ctx=Load()),
            args=[
              Name(id='state', ctx=Load())])),
        Assign(
          targets=[
            Name(id='final_draft', ctx=Store())],
          value=Subscript(
            value=Subscript(
              value=Name(id='state', ctx=Load()),
              slice=Constant(value='artifacts'),
              ctx=Load()),
            slice=Constant(value='final_draft'),
            ctx=Load())),
        Assign(
          targets=[
            Name(id='qa_llm_agent', ctx=Store())],
          value=Call(
            func=Name(id='AtomicQASwarmLLM', ctx=Load()),
            args=[
              Name(id='blackboard', ctx=Load())],
            keywords=[
              keyword(
                arg='debug_mode',
                value=Constant(value=True))])),
        Assign(
          targets=[
            Name(id='llm_results', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='qa_llm_agent', ctx=Load()),
              attr='run',
              ctx=Load()),
            keywords=[
              keyword(
                arg='final_draft',
                value=Name(id='final_draft', ctx=Load()))])),
        Assign(
          targets=[
            Name(id='qa_logic_agent', ctx=Store())],
          value=Call(
            func=Name(id='AtomicQASwarmLogic', ctx=Load()),
            args=[
              Name(id='blackboard', ctx=Load())],
            keywords=[
              keyword(
                arg='debug_mode',
                value=Constant(value=True))])),
        Assign(
          targets=[
            Name(id='logic_results', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='qa_logic_agent', ctx=Load()),
              attr='run',
              ctx=Load()),
            keywords=[
              keyword(
                arg='final_draft',
                value=Name(id='final_draft', ctx=Load()))])),
        Assign(
          targets=[
            Name(id='all_qa_results', ctx=Store())],
          value=BinOp(
            left=Name(id='llm_results', ctx=Load()),
            op=Add(),
            right=Name(id='logic_results', ctx=Load()))),
        Assign(
          targets=[
            Name(id='failed_checks', ctx=Store())],
          value=ListComp(
            elt=Name(id='r', ctx=Load()),
            generators=[
              comprehension(
                target=Name(id='r', ctx=Store()),
                iter=Name(id='all_qa_results', ctx=Load()),
                ifs=[
                  UnaryOp(
                    op=Not(),
                    operand=Call(
                      func=Attribute(
                        value=Name(id='r', ctx=Load()),
                        attr='get',
                        ctx=Load()),
                      args=[
                        Constant(value='passed'),
                        Constant(value=False)]))],
                is_async=0)])),
        Assign(
          targets=[
            Name(id='validation_summary', ctx=Store())],
          value=Dict(
            keys=[
              Constant(value='overall_passed'),
              Constant(value='failed_checks_count'),
              Constant(value='failed_checks'),
              Constant(value='all_results')],
            values=[
              Compare(
                left=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Name(id='failed_checks', ctx=Load())]),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value=0)]),
              Call(
                func=Name(id='len', ctx=Load()),
                args=[
                  Name(id='failed_checks', ctx=Load())]),
              Name(id='failed_checks', ctx=Load()),
              Name(id='all_qa_results', ctx=Load())])),
        Assign(
          targets=[
            Name(id='feedback_logger', ctx=Store())],
          value=Call(
            func=Name(id='FeedbackLoggerAgent', ctx=Load()),
            keywords=[
              keyword(
                arg='log_path',
                value=Attribute(
                  value=Attribute(
                    value=Name(id='CONFIG', ctx=Load()),
                    attr='meta_loop_config',
                    ctx=Load()),
                  attr='feedback_log_path',
                  ctx=Load()))])),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='feedback_logger', ctx=Load()),
              attr='log',
              ctx=Load()),
            args=[
              Name(id='validation_summary', ctx=Load()),
              Subscript(
                value=Name(id='state', ctx=Load()),
                slice=Constant(value='workflow_id'),
                ctx=Load())])),
        Return(
          value=Dict(
            keys=[
              Constant(value='artifacts')],
            values=[
              Dict(
                keys=[
                  Constant(value='qa_llm_results'),
                  Constant(value='qa_logic_results'),
                  Constant(value='validation_results')],
                values=[
                  Name(id='llm_results', ctx=Load()),
                  Name(id='logic_results', ctx=Load()),
                  Name(id='validation_summary', ctx=Load())])]))],
      returns=Subscript(
        value=Name(id='Dict', ctx=Load()),
        slice=Tuple(
          elts=[
            Name(id='str', ctx=Load()),
            Name(id='Any', ctx=Load())],
          ctx=Load()),
        ctx=Load())),
    FunctionDef(
      name='run_replanner',
      args=arguments(
        args=[
          arg(
            arg='state',
            annotation=Constant(value='GraphState'))]),
      body=[
        Expr(
          value=Constant(value='Node: Runs Step 3 (SC Paths): Re-Planner')),
        Assign(
          targets=[
            Name(id='blackboard', ctx=Store())],
          value=Call(
            func=Name(id='get_blackboard', ctx=Load()),
            args=[
              Name(id='state', ctx=Load())])),
        Assign(
          targets=[
            Name(id='agent', ctx=Store())],
          value=Call(
            func=Name(id='WorkflowRePlannerAgent', ctx=Load()),
            args=[
              Name(id='blackboard', ctx=Load())],
            keywords=[
              keyword(
                arg='debug_mode',
                value=Constant(value=True))])),
        Assign(
          targets=[
            Name(id='failed_checks', ctx=Store())],
          value=Subscript(
            value=Subscript(
              value=Subscript(
                value=Name(id='state', ctx=Load()),
                slice=Constant(value='artifacts'),
                ctx=Load()),
              slice=Constant(value='validation_results'),
              ctx=Load()),
            slice=Constant(value='failed_checks'),
            ctx=Load())),
        Assign(
          targets=[
            Name(id='plan', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='agent', ctx=Load()),
              attr='run',
              ctx=Load()),
            keywords=[
              keyword(
                arg='failed_qa_results',
                value=Name(id='failed_checks', ctx=Load()))])),
        Assign(
          targets=[
            Name(id='new_replan_count', ctx=Store())],
          value=BinOp(
            left=Call(
              func=Attribute(
                value=Name(id='state', ctx=Load()),
                attr='get',
                ctx=Load()),
              args=[
                Constant(value='replan_count'),
                Constant(value=0)]),
            op=Add(),
            right=Constant(value=1))),
        Assign(
          targets=[
            Name(id='artifacts', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Subscript(
                value=Name(id='state', ctx=Load()),
                slice=Constant(value='artifacts'),
                ctx=Load()),
              attr='copy',
              ctx=Load()))),
        For(
          target=Name(id='key', ctx=Store()),
          iter=List(
            elts=[
              Constant(value='final_drafting_prompt'),
              Constant(value='generated_bullets'),
              Constant(value='final_draft'),
              Constant(value='qa_llm_results'),
              Constant(value='qa_logic_results'),
              Constant(value='validation_results'),
              Constant(value='recovery_plan')],
            ctx=Load()),
          body=[
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='artifacts', ctx=Load()),
                  attr='pop',
                  ctx=Load()),
                args=[
                  Name(id='key', ctx=Load()),
                  Constant(value=None)]))]),
        Assign(
          targets=[
            Subscript(
              value=Name(id='artifacts', ctx=Load()),
              slice=Constant(value='recovery_plan'),
              ctx=Store())],
          value=Name(id='plan', ctx=Load())),
        Return(
          value=Dict(
            keys=[
              Constant(value='artifacts'),
              Constant(value='replan_count')],
            values=[
              Name(id='artifacts', ctx=Load()),
              Name(id='new_replan_count', ctx=Load())]))],
      returns=Subscript(
        value=Name(id='Dict', ctx=Load()),
        slice=Tuple(
          elts=[
            Name(id='str', ctx=Load()),
            Name(id='Any', ctx=Load())],
          ctx=Load()),
        ctx=Load())),
    FunctionDef(
      name='check_qa_results',
      args=arguments(
        args=[
          arg(
            arg='state',
            annotation=Constant(value='GraphState'))]),
      body=[
        Expr(
          value=Constant(value='\n    This is the "conditional edge" that replaces the Governor\'s while loop.\n    It routes to the Re-Planner, to END, or to a FAIL node.\n    ')),
        Assign(
          targets=[
            Name(id='qa_passed', ctx=Store())],
          value=Subscript(
            value=Subscript(
              value=Subscript(
                value=Name(id='state', ctx=Load()),
                slice=Constant(value='artifacts'),
                ctx=Load()),
              slice=Constant(value='validation_results'),
              ctx=Load()),
            slice=Constant(value='overall_passed'),
            ctx=Load())),
        Assign(
          targets=[
            Name(id='replan_count', ctx=Store())],
          value=Subscript(
            value=Name(id='state', ctx=Load()),
            slice=Constant(value='replan_count'),
            ctx=Load())),
        Assign(
          targets=[
            Name(id='max_replan', ctx=Store())],
          value=Attribute(
            value=Attribute(
              value=Name(id='CONFIG', ctx=Load()),
              attr='planner_config',
              ctx=Load()),
            attr='max_replan_loops',
            ctx=Load())),
        If(
          test=Name(id='qa_passed', ctx=Load()),
          body=[
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='logger', ctx=Load()),
                  attr='info',
                  ctx=Load()),
                args=[
                  Constant(value='✅ QA Swarm Passed. Ending workflow.')])),
            Return(
              value=Constant(value='END'))],
          orelse=[
            If(
              test=Compare(
                left=Name(id='replan_count', ctx=Load()),
                ops=[
                  GtE()],
                comparators=[
                  Name(id='max_replan', ctx=Load())]),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='logger', ctx=Load()),
                      attr='error',
                      ctx=Load()),
                    args=[
                      JoinedStr(
                        values=[
                          Constant(value='❌ QA Failed. Max replan loops ('),
                          FormattedValue(
                            value=Name(id='max_replan', ctx=Load()),
                            conversion=-1),
                          Constant(value=') reached. Halting.')])])),
                Return(
                  value=Constant(value='FAIL_HALT'))],
              orelse=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='logger', ctx=Load()),
                      attr='warning',
                      ctx=Load()),
                    args=[
                      JoinedStr(
                        values=[
                          Constant(value='⚠️ QA Failed. Triggering Re-Planner (Attempt '),
                          FormattedValue(
                            value=BinOp(
                              left=Name(id='replan_count', ctx=Load()),
                              op=Add(),
                              right=Constant(value=1)),
                            conversion=-1),
                          Constant(value=').')])])),
                Return(
                  value=Constant(value='REPLANNER'))])])],
      returns=Name(id='str', ctx=Load())),
    FunctionDef(
      name='get_graph_app',
      args=arguments(
        args=[
          arg(
            arg='checkpointer',
            annotation=Constant(value='RedisSaver'))]),
      body=[
        Expr(
          value=Constant(value='\n    Builds and compiles the persistent v7.0 StateGraph.\n    ')),
        ImportFrom(
          module='langgraph.graph',
          names=[
            alias(name='StateGraph'),
            alias(name='END')],
          level=0),
        ImportFrom(
          module='core_v7_0',
          names=[
            alias(name='GraphState')],
          level=0),
        Assign(
          targets=[
            Name(id='workflow', ctx=Store())],
          value=Call(
            func=Name(id='StateGraph', ctx=Load()),
            args=[
              Name(id='GraphState', ctx=Load())])),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='workflow', ctx=Load()),
              attr='add_node',
              ctx=Load()),
            args=[
              Constant(value='strategy'),
              Name(id='run_strategy', ctx=Load())])),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='workflow', ctx=Load()),
              attr='add_node',
              ctx=Load()),
            args=[
              Constant(value='rag_stack'),
              Name(id='run_rag_stack', ctx=Load())])),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='workflow', ctx=Load()),
              attr='add_node',
              ctx=Load()),
            args=[
              Constant(value='drafting_stack'),
              Name(id='run_drafting_stack', ctx=Load())])),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='workflow', ctx=Load()),
              attr='add_node',
              ctx=Load()),
            args=[
              Constant(value='qa_swarm'),
              Name(id='run_qa_swarm', ctx=Load())])),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='workflow', ctx=Load()),
              attr='add_node',
              ctx=Load()),
            args=[
              Constant(value='replanner'),
              Name(id='run_replanner', ctx=Load())])),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='workflow', ctx=Load()),
              attr='set_entry_point',
              ctx=Load()),
            args=[
              Constant(value='strategy')])),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='workflow', ctx=Load()),
              attr='add_edge',
              ctx=Load()),
            args=[
              Constant(value='strategy'),
              Constant(value='rag_stack')])),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='workflow', ctx=Load()),
              attr='add_edge',
              ctx=Load()),
            args=[
              Constant(value='rag_stack'),
              Constant(value='drafting_stack')])),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='workflow', ctx=Load()),
              attr='add_edge',
              ctx=Load()),
            args=[
              Constant(value='drafting_stack'),
              Constant(value='qa_swarm')])),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='workflow', ctx=Load()),
              attr='add_conditional_edges',
              ctx=Load()),
            args=[
              Constant(value='qa_swarm'),
              Name(id='check_qa_results', ctx=Load()),
              Dict(
                keys=[
                  Constant(value='END'),
                  Constant(value='FAIL_HALT'),
                  Constant(value='REPLANNER')],
                values=[
                  Name(id='END', ctx=Load()),
                  Name(id='END', ctx=Load()),
                  Constant(value='replanner')])])),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='workflow', ctx=Load()),
              attr='add_edge',
              ctx=Load()),
            args=[
              Constant(value='replanner'),
              Constant(value='drafting_stack')])),
        Return(
          value=Call(
            func=Attribute(
              value=Name(id='workflow', ctx=Load()),
              attr='compile',
              ctx=Load()),
            keywords=[
              keyword(
                arg='checkpointer',
                value=Name(id='checkpointer', ctx=Load()))]))],
      returns=Constant(value='CompiledGraph')),
    Assign(
      targets=[
        Name(id='__all__', ctx=Store())],
      value=List(
        elts=[
          Constant(value='get_graph_app'),
          Constant(value='WorkflowSteps'),
          Constant(value='FeedbackLoggerAgent'),
          Constant(value='ThemeClassifierAgent'),
          Constant(value='RAG_QueryGeneratorAgent'),
          Constant(value='RAG_SearchAgent'),
          Constant(value='RAG_CritiqueAgent'),
          Constant(value='PromptStackAgent'),
          Constant(value='BulletSwarmAgent'),
          Constant(value='AdversarialDraftingRouter'),
          Constant(value='WorkflowRePlannerAgent'),
          Constant(value='AtomicQASwarmLLM'),
          Constant(value='AtomicQASwarmLogic')],
        ctx=Load()))])