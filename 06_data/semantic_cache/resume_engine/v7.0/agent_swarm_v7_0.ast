                        attr='logger',
                        ctx=Load()),
                      attr='warning',
                      ctx=Load()),
                    args=[
                      Constant(value='No feedback_log_path configured. Skipping log.')])),
                Return()]),
            Try(
              body=[
                Assign(
                  targets=[
                    Name(id='log_entry', ctx=Store())],
                  value=Dict(
                    keys=[
                      Constant(value='timestamp'),
                      Constant(value='workflow_id'),
