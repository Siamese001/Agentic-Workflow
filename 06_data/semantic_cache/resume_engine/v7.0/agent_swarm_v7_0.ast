                          attr='get',
                          ctx=Load()),
                        args=[
                          Constant(value='failed_checks'),
                          List(ctx=Load())]),
                      Call(
                        func=Attribute(
                          value=Name(id='validation_results', ctx=Load()),
                          attr='get',
                          ctx=Load()),
                        args=[
                          Constant(value='all_results'),
                          List(ctx=Load())])])),
                With(
                  items=[
                    withitem(
                      context_expr=Call(
                        func=Name(id='open', ctx=Load()),
                        args=[
                          Attribute(
                            value=Name(id='self', ctx=Load()),
                            attr='log_path',
                            ctx=Load()),
                          Constant(value='a')]),
                      optional_vars=Name(id='f', ctx=Store()))],
                  body=[
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Name(id='json', ctx=Load()),
                          attr='dump',
                          ctx=Load()),
                        args=[
                          Name(id='log_entry', ctx=Load()),
                          Name(id='f', ctx=Load())])),
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Name(id='f', ctx=Load()),
                          attr='write',
                          ctx=Load()),
                        args=[
                          Constant(value='\n')]))]),
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='logger',
                        ctx=Load()),
                      attr='info',
                      ctx=Load()),
                    args=[
                      JoinedStr(
                        values=[
                          Constant(value='Feedback logged to '),
                          FormattedValue(
                            value=Attribute(
                              value=Name(id='self', ctx=Load()),
                              attr='log_path',
                              ctx=Load()),
                            conversion=-1),
                          Constant(value=' for workflow '),
                          FormattedValue(
                            value=Name(id='workflow_id', ctx=Load()),
                            conversion=-1)])]))],
              handlers=[
