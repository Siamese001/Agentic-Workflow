                attr='message_history',
                ctx=Store()),
              annotation=Subscript(
                value=Name(id='List', ctx=Load()),
                slice=Name(id='str', ctx=Load()),
                ctx=Load()),
              value=List(ctx=Load()),
              simple=0),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='vectorizer',
                  ctx=Store())],
              value=Call(
                func=Name(id='TfidfVectorizer', ctx=Load())))]),
        FunctionDef(
          name='check_diversity',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='new_message',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Check if new message is sufficiently different from history\n        \n        Returns:\n            (is_diverse, max_similarity, most_similar_message)\n        ')),
            If(
              test=UnaryOp(
                op=Not(),
                operand=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='message_history',
                  ctx=Load())),
              body=[
                Return(
                  value=Tuple(
                    elts=[
                      Constant(value=True),
                      Constant(value=0.0),
                      Constant(value='')],
                    ctx=Load()))]),
            Assign(
              targets=[
                Name(id='all_messages', ctx=Store())],
              value=BinOp(
                left=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='message_history',
                  ctx=Load()),
                op=Add(),
                right=List(
                  elts=[
                    Name(id='new_message', ctx=Load())],
                  ctx=Load()))),
            Try(
              body=[
                Assign(
                  targets=[
                    Name(id='vectors', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='vectorizer',
                        ctx=Load()),
                      attr='fit_transform',
                      ctx=Load()),
                    args=[
                      Name(id='all_messages', ctx=Load())])),
                Assign(
                  targets=[
                    Name(id='new_vector', ctx=Store())],
                  value=Subscript(
                    value=Name(id='vectors', ctx=Load()),
                    slice=UnaryOp(
                      op=USub(),
                      operand=Constant(value=1)),
                    ctx=Load())),
                Assign(
                  targets=[
                    Name(id='history_vectors', ctx=Store())],
                  value=Subscript(
                    value=Name(id='vectors', ctx=Load()),
                    slice=Slice(
                      upper=UnaryOp(
                        op=USub(),
                        operand=Constant(value=1))),
                    ctx=Load())),
                Assign(
                  targets=[
                    Name(id='similarities', ctx=Store())],
                  value=Subscript(
                    value=Call(
                      func=Name(id='cosine_similarity', ctx=Load()),
                      args=[
                        Name(id='new_vector', ctx=Load()),
                        Name(id='history_vectors', ctx=Load())]),
                    slice=Constant(value=0),
                    ctx=Load())),
                Assign(
                  targets=[
                    Name(id='max_similarity', ctx=Store())],
                  value=Call(
                    func=Name(id='float', ctx=Load()),
                    args=[
                      Call(
                        func=Attribute(
                          value=Name(id='np', ctx=Load()),
                          attr='max',
                          ctx=Load()),
                        args=[
                          Name(id='similarities', ctx=Load())])])),
                Assign(
                  targets=[
                    Name(id='max_idx', ctx=Store())],
                  value=Call(
                    func=Name(id='int', ctx=Load()),
                    args=[
                      Call(
                        func=Attribute(
                          value=Name(id='np', ctx=Load()),
                          attr='argmax',
                          ctx=Load()),
                        args=[
                          Name(id='similarities', ctx=Load())])])),
                Assign(
                  targets=[
                    Name(id='is_diverse', ctx=Store())],
                  value=Compare(
                    left=Name(id='max_similarity', ctx=Load()),
                    ops=[
                      Lt()],
                    comparators=[
                      Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='MIN_DIVERSITY_THRESHOLD',
                        ctx=Load())])),
                Assign(
                  targets=[
                    Name(id='most_similar', ctx=Store())],
                  value=IfExp(
                    test=Compare(
                      left=Name(id='max_idx', ctx=Load()),
                      ops=[
                        Lt()],
                      comparators=[
                        Call(
                          func=Name(id='len', ctx=Load()),
                          args=[
                            Attribute(
                              value=Name(id='self', ctx=Load()),
                              attr='message_history',
                              ctx=Load())])]),
                    body=Subscript(
                      value=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='message_history',
                        ctx=Load()),
                      slice=Name(id='max_idx', ctx=Load()),
                      ctx=Load()),
                    orelse=Constant(value=''))),
                Return(
                  value=Tuple(
                    elts=[
                      Name(id='is_diverse', ctx=Load()),
                      Name(id='max_similarity', ctx=Load()),
                      Name(id='most_similar', ctx=Load())],
                    ctx=Load()))],
              handlers=[
                ExceptHandler(
                  body=[
                    Return(
                      value=Tuple(
                        elts=[
                          Constant(value=True),
                          Constant(value=0.0),
                          Constant(value='')],
                        ctx=Load()))])])],
          returns=Subscript(
            value=Name(id='Tuple', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='bool', ctx=Load()),
                Name(id='float', ctx=Load()),
                Name(id='str', ctx=Load())],
