                  attr='state',
                  ctx=Store())],
              value=Attribute(
                value=Name(id='CircuitState', ctx=Load()),
                attr='CLOSED',
                ctx=Load()))]),
        FunctionDef(
          name='call',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='func',
                annotation=Name(id='Callable', ctx=Load()))],
            vararg=arg(arg='args'),
            kwarg=arg(arg='kwargs')),
          body=[
            Expr(
              value=Constant(value='\n        Execute function with circuit breaker protection\n        ')),
            If(
              test=Compare(
                left=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='state',
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Attribute(
                    value=Name(id='CircuitState', ctx=Load()),
                    attr='OPEN',
                    ctx=Load())]),
              body=[
                If(
                  test=BoolOp(
                    op=And(),
                    values=[
                      Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='last_failure_time',
                        ctx=Load()),
                      Compare(
                        left=BinOp(
                          left=Call(
                            func=Attribute(
                              value=Name(id='datetime', ctx=Load()),
                              attr='now',
                              ctx=Load())),
                          op=Sub(),
                          right=Attribute(
                            value=Name(id='self', ctx=Load()),
                            attr='last_failure_time',
                            ctx=Load())),
                        ops=[
                          Gt()],
                        comparators=[
                          Call(
                            func=Name(id='timedelta', ctx=Load()),
                            keywords=[
                              keyword(
                                arg='seconds',
                                value=Attribute(
                                  value=Name(id='self', ctx=Load()),
                                  attr='timeout_seconds',
                                  ctx=Load()))])])]),
                  body=[
                    Assign(
                      targets=[
                        Attribute(
                          value=Name(id='self', ctx=Load()),
                          attr='state',
                          ctx=Store())],
                      value=Attribute(
                        value=Name(id='CircuitState', ctx=Load()),
                        attr='HALF_OPEN',
                        ctx=Load())),
                    Assign(
                      targets=[
                        Attribute(
                          value=Name(id='self', ctx=Load()),
                          attr='failure_count',
                          ctx=Store())],
                      value=Constant(value=0))],
                  orelse=[
                    Raise(
                      exc=Call(
                        func=Name(id='CircuitBreakerOpenError', ctx=Load()),
                        args=[
                          Constant(value='API circuit breaker is OPEN - waiting for recovery')]))])]),
            Try(
              body=[
                Assign(
                  targets=[
                    Name(id='result', ctx=Store())],
                  value=Call(
                    func=Name(id='func', ctx=Load()),
                    args=[
                      Starred(
                        value=Name(id='args', ctx=Load()),
                        ctx=Load())],
                    keywords=[
                      keyword(
                        value=Name(id='kwargs', ctx=Load()))])),
                If(
                  test=Compare(
                    left=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='state',
                      ctx=Load()),
                    ops=[
                      Eq()],
                    comparators=[
                      Attribute(
                        value=Name(id='CircuitState', ctx=Load()),
                        attr='HALF_OPEN',
                        ctx=Load())]),
                  body=[
                    Assign(
                      targets=[
                        Attribute(
                          value=Name(id='self', ctx=Load()),
                          attr='state',
                          ctx=Store())],
                      value=Attribute(
                        value=Name(id='CircuitState', ctx=Load()),
                        attr='CLOSED',
                        ctx=Load())),
                    Assign(
                      targets=[
                        Attribute(
                          value=Name(id='self', ctx=Load()),
                          attr='failure_count',
                          ctx=Store())],
                      value=Constant(value=0))]),
                Return(
                  value=Name(id='result', ctx=Load()))],
              handlers=[
                ExceptHandler(
                  type=Name(id='Exception', ctx=Load()),
                  name='e',
                  body=[
                    AugAssign(
                      target=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='failure_count',
                        ctx=Store()),
                      op=Add(),
                      value=Constant(value=1)),
                    Assign(
                      targets=[
                        Attribute(
                          value=Name(id='self', ctx=Load()),
                          attr='last_failure_time',
                          ctx=Store())],
                      value=Call(
                        func=Attribute(
                          value=Name(id='datetime', ctx=Load()),
                          attr='now',
                          ctx=Load()))),
                    If(
