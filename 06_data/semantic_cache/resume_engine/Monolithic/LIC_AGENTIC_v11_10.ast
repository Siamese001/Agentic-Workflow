                    comparators=[
                      Constant(value=0)])]),
              body=[
                Assign(
                  targets=[
                    Name(id='reasoning', ctx=Store())],
                  value=JoinedStr(
                    values=[
                      Constant(value='Node 3: Existing relationship ('),
