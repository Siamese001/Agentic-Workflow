    ClassDef(
      name='SignalQualityScorer',
      body=[
        Expr(
          value=Constant(value='\n    Weights RAG sources by reliability for message generation\n    FEATURE 1.1 from SUPREME_SPELL\n    ')),
        Assign(
          targets=[
            Name(id='SOURCE_WEIGHTS', ctx=Store())],
          value=Dict(
            keys=[
              Constant(value='RECIPIENT_LINKEDIN_ABOUT'),
              Constant(value='RECIPIENT_RECENT_POST'),
              Constant(value='COMPANY_BLOG_ANNOUNCEMENT'),
              Constant(value='COMPANY_LINKEDIN_PAGE'),
              Constant(value='NEWS_ARTICLE_COMPANY'),
              Constant(value='COMPETITOR_COMPARISON'),
              Constant(value='GENERIC_INDUSTRY_TREND'),
              Constant(value='SENDER_PROFILE_ONLY')],
            values=[
              Constant(value=2.0),
              Constant(value=1.8),
              Constant(value=1.5),
              Constant(value=1.3),
              Constant(value=1.2),
              Constant(value=0.9),
              Constant(value=0.6),
              Constant(value=0.3)])),
        Assign(
          targets=[
            Name(id='MINIMUM_SIGNAL_THRESHOLD', ctx=Store())],
          value=Constant(value=0.7)),
        FunctionDef(
          name='calculate_signal_score',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='rag_results',
                annotation=Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Name(id='RAGResult', ctx=Load()),
                  ctx=Load())),
              arg(
                arg='message_content',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Calculate weighted signal quality score for generated message\n        ')),
            Assign(
              targets=[
                Name(id='keyword_scores', ctx=Store())],
              value=Call(
                func=Name(id='defaultdict', ctx=Load()),
                args=[
                  Name(id='float', ctx=Load())])),
            Assign(
              targets=[
                Name(id='source_breakdown', ctx=Store())],
              value=Call(
                func=Name(id='defaultdict', ctx=Load()),
                args=[
                  Name(id='int', ctx=Load())])),
            For(
              target=Name(id='result', ctx=Store()),
              iter=Name(id='rag_results', ctx=Load()),
              body=[
                Assign(
                  targets=[
                    Name(id='weight', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='SOURCE_WEIGHTS',
                        ctx=Load()),
                      attr='get',
                      ctx=Load()),
                    args=[
                      Attribute(
                        value=Name(id='result', ctx=Load()),
                        attr='source_type',
                        ctx=Load()),
                      Constant(value=0.5)])),
                For(
                  target=Name(id='keyword', ctx=Store()),
                  iter=Attribute(
                    value=Name(id='result', ctx=Load()),
                    attr='extracted_keywords',
                    ctx=Load()),
                  body=[
                    If(
                      test=Compare(
                        left=Call(
                          func=Attribute(
                            value=Name(id='keyword', ctx=Load()),
                            attr='lower',
                            ctx=Load())),
                        ops=[
                          In()],
                        comparators=[
                          Call(
                            func=Attribute(
                              value=Name(id='message_content', ctx=Load()),
                              attr='lower',
                              ctx=Load()))]),
                      body=[
                        AugAssign(
                          target=Subscript(
                            value=Name(id='keyword_scores', ctx=Load()),
                            slice=Name(id='keyword', ctx=Load()),
                            ctx=Store()),
                          op=Add(),
                          value=Name(id='weight', ctx=Load())),
                        AugAssign(
                          target=Subscript(
                            value=Name(id='source_breakdown', ctx=Load()),
                            slice=Attribute(
                              value=Name(id='result', ctx=Load()),
                              attr='source_type',
                              ctx=Load()),
                            ctx=Store()),
                          op=Add(),
                          value=Constant(value=1))])])]),
            If(
              test=UnaryOp(
                op=Not(),
                operand=Name(id='keyword_scores', ctx=Load())),
              body=[
                Return(
                  value=Tuple(
                    elts=[
                      Constant(value=0.0),
                      Call(
                        func=Name(id='dict', ctx=Load()),
                        args=[
                          Name(id='source_breakdown', ctx=Load())])],
                    ctx=Load()))]),
            Assign(
              targets=[
                Name(id='signal_score', ctx=Store())],
              value=BinOp(
                left=Call(
                  func=Name(id='sum', ctx=Load()),
                  args=[
                    Call(
                      func=Attribute(
                        value=Name(id='keyword_scores', ctx=Load()),
                        attr='values',
                        ctx=Load()))]),
                op=Div(),
                right=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Name(id='keyword_scores', ctx=Load())]))),
            Return(
              value=Tuple(
                elts=[
                  Name(id='signal_score', ctx=Load()),
                  Call(
                    func=Name(id='dict', ctx=Load()),
                    args=[
                      Name(id='source_breakdown', ctx=Load())])],
                ctx=Load()))],
          returns=Subscript(
            value=Name(id='Tuple', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='float', ctx=Load()),
                Subscript(
                  value=Name(id='Dict', ctx=Load()),
                  slice=Tuple(
                    elts=[
                      Name(id='str', ctx=Load()),
                      Name(id='int', ctx=Load())],
                    ctx=Load()),
                  ctx=Load())],
              ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='validate_minimum_signal',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='score',
                annotation=Name(id='float', ctx=Load()))]),
          body=[
            Return(
              value=Compare(
                left=Name(id='score', ctx=Load()),
                ops=[
                  GtE()],
                comparators=[
                  Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='MINIMUM_SIGNAL_THRESHOLD',
                    ctx=Load())]))],
          returns=Name(id='bool', ctx=Load()))]),
    ClassDef(
      name='ClaimConfidenceScorer',
      body=[
        Expr(
          value=Constant(value='\n    Per-claim confidence scoring with rejection gate\n    FEATURE 1.2 from SUPREME_SPELL\n    ')),
        Assign(
          targets=[
            Name(id='MIN_PER_CLAIM_CONFIDENCE', ctx=Store())],
          value=Constant(value=0.7)),
        Assign(
          targets=[
            Name(id='MIN_AGGREGATE_CONFIDENCE', ctx=Store())],
          value=Constant(value=0.75)),
        FunctionDef(
          name='score_claim',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='claim_text',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='rag_results',
                annotation=Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Name(id='RAGResult', ctx=Load()),
                  ctx=Load())),
              arg(
                arg='embedding_similarity_threshold',
                annotation=Name(id='float', ctx=Load()))],
            defaults=[
              Constant(value=0.75)]),
          body=[
            Expr(
              value=Constant(value='\n        Score individual claim based on RAG evidence\n        (Simplified version - full implementation would use embeddings)\n        ')),
            Assign(
              targets=[
                Name(id='supporting', ctx=Store())],
              value=List(ctx=Load())),
            Assign(
              targets=[
                Name(id='weights', ctx=Store())],
              value=List(ctx=Load())),
            Assign(
              targets=[
                Name(id='claim_words', ctx=Store())],
              value=Call(
                func=Name(id='set', ctx=Load()),
                args=[
                  Call(
                    func=Attribute(
                      value=Call(
                        func=Attribute(
                          value=Name(id='claim_text', ctx=Load()),
                          attr='lower',
                          ctx=Load())),
                      attr='split',
                      ctx=Load()))])),
            For(
              target=Name(id='result', ctx=Store()),
              iter=Name(id='rag_results', ctx=Load()),
              body=[
                Assign(
                  targets=[
                    Name(id='result_words', ctx=Store())],
                  value=Call(
                    func=Name(id='set', ctx=Load()),
                    args=[
                      Call(
                        func=Attribute(
                          value=Call(
                            func=Attribute(
                              value=Attribute(
                                value=Name(id='result', ctx=Load()),
                                attr='text',
                                ctx=Load()),
                              attr='lower',
                              ctx=Load())),
                          attr='split',
                          ctx=Load()))])),
                Assign(
                  targets=[
                    Name(id='overlap', ctx=Store())],
                  value=Call(
                    func=Name(id='len', ctx=Load()),
                    args=[
                      BinOp(
                        left=Name(id='claim_words', ctx=Load()),
                        op=BitAnd(),
                        right=Name(id='result_words', ctx=Load()))])),
                If(
                  test=Compare(
                    left=Name(id='overlap', ctx=Load()),
                    ops=[
                      GtE()],
                    comparators=[
                      Constant(value=3)]),
                  body=[
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Name(id='supporting', ctx=Load()),
                          attr='append',
                          ctx=Load()),
                        args=[
                          Attribute(
                            value=Name(id='result', ctx=Load()),
                            attr='source',
                            ctx=Load())])),
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Name(id='weights', ctx=Load()),
                          attr='append',
                          ctx=Load()),
                        args=[
                          Attribute(
                            value=Name(id='result', ctx=Load()),
                            attr='source_weight',
                            ctx=Load())]))])]),
            If(
              test=UnaryOp(
                op=Not(),
                operand=Name(id='supporting', ctx=Load())),
              body=[
                Assign(
                  targets=[
                    Name(id='confidence', ctx=Store())],
                  value=Constant(value=0.0))],
              orelse=[
                Assign(
                  targets=[
                    Name(id='confidence', ctx=Store())],
                  value=Call(
                    func=Name(id='min', ctx=Load()),
                    args=[
                      Constant(value=1.0),
                      BinOp(
                        left=BinOp(
                          left=Call(
                            func=Name(id='len', ctx=Load()),
                            args=[
                              Name(id='supporting', ctx=Load())]),
                          op=Mult(),
                          right=Constant(value=0.3)),
                        op=Add(),
                        right=BinOp(
                          left=BinOp(
                            left=Call(
                              func=Name(id='sum', ctx=Load()),
                              args=[
                                Name(id='weights', ctx=Load())]),
                            op=Div(),
                            right=Call(
                              func=Name(id='len', ctx=Load()),
                              args=[
                                Name(id='weights', ctx=Load())])),
                          op=Mult(),
                          right=Constant(value=0.7)))]))]),
            Return(
              value=Call(
                func=Name(id='MessageClaim', ctx=Load()),
                keywords=[
                  keyword(
                    arg='text',
                    value=Name(id='claim_text', ctx=Load())),
                  keyword(
                    arg='confidence',
                    value=Name(id='confidence', ctx=Load())),
                  keyword(
                    arg='supporting_sources',
                    value=Name(id='supporting', ctx=Load())),
                  keyword(
                    arg='source_weights',
                    value=Name(id='weights', ctx=Load()))]))],
          returns=Name(id='MessageClaim', ctx=Load())),
        FunctionDef(
          name='score_message_claims',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='message',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='rag_results',
                annotation=Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Name(id='RAGResult', ctx=Load()),
                  ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Score all claims in message\n        ')),
            Assign(
              targets=[
                Name(id='sentences', ctx=Store())],
              value=ListComp(
                elt=Call(
                  func=Attribute(
                    value=Name(id='s', ctx=Load()),
                    attr='strip',
                    ctx=Load())),
                generators=[
                  comprehension(
                    target=Name(id='s', ctx=Store()),
                    iter=Call(
                      func=Attribute(
                        value=Name(id='message', ctx=Load()),
                        attr='split',
                        ctx=Load()),
                      args=[
                        Constant(value='.')]),
                    ifs=[
                      Compare(
                        left=Call(
                          func=Name(id='len', ctx=Load()),
                          args=[
                            Call(
                              func=Attribute(
                                value=Name(id='s', ctx=Load()),
                                attr='strip',
                                ctx=Load()))]),
                        ops=[
                          Gt()],
                        comparators=[
                          Constant(value=10)])],
                    is_async=0)])),
            Assign(
              targets=[
                Name(id='claims', ctx=Store())],
              value=List(ctx=Load())),
            For(
              target=Name(id='sentence', ctx=Store()),
              iter=Name(id='sentences', ctx=Load()),
              body=[
                Assign(
                  targets=[
                    Name(id='claim', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='score_claim',
                      ctx=Load()),
                    args=[
                      Name(id='sentence', ctx=Load()),
                      Name(id='rag_results', ctx=Load())])),
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='claims', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Name(id='claim', ctx=Load())]))]),
            If(
              test=UnaryOp(
                op=Not(),
                operand=Name(id='claims', ctx=Load())),
              body=[
                Return(
                  value=Tuple(
                    elts=[
                      List(ctx=Load()),
                      Constant(value=0.0)],
                    ctx=Load()))]),
            Assign(
              targets=[
                Name(id='aggregate_confidence', ctx=Store())],
              value=BinOp(
                left=Call(
                  func=Name(id='sum', ctx=Load()),
                  args=[
                    GeneratorExp(
                      elt=Attribute(
                        value=Name(id='c', ctx=Load()),
                        attr='confidence',
                        ctx=Load()),
                      generators=[
                        comprehension(
                          target=Name(id='c', ctx=Store()),
                          iter=Name(id='claims', ctx=Load()),
                          is_async=0)])]),
                op=Div(),
                right=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Name(id='claims', ctx=Load())]))),
            Return(
              value=Tuple(
                elts=[
                  Name(id='claims', ctx=Load()),
                  Name(id='aggregate_confidence', ctx=Load())],
                ctx=Load()))],
          returns=Subscript(
            value=Name(id='Tuple', ctx=Load()),
            slice=Tuple(
              elts=[
                Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Name(id='MessageClaim', ctx=Load()),
                  ctx=Load()),
                Name(id='float', ctx=Load())],
              ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='validate_claims',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='claims',
                annotation=Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Name(id='MessageClaim', ctx=Load()),
                  ctx=Load())),
              arg(
                arg='aggregate_confidence',
                annotation=Name(id='float', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Validate claims meet minimum thresholds\n        ')),
            Assign(
              targets=[
                Name(id='low_confidence_claims', ctx=Store())],
              value=ListComp(
                elt=Name(id='c', ctx=Load()),
                generators=[
                  comprehension(
                    target=Name(id='c', ctx=Store()),
                    iter=Name(id='claims', ctx=Load()),
                    ifs=[
                      Compare(
                        left=Attribute(
                          value=Name(id='c', ctx=Load()),
                          attr='confidence',
                          ctx=Load()),
                        ops=[
                          Lt()],
                        comparators=[
                          Attribute(
                            value=Name(id='self', ctx=Load()),
                            attr='MIN_PER_CLAIM_CONFIDENCE',
                            ctx=Load())])],
                    is_async=0)])),
            If(
              test=Name(id='low_confidence_claims', ctx=Load()),
              body=[
                Return(
                  value=Tuple(
                    elts=[
                      Constant(value=False),
                      JoinedStr(
                        values=[
                          FormattedValue(
                            value=Call(
                              func=Name(id='len', ctx=Load()),
                              args=[
                                Name(id='low_confidence_claims', ctx=Load())]),
                            conversion=-1),
                          Constant(value=' claims below 0.70 confidence')])],
                    ctx=Load()))]),
            If(
              test=Compare(
                left=Name(id='aggregate_confidence', ctx=Load()),
                ops=[
                  Lt()],
                comparators=[
                  Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='MIN_AGGREGATE_CONFIDENCE',
                    ctx=Load())]),
              body=[
                Return(
                  value=Tuple(
                    elts=[
                      Constant(value=False),
                      JoinedStr(
                        values=[
                          Constant(value='Aggregate confidence '),
                          FormattedValue(
                            value=Name(id='aggregate_confidence', ctx=Load()),
                            conversion=-1,
                            format_spec=JoinedStr(
                              values=[
                                Constant(value='.2f')])),
                          Constant(value=' < 0.75')])],
                    ctx=Load()))]),
            Return(
              value=Tuple(
                elts=[
                  Constant(value=True),
                  Constant(value='')],
                ctx=Load()))],
          returns=Subscript(
            value=Name(id='Tuple', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='bool', ctx=Load()),
                Name(id='str', ctx=Load())],
              ctx=Load()),
            ctx=Load()))]),
    ClassDef(
      name='RAGReflexionSystem',
      body=[
        Expr(
          value=Constant(value='\n    Iterative RAG refinement with critique loop\n    FEATURE 1.4 from SUPREME_SPELL\n    ')),
        Assign(
          targets=[
            Name(id='MIN_CONFIDENCE_THRESHOLD', ctx=Store())],
          value=Constant(value=0.7)),
        Assign(
          targets=[
            Name(id='MAX_ITERATIONS', ctx=Store())],
          value=Constant(value=3)),
        FunctionDef(
          name='critique_rag_sufficiency',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='rag_results',
                annotation=Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Name(id='RAGResult', ctx=Load()),
                  ctx=Load())),
              arg(
                arg='recipient_archetype',
                annotation=Name(id='Archetype', ctx=Load())),
              arg(
                arg='iteration',
                annotation=Name(id='int', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Critique RAG research quality and identify gaps\n        ')),
            Assign(
              targets=[
                Name(id='gaps', ctx=Store())],
              value=List(ctx=Load())),
            Assign(
              targets=[
                Name(id='source_types', ctx=Store())],
              value=Call(
                func=Name(id='set', ctx=Load()),
                args=[
                  GeneratorExp(
                    elt=Attribute(
                      value=Name(id='r', ctx=Load()),
                      attr='source_type',
                      ctx=Load()),
                    generators=[
                      comprehension(
                        target=Name(id='r', ctx=Store()),
                        iter=Name(id='rag_results', ctx=Load()),
                        is_async=0)])])),
            If(
              test=Compare(
                left=Constant(value='RECIPIENT_LINKEDIN_ABOUT'),
                ops=[
                  NotIn()],
                comparators=[
                  Name(id='source_types', ctx=Load())]),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='gaps', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Constant(value='Missing direct recipient profile data')]))]),
            If(
              test=Compare(
                left=Constant(value='COMPANY_BLOG_ANNOUNCEMENT'),
                ops=[
                  NotIn()],
                comparators=[
                  Name(id='source_types', ctx=Load())]),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='gaps', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Constant(value='Missing recent company announcements')]))]),
            If(
              test=Compare(
                left=Name(id='recipient_archetype', ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Attribute(
                    value=Name(id='Archetype', ctx=Load()),
                    attr='C_LEVEL',
                    ctx=Load())]),
              body=[
                Assign(
