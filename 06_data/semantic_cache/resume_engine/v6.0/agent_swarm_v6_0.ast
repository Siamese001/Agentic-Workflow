                        func=Name(id='asdict', ctx=Load()),
                        args=[
                          Attribute(
                            value=Name(id='conductor_decision', ctx=Load()),
                            attr='winning_branch',
                            ctx=Load())]),
                      ListComp(
                        elt=Call(
                          func=Name(id='asdict', ctx=Load()),
                          args=[
                            Name(id='b', ctx=Load())]),
                        generators=[
                          comprehension(
                            target=Name(id='b', ctx=Store()),
                            iter=Attribute(
                              value=Name(id='conductor_decision', ctx=Load()),
                              attr='all_branches',
                              ctx=Load()),
                            is_async=0)]),
                      Attribute(
                        value=Name(id='conductor_decision', ctx=Load()),
                        attr='vote_results',
                        ctx=Load())])),
                Assign(
                  targets=[
                    Name(id='winning_strategy', ctx=Store())],
                  value=Attribute(
                    value=Attribute(
                      value=Name(id='conductor_decision', ctx=Load()),
                      attr='winning_branch',
                      ctx=Load()),
                    attr='strategy_description',
                    ctx=Load())),
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='logger',
                        ctx=Load()),
                      attr='info',
                      ctx=Load()),
                    args=[
                      JoinedStr(
                        values=[
