    ClassDef(
      name='Governor',
      body=[
        Expr(
          value=Constant(value='\n    v6.0 Governor: Main orchestration agent that delegates to specialists.\n    REFACTORED: Reads max_replan_loops from CONFIG.\n    ')),
        FunctionDef(
          name='__init__',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='config',
                annotation=Name(id='CrewConfiguration', ctx=Load()))]),
          body=[
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='config',
                  ctx=Store())],
              value=Name(id='config', ctx=Load())),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='logger',
                  ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='logging', ctx=Load()),
                  attr='getLogger',
                  ctx=Load()),
                args=[
                  Name(id='__name__', ctx=Load())])),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='telemetry_logger',
                  ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='logging', ctx=Load()),
                  attr='getLogger',
                  ctx=Load()),
                args=[
                  Constant(value='agent_telemetry')])),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='conductor',
                  ctx=Store())],
              value=IfExp(
                test=Attribute(
                  value=Name(id='config', ctx=Load()),
                  attr='enable_conductor',
                  ctx=Load()),
                body=Call(
                  func=Name(id='ConductorAgent', ctx=Load())),
                orelse=Constant(value=None))),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='planner',
                  ctx=Store())],
              value=Call(
                func=Name(id='WorkflowPlannerAgent', ctx=Load()))),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='critique',
                  ctx=Store())],
              value=Call(
                func=Name(id='WorkflowCritiqueAgent', ctx=Load()))),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='replanner',
                  ctx=Store())],
              value=Call(
                func=Name(id='WorkflowRePlannerAgent', ctx=Load()))),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='cost_estimator',
                  ctx=Store())],
              value=Call(
                func=Name(id='CostEstimatorAgent', ctx=Load()))),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='cost_tracker',
                  ctx=Store())],
              value=Call(
                func=Name(id='CostTrackerAgent', ctx=Load()))),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='max_replan_loops',
                  ctx=Store())],
              value=Attribute(
                value=Attribute(
                  value=Name(id='CONFIG', ctx=Load()),
                  attr='planner_config',
                  ctx=Load()),
                attr='max_replan_loops',
                ctx=Load())),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='execution_map',
                  ctx=Store())],
              value=Dict(
                keys=[
                  Attribute(
                    value=Attribute(
                      value=Name(id='WorkflowSteps', ctx=Load()),
                      attr='STRATEGY',
                      ctx=Load()),
                    attr='value',
                    ctx=Load()),
                  Attribute(
                    value=Attribute(
                      value=Name(id='WorkflowSteps', ctx=Load()),
                      attr='RAG',
                      ctx=Load()),
                    attr='value',
                    ctx=Load()),
                  Attribute(
                    value=Attribute(
                      value=Name(id='WorkflowSteps', ctx=Load()),
                      attr='PROMPT',
                      ctx=Load()),
                    attr='value',
                    ctx=Load()),
                  Attribute(
                    value=Attribute(
                      value=Name(id='WorkflowSteps', ctx=Load()),
                      attr='BULLET',
                      ctx=Load()),
                    attr='value',
                    ctx=Load()),
                  Attribute(
                    value=Attribute(
                      value=Name(id='WorkflowSteps', ctx=Load()),
                      attr='DRAFTING',
                      ctx=Load()),
                    attr='value',
                    ctx=Load()),
                  Attribute(
                    value=Attribute(
                      value=Name(id='WorkflowSteps', ctx=Load()),
                      attr='QA',
                      ctx=Load()),
                    attr='value',
                    ctx=Load())],
                values=[
                  Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='_run_strategy_stack',
                    ctx=Load()),
                  Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='_run_rag_stack',
                    ctx=Load()),
                  Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='_run_prompt_stack',
                    ctx=Load()),
                  Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='_run_bullet_stack',
                    ctx=Load()),
                  Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='_run_drafting_stack',
                    ctx=Load()),
                  Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='_run_qa_stack',
                    ctx=Load())]))]),
        FunctionDef(
          name='_execute_step',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='step',
                annotation=Name(id='WorkflowStep', ctx=Load())),
              arg(
                arg='blackboard',
                annotation=Name(id='WorkflowBlackboard', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        --- v6.0: Wrapper for execution, telemetry, cost, and circuit breaking ---\n        Single point for all step execution with comprehensive telemetry.\n        ')),
            Assign(
              targets=[
                Name(id='agent_name', ctx=Store())],
              value=Attribute(
                value=Name(id='step', ctx=Load()),
                attr='agent',
                ctx=Load())),
            Assign(
              targets=[
                Name(id='workflow_id', ctx=Store())],
              value=Attribute(
                value=Name(id='blackboard', ctx=Load()),
                attr='workflow_id',
                ctx=Load())),
            Assign(
              targets=[
                Name(id='log_extra', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='workflow_id'),
                  Constant(value='agent_id'),
                  Constant(value='step_id')],
                values=[
                  Name(id='workflow_id', ctx=Load()),
                  Name(id='agent_name', ctx=Load()),
                  Attribute(
                    value=Name(id='step', ctx=Load()),
                    attr='step_id',
                    ctx=Load())])),
            Assign(
              targets=[
                Name(id='result', ctx=Store())],
              value=Constant(value=None)),
            Assign(
              targets=[
                Name(id='start_time', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='time', ctx=Load()),
                  attr='monotonic',
                  ctx=Load()))),
            Try(
              body=[
                If(
                  test=Compare(
                    left=Name(id='agent_name', ctx=Load()),
                    ops=[
                      NotIn()],
                    comparators=[
                      Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='execution_map',
                        ctx=Load())]),
                  body=[
                    Raise(
                      exc=Call(
                        func=Name(id='NotImplementedError', ctx=Load()),
                        args=[
                          JoinedStr(
                            values=[
                              Constant(value='No executable for agent: '),
                              FormattedValue(
                                value=Name(id='agent_name', ctx=Load()),
                                conversion=-1)])]))]),
                Assign(
                  targets=[
                    Name(id='result', ctx=Store())],
                  value=Call(
                    func=Subscript(
                      value=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='execution_map',
                        ctx=Load()),
                      slice=Name(id='agent_name', ctx=Load()),
                      ctx=Load()),
                    args=[
                      Name(id='blackboard', ctx=Load())])),
                Assign(
                  targets=[
                    Name(id='cost_usd', ctx=Store())],
                  value=Constant(value=0.0)),
                Assign(
                  targets=[
                    Name(id='token_input', ctx=Store())],
                  value=Constant(value=0)),
                Assign(
                  targets=[
                    Name(id='token_output', ctx=Store())],
                  value=Constant(value=0)),
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='log_extra', ctx=Load()),
                      attr='update',
                      ctx=Load()),
                    args=[
                      Dict(
                        keys=[
                          Constant(value='duration_ms'),
                          Constant(value='status'),
                          Constant(value='cost_usd'),
                          Constant(value='token_input'),
                          Constant(value='token_output'),
                          Constant(value='output_metadata')],
                        values=[
                          Call(
                            func=Name(id='int', ctx=Load()),
                            args=[
                              BinOp(
                                left=BinOp(
                                  left=Call(
                                    func=Attribute(
                                      value=Name(id='time', ctx=Load()),
                                      attr='monotonic',
                                      ctx=Load())),
                                  op=Sub(),
                                  right=Name(id='start_time', ctx=Load())),
                                op=Mult(),
                                right=Constant(value=1000))]),
                          Constant(value='SUCCESS'),
                          Name(id='cost_usd', ctx=Load()),
                          Name(id='token_input', ctx=Load()),
                          Name(id='token_output', ctx=Load()),
                          Dict(
                            keys=[
                              Constant(value='result_type')],
                            values=[
                              Call(
                                func=Name(id='str', ctx=Load()),
                                args=[
                                  Call(
                                    func=Name(id='type', ctx=Load()),
                                    args=[
                                      Name(id='result', ctx=Load())])])])])])),
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='telemetry_logger',
                        ctx=Load()),
                      attr='info',
                      ctx=Load()),
                    args=[
                      JoinedStr(
                        values=[
                          Constant(value='Agent '),
                          FormattedValue(
                            value=Name(id='agent_name', ctx=Load()),
                            conversion=-1),
                          Constant(value=' SUCCESS')])],
                    keywords=[
                      keyword(
                        arg='extra',
                        value=Name(id='log_extra', ctx=Load()))]))],
              handlers=[
                ExceptHandler(
                  type=Name(id='Exception', ctx=Load()),
                  name='e',
                  body=[
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Name(id='log_extra', ctx=Load()),
                          attr='update',
                          ctx=Load()),
                        args=[
                          Dict(
                            keys=[
                              Constant(value='duration_ms'),
                              Constant(value='status'),
                              Constant(value='error_message')],
                            values=[
                              Call(
                                func=Name(id='int', ctx=Load()),
                                args=[
                                  BinOp(
                                    left=BinOp(
                                      left=Call(
                                        func=Attribute(
                                          value=Name(id='time', ctx=Load()),
                                          attr='monotonic',
                                          ctx=Load())),
                                      op=Sub(),
                                      right=Name(id='start_time', ctx=Load())),
                                    op=Mult(),
                                    right=Constant(value=1000))]),
                              Constant(value='FAILED'),
                              Call(
                                func=Name(id='str', ctx=Load()),
                                args=[
                                  Name(id='e', ctx=Load())])])])),
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Attribute(
                            value=Name(id='self', ctx=Load()),
                            attr='telemetry_logger',
                            ctx=Load()),
                          attr='error',
                          ctx=Load()),
                        args=[
                          JoinedStr(
                            values=[
                              Constant(value='Agent '),
                              FormattedValue(
                                value=Name(id='agent_name', ctx=Load()),
                                conversion=-1),
                              Constant(value=' FAILED')])],
                        keywords=[
                          keyword(
                            arg='extra',
                            value=Name(id='log_extra', ctx=Load()))])),
                    Raise(
                      exc=Name(id='e', ctx=Load()))])]),
