    ClassDef(
      name='RAG_FilterAgent',
      body=[
        Expr(
          value=Constant(value='\n    Filters low-quality chunks.\n    REFACTORED: Reads top_k from config, with a fallback.\n    ')),
        FunctionDef(
          name='execute',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='ranked_chunks',
                annotation=Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Name(id='str', ctx=Load()),
                  ctx=Load())),
              arg(
                arg='blackboard',
                annotation=Name(id='RAG_Blackboard', ctx=Load()))]),
          body=[
            Assign(
              targets=[
                Name(id='top_k', ctx=Store())],
              value=Call(
                func=Name(id='getattr', ctx=Load()),
                args=[
                  Attribute(
                    value=Attribute(
                      value=Name(id='CONFIG', ctx=Load()),
                      attr='new_agent_configs',
                      ctx=Load()),
                    attr='rag_filter',
                    ctx=Load()),
                  Constant(value='top_k_filter'),
                  Constant(value=2)])),
            Return(
              value=Subscript(
                value=Name(id='ranked_chunks', ctx=Load()),
                slice=Slice(
                  upper=Name(id='top_k', ctx=Load())),
                ctx=Load()))],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load()))]),
