                      attr='execute',
                      ctx=Load()),
                    args=[
                      Name(id='blackboard', ctx=Load())])),
                Assign(
                  targets=[
                    Subscript(
                      value=Name(id='results', ctx=Load()),
                      slice=Constant(value='conductor_decision'),
                      ctx=Store())],
                  value=Dict(
                    keys=[
                      Constant(value='winning_branch'),
                      Constant(value='all_branches'),
                      Constant(value='scores')],
