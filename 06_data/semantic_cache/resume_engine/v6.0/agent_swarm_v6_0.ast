    ClassDef(
      name='AdversarialDraftingRouter',
      body=[
        Expr(
          value=Constant(value='\n    v6.0 MoE router for adversarial drafting.\n    Spawns multiple drafters (Gemini, Claude, Muse) and synthesizes results.\n    REFACTORED: Reads enabled drafters from CONFIG.\n    ')),
        FunctionDef(
          name='__init__',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='logger',
                  ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='logging', ctx=Load()),
                  attr='getLogger',
                  ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      FormattedValue(
                        value=Name(id='__name__', ctx=Load()),
                        conversion=-1),
                      Constant(value='.AdversarialDraftingRouter')])])),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='drafters',
                  ctx=Store())],
              value=Dict()),
            Assign(
              targets=[
                Name(id='drafter_factory', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='Gemini_Drafter'),
                  Constant(value='Claude_Drafter'),
                  Constant(value='Muse_Drafter')],
                values=[
                  Lambda(
                    args=arguments(
                      args=[
                        arg(arg='c')]),
                    body=Call(
                      func=Name(id='Gemini_Drafter', ctx=Load()),
                      args=[
                        Name(id='c', ctx=Load())])),
                  Lambda(
                    args=arguments(
                      args=[
                        arg(arg='c')]),
                    body=Call(
                      func=Name(id='Claude_Drafter', ctx=Load()),
                      args=[
                        Name(id='c', ctx=Load())])),
                  Lambda(
                    args=arguments(
                      args=[
                        arg(arg='c')]),
                    body=Call(
                      func=Name(id='Muse_Drafter', ctx=Load()),
                      args=[
                        Name(id='c', ctx=Load())]))])),
            Assign(
              targets=[
                Name(id='drafter_configs', ctx=Store())],
              value=Attribute(
                value=Attribute(
                  value=Name(id='CONFIG', ctx=Load()),
                  attr='adversarial_moe_drafting',
                  ctx=Load()),
                attr='drafters',
                ctx=Load())),
            For(
              target=Name(id='drafter_config', ctx=Store()),
              iter=Name(id='drafter_configs', ctx=Load()),
              body=[
                If(
                  test=Attribute(
                    value=Name(id='drafter_config', ctx=Load()),
                    attr='enabled',
                    ctx=Load()),
                  body=[
                    Assign(
                      targets=[
                        Name(id='drafter_name', ctx=Store())],
                      value=Attribute(
                        value=Name(id='drafter_config', ctx=Load()),
                        attr='name',
                        ctx=Load())),
                    Assign(
                      targets=[
                        Name(id='drafter_class', ctx=Store())],
                      value=Call(
                        func=Attribute(
                          value=Name(id='drafter_factory', ctx=Load()),
                          attr='get',
                          ctx=Load()),
                        args=[
                          Name(id='drafter_name', ctx=Load())])),
                    If(
                      test=Name(id='drafter_class', ctx=Load()),
                      body=[
                        Expr(
                          value=Call(
                            func=Attribute(
                              value=Attribute(
                                value=Name(id='self', ctx=Load()),
                                attr='logger',
                                ctx=Load()),
                              attr='info',
                              ctx=Load()),
                            args=[
                              JoinedStr(
                                values=[
                                  Constant(value='Initializing drafter: '),
                                  FormattedValue(
                                    value=Name(id='drafter_name', ctx=Load()),
                                    conversion=-1)])])),
                        Assign(
                          targets=[
                            Subscript(
                              value=Attribute(
                                value=Name(id='self', ctx=Load()),
                                attr='drafters',
                                ctx=Load()),
                              slice=Name(id='drafter_name', ctx=Load()),
                              ctx=Store())],
                          value=Call(
                            func=Name(id='drafter_class', ctx=Load()),
                            args=[
                              Name(id='drafter_config', ctx=Load())]))],
                      orelse=[
                        Expr(
                          value=Call(
                            func=Attribute(
                              value=Attribute(
                                value=Name(id='self', ctx=Load()),
                                attr='logger',
                                ctx=Load()),
                              attr='warning',
                              ctx=Load()),
                            args=[
                              JoinedStr(
                                values=[
                                  Constant(value='Unknown drafter name in config: '),
                                  FormattedValue(
                                    value=Name(id='drafter_name', ctx=Load()),
                                    conversion=-1)])]))])])])]),
        FunctionDef(
          name='execute',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='prompt',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='bullets',
                annotation=Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Name(id='str', ctx=Load()),
                  ctx=Load()))]),
          body=[
            Expr(
              value=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='logger',
                    ctx=Load()),
                  attr='info',
                  ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='⚔️  Adversarial MoE drafting with '),
                      FormattedValue(
                        value=Call(
                          func=Name(id='len', ctx=Load()),
                          args=[
                            Attribute(
                              value=Name(id='self', ctx=Load()),
                              attr='drafters',
                              ctx=Load())]),
                        conversion=-1),
                      Constant(value=' enabled drafters...')])])),
            Assign(
              targets=[
                Name(id='drafts', ctx=Store())],
              value=Dict()),
            For(
              target=Tuple(
                elts=[
                  Name(id='name', ctx=Store()),
                  Name(id='drafter', ctx=Store())],
                ctx=Store()),
              iter=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='drafters',
                    ctx=Load()),
                  attr='items',
                  ctx=Load())),
              body=[
                Try(
                  body=[
                    Assign(
                      targets=[
                        Name(id='draft', ctx=Store())],
                      value=Call(
                        func=Attribute(
                          value=Name(id='drafter', ctx=Load()),
                          attr='draft',
                          ctx=Load()),
                        args=[
                          Name(id='prompt', ctx=Load()),
                          Name(id='bullets', ctx=Load())])),
                    Assign(
                      targets=[
                        Subscript(
                          value=Name(id='drafts', ctx=Load()),
                          slice=Name(id='name', ctx=Load()),
                          ctx=Store())],
                      value=Name(id='draft', ctx=Load()))],
                  handlers=[
                    ExceptHandler(
                      type=Name(id='Exception', ctx=Load()),
                      name='e',
                      body=[
                        Expr(
                          value=Call(
                            func=Attribute(
                              value=Attribute(
                                value=Name(id='self', ctx=Load()),
                                attr='logger',
                                ctx=Load()),
