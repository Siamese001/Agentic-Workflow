                          FormattedValue(
                            value=Name(id='winning_strategy', ctx=Load()),
                            conversion=-1)])])),
                Assign(
                  targets=[
                    Name(id='branch_planner', ctx=Store())],
                  value=Call(
                    func=Name(id='WorkflowPlannerAgent', ctx=Load()),
                    keywords=[
                      keyword(
                        arg='strategy_type',
                        value=Name(id='winning_strategy', ctx=Load()))])),
                Assign(
                  targets=[
                    Attribute(
                      value=Name(id='blackboard', ctx=Load()),
                      attr='plan',
                      ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='branch_planner', ctx=Load()),
                      attr='create_initial_plan',
                      ctx=Load()),
                    args=[
                      Name(id='blackboard', ctx=Load())]))],
              orelse=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='logger',
                        ctx=Load()),
                      attr='info',
                      ctx=Load()),
                    args=[
                      Constant(value="Using default 'balanced' strategy...")])),
                Assign(
                  targets=[
                    Attribute(
                      value=Name(id='blackboard', ctx=Load()),
