                  ctx=Load()))],
            kwarg=arg(arg='kwargs')),
          body=[
            Assign(
              targets=[
                Name(id='sections_list', ctx=Store())],
              value=Call(
                func=Name(id='list', ctx=Load()),
                args=[
                  Call(
                    func=Attribute(
                      value=Name(id='all_sections', ctx=Load()),
                      attr='items',
                      ctx=Load()))])),
            Assign(
              targets=[
                Name(id='high_similarity_pairs', ctx=Store())],
              value=List(ctx=Load())),
            Assign(
              targets=[
                Name(id='threshold', ctx=Store())],
              value=Attribute(
                value=Attribute(
                  value=Name(id='CONFIG', ctx=Load()),
                  attr='signal_constraints',
                  ctx=Load()),
                attr='MAX_CROSS_SECTION_SIMILARITY',
                ctx=Load())),
            For(
              target=Tuple(
                elts=[
                  Name(id='i', ctx=Store()),
                  Tuple(
                    elts=[
                      Name(id='s1_name', ctx=Store()),
                      Name(id='s1_content', ctx=Store())],
                    ctx=Store())],
                ctx=Store()),
              iter=Call(
                func=Name(id='enumerate', ctx=Load()),
                args=[
                  Name(id='sections_list', ctx=Load())]),
              body=[
                For(
                  target=Tuple(
                    elts=[
                      Name(id='s2_name', ctx=Store()),
                      Name(id='s2_content', ctx=Store())],
                    ctx=Store()),
                  iter=Subscript(
                    value=Name(id='sections_list', ctx=Load()),
                    slice=Slice(
                      lower=BinOp(
                        left=Name(id='i', ctx=Load()),
                        op=Add(),
                        right=Constant(value=1))),
                    ctx=Load()),
                  body=[
                    If(
                      test=BoolOp(
                        op=Or(),
                        values=[
                          UnaryOp(
                            op=Not(),
                            operand=Name(id='s1_content', ctx=Load())),
                          UnaryOp(
                            op=Not(),
                            operand=Name(id='s2_content', ctx=Load()))]),
                      body=[
                        Continue()]),
                    Assign(
                      targets=[
                        Name(id='sim', ctx=Store())],
                      value=Call(
                        func=Attribute(
                          value=Name(id='text_utils', ctx=Load()),
                          attr='compute_similarity',
                          ctx=Load()),
                        args=[
                          Name(id='s1_content', ctx=Load()),
                          Name(id='s2_content', ctx=Load())])),
                    If(
                      test=Compare(
                        left=Name(id='sim', ctx=Load()),
                        ops=[
                          Gt()],
                        comparators=[
                          Name(id='threshold', ctx=Load())]),
                      body=[
                        Expr(
                          value=Call(
                            func=Attribute(
                              value=Name(id='high_similarity_pairs', ctx=Load()),
                              attr='append',
                              ctx=Load()),
                            args=[
                              Tuple(
                                elts=[
                                  Name(id='s1_name', ctx=Load()),
                                  Name(id='s2_name', ctx=Load()),
                                  Name(id='sim', ctx=Load())],
                                ctx=Load())]))])])]),
            Assign(
              targets=[
                Name(id='passed', ctx=Store())],
              value=Compare(
                left=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Name(id='high_similarity_pairs', ctx=Load())]),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value=0)])),
            Return(
              value=Call(
                func=Name(id='ValidationResult', ctx=Load()),
                keywords=[
                  keyword(
                    arg='rule_id',
                    value=Constant(value='R19_CROSS_SECTION_SIMILARITY')),
                  keyword(
                    arg='passed',
                    value=Name(id='passed', ctx=Load())),
                  keyword(
                    arg='severity',
                    value=IfExp(
                      test=UnaryOp(
                        op=Not(),
                        operand=Name(id='passed', ctx=Load())),
                      body=Attribute(
                        value=Name(id='ValidationSeverity', ctx=Load()),
                        attr='MEDIUM',
                        ctx=Load()),
                      orelse=Attribute(
                        value=Name(id='ValidationSeverity', ctx=Load()),
                        attr='INFO',
                        ctx=Load()))),
                  keyword(
                    arg='message',
                    value=JoinedStr(
                      values=[
                        Constant(value='High similarity pairs > '),
                        FormattedValue(
                          value=Name(id='threshold', ctx=Load()),
                          conversion=-1,
                          format_spec=JoinedStr(
