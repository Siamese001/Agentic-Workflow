    ClassDef(
      name='SimilarityValidatorAgent',
      bases=[
        Name(id='BaseAtomicValidator', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='\n    Validates cross-section similarity.\n    REFACTORED: Similarity threshold is read from CONFIG.\n    ')),
        FunctionDef(
          name='validate',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='all_sections',
                annotation=Subscript(
                  value=Name(id='Dict', ctx=Load()),
                  slice=Tuple(
                    elts=[
                      Name(id='str', ctx=Load()),
                      Name(id='str', ctx=Load())],
