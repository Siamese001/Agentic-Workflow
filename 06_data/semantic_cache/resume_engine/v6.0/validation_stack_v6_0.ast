                          conversion=-1)])),
                  keyword(
                    arg='details',
                    value=Dict(
                      keys=[
                        Constant(value='high_similarity_pairs')],
                      values=[
                        Name(id='high_similarity_pairs', ctx=Load())]))]))],
          returns=Name(id='ValidationResult', ctx=Load()))]),
