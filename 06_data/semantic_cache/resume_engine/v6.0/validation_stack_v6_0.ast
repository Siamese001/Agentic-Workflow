                ctx=Load())),
            Assign(
              targets=[
                Tuple(
                  elts=[
                    Name(id='min_wc', ctx=Store()),
                    Name(id='max_wc', ctx=Store())],
                  ctx=Store())],
              value=Tuple(
                elts=[
                  Name(id='ACCEPTABLE_MIN_WC', ctx=Load()),
                  Name(id='ACCEPTABLE_MAX_WC', ctx=Load())],
                ctx=Load())),
            If(
              test=Compare(
                left=Name(id='section', ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Attribute(
                    value=Name(id='ResumeSection', ctx=Load()),
                    attr='K1_EXECUTIVE_SUMMARY',
                    ctx=Load())]),
              body=[
                Assign(
                  targets=[
                    Name(id='min_wc', ctx=Store())],
                  value=Attribute(
                    value=Attribute(
                      value=Name(id='constraints', ctx=Load()),
                      attr='executive_summary',
                      ctx=Load()),
                    attr='word_count_min',
                    ctx=Load())),
                Assign(
                  targets=[
                    Name(id='max_wc', ctx=Store())],
                  value=Attribute(
                    value=Attribute(
                      value=Name(id='constraints', ctx=Load()),
                      attr='executive_summary',
                      ctx=Load()),
                    attr='word_count_max',
                    ctx=Load()))],
              orelse=[
                If(
                  test=BoolOp(
                    op=Or(),
                    values=[
                      Compare(
                        left=Name(id='section', ctx=Load()),
                        ops=[
                          Eq()],
                        comparators=[
                          Attribute(
                            value=Name(id='ResumeSection', ctx=Load()),
                            attr='K2_UNIFY_BULLETS',
                            ctx=Load())]),
                      Compare(
                        left=Name(id='section', ctx=Load()),
                        ops=[
                          Eq()],
                        comparators=[
                          Attribute(
                            value=Name(id='ResumeSection', ctx=Load()),
                            attr='K3_IBM_BULLETS',
                            ctx=Load())])]),
                  body=[
                    Assign(
                      targets=[
                        Name(id='min_wc', ctx=Store())],
                      value=Attribute(
                        value=Attribute(
                          value=Name(id='constraints', ctx=Load()),
                          attr='bullets',
                          ctx=Load()),
                        attr='word_count_min',
                        ctx=Load())),
                    Assign(
                      targets=[
                        Name(id='max_wc', ctx=Store())],
                      value=Attribute(
                        value=Attribute(
                          value=Name(id='constraints', ctx=Load()),
                          attr='bullets',
                          ctx=Load()),
                        attr='word_count_max',
                        ctx=Load()))])]),
            Assign(
              targets=[
                Name(id='passed', ctx=Store())],
              value=Compare(
                left=Name(id='min_wc', ctx=Load()),
                ops=[
                  LtE(),
                  LtE()],
                comparators=[
                  Name(id='word_count', ctx=Load()),
                  Name(id='max_wc', ctx=Load())])),
            Return(
              value=Call(
                func=Name(id='ValidationResult', ctx=Load()),
