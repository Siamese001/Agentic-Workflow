    ClassDef(
      name='ForbiddenVerbValidatorAgent',
      bases=[
        Name(id='BaseAtomicValidator', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='\n    Validates against forbidden verbs.\n    REFACTORED: Forbidden verb list is read from CONFIG.\n    ')),
        Assign(
          targets=[
            Name(id='FORBIDDEN_VERBS', ctx=Store())],
          value=Attribute(
            value=Attribute(
              value=Attribute(
                value=Name(id='CONFIG', ctx=Load()),
                attr='rules',
                ctx=Load()),
              attr='linguistic_validators',
              ctx=Load()),
            attr='forbidden_verbs',
            ctx=Load())),
        FunctionDef(
          name='validate',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='content',
                annotation=Name(id='str', ctx=Load()))],
            kwarg=arg(arg='kwargs')),
          body=[
            Assign(
              targets=[
                Name(id='found_verbs', ctx=Store())],
              value=List(ctx=Load())),
            For(
              target=Name(id='verb', ctx=Store()),
              iter=Attribute(
                value=Name(id='self', ctx=Load()),
                attr='FORBIDDEN_VERBS',
                ctx=Load()),
              body=[
                If(
                  test=Call(
                    func=Attribute(
                      value=Name(id='re', ctx=Load()),
                      attr='search',
                      ctx=Load()),
                    args=[
                      BinOp(
                        left=BinOp(
                          left=Constant(value='\\b'),
                          op=Add(),
                          right=Call(
                            func=Attribute(
                              value=Name(id='re', ctx=Load()),
                              attr='escape',
                              ctx=Load()),
                            args=[
                              Name(id='verb', ctx=Load())])),
                        op=Add(),
                        right=Constant(value='\\b')),
                      Name(id='content', ctx=Load()),
                      Attribute(
                        value=Name(id='re', ctx=Load()),
                        attr='IGNORECASE',
                        ctx=Load())]),
                  body=[
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Name(id='found_verbs', ctx=Load()),
                          attr='append',
                          ctx=Load()),
                        args=[
                          Name(id='verb', ctx=Load())]))])]),
            Assign(
              targets=[
                Name(id='passed', ctx=Store())],
              value=Compare(
                left=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Name(id='found_verbs', ctx=Load())]),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value=0)])),
            Return(
              value=Call(
                func=Name(id='ValidationResult', ctx=Load()),
                keywords=[
                  keyword(
                    arg='rule_id',
                    value=Constant(value='R1_NO_FORBIDDEN_VERBS')),
                  keyword(
                    arg='passed',
                    value=Name(id='passed', ctx=Load())),
                  keyword(
                    arg='severity',
                    value=IfExp(
                      test=UnaryOp(
                        op=Not(),
                        operand=Name(id='passed', ctx=Load())),
                      body=Attribute(
                        value=Name(id='ValidationSeverity', ctx=Load()),
                        attr='HIGH',
                        ctx=Load()),
                      orelse=Attribute(
                        value=Name(id='ValidationSeverity', ctx=Load()),
                        attr='INFO',
                        ctx=Load()))),
                  keyword(
                    arg='message',
                    value=IfExp(
                      test=UnaryOp(
                        op=Not(),
                        operand=Name(id='passed', ctx=Load())),
                      body=JoinedStr(
                        values=[
                          Constant(value='Found forbidden verbs: '),
                          FormattedValue(
                            value=Name(id='found_verbs', ctx=Load()),
                            conversion=-1)]),
                      orelse=Constant(value='No forbidden verbs'))),
                  keyword(
                    arg='details',
                    value=Dict(
                      keys=[
                        Constant(value='forbidden_verbs_found')],
                      values=[
                        Name(id='found_verbs', ctx=Load())]))]))],
          returns=Name(id='ValidationResult', ctx=Load()))]),
    ClassDef(
      name='GrammarTokenCountAgent',
