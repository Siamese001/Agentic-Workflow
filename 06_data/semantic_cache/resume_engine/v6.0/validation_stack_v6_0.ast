    ClassDef(
      name='BiasScrubberAgent',
      bases=[
        Name(id='BaseAtomicValidator', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='\n    Scrubs biased or problematic language.\n    REFACTORED: Biased term list is read from CONFIG.\n    ')),
        Assign(
          targets=[
            Name(id='BIASED_TERMS', ctx=Store())],
          value=Attribute(
            value=Attribute(
              value=Attribute(
                value=Name(id='CONFIG', ctx=Load()),
                attr='rules',
                ctx=Load()),
              attr='linguistic_validators',
              ctx=Load()),
            attr='biased_terms',
            ctx=Load())),
        FunctionDef(
          name='validate',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='content',
                annotation=Name(id='str', ctx=Load()))],
            kwarg=arg(arg='kwargs')),
          body=[
            Assign(
              targets=[
                Name(id='found_terms', ctx=Store())],
              value=List(ctx=Load())),
            For(
              target=Name(id='term', ctx=Store()),
              iter=Attribute(
                value=Name(id='self', ctx=Load()),
                attr='BIASED_TERMS',
                ctx=Load()),
              body=[
                If(
                  test=Call(
                    func=Attribute(
                      value=Name(id='re', ctx=Load()),
                      attr='search',
                      ctx=Load()),
                    args=[
                      BinOp(
                        left=BinOp(
                          left=Constant(value='\\b'),
                          op=Add(),
                          right=Call(
                            func=Attribute(
                              value=Name(id='re', ctx=Load()),
                              attr='escape',
                              ctx=Load()),
                            args=[
                              Name(id='term', ctx=Load())])),
                        op=Add(),
                        right=Constant(value='\\b')),
                      Name(id='content', ctx=Load()),
                      Attribute(
                        value=Name(id='re', ctx=Load()),
                        attr='IGNORECASE',
                        ctx=Load())]),
                  body=[
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Name(id='found_terms', ctx=Load()),
                          attr='append',
                          ctx=Load()),
                        args=[
                          Name(id='term', ctx=Load())]))])]),
            Assign(
              targets=[
                Name(id='passed', ctx=Store())],
              value=Compare(
                left=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Name(id='found_terms', ctx=Load())]),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value=0)])),
            Return(
              value=Call(
                func=Name(id='ValidationResult', ctx=Load()),
                keywords=[
                  keyword(
                    arg='rule_id',
                    value=Constant(value='R4_NO_BIAS')),
                  keyword(
                    arg='passed',
                    value=Name(id='passed', ctx=Load())),
                  keyword(
                    arg='severity',
                    value=IfExp(
                      test=UnaryOp(
                        op=Not(),
                        operand=Name(id='passed', ctx=Load())),
                      body=Attribute(
                        value=Name(id='ValidationSeverity', ctx=Load()),
                        attr='CRITICAL',
                        ctx=Load()),
                      orelse=Attribute(
                        value=Name(id='ValidationSeverity', ctx=Load()),
                        attr='INFO',
                        ctx=Load()))),
                  keyword(
                    arg='message',
                    value=IfExp(
                      test=UnaryOp(
                        op=Not(),
                        operand=Name(id='passed', ctx=Load())),
                      body=JoinedStr(
                        values=[
                          Constant(value='Biased terms found: '),
                          FormattedValue(
                            value=Name(id='found_terms', ctx=Load()),
                            conversion=-1)]),
                      orelse=Constant(value='No biased language'))),
                  keyword(
                    arg='details',
                    value=Dict(
                      keys=[
                        Constant(value='biased_terms')],
                      values=[
                        Name(id='found_terms', ctx=Load())]))]))],
          returns=Name(id='ValidationResult', ctx=Load()))]),
