Module(
  body=[
    ImportFrom(
      module='__future__',
      names=[
        alias(name='annotations')],
      level=0),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Iterable')],
      level=0),
    ImportFrom(
      module='meta.metacognition.models',
      names=[
        alias(name='Hypothesis')],
      level=0),
    FunctionDef(
      name='compute_uncertainty',
      args=arguments(
        args=[
          arg(
            arg='hypotheses',
            annotation=Subscript(
              value=Name(id='Iterable', ctx=Load()),
              slice=Name(id='Hypothesis', ctx=Load()),
              ctx=Load())),
          arg(
            arg='qa_signals',
            annotation=Name(id='int', ctx=Load())),
          arg(
            arg='safety_signals',
            annotation=Name(id='int', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='Compute a coarse uncertainty score in [0, 1].\n\n    Factors:\n    - spread of confidence values (higher spread ⇒ higher uncertainty)\n    - presence of QA / safety signals (more signals ⇒ higher uncertainty)\n    ')),
        Assign(
          targets=[
            Name(id='hs', ctx=Store())],
          value=Call(
            func=Name(id='list', ctx=Load()),
            args=[
              Name(id='hypotheses', ctx=Load())])),
        If(
          test=UnaryOp(
            op=Not(),
            operand=Name(id='hs', ctx=Load())),
          body=[
            Assign(
              targets=[
                Name(id='base', ctx=Store())],
              value=IfExp(
                test=BoolOp(
                  op=Or(),
                  values=[
                    Name(id='qa_signals', ctx=Load()),
                    Name(id='safety_signals', ctx=Load())]),
                body=Constant(value=0.8),
                orelse=Constant(value=0.5))),
            Return(
              value=Call(
                func=Name(id='min', ctx=Load()),
                args=[
                  Constant(value=1.0),
                  Name(id='base', ctx=Load())]))]),
        Assign(
          targets=[
            Name(id='confidences', ctx=Store())],
          value=ListComp(
            elt=Call(
              func=Name(id='float', ctx=Load()),
              args=[
                Attribute(
                  value=Name(id='h', ctx=Load()),
                  attr='confidence',
                  ctx=Load())]),
            generators=[
              comprehension(
                target=Name(id='h', ctx=Store()),
                iter=Name(id='hs', ctx=Load()),
                is_async=0)])),
        Assign(
          targets=[
            Name(id='avg', ctx=Store())],
          value=BinOp(
            left=Call(
              func=Name(id='sum', ctx=Load()),
              args=[
                Name(id='confidences', ctx=Load())]),
            op=Div(),
            right=Call(
              func=Name(id='len', ctx=Load()),
              args=[
                Name(id='confidences', ctx=Load())]))),
        Assign(
          targets=[
            Name(id='var', ctx=Store())],
          value=BinOp(
            left=Call(
              func=Name(id='sum', ctx=Load()),
              args=[
                GeneratorExp(
                  elt=BinOp(
                    left=BinOp(
                      left=Name(id='c', ctx=Load()),
                      op=Sub(),
                      right=Name(id='avg', ctx=Load())),
                    op=Pow(),
                    right=Constant(value=2)),
                  generators=[
                    comprehension(
                      target=Name(id='c', ctx=Store()),
                      iter=Name(id='confidences', ctx=Load()),
                      is_async=0)])]),
            op=Div(),
            right=Call(
              func=Name(id='max', ctx=Load()),
              args=[
                Constant(value=1),
                BinOp(
                  left=Call(
                    func=Name(id='len', ctx=Load()),
                    args=[
                      Name(id='confidences', ctx=Load())]),
                  op=Sub(),
                  right=Constant(value=1))]))),
        Assign(
          targets=[
            Name(id='spread', ctx=Store())],
          value=Call(
            func=Name(id='min', ctx=Load()),
            args=[
              Constant(value=1.0),
              BinOp(
                left=Name(id='var', ctx=Load()),
                op=Pow(),
                right=Constant(value=0.5))])),
        Assign(
          targets=[
            Name(id='qa_factor', ctx=Store())],
          value=Call(
            func=Name(id='min', ctx=Load()),
            args=[
              Constant(value=1.0),
              BinOp(
                left=Name(id='qa_signals', ctx=Load()),
                op=Div(),
                right=Constant(value=5.0))])),
        Assign(
          targets=[
            Name(id='safety_factor', ctx=Store())],
          value=Call(
            func=Name(id='min', ctx=Load()),
            args=[
              Constant(value=1.0),
              BinOp(
                left=Name(id='safety_signals', ctx=Load()),
                op=Div(),
                right=Constant(value=3.0))])),
        Assign(
          targets=[
            Name(id='score', ctx=Store())],
          value=BinOp(
            left=BinOp(
              left=BinOp(
                left=Constant(value=0.3),
                op=Mult(),
                right=Name(id='spread', ctx=Load())),
              op=Add(),
              right=BinOp(
                left=Constant(value=0.4),
                op=Mult(),
                right=Name(id='qa_factor', ctx=Load()))),
            op=Add(),
            right=BinOp(
              left=Constant(value=0.3),
              op=Mult(),
              right=Name(id='safety_factor', ctx=Load())))),
        Return(
          value=Call(
            func=Name(id='max', ctx=Load()),
            args=[
              Constant(value=0.0),
              Call(
                func=Name(id='min', ctx=Load()),
                args=[
                  Constant(value=1.0),
                  Name(id='score', ctx=Load())])]))],
      returns=Name(id='float', ctx=Load()))])