Module(
  body=[
    Expr(
      value=Constant(value='Human-in-the-loop interface module.')),
    Import(
      names=[
        alias(name='copy')]),
    FunctionDef(
      name='apply_hil_feedback',
      args=arguments(
        args=[
          arg(arg='state'),
          arg(arg='feedback')]),
      body=[
        Expr(
          value=Constant(value='Return a deep-copied state updated with human-in-the-loop feedback.')),
        Assign(
          targets=[
            Name(id='new_state', ctx=Store())],
          value=IfExp(
            test=Compare(
              left=Name(id='state', ctx=Load()),
              ops=[
                IsNot()],
              comparators=[
                Constant(value=None)]),
            body=Call(
              func=Attribute(
                value=Name(id='copy', ctx=Load()),
                attr='deepcopy',
                ctx=Load()),
              args=[
                Name(id='state', ctx=Load())]),
            orelse=Dict())),
        Assign(
          targets=[
            Subscript(
              value=Name(id='new_state', ctx=Load()),
              slice=Constant(value='hil_feedback'),
              ctx=Store())],
          value=Name(id='feedback', ctx=Load())),
        Return(
          value=Name(id='new_state', ctx=Load()))])])