Module(
  body=[
    Assign(
      targets=[
        Name(id='__version__', ctx=Store())],
      value=Constant(value='13.0')),
    Import(
      names=[
        alias(name='json')]),
    Import(
      names=[
        alias(name='os')]),
    ImportFrom(
      module='pathlib',
      names=[
        alias(name='Path')],
      level=0),
    ImportFrom(
      module='datetime',
      names=[
        alias(name='datetime')],
      level=0),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Dict'),
        alias(name='List'),
        alias(name='Any'),
        alias(name='Tuple')],
      level=0),
    ImportFrom(
      module='models_LIC',
      names=[
        alias(name='AgentStatus')],
      level=0),
    ImportFrom(
      module='state_manager_LIC',
      names=[
        alias(name='StateManager')],
      level=0),
    ImportFrom(
      module='tools_LIC',
      names=[
        alias(name='ValidationToolkit'),
        alias(name='CodeInterpreterTool')],
      level=0),
    ClassDef(
      name='HOP6_ValidationAgent',
      body=[
        Expr(
          value=Constant(value='\n    v13.0: HOP-6 Validation Agent - Rule-based validation from config.\n    \n    CRITICAL ENHANCEMENTS:\n    - Enhancement 1: Loads all rules from `validator_rules_LIC.json`.\n    - Enhancement 3: Uses StateManager for all I/O. Reads HOP-2, 3, 5. Writes HOP-6.\n    - Enhancement 5: Uses ValidationToolkit/CodeInterpreterTool for all checks.\n    \n    Single Responsibility: Validate the winning generated message against all rules.\n    ')),
        FunctionDef(
          name='__init__',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='config',
                annotation=Subscript(
                  value=Name(id='Dict', ctx=Load()),
                  slice=Tuple(
                    elts=[
                      Name(id='str', ctx=Load()),
                      Name(id='Any', ctx=Load())],
                    ctx=Load()),
                  ctx=Load())),
              arg(
                arg='toolkit',
                annotation=Name(id='ValidationToolkit', ctx=Load())),
              arg(
                arg='code_interpreter',
                annotation=Name(id='CodeInterpreterTool', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Initialize with externalized config and tools.\n        \n        Args:\n            config: Loaded from config/agent_specs_LIC.json\n            toolkit: ValidationToolkit for deterministic checks\n            code_interpreter: CodeInterpreterTool for complex scoring\n        ')),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='config',
                  ctx=Store())],
              value=Subscript(
                value=Name(id='config', ctx=Load()),
                slice=Constant(value='validation_agent'),
                ctx=Load())),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='toolkit',
                  ctx=Store())],
              value=Name(id='toolkit', ctx=Load())),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='code_interpreter',
                  ctx=Store())],
              value=Name(id='code_interpreter', ctx=Load())),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='status',
                  ctx=Store())],
              value=Attribute(
                value=Name(id='AgentStatus', ctx=Load()),
                attr='IDLE',
                ctx=Load())),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='rules',
                  ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='_load_validation_rules',
                  ctx=Load()),
                args=[
                  Constant(value='config/validator_rules_LIC.json')])),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='rule_map',
                  ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='_build_rule_map',
                  ctx=Load()))),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='execution_order',
                  ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='rules',
                    ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='validation_execution_order'),
                  Dict()])),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  Constant(value='  HOP-6: ValidationAgent Initialized')]))]),
        FunctionDef(
          name='_load_validation_rules',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='rules_file',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Loads validator_rules_LIC.json.')),
            If(
              test=UnaryOp(
                op=Not(),
                operand=Call(
                  func=Attribute(
                    value=Attribute(
                      value=Name(id='os', ctx=Load()),
                      attr='path',
                      ctx=Load()),
                    attr='exists',
                    ctx=Load()),
                  args=[
                    Name(id='rules_file', ctx=Load())])),
              body=[
                Raise(
                  exc=Call(
                    func=Name(id='FileNotFoundError', ctx=Load()),
                    args=[
                      JoinedStr(
                        values=[
                          Constant(value='CRITICAL: '),
                          FormattedValue(
                            value=Name(id='rules_file', ctx=Load()),
                            conversion=-1),
                          Constant(value=' not found.')])]))]),
            With(
              items=[
                withitem(
                  context_expr=Call(
                    func=Name(id='open', ctx=Load()),
                    args=[
                      Name(id='rules_file', ctx=Load()),
                      Constant(value='r')]),
                  optional_vars=Name(id='f', ctx=Store()))],
              body=[
                Assign(
                  targets=[
                    Name(id='rules', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='json', ctx=Load()),
                      attr='load',
                      ctx=Load()),
                    args=[
                      Name(id='f', ctx=Load())])),
                Expr(
                  value=Call(
                    func=Name(id='print', ctx=Load()),
                    args=[
                      JoinedStr(
                        values=[
                          Constant(value='  HOP-6: Loaded validation rules from '),
                          FormattedValue(
                            value=Name(id='rules_file', ctx=Load()),
                            conversion=-1)])])),
                Return(
                  value=Name(id='rules', ctx=Load()))])],
          returns=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='Any', ctx=Load())],
              ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='_build_rule_map',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Creates a simple map of rule_id -> config for fast lookup.')),
            Assign(
              targets=[
                Name(id='rule_map', ctx=Store())],
              value=Dict()),
            For(
              target=Name(id='config_group', ctx=Store()),
              iter=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='rules',
                    ctx=Load()),
                  attr='values',
                  ctx=Load())),
              body=[
                If(
                  test=BoolOp(
                    op=And(),
                    values=[
                      Call(
                        func=Name(id='isinstance', ctx=Load()),
                        args=[
                          Name(id='config_group', ctx=Load()),
                          Name(id='dict', ctx=Load())]),
                      Compare(
                        left=Constant(value='rule_id'),
                        ops=[
                          In()],
                        comparators=[
                          Name(id='config_group', ctx=Load())])]),
                  body=[
                    Assign(
                      targets=[
                        Subscript(
                          value=Name(id='rule_map', ctx=Load()),
                          slice=Subscript(
                            value=Name(id='config_group', ctx=Load()),
                            slice=Constant(value='rule_id'),
                            ctx=Load()),
                          ctx=Store())],
                      value=Name(id='config_group', ctx=Load()))])]),
            Return(
              value=Name(id='rule_map', ctx=Load()))],
          returns=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Subscript(
                  value=Name(id='Dict', ctx=Load()),
                  slice=Tuple(
                    elts=[
                      Name(id='str', ctx=Load()),
                      Name(id='Any', ctx=Load())],
                    ctx=Load()),
                  ctx=Load())],
              ctx=Load()),
            ctx=Load())),
        AsyncFunctionDef(
          name='execute',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='state_mgr',
                annotation=Name(id='StateManager', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Execute HOP-6: Validate the winning message.\n        \n        Args:\n            state_mgr: State manager for this mission\n        \n        Returns:\n            Path to output state file\n        ')),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='status',
                  ctx=Store())],
              value=Attribute(
                value=Name(id='AgentStatus', ctx=Load()),
                attr='RUNNING',
                ctx=Load())),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='\n'),
                      FormattedValue(
                        value=BinOp(
                          left=Constant(value='='),
                          op=Mult(),
                          right=Constant(value=80)),
                        conversion=-1)])])),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  Constant(value='HOP-6: VALIDATION AGENT')])),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      FormattedValue(
                        value=BinOp(
                          left=Constant(value='='),
                          op=Mult(),
                          right=Constant(value=80)),
                        conversion=-1),
                      Constant(value='\n')])])),
            Try(
              body=[
                Assign(
                  targets=[
                    Name(id='generation_state', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='state_mgr', ctx=Load()),
                      attr='read_state',
                      ctx=Load()),
                    args=[
                      Constant(value='HOP-5')])),
                Assign(
                  targets=[
                    Name(id='research_state', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='state_mgr', ctx=Load()),
                      attr='read_state',
                      ctx=Load()),
                    args=[
                      Constant(value='HOP-2')])),
                Assign(
                  targets=[
                    Name(id='grounding_state', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='state_mgr', ctx=Load()),
                      attr='read_state',
                      ctx=Load()),
                    args=[
                      Constant(value='HOP-3')])),
                Assign(
                  targets=[
                    Name(id='scaffold_state', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='state_mgr', ctx=Load()),
                      attr='read_state',
                      ctx=Load()),
                    args=[
                      Constant(value='HOP-4.5')]))],
              handlers=[
                ExceptHandler(
                  type=Name(id='FileNotFoundError', ctx=Load()),
                  name='e',
                  body=[
                    Expr(
                      value=Call(
                        func=Name(id='print', ctx=Load()),
                        args=[
                          JoinedStr(
                            values=[
                              Constant(value='  ✗ ERROR: Missing required state file: '),
                              FormattedValue(
                                value=Name(id='e', ctx=Load()),
                                conversion=-1)])])),
                    Assign(
                      targets=[
                        Attribute(
                          value=Name(id='self', ctx=Load()),
                          attr='status',
                          ctx=Store())],
                      value=Attribute(
                        value=Name(id='AgentStatus', ctx=Load()),
                        attr='FAILED',
                        ctx=Load())),
                    Raise()])]),
            Assign(
              targets=[
                Name(id='draft', ctx=Store())],
              value=Subscript(
                value=Name(id='generation_state', ctx=Load()),
                slice=Constant(value='selected_draft'),
                ctx=Load())),
            Assign(
              targets=[
                Name(id='text_to_validate', ctx=Store())],
              value=Subscript(
                value=Name(id='draft', ctx=Load()),
                slice=Constant(value='text'),
                ctx=Load())),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='Validating selected draft ('),
                      FormattedValue(
                        value=Subscript(
                          value=Name(id='draft', ctx=Load()),
                          slice=Constant(value='word_count'),
                          ctx=Load()),
                        conversion=-1),
                      Constant(value=' words)...')])])),
            Assign(
              targets=[
                Name(id='validation_results', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='_run_validation_engine',
                  ctx=Load()),
                args=[
                  Name(id='draft', ctx=Load()),
                  Name(id='research_state', ctx=Load()),
                  Name(id='grounding_state', ctx=Load()),
                  Name(id='scaffold_state', ctx=Load())])),
            Assign(
              targets=[
                Name(id='critical_issues', ctx=Store())],
              value=Call(
                func=Name(id='sum', ctx=Load()),
                args=[
                  GeneratorExp(
                    elt=Constant(value=1),
                    generators=[
                      comprehension(
                        target=Name(id='r', ctx=Store()),
                        iter=Name(id='validation_results', ctx=Load()),
                        ifs=[
                          BoolOp(
                            op=And(),
                            values=[
                              Compare(
                                left=Subscript(
                                  value=Name(id='r', ctx=Load()),
                                  slice=Constant(value='severity'),
                                  ctx=Load()),
                                ops=[
                                  Eq()],
                                comparators=[
                                  Constant(value='CRITICAL')]),
                              UnaryOp(
                                op=Not(),
                                operand=Subscript(
                                  value=Name(id='r', ctx=Load()),
                                  slice=Constant(value='passed'),
                                  ctx=Load()))])],
                        is_async=0)])])),
            Assign(
              targets=[
                Name(id='high_issues', ctx=Store())],
              value=Call(
                func=Name(id='sum', ctx=Load()),
                args=[
                  GeneratorExp(
                    elt=Constant(value=1),
                    generators=[
                      comprehension(
                        target=Name(id='r', ctx=Store()),
                        iter=Name(id='validation_results', ctx=Load()),
                        ifs=[
                          BoolOp(
                            op=And(),
                            values=[
                              Compare(
                                left=Subscript(
                                  value=Name(id='r', ctx=Load()),
                                  slice=Constant(value='severity'),
                                  ctx=Load()),
                                ops=[
                                  Eq()],
                                comparators=[
                                  Constant(value='HIGH')]),
                              UnaryOp(
                                op=Not(),
                                operand=Subscript(
                                  value=Name(id='r', ctx=Load()),
                                  slice=Constant(value='passed'),
                                  ctx=Load()))])],
                        is_async=0)])])),
            Assign(
              targets=[
                Name(id='medium_issues', ctx=Store())],
              value=Call(
                func=Name(id='sum', ctx=Load()),
                args=[
                  GeneratorExp(
                    elt=Constant(value=1),
                    generators=[
                      comprehension(
                        target=Name(id='r', ctx=Store()),
                        iter=Name(id='validation_results', ctx=Load()),
                        ifs=[
                          BoolOp(
                            op=And(),
                            values=[
                              Compare(
                                left=Subscript(
                                  value=Name(id='r', ctx=Load()),
                                  slice=Constant(value='severity'),
                                  ctx=Load()),
                                ops=[
                                  Eq()],
                                comparators=[
                                  Constant(value='MEDIUM')]),
                              UnaryOp(
                                op=Not(),
                                operand=Subscript(
                                  value=Name(id='r', ctx=Load()),
                                  slice=Constant(value='passed'),
                                  ctx=Load()))])],
                        is_async=0)])])),
            Assign(
              targets=[
                Name(id='passed', ctx=Store())],
              value=BoolOp(
                op=And(),
                values=[
                  Compare(
                    left=Name(id='critical_issues', ctx=Load()),
                    ops=[
                      Eq()],
                    comparators=[
                      Constant(value=0)]),
                  Compare(
                    left=Name(id='high_issues', ctx=Load()),
                    ops=[
                      Eq()],
                    comparators=[
                      Constant(value=0)])])),
            Assign(
              targets=[
                Name(id='output_state', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='validation_results'),
                  Constant(value='passed'),
                  Constant(value='critical_issues'),
                  Constant(value='high_issues'),
                  Constant(value='medium_issues'),
                  Constant(value='total_rules_checked')],
                values=[
                  Name(id='validation_results', ctx=Load()),
                  Name(id='passed', ctx=Load()),
                  Name(id='critical_issues', ctx=Load()),
                  Name(id='high_issues', ctx=Load()),
                  Name(id='medium_issues', ctx=Load()),
                  Call(
                    func=Name(id='len', ctx=Load()),
                    args=[
                      Name(id='validation_results', ctx=Load())])])),
            Assign(
              targets=[
                Name(id='output_path', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='state_mgr', ctx=Load()),
                  attr='write_state',
                  ctx=Load()),
                args=[
                  Constant(value='HOP-6'),
                  Name(id='output_state', ctx=Load())])),
            If(
              test=Name(id='passed', ctx=Load()),
              body=[
                Expr(
                  value=Call(
                    func=Name(id='print', ctx=Load()),
                    args=[
                      Constant(value='\n✓ Validation PASSED')]))],
              orelse=[
                Expr(
                  value=Call(
                    func=Name(id='print', ctx=Load()),
                    args=[
                      Constant(value='\n✗ Validation FAILED')]))]),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='  Critical: '),
                      FormattedValue(
                        value=Name(id='critical_issues', ctx=Load()),
                        conversion=-1)])])),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='  High: '),
                      FormattedValue(
                        value=Name(id='high_issues', ctx=Load()),
                        conversion=-1)])])),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='  Medium: '),
                      FormattedValue(
                        value=Name(id='medium_issues', ctx=Load()),
                        conversion=-1),
                      Constant(value='\n')])])),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='status',
                  ctx=Store())],
              value=Attribute(
                value=Name(id='AgentStatus', ctx=Load()),
                attr='COMPLETED',
                ctx=Load())),
            Return(
              value=Name(id='output_path', ctx=Load()))],
          returns=Name(id='str', ctx=Load())),
        FunctionDef(
          name='_run_validation_engine',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='draft',
                annotation=Subscript(
                  value=Name(id='Dict', ctx=Load()),
                  slice=Tuple(
                    elts=[
                      Name(id='str', ctx=Load()),
                      Name(id='Any', ctx=Load())],
                    ctx=Load()),
                  ctx=Load())),
              arg(
                arg='research',
                annotation=Subscript(
                  value=Name(id='Dict', ctx=Load()),
                  slice=Tuple(
                    elts=[
                      Name(id='str', ctx=Load()),
                      Name(id='Any', ctx=Load())],
                    ctx=Load()),
                  ctx=Load())),
              arg(
                arg='grounding',
                annotation=Subscript(
                  value=Name(id='Dict', ctx=Load()),
                  slice=Tuple(
                    elts=[
                      Name(id='str', ctx=Load()),
                      Name(id='Any', ctx=Load())],
                    ctx=Load()),
                  ctx=Load())),
              arg(
                arg='scaffold',
                annotation=Subscript(
                  value=Name(id='Dict', ctx=Load()),
                  slice=Tuple(
                    elts=[
                      Name(id='str', ctx=Load()),
                      Name(id='Any', ctx=Load())],
                    ctx=Load()),
                  ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Executes all validation rules from the loaded JSON config in priority order.\n        This is the new "Rule Engine" implementation for v13.0.\n        ')),
            Assign(
              targets=[
                Name(id='results', ctx=Store())],
              value=List(ctx=Load())),
            Assign(
              targets=[
                Name(id='text', ctx=Store())],
              value=Subscript(
                value=Name(id='draft', ctx=Load()),
                slice=Constant(value='text'),
                ctx=Load())),
            For(
              target=Name(id='priority_group', ctx=Store()),
              iter=Call(
                func=Name(id='sorted', ctx=Load()),
                args=[
                  Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='execution_order',
                        ctx=Load()),
                      attr='keys',
                      ctx=Load()))]),
              body=[
                For(
                  target=Name(id='rule_id', ctx=Store()),
                  iter=Subscript(
                    value=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='execution_order',
                      ctx=Load()),
                    slice=Name(id='priority_group', ctx=Load()),
                    ctx=Load()),
                  body=[
                    Assign(
                      targets=[
                        Name(id='config', ctx=Store())],
                      value=Call(
                        func=Attribute(
                          value=Attribute(
                            value=Name(id='self', ctx=Load()),
                            attr='rule_map',
                            ctx=Load()),
                          attr='get',
                          ctx=Load()),
                        args=[
                          Name(id='rule_id', ctx=Load())])),
                    If(
                      test=UnaryOp(
                        op=Not(),
                        operand=Name(id='config', ctx=Load())),
                      body=[
                        Expr(
                          value=Call(
                            func=Name(id='print', ctx=Load()),
                            args=[
                              JoinedStr(
                                values=[
                                  Constant(value="  ⚠ Warning: Rule config for '"),
                                  FormattedValue(
                                    value=Name(id='rule_id', ctx=Load()),
                                    conversion=-1),
                                  Constant(value="' not found. Skipping.")])])),
                        Continue()]),
                    Assign(
                      targets=[
                        Tuple(
                          elts=[
                            Name(id='is_valid', ctx=Store()),
                            Name(id='details', ctx=Store())],
                          ctx=Store())],
                      value=Call(
                        func=Attribute(
                          value=Name(id='self', ctx=Load()),
                          attr='_dispatch_rule',
                          ctx=Load()),
                        args=[
                          Name(id='rule_id', ctx=Load()),
                          Name(id='config', ctx=Load()),
                          Name(id='text', ctx=Load()),
                          Name(id='research', ctx=Load()),
                          Name(id='grounding', ctx=Load()),
                          Name(id='scaffold', ctx=Load()),
                          Name(id='draft', ctx=Load())])),
                    If(
                      test=UnaryOp(
                        op=Not(),
                        operand=Name(id='is_valid', ctx=Load())),
                      body=[
                        Expr(
                          value=Call(
                            func=Attribute(
                              value=Name(id='results', ctx=Load()),
                              attr='append',
                              ctx=Load()),
                            args=[
                              Call(
                                func=Attribute(
                                  value=Name(id='self', ctx=Load()),
                                  attr='_format_result',
                                  ctx=Load()),
                                args=[
                                  Constant(value=False),
                                  Name(id='config', ctx=Load()),
                                  Name(id='details', ctx=Load())])]))])])]),
            If(
              test=UnaryOp(
                op=Not(),
                operand=Name(id='results', ctx=Load())),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='results', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Dict(
                        keys=[
                          Constant(value='passed'),
                          Constant(value='severity'),
                          Constant(value='rule_id'),
                          Constant(value='message')],
                        values=[
                          Constant(value=True),
                          Constant(value='INFO'),
                          Constant(value='ALL-CHECKS'),
                          Constant(value='All validation checks passed')])]))]),
            Return(
              value=Name(id='results', ctx=Load()))],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Subscript(
              value=Name(id='Dict', ctx=Load()),
              slice=Tuple(
                elts=[
                  Name(id='str', ctx=Load()),
                  Name(id='Any', ctx=Load())],
                ctx=Load()),
              ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='_dispatch_rule',
          args=arguments(
            args=[
              arg(arg='self'),
