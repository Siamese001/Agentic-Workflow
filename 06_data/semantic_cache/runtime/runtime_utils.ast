                          left=Name(id='end', ctx=Load()),
                          op=Sub(),
                          right=Name(id='start', ctx=Load())),
                        op=Mult(),
                        right=Constant(value=1000.0))])),
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='out', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Dict(
                        keys=[
                          Constant(value='name'),
                          Constant(value='duration_ms')],
                        values=[
                          Name(id='n', ctx=Load()),
                          Name(id='dur_ms', ctx=Load())])]))]),
            Return(
