          value=Constant(value='\n    Return a shallow copy of the telemetry event list.\n\n    Intended for tests, diagnostics, or offline meta-learning.\n    ')),
        Return(
          value=Call(
            func=Name(id='list', ctx=Load()),
            args=[
              Name(id='_TELEMETRY_EVENTS', ctx=Load())]))],
      returns=Subscript(
