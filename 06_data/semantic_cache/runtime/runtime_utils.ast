                  ctx=Load()),
                ctx=Load()),
              ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Deterministic optimization hint based on planning/execution durations.\n\n    Logic:\n        • If planning > execution → suggest "reroute_fast"\n        • Else → suggest "normal"\n    ')),
        Assign(
          targets=[
            Name(id='planning', ctx=Store())],
          value=Call(
            func=Name(id='next', ctx=Load()),
            args=[
              GeneratorExp(
                elt=Name(id='s', ctx=Load()),
                generators=[
                  comprehension(
                    target=Name(id='s', ctx=Store()),
                    iter=Name(id='spans', ctx=Load()),
                    ifs=[
                      Compare(
                        left=Call(
                          func=Attribute(
                            value=Name(id='s', ctx=Load()),
                            attr='get',
                            ctx=Load()),
                          args=[
                            Constant(value='name')]),
                        ops=[
                          Eq()],
                        comparators=[
                          Constant(value='planning')])],
                    is_async=0)]),
              Dict(
                keys=[
                  Constant(value='duration_ms')],
                values=[
                  Constant(value=0)])])),
        Assign(
          targets=[
            Name(id='execution', ctx=Store())],
          value=Call(
            func=Name(id='next', ctx=Load()),
            args=[
              GeneratorExp(
                elt=Name(id='s', ctx=Load()),
                generators=[
                  comprehension(
                    target=Name(id='s', ctx=Store()),
                    iter=Name(id='spans', ctx=Load()),
                    ifs=[
                      Compare(
                        left=Call(
                          func=Attribute(
                            value=Name(id='s', ctx=Load()),
                            attr='get',
                            ctx=Load()),
                          args=[
                            Constant(value='name')]),
                        ops=[
                          Eq()],
                        comparators=[
                          Constant(value='execution')])],
                    is_async=0)]),
              Dict(
                keys=[
                  Constant(value='duration_ms')],
                values=[
                  Constant(value=0)])])),
        Assign(
          targets=[
            Name(id='p_ms', ctx=Store())],
          value=Call(
            func=Name(id='float', ctx=Load()),
            args=[
              BoolOp(
                op=Or(),
                values=[
                  Call(
                    func=Attribute(
                      value=Name(id='planning', ctx=Load()),
                      attr='get',
                      ctx=Load()),
                    args=[
                      Constant(value='duration_ms'),
                      Constant(value=0)]),
                  Constant(value=0.0)])])),
        Assign(
          targets=[
            Name(id='e_ms', ctx=Store())],
          value=Call(
            func=Name(id='float', ctx=Load()),
            args=[
              BoolOp(
                op=Or(),
                values=[
                  Call(
                    func=Attribute(
                      value=Name(id='execution', ctx=Load()),
                      attr='get',
                      ctx=Load()),
                    args=[
                      Constant(value='duration_ms'),
                      Constant(value=0)]),
                  Constant(value=0.0)])])),
        If(
          test=Compare(
            left=Name(id='p_ms', ctx=Load()),
            ops=[
              Gt()],
            comparators=[
              Name(id='e_ms', ctx=Load())]),
          body=[
            Return(
              value=Dict(
                keys=[
                  Constant(value='suggestion')],
                values=[
                  Constant(value='reroute_fast')]))]),
        Return(
          value=Dict(
            keys=[
              Constant(value='suggestion')],
            values=[
              Constant(value='normal')]))],
      returns=Subscript(
        value=Name(id='Dict', ctx=Load()),
        slice=Tuple(
          elts=[
            Name(id='str', ctx=Load()),
            Name(id='Any', ctx=Load())],
          ctx=Load()),
        ctx=Load())),
    ClassDef(
      name='Optimization',
      body=[
        Expr(
          value=Constant(value='\n    Namespace wrapper for optimization helpers.\n\n    Used by meta and orchestration layers to get coarse-grained hints.\n    ')),
        FunctionDef(
