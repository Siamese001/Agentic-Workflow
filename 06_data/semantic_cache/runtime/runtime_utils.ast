                elts=[
                  Name(id='str', ctx=Load()),
                  Name(id='Any', ctx=Load())],
                ctx=Load()),
              ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Append a telemetry event to the in-memory list.\n\n    This function must NEVER raise in normal operation.\n    ')),
        Try(
          body=[
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='_TELEMETRY_EVENTS', ctx=Load()),
                  attr='append',
                  ctx=Load()),
                args=[
                  Dict(
                    keys=[
                      Constant(value='name'),
