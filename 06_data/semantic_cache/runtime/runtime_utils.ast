                                      attr='get',
                                      ctx=Load()),
                                    args=[
                                      Constant(value='rank'),
                                      Constant(value=0)]),
                                  Constant(value=0)])])])]))]),
            Return(
              value=Name(id='out', ctx=Load()))],
          decorator_list=[
            Name(id='staticmethod', ctx=Load())],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Subscript(
              value=Name(id='Dict', ctx=Load()),
              slice=Tuple(
                elts=[
                  Name(id='str', ctx=Load()),
