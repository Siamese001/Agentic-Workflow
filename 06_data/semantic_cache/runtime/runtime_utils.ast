          slice=Tuple(
            elts=[
              Name(id='str', ctx=Load()),
              Name(id='Any', ctx=Load())],
            ctx=Load()),
          ctx=Load()),
        ctx=Load())),
    ClassDef(
      name='CostTracker',
      body=[
        Expr(
          value=Constant(value='\n    Minimal span-based timing helper used by orchestration layers.\n\n    Usage:\n        ct = CostTracker()\n        ct.start_span("planning")\n        ...\n        ct.end_span("planning")\n        snapshot = ct.snapshot()\n\n    The snapshot is consumed by:\n        • observability.summarize_run\n        • meta_profile.update_from_spans\n        • runtime_utils.Optimization.compute_hint\n    ')),
        AnnAssign(
          target=Name(id='spans', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Subscript(
                  value=Name(id='Dict', ctx=Load()),
                  slice=Tuple(
                    elts=[
                      Name(id='str', ctx=Load()),
                      Subscript(
                        value=Name(id='Optional', ctx=Load()),
                        slice=Name(id='float', ctx=Load()),
                        ctx=Load())],
                    ctx=Load()),
                  ctx=Load())],
              ctx=Load()),
            ctx=Load()),
          value=Call(
            func=Name(id='field', ctx=Load()),
            keywords=[
              keyword(
                arg='default_factory',
                value=Name(id='dict', ctx=Load()))]),
          simple=1),
        FunctionDef(
          name='start_span',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='name',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Start a span with the given name. Overwrites any existing start time.\n        ')),
            Assign(
              targets=[
                Subscript(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='spans',
                    ctx=Load()),
                  slice=Name(id='name', ctx=Load()),
                  ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='start'),
                  Constant(value='end')],
                values=[
                  Call(
                    func=Attribute(
                      value=Name(id='time', ctx=Load()),
                      attr='perf_counter',
                      ctx=Load())),
                  Constant(value=None)]))],
          returns=Constant(value=None)),
        FunctionDef(
          name='end_span',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='name',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        End a span with the given name if it has not already been ended.\n        ')),
            If(
              test=BoolOp(
                op=And(),
                values=[
                  Compare(
                    left=Name(id='name', ctx=Load()),
                    ops=[
                      In()],
                    comparators=[
                      Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='spans',
                        ctx=Load())]),
                  Compare(
                    left=Subscript(
                      value=Subscript(
                        value=Attribute(
                          value=Name(id='self', ctx=Load()),
                          attr='spans',
                          ctx=Load()),
                        slice=Name(id='name', ctx=Load()),
                        ctx=Load()),
                      slice=Constant(value='end'),
                      ctx=Load()),
                    ops=[
                      Is()],
                    comparators=[
                      Constant(value=None)])]),
              body=[
                Assign(
                  targets=[
                    Subscript(
                      value=Subscript(
                        value=Attribute(
                          value=Name(id='self', ctx=Load()),
                          attr='spans',
                          ctx=Load()),
                        slice=Name(id='name', ctx=Load()),
                        ctx=Load()),
                      slice=Constant(value='end'),
                      ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='time', ctx=Load()),
                      attr='perf_counter',
                      ctx=Load())))])],
          returns=Constant(value=None)),
        FunctionDef(
          name='snapshot',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='\n        Return a deterministic snapshot of spans:\n\n            {"spans": [{"name": str, "duration_ms": float}, ...]}\n        ')),
            AnnAssign(
              target=Name(id='out', ctx=Store()),
              annotation=Subscript(
