                args=[
                  Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='spans',
                        ctx=Load()),
                      attr='keys',
                      ctx=Load()))]),
              body=[
                Assign(
                  targets=[
                    Name(id='s', ctx=Store())],
                  value=BoolOp(
                    op=Or(),
                    values=[
                      Call(
                        func=Attribute(
                          value=Attribute(
                            value=Name(id='self', ctx=Load()),
