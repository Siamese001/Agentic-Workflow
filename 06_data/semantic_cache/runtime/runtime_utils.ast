    FunctionDef(
      name='compute_optimization_hint',
      args=arguments(
        args=[
          arg(
            arg='spans',
            annotation=Subscript(
              value=Name(id='List', ctx=Load()),
              slice=Subscript(
                value=Name(id='Dict', ctx=Load()),
