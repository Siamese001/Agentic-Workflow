                Assign(
                  targets=[
                    Name(id='start', ctx=Store())],
                  value=BoolOp(
                    op=Or(),
                    values=[
                      Call(
                        func=Attribute(
                          value=Name(id='s', ctx=Load()),
                          attr='get',
                          ctx=Load()),
                        args=[
                          Constant(value='start')]),
                      Constant(value=0.0)])),
                Assign(
                  targets=[
                    Name(id='end', ctx=Store())],
                  value=BoolOp(
                    op=Or(),
                    values=[
                      Call(
                        func=Attribute(
                          value=Name(id='s', ctx=Load()),
                          attr='get',
                          ctx=Load()),
                        args=[
                          Constant(value='end')]),
                      Name(id='start', ctx=Load())])),
                Assign(
                  targets=[
                    Name(id='dur_ms', ctx=Store())],
                  value=Call(
                    func=Name(id='max', ctx=Load()),
                    args=[
