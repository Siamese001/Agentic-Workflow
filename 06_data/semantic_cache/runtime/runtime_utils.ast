            Assign(
              targets=[
                Name(id='PENDING', ctx=Store())],
              value=Constant(value='pending'))]),
        AnnAssign(
          target=Name(id='CANONICAL_MODEL_DEFAULT', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          value=Constant(value='gpt-4.1'),
          simple=1)]),
