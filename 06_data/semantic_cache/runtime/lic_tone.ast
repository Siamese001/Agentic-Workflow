Module(
  body=[
    Expr(
      value=Constant(value='Router agent responsible for selecting the outreach path.')),
    ImportFrom(
      module='__future__',
      names=[
        alias(name='annotations')],
      level=0),
    ImportFrom(
      module='dataclasses',
      names=[
        alias(name='dataclass')],
      level=0),
    ImportFrom(
      module='safety.bias_auditor',
      names=[
        alias(name='BiasAssessment')],
      level=2),
    ClassDef(
      name='RouteDecision',
      body=[
        AnnAssign(
          target=Name(id='channel', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='priority', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1)],
      decorator_list=[
        Call(
          func=Name(id='dataclass', ctx=Load()),
          keywords=[
            keyword(
              arg='frozen',
              value=Constant(value=True))])]),
    ClassDef(
      name='RouterAgent',
      body=[
        Expr(
          value=Constant(value='Very small heuristic-based router.')),
        FunctionDef(
          name='route',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(arg='sanitized_inputs'),
              arg(
                arg='bias',
                annotation=Name(id='BiasAssessment', ctx=Load()))]),
          body=[
            Assign(
              targets=[
                Name(id='prompt', ctx=Store())],
              value=Call(
                func=Name(id='getattr', ctx=Load()),
                args=[
                  Name(id='sanitized_inputs', ctx=Load()),
                  Constant(value='prompt'),
                  Constant(value='')])),
            If(
              test=Compare(
                left=Constant(value='meeting'),
                ops=[
                  In()],
                comparators=[
                  Call(
                    func=Attribute(
                      value=Name(id='prompt', ctx=Load()),
                      attr='lower',
                      ctx=Load()))]),
              body=[
                Return(
                  value=Call(
                    func=Name(id='RouteDecision', ctx=Load()),
                    keywords=[
                      keyword(
                        arg='channel',
                        value=Constant(value='email')),
                      keyword(
                        arg='priority',
                        value=Constant(value='high'))]))]),
            Return(
              value=Call(
                func=Name(id='RouteDecision', ctx=Load()),
                keywords=[
                  keyword(
                    arg='channel',
                    value=Constant(value='email')),
                  keyword(
                    arg='priority',
                    value=Constant(value='normal'))]))],
          returns=Name(id='RouteDecision', ctx=Load()))])])