Module(
  body=[
    ImportFrom(
      module='eval.golden_state.datasets',
      names=[
        alias(name='load_golden_inputs'),
        alias(name='load_baseline_scores'),
        alias(name='load_exemplar_prompts')],
      level=0),
    FunctionDef(
      name='test_load_golden_inputs_minimum_cases',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='cases', ctx=Store())],
          value=Call(
            func=Name(id='load_golden_inputs', ctx=Load()))),
        Assert(
          test=Compare(
            left=Call(
              func=Name(id='len', ctx=Load()),
              args=[
                Name(id='cases', ctx=Load())]),
            ops=[
              GtE()],
            comparators=[
              Constant(value=2)])),
        Assign(
          targets=[
            Name(id='ids', ctx=Store())],
          value=SetComp(
            elt=Attribute(
              value=Name(id='c', ctx=Load()),
              attr='id',
              ctx=Load()),
            generators=[
              comprehension(
                target=Name(id='c', ctx=Store()),
                iter=Name(id='cases', ctx=Load()),
                is_async=0)])),
        Assert(
          test=Compare(
            left=Constant(value='gs_basic_1'),
            ops=[
              In()],
            comparators=[
              Name(id='ids', ctx=Load())])),
        Assert(
          test=Compare(
            left=Constant(value='gs_safety_1'),
            ops=[
              In()],
            comparators=[
              Name(id='ids', ctx=Load())]))]),
    FunctionDef(
      name='test_load_baselines_and_exemplars_present',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='baselines', ctx=Store())],
          value=Call(
            func=Name(id='load_baseline_scores', ctx=Load()))),
        Assign(
          targets=[
            Name(id='exemplars', ctx=Store())],
          value=Call(
            func=Name(id='load_exemplar_prompts', ctx=Load()))),
        Assert(
          test=Compare(
            left=Constant(value='avg_score'),
            ops=[
              In()],
            comparators=[
              Name(id='baselines', ctx=Load())])),
        Assert(
          test=Compare(
            left=Constant(value='gs_basic_1'),
            ops=[
              In()],
            comparators=[
              Name(id='exemplars', ctx=Load())]))])])