Module(
  body=[
    Expr(
      value=Constant(value='Validate RG_CAPABILITIES bucket structure')),
    Import(
      names=[
        alias(name='sys')]),
    Expr(
      value=Call(
        func=Attribute(
          value=Attribute(
            value=Name(id='sys', ctx=Load()),
            attr='path',
            ctx=Load()),
          attr='append',
          ctx=Load()),
        args=[
          Constant(value='C:\\Users\\amita\\Documents\\Work\\AI Job Search\\AI\\ML\\DL\\GenAI\\LLM 101\\LLM Pipelines\\Resume Gen\\Git\\Agentic_Workflow-10_11\\agentic_workflow\\RG_capabilities')])),
    ImportFrom(
      module='reconstructed_capabilities',
      names=[
        alias(name='RG_CAPABILITIES')],
      level=0),
    Assign(
      targets=[
        Name(id='expected_buckets', ctx=Store())],
      value=List(
        elts=[
          Constant(value='routing_rules'),
          Constant(value='parameter_presets'),
          Constant(value='quant_rules'),
          Constant(value='bullet_engine'),
          Constant(value='rewrite_engine'),
          Constant(value='skills_engine'),
          Constant(value='section_rules'),
          Constant(value='job_workflow_steps'),
          Constant(value='ats_rules'),
          Constant(value='template_layouts'),
          Constant(value='formatting_rules'),
          Constant(value='seniority_rules'),
          Constant(value='tone_rules'),
          Constant(value='constraints'),
          Constant(value='validator_rules'),
          Constant(value='mission_fields')],
        ctx=Load())),
    Assign(
      targets=[
        Name(id='actual_buckets', ctx=Store())],
      value=Call(
        func=Name(id='list', ctx=Load()),
        args=[
          Call(
            func=Attribute(
              value=Name(id='RG_CAPABILITIES', ctx=Load()),
              attr='keys',
              ctx=Load()))])),
    Expr(
      value=Call(
        func=Name(id='print', ctx=Load()),
        args=[
          JoinedStr(
            values=[
              Constant(value='Expected: '),
              FormattedValue(
                value=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Name(id='expected_buckets', ctx=Load())]),
                conversion=-1),
              Constant(value=' buckets')])])),
    Expr(
      value=Call(
        func=Name(id='print', ctx=Load()),
        args=[
          JoinedStr(
            values=[
              Constant(value='Actual: '),
              FormattedValue(
                value=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Name(id='actual_buckets', ctx=Load())]),
                conversion=-1),
              Constant(value=' buckets')])])),
    Assign(
      targets=[
        Name(id='extra', ctx=Store())],
      value=BinOp(
        left=Call(
          func=Name(id='set', ctx=Load()),
          args=[
            Name(id='actual_buckets', ctx=Load())]),
        op=Sub(),
        right=Call(
          func=Name(id='set', ctx=Load()),
          args=[
            Name(id='expected_buckets', ctx=Load())]))),
    Assign(
      targets=[
        Name(id='missing', ctx=Store())],
      value=BinOp(
        left=Call(
          func=Name(id='set', ctx=Load()),
          args=[
            Name(id='expected_buckets', ctx=Load())]),
        op=Sub(),
        right=Call(
          func=Name(id='set', ctx=Load()),
          args=[
            Name(id='actual_buckets', ctx=Load())]))),
    If(
      test=Name(id='extra', ctx=Load()),
      body=[
        Expr(
          value=Call(
            func=Name(id='print', ctx=Load()),
            args=[
              JoinedStr(
                values=[
                  Constant(value='Extra bucket(s): '),
                  FormattedValue(
                    value=Name(id='extra', ctx=Load()),
                    conversion=-1)])]))]),
    If(
      test=Name(id='missing', ctx=Load()),
      body=[
        Expr(
          value=Call(
            func=Name(id='print', ctx=Load()),
            args=[
              JoinedStr(
                values=[
                  Constant(value='Missing bucket(s): '),
                  FormattedValue(
                    value=Name(id='missing', ctx=Load()),
                    conversion=-1)])]))]),
    Expr(
      value=Call(
        func=Name(id='print', ctx=Load()),
        args=[
          Constant(value='\nFile counts per bucket:')])),
    Assign(
      targets=[
        Name(id='total_files', ctx=Store())],
      value=Constant(value=0)),
    For(
      target=Tuple(
        elts=[
          Name(id='bucket', ctx=Store()),
          Name(id='files', ctx=Store())],
        ctx=Store()),
      iter=Call(
        func=Attribute(
          value=Name(id='RG_CAPABILITIES', ctx=Load()),
          attr='items',
          ctx=Load())),
      body=[
        Assign(
          targets=[
            Name(id='count', ctx=Store())],
          value=Call(
            func=Name(id='len', ctx=Load()),
            args=[
              Name(id='files', ctx=Load())])),
        AugAssign(
          target=Name(id='total_files', ctx=Store()),
          op=Add(),
          value=Name(id='count', ctx=Load())),
        Expr(
          value=Call(
            func=Name(id='print', ctx=Load()),
            args=[
              JoinedStr(
                values=[
                  Constant(value='  '),
                  FormattedValue(
                    value=Name(id='bucket', ctx=Load()),
                    conversion=-1),
                  Constant(value=': '),
                  FormattedValue(
                    value=Name(id='count', ctx=Load()),
                    conversion=-1),
                  Constant(value=' files')])]))]),
    Expr(
      value=Call(
        func=Name(id='print', ctx=Load()),
        args=[
          JoinedStr(
            values=[
              Constant(value='\nTotal files: '),
              FormattedValue(
                value=Name(id='total_files', ctx=Load()),
                conversion=-1)])])),
    Expr(
      value=Call(
        func=Name(id='print', ctx=Load()),
        args=[
          Constant(value='\nSample files per bucket:')])),
    For(
      target=Tuple(
        elts=[
          Name(id='bucket', ctx=Store()),
          Name(id='files', ctx=Store())],
        ctx=Store()),
      iter=Call(
        func=Attribute(
          value=Name(id='RG_CAPABILITIES', ctx=Load()),
          attr='items',
          ctx=Load())),
      body=[
        If(
          test=Name(id='files', ctx=Load()),
          body=[
            Assign(
              targets=[
                Name(id='sample_file', ctx=Store())],
              value=Subscript(
                value=Call(
                  func=Name(id='list', ctx=Load()),
                  args=[
                    Call(
                      func=Attribute(
                        value=Name(id='files', ctx=Load()),
                        attr='keys',
                        ctx=Load()))]),
                slice=Constant(value=0),
                ctx=Load())),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='  '),
                      FormattedValue(
                        value=Name(id='bucket', ctx=Load()),
                        conversion=-1),
                      Constant(value=': '),
                      FormattedValue(
                        value=Subscript(
                          value=Call(
                            func=Attribute(
                              value=Name(id='sample_file', ctx=Load()),
                              attr='split',
                              ctx=Load()),
                            args=[
                              Constant(value='/')]),
                          slice=UnaryOp(
                            op=USub(),
                            operand=Constant(value=1)),
                          ctx=Load()),
                        conversion=-1)])]))])])])