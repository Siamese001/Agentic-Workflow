Module(
  body=[
    Expr(
      value=Constant(value='Append signature information to the outreach draft.')),
    ImportFrom(
      module='__future__',
      names=[
        alias(name='annotations')],
      level=0),
    ClassDef(
      name='SignatureAgent',
      body=[
        FunctionDef(
          name='attach',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='draft',
                annotation=Name(id='str', ctx=Load())),
              arg(arg='route_decision')]),
          body=[
            Assign(
              targets=[
                Name(id='signature', ctx=Store())],
              value=Constant(value='Best regards,\nLIC Outreach Bot')),
            Return(
              value=JoinedStr(
                values=[
                  FormattedValue(
                    value=Name(id='draft', ctx=Load()),
                    conversion=-1),
                  Constant(value='\n\n'),
                  FormattedValue(
                    value=Name(id='signature', ctx=Load()),
                    conversion=-1)]))],
          returns=Name(id='str', ctx=Load()))])])