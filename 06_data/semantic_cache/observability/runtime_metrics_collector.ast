                      Constant(value='reliability_score_'),
                      FormattedValue(
                        value=Name(id='component', ctx=Load()),
                        conversion=-1)]),
                  Name(id='reliability_score', ctx=Load())])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='collector', ctx=Load()),
                  attr='record_histogram',
                  ctx=Load()),
                args=[
                  Constant(value='reliability_distribution'),
                  Name(id='reliability_score', ctx=Load())],
                keywords=[
                  keyword(
                    arg='labels',
                    value=Dict(
                      keys=[
                        Constant(value='component')],
                      values=[
                        Name(id='component', ctx=Load())]))])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='collector', ctx=Load()),
                  attr='increment_counter',
                  ctx=Load()),
                args=[
                  Constant(value='reliability_updates')],
                keywords=[
                  keyword(
                    arg='labels',
                    value=Dict(
                      keys=[
                        Constant(value='component')],
                      values=[
                        Name(id='component', ctx=Load())]))])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='logger', ctx=Load()),
                  attr='info',
                  ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='Updated reliability score for '),
