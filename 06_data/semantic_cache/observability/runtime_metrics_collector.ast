                        value=Name(id='component', ctx=Load()),
                        conversion=-1),
                      Constant(value=': '),
                      FormattedValue(
                        value=Name(id='reliability_score', ctx=Load()),
                        conversion=-1)])])),
            Return(
              value=Constant(value=True))],
          handlers=[
            ExceptHandler(
              type=Name(id='Exception', ctx=Load()),
              name='e',
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='logger', ctx=Load()),
                      attr='error',
                      ctx=Load()),
                    args=[
                      JoinedStr(
