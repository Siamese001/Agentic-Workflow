                      attr='append',
                      ctx=Load()),
                    args=[
                      Dict(
                        keys=[
                          Constant(value='task'),
                          Constant(value='agent_role'),
                          Constant(value='reason'),
                          Constant(value='has_council'),
                          Constant(value='council_selected_id'),
                          Constant(value='council_aggregated_decision'),
                          Constant(value='council_vote_count')],
                        values=[
                          Call(
                            func=Attribute(
                              value=Name(id='attrs', ctx=Load()),
                              attr='get',
                              ctx=Load()),
                            args=[
                              Constant(value='task')]),
                          Call(
                            func=Attribute(
