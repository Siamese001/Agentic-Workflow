Module(
  body=[
    ImportFrom(
      module='types',
      names=[
        alias(name='SimpleNamespace')],
      level=0),
    ImportFrom(
      module='src.lic_agentic.reasoning.toggles',
      names=[
        alias(name='ReasoningToggles')],
      level=0),
    ImportFrom(
      module='src.lic_agentic.stacks.outreach_stack',
      names=[
        alias(name='OutreachStack')],
      level=0),
    FunctionDef(
      name='test_token_drift_guard',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='stack', ctx=Store())],
          value=Call(
            func=Name(id='OutreachStack', ctx=Load()),
            args=[
              Call(
                func=Name(id='ReasoningToggles', ctx=Load()))])),
        Assign(
          targets=[
            Name(id='sample', ctx=Store())],
          value=Call(
            func=Name(id='SimpleNamespace', ctx=Load()),
            keywords=[
              keyword(
                arg='prompt',
                value=Constant(value='Checking drift bounds')),
              keyword(
                arg='company_id',
                value=Constant(value='ACME')),
              keyword(
                arg='contact_id',
                value=Constant(value='C1'))])),
        Assign(
          targets=[
            Name(id='outcome', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='stack', ctx=Load()),
              attr='run',
              ctx=Load()),
            args=[
              Name(id='sample', ctx=Load())])),
        Assign(
          targets=[
            Name(id='verdict', ctx=Store())],
          value=Subscript(
            value=Name(id='outcome', ctx=Load()),
            slice=Constant(value='verdict'),
            ctx=Load())),
        Assert(
          test=Attribute(
            value=Name(id='verdict', ctx=Load()),
            attr='passed',
            ctx=Load())),
        Assign(
          targets=[
            Name(id='drift', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Attribute(
                value=Attribute(
                  value=Name(id='stack', ctx=Load()),
                  attr='validator',
                  ctx=Load()),
                attr='metrics',
                ctx=Load()),
              attr='token_drift',
              ctx=Load()))),
        Assert(
          test=Compare(
            left=Name(id='drift', ctx=Load()),
            ops=[
              LtE()],
            comparators=[
              Constant(value=0.1)]))])])