            ctx=Load()),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='HybridRetriever',
      body=[
        Expr(
          value=Constant(value='Hybrid retrieval system combining multiple retrieval methods')),
        FunctionDef(
          name='__init__',
          args=arguments(
