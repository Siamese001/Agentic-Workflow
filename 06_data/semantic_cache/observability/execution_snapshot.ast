        AnnAssign(
          target=Name(id='query_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='retrieval_type', ctx=Store()),
          annotation=Name(id='RetrievalType', ctx=Load()),
          simple=1),
        AnnAssign(
