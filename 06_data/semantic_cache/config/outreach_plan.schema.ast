                        comparators=[
                          Constant(value=0)])]),
                  body=[
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Name(id='achievements', ctx=Load()),
                          attr='append',
                          ctx=Load()),
                        args=[
