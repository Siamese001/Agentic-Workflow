Module(
  body=[
    ImportFrom(
      module='__future__',
      names=[
        alias(name='annotations')],
      level=0),
    ImportFrom(
      module='typing',
      names=[
        alias(name='List')],
      level=0),
    ImportFrom(
      module='config.agent_profile',
      names=[
        alias(name='AgentCard')],
      level=0),
    ImportFrom(
      module='orchestration.agent_registry',
      names=[
        alias(name='AgentRegistry')],
      level=0),
    Expr(
      value=Constant(value='Defines simple routing rules that pick which specialist agents handle planning, drafting, review, and safety so each resume step is done by the right expertise.')),
    FunctionDef(
      name='choose_agents_for_task',
      args=arguments(
        args=[
          arg(
            arg='task_type',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='registry',
            annotation=Name(id='AgentRegistry', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='Chooses agents for a given task type so planning, retrieval, drafting, QA, and safety work are handled by specialists, leading to clearer, more relevant, and safer resumes.')),
        Assign(
          targets=[
            Name(id='mapping', ctx=Store())],
          value=Dict(
            keys=[
              Constant(value='strategy'),
              Constant(value='planning'),
              Constant(value='retrieval'),
              Constant(value='rag'),
              Constant(value='drafting'),
              Constant(value='qa'),
              Constant(value='safety')],
            values=[
              Constant(value='planner'),
              Constant(value='planner'),
              Constant(value='researcher'),
              Constant(value='researcher'),
              Constant(value='drafter'),
              Constant(value='qa'),
              Constant(value='safety')])),
        Assign(
          targets=[
            Name(id='desired_type', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='mapping', ctx=Load()),
              attr='get',
              ctx=Load()),
            args=[
              Name(id='task_type', ctx=Load())])),
        If(
          test=Compare(
            left=Name(id='desired_type', ctx=Load()),
            ops=[
              Is()],
            comparators=[
              Constant(value=None)]),
          body=[
            Return(
              value=Call(
                func=Name(id='list', ctx=Load()),
                args=[
                  Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='registry', ctx=Load()),
                        attr='agents',
                        ctx=Load()),
                      attr='values',
                      ctx=Load()))]))]),
        Assign(
          targets=[
            Name(id='candidates', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='registry', ctx=Load()),
              attr='find_agents_by_type',
              ctx=Load()),
            args=[
              Name(id='desired_type', ctx=Load())])),
        Return(
          value=BoolOp(
            op=Or(),
            values=[
              Name(id='candidates', ctx=Load()),
              Call(
                func=Name(id='list', ctx=Load()),
                args=[
                  Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='registry', ctx=Load()),
                        attr='agents',
                        ctx=Load()),
                      attr='values',
                      ctx=Load()))])]))],
      returns=Subscript(
        value=Name(id='List', ctx=Load()),
        slice=Name(id='AgentCard', ctx=Load()),
        ctx=Load()))])