                      value=Call(
                        func=Attribute(
                          value=Name(id='self', ctx=Load()),
                          attr='_sanitize_text',
                          ctx=Load()),
                        args=[
                          Name(id='node', ctx=Load())]))]),
                Return(
                  value=Name(id='node', ctx=Load()))],
              returns=Name(id='Any', ctx=Load())),
            Assign(
              targets=[
                Name(id='sanitized', ctx=Store())],
              value=Call(
                func=Name(id='sanitize_node', ctx=Load()),
