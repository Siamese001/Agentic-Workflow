            values=[
              Call(
                func=Attribute(
                  value=Name(id='re', ctx=Load()),
                  attr='compile',
                  ctx=Load()),
                args=[
                  Constant(value='\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Z|a-z]{2,}\\b')]),
              Call(
                func=Attribute(
                  value=Name(id='re', ctx=Load()),
                  attr='compile',
                  ctx=Load()),
                args=[
                  Constant(value='\\b(?:\\+?1[ -]?)?\\(?\\d{3}\\)?[ -]?\\d{3}[ -]?\\d{4}\\b')]),
              Call(
                func=Attribute(
                  value=Name(id='re', ctx=Load()),
                  attr='compile',
                  ctx=Load()),
                args=[
                  Constant(value='\\b[A-Z][a-z]+ [A-Z][a-z]+\\b')])])),
        FunctionDef(
          name='run',
