              value=Call(
                func=Attribute(
                  value=Name(id='json', ctx=Load()),
                  attr='loads',
                  ctx=Load()),
                args=[
                  Call(
                    func=Attribute(
                      value=Name(id='json', ctx=Load()),
                      attr='dumps',
                      ctx=Load()),
                    args=[
                      Name(id='resume', ctx=Load())])])),
            FunctionDef(
              name='sanitize_node',
              args=arguments(
                args=[
                  arg(
                    arg='node',
                    annotation=Name(id='Any', ctx=Load()))]),
              body=[
                If(
                  test=Call(
                    func=Name(id='isinstance', ctx=Load()),
