                              ctx=Store()),
                            iter=Call(
                              func=Attribute(
                                value=Name(id='node', ctx=Load()),
                                attr='items',
                                ctx=Load())),
                            is_async=0)]))]),
                If(
                  test=Call(
                    func=Name(id='isinstance', ctx=Load()),
                    args=[
                      Name(id='node', ctx=Load()),
                      Name(id='list', ctx=Load())]),
                  body=[
                    Return(
                      value=ListComp(
                        elt=Call(
                          func=Name(id='sanitize_node', ctx=Load()),
                          args=[
                            Name(id='item', ctx=Load())]),
                        generators=[
                          comprehension(
                            target=Name(id='item', ctx=Store()),
