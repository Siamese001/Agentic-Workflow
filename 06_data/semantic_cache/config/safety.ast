    ClassDef(
      name='PIISanitizerAgent',
      bases=[
        Name(id='BaseAgent', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Performs local PII detection using regex heuristics.')),
        Assign(
          targets=[
            Name(id='PII_PATTERNS', ctx=Store())],
          value=Dict(
            keys=[
              Constant(value='EMAIL'),
              Constant(value='PHONE'),
