    ClassDef(
      name='BiasDetectorAgent',
      bases=[
        Name(id='BaseAgent', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Local bias detection with regex (no external API)')),
        Assign(
          targets=[
            Name(id='BIAS_PATTERNS', ctx=Store())],
          value=Dict(
            keys=[
              Constant(value='gender'),
              Constant(value='age'),
              Constant(value='cultural')],
            values=[
              List(
                elts=[
                  Constant(value='\\b(he|she|his|her|him|himself|herself)\\b'),
                  Constant(value='\\b(male|female|man|woman|boy|girl)\\b')],
                ctx=Load()),
              List(
                elts=[
                  Constant(value='\\b(young|old|elderly|senior|junior)\\b'),
                  Constant(value='\\b\\d{1,2}[\\s\\-]?year[\\s\\-]?old\\b')],
                ctx=Load()),
              List(
                elts=[
                  Constant(value='\\b(native|foreign|immigrant|alien)\\b')],
                ctx=Load())])),
        FunctionDef(
          name='__init__',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='context',
                annotation=Name(id='WorkflowContext', ctx=Load())),
              arg(
                arg='debug_mode',
                annotation=Name(id='bool', ctx=Load()))],
            defaults=[
              Constant(value=False)]),
          body=[
            Expr(
              value=Call(
                func=Attribute(
                  value=Call(
                    func=Name(id='super', ctx=Load())),
                  attr='__init__',
                  ctx=Load()),
                args=[
                  Name(id='context', ctx=Load()),
                  Name(id='debug_mode', ctx=Load())]))]),
        FunctionDef(
          name='run',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='text',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Detect bias using local regex')),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='log_info',
                  ctx=Load()),
                args=[
                  Constant(value='Running LOCAL bias detection...')])),
            Assign(
              targets=[
                Name(id='detected_biases', ctx=Store())],
              value=List(ctx=Load())),
            For(
              target=Tuple(
                elts=[
                  Name(id='bias_type', ctx=Store()),
                  Name(id='patterns', ctx=Store())],
                ctx=Store()),
              iter=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='BIAS_PATTERNS',
                    ctx=Load()),
                  attr='items',
                  ctx=Load())),
              body=[
                For(
                  target=Name(id='pattern', ctx=Store()),
                  iter=Name(id='patterns', ctx=Load()),
                  body=[
                    Assign(
                      targets=[
                        Name(id='matches', ctx=Store())],
                      value=Call(
                        func=Attribute(
                          value=Name(id='re', ctx=Load()),
                          attr='findall',
                          ctx=Load()),
                        args=[
                          Name(id='pattern', ctx=Load()),
                          Name(id='text', ctx=Load()),
                          Attribute(
                            value=Name(id='re', ctx=Load()),
                            attr='IGNORECASE',
                            ctx=Load())])),
                    If(
                      test=Name(id='matches', ctx=Load()),
                      body=[
                        Expr(
                          value=Call(
                            func=Attribute(
                              value=Name(id='detected_biases', ctx=Load()),
                              attr='append',
                              ctx=Load()),
                            args=[
                              Dict(
                                keys=[
                                  Constant(value='type'),
                                  Constant(value='pattern'),
                                  Constant(value='matches')],
                                values=[
                                  Name(id='bias_type', ctx=Load()),
                                  Name(id='pattern', ctx=Load()),
                                  Name(id='matches', ctx=Load())])]))])])]),
            Assign(
              targets=[
                Name(id='bias_detected', ctx=Store())],
              value=Compare(
                left=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Name(id='detected_biases', ctx=Load())]),
                ops=[
                  Gt()],
                comparators=[
                  Constant(value=0)])),
            If(
              test=Name(id='bias_detected', ctx=Load()),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='log_warning',
                      ctx=Load()),
                    args=[
                      JoinedStr(
                        values=[
                          Constant(value='Detected '),
                          FormattedValue(
                            value=Call(
                              func=Name(id='len', ctx=Load()),
                              args=[
                                Name(id='detected_biases', ctx=Load())]),
                            conversion=-1),
                          Constant(value=' potential bias patterns')])]))]),
            Return(
              value=Dict(
                keys=[
                  Constant(value='bias_detected'),
                  Constant(value='biases'),
                  Constant(value='bias_score')],
                values=[
                  Name(id='bias_detected', ctx=Load()),
                  Name(id='detected_biases', ctx=Load()),
                  BinOp(
                    left=Call(
                      func=Name(id='len', ctx=Load()),
                      args=[
                        Name(id='detected_biases', ctx=Load())]),
                    op=Div(),
                    right=Constant(value=10.0))]))],
          returns=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='Any', ctx=Load())],
              ctx=Load()),
            ctx=Load()))]),
