              Attribute(
                value=Name(id='result', ctx=Load()),
                attr='text',
                ctx=Load()),
              Name(id='metadata', ctx=Load())])),
        Assign(
          targets=[
            Name(id='signal_type', ctx=Store())],
          value=Call(
            func=Name(id='_classify_signal_type', ctx=Load()),
            args=[
              Attribute(
                value=Name(id='result', ctx=Load()),
                attr='text',
                ctx=Load()),
              Name(id='metadata', ctx=Load())])),
        Assign(
          targets=[
            Name(id='is_signal_candidate', ctx=Store())],
          value=Compare(
            left=Name(id='signal_score', ctx=Load()),
            ops=[
              GtE()],
            comparators=[
              Constant(value=0.7)])),
        Return(
          value=Call(
