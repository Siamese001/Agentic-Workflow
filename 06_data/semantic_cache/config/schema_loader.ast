      returns=Name(id='OutreachRAGResult', ctx=Load())),
    FunctionDef(
      name='_compute_age_days',
      args=arguments(
        args=[
          arg(
            arg='ts',
            annotation=Subscript(
              value=Name(id='Optional', ctx=Load()),
              slice=Name(id='str', ctx=Load()),
              ctx=Load()))]),
      body=[
        If(
          test=UnaryOp(
            op=Not(),
            operand=Name(id='ts', ctx=Load())),
          body=[
            Return(
              value=Constant(value=365))]),
        Try(
          body=[
            Assign(
              targets=[
                Name(id='dt', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='datetime', ctx=Load()),
                  attr='fromisoformat',
                  ctx=Load()),
                args=[
                  Call(
                    func=Attribute(
                      value=Name(id='ts', ctx=Load()),
                      attr='replace',
                      ctx=Load()),
                    args=[
                      Constant(value='Z'),
                      Constant(value='+00:00')])])),
            Return(
              value=Attribute(
                value=BinOp(
                  left=Call(
                    func=Attribute(
                      value=Name(id='datetime', ctx=Load()),
                      attr='now',
                      ctx=Load()),
                    args=[
                      Attribute(
                        value=Name(id='timezone', ctx=Load()),
                        attr='utc',
                        ctx=Load())]),
                  op=Sub(),
                  right=Name(id='dt', ctx=Load())),
                attr='days',
                ctx=Load()))],
          handlers=[
            ExceptHandler(
              type=Name(id='Exception', ctx=Load()),
              body=[
                Return(
                  value=Constant(value=365))])])],
      returns=Name(id='int', ctx=Load())),
    FunctionDef(
      name='_compute_signal_score',
      args=arguments(
        args=[
          arg(
            arg='text',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='metadata',
            annotation=Subscript(
              value=Name(id='Dict', ctx=Load()),
              slice=Tuple(
                elts=[
                  Name(id='str', ctx=Load()),
                  Name(id='Any', ctx=Load())],
                ctx=Load()),
              ctx=Load()))]),
      body=[
        Assign(
          targets=[
            Name(id='score', ctx=Store())],
          value=Constant(value=0.5)),
        If(
          test=Call(
            func=Attribute(
              value=Name(id='re', ctx=Load()),
              attr='search',
              ctx=Load()),
            args=[
              Constant(value='\\d+%|\\$\\d+|\\d+x'),
              Name(id='text', ctx=Load())]),
          body=[
            AugAssign(
              target=Name(id='score', ctx=Store()),
              op=Add(),
              value=Constant(value=0.2))]),
        If(
          test=Call(
            func=Attribute(
              value=Name(id='metadata', ctx=Load()),
              attr='get',
              ctx=Load()),
            args=[
              Constant(value='timestamp')]),
          body=[
            AugAssign(
              target=Name(id='score', ctx=Store()),
              op=Add(),
              value=Constant(value=0.1))]),
        If(
          test=Call(
            func=Attribute(
              value=Name(id='metadata', ctx=Load()),
              attr='get',
              ctx=Load()),
            args=[
              Constant(value='named_entities')]),
          body=[
            AugAssign(
              target=Name(id='score', ctx=Store()),
              op=Add(),
              value=Constant(value=0.2))]),
        If(
          test=Call(
            func=Attribute(
              value=Name(id='metadata', ctx=Load()),
              attr='get',
              ctx=Load()),
            args=[
              Constant(value='is_signal_candidate')]),
          body=[
            AugAssign(
              target=Name(id='score', ctx=Store()),
              op=Add(),
              value=Constant(value=0.1))]),
        If(
          test=Call(
            func=Attribute(
              value=Name(id='re', ctx=Load()),
              attr='search',
              ctx=Load()),
            args=[
              Constant(value='strategy|vision|transform|initiative'),
              Call(
                func=Attribute(
                  value=Name(id='text', ctx=Load()),
                  attr='lower',
                  ctx=Load()))]),
          body=[
            AugAssign(
              target=Name(id='score', ctx=Store()),
              op=Add(),
              value=Constant(value=0.2))],
          orelse=[
            If(
              test=Call(
                func=Attribute(
                  value=Name(id='re', ctx=Load()),
                  attr='search',
                  ctx=Load()),
                args=[
                  Constant(value='recently|just|announced|launched'),
                  Call(
                    func=Attribute(
                      value=Name(id='text', ctx=Load()),
                      attr='lower',
                      ctx=Load()))]),
              body=[
                AugAssign(
                  target=Name(id='score', ctx=Store()),
                  op=Add(),
                  value=Constant(value=0.2))])]),
        Return(
          value=Call(
            func=Name(id='min', ctx=Load()),
            args=[
              Name(id='score', ctx=Load()),
              Constant(value=1.0)]))],
      returns=Name(id='float', ctx=Load())),
    FunctionDef(
      name='_classify_signal_type',
      args=arguments(
        args=[
          arg(
            arg='text',
            annotation=Name(id='str', ctx=Load())),
          arg(
