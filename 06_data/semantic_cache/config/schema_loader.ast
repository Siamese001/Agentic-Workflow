            Name(id='source', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='metadata', ctx=Load()),
              attr='get',
              ctx=Load()),
            args=[
              Constant(value='source'),
              Constant(value='unknown')])),
        Assign(
          targets=[
            Name(id='source_weight', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='metadata', ctx=Load()),
              attr='get',
              ctx=Load()),
            args=[
              Constant(value='source_weight'),
              Constant(value=1.0)])),
        Assign(
          targets=[
            Name(id='timestamp', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='metadata', ctx=Load()),
              attr='get',
              ctx=Load()),
            args=[
              Constant(value='timestamp')])),
        Assign(
          targets=[
            Name(id='age_days', ctx=Store())],
          value=Call(
            func=Name(id='_compute_age_days', ctx=Load()),
