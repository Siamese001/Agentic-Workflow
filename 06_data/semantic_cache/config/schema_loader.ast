                elts=[
                  Name(id='str', ctx=Load()),
                  Name(id='Any', ctx=Load())],
                ctx=Load()),
              ctx=Load()))]),
      body=[
        Assign(
          targets=[
            Name(id='t', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='text', ctx=Load()),
              attr='lower',
              ctx=Load()))),
        If(
          test=Call(
            func=Attribute(
              value=Name(id='re', ctx=Load()),
              attr='search',
              ctx=Load()),
            args=[
              Constant(value='\\d+%|\\$\\d+|\\d+x|revenue|growth'),
              Name(id='t', ctx=Load())]),
          body=[
            Return(
              value=Constant(value='quantitative'))]),
        If(
          test=Call(
            func=Attribute(
              value=Name(id='re', ctx=Load()),
              attr='search',
              ctx=Load()),
            args=[
              Constant(value='strategy|vision|transform|initiative'),
              Name(id='t', ctx=Load())]),
          body=[
            Return(
              value=Constant(value='strategic'))]),
        If(
          test=Call(
            func=Attribute(
              value=Name(id='re', ctx=Load()),
              attr='search',
              ctx=Load()),
            args=[
              Constant(value='recently|just|announced|launched'),
              Name(id='t', ctx=Load())]),
          body=[
            Return(
              value=Constant(value='recent_activity'))]),
        Return(
          value=Constant(value='general'))],
      returns=Subscript(
        value=Name(id='Optional', ctx=Load()),
        slice=Name(id='str', ctx=Load()),
        ctx=Load()))])