          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    FunctionDef(
      name='format_as_outreach_result',
      args=arguments(
        args=[
          arg(
            arg='result',
            annotation=Name(id='SearchResult', ctx=Load()))]),
      body=[
        Assign(
          targets=[
            Name(id='metadata', ctx=Store())],
          value=BoolOp(
            op=Or(),
            values=[
              Attribute(
                value=Name(id='result', ctx=Load()),
                attr='metadata',
                ctx=Load()),
              Dict()])),
        Assign(
          targets=[
            Name(id='company', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='metadata', ctx=Load()),
              attr='get',
              ctx=Load()),
            args=[
              Constant(value='company'),
              Constant(value='N/A')])),
        Assign(
          targets=[
            Name(id='title', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='metadata', ctx=Load()),
              attr='get',
              ctx=Load()),
            args=[
              Constant(value='title'),
              Constant(value='N/A')])),
        Assign(
