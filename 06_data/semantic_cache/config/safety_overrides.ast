                  Constant(value='\\$\\([^(]*\\)'),
                  Constant(value='`[^`]*`'),
                  Constant(value='&&\\s*[a-zA-Z]'),
                  Constant(value='\\|\\|\\s*[a-zA-Z]'),
                  Constant(value=';\\s*(rm|cat|ls|cd|pwd|whoami|id)')],
                ctx=Load())),
            Assign(
              targets=[
