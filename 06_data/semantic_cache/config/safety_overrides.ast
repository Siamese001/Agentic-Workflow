              value=List(
                elts=[
                  Constant(value="('|(\\\\')|(;)|(\\\\;))"),
                  Constant(value="((\\%27)|(\\'))((\\%6F)|o|(\\%4F))((\\%72)|r|(\\%52))"),
                  Constant(value='union.*select'),
                  Constant(value='drop.*table'),
                  Constant(value='insert.*into'),
                  Constant(value='delete.*from')],
                ctx=Load())),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='command_patterns',
                  ctx=Store())],
              value=List(
