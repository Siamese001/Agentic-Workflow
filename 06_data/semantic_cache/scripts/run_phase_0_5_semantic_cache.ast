                                        values=[
                                          Constant(value='Corrupted artifact: '),
                                          FormattedValue(
                                            value=Name(id='artifact_file', ctx=Load()),
                                            conversion=-1),
                                          Constant(value=' - '),
                                          FormattedValue(
                                            value=Name(id='e', ctx=Load()),
                                            conversion=-1)])]))])])])])]),
            Assign(
              targets=[
                Subscript(
                  value=Name(id='integrity_results', ctx=Load()),
                  slice=Constant(value='overall_valid'),
                  ctx=Store())],
              value=Compare(
                left=Subscript(
