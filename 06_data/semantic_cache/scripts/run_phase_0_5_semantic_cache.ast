              keyword(
                arg='formatter_class',
                value=Attribute(
                  value=Name(id='argparse', ctx=Load()),
                  attr='RawDescriptionHelpFormatter',
                  ctx=Load())),
              keyword(
                arg='epilog',
                value=Constant(value='\nExamples:\n    python scripts/run_phase_0_5_semantic_cache.py --dry-run\n    python scripts/run_phase_0_5_semantic_cache.py --validate-only\n    python scripts/run_phase_0_5_semantic_cache.py --engine RG\n    python scripts/run_phase_0_5_semantic_cache.py  # Full rebuild\n        '))])),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='parser', ctx=Load()),
              attr='add_argument',
              ctx=Load()),
            args=[
              Constant(value='--dry-run')],
            keywords=[
              keyword(
                arg='action',
                value=Constant(value='store_true')),
              keyword(
                arg='help',
                value=Constant(value='Perform dry-run validation without processing files'))])),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='parser', ctx=Load()),
              attr='add_argument',
              ctx=Load()),
            args=[
              Constant(value='--validate-only')],
            keywords=[
              keyword(
                arg='action',
                value=Constant(value='store_true')),
              keyword(
                arg='help',
                value=Constant(value='Validate existing semantic cache without rebuilding'))])),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='parser', ctx=Load()),
              attr='add_argument',
              ctx=Load()),
            args=[
              Constant(value='--engine')],
            keywords=[
