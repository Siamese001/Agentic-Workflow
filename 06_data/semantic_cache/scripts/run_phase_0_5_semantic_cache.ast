                        ctx=Load()),
                      attr='output_root',
                      ctx=Load()),
                    op=Div(),
                    right=Constant(value='outreach_engine'))],
                ctx=Load()),
              body=[
                If(
                  test=UnaryOp(
                    op=Not(),
                    operand=Call(
                      func=Attribute(
                        value=Name(id='engine_dir', ctx=Load()),
                        attr='exists',
                        ctx=Load()))),
                  body=[
                    Continue()]),
                For(
                  target=Name(id='version_dir', ctx=Store()),
                  iter=Call(
                    func=Attribute(
                      value=Name(id='engine_dir', ctx=Load()),
                      attr='iterdir',
                      ctx=Load())),
                  body=[
                    If(
                      test=UnaryOp(
                        op=Not(),
                        operand=Call(
                          func=Attribute(
                            value=Name(id='version_dir', ctx=Load()),
                            attr='is_dir',
                            ctx=Load()))),
                      body=[
                        Continue()]),
                    For(
                      target=Name(id='artifact_file', ctx=Store()),
                      iter=Call(
                        func=Attribute(
                          value=Name(id='version_dir', ctx=Load()),
                          attr='glob',
                          ctx=Load()),
                        args=[
                          Constant(value='*.json')]),
                      body=[
                        AugAssign(
                          target=Subscript(
                            value=Name(id='integrity_results', ctx=Load()),
                            slice=Constant(value='total_artifacts'),
                            ctx=Store()),
                          op=Add(),
                          value=Constant(value=1)),
                        Try(
                          body=[
                            With(
                              items=[
                                withitem(
                                  context_expr=Call(
                                    func=Name(id='open', ctx=Load()),
                                    args=[
                                      Name(id='artifact_file', ctx=Load()),
                                      Constant(value='r')],
                                    keywords=[
                                      keyword(
                                        arg='encoding',
                                        value=Constant(value='utf-8'))]),
                                  optional_vars=Name(id='f', ctx=Store()))],
                              body=[
                                Expr(
                                  value=Call(
                                    func=Attribute(
                                      value=Name(id='json', ctx=Load()),
                                      attr='load',
                                      ctx=Load()),
                                    args=[
                                      Name(id='f', ctx=Load())]))]),
                            AugAssign(
                              target=Subscript(
                                value=Name(id='integrity_results', ctx=Load()),
                                slice=Constant(value='valid_artifacts'),
                                ctx=Store()),
                              op=Add(),
                              value=Constant(value=1))],
                          handlers=[
                            ExceptHandler(
                              type=Tuple(
                                elts=[
                                  Attribute(
                                    value=Name(id='json', ctx=Load()),
                                    attr='JSONDecodeError',
                                    ctx=Load()),
                                  Name(id='UnicodeDecodeError', ctx=Load())],
                                ctx=Load()),
                              name='e',
                              body=[
                                AugAssign(
                                  target=Subscript(
                                    value=Name(id='integrity_results', ctx=Load()),
                                    slice=Constant(value='corrupted_artifacts'),
                                    ctx=Store()),
                                  op=Add(),
                                  value=Constant(value=1)),
                                Expr(
