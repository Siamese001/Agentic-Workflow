              ctx=Store())],
          value=Call(
            func=Name(id='Path', ctx=Load()),
            args=[
              Attribute(
                value=Name(id='args', ctx=Load()),
                attr='output_dir',
                ctx=Load())])),
        Assign(
          targets=[
