                  Constant(value='overall_valid')],
                values=[
                  Constant(value=0),
                  Constant(value=0),
                  Constant(value=0),
                  Constant(value=True)])),
            For(
              target=Name(id='engine_dir', ctx=Store()),
              iter=List(
                elts=[
                  BinOp(
                    left=Attribute(
                      value=Attribute(
                        value=Name(id='self', ctx=Load()),
