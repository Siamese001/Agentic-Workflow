        Assign(
          targets=[
            Name(id='parser', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='argparse', ctx=Load()),
              attr='ArgumentParser',
              ctx=Load()),
            keywords=[
              keyword(
                arg='description',
