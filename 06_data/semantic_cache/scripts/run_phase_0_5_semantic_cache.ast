        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='parser', ctx=Load()),
              attr='add_argument',
              ctx=Load()),
            args=[
              Constant(value='--max-workers')],
            keywords=[
              keyword(
                arg='type',
