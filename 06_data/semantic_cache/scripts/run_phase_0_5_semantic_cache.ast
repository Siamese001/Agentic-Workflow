                                  slice=Constant(value='total_archives'),
                                  ctx=Load()),
                                conversion=-1)])])),
                    Expr(
                      value=Call(
                        func=Name(id='print', ctx=Load()),
                        args=[
                          JoinedStr(
                            values=[
                              Constant(value='  Total files: '),
