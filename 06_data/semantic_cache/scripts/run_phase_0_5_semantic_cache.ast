                          right=Constant(value=80)))])),
                Expr(
                  value=Call(
                    func=Name(id='print', ctx=Load()),
                    args=[
                      Constant(value='DRY-RUN VALIDATION RESULTS')])),
                Expr(
                  value=Call(
                    func=Name(id='print', ctx=Load()),
                    args=[
                      BinOp(
                        left=Constant(value='='),
                        op=Mult(),
                        right=Constant(value=80))])),
                Expr(
                  value=Call(
                    func=Name(id='print', ctx=Load()),
