          value=Call(
            func=Name(id='Phase05Orchestrator', ctx=Load()),
            args=[
              Name(id='config', ctx=Load())])),
        Try(
          body=[
            If(
              test=Attribute(
                value=Name(id='args', ctx=Load()),
                attr='dry_run',
                ctx=Load()),
              body=[
                Assign(
                  targets=[
