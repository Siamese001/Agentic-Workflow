            "body": [
              {
                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Fuse multiple pre-ranked lists into a single deterministic list.\n\n    Algorithm:\n        1. Flatten\n        2. Deduplicate by (query, evidence)\n        3. Sort by minimal rank across groups\n        4. Secondary sort by alphabetical evidence\n        5. Re-assign ranks\n\n    All behavior purely deterministic.\n    ",
                      "kind": "None"
                    },
                    "_lineno": 105,
                    "_col_offset": 4
                  }
                },
                "_lineno": 105,
                "_col_offset": 4
              },
