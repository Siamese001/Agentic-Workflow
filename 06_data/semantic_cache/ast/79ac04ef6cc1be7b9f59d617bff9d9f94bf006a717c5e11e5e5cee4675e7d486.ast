                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Apply a ranking strategy:\n\n        \"bm25\"\n        \"dense\"\n        \"hybrid\"\n        anything else \u2192 hybrid\n\n    After ranking, all candidates receive a deterministic \"rank\" field.\n\n    This function never mutates the caller\u2019s list.\n    ",
                      "kind": "None"
                    },
                    "_lineno": 69,
                    "_col_offset": 4
                  }
