        {
          "_type": "ClassDef",
          "_fields": {
            "name": "FailureClassifier",
            "bases": [
              {
                "_type": "Name",
                "_fields": {
                  "id": "Enum",
                  "ctx": {
                    "_type": "Load",
                    "_fields": {}
                  }
                },
                "_lineno": 77,
                "_col_offset": 24
              }
            ],
            "keywords": [],
            "body": [
              {
                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    NEW v11.10: Classifies S6 validation failures to determine retry strategy.\n    - CREATIVE_FAILURE: Retried by S5 (e.g., temp escalation).\n    - FACTUAL_FAILURE: Throws FactualGapError, triggering S6->S2 meta-loop.\n    ",
                      "kind": "None"
                    },
                    "_lineno": 78,
                    "_col_offset": 4
                  }
                },
                "_lineno": 78,
                "_col_offset": 4
              },
              {
                "_type": "Assign",
                "_fields": {
                  "targets": [
                    {
                      "_type": "Name",
                      "_fields": {
                        "id": "CREATIVE_FAILURE",
                        "ctx": {
                          "_type": "Store",
                          "_fields": {}
                        }
                      },
                      "_lineno": 83,
                      "_col_offset": 4
                    }
                  ],
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "CREATIVE_FAILURE",
                      "kind": "None"
                    },
                    "_lineno": 83,
                    "_col_offset": 23
                  },
                  "type_comment": "None"
                },
                "_lineno": 83,
                "_col_offset": 4
              },
              {
                "_type": "Assign",
                "_fields": {
                  "targets": [
                    {
                      "_type": "Name",
                      "_fields": {
                        "id": "FACTUAL_FAILURE",
                        "ctx": {
                          "_type": "Store",
                          "_fields": {}
                        }
                      },
                      "_lineno": 84,
                      "_col_offset": 4
                    }
                  ],
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "FACTUAL_FAILURE",
                      "kind": "None"
