        {
          "_type": "ClassDef",
          "_fields": {
            "name": "FactualGapError",
            "bases": [
              {
                "_type": "Name",
                "_fields": {
                  "id": "Exception",
                  "ctx": {
                    "_type": "Load",
                    "_fields": {}
                  }
                },
                "_lineno": 90,
                "_col_offset": 22
              }
            ],
            "keywords": [],
            "body": [
              {
                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    NEW v11.10: Custom exception raised by S5 when a FACTUAL failure (not\n    creative) is detected by S6. This signals the S6->S2 \"Meta-Loop\"\n    in the WorkflowOrchestrator to trigger a full re-planning cycle.\n    ",
                      "kind": "None"
                    },
                    "_lineno": 91,
                    "_col_offset": 4
                  }
                },
                "_lineno": 91,
                "_col_offset": 4
              },
