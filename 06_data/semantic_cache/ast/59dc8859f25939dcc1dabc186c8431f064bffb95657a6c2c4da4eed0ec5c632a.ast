                        "value": {
                          "_type": "Constant",
                          "_fields": {
                            "value": "\n        Retrieves evidence for resume job alignment processing.\n        \n        Provides DI-compatible interface through L4 adapter for resume enhancement.\n        \n        Args:\n            query: Base query string\n            ctx: Execution context\n            retrieval_cfg: Retrieval configuration\n            hyde_query: Optional HYDE-generated query\n            council_vote: Optional council vote for weighting\n            \n        Returns:\n            List of Evidence objects\n        ",
