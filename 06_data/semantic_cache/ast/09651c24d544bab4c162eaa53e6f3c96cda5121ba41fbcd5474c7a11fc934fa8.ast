          "_type": "Expr",
          "_fields": {
            "value": {
              "_type": "Constant",
              "_fields": {
                "value": "\nTelemetry helpers for v10.7.\n\nThis module provides a unified event envelope for:\n - LLM metrics\n - tool execution metrics\n - cache events (exact + semantic)\n - agent routing decisions\n - pruning outcomes\n - MCP-integrated telemetry streams\n\nAll telemetry events are emitted via MCP (if present) and mirrored to local logs.\nExisting calls to log_event(...) continue to work unchanged.\n",
                "kind": "None"
              },
              "_lineno": 1,
              "_col_offset": 0
            }
          },
          "_lineno": 1,
          "_col_offset": 0
        },
