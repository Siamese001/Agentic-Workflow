                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Apply the requested ranking strategy to a list of retrieval dicts.\n\n    Strategy:\n        \u2022 \"bm25\"   \u2192 length-based BM25-like ranking.\n        \u2022 \"dense\"  \u2192 hash-based dense score ranking.\n        \u2022 \"hybrid\" \u2192 combined BM25 + dense ranking.\n        \u2022 default  \u2192 hybrid.\n    ",
                      "kind": "None"
