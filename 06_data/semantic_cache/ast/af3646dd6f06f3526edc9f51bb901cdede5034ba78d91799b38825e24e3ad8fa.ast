            "body": [
              {
                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Convenience helper: return a plain list[dict] for use in JSON or\n    logging. Each item is:\n\n        {\n            \"query\": str,\n            \"evidence\": str,\n            \"rank\": int,\n            \"metadata\": {...}\n        }\n    ",
                      "kind": "None"
                    },
                    "_lineno": 356,
                    "_col_offset": 4
                  }
                },
