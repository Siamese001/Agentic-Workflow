              {
                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Apply very light deterministic filtering for obviously risky items.\n\n    For now, this is deliberately simple and hard-coded. It is meant to\n    support heightened_caution flows by removing items that contain\n    highly suspicious markers in 'evidence'.\n    ",
                      "kind": "None"
                    },
                    "_lineno": 218,
                    "_col_offset": 4
                  }
