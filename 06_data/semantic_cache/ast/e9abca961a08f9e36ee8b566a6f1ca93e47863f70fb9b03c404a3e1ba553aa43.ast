                  "body": [
                    {
                      "_type": "Expr",
                      "_fields": {
                        "value": {
                          "_type": "Constant",
                          "_fields": {
                            "value": "\n        COST-OPTIMIZED: Check Librarian cache for similar missions.\n        \n        If a high-quality cached ThematicAnalysis is found for a similar role,\n        return it directly to skip expensive RAG phases (saves ~4-5 LLM calls).\n        \n        Args:\n            current_mission: The RAGMission just extracted\n            company_name: Target company\n            job_title: Target job title\n            similarity_threshold: Minimum similarity score (0-1) to use cache\n            \n        Returns:\n            Cached ThematicAnalysis if high-quality match found, else None\n        ",
                            "kind": "None"
                          },
                          "_lineno": 730,
                          "_col_offset": 8
                        }
                      },
                      "_lineno": 730,
                      "_col_offset": 8
