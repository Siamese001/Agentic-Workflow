        {
          "_type": "ClassDef",
          "_fields": {
            "name": "LibrarianAgent",
            "bases": [],
            "keywords": [],
            "body": [
              {
                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Persistent memory agent using ChromaDB for cross-job intelligence.\n    \n    The Librarian maintains a vector database of:\n    - Past RAGMission extractions\n    - Successful positioning strategies\n    - Competitor intelligence patterns\n    - Industry-specific insights\n    \n    This enables:\n    - Learning from past successes\n    - Consistent high-signal extraction\n    - Progressive refinement of RAG quality\n    ",
                      "kind": "None"
                    },
                    "_lineno": 89,
                    "_col_offset": 4
                  }
                },
                "_lineno": 89,
                "_col_offset": 4
              },
