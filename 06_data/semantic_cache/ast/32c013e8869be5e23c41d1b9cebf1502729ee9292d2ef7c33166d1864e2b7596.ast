                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Convert a WorkflowOutput (or arbitrary Python object) into a JSON-safe\n    structure for JSONL emission.\n\n    The preference order:\n    - output.to_dict() if available\n    - dataclasses.asdict(output) if dataclass\n    - mapping / sequence / primitive used as-is\n    - fallback to repr(output)\n    ",
                      "kind": "None"
                    },
                    "_lineno": 318,
                    "_col_offset": 4
                  }
