                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Read a JSONL file or stdin (\"-\") into a list of dict rows.\n\n    Non-mapping rows are wrapped as {\"value\": row} to keep a stable schema.\n    Lines starting with \"#\" are treated as comments and ignored.\n    ",
                      "kind": "None"
                    },
                    "_lineno": 235,
                    "_col_offset": 4
