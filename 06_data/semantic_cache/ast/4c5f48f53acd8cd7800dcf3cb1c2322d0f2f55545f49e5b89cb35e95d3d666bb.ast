                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Full meta-profile state for the system (in-memory, mutable).\n\n    This is a long-lived object that accumulates rolling statistics\n    across workflows; snapshots are created per workflow.\n    ",
                      "kind": "None"
                    },
                    "_lineno": 77,
