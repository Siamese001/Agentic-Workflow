        {
          "_type": "Expr",
          "_fields": {
            "value": {
              "_type": "Constant",
              "_fields": {
                "value": "Run pytest under the stdlib trace module and enforce a coverage threshold.\n\nThis script exists so we can enforce the repository's 90%% coverage gate even in\nrestricted environments where third-party coverage plugins (e.g. pytest-cov)\nare not available.  It executes pytest with the builtin ``trace`` module to\ncollect line execution counts, computes the aggregate coverage for the\n``src/lic_agentic`` package, and exits with a non-zero status code if coverage\nfalls below the requested threshold.\n",
                "kind": "None"
              },
              "_lineno": 2,
              "_col_offset": 0
            }
          },
          "_lineno": 2,
          "_col_offset": 0
        },
