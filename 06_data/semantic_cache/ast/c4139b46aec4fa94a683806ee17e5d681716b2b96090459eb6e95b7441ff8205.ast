                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "Best-effort helper to read a schema_version attribute from a model.\n\n    The validator is intentionally defensive and never raises on simple\n    attribute access issues; it only raises when the value is present but\n    incompatible with expectations.\n    ",
                      "kind": "None"
                    },
                    "_lineno": 9,
                    "_col_offset": 4
                  }
