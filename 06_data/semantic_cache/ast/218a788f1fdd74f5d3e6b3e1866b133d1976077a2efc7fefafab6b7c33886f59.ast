                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Inspect RAGResult evidence for retrieval/coverage issues.\n\n    Heuristics:\n\n        \u2022 If no evidence at all:\n             \u2013 severity = 3\n             \u2013 recommended_action = \"retry_rag\"\n        \u2022 If evidence exists but is very small (< 3 items) AND none are marked\n          as \"hybrid\" or \"resume_experience\":\n             \u2013 severity = 2\n             \u2013 recommended_action = \"retry_rag\"\n        \u2022 Otherwise:\n             \u2013 severity = 0\n    ",
                      "kind": "None"
                    },
                    "_lineno": 143,
                    "_col_offset": 4
                  }
                },
