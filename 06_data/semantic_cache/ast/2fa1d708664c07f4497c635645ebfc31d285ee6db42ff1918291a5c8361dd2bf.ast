                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Return a copy of the current routing bias block.\n\n    Typical usage:\n        criteria = RoutingCriteria(...)\n        if get_routing_bias().get(\"prefer_fast\"):\n            criteria.latency_target_ms = min(criteria.latency_target_ms, 1000)\n    ",
