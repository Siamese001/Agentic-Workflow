        {
          "_type": "ClassDef",
          "_fields": {
            "name": "RoutingBias",
            "bases": [],
            "keywords": [],
            "body": [
              {
                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Routing-level preferences for L2/L5.\n\n    Fields:\n        prefer_fast:             prefer cheaper/faster models\n        prefer_robust_retrieval: bias toward more robust RAG settings\n        prefer_long_context:     bias toward long-context models\n    ",
                      "kind": "None"
