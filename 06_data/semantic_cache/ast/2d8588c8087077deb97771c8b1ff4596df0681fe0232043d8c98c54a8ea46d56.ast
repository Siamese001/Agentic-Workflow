        {
          "_type": "Expr",
          "_fields": {
            "value": {
              "_type": "Constant",
              "_fields": {
                "value": "\nHop 7: Document Rendering - HIGH-SIGNAL OVERWRITE\n\nThis is a spec-driven, context-aware renderer.\n1. It loads a \"render_spec\" (mocked inline) to define document\n   structure, order, and content sourcing.\n2. It dynamically sources content from the HOP-4 staging buffer\n   (for LLM content) AND the HOP-0 thematic analysis (for\n   guaranteed-alignment data like keywords).\n3. It generates a \"High-Signal App Tracker\" entry, which serves\n   as a performance snapshot of the run, including RAG signal\n   quality and final alignment scores from HOP-5.\n",
                "kind": "None"
              },
              "_lineno": 2,
              "_col_offset": 0
            }
          },
          "_lineno": 2,
          "_col_offset": 0
        },
