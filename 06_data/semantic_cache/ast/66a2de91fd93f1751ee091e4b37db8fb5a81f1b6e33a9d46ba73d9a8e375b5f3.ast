                              }
                            ],
                            "values": [
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "Would you have 15 minutes to discuss [TECHNICAL_TOPIC]?",
                                  "kind": "None"
                                },
                                "_lineno": 17,
                                "_col_offset": 22
                              },
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "If this aligns with your team's direction, I'd appreciate any guidance you could share.",
                                  "kind": "None"
                                },
                                "_lineno": 18,
                                "_col_offset": 27
                              }
                            ]
