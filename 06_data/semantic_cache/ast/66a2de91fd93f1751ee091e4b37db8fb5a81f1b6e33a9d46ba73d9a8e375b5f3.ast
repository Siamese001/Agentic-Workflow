                          "_lineno": 25,
                          "_col_offset": 29
                        },
                        {
                          "_type": "Constant",
                          "_fields": {
                            "value": "I'd welcome a conversation about potential opportunities that could benefit your team.",
                            "kind": "None"
                          },
                          "_lineno": 29,
                          "_col_offset": 29
