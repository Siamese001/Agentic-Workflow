                            "values": [
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "Could we schedule 20 minutes to dive into [TECHNICAL_TOPIC]?",
                                  "kind": "None"
                                },
                                "_lineno": 26,
                                "_col_offset": 22
                              },
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "If this resonates with your team's roadmap, I'd be grateful for any insights you could offer.",
                                  "kind": "None"
                                },
                                "_lineno": 27,
                                "_col_offset": 27
                              }
                            ]
