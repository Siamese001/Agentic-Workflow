            "body": [
              {
                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Primary production retrieval entrypoint.\n\n    Steps:\n        1. Select effective query (HYDE if provided)\n        2. Emit attempt telemetry\n        3. Run BM25 (isolated)\n        4. Run Dense (isolated)\n        5. Fuse via weighted RRF\n        6. Apply QA-council evidence weighting\n        7. Emit success/failure events per retriever\n\n    Deterministic unless HYDE is enabled (HYDE generated in L2).\n    ",
                      "kind": "None"
                    },
                    "_lineno": 114,
                    "_col_offset": 4
                  }
                },
                "_lineno": 114,
                "_col_offset": 4
              },
