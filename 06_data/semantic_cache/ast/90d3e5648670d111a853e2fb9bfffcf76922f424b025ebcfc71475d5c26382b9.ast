                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "\n        -------------------\n        MODE: ANALYTICAL\n        TASK: Classify the job description's complexity as 'simple' or 'complex'.\n        'simple' = Junior role, few requirements, common tech.\n        'complex' = Senior/Executive role, many requirements, niche tech, leadership.\n\n        Job Description:\n        ",
                                  "kind": "None"
                                },
                                "_lineno": 34,
                                "_col_offset": 29
                              },
