                                },
                                "_lineno": 42,
                                "_col_offset": 8
                              },
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "\n\n        REFLECTION: What is the seniority level?\n        Output JSON:\n        {\"complexity\": \"simple/complex\", \"reason\": \"...\"}\n        ",
                                  "kind": "None"
                                },
                                "_lineno": 42,
                                "_col_offset": 19
