        {
          "_type": "Expr",
          "_fields": {
            "value": {
              "_type": "Constant",
              "_fields": {
                "value": "Concatenate repository code into consolidated text bundles.\n\nThe script walks tracked text files in the repository and writes them into a\nhandful of consolidated parts for easier upload to ChatGPT. Files are grouped\nsequentially based on their line counts so that the total set fits into at most\n``max_parts`` outputs.\n",
                "kind": "None"
              },
              "_lineno": 2,
              "_col_offset": 0
            }
          },
          "_lineno": 2,
          "_col_offset": 0
        },
