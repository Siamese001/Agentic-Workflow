            "body": [
              {
                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Simple, deterministic BM25-like score based on term frequencies.\n\n    This is intentionally non-production but deterministic for testing:\n        \u2022 Lowercase text.\n        \u2022 Count \"important\" tokens.\n        \u2022 Apply a fixed formula to derive a score.\n    ",
                      "kind": "None"
                    },
                    "_lineno": 37,
                    "_col_offset": 4
                  }
                },
