                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Compute weights for weighted RRF.\n\n    Phase-3 requirement:\n        \"Weighted RRF (if config specifies)\"\n\n    Implementation:\n        \u2022 If cfg.rrf_weights exists and is a sequence of floats, use it.\n          - If shorter than n_groups, last weight is repeated.\n          - If longer, excess weights are ignored.\n        \u2022 Otherwise, fall back to uniform weights (=1.0).\n    ",
                      "kind": "None"
                    },
                    "_lineno": 159,
                    "_col_offset": 4
                  }
                },
