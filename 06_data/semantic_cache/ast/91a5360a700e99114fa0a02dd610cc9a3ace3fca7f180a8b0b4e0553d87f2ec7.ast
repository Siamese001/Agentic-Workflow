            "body": [
              {
                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    High-level helper to fuse and rank Evidence sets and produce a RAGResult.\n\n    If cfg.use_rrf is True:\n        \u2022 Apply evidence-level RRF across groups, then truncate/trim.\n    Otherwise:\n        \u2022 Concatenate groups, deduplicate, rank by score, truncate/trim.\n    ",
                      "kind": "None"
                    },
                    "_lineno": 533,
                    "_col_offset": 4
                  }
                },
