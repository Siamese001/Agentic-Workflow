                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "Run an OpenAI chat completion and return the response text.\n\n    This helper performs no routing or caching; it is a thin wrapper\n    around the OpenAI SDK. Errors are allowed to propagate and will be\n    wrapped by the caller (runtime_utils.invoke_model).\n    ",
                      "kind": "None"
                    },
                    "_lineno": 21,
                    "_col_offset": 4
                  }
