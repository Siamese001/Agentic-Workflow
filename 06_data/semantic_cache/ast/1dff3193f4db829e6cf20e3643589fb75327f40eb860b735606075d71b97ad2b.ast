                                "_type": "Constant",
                                "_fields": {
                                  "value": "\n\n---\nTHEIR PRIORITIES (GROUND TRUTH):\n",
                                  "kind": "None"
                                },
                                "_lineno": 730,
                                "_col_offset": 16
