          "_type": "Expr",
          "_fields": {
            "value": {
              "_type": "Constant",
              "_fields": {
                "value": "\nShared utility functions, dataclasses, and constants for the decoupled pipeline (v16.0-100%).\nThis is the canonical source of truth for ALL shared data models.\n\nCRITICAL: This file now includes ALL configuration classes from v15.55:\n- ReasoningConfig with all section-specific configs\n- ContentConstraintsConfig with all word count boundaries\n- SignalControlConfig for signal scoring\n- PromptAddendumConfig for reasoning directives\n- CircuitState enum for circuit breaker\n- All reasoning enhancement functions\n- Signal score calculation function\n",
                "kind": "None"
              },
              "_lineno": 2,
              "_col_offset": 0
            }
          },
          "_lineno": 2,
          "_col_offset": 0
        },
