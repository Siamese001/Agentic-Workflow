            "value": {
              "_type": "Constant",
              "_fields": {
                "value": "\nMain orchestrator for the decoupled resume generation pipeline (v16.0-WINNER).\nA spec-driven, DAG-aware, and cryptographically-verified engine.\nManages workflow execution by calling individual hop scripts via subprocess\nand coordinating data flow through files in a run directory.\n",
                "kind": "None"
              },
              "_lineno": 2,
              "_col_offset": 0
            }
          },
