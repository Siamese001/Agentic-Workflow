                                  "value": "constitutional_review",
                                  "kind": "None"
                                },
                                "_lineno": 1029,
                                "_col_offset": 12
                              },
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "meta_log_reader",
                                  "kind": "None"
