                      "_type": "Name",
                      "_fields": {
                        "id": "ROUTE_ACCEPT",
                        "ctx": {
                          "_type": "Store",
                          "_fields": {}
                        }
                      },
                      "_lineno": 1727,
                      "_col_offset": 4
                    }
                  ],
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "ACCEPT",
                      "kind": "None"
                    },
                    "_lineno": 1727,
                    "_col_offset": 19
                  },
                  "type_comment": "None"
                },
                "_lineno": 1727,
