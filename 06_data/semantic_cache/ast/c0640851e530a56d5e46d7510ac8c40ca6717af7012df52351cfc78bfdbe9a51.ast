                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Normalize incoming state for orchestration.\n\n    Ensures:\n        \u2022 workflow_id present in root and metadata\n        \u2022 messages is a list\n        \u2022 metadata is a dict\n        \u2022 compat/debug flags stored in metadata\n    ",
