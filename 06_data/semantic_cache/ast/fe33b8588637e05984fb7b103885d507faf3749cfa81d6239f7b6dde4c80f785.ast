                            "values": [
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "You are an adversarial reviewer. Review the following research findings and identify any weak or unsupported claims:\n\n",
                                  "kind": "None"
                                },
                                "_lineno": 886,
                                "_col_offset": 30
                              },
