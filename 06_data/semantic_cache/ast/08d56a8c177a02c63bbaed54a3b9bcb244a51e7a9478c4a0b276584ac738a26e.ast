              {
                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "Run a high-level simulation scenario using the existing Engine.\n\n    For now this is a thin wrapper around ``simulation.Engine.run_sync``.\n    It executes the named scenario ``run_count`` times (if available) and\n    aggregates the \"golden_eval_score\" metric from each run's outcome.\n    Unknown scenario ids are treated as empty, yielding zeroed scores.\n    ",
                      "kind": "None"
                    },
                    "_lineno": 11,
                    "_col_offset": 4
                  }
                },
                "_lineno": 11,
                "_col_offset": 4
              },
