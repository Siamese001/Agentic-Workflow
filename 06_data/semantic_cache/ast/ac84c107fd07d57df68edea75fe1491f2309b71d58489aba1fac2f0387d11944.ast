                      "_fields": {
                        "value": {
                          "_type": "Constant",
                          "_fields": {
                            "value": "Fuses dense and sparse results for resume job alignment.\n        \n        Reciprocal Rank Fusion (RRF):\n        score = sum(weight / (k + rank)) for each result list\n        where k is a constant (typically 60)\n        ",
                            "kind": "None"
                          },
                          "_lineno": 230,
                          "_col_offset": 8
                        }
