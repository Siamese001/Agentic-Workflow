                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "Run BM25 search over an in-memory corpus.\n\n    Parameters\n    ----------\n    query:\n        Query string.\n    corpus:\n        Sequence of dict items; each must contain a ``text`` field.\n    cfg:\n        BM25Config with k1 / b / max_hits.\n\n    Returns\n    -------\n    List[Dict[str, Any]]\n        Items annotated with ``score`` and sorted by descending score.\n    ",
                      "kind": "None"
                    },
                    "_lineno": 59,
                    "_col_offset": 4
                  }
                },
                "_lineno": 59,
                "_col_offset": 4
