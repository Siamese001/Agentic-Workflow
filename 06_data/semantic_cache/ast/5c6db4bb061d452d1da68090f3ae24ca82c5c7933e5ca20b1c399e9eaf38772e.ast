            "body": [
              {
                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "Refine hypotheses below a confidence threshold.\n\n    Rules:\n    - if confidence < threshold / 2, mark hypothesis as effectively discarded\n      by prepending a cautionary prefix.\n    - elif confidence < 1.0, append a cautious qualifier asking for more\n      evidence before acting.\n    - otherwise leave content unchanged.\n    ",
                      "kind": "None"
                    },
                    "_lineno": 9,
                    "_col_offset": 4
                  }
                },
                "_lineno": 9,
                "_col_offset": 4
