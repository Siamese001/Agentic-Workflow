                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "Heuristic classifier used by L1 to estimate ComplexityLevel.\n\n    This version incorporates:\n        - Job seniority / requirements\n        - Resume length\n        - QA / correction rates from meta_profile\n        - Deterministic skill and domain classifiers (non-LLM)\n\n    All logic is deterministic and side-effect free.\n    ",
                      "kind": "None"
                    },
                    "_lineno": 337,
                    "_col_offset": 4
                  }
                },
                "_lineno": 337,
                "_col_offset": 4
