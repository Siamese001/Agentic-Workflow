            },
            "body": [
              {
                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Construct a RoutingPolicy based on ComplexityLevel and optional meta_profile.\n\n    Rules:\n        LOW complexity -> light models, 2 branches.\n        MEDIUM complexity -> standard models, 3 branches.\n        HIGH complexity -> heavy models, 5 branches.\n\n    If meta_profile contains bias overrides, they are applied here.\n    ",
                      "kind": "None"
                    },
                    "_lineno": 106,
                    "_col_offset": 4
                  }
                },
                "_lineno": 106,
                "_col_offset": 4
              },
