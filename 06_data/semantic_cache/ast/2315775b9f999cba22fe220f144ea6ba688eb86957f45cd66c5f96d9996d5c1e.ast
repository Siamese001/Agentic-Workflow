        {
          "_type": "ClassDef",
          "_fields": {
            "name": "RoutingPolicy",
            "bases": [],
            "keywords": [],
            "body": [
              {
                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Minimal routing policy used by L2 cognitive agents.\n\n    Fields:\n        default_model: fallback model for unspecified tasks.\n        strategy_model: model used for strategy generation.\n        drafting_model: model used for draft generation.\n        qa_model: model used for QA checks.\n        safety_model: model used for safety evaluation.\n        tot_branch_count: Tree-of-Thought branching factor.\n    ",
                      "kind": "None"
                    },
                    "_lineno": 78,
                    "_col_offset": 4
                  }
                },
                "_lineno": 78,
                "_col_offset": 4
              },
