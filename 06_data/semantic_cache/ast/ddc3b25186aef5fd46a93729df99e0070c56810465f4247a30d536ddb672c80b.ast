                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "META-level BM25 retrieval wrapper.\n\n    Delegates to the existing retrievers.bm25 implementation and adapts the\n    result into Evidence objects. The underlying corpus wiring remains in the\n    existing module; this function simply provides a stable META surface.\n    ",
                      "kind": "None"
                    },
                    "_lineno": 10,
                    "_col_offset": 4
                  }
