                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Central store for run-level telemetry (in-memory only).\n\n    This is pure infra: it holds metrics, spans, and summaries for each\n    workflow_id. It never mutates application state.\n    ",
                      "kind": "None"
                    },
                    "_lineno": 104,
                    "_col_offset": 4
