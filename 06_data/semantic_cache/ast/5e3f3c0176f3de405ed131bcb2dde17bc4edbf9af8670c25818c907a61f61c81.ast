                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Aggregated summary for a single workflow run.\n\n    Fields:\n        \u2022 workflow_id\n        \u2022 phases        \u2013 ordered list of phases\n        \u2022 timings       \u2013 span durations\n        \u2022 counts        \u2013 metric counters\n        \u2022 issues        \u2013 domain-specific issue lists\n    ",
