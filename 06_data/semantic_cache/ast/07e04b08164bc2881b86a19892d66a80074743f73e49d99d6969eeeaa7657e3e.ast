                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Production ContextRelayLayer: Centralizes all prompt construction logic.\n    \n    Responsibilities:\n    - Build context for each section type\n    - Format prompts with data\n    - Inject critique from previous attempts\n    - Return complete context envelope for Writer\n    \n    V2: Delegates to prompts_RES_v2.py for sophisticated context building.\n    ",
                      "kind": "None"
                    },
                    "_lineno": 355,
                    "_col_offset": 4
                  }
