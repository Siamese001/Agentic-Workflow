                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Code Interpreter for deterministic operations on LLM outputs.\n    Provides Python execution environment for validation and transformation tasks.\n    This is a powerful and high-risk sandboxed tool that must be in its own module\n    for clear isolation, security auditing, and maintenance.\n    (Extracted from utils_RES_v2.py lines 651-809)\n    ",
                      "kind": "None"
