              "_type": "Constant",
              "_fields": {
                "value": "Redis-backed caching utilities (v10_10 \u00b7 META cache layer).\n\nThis module encapsulates all direct interactions with Redis so that\ncore layers and agents remain pure. It is safe to import even if the\n`redis` package is not installed: imports are performed lazily inside\nhelper functions and surfaced as explicit errors.\n",
                "kind": "None"
              },
              "_lineno": 1,
