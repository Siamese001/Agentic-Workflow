        {
          "_type": "ClassDef",
          "_fields": {
            "name": "HOPOrchestrator",
            "bases": [],
            "keywords": [],
            "body": [
              {
                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    v13.0: HOP-based Workflow Orchestrator\n    \n    BREAKING CHANGE from v12.0:\n    - OLD: Monolithic orchestrator with in-memory object passing\n    - NEW: \"Foreman\" pattern - iterates through HOPs, all I/O via state files\n    - Implements S6\u2192S2 meta-loop (Factual failure)\n    - Implements S5 retry (Creative failure)\n    \n    The Orchestrator is configuration-driven and agent-agnostic.\n    ",
                      "kind": "None"
                    },
                    "_lineno": 1044,
                    "_col_offset": 4
                  }
                },
                "_lineno": 1044,
                "_col_offset": 4
              },
