            "body": [
              {
                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    v13.0: Research Agent - Vector-store-first with fallback RAG\n    \n    BREAKING CHANGE from v12.0:\n    - OLD: All research at runtime (60-80s)\n    - NEW: Query vector store first (<1s), fallback RAG only for gaps\n    \n    Single Responsibility: Synthesize research context\n    \n    Input:  state/1_profile_analysis.json\n    Output: state/2_research_context.json\n    ",
                      "kind": "None"
                    },
                    "_lineno": 34,
                    "_col_offset": 4
                  }
                },
                "_lineno": 34,
                "_col_offset": 4
