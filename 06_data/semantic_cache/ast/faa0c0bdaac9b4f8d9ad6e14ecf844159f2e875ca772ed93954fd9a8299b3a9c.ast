                                        },
                                        "conversion": "-1",
                                        "format_spec": "None"
                                      },
                                      "_lineno": 5147,
                                      "_col_offset": 77
                                    },
                                    {
                                      "_type": "Constant",
                                      "_fields": {
                                        "value": "'.\n3. **CRITICAL:** Adopt the **Authentic Voice**. Use the suggested verbs and metric formats as inspiration to make the bullets sound natural and confident.\n4. **AVOID forcing keywords.**\n5. DO NOT invent new facts, skills, metrics, or experience.\n6. Maintain the same number of bullets as the original list.\n7. Return ONLY the rewritten bullets, each on a new line, starting with '\u2022 '.\n",
                                        "kind": "None"
                                      },
                                      "_lineno": 5147,
                                      "_col_offset": 92
                                    }
