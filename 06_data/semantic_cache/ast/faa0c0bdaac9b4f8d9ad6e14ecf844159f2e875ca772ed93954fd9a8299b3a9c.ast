                                    },
                                    {
                                      "_type": "Constant",
                                      "_fields": {
                                        "value": "\n\n**Instructions:**\n1. Rewrite each bullet to be concise and impactful.\n2. **Subtly** emphasize concepts from the original text that align with the '",
                                        "kind": "None"
                                      },
                                      "_lineno": 5143,
                                      "_col_offset": 51
                                    },
                                    {
                                      "_type": "FormattedValue",
                                      "_fields": {
                                        "value": {
                                          "_type": "Name",
