                            "value": "Databricks Lakehouse Fundamentals Accreditation (2023)",
                            "kind": "None"
                          },
                          "_lineno": 1469,
                          "_col_offset": 4
                        },
                        {
                          "_type": "Constant",
                          "_fields": {
                            "value": "Certified Solutions Architect \u2013 Professional, AWS (2022)",
                            "kind": "None"
                          },
                          "_lineno": 1470,
                          "_col_offset": 4
                        },
                        {
                          "_type": "Constant",
                          "_fields": {
                            "value": "Fellow of the Society of Actuaries (2010)",
                            "kind": "None"
                          },
