        {
          "_type": "ClassDef",
          "_fields": {
            "name": "WebSearchRAG",
            "bases": [],
            "keywords": [],
            "body": [
              {
                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Implements three-phase web search RAG strategy with resilience.\n    v5.59: Phase-level retries, simplified fallbacks, timeout management.\n    v11.30: Correctly passes mission object to prompt builders.\n\n    Enhanced Features:\n    - Phase-level retries (3 attempts per phase)\n    - Simplified fallback prompts (8-10 searches vs 15-20)\n    - Phase result validation\n    - Timeout management per phase\n    ",
                      "kind": "None"
                    },
                    "_lineno": 2374,
                    "_col_offset": 4
                  }
                },
                "_lineno": 2374,
                "_col_offset": 4
