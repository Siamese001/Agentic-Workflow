        {
          "_type": "ClassDef",
          "_fields": {
            "name": "WorkflowOrchestrator",
            "bases": [],
            "keywords": [],
            "body": [
              {
                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Manages the execution of the multi-hop resume generation workflow.\n    Coordinates data flow, validation, and output generation.\n    v11.0: Incorporates redesigned HOP-3 signal consumption and updated QA reporting.\n    v10.14->v11.0 Refactor: Replaced QA Section 2 with Section 10 (Signal Flow Map).\n    v11.0.1 Refactor: Renumbered QA sections 1-9, 10-15 per user request. New Signal Map is Section 2.\n    v11.0.2 Refactor: Merged QA Sections 4 & 5 into new Section 4, removed bullet tolerance row, renumbered 5-15.\n    ",
                      "kind": "None"
                    },
                    "_lineno": 7989,
                    "_col_offset": 4
                  }
                },
                "_lineno": 7989,
                "_col_offset": 4
              },
