                      "elts": [
                        {
                          "_type": "Constant",
                          "_fields": {
                            "value": "Certified Machine Learning Engineer \u2013 Associate, AWS (2025)",
                            "kind": "None"
                          },
                          "_lineno": 1468,
                          "_col_offset": 4
                        },
                        {
                          "_type": "Constant",
