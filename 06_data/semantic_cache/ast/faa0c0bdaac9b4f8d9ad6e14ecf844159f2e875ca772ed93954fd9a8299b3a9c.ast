                                "_fields": {
                                  "elts": [
                                    {
                                      "_type": "Constant",
                                      "_fields": {
                                        "value": "Directed $16M stress testing transformation for Tier 1 banks, advising CROs on CCAR methodology and automated reporting that reduced Federal Reserve examination findings by 38%.",
                                        "kind": "None"
                                      },
                                      "_lineno": 1437,
                                      "_col_offset": 8
                                    },
                                    {
                                      "_type": "Constant",
                                      "_fields": {
                                        "value": "Advised insurance boards and audit committees on Solvency II implementation, designing economic capital models and loss reserving methodologies that reduced statutory provisions by 19%.",
