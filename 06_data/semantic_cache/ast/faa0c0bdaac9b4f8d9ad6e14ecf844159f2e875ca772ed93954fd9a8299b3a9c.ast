                      "_fields": {
                        "value": {
                          "_type": "Constant",
                          "_fields": {
                            "value": "\n        v9.11: Compute cosine similarity between Executive Summary and other sections.\n        \n        Args:\n            exec_summary_text: The text of the Executive Summary (K.1).\n            sections_content: A dictionary where keys are section labels (e.g., \"Unify Overview\", \"IBM Bullets\")\n                              and values are either a single string (for overviews) or a list of strings (for bullets).\n                              \n        Returns:\n            List of dictionaries, each containing 'section_label', 'max_similarity',\n            'average_similarity', and 'item_count'.\n        ",
                            "kind": "None"
                          },
                          "_lineno": 4159,
                          "_col_offset": 8
                        }
                      },
