                                    },
                                    {
                                      "_type": "Constant",
                                      "_fields": {
                                        "value": "\n\n**TASK:**\n1. Identify the **12 most important skills** based on the provided analysis and JD.\n2. These skills must have 90%+ signal (directly supported by themes and keywords).\n3. Format **each** skill as a 1-3 word keyword (e.g., 'AI Strategy', 'Team Leadership', 'SaaS Delivery').\n4. The skills must be common terms found in HR recruiting databases.\n5. Return **only** the 12 skills, each on a new line.\n6. Do NOT add bullets, numbers, or any other commentary or preamble.\n",
                                        "kind": "None"
                                      },
                                      "_lineno": 4565,
                                      "_col_offset": 73
                                    }
