                                },
                                "_lineno": 2803,
                                "_col_offset": 89
                              },
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": " searches.\n2. Analyze the search results (articles, case studies, blogs) to identify recurring business or technical problems that someone in this role would solve.\n3. For each problem, identify the common solution patterns or approaches described.\n4. ",
                                  "kind": "None"
                                },
                                "_lineno": 2803,
                                "_col_offset": 103
                              },
                              {
                                "_type": "FormattedValue",
                                "_fields": {
                                  "value": {
                                    "_type": "Name",
                                    "_fields": {
                                      "id": "analysis_depth",
                                      "ctx": {
                                        "_type": "Load",
                                        "_fields": {}
                                      }
                                    },
                                    "_lineno": 2806,
                                    "_col_offset": 4
                                  },
                                  "conversion": "-1",
                                  "format_spec": "None"
                                },
                                "_lineno": 2806,
                                "_col_offset": 3
                              },
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "\n\nReturn ONLY this JSON structure:\n{\n  \"search_summary\": {\n    \"searches_performed\": <number of web_search calls>,\n    \"sources\": [\"<url1>\", \"<url2>\", ...]\n  },\n  \"problem_solution_narratives\": {\n    \"common_problems\": [\n      \"Problem statement 1 (e.g., 'High cost of model inference at scale')\",\n      \"Problem statement 2 (e.g., 'Slow time-to-value for new enterprise customers')\"\n    ],\n    \"solution_patterns\": [\n      \"Solution narrative 1 (e.g., 'Implemented a multi-tiered caching strategy and model quantization to reduce inference costs')\",\n      \"Solution narrative 2 (e.g., 'Developed a standardized RAG-based onboarding process to automate initial setup')\"\n    ]\n  }\n}\n\nCRITICAL: Return ONLY valid JSON. The problems and solutions should be specific and reflect real-world challenges, not generic statements.\n",
                                  "kind": "None"
                                },
                                "_lineno": 2806,
                                "_col_offset": 19
                              }
                            ]
