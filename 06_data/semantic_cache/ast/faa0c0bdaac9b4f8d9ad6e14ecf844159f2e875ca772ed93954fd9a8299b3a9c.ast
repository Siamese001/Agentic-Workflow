                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "Managed an 18-person enterprise risk team that provided strategic guidance to financial institutions on capital adequacy and regulatory modeling.",
                                  "kind": "None"
                                },
                                "_lineno": 1435,
                                "_col_offset": 18
                              },
                              {
