                                "_lineno": 4633,
                                "_col_offset": 14
                              },
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "\n\n**Authentic Tone Example (from RAG):** \"",
                                  "kind": "None"
                                },
                                "_lineno": 4633,
                                "_col_offset": 26
                              },
                              {
                                "_type": "FormattedValue",
                                "_fields": {
