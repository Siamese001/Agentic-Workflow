                                },
                                "_lineno": 4640,
                                "_col_offset": 41
                              },
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "\n4. Format: \"[Functional Expertise Area] | [Key Strength 1] | [Key Strength 2]\" (Use pipes '|' as separators)\n5. **DO NOT** use commas.\n6. The headline must be between ",
                                  "kind": "None"
                                },
                                "_lineno": 4640,
                                "_col_offset": 69
                              },
                              {
                                "_type": "FormattedValue",
                                "_fields": {
