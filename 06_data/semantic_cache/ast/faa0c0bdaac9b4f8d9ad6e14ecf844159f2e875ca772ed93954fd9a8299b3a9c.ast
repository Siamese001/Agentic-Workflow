                                },
                                "_lineno": 4635,
                                "_col_offset": 40
                              },
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "\"\n\n**Instructions:**\n1. Create a headline that positions the candidate for a role aligned with '",
                                  "kind": "None"
                                },
                                "_lineno": 4635,
                                "_col_offset": 59
                              },
                              {
                                "_type": "FormattedValue",
                                "_fields": {
