                                    "_col_offset": 76
                                  },
                                  "conversion": "-1",
                                  "format_spec": "None"
                                },
                                "_lineno": 4638,
                                "_col_offset": 75
                              },
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "'.\n2. **DO NOT** include formal job titles (e.g., 'Vice President', 'Director'). Focus on functional expertise.\n3. Include 2-3 of these differentiators: ",
                                  "kind": "None"
                                },
                                "_lineno": 4638,
                                "_col_offset": 90
                              },
                              {
                                "_type": "FormattedValue",
                                "_fields": {
                                  "value": {
                                    "_type": "Call",
                                    "_fields": {
                                      "func": {
                                        "_type": "Attribute",
                                        "_fields": {
                                          "value": {
                                            "_type": "Constant",
                                            "_fields": {
                                              "value": ", ",
                                              "kind": "None"
                                            },
