                      }
                    },
                    "_lineno": 1467,
                    "_col_offset": 36
                  },
                  {
                    "_type": "List",
                    "_fields": {
                      "elts": [
                        {
                          "_type": "Constant",
                          "_fields": {
                            "value": "\u2022 **Enterprise AI Platform Architecture:** Designed multi-cloud AI platforms on leading cloud and analytics infrastructures for financial services driving regulatory compliance, operational efficiency, and 42% performance improvements across organizations.",
                            "kind": "None"
                          },
                          "_lineno": 1474,
                          "_col_offset": 4
                        },
                        {
                          "_type": "Constant",
                          "_fields": {
                            "value": "\u2022 **AI Governance & Risk Management:** Established enterprise governance and bias audit frameworks enabling audit-ready AI model launches while reducing compliance risk by 36% and accelerating regulatory approval cycles for clients.",
                            "kind": "None"
                          },
                          "_lineno": 1475,
                          "_col_offset": 4
                        },
                        {
                          "_type": "Constant",
                          "_fields": {
                            "value": "\u2022 **Production System Scalability & Reliability:** Built scalable AI systems on cloud infrastructure processing millions of daily transactions with 99.9% uptime, deploying containerized microservices and implementing enterprise-grade reliability standards.",
                            "kind": "None"
                          },
                          "_lineno": 1476,
                          "_col_offset": 4
                        },
                        {
                          "_type": "Constant",
                          "_fields": {
                            "value": "\u2022 **Executive Leadership & Strategic Transformation:** Unified senior technical, commercial, and risk leaders to drive enterprise-wide technology programs delivering $50M+ in value and business transformation results across regulated industries.",
                            "kind": "None"
                          },
                          "_lineno": 1477,
                          "_col_offset": 4
                        },
                        {
                          "_type": "Constant",
                          "_fields": {
                            "value": "\u2022 **Strategic Partnership & Alliance Development:** Forged alliances with cloud, data platform, and systems integration providers to expand market reach, co-develop solutions, and accelerate adoption across portfolio companies.",
                            "kind": "None"
                          },
                          "_lineno": 1478,
                          "_col_offset": 4
                        },
                        {
                          "_type": "Constant",
                          "_fields": {
                            "value": "\u2022 **AI-Driven Operational Excellence & Innovation:** Embedded automation and intelligent systems into operational models cutting delivery costs by 37% and improving transformation outcomes through technology adoption.",
                            "kind": "None"
                          },
                          "_lineno": 1479,
                          "_col_offset": 4
                        }
                      ],
                      "ctx": {
                        "_type": "Load",
                        "_fields": {}
                      }
                    },
