        {
          "_type": "ClassDef",
          "_fields": {
            "name": "RAGStrategyDefinition",
            "bases": [],
            "keywords": [],
            "body": [
              {
                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Canonical definition of a RAG strategy used by the registry.\n\n    Fields:\n        name: Human-readable name of the strategy.\n        description: Short description.\n        retrieval_mode: \"bm25\" | \"dense\" | \"hybrid\"\n        use_hyde: Whether HYDE expansion should be used.\n        use_rrf: Whether RRF fusion should be applied.\n        top_k: Max hits to retrieve.\n    ",
                      "kind": "None"
                    },
                    "_lineno": 44,
                    "_col_offset": 4
                  }
                },
                "_lineno": 44,
                "_col_offset": 4
              },
