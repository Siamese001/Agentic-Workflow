                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "Apply QA-council post-fusion weighting to Evidence scores.\n\n    Selected id receives a small boost; all others are slightly demoted.\n    This mirrors the behavior previously implemented in retrieval.py\n    but lives here so that all evidence-level ranking logic is contained\n    within the META retrieval/ranking layer.\n    ",
                      "kind": "None"
                    },
                    "_lineno": 9,
                    "_col_offset": 4
