              {
                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "Fuse lexical and dense retrieval results and return a RAGResult.\n\n    Responsibilities:\n        * RRF fusion of lexical and dense groups.\n        * Evidence-level deduplication and sorting.\n        * Truncation according to RetrievalConfig.max_hits.\n        * Optional QA-council post-fusion weighting.\n    ",
                      "kind": "None"
                    },
                    "_lineno": 98,
                    "_col_offset": 4
                  }
