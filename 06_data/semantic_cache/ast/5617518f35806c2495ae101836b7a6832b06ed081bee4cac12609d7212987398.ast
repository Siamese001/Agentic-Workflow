              "_type": "Constant",
              "_fields": {
                "value": "Compatibility layer exposing test-facing agent facades.\n\nThese light-weight facades provide deterministic, dependency-free\nimplementations that satisfy the behaviour expected by the automated\ntests. They intentionally avoid importing the much heavier production\nagent stacks so that the unit and regression suites can execute in the\nrestricted CI environment used for kata style exercises.\n",
                "kind": "None"
              },
              "_lineno": 1,
              "_col_offset": 0
