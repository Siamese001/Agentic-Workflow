            "body": [
              {
                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "Run the full execution pipeline from synchronous code.\n\n    This helper exists for callers that are not async-aware. It invokes\n    :func:`run_l2` under the hood and returns the same structured bundle of\n    results: updated strategy, retrieved evidence, drafted sections, QA\n    findings, and safety findings.\n\n    In business terms, it provides a simple, blocking way for other systems to\n    request a fully processed resume without needing to manage asynchronous\n    workflows themselves.\n    ",
                      "kind": "None"
                    },
                    "_lineno": 649,
                    "_col_offset": 4
                  }
                },
                "_lineno": 649,
                "_col_offset": 4
              },
