        {
          "_type": "ClassDef",
          "_fields": {
            "name": "ManifestManager",
            "bases": [],
            "keywords": [],
            "body": [
              {
                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Manages the run_manifest.json file for a workflow run.\n    \n    This class handles:\n    - Creating initial manifests for new runs\n    - Loading manifests for resumed runs\n    - Updating manifests with checkpoint data\n    - Cryptographic validation of state integrity\n    \n    In V2, this is the primary persistence mechanism for the final workflow state.\n    ",
                      "kind": "None"
                    },
                    "_lineno": 32,
                    "_col_offset": 4
                  }
                },
                "_lineno": 32,
                "_col_offset": 4
              },
