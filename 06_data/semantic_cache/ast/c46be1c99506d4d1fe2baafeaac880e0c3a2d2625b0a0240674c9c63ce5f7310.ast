                    {
                      "_type": "Expr",
                      "_fields": {
                        "value": {
                          "_type": "Constant",
                          "_fields": {
                            "value": "\n        Loads the manifest from disk with integrity validation.\n        \n        Returns:\n            The manifest dictionary\n            \n        Raises:\n            FileNotFoundError: If manifest doesn't exist\n            ValueError: If manifest integrity check fails\n        ",
                            "kind": "None"
                          },
                          "_lineno": 83,
                          "_col_offset": 8
                        }
                      },
                      "_lineno": 83,
                      "_col_offset": 8
