        {
          "_type": "ClassDef",
          "_fields": {
            "name": "DAGNode",
            "bases": [],
            "keywords": [],
            "body": [
              {
                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Single node in the orchestration DAG.\n\n    Fields:\n        name:                  unique node identifier\n        mode:                  L2 executor mode (strategy, rag, etc.)\n        plan:                  PlanObject or plan dict for this node\n        depends_on:            upstream node names\n        fallback:              fallback node names (declared in DAG, not executed here)\n        parallel_group:        logical parallel group (metadata only)\n        max_retries:           max retries before marking node ERROR\n        predictive_cache_key:  hint for external caching (metadata only)\n        surfaces:              self-correction surfaces (for journaling)\n    ",
                      "kind": "None"
                    },
                    "_lineno": 87,
                    "_col_offset": 4
                  }
                },
                "_lineno": 87,
                "_col_offset": 4
              },
