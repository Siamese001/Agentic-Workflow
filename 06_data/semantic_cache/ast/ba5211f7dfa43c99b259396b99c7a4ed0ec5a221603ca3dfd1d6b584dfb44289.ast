                      "_type": "Expr",
                      "_fields": {
                        "value": {
                          "_type": "Constant",
                          "_fields": {
                            "value": "\n        Execute full L3 orchestration for a single L1 PlanObject.\n\n        This is a synchronous API; higher layers may wrap it with asyncio\n        as needed. Internally, this uses asyncio.run to call the async L2\n        route_executor.\n        ",
                            "kind": "None"
                          },
