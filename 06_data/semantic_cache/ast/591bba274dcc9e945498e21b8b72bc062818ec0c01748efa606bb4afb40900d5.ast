        {
          "_type": "FunctionDef",
          "_fields": {
            "name": "_evaluate_strategy_surface",
            "args": {
              "_type": "arguments",
              "_fields": {
                "posonlyargs": [],
                "args": [
                  {
                    "_type": "arg",
                    "_fields": {
                      "arg": "strategy",
                      "annotation": {
                        "_type": "Name",
                        "_fields": {
                          "id": "StrategyResult",
                          "ctx": {
                            "_type": "Load",
                            "_fields": {}
                          }
                        },
                        "_lineno": 70,
                        "_col_offset": 41
                      },
                      "type_comment": "None"
