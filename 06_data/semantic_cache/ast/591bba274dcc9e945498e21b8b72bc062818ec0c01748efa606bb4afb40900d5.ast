                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Inspect DraftingResult section structure.\n\n    Heuristics:\n\n        \u2022 If zero sections, or total characters across sections < 400:\n             \u2013 severity = 3\n             \u2013 recommended_action = \"retry_drafting\"\n        \u2022 If < 3 sections:\n             \u2013 severity = 2\n             \u2013 recommended_action = \"retry_drafting\"\n        \u2022 Otherwise:\n             \u2013 severity = 0\n    ",
                      "kind": "None"
