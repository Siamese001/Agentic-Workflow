            "body": [
              {
                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Inspect QAResult for severity of findings.\n\n    Heuristics:\n\n        \u2022 If there are \u2265 3 high-severity findings:\n             \u2013 severity = 3\n             \u2013 recommended_action = \"retry_qa\"\n        \u2022 If there are \u2265 5 total findings (any severity):\n             \u2013 severity = 2\n             \u2013 recommended_action = \"retry_qa\"\n        \u2022 Otherwise:\n             \u2013 severity = 0\n    ",
