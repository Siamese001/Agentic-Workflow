        {
          "_type": "Expr",
          "_fields": {
            "value": {
              "_type": "Constant",
              "_fields": {
                "value": "Self-Correction - Meta Layer\n\nThis module provides self-correction surface evaluation.\n\nLayer: Meta\nResponsibilities:\n- Evaluate L2 results for quality issues\n- Detect correction opportunities\n- Emit CorrectionSignal objects\n- Deterministic, side-effect-free analysis\n\nNon-responsibilities:\n- LLM calls\n- Tool execution\n- State mutation\n- Correction application (L3 decides)\n",
                "kind": "None"
              },
              "_lineno": 1,
              "_col_offset": 0
            }
          },
          "_lineno": 1,
          "_col_offset": 0
        },
