                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Evaluate all L2 surfaces and return a list of CorrectionSignal.\n\n    The list will contain one signal per surface:\n        [\"strategy\", \"rag\", \"drafting\", \"qa\", \"safety\"]\n\n    Each signal may have severity 0..3 and a recommended_action.\n    ",
                      "kind": "None"
                    },
