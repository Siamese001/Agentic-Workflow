                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Inspect SafetyResult for policy violations.\n\n    Heuristics:\n\n        \u2022 Any \"high\" severity finding:\n             \u2013 severity = 3\n             \u2013 recommended_action = \"retry_safety\"\n        \u2022 \u2265 3 total findings of any severity:\n             \u2013 severity = 2\n             \u2013 recommended_action = \"retry_safety\"\n        \u2022 Otherwise:\n             \u2013 severity = 0\n    ",
                      "kind": "None"
