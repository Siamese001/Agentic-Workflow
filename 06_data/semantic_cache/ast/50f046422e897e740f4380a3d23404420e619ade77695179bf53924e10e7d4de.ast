                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    API envelope invariant:\n    All top-level sections that existed previously must still exist in v10.7.\n\n    Example from your baselines:\n      previous: {\"strategy\": {...}, \"qa\": {...}}\n      v10.7:    {\"strategy\": {...}, \"qa\": {...}}\n    ",
