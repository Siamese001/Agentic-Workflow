                        "value": {
                          "_type": "Constant",
                          "_fields": {
                            "value": "\n        Stores relationships between resume entities with temporal tracking.\n\n        Ensures resume content relationships are properly structured\n        for accurate job alignment and relevance.\n        ",
                            "kind": "None"
                          },
                          "_lineno": 88,
                          "_col_offset": 8
