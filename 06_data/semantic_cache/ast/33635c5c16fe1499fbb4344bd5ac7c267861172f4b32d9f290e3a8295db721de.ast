                          "_fields": {
                            "value": "\n        MATCH (s:Entity {id: $subject_id})\n        MATCH (o:Entity {id: $object_id})\n        MERGE (s)-[r:RELATION {id: $rel_id}]->(o)\n        SET r.predicate = $predicate\n        ",
