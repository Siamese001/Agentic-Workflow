                  },
                  "body": [
                    {
                      "_type": "Expr",
                      "_fields": {
                        "value": {
                          "_type": "Constant",
                          "_fields": {
                            "value": "\n        Queries temporal facts about resume entities within time ranges.\n\n        Ensures resume content reflects current and relevant information\n        for improved accuracy and job alignment.\n        ",
                            "kind": "None"
                          },
                          "_lineno": 162,
                          "_col_offset": 8
                        }
                      },
                      "_lineno": 162,
                      "_col_offset": 8
                    },
                    {
                      "_type": "Assign",
                      "_fields": {
                        "targets": [
                          {
                            "_type": "Name",
                            "_fields": {
                              "id": "cypher",
                              "ctx": {
                                "_type": "Store",
                                "_fields": {}
                              }
                            },
                            "_lineno": 168,
                            "_col_offset": 8
                          }
                        ],
                        "value": {
                          "_type": "Constant",
                          "_fields": {
                            "value": "\n        MATCH (s:Entity)-[r:RELATION]->(o:Entity)\n        WHERE toLower(s.name) CONTAINS toLower($name)\n          AND r.predicate = $predicate\n          AND (r.valid_at IS NULL OR r.valid_at <= datetime($end))\n          AND (r.invalid_at IS NULL OR r.invalid_at >= datetime($start))\n        RETURN s, r, o\n        ",
                            "kind": "None"
                          },
                          "_lineno": 168,
                          "_col_offset": 17
                        },
                        "type_comment": "None"
                      },
                      "_lineno": 168,
                      "_col_offset": 8
                    },
