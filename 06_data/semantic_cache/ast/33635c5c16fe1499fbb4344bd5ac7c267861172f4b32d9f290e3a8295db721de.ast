                  },
                  "body": [
                    {
                      "_type": "Expr",
                      "_fields": {
                        "value": {
                          "_type": "Constant",
                          "_fields": {
                            "value": "\n        Stores or updates resume-related entities with metadata.\n\n        Ensures all resume entities are properly structured for\n        accurate content generation and job alignment.\n        ",
                            "kind": "None"
                          },
                          "_lineno": 35,
                          "_col_offset": 8
                        }
                      },
                      "_lineno": 35,
                      "_col_offset": 8
                    },
                    {
                      "_type": "Assign",
                      "_fields": {
                        "targets": [
                          {
                            "_type": "Name",
                            "_fields": {
                              "id": "cypher",
                              "ctx": {
                                "_type": "Store",
                                "_fields": {}
                              }
                            },
                            "_lineno": 41,
                            "_col_offset": 8
                          }
                        ],
                        "value": {
                          "_type": "Constant",
                          "_fields": {
                            "value": "\n        MERGE (e:Entity {id: $id})\n        SET e.type = $type,\n            e.name = $name\n        WITH e\n        CALL apoc.create.addProperties(e, $metadata) YIELD node\n        RETURN node\n        ",
                            "kind": "None"
                          },
                          "_lineno": 41,
                          "_col_offset": 17
                        },
                        "type_comment": "None"
                      },
                      "_lineno": 41,
                      "_col_offset": 8
