                      "_type": "Expr",
                      "_fields": {
                        "value": {
                          "_type": "Constant",
                          "_fields": {
                            "value": "Apply a StatePatch and reconcile + validate.\n\n        Semantics:\n\n            \u2022 If both existing state[key] and patch.value are dicts,\n              perform shallow merge.\n            \u2022 If both are lists, append.\n            \u2022 Else replace the top-level key with patch.value.\n        ",
                            "kind": "None"
                          },
                          "_lineno": 428,
                          "_col_offset": 8
                        }
