            "body": [
              {
                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "Normalize arbitrary world facts into a consistent schema.\n\n    Each fact has the form:\n\n        {\n            \"category\": \"entity\" | \"event\" | \"relation\",\n            \"origin\": \"retrieval\" | \"user\" | \"system\",\n            \"content\": \"...\",\n        }\n\n    This is a pure function; it does not touch StateAdapter or phases.\n    ",
                      "kind": "None"
                    },
                    "_lineno": 75,
                    "_col_offset": 4
                  }
                },
                "_lineno": 75,
                "_col_offset": 4
              },
