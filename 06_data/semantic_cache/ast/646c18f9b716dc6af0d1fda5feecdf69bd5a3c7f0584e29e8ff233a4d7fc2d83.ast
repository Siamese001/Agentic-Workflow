                "_type": "AnnAssign",
                "_fields": {
                  "target": {
                    "_type": "Name",
                    "_fields": {
                      "id": "out",
                      "ctx": {
                        "_type": "Store",
                        "_fields": {}
                      }
                    },
                    "_lineno": 87,
                    "_col_offset": 4
