                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Canonical workflow state.\n\n    This is the single source of truth for all cross-layer state.\n\n    L4 is the *only* layer allowed to mutate instances of this model;\n    other layers must work with copies or immutable views.\n    ",
                      "kind": "None"
