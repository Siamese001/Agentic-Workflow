                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "Convenience helper to run a single tool call in an ephemeral VM.\n\n    This creates a VM, executes the request, and tears the VM down,\n    ensuring cleanup even on errors.\n    ",
                      "kind": "None"
