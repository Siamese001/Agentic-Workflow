                  {
                    "_type": "arg",
                    "_fields": {
                      "arg": "expectation",
                      "annotation": {
                        "_type": "Name",
                        "_fields": {
                          "id": "GoldenExpectation",
                          "ctx": {
                            "_type": "Load",
