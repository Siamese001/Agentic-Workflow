                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Generic field\u2011level expectation expressed as a dotted path into\n    the state patch.\n\n    Example JSON shape (for load_expectations):\n\n        {\n          \"path\": \"config.knobs.hyde_enabled\",\n          \"comparator\": \"eq\",\n          \"expected\": true,\n          \"weight\": 2.0,\n          \"hard_fail\": true,\n          \"description\": \"HYDE enabled in knob config\"\n        }\n    ",
