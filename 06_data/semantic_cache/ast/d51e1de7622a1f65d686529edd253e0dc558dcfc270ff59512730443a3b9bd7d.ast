                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Simple CLI intended for CI pipelines.\n\n    Example:\n\n        python -m golden_eval             --patch state_patch.json             --expectation golden_expectations.json             --scenario-id hyde_on_rrf_weighted_council3             --out eval_report.json\n\n    If --expectation is omitted or set to the literal string \"builtin\",\n    the built\u2011in GOLDEN_SCENARIOS registry is used.\n    ",
                      "kind": "None"
                    },
                    "_lineno": 1538,
                    "_col_offset": 4
                  }
