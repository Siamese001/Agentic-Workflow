            "body": [
              {
                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Canonical golden scenarios used in Phase\u20113 testing.\n\n    These are intentionally generic and only talk about knobs and\n    observable invariants \u2014 they do not encode any specific user\n    prompts or corpus content.\n    ",
                      "kind": "None"
                    },
                    "_lineno": 405,
                    "_col_offset": 4
                  }
                },
                "_lineno": 405,
                "_col_offset": 4
              },
