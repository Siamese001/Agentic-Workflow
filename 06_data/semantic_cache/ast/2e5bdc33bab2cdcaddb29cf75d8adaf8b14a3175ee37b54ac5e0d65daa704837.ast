        {
          "_type": "ClassDef",
          "_fields": {
            "name": "LLMBaseAgent",
            "bases": [],
            "keywords": [],
            "body": [
              {
                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Base class for all L2 cognitive agents.\n\n    This class centralizes:\n        \u2022 RoutingPolicy-based model selection.\n        \u2022 SandboxConfig usage.\n        \u2022 invoke_model() calls.\n        \u2022 Basic observability events.\n\n    This class must remain **L2-only** and must not perform:\n        \u2022 planning (L1),\n        \u2022 orchestration / retries (L3),\n        \u2022 state mutation (L4),\n        \u2022 safety policy enforcement (L5).\n    ",
                      "kind": "None"
                    },
                    "_lineno": 88,
                    "_col_offset": 4
                  }
                },
                "_lineno": 88,
                "_col_offset": 4
              },
