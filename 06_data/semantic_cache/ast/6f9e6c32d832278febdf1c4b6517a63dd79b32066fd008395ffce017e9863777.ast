                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Lightweight in-memory predictive/semantic cache.\n\n    Intended use:\n        \u2022 Cache expensive L2 operations (RAG, cognitive agent calls).\n        \u2022 Keyed by (domain, plan, context signature).\n\n    Behavior:\n        \u2022 In-memory only.\n        \u2022 Evicts oldest entry when capacity exceeded.\n    ",
                      "kind": "None"
