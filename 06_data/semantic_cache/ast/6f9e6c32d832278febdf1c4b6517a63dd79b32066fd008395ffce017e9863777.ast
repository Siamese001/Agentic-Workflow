        {
          "_type": "ClassDef",
          "_fields": {
            "name": "SandboxConfig",
            "bases": [],
            "keywords": [],
            "body": [
              {
                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Logical sandbox configuration for tool/LLM invocations.\n\n    Actual isolation is provided by the surrounding environment (e.g.,\n    container). This object provides *logical* constraints:\n\n        \u2022 allow_network: whether network calls are permitted.\n        \u2022 request_timeout_s: per-call timeout.\n        \u2022 max_tokens_per_call: cap on LLM token generation.\n    ",
                      "kind": "None"
                    },
                    "_lineno": 279,
                    "_col_offset": 4
                  }
                },
                "_lineno": 279,
                "_col_offset": 4
              },
              {
                "_type": "AnnAssign",
                "_fields": {
                  "target": {
                    "_type": "Name",
                    "_fields": {
                      "id": "name",
                      "ctx": {
                        "_type": "Store",
                        "_fields": {}
                      }
                    },
                    "_lineno": 290,
                    "_col_offset": 4
                  },
                  "annotation": {
                    "_type": "Name",
                    "_fields": {
                      "id": "str",
                      "ctx": {
                        "_type": "Load",
                        "_fields": {}
                      }
                    },
                    "_lineno": 290,
                    "_col_offset": 10
                  },
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "default",
                      "kind": "None"
                    },
                    "_lineno": 290,
                    "_col_offset": 16
                  },
                  "simple": "1"
                },
                "_lineno": 290,
                "_col_offset": 4
