              {
                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "Execution-scoped context integrating L3, L4, and L5.\n\n    Responsibilities:\n    - Coordinate node execution with retries and timeouts.\n    - Capture L4 snapshots before/after each node.\n    - Invoke L5 safety for node outputs.\n    - Produce a `DAGResult` view over the run.\n    ",
                      "kind": "None"
                    },
                    "_lineno": 51,
                    "_col_offset": 4
                  }
                },
                "_lineno": 51,
                "_col_offset": 4
