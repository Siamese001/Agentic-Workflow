                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    NEW v11.10: Replaces ResearchOrchestrator (Enhancement 1).\n    Acts as a planner/delegator for a team of specialist agents.\n    Runs an internal \"Execute-Critique-Replan\" loop (Enhancement 2).\n    Runs an \"Adversarial Self-Verification\" step (Enhancement 3).\n    Accepts an \"S6->S2 Meta-Loop\" refinement context (Enhancement 4).\n    ",
                      "kind": "None"
                    },
                    "_lineno": 386,
                    "_col_offset": 4
                  }
                },
