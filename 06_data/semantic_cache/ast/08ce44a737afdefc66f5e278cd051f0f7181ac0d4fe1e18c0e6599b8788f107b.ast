                                "func": {
                                  "_type": "Name",
                                  "_fields": {
                                    "id": "_summarize_job_and_resume",
                                    "ctx": {
                                      "_type": "Load",
                                      "_fields": {}
                                    }
                                  },
                                  "_lineno": 500,
                                  "_col_offset": 16
                                },
                                "args": [
                                  {
                                    "_type": "Name",
                                    "_fields": {
                                      "id": "ctx",
                                      "ctx": {
                                        "_type": "Load",
                                        "_fields": {}
                                      }
                                    },
                                    "_lineno": 500,
                                    "_col_offset": 42
                                  }
                                ],
                                "keywords": []
                              },
                              "_lineno": 500,
                              "_col_offset": 16
                            }
                          },
                          "_lineno": 500,
                          "_col_offset": 8
                        },
                        {
                          "_type": "keyword",
                          "_fields": {
                            "arg": "reasoning",
                            "value": {
                              "_type": "Constant",
                              "_fields": {
                                "value": "Imagine the ideal, well-written answer that would perfectly match this job and candidate. This answer will be used as a semantic query to retrieve similar documents.",
                                "kind": "None"
                              },
                              "_lineno": 502,
                              "_col_offset": 12
                            }
                          },
                          "_lineno": 501,
                          "_col_offset": 8
                        },
                        {
                          "_type": "keyword",
                          "_fields": {
                            "arg": "instructions",
                            "value": {
                              "_type": "Constant",
                              "_fields": {
                                "value": "Write a single, coherent paragraph that describes the ideal candidate's experience and impact for this role, grounded in the provided job and resume information.",
                                "kind": "None"
                              },
                              "_lineno": 507,
                              "_col_offset": 12
                            }
                          },
                          "_lineno": 506,
                          "_col_offset": 8
                        },
                        {
                          "_type": "keyword",
                          "_fields": {
                            "arg": "safety_signals",
                            "value": {
                              "_type": "Constant",
                              "_fields": {
                                "value": "Do not fabricate credentials or experience not hinted in the resume.",
                                "kind": "None"
                              },
                              "_lineno": 511,
                              "_col_offset": 23
                            }
                          },
                          "_lineno": 511,
                          "_col_offset": 8
                        },
