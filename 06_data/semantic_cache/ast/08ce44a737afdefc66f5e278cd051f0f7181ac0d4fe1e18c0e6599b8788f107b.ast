            "body": [
              {
                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Build a HYDE prompt: generate an ideal answer for use as a retrieval proxy.\n\n    The output is a synthetic, idealized answer to the user's (implicit) query\n    for the job/resume pair, which retrieval.py will treat as a dense query.\n    ",
                      "kind": "None"
                    },
                    "_lineno": 490,
                    "_col_offset": 4
                  }
                },
                "_lineno": 490,
                "_col_offset": 4
              },
              {
                "_type": "Assign",
                "_fields": {
                  "targets": [
                    {
                      "_type": "Name",
                      "_fields": {
                        "id": "envelope",
                        "ctx": {
                          "_type": "Store",
                          "_fields": {}
                        }
                      },
                      "_lineno": 496,
                      "_col_offset": 4
                    }
                  ],
                  "value": {
                    "_type": "Call",
                    "_fields": {
                      "func": {
                        "_type": "Name",
                        "_fields": {
                          "id": "PromptEnvelope",
                          "ctx": {
                            "_type": "Load",
                            "_fields": {}
                          }
                        },
                        "_lineno": 496,
                        "_col_offset": 15
                      },
                      "args": [],
                      "keywords": [
                        {
                          "_type": "keyword",
                          "_fields": {
                            "arg": "framing",
                            "value": {
                              "_type": "Constant",
                              "_fields": {
                                "value": "You are the HYDE (Hypothetical Document) generator for retrieval.",
                                "kind": "None"
                              },
                              "_lineno": 498,
                              "_col_offset": 12
                            }
                          },
                          "_lineno": 497,
                          "_col_offset": 8
                        },
                        {
                          "_type": "keyword",
