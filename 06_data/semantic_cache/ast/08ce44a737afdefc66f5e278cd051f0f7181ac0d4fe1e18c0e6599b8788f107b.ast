            "body": [
              {
                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Structured container for deterministic prompt assembly.\n\n    Sections map directly to the v10_8 envelope design, with explicit\n    naming so that downstream rendering and logging can reason about\n    each component separately.\n    ",
                      "kind": "None"
                    },
                    "_lineno": 63,
                    "_col_offset": 4
                  }
