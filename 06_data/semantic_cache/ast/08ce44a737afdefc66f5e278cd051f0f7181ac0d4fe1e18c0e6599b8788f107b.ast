                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Extract ACL metadata from a PromptDefinition.\n\n    Expected shape (stored in defn.metadata[\"acl\"]):\n\n        {\n            \"layers\": [\"L1\", \"L2\", ...],\n            \"agents\": [\"strategy\", \"rag\", \"drafting\", \"qa\", \"safety\"],\n            \"model_tiers\": [\"cheap\", \"balanced\", \"premium\"],\n        }\n\n    All fields are optional; missing fields are treated as \"no restriction\".\n    ",
                      "kind": "None"
                    },
                    "_lineno": 130,
                    "_col_offset": 4
                  }
                },
                "_lineno": 130,
