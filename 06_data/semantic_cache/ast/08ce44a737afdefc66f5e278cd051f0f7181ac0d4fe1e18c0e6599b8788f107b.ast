                  {
                    "_type": "arg",
                    "_fields": {
                      "arg": "envelope",
                      "annotation": {
                        "_type": "Name",
                        "_fields": {
                          "id": "PromptEnvelope",
                          "ctx": {
                            "_type": "Load",
