        {
          "_type": "FunctionDef",
          "_fields": {
            "name": "_render_envelope_with_template",
            "args": {
              "_type": "arguments",
              "_fields": {
                "posonlyargs": [],
                "args": [
                  {
                    "_type": "arg",
                    "_fields": {
                      "arg": "defn",
                      "annotation": {
                        "_type": "Name",
