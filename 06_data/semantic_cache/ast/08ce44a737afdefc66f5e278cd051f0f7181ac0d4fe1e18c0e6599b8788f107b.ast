            "body": [
              {
                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Merge a PromptEnvelope with the registry template into a final string.\n\n    Default templates follow the pattern:\n\n        \"## CONTEXT\\n\\n## INSTRUCTIONS\\n\\n## OUTPUT_FORMAT\\n\"\n\n    This helper injects the envelope contents into those anchors while\n    also adding the richer sections (Framing, Reasoning, Safety).\n    ",
                      "kind": "None"
                    },
                    "_lineno": 226,
                    "_col_offset": 4
                  }
                },
