            },
            "body": [
              {
                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Orchestrate the full L2 workflow using the Phase-3 DAG + correction loop.\n\n    Steps:\n        1. Start an L3-level span (\"l3.orchestrate\").\n        2. Emit high-level L3 node events (start/success/error).\n        3. Delegate to workflow_graph.run_workflow_graph for actual DAG\n           execution and correction-loop handling.\n        4. Catch any fatal errors and return\n           L2ResultBundle.empty_with_error(message).\n    ",
                      "kind": "None"
                    },
                    "_lineno": 50,
                    "_col_offset": 4
                  }
                },
                "_lineno": 50,
                "_col_offset": 4
              },
