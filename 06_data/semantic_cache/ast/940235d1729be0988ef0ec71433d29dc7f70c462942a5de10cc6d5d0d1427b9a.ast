                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Backward-compatible alias for orchestrate_execution.\n\n    Older callers (e.g., earlier L4/state adapter or entrypoint code) may\n    still refer to run_l3_workflow; this function keeps that surface stable\n    while delegating all orchestration to orchestrate_execution.\n    ",
                      "kind": "None"
                    },
                    "_lineno": 79,
                    "_col_offset": 4
                  }
