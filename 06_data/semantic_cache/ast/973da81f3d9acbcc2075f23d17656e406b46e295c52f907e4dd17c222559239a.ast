                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Combine base SafetyMode with meta_profile biases:\n\n        \u2022 safety_bias.heightened_caution  \u2192 STRICT\n        \u2022 planning_bias.conservative      \u2192 tilt to STRICT\n        \u2022 safety_bias.human_review_important alone \u2192 BALANCED is ok\n    ",
