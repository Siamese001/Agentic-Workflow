        {
          "_type": "Expr",
          "_fields": {
            "value": {
              "_type": "Constant",
              "_fields": {
                "value": "\nPydantic models shared across the v10.7 workflow (corrected + aligned).\n\nThis version:\n - Adds uniform model_config to allow extra fields\n - Adds helper .dump() and .load() backing for MainGraphState hydration\n - Normalizes QA tool outputs\n - Expands GeneratedPrompts to match PromptStack outputs\n - Adds descriptive defaults for safety and HIL models\n - Ensures compatibility with ResponseValidator + Pydantic v2\n - Preserves ALL correct semantics from the original models\n",
                "kind": "None"
              },
              "_lineno": 1,
              "_col_offset": 0
            }
          },
          "_lineno": 1,
          "_col_offset": 0
        },
