                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "Return a new list of hypotheses with adjusted confidence.\n\n    Heuristics (purely deterministic):\n    - penalize very long or very short content slightly.\n    - if a hypothesis has no evidence_ids, reduce confidence.\n    - clamp confidence to [0, 1].\n    ",
                      "kind": "None"
                    },
                    "_lineno": 9,
                    "_col_offset": 4
