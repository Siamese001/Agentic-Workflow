                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "Verify that only providers/ directory contains external SDK imports.\n    \n    This enforces architectural separation where concrete SDK dependencies\n    (openai, anthropic, redis, chromadb, pinecone, etc.) are isolated\n    to the providers layer only.\n    ",
                      "kind": "None"
                    },
