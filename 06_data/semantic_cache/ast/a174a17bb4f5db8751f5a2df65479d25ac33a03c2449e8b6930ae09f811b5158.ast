                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Central meta-profile object representing adaptive, soft preferences.\n\n    Phase-1 addition:\n    -----------------\n    profile_inference : ProfileInferenceResult\n        Stores seniority/domain/skills inference from L1 and routes\n        into planning/routing for richer Agent Boundaries.\n    ",
                      "kind": "None"
                    },
                    "_lineno": 59,
                    "_col_offset": 4
                  }
