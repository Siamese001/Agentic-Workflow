        {
          "_type": "ClassDef",
          "_fields": {
            "name": "IntelligenceLibrarian",
            "bases": [],
            "keywords": [],
            "body": [
              {
                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    v13.0: Offline research agent that pre-computes intelligence\n    \n    The Librarian runs asynchronously (e.g., nightly via cron) to:\n    1. Research target companies and executives\n    2. Extract and embed key findings\n    3. Store embeddings in persistent vector database (ChromaDB)\n    \n    This transforms S2 from a runtime-heavy research agent to a\n    runtime-light synthesis agent that queries pre-computed memory.\n    ",
                      "kind": "None"
                    },
                    "_lineno": 33,
                    "_col_offset": 4
                  }
                },
                "_lineno": 33,
                "_col_offset": 4
              },
