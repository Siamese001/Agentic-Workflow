              {
                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    HOP-1: Pre-processes the master resume.\n    - Extracts all sections (header, experience, education, etc.)\n    - Extracts and structures competency map.\n    - Enriches every experience bullet with:\n        1. An Action Verb\n        2. Extracted Metrics (%, $, etc.)\n        3. Inferred Skills (cross-referenced with competencies)\n        4. A Vector Embedding (for HOP-2 semantic scoring)\n    ",
                      "kind": "None"
                    },
                    "_lineno": 73,
                    "_col_offset": 4
                  }
