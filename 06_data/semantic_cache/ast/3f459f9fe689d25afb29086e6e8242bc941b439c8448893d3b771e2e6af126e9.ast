              {
                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Convert a PromptEngineering plan into prompt envelope metadata.\n\n    This executor does NOT render actual prompts; that is done by the\n    dedicated prompt module and higher-level orchestration. Here we\n    simply normalize the plan into a metadata payload suitable for\n    consumption by the prompt layer.\n    ",
                      "kind": "None"
                    },
                    "_lineno": 742,
                    "_col_offset": 4
                  }
