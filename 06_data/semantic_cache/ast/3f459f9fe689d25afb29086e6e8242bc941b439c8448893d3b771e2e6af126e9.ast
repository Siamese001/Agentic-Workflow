              {
                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Execute a HIL plan:\n\n        \u2022 Create an HILPrompt using the plan's question_template and\n          contextual state.\n        \u2022 Optionally attach an existing HILResponse if present in state.\n\n    This executor does NOT interface with a real human; an external\n    system handles that and writes back the HILResponse.\n    ",
                      "kind": "None"
                    },
                    "_lineno": 792,
                    "_col_offset": 4
                  }
