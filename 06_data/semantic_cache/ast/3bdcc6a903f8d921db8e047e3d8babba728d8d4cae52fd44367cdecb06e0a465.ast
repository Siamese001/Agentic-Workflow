              {
                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    v13.0: Explicit state management for HOP architecture\n    \n    Each HOP (single-responsibility agent) reads from and writes to the\n    state/ directory. This creates an auditable trail and enables:\n    - Debugging: Inspect state at any HOP\n    - Resumability: Re-run from any HOP\n    - Auditability: Complete record of workflow decisions\n    ",
                      "kind": "None"
                    },
                    "_lineno": 17,
                    "_col_offset": 4
                  }
                },
                "_lineno": 17,
                "_col_offset": 4
              },
