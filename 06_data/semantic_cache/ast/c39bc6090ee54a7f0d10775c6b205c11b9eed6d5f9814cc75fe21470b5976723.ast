                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Deterministic stub to indicate whether a local retry is warranted.\n\n    For v10.8, logic must be simple:\n      - If surface is QA_RECHECK and last_result contains \"qa_report\"\n        with any finding.status == \"pending\" \u2192 return True.\n      - Else return False.\n    ",
                      "kind": "None"
                    },
                    "_lineno": 30,
                    "_col_offset": 4
