                                      "func": {
                                        "_type": "Attribute",
                                        "_fields": {
                                          "value": {
                                            "_type": "Constant",
                                            "_fields": {
                                              "value": "\nRAG Best Practices:\n1. Use multiple queries for complex information needs\n2. Apply metadata filters to narrow scope\n3. Set appropriate score thresholds (typically 0.7-0.8)\n4. Use temporal filters for time-sensitive queries\n5. Enable reranking for better precision\n6. Balance recall (top_k) with precision (threshold)\n7. Consider query expansion for better coverage\n",
                                              "kind": "None"
                                            },
                                            "_lineno": 158,
                                            "_col_offset": 16
                                          },
