                                      "func": {
                                        "_type": "Attribute",
                                        "_fields": {
                                          "value": {
                                            "_type": "Constant",
                                            "_fields": {
                                              "value": "\nDomain: Resume Tailoring for Job Applications\n\nKey Concepts:\n- Job requirements: Skills, experience, and qualifications sought by employer\n- Resume content: Candidate's experience, skills, and achievements\n- Strategy: Approach to emphasize relevant content and deemphasize irrelevant content\n- Tone: Professional communication style appropriate for the role level\n- Gaps: Missing qualifications that need mitigation strategies\n",
                                              "kind": "None"
                                            },
                                            "_lineno": 55,
                                            "_col_offset": 16
