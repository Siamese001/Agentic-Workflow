                                      "func": {
                                        "_type": "Attribute",
                                        "_fields": {
                                          "value": {
                                            "_type": "Constant",
                                            "_fields": {
                                              "value": "\nResume Tailoring Best Practices:\n1. Match keywords from job description (ATS optimization)\n2. Quantify achievements with metrics when possible\n3. Emphasize recent and relevant experience\n4. Address gaps proactively with mitigation strategies\n5. Adjust tone based on role level (entry/mid/senior/executive)\n6. Highlight transferable skills for career transitions\n7. Use action verbs and achievement-focused language\n",
                                              "kind": "None"
                                            },
                                            "_lineno": 70,
                                            "_col_offset": 16
                                          },
                                          "attr": "strip",
                                          "ctx": {
