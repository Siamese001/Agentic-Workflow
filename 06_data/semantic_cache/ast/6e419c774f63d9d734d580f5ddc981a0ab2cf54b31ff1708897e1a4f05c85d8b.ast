                                        "_type": "Attribute",
                                        "_fields": {
                                          "value": {
                                            "_type": "Constant",
                                            "_fields": {
                                              "value": "\nDomain: Retrieval-Augmented Generation (RAG)\n\nKey Concepts:\n- Query formulation: Crafting effective search queries\n- Vector similarity: Semantic search in embedding space\n- Metadata filtering: Narrowing results by attributes\n- Temporal filtering: Time-based result filtering\n- Reranking: Improving result relevance\n- Multi-query: Multiple queries for comprehensive coverage\n",
                                              "kind": "None"
                                            },
                                            "_lineno": 142,
                                            "_col_offset": 16
                                          },
