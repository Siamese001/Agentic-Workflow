                  "body": [
                    {
                      "_type": "Expr",
                      "_fields": {
                        "value": {
                          "_type": "Constant",
                          "_fields": {
                            "value": "\n        Check if the given context is safe according to the specified policies.\n        \n        This is a convenience method that returns a simple boolean indicating\n        whether the content is safe (True) or should be blocked (False).\n        \n        Args:\n            context: The safety context to evaluate\n            policy_ids: Optional list of policy IDs to evaluate against\n            severity_threshold: Minimum severity level to consider for blocking\n            \n        Returns:\n            bool: True if the content is safe, False if it should be blocked\n        ",
                            "kind": "None"
                          },
                          "_lineno": 228,
                          "_col_offset": 8
                        }
                      },
                      "_lineno": 228,
                      "_col_offset": 8
