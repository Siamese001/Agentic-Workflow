                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "META-layer helper to select agent role + optional QA council.\n\n    This does **not** call any LLMs or mutate state. It is intended to be\n    used by L2/L3 orchestration to decide which concrete agent / council\n    to invoke, and to emit a typed RoutingDecisionEvent for observability.\n    ",
                      "kind": "None"
