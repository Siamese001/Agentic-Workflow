                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "Create the instructions for writing or rewriting resume sections.\n\n    This prompt explains to the drafting agent what sections to produce, what\n    strategy to follow, and which evidence to lean on. It emphasizes impact,\n    clarity, and alignment to the job so that the resulting resume feels\n    tailored and recruiter-friendly rather than generic.\n    ",
                      "kind": "None"
                    },
                    "_lineno": 658,
                    "_col_offset": 4
                  }
