                          "_fields": {
                            "arg": "framing",
                            "value": {
                              "_type": "Constant",
                              "_fields": {
                                "value": "You are the HYDE (Hypothetical Document) generator for retrieval.",
                                "kind": "None"
                              },
                              "_lineno": 613,
                              "_col_offset": 12
                            }
                          },
                          "_lineno": 612,
