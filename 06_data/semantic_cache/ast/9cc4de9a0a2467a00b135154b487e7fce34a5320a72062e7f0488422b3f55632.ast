                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "Create the instructions for the final safety and policy review.\n\n    This prompt asks the safety agent to look for content that might violate\n    policies, privacy expectations, or fairness standards, and to recommend\n    any required edits or blocks. It is a key part of ensuring resumes are not\n    only compelling but also safe and appropriate to share.\n    ",
                      "kind": "None"
                    },
                    "_lineno": 773,
                    "_col_offset": 4
                  }
                },
