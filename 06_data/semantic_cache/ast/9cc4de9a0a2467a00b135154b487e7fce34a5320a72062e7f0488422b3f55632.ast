                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "Create the instructions for planning how to tailor the resume.\n\n    This prompt tells the strategy agent to read the job and resume, propose\n    several options for how to position the candidate, and pick the most\n    effective one. The goal is to ensure later steps work from a clear plan\n    that reflects the role's expectations and the candidate's strengths.\n    ",
                      "kind": "None"
                    },
                    "_lineno": 470,
                    "_col_offset": 4
                  }
                },
