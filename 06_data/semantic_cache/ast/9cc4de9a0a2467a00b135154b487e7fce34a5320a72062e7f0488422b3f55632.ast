                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "Create the instructions for reviewing the drafted resume.\n\n    This prompt tells the QA agent to check the draft against the job\n    description and evidence, surface issues such as unsupported claims or\n    missing requirements, and suggest concrete fixes. It helps keep the final\n    resume accurate, clear, and focused on what employers care about.\n    ",
                      "kind": "None"
                    },
                    "_lineno": 717,
                    "_col_offset": 4
