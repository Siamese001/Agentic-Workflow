            "body": [
              {
                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "Create the instructions for imagining an ideal candidate profile.\n\n    This prompt asks the agent to write a short description of a \"perfect\"\n    candidate for the role, based on the job and resume. Retrieval uses this\n    text as a semantic query to pull in better-matching examples and\n    references, which in turn supports more targeted resume improvements.\n    ",
                      "kind": "None"
                    },
                    "_lineno": 604,
                    "_col_offset": 4
                  }
                },
                "_lineno": 604,
                "_col_offset": 4
              },
