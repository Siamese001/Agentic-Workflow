                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "Orchestrator for KG-first hybrid retrieval.\n    \n    This orchestrator builds and executes retrieval DAGs that:\n    1. First query the Knowledge Graph for structured facts\n    2. Use KG entities to enhance vector search\n    3. Fuse results with weighted combination\n    4. Optionally rerank for relevance\n    ",
                      "kind": "None"
                    },
                    "_lineno": 146,
                    "_col_offset": 4
                  }
