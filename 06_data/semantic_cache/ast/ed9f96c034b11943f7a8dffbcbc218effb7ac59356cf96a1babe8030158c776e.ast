                  },
                  {
                    "_type": "arg",
                    "_fields": {
                      "arg": "ctx",
                      "annotation": {
                        "_type": "Name",
                        "_fields": {
                          "id": "ExecutionContext",
                          "ctx": {
                            "_type": "Load",
