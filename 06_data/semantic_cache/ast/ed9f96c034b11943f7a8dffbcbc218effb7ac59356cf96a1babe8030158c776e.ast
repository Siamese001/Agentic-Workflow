        {
          "_type": "AsyncFunctionDef",
          "_fields": {
            "name": "run_workflow_graph",
            "args": {
              "_type": "arguments",
              "_fields": {
                "posonlyargs": [],
                "args": [
                  {
                    "_type": "arg",
