                  "body": [
                    {
                      "_type": "Expr",
                      "_fields": {
                        "value": {
                          "_type": "Constant",
                          "_fields": {
                            "value": "Run a complete safe temporal KG + RAG fusion session.\n        \n        Args:\n            question: User's natural language query\n            user_context: Optional user context for safety evaluation\n            safety_profile: Safety profile to apply\n            temporal_constraints: Temporal filtering constraints\n            max_recursion_depth: Override for recursion depth limit\n            \n        Returns:\n            SafetyWrappedResult with answer and safety information\n        ",
                            "kind": "None"
                          },
                          "_lineno": 187,
                          "_col_offset": 8
                        }
                      },
                      "_lineno": 187,
                      "_col_offset": 8
