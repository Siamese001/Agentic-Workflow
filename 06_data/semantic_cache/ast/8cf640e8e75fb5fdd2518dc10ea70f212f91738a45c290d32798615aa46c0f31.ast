                          "_fields": {
                            "value": "\n        Generate content with circuit breaker protection\n        \n        Args:\n            prompt: The prompt string to send to Gemini\n            \n        Returns:\n            Generated text response\n            \n        Raises:\n            Exception: If API call fails\n            CircuitBreakerOpenError: If circuit breaker is OPEN\n        ",
