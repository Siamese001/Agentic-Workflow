                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "Heuristic classifier used by L1 to estimate ComplexityLevel.\n\n    This version incorporates:\n        \u2022 Job seniority / requirements\n        \u2022 Resume length\n        \u2022 QA / correction rates from meta_profile\n        \u2022 Deterministic skill and domain classifiers (non-LLM)\n\n    All logic is deterministic and side-effect free.\n    ",
                      "kind": "None"
                    },
                    "_lineno": 310,
                    "_col_offset": 4
                  }
                },
                "_lineno": 310,
                "_col_offset": 4
