                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "Deterministic, rule-based skill classifier (non-LLM).\n\n    Uses simple keyword / structural heuristics on job + resume to\n    derive a coarse skill profile. This is intentionally conservative\n    but stable for routing and complexity decisions.\n    ",
                      "kind": "None"
                    },
                    "_lineno": 211,
                    "_col_offset": 4
                  }
