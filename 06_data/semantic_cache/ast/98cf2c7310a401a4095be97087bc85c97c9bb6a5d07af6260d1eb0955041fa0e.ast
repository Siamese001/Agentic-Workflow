                  "body": [
                    {
                      "_type": "Expr",
                      "_fields": {
                        "value": {
                          "_type": "Constant",
                          "_fields": {
                            "value": "\n        Select the appropriate model for a given task and complexity.\n\n        task:\n            A string identifier describing the logical task, e.g.:\n                - \"strategy_generate_branch\"\n                - \"strategy_select_branch\"\n                - \"drafting_structure\"\n                - \"drafting_narrative\"\n                - \"drafting_compliance\"\n                - \"qa_semantic_check\"\n                - \"safety_check\"\n\n        complexity:\n            L1-estimated ComplexityLevel for the workload.\n\n        meta_profile:\n            Optional MetaProfileSnapshot influencing provider choice.\n        ",
                            "kind": "None"
                          },
                          "_lineno": 157,
                          "_col_offset": 8
                        }
                      },
                      "_lineno": 157,
                      "_col_offset": 8
                    },
                    {
                      "_type": "Assign",
                      "_fields": {
