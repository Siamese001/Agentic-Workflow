        {
          "_type": "ClassDef",
          "_fields": {
            "name": "RoutingPolicy",
            "bases": [],
            "keywords": [],
            "body": [
              {
                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    v10_10 RoutingPolicy: pure model-selection logic.\n\n    Fields:\n        prefer_anthropic: Prefer Anthropic models if True.\n        prefer_openai:    Prefer OpenAI models if True.\n        allow_heavy:      Allow heavy models (deep reasoning).\n        enforce_low_cost: Prefer light models when possible.\n\n    Notes:\n        - MetaProfileSnapshot can override provider preference based on\n          recent QA / correction rates.\n    ",
                      "kind": "None"
                    },
                    "_lineno": 79,
                    "_col_offset": 4
                  }
                },
                "_lineno": 79,
                "_col_offset": 4
              },
              {
                "_type": "AnnAssign",
