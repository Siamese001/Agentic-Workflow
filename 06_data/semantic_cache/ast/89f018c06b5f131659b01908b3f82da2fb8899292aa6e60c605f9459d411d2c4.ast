                  "body": [
                    {
                      "_type": "Expr",
                      "_fields": {
                        "value": {
                          "_type": "Constant",
                          "_fields": {
                            "value": "\n        Score N candidate messages against strategic brief\n        \n        This is the \"Fast Loop\" that replaces LLM synthesis for C_LEVEL.\n        Instead of using an LLM to synthesize 3 drafts, we score them\n        deterministically and select the winner.\n        \n        Args:\n            candidates: List of candidate message texts\n            strategic_brief: Strategic brief text to align with\n            criteria: Optional scoring weights (defaults to equal)\n        \n        Returns:\n            List of scored candidates, sorted by score (highest first)\n        ",
                            "kind": "None"
                          },
                          "_lineno": 109,
                          "_col_offset": 8
                        }
                      },
                      "_lineno": 109,
                      "_col_offset": 8
