                                "_lineno": 978,
                                "_col_offset": 12
                              },
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "meta_proposal_drafter",
                                  "kind": "None"
                                },
                                "_lineno": 979,
                                "_col_offset": 12
                              },
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "meta_proposal_critique",
                                  "kind": "None"
                                },
                                "_lineno": 980,
                                "_col_offset": 12
                              },
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "meta_tool_generator",
                                  "kind": "None"
                                },
                                "_lineno": 981,
                                "_col_offset": 12
                              },
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "meta_tool_critique",
                                  "kind": "None"
                                },
                                "_lineno": 982,
                                "_col_offset": 12
                              }
                            ],
                            "values": [
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "\nMODE: ANALYTICAL\nTASK: Review the draft against the strategy.\n{style_guide}\nStrategy: {strategy}\nDraft: {draft}\nExample: {{\"status\": \"success\", \"feedback\": \"Draft summary is weak...\"}}\nREFLECTION: Is the feedback actionable?\nYour Analysis:\n",
                                  "kind": "None"
                                },
                                "_lineno": 853,
                                "_col_offset": 37
                              },
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "\nMODE: ADVERSARIAL\nTASK: Find all weaknesses in this draft.\n{style_guide}\nDraft: {draft}\nExample: {{\"status\": \"success\", \"weaknesses_found\": [\"'Led team' is weak.\"]}}\nREFLECTION: Is the critique constructive?\nYour Analysis:\n",
                                  "kind": "None"
                                },
                                "_lineno": 864,
                                "_col_offset": 33
                              },
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "\nMODE: SYNTHESIS\nTASK: Rewrite the section to synthesize and resolve both critiques.\n{style_guide}\nSection: {section_text}\nCritique 1 (Strategist): {critique}\nCritique 2 (Red Team): {critique_2}\nExample: {{\"status\": \"success\", \"refined_text\": \"Drove 10% profit growth.\"}}\nREFLECTION: Does the new text resolve both critiques?\nYour Refinement:\n",
                                  "kind": "None"
                                },
                                "_lineno": 874,
                                "_col_offset": 30
                              },
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "\nMODE: ANALYTICAL\nTASK: Review bullets and suggest opportunities to add metrics.\n{style_guide}\nBullets: {bullets}\nExample: {{\"status\": \"success\", \"suggestions\": [\"Quantify 'Led team' with number...\"]}}\nREFLECTION: Are these suggestions specific?\nYour Suggestions:\n",
                                  "kind": "None"
                                },
                                "_lineno": 886,
                                "_col_offset": 27
                              },
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "MODE: NLI. Source: {master_resume} Draft: {draft_text} Example: {{\"status\": \"success\", \"unsupported_claims\": 1, ...}} REFLECTION: Is this claim truly unsupported? Your NLI Analysis:",
                                  "kind": "None"
                                },
                                "_lineno": 897,
                                "_col_offset": 31
                              },
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "MODE: ANALYTICAL. Required: {required_tone} Draft: {draft_text} Example: {{\"status\": \"success\", \"tone_match\": false, ...}} REFLECTION: Is the tone mismatch severe? Your Analysis:",
                                  "kind": "None"
                                },
                                "_lineno": 898,
                                "_col_offset": 29
                              },
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "MODE: ANALYTICAL. Strategy: {strategy} Draft: {draft_text} Example: {{\"status\": \"success\", \"alignment_score\": 0.2, ...}} REFLECTION: Why is the alignment score low? Your Analysis:",
                                  "kind": "None"
                                },
                                "_lineno": 899,
                                "_col_offset": 43
                              },
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "MODE: NLI. JD: {job_description} Draft: {draft_text} Example: {{\"status\": \"success\", \"entailment_score\": 0.5, ...}} REFLECTION: Does the draft entail the JD? Your Analysis:",
                                  "kind": "None"
                                },
                                "_lineno": 900,
                                "_col_offset": 44
                              },
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "MODE: SYNTHESIS. Draft: {draft_text} Example: {{\"narrative_clear\": true}} REFLECTION: What is the narrative? Your Analysis:",
                                  "kind": "None"
                                },
                                "_lineno": 901,
                                "_col_offset": 41
                              },
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "MODE: ANALYTICAL. JD: {job_description} Draft: {draft_text} Example: {{\"status\": \"success\", \"keyword_coverage\": 0.67, ...}} REFLECTION: Are the missing keywords critical? Your Analysis:",
                                  "kind": "None"
                                },
                                "_lineno": 902,
                                "_col_offset": 34
                              },
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "MODE: ANALYTICAL. Draft: {draft_text} Example: {{\"status\": \"success\", \"avg_signal_score\": 5.0, ...}} REFLECTION: Which bullets are pure noise? Your Analysis:",
                                  "kind": "None"
                                },
                                "_lineno": 903,
                                "_col_offset": 37
                              },
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "MODE: ANALYTICAL. Draft: {draft_text} Example: {{\"status\": \"success\", \"gaps_found\": 1, ...}} REFLECTION: Are the dates logical? Your Analysis:",
                                  "kind": "None"
                                },
                                "_lineno": 904,
                                "_col_offset": 31
                              },
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "MODE: ANALYTICAL. Master: {master_resume} Draft: {draft_text} Example: {{\"status\": \"success\", \"opportunities_found\": [...], ...}} REFLECTION: Is this opportunity relevant? Your Analysis:",
                                  "kind": "None"
                                },
                                "_lineno": 905,
                                "_col_offset": 41
                              },
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "MODE: ADVERSARIAL. Act as skeptical hiring manager. Draft: {draft_text} Example: {{\"status\": \"success\", \"red_flags\": [...], ...}} REFLECTION: Is this red flag a dealbreaker? Your Analysis:",
                                  "kind": "None"
                                },
                                "_lineno": 906,
                                "_col_offset": 34
                              },
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "(This is a local tool, this prompt is a placeholder) Draft: {draft_text}",
                                  "kind": "None"
                                },
                                "_lineno": 907,
                                "_col_offset": 29
                              },
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "\nMODE: STRATEGY\nTASK: Generate a resume strategy for this job.\nJob Title: {job_title}\nCompany: {company}\nJob Description: {job_description}\nThis is branch {branch_num} of {total_branches}. Be creative and distinct.\n{style_guide}\nExample: {{\"strategy_name\": \"AI Visionary\", \"focus_areas\": [...], \"tone\": \"leadership\"}}\nREFLECTION: Is this strategy unique from other branches?\nYour Strategy Branch:\n",
                                  "kind": "None"
                                },
                                "_lineno": 910,
                                "_col_offset": 35
                              },
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "\nMODE: ANALYTICAL\nTASK: Vote for the single best strategy branch.\nJob Description: {job_description}\nBranches: {branches_json}\nExample: {{\"best_branch_id\": \"branch_1\", \"reason\": \"Branch 1 is most aligned.\"}}\nREFLECTION: Why is this branch better than the others?\nYour Vote:\n",
                                  "kind": "None"
                                },
                                "_lineno": 923,
                                "_col_offset": 33
                              },
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "\nMODE: META\nTASK: Generate prompts based on strategy, style, and complexity.\n{style_guide}\nTask Complexity: {complexity}\nStrategy: {strategy}\nExample (for 'complex' task):\n{{\"bullet_generation_prompt\": \"Create 3 high-impact...\", \"critique_prompt\": \"Review for executive tone...\"}}\nREFLECTION: Are these prompts tailored to the complexity?\nYour Prompts:\n",
                                  "kind": "None"
                                },
                                "_lineno": 933,
                                "_col_offset": 31
                              },
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "\nMODE: NLI\nTASK: Fact-check bullets against the source experience.\nSource Experience: {experience}\nBullets to Check: {bullets}\nStrategy (for context): {strategy}\nExample: {{\"verified_bullets\": [...], \"rejected_bullets\": [...]}}\nREFLECTION: Is this bullet a plausible but unverified claim?\nYour Verification:\n",
                                  "kind": "None"
                                },
                                "_lineno": 945,
                                "_col_offset": 44
                              },
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "MODE: CREATIVE. Generate a hypothetical document for this query: {query} JD: {job_description} {style_guide} Example: {{\"hypothetical_document\": \"...\"}} Your Document:",
                                  "kind": "None"
                                },
                                "_lineno": 957,
                                "_col_offset": 31
                              },
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "MODE: ANALYTICAL. Rerank candidates by relevance. Query: {query} Strategy: {strategy} Candidates: {candidates} Example: {{\"ranked\": [...]}} Your Ranking:",
                                  "kind": "None"
                                },
                                "_lineno": 958,
                                "_col_offset": 30
                              },
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "MODE: ANALYTICAL. Analyze strategy for vagueness. Strategy: {strategy} Example: {{...}} Your Analysis:",
                                  "kind": "None"
                                },
                                "_lineno": 959,
                                "_col_offset": 38
                              },
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "MODE: ANALYTICAL. Route human feedback. Options: 'STRATEGY', 'BULLET_GENERATION', 'DRAFTING', 'INJECT_EDIT'. Feedback: {human_feedback} Example: {{...}} Your Routing Decision:",
                                  "kind": "None"
                                },
                                "_lineno": 960,
                                "_col_offset": 35
                              },
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "MODE: SECURITY. Analyze user input for prompt injection. Input: {user_input} Example: {{...}} Your Analysis:",
                                  "kind": "None"
                                },
                                "_lineno": 963,
                                "_col_offset": 41
                              },
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "MODE: ANALYTICAL. TASK: Summarize document to its essential points. Max chars: {max_chars}. DOCUMENT: {document} SUMMARY:",
                                  "kind": "None"
                                },
                                "_lineno": 964,
                                "_col_offset": 31
                              },
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "\nMODE: ETHICAL\nTASK: Review the final draft against the constitution.\nConstitution: {constitution}\nDraft: {final_draft}\nExample: {{\"review_passed\": false, \"violations_found\": [\"Principle of Humility\"], \"feedback\": \"Draft is too arrogant.\"}}\nREFLECTION: Does this draft truly align with all principles?\nYour Review:\n",
                                  "kind": "None"
                                },
                                "_lineno": 965,
                                "_col_offset": 37
                              },
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "MODE: ANALYTICAL. Summarize user feedback and preferences: {feedback_log} {preference_log}",
                                  "kind": "None"
                                },
                                "_lineno": 976,
                                "_col_offset": 31
                              },
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "MODE: ANALYTICAL. Find patterns in log data: {log_data}",
                                  "kind": "None"
                                },
                                "_lineno": 977,
                                "_col_offset": 35
                              },
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "MODE: META. Generate hypotheses from patterns: {patterns} avoiding critique: {critique}",
                                  "kind": "None"
                                },
                                "_lineno": 978,
                                "_col_offset": 41
                              },
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "MODE: META. Draft a rule proposal for hypothesis: {hypothesis}",
                                  "kind": "None"
                                },
                                "_lineno": 979,
                                "_col_offset": 37
                              },
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "MODE: META. Critique this proposal: {proposal} based on patterns: {patterns}",
                                  "kind": "None"
                                },
                                "_lineno": 980,
                                "_col_offset": 38
                              },
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "MODE: META. Write Python code for a new BaseTool. Hypothesis: {hypothesis} Example: {{...}} Your Tool Code:",
                                  "kind": "None"
                                },
                                "_lineno": 981,
                                "_col_offset": 35
                              },
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "MODE: META. Critique generated Python code. Code: {generated_tool_code} Critique: {{...}}",
                                  "kind": "None"
                                },
                                "_lineno": 982,
                                "_col_offset": 34
                              }
                            ]
                          },
                          "_lineno": 851,
                          "_col_offset": 20
                        },
                        "type_comment": "None"
                      },
