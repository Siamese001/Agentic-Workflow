        {
          "_type": "ClassDef",
          "_fields": {
            "name": "CircuitBreaker",
            "bases": [],
            "keywords": [],
            "body": [
              {
                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Circuit breaker for API calls - prevents cascade failures.\n    This is a core utility and remains in v13.0.\n    \n    The circuit breaker has three states:\n    - CLOSED: Normal operation, requests pass through\n    - OPEN: Too many failures, requests are blocked\n    - HALF_OPEN: Testing if service has recovered\n    \n    After failure_threshold consecutive failures, the circuit opens.\n    After timeout_seconds, it transitions to HALF_OPEN to test recovery.\n    A successful request in HALF_OPEN closes the circuit.\n    ",
                      "kind": "None"
                    },
                    "_lineno": 23,
                    "_col_offset": 4
                  }
                },
                "_lineno": 23,
                "_col_offset": 4
              },
              {
                "_type": "FunctionDef",
