            "body": [
              {
                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Execute all L2 stages for the workflow:\n\n        \u2022 Strategy\n        \u2022 Retrieval\n        \u2022 RAG reasoning\n        \u2022 Drafting\n        \u2022 QA (+ council heuristic)\n        \u2022 Safety\n\n    With concurrency:\n        \u2022 Strategy + Retrieval in parallel.\n        \u2022 RAG reasoning \u2192 Drafting \u2192 QA \u2192 Safety sequentially.\n    ",
                      "kind": "None"
                    },
                    "_lineno": 477,
                    "_col_offset": 4
                  }
                },
