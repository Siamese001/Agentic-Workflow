                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Build a retrieval query string from the in-memory job + resume.\n\n    This is intentionally deterministic and side-effect free; all actual\n    retrieval / ranking is handled inside retrieval.run_rag_retrieval.\n    ",
                      "kind": "None"
