            "body": [
              {
                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Phase-3 RAG reasoning step.\n\n    Runs between retrieval and drafting:\n\n        1. Build a RAG prompt using build_rag_prompt.\n        2. Call SemanticQAAgent.run_rag_reasoning to reason over the retrieved\n           evidence (no additional retrieval).\n        3. Inject the reasoning as a synthetic Evidence item at the end of\n           the evidence list.\n    ",
                      "kind": "None"
                    },
                    "_lineno": 279,
                    "_col_offset": 4
                  }
                },
                "_lineno": 279,
                "_col_offset": 4
