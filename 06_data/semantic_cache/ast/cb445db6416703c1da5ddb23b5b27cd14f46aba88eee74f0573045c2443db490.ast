        {
          "_type": "FunctionDef",
          "_fields": {
            "name": "_compute_council_vote_from_qa",
            "args": {
              "_type": "arguments",
              "_fields": {
                "posonlyargs": [],
                "args": [
                  {
                    "_type": "arg",
                    "_fields": {
                      "arg": "qa_result",
                      "annotation": {
