        {
          "_type": "ClassDef",
          "_fields": {
            "name": "MultiAgentOrchestrator",
            "bases": [],
            "keywords": [],
            "body": [
              {
                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    META-layer orchestrator.\n\n    Responsibilities:\n        \u2022 Evaluate a meta-agent graph (QA, Safety, Meta councils)\n        \u2022 Produce MultiAgentCouncilResult objects\n        \u2022 Provide patch-ready payloads for L4 without applying them\n        \u2022 Provide synthetic meta-layer messages for logging/prompts\n\n    It MUST NOT:\n        \u2022 call L1 planners\n        \u2022 call L2 executors\n        \u2022 call L3 DAG logic\n        \u2022 mutate L4 state directly\n        \u2022 make L5 decisions\n    ",
                      "kind": "None"
                    },
                    "_lineno": 270,
                    "_col_offset": 4
                  }
                },
                "_lineno": 270,
                "_col_offset": 4
