                                                      "_lineno": 1050,
                                                      "_col_offset": 12
                                                    },
                                                    "conversion": "-1",
                                                    "format_spec": "None"
                                                  },
                                                  "_lineno": 1050,
                                                  "_col_offset": 11
                                                },
                                                {
                                                  "_type": "Constant",
                                                  "_fields": {
                                                    "value": "\nverbatim_count = ",
                                                    "kind": "None"
                                                  },
                                                  "_lineno": 1050,
                                                  "_col_offset": 26
                                                },
                                                {
                                                  "_type": "FormattedValue",
                                                  "_fields": {
                                                    "value": {
                                                      "_type": "Name",
                                                      "_fields": {
                                                        "id": "verbatim_count",
                                                        "ctx": {
                                                          "_type": "Load",
                                                          "_fields": {}
                                                        }
                                                      },
                                                      "_lineno": 1051,
                                                      "_col_offset": 18
                                                    },
                                                    "conversion": "-1",
                                                    "format_spec": "None"
                                                  },
                                                  "_lineno": 1051,
                                                  "_col_offset": 17
                                                },
                                                {
                                                  "_type": "Constant",
                                                  "_fields": {
                                                    "value": "\n\nkeywords_lower = [k.lower() for k in keywords if k]\n\ndef score_bullet(bullet_text):\n    if not keywords_lower:\n        return 0\n    text_lower = bullet_text.lower()\n    score = sum(1 for kw in keywords_lower if kw in text_lower)\n    return score\n\nfor bullet in bullets_data:\n    bullet['relevance_score'] = score_bullet(bullet.get('bullet_text', ''))\n\nsorted_bullets = sorted(bullets_data, key=lambda x: x['relevance_score'], reverse=True)\nselected_bullets = sorted_bullets[:verbatim_count]\n\n# Remove temporary score\nfor b in selected_bullets:\n    b.pop('relevance_score', None)\n\nprint(json.dumps(selected_bullets))\n",
                                                    "kind": "None"
                                                  },
                                                  "_lineno": 1051,
                                                  "_col_offset": 33
                                                }
