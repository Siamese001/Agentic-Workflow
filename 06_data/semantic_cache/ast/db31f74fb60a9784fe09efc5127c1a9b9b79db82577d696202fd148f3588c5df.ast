                                            "_type": "JoinedStr",
                                            "_fields": {
                                              "values": [
                                                {
                                                  "_type": "Constant",
                                                  "_fields": {
                                                    "value": "\nimport json\n\nbullets_data = ",
                                                    "kind": "None"
                                                  },
                                                  "_lineno": 1046,
                                                  "_col_offset": 43
                                                },
                                                {
                                                  "_type": "FormattedValue",
                                                  "_fields": {
                                                    "value": {
                                                      "_type": "Name",
