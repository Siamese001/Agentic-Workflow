                            "_lineno": 290,
                            "_col_offset": 8
                          }
                        ],
                        "value": {
                          "_type": "JoinedStr",
                          "_fields": {
                            "values": [
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "You are a constraint feasibility analyzer.\nYour ONLY task is to determine if a set of constraints is logically achievable.\n\nCONSTRAINTS TO ANALZE:\n",
                                  "kind": "None"
                                },
                                "_lineno": 290,
                                "_col_offset": 26
                              },
                              {
                                "_type": "FormattedValue",
                                "_fields": {
                                  "value": {
