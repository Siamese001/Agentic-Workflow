            },
            "body": [
              {
                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    End-to-end META routing pipeline:\n\n        1. Normalize plan\n        2. Build prompt envelope\n        3. Construct RoutingCriteria (meta-aware)\n        4. Ask L5.ModelRouter for model selection\n        5. Simulate model invocation\n        6. Return structured routing output\n\n    DOES NOT mutate state.\n    DOES NOT perform safety/policy.\n    ",
                      "kind": "None"
                    },
                    "_lineno": 272,
                    "_col_offset": 4
                  }
                },
                "_lineno": 272,
                "_col_offset": 4
