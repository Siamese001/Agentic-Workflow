                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    META-layer is allowed to read state (NOT mutate it).\n    This helper extracts only the fields needed for prompt construction.\n\n    This avoids importing from L4 and avoids layer violations.\n    ",
