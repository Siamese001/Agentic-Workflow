            "body": [
              {
                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "Generate a small set of coarse hypotheses from task + RAG.\n\n    This implementation is deterministic and uses only cheap heuristics:\n    - if there is any evidence, we create 1\u20133 simple hypotheses whose\n      confidence is proportional to the number of evidence items.\n    - if no evidence is present, we still produce a single low-confidence\n      hypothesis so downstream code has something to inspect.\n    ",
                      "kind": "None"
                    },
                    "_lineno": 9,
                    "_col_offset": 4
                  }
                },
                "_lineno": 9,
                "_col_offset": 4
              },
