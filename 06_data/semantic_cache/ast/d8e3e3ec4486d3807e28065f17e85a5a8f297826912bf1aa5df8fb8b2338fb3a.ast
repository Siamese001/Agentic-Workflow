            "body": [
              {
                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "Wrapper used by retrieval.py for Evidence-level weighted RRF.\n\n    This function adapts the raw `rrf_weights` list (coming from\n    RetrievalConfig.rrf_weights) into a minimal RetrievalConfig instance\n    and delegates to `fuse_evidence_groups_rrf`.\n\n    It exists solely to preserve the existing retrieval.py call-site:\n\n        ranking.fuse_ranked_groups_rrf(\n            groups=groups,\n            rrf_weights=retrieval_cfg.rrf_weights,\n            workflow_id=workflow_id,\n        )\n\n    The `workflow_id` is accepted for signature compatibility but is\n    not used here; telemetry is emitted inside `fuse_evidence_groups_rrf`.\n    ",
                      "kind": "None"
                    },
                    "_lineno": 548,
                    "_col_offset": 4
                  }
                },
                "_lineno": 548,
                "_col_offset": 4
              },
