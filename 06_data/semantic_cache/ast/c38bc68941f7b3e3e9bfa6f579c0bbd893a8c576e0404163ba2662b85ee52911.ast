              {
                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Surfaces for self-correction / recovery decisions.\n\n    These surfaces are used by L3 orchestrators, self_correction, and\n    meta-learning to decide how to adapt behavior over time.\n    ",
                      "kind": "None"
                    },
                    "_lineno": 67,
