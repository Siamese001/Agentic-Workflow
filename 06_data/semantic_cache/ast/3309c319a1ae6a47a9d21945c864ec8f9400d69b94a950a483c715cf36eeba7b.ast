                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Run L5 policy evaluation and return a verdict event.\n    \n    This is a thin adapter that converts safety results into a policy decision\n    event with verdict and reason fields.\n    \n    Args:\n        safety_result: SafetyResult with findings\n        council_vote: CouncilVote (for future use)\n        policy: SafetyPolicy to apply\n        ctx: Optional execution context\n        \n    Returns:\n        An event object with 'verdict' and 'reason' attributes\n    ",
                      "kind": "None"
                    },
                    "_lineno": 178,
                    "_col_offset": 4
                  }
                },
                "_lineno": 178,
                "_col_offset": 4
