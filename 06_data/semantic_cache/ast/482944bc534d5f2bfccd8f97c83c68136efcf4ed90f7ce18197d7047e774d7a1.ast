                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Build a linear pipeline:\n        r0 \u2192 r1 \u2192 r2 \u2192 ...\n\n    Example:\n        build_linear_pipeline([\n            AgentRole.PLANNER,\n            AgentRole.RETRIEVER,\n            AgentRole.DRAFTER,\n            AgentRole.QA,\n            AgentRole.SAFETY,\n        ])\n    ",
                      "kind": "None"
