                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "Compute a simple collaboration score over simulation outputs.\n\n    The current implementation looks for a ``golden_eval_score`` field in\n    each output's ``outcome`` mapping and returns the average. Missing\n    scores are treated as zero.\n    ",
                      "kind": "None"
                    },
                    "_lineno": 25,
                    "_col_offset": 4
                  }
                },
                "_lineno": 25,
                "_col_offset": 4
