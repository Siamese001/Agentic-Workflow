              {
                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "Compute a heuristic conflict index from simulation outputs.\n\n    We treat any ``correction_iterations`` > 0 or explicit\n    ``agent_conflict_count`` > 0 as evidence of conflict and return the\n    fraction of outputs exhibiting such signals.\n    ",
                      "kind": "None"
                    },
                    "_lineno": 47,
                    "_col_offset": 4
                  }
                },
                "_lineno": 47,
                "_col_offset": 4
