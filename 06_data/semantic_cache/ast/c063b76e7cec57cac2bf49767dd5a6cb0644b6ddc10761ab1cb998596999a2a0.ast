                      ],
                      "values": [
                        {
                          "_type": "Constant",
                          "_fields": {
                            "value": "I'd value the opportunity to explore how [TOPIC] aligns with your vision for [COMPANY].",
                            "kind": "None"
                          },
                          "_lineno": 28,
                          "_col_offset": 27
                        },
                        {
                          "_type": "Constant",
                          "_fields": {
                            "value": "Would you be open to a brief call to discuss [TOPIC]?",
                            "kind": "None"
                          },
                          "_lineno": 29,
                          "_col_offset": 29
                        },
                        {
                          "_type": "Dict",
                          "_fields": {
                            "keys": [
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "direct",
                                  "kind": "None"
                                },
                                "_lineno": 31,
                                "_col_offset": 12
                              },
                              {
                                "_type": "Constant",
                                "_fields": {
