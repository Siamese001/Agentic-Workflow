                          }
                        },
                        "_lineno": 46,
                        "_col_offset": 4
                      },
                      "attr": "C_LEVEL",
                      "ctx": {
                        "_type": "Load",
                        "_fields": {}
                      }
                    },
                    "_lineno": 46,
                    "_col_offset": 4
                  },
                  {
                    "_type": "Attribute",
                    "_fields": {
                      "value": {
                        "_type": "Name",
                        "_fields": {
                          "id": "Archetype",
                          "ctx": {
                            "_type": "Load",
