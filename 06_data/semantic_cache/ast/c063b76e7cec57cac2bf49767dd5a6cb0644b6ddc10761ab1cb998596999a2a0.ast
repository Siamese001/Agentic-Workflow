                                },
                                "_lineno": 32,
                                "_col_offset": 12
                              }
                            ],
                            "values": [
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "Could we schedule 20 minutes to dive into [TECHNICAL_TOPIC]?",
                                  "kind": "None"
                                },
                                "_lineno": 31,
                                "_col_offset": 22
                              },
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "If this resonates with your team's roadmap, I'd be grateful for any insights you could offer.",
                                  "kind": "None"
                                },
                                "_lineno": 32,
                                "_col_offset": 27
                              }
                            ]
                          },
                          "_lineno": 30,
                          "_col_offset": 29
                        },
                        {
                          "_type": "Constant",
                          "_fields": {
                            "value": "I'd welcome a conversation about potential opportunities that could benefit your team.",
                            "kind": "None"
                          },
                          "_lineno": 34,
                          "_col_offset": 29
                        }
                      ]
                    },
                    "_lineno": 27,
                    "_col_offset": 17
                  },
                  {
                    "_type": "Dict",
                    "_fields": {
