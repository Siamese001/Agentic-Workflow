                      ],
                      "values": [
                        {
                          "_type": "Constant",
                          "_fields": {
                            "value": "Would you be open to a brief conversation about how [TOPIC] might align with your strategic priorities?",
                            "kind": "None"
                          },
                          "_lineno": 19,
                          "_col_offset": 27
                        },
                        {
                          "_type": "Constant",
                          "_fields": {
                            "value": "I'd welcome the chance to discuss how [TOPIC] could support your team's objectives.",
                            "kind": "None"
                          },
                          "_lineno": 20,
                          "_col_offset": 29
                        },
                        {
                          "_type": "Dict",
                          "_fields": {
                            "keys": [
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "direct",
                                  "kind": "None"
                                },
                                "_lineno": 22,
                                "_col_offset": 12
                              },
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "deferential",
                                  "kind": "None"
                                },
                                "_lineno": 23,
                                "_col_offset": 12
                              }
                            ],
                            "values": [
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "Would you have 15 minutes to discuss [TECHNICAL_TOPIC]?",
                                  "kind": "None"
                                },
                                "_lineno": 22,
                                "_col_offset": 22
                              },
                              {
                                "_type": "Constant",
                                "_fields": {
                                  "value": "If this aligns with your team's direction, I'd appreciate any guidance you could share.",
                                  "kind": "None"
                                },
                                "_lineno": 23,
                                "_col_offset": 27
                              }
                            ]
                          },
                          "_lineno": 21,
                          "_col_offset": 29
                        },
                        {
                          "_type": "Constant",
                          "_fields": {
                            "value": "Would you be open to a conversation about roles that might match your team's needs?",
                            "kind": "None"
                          },
                          "_lineno": 25,
                          "_col_offset": 29
                        }
