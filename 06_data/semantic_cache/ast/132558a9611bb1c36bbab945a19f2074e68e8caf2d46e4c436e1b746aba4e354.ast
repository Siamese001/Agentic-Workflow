                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Enforce PromptACL for the given role and use_case.\n\n    use_case:\n        - \"read\"  \u2192 viewing the definition\n        - \"edit\"  \u2192 modifying / registering the definition\n        - \"use\"   \u2192 using in ENGINE (runtime)\n    ",
