          "_fields": {
            "value": {
              "_type": "Constant",
              "_fields": {
                "value": "Registry - Meta Layer\n\nThis module provides strategy and configuration registries.\n\nLayer: Meta\nResponsibilities:\n- RAG strategy registry\n- RetrievalConfig factories\n- Static strategy mappings\n- Prompt registry bridge\n\nNon-responsibilities:\n- Retrieval execution\n- Ranking execution\n- LLM calls\n- Orchestration\n- State mutation\n",
                "kind": "None"
              },
              "_lineno": 1,
              "_col_offset": 0
            }
          },
          "_lineno": 1,
          "_col_offset": 0
        },
