          "_fields": {
            "value": {
              "_type": "Constant",
              "_fields": {
                "value": "Snapshot-local runtime package shim for v10_10 tests.\n\nWhen tests are run with rootdir=Agentic-Workflow-10_10, the name ``runtime``\nresolves to this package. This shim ensures that imports like\n``from runtime.observability import start_span`` are forwarded to the real\nruntime package defined at the repo root.\n",
                "kind": "None"
              },
              "_lineno": 1,
              "_col_offset": 0
            }
          },
          "_lineno": 1,
          "_col_offset": 0
