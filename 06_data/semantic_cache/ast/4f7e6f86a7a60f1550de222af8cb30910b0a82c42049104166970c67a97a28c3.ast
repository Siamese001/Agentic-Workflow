        {
          "_type": "Expr",
          "_fields": {
            "value": {
              "_type": "Constant",
              "_fields": {
                "value": "\nHop 6: Gate Decision - HIGH-SIGNAL OVERWRITE\n\nThis is a risk-aware, dynamic decision engine.\n1. It differentiates between deterministic (e.g., placeholder) and\n   quality-based (e.g., thematic alignment) failures.\n2. It reads the HOP-0 RAG signal quality (via HOP-5 results) to\n   dynamically adjust its risk tolerance.\n3. It outputs a \"PROCEED_WITH_REVIEW\" state for low-confidence runs.\n",
                "kind": "None"
              },
              "_lineno": 2,
              "_col_offset": 0
            }
          },
          "_lineno": 2,
          "_col_offset": 0
        },
