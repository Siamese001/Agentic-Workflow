                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "Run a hybrid (dense + lexical) search over a Chroma collection.\n\n    This is a thin wrapper around ``collection.query``. It returns the\n    raw Chroma response so that higher layers can adapt it into Evidence\n    objects or other structures.\n    ",
                      "kind": "None"
                    },
