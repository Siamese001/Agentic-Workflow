                  "body": [
                    {
                      "_type": "Expr",
                      "_fields": {
                        "value": {
                          "_type": "Constant",
                          "_fields": {
                            "value": "\n        Fuse results from multiple queries into a single, deduplicated,\n        ranked list.\n\n        Steps:\n            1. Flatten all sources.\n            2. Deduplicate by (query.lower(), evidence.lower()).\n            3. Assign a fusion score combining rank and evidence length.\n            4. Sort by fusion score descending.\n            5. Reassign ranks deterministically.\n        ",
                            "kind": "None"
                          },
                          "_lineno": 451,
                          "_col_offset": 8
                        }
                      },
                      "_lineno": 451,
                      "_col_offset": 8
                    },
