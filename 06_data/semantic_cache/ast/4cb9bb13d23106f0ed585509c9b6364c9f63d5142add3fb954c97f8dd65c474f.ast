            "body": [
              {
                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Progressive temperature escalation for retry attempts.\n    FEATURE 2.2 from SUPREME_SPELL\n    \n    Each archetype has a base temperature. On retry attempts,\n    temperature increases by ESCALATION_STEP to encourage more\n    creative solutions, up to MAX_TEMPERATURE.\n    \n    Example:\n    - Attempt 1: 0.45 (base for C_LEVEL)\n    - Attempt 2: 0.60 (base + 0.15)\n    - Attempt 3: 0.75 (base + 0.30)\n    - Attempt 4+: 0.95 (capped at MAX)\n    ",
                      "kind": "None"
                    },
                    "_lineno": 215,
                    "_col_offset": 4
                  }
