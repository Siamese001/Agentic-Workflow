                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Intelligent context window management with priority-based truncation\n    GAP 7.1, 7.2, 7.3 from v10.22\n    \n    Different sections of context have different priorities:\n    - Job description: Highest priority, never truncate\n    - Recipient profile: High priority\n    - Company context: Medium-high priority\n    - Sender profile: Medium priority\n    - RAG results: Lower priority, truncate oldest first\n    - Examples: Lowest priority, truncate first\n    ",
                      "kind": "None"
                    },
                    "_lineno": 106,
                    "_col_offset": 4
                  }
                },
