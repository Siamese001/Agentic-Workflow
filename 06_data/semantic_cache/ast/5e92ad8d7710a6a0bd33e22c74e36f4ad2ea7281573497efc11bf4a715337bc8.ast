                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Convenience wrapper around run_batch_v10_10.run_batch for tests.\n\n    It accepts a list of jobs (already structured for the main entrypoint)\n    and optional SimulationKnobs. It returns whatever the underlying\n    run_batch implementation returns, without modification.\n    ",
                      "kind": "None"
