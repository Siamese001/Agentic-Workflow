                "_type": "Expr",
                "_fields": {
                  "value": {
                    "_type": "Constant",
                    "_fields": {
                      "value": "\n    Run a matrix of simulations across the HYDE / council / correction /\n    telemetry dimensions.\n\n    This uses the same run_workflow entrypoint as the golden scenarios but\n    does not attach a GoldenExpectation. It is intended for stress-testing\n    and diagnostics (e.g., ensuring no combination explodes).\n    ",
                      "kind": "None"
                    },
                    "_lineno": 434,
                    "_col_offset": 4
                  }
