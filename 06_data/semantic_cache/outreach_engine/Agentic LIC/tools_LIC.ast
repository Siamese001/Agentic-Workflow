        alias(name='numpy', asname='np')]),
    ClassDef(
      name='CodeInterpreterTool',
      body=[
        Expr(
          value=Constant(value='\n    v13.0: Safe code execution environment for deterministic evaluation\n    \n    Provides a "Fast Loop" for validation and scoring before committing\n    to expensive LLM calls. Used by HOP-6 (ValidationAgent) to:\n    - Score message drafts for similarity to strategic brief\n    - Rank N candidates without LLM synthesis\n    - Run deterministic validation checks\n    ')),
        FunctionDef(
          name='__init__',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Initialize code interpreter with safe function registry')),
            Assign(
