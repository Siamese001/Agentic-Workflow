                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='functions',
                  ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='run_similarity_check'),
                  Constant(value='run_scoring_competition'),
                  Constant(value='extract_keywords'),
                  Constant(value='calculate_overlap'),
                  Constant(value='rank_by_metric'),
                  Constant(value='validate_structure')],
                values=[
                  Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='run_similarity_check',
                    ctx=Load()),
                  Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='run_scoring_competition',
                    ctx=Load()),
                  Attribute(
                    value=Name(id='self', ctx=Load()),
