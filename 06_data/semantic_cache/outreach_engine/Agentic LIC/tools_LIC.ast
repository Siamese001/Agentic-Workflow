                    ctx=Load()),
                  Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='calculate_overlap',
                    ctx=Load()),
                  Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='rank_by_metric',
                    ctx=Load()),
                  Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='validate_structure',
                    ctx=Load())])),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  Constant(value='[CodeInterpreter] Initialized with safe function registry')]))]),
        FunctionDef(
          name='execute',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='function_name',
                annotation=Name(id='str', ctx=Load()))],
            kwarg=arg(arg='kwargs')),
          body=[
            Expr(
              value=Constant(value='\n        Execute a registered function safely\n        \n        Args:\n            function_name: Name of function to execute\n            **kwargs: Function arguments\n        \n        Returns:\n            Function result\n        \n        Raises:\n            ValueError: If function not registered\n        ')),
            If(
              test=Compare(
                left=Name(id='function_name', ctx=Load()),
                ops=[
                  NotIn()],
                comparators=[
                  Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='functions',
                    ctx=Load())]),
              body=[
                Raise(
                  exc=Call(
                    func=Name(id='ValueError', ctx=Load()),
                    args=[
                      JoinedStr(
                        values=[
                          Constant(value="Function '"),
                          FormattedValue(
                            value=Name(id='function_name', ctx=Load()),
                            conversion=-1),
                          Constant(value="' not registered. Available: "),
                          FormattedValue(
                            value=Call(
                              func=Name(id='list', ctx=Load()),
                              args=[
                                Call(
                                  func=Attribute(
                                    value=Attribute(
                                      value=Name(id='self', ctx=Load()),
                                      attr='functions',
                                      ctx=Load()),
                                    attr='keys',
                                    ctx=Load()))]),
                            conversion=-1)])]))]),
            Assign(
              targets=[
                Name(id='func', ctx=Store())],
              value=Subscript(
                value=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='functions',
                  ctx=Load()),
                slice=Name(id='function_name', ctx=Load()),
                ctx=Load())),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='[CodeInterpreter] Executing: '),
                      FormattedValue(
                        value=Name(id='function_name', ctx=Load()),
                        conversion=-1)])])),
            Return(
              value=Call(
                func=Name(id='func', ctx=Load()),
                keywords=[
                  keyword(
                    value=Name(id='kwargs', ctx=Load()))]))],
          returns=Name(id='Any', ctx=Load())),
        FunctionDef(
          name='run_similarity_check',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='text1',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='text2',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='method',
                annotation=Name(id='str', ctx=Load()))],
            defaults=[
              Constant(value='cosine')]),
          body=[
            Expr(
              value=Constant(value='\n        Calculate similarity between two texts\n        \n        Args:\n            text1: First text\n            text2: Second text\n            method: Similarity method ("cosine", "jaccard")\n        \n        Returns:\n            Similarity score (0.0 to 1.0)\n        ')),
            If(
              test=Compare(
                left=Name(id='method', ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value='cosine')]),
              body=[
                Assign(
                  targets=[
                    Name(id='vectorizer', ctx=Store())],
                  value=Call(
                    func=Name(id='TfidfVectorizer', ctx=Load()))),
                Assign(
                  targets=[
                    Name(id='vectors', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='vectorizer', ctx=Load()),
                      attr='fit_transform',
                      ctx=Load()),
                    args=[
                      List(
                        elts=[
                          Name(id='text1', ctx=Load()),
                          Name(id='text2', ctx=Load())],
                        ctx=Load())])),
                Assign(
                  targets=[
                    Name(id='similarity', ctx=Store())],
                  value=Subscript(
                    value=Subscript(
                      value=Call(
                        func=Name(id='cosine_similarity', ctx=Load()),
                        args=[
                          Subscript(
                            value=Name(id='vectors', ctx=Load()),
                            slice=Slice(
                              lower=Constant(value=0),
                              upper=Constant(value=1)),
                            ctx=Load()),
                          Subscript(
                            value=Name(id='vectors', ctx=Load()),
                            slice=Slice(
                              lower=Constant(value=1),
                              upper=Constant(value=2)),
                            ctx=Load())]),
                      slice=Constant(value=0),
                      ctx=Load()),
                    slice=Constant(value=0),
                    ctx=Load())),
                Return(
                  value=Call(
                    func=Name(id='float', ctx=Load()),
                    args=[
                      Name(id='similarity', ctx=Load())]))],
              orelse=[
                If(
                  test=Compare(
                    left=Name(id='method', ctx=Load()),
                    ops=[
                      Eq()],
                    comparators=[
                      Constant(value='jaccard')]),
                  body=[
                    Assign(
                      targets=[
                        Name(id='words1', ctx=Store())],
                      value=Call(
                        func=Name(id='set', ctx=Load()),
                        args=[
                          Call(
                            func=Attribute(
                              value=Call(
                                func=Attribute(
                                  value=Name(id='text1', ctx=Load()),
                                  attr='lower',
                                  ctx=Load())),
                              attr='split',
                              ctx=Load()))])),
                    Assign(
                      targets=[
                        Name(id='words2', ctx=Store())],
                      value=Call(
                        func=Name(id='set', ctx=Load()),
                        args=[
                          Call(
                            func=Attribute(
                              value=Call(
                                func=Attribute(
                                  value=Name(id='text2', ctx=Load()),
                                  attr='lower',
                                  ctx=Load())),
                              attr='split',
                              ctx=Load()))])),
                    Assign(
                      targets=[
                        Name(id='intersection', ctx=Store())],
                      value=BinOp(
                        left=Name(id='words1', ctx=Load()),
                        op=BitAnd(),
                        right=Name(id='words2', ctx=Load()))),
                    Assign(
                      targets=[
                        Name(id='union', ctx=Store())],
                      value=BinOp(
                        left=Name(id='words1', ctx=Load()),
                        op=BitOr(),
                        right=Name(id='words2', ctx=Load()))),
                    If(
                      test=Compare(
                        left=Call(
                          func=Name(id='len', ctx=Load()),
                          args=[
                            Name(id='union', ctx=Load())]),
                        ops=[
                          Eq()],
                        comparators=[
                          Constant(value=0)]),
                      body=[
                        Return(
                          value=Constant(value=0.0))]),
                    Return(
                      value=BinOp(
                        left=Call(
                          func=Name(id='len', ctx=Load()),
                          args=[
                            Name(id='intersection', ctx=Load())]),
                        op=Div(),
                        right=Call(
                          func=Name(id='len', ctx=Load()),
                          args=[
                            Name(id='union', ctx=Load())])))],
                  orelse=[
                    Raise(
                      exc=Call(
                        func=Name(id='ValueError', ctx=Load()),
                        args=[
                          JoinedStr(
                            values=[
                              Constant(value='Unknown similarity method: '),
                              FormattedValue(
                                value=Name(id='method', ctx=Load()),
                                conversion=-1)])]))])])],
          returns=Name(id='float', ctx=Load())),
        FunctionDef(
          name='run_scoring_competition',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='candidates',
                annotation=Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Name(id='str', ctx=Load()),
                  ctx=Load())),
              arg(
                arg='strategic_brief',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='criteria',
                annotation=Subscript(
                  value=Name(id='Optional', ctx=Load()),
                  slice=Subscript(
                    value=Name(id='Dict', ctx=Load()),
                    slice=Tuple(
                      elts=[
                        Name(id='str', ctx=Load()),
                        Name(id='float', ctx=Load())],
                      ctx=Load()),
                    ctx=Load()),
                  ctx=Load()))],
            defaults=[
              Constant(value=None)]),
          body=[
            Expr(
              value=Constant(value='\n        Score N candidate messages against strategic brief\n        \n        This is the "Fast Loop" that replaces LLM synthesis for C_LEVEL.\n        Instead of using an LLM to synthesize 3 drafts, we score them\n        deterministically and select the winner.\n        \n        Args:\n            candidates: List of candidate message texts\n            strategic_brief: Strategic brief text to align with\n            criteria: Optional scoring weights (defaults to equal)\n        \n        Returns:\n            List of scored candidates, sorted by score (highest first)\n        ')),
            If(
              test=Compare(
                left=Name(id='criteria', ctx=Load()),
                ops=[
                  Is()],
                comparators=[
                  Constant(value=None)]),
              body=[
                Assign(
                  targets=[
                    Name(id='criteria', ctx=Store())],
                  value=Dict(
                    keys=[
                      Constant(value='strategic_alignment'),
                      Constant(value='keyword_density'),
                      Constant(value='readability')],
                    values=[
                      Constant(value=0.5),
                      Constant(value=0.3),
                      Constant(value=0.2)]))]),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='[CodeInterpreter] Scoring '),
                      FormattedValue(
                        value=Call(
                          func=Name(id='len', ctx=Load()),
                          args=[
                            Name(id='candidates', ctx=Load())]),
                        conversion=-1),
                      Constant(value=' candidates')])])),
            Assign(
              targets=[
                Name(id='scored', ctx=Store())],
              value=List(ctx=Load())),
            For(
              target=Tuple(
                elts=[
                  Name(id='i', ctx=Store()),
                  Name(id='candidate', ctx=Store())],
                ctx=Store()),
              iter=Call(
                func=Name(id='enumerate', ctx=Load()),
                args=[
                  Name(id='candidates', ctx=Load())]),
              body=[
                Assign(
                  targets=[
                    Name(id='scores', ctx=Store())],
                  value=Dict()),
                Assign(
                  targets=[
                    Subscript(
                      value=Name(id='scores', ctx=Load()),
                      slice=Constant(value='strategic_alignment'),
                      ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='run_similarity_check',
                      ctx=Load()),
                    args=[
                      Name(id='candidate', ctx=Load()),
                      Name(id='strategic_brief', ctx=Load())],
                    keywords=[
                      keyword(
                        arg='method',
                        value=Constant(value='cosine'))])),
                Assign(
                  targets=[
                    Name(id='brief_keywords', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='extract_keywords',
                      ctx=Load()),
                    args=[
                      Name(id='strategic_brief', ctx=Load())],
                    keywords=[
                      keyword(
                        arg='top_n',
                        value=Constant(value=20))])),
                Assign(
                  targets=[
                    Name(id='candidate_words', ctx=Store())],
                  value=Call(
                    func=Name(id='set', ctx=Load()),
                    args=[
                      Call(
                        func=Attribute(
                          value=Call(
                            func=Attribute(
                              value=Name(id='candidate', ctx=Load()),
                              attr='lower',
                              ctx=Load())),
                          attr='split',
                          ctx=Load()))])),
                Assign(
                  targets=[
                    Name(id='keyword_matches', ctx=Store())],
                  value=Call(
                    func=Name(id='sum', ctx=Load()),
                    args=[
                      GeneratorExp(
                        elt=Constant(value=1),
                        generators=[
                          comprehension(
                            target=Name(id='kw', ctx=Store()),
                            iter=Name(id='brief_keywords', ctx=Load()),
                            ifs=[
                              Compare(
                                left=Name(id='kw', ctx=Load()),
                                ops=[
                                  In()],
                                comparators=[
                                  Name(id='candidate_words', ctx=Load())])],
                            is_async=0)])])),
                Assign(
                  targets=[
                    Subscript(
                      value=Name(id='scores', ctx=Load()),
                      slice=Constant(value='keyword_density'),
                      ctx=Store())],
                  value=IfExp(
                    test=Name(id='brief_keywords', ctx=Load()),
                    body=BinOp(
                      left=Name(id='keyword_matches', ctx=Load()),
                      op=Div(),
                      right=Call(
                        func=Name(id='len', ctx=Load()),
                        args=[
                          Name(id='brief_keywords', ctx=Load())])),
                    orelse=Constant(value=0.0))),
                Assign(
                  targets=[
                    Subscript(
                      value=Name(id='scores', ctx=Load()),
                      slice=Constant(value='readability'),
                      ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='_calculate_readability',
                      ctx=Load()),
                    args=[
                      Name(id='candidate', ctx=Load())])),
                Assign(
                  targets=[
                    Name(id='total_score', ctx=Store())],
                  value=Call(
                    func=Name(id='sum', ctx=Load()),
                    args=[
                      GeneratorExp(
                        elt=BinOp(
                          left=Subscript(
                            value=Name(id='scores', ctx=Load()),
                            slice=Name(id='criterion', ctx=Load()),
                            ctx=Load()),
                          op=Mult(),
                          right=Name(id='weight', ctx=Load())),
                        generators=[
                          comprehension(
                            target=Tuple(
                              elts=[
                                Name(id='criterion', ctx=Store()),
                                Name(id='weight', ctx=Store())],
                              ctx=Store()),
                            iter=Call(
                              func=Attribute(
                                value=Name(id='criteria', ctx=Load()),
                                attr='items',
                                ctx=Load())),
                            ifs=[
                              Compare(
                                left=Name(id='criterion', ctx=Load()),
                                ops=[
                                  In()],
                                comparators=[
                                  Name(id='scores', ctx=Load())])],
                            is_async=0)])])),
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='scored', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Dict(
                        keys=[
                          Constant(value='candidate_index'),
                          Constant(value='candidate_text'),
                          Constant(value='scores'),
                          Constant(value='total_score')],
                        values=[
                          Name(id='i', ctx=Load()),
                          Name(id='candidate', ctx=Load()),
                          Name(id='scores', ctx=Load()),
                          Name(id='total_score', ctx=Load())])]))]),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='scored', ctx=Load()),
                  attr='sort',
                  ctx=Load()),
                keywords=[
                  keyword(
                    arg='key',
                    value=Lambda(
                      args=arguments(
                        args=[
                          arg(arg='x')]),
                      body=Subscript(
                        value=Name(id='x', ctx=Load()),
                        slice=Constant(value='total_score'),
                        ctx=Load()))),
                  keyword(
                    arg='reverse',
                    value=Constant(value=True))])),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='[CodeInterpreter] Winner: candidate '),
                      FormattedValue(
                        value=Subscript(
                          value=Subscript(
                            value=Name(id='scored', ctx=Load()),
                            slice=Constant(value=0),
                            ctx=Load()),
                          slice=Constant(value='candidate_index'),
                          ctx=Load()),
                        conversion=-1),
                      Constant(value=' (score: '),
                      FormattedValue(
                        value=Subscript(
                          value=Subscript(
                            value=Name(id='scored', ctx=Load()),
                            slice=Constant(value=0),
                            ctx=Load()),
                          slice=Constant(value='total_score'),
                          ctx=Load()),
                        conversion=-1,
                        format_spec=JoinedStr(
                          values=[
                            Constant(value='.3f')])),
                      Constant(value=')')])])),
            Return(
              value=Name(id='scored', ctx=Load()))],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Subscript(
              value=Name(id='Dict', ctx=Load()),
              slice=Tuple(
                elts=[
                  Name(id='str', ctx=Load()),
                  Name(id='Any', ctx=Load())],
                ctx=Load()),
              ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='extract_keywords',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='text',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='top_n',
                annotation=Name(id='int', ctx=Load())),
              arg(
                arg='min_length',
                annotation=Name(id='int', ctx=Load()))],
            defaults=[
              Constant(value=10),
              Constant(value=4)]),
          body=[
            Expr(
              value=Constant(value='\n        Extract top keywords from text using TF-IDF\n        \n        Args:\n            text: Input text\n            top_n: Number of keywords to return\n            min_length: Minimum word length\n        \n        Returns:\n            List of keywords\n        ')),
            Assign(
              targets=[
                Name(id='words', ctx=Store())],
              value=ListComp(
                elt=Call(
                  func=Attribute(
                    value=Name(id='w', ctx=Load()),
                    attr='lower',
                    ctx=Load())),
                generators=[
                  comprehension(
                    target=Name(id='w', ctx=Store()),
                    iter=Call(
                      func=Attribute(
                        value=Name(id='text', ctx=Load()),
                        attr='split',
                        ctx=Load())),
                    ifs=[
                      BoolOp(
                        op=And(),
                        values=[
                          Compare(
                            left=Call(
                              func=Name(id='len', ctx=Load()),
                              args=[
                                Name(id='w', ctx=Load())]),
                            ops=[
                              GtE()],
                            comparators=[
                              Name(id='min_length', ctx=Load())]),
                          Compare(
                            left=Call(
                              func=Attribute(
                                value=Name(id='w', ctx=Load()),
                                attr='lower',
                                ctx=Load())),
                            ops=[
                              NotIn()],
                            comparators=[
                              Call(
                                func=Attribute(
                                  value=Name(id='self', ctx=Load()),
                                  attr='_get_stopwords',
                                  ctx=Load()))])])],
                    is_async=0)])),
            If(
              test=UnaryOp(
                op=Not(),
                operand=Name(id='words', ctx=Load())),
              body=[
                Return(
                  value=List(ctx=Load()))]),
            ImportFrom(
              module='collections',
              names=[
                alias(name='Counter')],
              level=0),
            Assign(
              targets=[
                Name(id='word_counts', ctx=Store())],
              value=Call(
                func=Name(id='Counter', ctx=Load()),
                args=[
                  Name(id='words', ctx=Load())])),
            Return(
              value=ListComp(
                elt=Name(id='word', ctx=Load()),
                generators=[
                  comprehension(
                    target=Tuple(
                      elts=[
                        Name(id='word', ctx=Store()),
                        Name(id='count', ctx=Store())],
                      ctx=Store()),
                    iter=Call(
                      func=Attribute(
                        value=Name(id='word_counts', ctx=Load()),
                        attr='most_common',
                        ctx=Load()),
                      args=[
                        Name(id='top_n', ctx=Load())]),
                    is_async=0)]))],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='calculate_overlap',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='text',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='keyword_set',
                annotation=Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Name(id='str', ctx=Load()),
                  ctx=Load())),
              arg(
                arg='min_word_length',
                annotation=Name(id='int', ctx=Load()))],
            defaults=[
              Constant(value=4)]),
          body=[
            Expr(
              value=Constant(value='\n        Calculate keyword overlap between text and keyword set\n        \n        Args:\n            text: Input text\n            keyword_set: List of keywords to check for\n            min_word_length: Minimum word length to consider\n        \n        Returns:\n            Dictionary with overlap statistics\n        ')),
            Assign(
              targets=[
                Name(id='text_words', ctx=Store())],
              value=Call(
                func=Name(id='set', ctx=Load()),
                args=[
                  GeneratorExp(
                    elt=Call(
                      func=Attribute(
                        value=Call(
                          func=Attribute(
                            value=Name(id='w', ctx=Load()),
                            attr='lower',
                            ctx=Load())),
                        attr='strip',
                        ctx=Load()),
                      args=[
                        Constant(value='.,!?;:')]),
                    generators=[
                      comprehension(
                        target=Name(id='w', ctx=Store()),
                        iter=Call(
                          func=Attribute(
                            value=Name(id='text', ctx=Load()),
                            attr='split',
                            ctx=Load())),
                        ifs=[
                          Compare(
                            left=Call(
                              func=Name(id='len', ctx=Load()),
                              args=[
                                Name(id='w', ctx=Load())]),
                            ops=[
                              GtE()],
                            comparators=[
                              Name(id='min_word_length', ctx=Load())])],
                        is_async=0)])])),
            Assign(
              targets=[
                Name(id='keywords', ctx=Store())],
              value=Call(
                func=Name(id='set', ctx=Load()),
                args=[
                  GeneratorExp(
                    elt=Call(
                      func=Attribute(
                        value=Name(id='kw', ctx=Load()),
                        attr='lower',
                        ctx=Load())),
                    generators=[
                      comprehension(
                        target=Name(id='kw', ctx=Store()),
                        iter=Name(id='keyword_set', ctx=Load()),
                        is_async=0)])])),
            Assign(
              targets=[
                Name(id='overlap', ctx=Store())],
              value=BinOp(
                left=Name(id='text_words', ctx=Load()),
                op=BitAnd(),
                right=Name(id='keywords', ctx=Load()))),
            Assign(
              targets=[
                Name(id='overlap_ratio', ctx=Store())],
              value=IfExp(
                test=Name(id='keywords', ctx=Load()),
                body=BinOp(
                  left=Call(
                    func=Name(id='len', ctx=Load()),
                    args=[
                      Name(id='overlap', ctx=Load())]),
                  op=Div(),
                  right=Call(
                    func=Name(id='len', ctx=Load()),
                    args=[
                      Name(id='keywords', ctx=Load())])),
                orelse=Constant(value=0.0))),
