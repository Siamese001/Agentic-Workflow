                  optional_vars=Name(id='f', ctx=Store()))],
              body=[
                For(
                  target=Name(id='chunk', ctx=Store()),
                  iter=Call(
                    func=Name(id='iter', ctx=Load()),
                    args=[
                      Lambda(
                        args=arguments(),
                        body=Call(
                          func=Attribute(
                            value=Name(id='f', ctx=Load()),
                            attr='read',
                            ctx=Load()),
                          args=[
                            Constant(value=4096)])),
                      Constant(value=b'')]),
                  body=[
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Name(id='sha256', ctx=Load()),
                          attr='update',
                          ctx=Load()),
                        args=[
                          Name(id='chunk', ctx=Load())]))])]),
            Return(
              value=Call(
                func=Attribute(
                  value=Name(id='sha256', ctx=Load()),
                  attr='hexdigest',
                  ctx=Load())))],
