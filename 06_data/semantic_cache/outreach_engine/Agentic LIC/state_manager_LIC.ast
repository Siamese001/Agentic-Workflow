Module(
  body=[
    Assign(
      targets=[
        Name(id='__version__', ctx=Store())],
      value=Constant(value='13.0')),
    Import(
      names=[
        alias(name='json')]),
    Import(
      names=[
        alias(name='os')]),
    Import(
      names=[
        alias(name='hashlib')]),
    ImportFrom(
      module='pathlib',
      names=[
        alias(name='Path')],
      level=0),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Dict'),
        alias(name='List'),
        alias(name='Any'),
        alias(name='Optional')],
      level=0),
    ImportFrom(
      module='datetime',
      names=[
        alias(name='datetime')],
      level=0),
    Import(
      names=[
        alias(name='shutil')]),
    ClassDef(
      name='StateManager',
      body=[
        Expr(
          value=Constant(value='\n    v13.0: Explicit state management for HOP architecture\n    \n    Each HOP (single-responsibility agent) reads from and writes to the\n    state/ directory. This creates an auditable trail and enables:\n    - Debugging: Inspect state at any HOP\n    - Resumability: Re-run from any HOP\n    - Auditability: Complete record of workflow decisions\n    ')),
        FunctionDef(
          name='__init__',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='mission_id',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='state_directory',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='create_if_missing',
                annotation=Name(id='bool', ctx=Load()))],
            defaults=[
              Constant(value='state'),
              Constant(value=True)]),
          body=[
            Expr(
              value=Constant(value="\n        Initialize state manager for a mission\n        \n        Args:\n            mission_id: Unique mission identifier\n            state_directory: Base directory for state files\n            create_if_missing: Create directory if it doesn't exist\n        ")),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='mission_id',
                  ctx=Store())],
              value=Name(id='mission_id', ctx=Load())),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='base_dir',
                  ctx=Store())],
              value=Call(
                func=Name(id='Path', ctx=Load()),
                args=[
                  Name(id='state_directory', ctx=Load())])),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='mission_dir',
                  ctx=Store())],
              value=BinOp(
                left=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='base_dir',
                  ctx=Load()),
                op=Div(),
                right=Name(id='mission_id', ctx=Load()))),
            If(
              test=Name(id='create_if_missing', ctx=Load()),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='mission_dir',
                        ctx=Load()),
                      attr='mkdir',
                      ctx=Load()),
                    keywords=[
                      keyword(
                        arg='parents',
                        value=Constant(value=True)),
                      keyword(
                        arg='exist_ok',
                        value=Constant(value=True))]))]),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='[StateManager] Initialized for mission: '),
                      FormattedValue(
                        value=Name(id='mission_id', ctx=Load()),
                        conversion=-1)])])),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='[StateManager] State directory: '),
                      FormattedValue(
                        value=Attribute(
                          value=Name(id='self', ctx=Load()),
                          attr='mission_dir',
                          ctx=Load()),
                        conversion=-1)])]))]),
        FunctionDef(
          name='write_state',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='hop_id',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='data',
                annotation=Subscript(
                  value=Name(id='Dict', ctx=Load()),
                  slice=Tuple(
                    elts=[
                      Name(id='str', ctx=Load()),
                      Name(id='Any', ctx=Load())],
                    ctx=Load()),
                  ctx=Load())),
              arg(
                arg='atomic',
                annotation=Name(id='bool', ctx=Load()))],
            defaults=[
              Constant(value=True)]),
          body=[
            Expr(
              value=Constant(value='\n        Write state file for a HOP\n        \n        Args:\n            hop_id: HOP identifier (e.g., "HOP-1", "1_profile_analysis")\n            data: State data to write\n            atomic: Use atomic write (write to temp file, then rename)\n        \n        Returns:\n            Path to written file\n        ')),
            Assign(
              targets=[
                Name(id='filename', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='_sanitize_filename',
                  ctx=Load()),
                args=[
                  Name(id='hop_id', ctx=Load())])),
            If(
              test=UnaryOp(
                op=Not(),
                operand=Call(
                  func=Attribute(
                    value=Name(id='filename', ctx=Load()),
                    attr='endswith',
                    ctx=Load()),
                  args=[
                    Constant(value='.json')])),
              body=[
                AugAssign(
                  target=Name(id='filename', ctx=Store()),
                  op=Add(),
                  value=Constant(value='.json'))]),
            Assign(
              targets=[
                Name(id='filepath', ctx=Store())],
              value=BinOp(
                left=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='mission_dir',
                  ctx=Load()),
                op=Div(),
                right=Name(id='filename', ctx=Load()))),
            Assign(
              targets=[
                Name(id='data_with_metadata', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='hop_id'),
                  Constant(value='mission_id'),
                  Constant(value='timestamp'),
                  Constant(value='schema_version'),
                  None],
                values=[
                  Name(id='hop_id', ctx=Load()),
                  Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='mission_id',
                    ctx=Load()),
                  Call(
                    func=Attribute(
                      value=Call(
                        func=Attribute(
                          value=Name(id='datetime', ctx=Load()),
                          attr='now',
                          ctx=Load())),
                      attr='isoformat',
                      ctx=Load())),
                  Constant(value='13.0'),
                  Name(id='data', ctx=Load())])),
            If(
              test=Name(id='atomic', ctx=Load()),
              body=[
                Assign(
                  targets=[
                    Name(id='temp_filepath', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='filepath', ctx=Load()),
                      attr='with_suffix',
                      ctx=Load()),
                    args=[
                      Constant(value='.tmp')])),
                With(
                  items=[
                    withitem(
                      context_expr=Call(
                        func=Name(id='open', ctx=Load()),
                        args=[
                          Name(id='temp_filepath', ctx=Load()),
                          Constant(value='w')]),
                      optional_vars=Name(id='f', ctx=Store()))],
                  body=[
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Name(id='json', ctx=Load()),
                          attr='dump',
                          ctx=Load()),
                        args=[
                          Name(id='data_with_metadata', ctx=Load()),
                          Name(id='f', ctx=Load())],
                        keywords=[
                          keyword(
                            arg='indent',
                            value=Constant(value=2)),
                          keyword(
                            arg='default',
                            value=Name(id='str', ctx=Load()))]))]),
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='temp_filepath', ctx=Load()),
                      attr='replace',
                      ctx=Load()),
                    args=[
                      Name(id='filepath', ctx=Load())]))],
              orelse=[
                With(
                  items=[
                    withitem(
                      context_expr=Call(
                        func=Name(id='open', ctx=Load()),
                        args=[
                          Name(id='filepath', ctx=Load()),
                          Constant(value='w')]),
                      optional_vars=Name(id='f', ctx=Store()))],
                  body=[
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Name(id='json', ctx=Load()),
                          attr='dump',
                          ctx=Load()),
                        args=[
                          Name(id='data_with_metadata', ctx=Load()),
                          Name(id='f', ctx=Load())],
                        keywords=[
                          keyword(
                            arg='indent',
                            value=Constant(value=2)),
                          keyword(
                            arg='default',
                            value=Name(id='str', ctx=Load()))]))])]),
            Assign(
              targets=[
                Name(id='checksum', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='_calculate_checksum',
                  ctx=Load()),
                args=[
                  Name(id='filepath', ctx=Load())])),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='[StateManager] Wrote state: '),
                      FormattedValue(
                        value=Name(id='filename', ctx=Load()),
                        conversion=-1),
                      Constant(value=' (checksum: '),
                      FormattedValue(
                        value=Subscript(
                          value=Name(id='checksum', ctx=Load()),
                          slice=Slice(
                            upper=Constant(value=8)),
                          ctx=Load()),
                        conversion=-1),
                      Constant(value='...)')])])),
            Return(
              value=Call(
                func=Name(id='str', ctx=Load()),
                args=[
                  Name(id='filepath', ctx=Load())]))],
          returns=Name(id='str', ctx=Load())),
        FunctionDef(
          name='read_state',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='hop_id',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='validate_checksum',
                annotation=Name(id='bool', ctx=Load()))],
            defaults=[
              Constant(value=False)]),
          body=[
            Expr(
              value=Constant(value="\n        Read state file for a HOP\n        \n        Args:\n            hop_id: HOP identifier\n            validate_checksum: Verify file integrity\n        \n        Returns:\n            State data dictionary\n        \n        Raises:\n            FileNotFoundError: If state file doesn't exist\n            ValueError: If checksum validation fails\n        ")),
            Assign(
              targets=[
                Name(id='filename', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='_sanitize_filename',
                  ctx=Load()),
                args=[
                  Name(id='hop_id', ctx=Load())])),
            If(
              test=UnaryOp(
                op=Not(),
                operand=Call(
                  func=Attribute(
                    value=Name(id='filename', ctx=Load()),
                    attr='endswith',
                    ctx=Load()),
                  args=[
                    Constant(value='.json')])),
              body=[
                AugAssign(
                  target=Name(id='filename', ctx=Store()),
                  op=Add(),
                  value=Constant(value='.json'))]),
            Assign(
              targets=[
                Name(id='filepath', ctx=Store())],
              value=BinOp(
                left=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='mission_dir',
                  ctx=Load()),
                op=Div(),
                right=Name(id='filename', ctx=Load()))),
            If(
              test=UnaryOp(
                op=Not(),
                operand=Call(
                  func=Attribute(
                    value=Name(id='filepath', ctx=Load()),
                    attr='exists',
                    ctx=Load()))),
              body=[
                Raise(
                  exc=Call(
                    func=Name(id='FileNotFoundError', ctx=Load()),
                    args=[
                      JoinedStr(
                        values=[
                          Constant(value='State file not found: '),
                          FormattedValue(
                            value=Name(id='filepath', ctx=Load()),
                            conversion=-1)])]))]),
            If(
              test=Name(id='validate_checksum', ctx=Load()),
              body=[
                Assign(
                  targets=[
                    Name(id='stored_checksum', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='_get_stored_checksum',
                      ctx=Load()),
                    args=[
                      Name(id='hop_id', ctx=Load())])),
                Assign(
                  targets=[
                    Name(id='current_checksum', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='_calculate_checksum',
                      ctx=Load()),
                    args=[
                      Name(id='filepath', ctx=Load())])),
                If(
                  test=BoolOp(
                    op=And(),
                    values=[
                      Name(id='stored_checksum', ctx=Load()),
                      Compare(
                        left=Name(id='stored_checksum', ctx=Load()),
                        ops=[
                          NotEq()],
                        comparators=[
                          Name(id='current_checksum', ctx=Load())])]),
                  body=[
                    Raise(
                      exc=Call(
                        func=Name(id='ValueError', ctx=Load()),
                        args=[
                          JoinedStr(
                            values=[
                              Constant(value='Checksum mismatch for '),
                              FormattedValue(
                                value=Name(id='filename', ctx=Load()),
                                conversion=-1),
                              Constant(value=': file may be corrupted')])]))])]),
            With(
              items=[
                withitem(
                  context_expr=Call(
                    func=Name(id='open', ctx=Load()),
                    args=[
                      Name(id='filepath', ctx=Load()),
                      Constant(value='r')]),
                  optional_vars=Name(id='f', ctx=Store()))],
              body=[
                Assign(
                  targets=[
                    Name(id='data', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='json', ctx=Load()),
                      attr='load',
                      ctx=Load()),
                    args=[
                      Name(id='f', ctx=Load())]))]),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='[StateManager] Read state: '),
                      FormattedValue(
                        value=Name(id='filename', ctx=Load()),
                        conversion=-1)])])),
            Return(
              value=Name(id='data', ctx=Load()))],
          returns=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='Any', ctx=Load())],
              ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='state_exists',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='hop_id',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Check if state file exists for a HOP\n        \n        Args:\n            hop_id: HOP identifier\n        \n        Returns:\n            True if state file exists\n        ')),
            Assign(
              targets=[
                Name(id='filename', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='_sanitize_filename',
                  ctx=Load()),
                args=[
                  Name(id='hop_id', ctx=Load())])),
            If(
              test=UnaryOp(
                op=Not(),
                operand=Call(
                  func=Attribute(
                    value=Name(id='filename', ctx=Load()),
                    attr='endswith',
                    ctx=Load()),
                  args=[
                    Constant(value='.json')])),
              body=[
                AugAssign(
                  target=Name(id='filename', ctx=Store()),
                  op=Add(),
                  value=Constant(value='.json'))]),
            Assign(
              targets=[
                Name(id='filepath', ctx=Store())],
              value=BinOp(
                left=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='mission_dir',
                  ctx=Load()),
                op=Div(),
                right=Name(id='filename', ctx=Load()))),
            Return(
              value=Call(
                func=Attribute(
                  value=Name(id='filepath', ctx=Load()),
                  attr='exists',
                  ctx=Load())))],
          returns=Name(id='bool', ctx=Load())),
        FunctionDef(
          name='list_states',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='\n        List all state files for this mission\n        \n        Returns:\n            List of state file names\n        ')),
            If(
              test=UnaryOp(
                op=Not(),
                operand=Call(
                  func=Attribute(
                    value=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='mission_dir',
                      ctx=Load()),
                    attr='exists',
                    ctx=Load()))),
              body=[
                Return(
                  value=List(ctx=Load()))]),
            Assign(
              targets=[
                Name(id='state_files', ctx=Store())],
              value=Call(
                func=Name(id='sorted', ctx=Load()),
                args=[
                  ListComp(
                    elt=Attribute(
                      value=Name(id='f', ctx=Load()),
                      attr='name',
                      ctx=Load()),
                    generators=[
                      comprehension(
                        target=Name(id='f', ctx=Store()),
                        iter=Call(
                          func=Attribute(
                            value=Attribute(
                              value=Name(id='self', ctx=Load()),
                              attr='mission_dir',
                              ctx=Load()),
                            attr='iterdir',
                            ctx=Load())),
                        ifs=[
                          BoolOp(
                            op=And(),
                            values=[
                              Call(
                                func=Attribute(
                                  value=Name(id='f', ctx=Load()),
                                  attr='is_file',
                                  ctx=Load())),
                              Compare(
                                left=Attribute(
                                  value=Name(id='f', ctx=Load()),
                                  attr='suffix',
                                  ctx=Load()),
                                ops=[
                                  Eq()],
                                comparators=[
                                  Constant(value='.json')])])],
                        is_async=0)])])),
            Return(
              value=Name(id='state_files', ctx=Load()))],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='get_workflow_progress',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='\n        Get workflow progress summary\n        \n        Returns:\n            Dictionary with progress information\n        ')),
            Assign(
              targets=[
                Name(id='states', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='list_states',
                  ctx=Load()))),
            Assign(
              targets=[
                Name(id='completed_hops', ctx=Store())],
              value=List(ctx=Load())),
            For(
              target=Name(id='state_file', ctx=Store()),
              iter=Name(id='states', ctx=Load()),
              body=[
                Assign(
                  targets=[
                    Name(id='parts', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Call(
                        func=Attribute(
                          value=Name(id='state_file', ctx=Load()),
                          attr='replace',
                          ctx=Load()),
                        args=[
                          Constant(value='.json'),
                          Constant(value='')]),
                      attr='split',
                      ctx=Load()),
                    args=[
                      Constant(value='_')])),
                If(
                  test=Call(
                    func=Attribute(
                      value=Call(
                        func=Attribute(
                          value=Subscript(
                            value=Name(id='parts', ctx=Load()),
                            slice=Constant(value=0),
                            ctx=Load()),
                          attr='replace',
                          ctx=Load()),
                        args=[
                          Constant(value='.'),
                          Constant(value='')]),
                      attr='isdigit',
                      ctx=Load())),
                  body=[
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Name(id='completed_hops', ctx=Load()),
                          attr='append',
                          ctx=Load()),
                        args=[
                          Subscript(
                            value=Name(id='parts', ctx=Load()),
                            slice=Constant(value=0),
                            ctx=Load())]))])]),
            Return(
              value=Dict(
                keys=[
                  Constant(value='mission_id'),
                  Constant(value='total_states'),
                  Constant(value='completed_hops'),
                  Constant(value='state_files')],
                values=[
                  Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='mission_id',
                    ctx=Load()),
                  Call(
                    func=Name(id='len', ctx=Load()),
                    args=[
                      Name(id='states', ctx=Load())]),
                  Call(
                    func=Name(id='sorted', ctx=Load()),
                    args=[
                      Name(id='completed_hops', ctx=Load())]),
                  Name(id='states', ctx=Load())]))],
          returns=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='Any', ctx=Load())],
              ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='create_checkpoint',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='checkpoint_name',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Create a checkpoint of all current state files\n        \n        Args:\n            checkpoint_name: Name for the checkpoint\n        \n        Returns:\n            Path to checkpoint directory\n        ')),
            Assign(
              targets=[
                Name(id='checkpoint_dir', ctx=Store())],
              value=BinOp(
                left=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='mission_dir',
                  ctx=Load()),
                op=Div(),
                right=JoinedStr(
                  values=[
                    Constant(value='checkpoint_'),
                    FormattedValue(
                      value=Name(id='checkpoint_name', ctx=Load()),
                      conversion=-1)]))),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='checkpoint_dir', ctx=Load()),
                  attr='mkdir',
                  ctx=Load()),
                keywords=[
                  keyword(
                    arg='exist_ok',
                    value=Constant(value=True))])),
            For(
              target=Name(id='state_file', ctx=Store()),
              iter=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='list_states',
                  ctx=Load())),
              body=[
                Assign(
                  targets=[
                    Name(id='src', ctx=Store())],
                  value=BinOp(
                    left=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='mission_dir',
                      ctx=Load()),
                    op=Div(),
                    right=Name(id='state_file', ctx=Load()))),
                Assign(
                  targets=[
                    Name(id='dst', ctx=Store())],
                  value=BinOp(
                    left=Name(id='checkpoint_dir', ctx=Load()),
                    op=Div(),
                    right=Name(id='state_file', ctx=Load()))),
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='shutil', ctx=Load()),
                      attr='copy2',
                      ctx=Load()),
                    args=[
                      Name(id='src', ctx=Load()),
                      Name(id='dst', ctx=Load())]))]),
            Assign(
              targets=[
                Name(id='metadata', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='checkpoint_name'),
                  Constant(value='created_at'),
                  Constant(value='mission_id'),
                  Constant(value='state_files')],
                values=[
                  Name(id='checkpoint_name', ctx=Load()),
                  Call(
                    func=Attribute(
                      value=Call(
                        func=Attribute(
                          value=Name(id='datetime', ctx=Load()),
                          attr='now',
                          ctx=Load())),
                      attr='isoformat',
                      ctx=Load())),
                  Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='mission_id',
                    ctx=Load()),
                  Call(
                    func=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='list_states',
                      ctx=Load()))])),
            With(
              items=[
                withitem(
                  context_expr=Call(
                    func=Name(id='open', ctx=Load()),
                    args=[
                      BinOp(
                        left=Name(id='checkpoint_dir', ctx=Load()),
                        op=Div(),
                        right=Constant(value='checkpoint_metadata.json')),
                      Constant(value='w')]),
                  optional_vars=Name(id='f', ctx=Store()))],
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='json', ctx=Load()),
                      attr='dump',
                      ctx=Load()),
                    args=[
                      Name(id='metadata', ctx=Load()),
                      Name(id='f', ctx=Load())],
                    keywords=[
                      keyword(
                        arg='indent',
                        value=Constant(value=2))]))]),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='[StateManager] Created checkpoint: '),
                      FormattedValue(
                        value=Name(id='checkpoint_name', ctx=Load()),
                        conversion=-1)])])),
            Return(
              value=Call(
                func=Name(id='str', ctx=Load()),
                args=[
                  Name(id='checkpoint_dir', ctx=Load())]))],
          returns=Name(id='str', ctx=Load())),
        FunctionDef(
          name='restore_checkpoint',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='checkpoint_name',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
