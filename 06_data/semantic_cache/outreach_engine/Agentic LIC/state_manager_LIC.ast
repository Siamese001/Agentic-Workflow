          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='filepath',
                annotation=Name(id='Path', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Calculate SHA256 checksum of a file\n        \n        Args:\n            filepath: Path to file\n        \n        Returns:\n            Hexadecimal checksum string\n        ')),
            Assign(
              targets=[
                Name(id='sha256', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='hashlib', ctx=Load()),
