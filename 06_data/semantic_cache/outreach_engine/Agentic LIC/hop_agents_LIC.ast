    ClassDef(
      name='HOP7_GateDecisionAgent',
      body=[
        Expr(
          value=Constant(value='\n    v13.0: HOP-7 - Gate Decision Agent (NEW - extracted from GenerationOrchestrator)\n    \n    Single Responsibility: Make the "Slow Loop" decision\n    \n    Input:  state/6_validation_report.json\n    Output: state/7_gate_decision.json\n    \n    Decision Logic:\n    - FACTUAL_FAILURE: raise FactualGapError → trigger S6->S2 meta-loop\n    - CREATIVE_FAILURE: raise CreativeFailureError → HALT workflow\n    - PASS: return True → proceed to output\n    ')),
        FunctionDef(
          name='__init__',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='config',
                annotation=Subscript(
                  value=Name(id='Dict', ctx=Load()),
                  slice=Tuple(
                    elts=[
                      Name(id='str', ctx=Load()),
                      Name(id='Any', ctx=Load())],
                    ctx=Load()),
                  ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Initialize with externalized configuration\n        \n        Args:\n            config: Loaded from config/agent_specs_LIC.json\n        ')),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='config',
                  ctx=Store())],
              value=Subscript(
                value=Name(id='config', ctx=Load()),
                slice=Constant(value='gate_decision_agent'),
                ctx=Load())),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='factual_failure_rules',
                  ctx=Store())],
              value=Call(
                func=Name(id='set', ctx=Load()),
                args=[
                  Subscript(
                    value=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='config',
                      ctx=Load()),
                    slice=Constant(value='factual_failure_rules'),
                    ctx=Load())])),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='max_factual_loops',
                  ctx=Store())],
              value=Subscript(
                value=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='config',
                  ctx=Load()),
                slice=Constant(value='max_factual_loops'),
                ctx=Load())),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='max_creative_retries',
                  ctx=Store())],
              value=Subscript(
                value=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='config',
                  ctx=Load()),
                slice=Constant(value='max_creative_retries'),
                ctx=Load())),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='factual_loop_count',
                  ctx=Store())],
              value=Constant(value=0)),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='creative_retry_count',
                  ctx=Store())],
              value=Constant(value=0))]),
        FunctionDef(
          name='execute',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='state_mgr',
                annotation=Name(id='StateManager', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Execute HOP-7: Make gate decision based on validation results\n        \n        Args:\n            state_mgr: State manager for this mission\n        \n        Returns:\n            Path to output state file\n        \n        Raises:\n            FactualGapError: If factual failure detected (triggers S6->S2 loop)\n            ValueError: If creative failure detected (halts workflow)\n        ')),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='\n'),
                      FormattedValue(
                        value=BinOp(
                          left=Constant(value='='),
                          op=Mult(),
                          right=Constant(value=80)),
                        conversion=-1)])])),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  Constant(value='HOP-7: GATE DECISION')])),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      FormattedValue(
                        value=BinOp(
                          left=Constant(value='='),
                          op=Mult(),
                          right=Constant(value=80)),
                        conversion=-1),
                      Constant(value='\n')])])),
            Assign(
              targets=[
                Name(id='validation_state', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='state_mgr', ctx=Load()),
                  attr='read_state',
                  ctx=Load()),
                args=[
                  Constant(value='HOP-6')])),
            Assign(
              targets=[
                Name(id='validation_results', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='validation_state', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='validation_results'),
                  List(ctx=Load())])),
            Assign(
              targets=[
                Name(id='passed', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='validation_state', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='passed'),
                  Constant(value=False)])),
            If(
              test=Name(id='passed', ctx=Load()),
              body=[
                Assign(
                  targets=[
                    Name(id='decision', ctx=Store())],
                  value=Constant(value='PASS')),
                Assign(
                  targets=[
                    Name(id='reasoning', ctx=Store())],
                  value=Constant(value='All validation checks passed')),
                Assign(
                  targets=[
                    Name(id='output_state', ctx=Store())],
                  value=Dict(
                    keys=[
                      Constant(value='decision'),
                      Constant(value='reasoning'),
                      Constant(value='factual_loop_count'),
                      Constant(value='creative_retry_count')],
                    values=[
                      Name(id='decision', ctx=Load()),
                      Name(id='reasoning', ctx=Load()),
                      Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='factual_loop_count',
                        ctx=Load()),
                      Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='creative_retry_count',
                        ctx=Load())])),
                Assign(
                  targets=[
                    Name(id='output_path', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='state_mgr', ctx=Load()),
                      attr='write_state',
                      ctx=Load()),
                    args=[
                      Constant(value='HOP-7'),
                      Name(id='output_state', ctx=Load())])),
                Expr(
                  value=Call(
                    func=Name(id='print', ctx=Load()),
                    args=[
                      JoinedStr(
                        values=[
                          Constant(value='✓ Gate Decision: PASS')])])),
                Expr(
                  value=Call(
                    func=Name(id='print', ctx=Load()),
                    args=[
                      JoinedStr(
                        values=[
                          Constant(value='  All validations passed\n')])])),
                Return(
                  value=Name(id='output_path', ctx=Load()))]),
            Assign(
              targets=[
                Name(id='critical_failures', ctx=Store())],
              value=ListComp(
                elt=Name(id='r', ctx=Load()),
                generators=[
                  comprehension(
                    target=Name(id='r', ctx=Store()),
                    iter=Name(id='validation_results', ctx=Load()),
                    ifs=[
                      BoolOp(
                        op=And(),
                        values=[
                          Compare(
                            left=Call(
                              func=Attribute(
                                value=Name(id='r', ctx=Load()),
                                attr='get',
                                ctx=Load()),
                              args=[
                                Constant(value='severity')]),
                            ops=[
                              In()],
                            comparators=[
                              List(
                                elts=[
                                  Constant(value='CRITICAL'),
                                  Constant(value='HIGH')],
                                ctx=Load())]),
                          UnaryOp(
                            op=Not(),
                            operand=Call(
                              func=Attribute(
                                value=Name(id='r', ctx=Load()),
                                attr='get',
                                ctx=Load()),
                              args=[
                                Constant(value='passed'),
                                Constant(value=True)]))])],
                    is_async=0)])),
            If(
              test=UnaryOp(
                op=Not(),
                operand=Name(id='critical_failures', ctx=Load())),
              body=[
                Assign(
                  targets=[
                    Name(id='decision', ctx=Store())],
                  value=Constant(value='PASS')),
                Assign(
                  targets=[
                    Name(id='reasoning', ctx=Store())],
                  value=Constant(value='No critical failures detected')),
                Assign(
                  targets=[
                    Name(id='output_state', ctx=Store())],
                  value=Dict(
                    keys=[
                      Constant(value='decision'),
                      Constant(value='reasoning'),
                      Constant(value='factual_loop_count'),
                      Constant(value='creative_retry_count')],
                    values=[
                      Name(id='decision', ctx=Load()),
                      Name(id='reasoning', ctx=Load()),
                      Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='factual_loop_count',
                        ctx=Load()),
                      Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='creative_retry_count',
                        ctx=Load())])),
                Assign(
                  targets=[
                    Name(id='output_path', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='state_mgr', ctx=Load()),
                      attr='write_state',
                      ctx=Load()),
                    args=[
                      Constant(value='HOP-7'),
                      Name(id='output_state', ctx=Load())])),
                Expr(
                  value=Call(
                    func=Name(id='print', ctx=Load()),
                    args=[
                      JoinedStr(
                        values=[
                          Constant(value='✓ Gate Decision: PASS (non-critical issues only)')])])),
                Return(
                  value=Name(id='output_path', ctx=Load()))]),
            Assign(
              targets=[
                Tuple(
                  elts=[
                    Name(id='failure_type', ctx=Store()),
                    Name(id='failure_message', ctx=Store())],
                  ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='_classify_failure',
                  ctx=Load()),
                args=[
                  Name(id='critical_failures', ctx=Load())])),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='  Failure Type: '),
                      FormattedValue(
                        value=Name(id='failure_type', ctx=Load()),
                        conversion=-1)])])),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='  Reason: '),
                      FormattedValue(
                        value=Name(id='failure_message', ctx=Load()),
                        conversion=-1),
