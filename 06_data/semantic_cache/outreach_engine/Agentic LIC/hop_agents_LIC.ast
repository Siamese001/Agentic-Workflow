                    ops=[
                      In()],
                    comparators=[
                      Name(id='conditions', ctx=Load())]),
                  body=[
                    If(
                      test=Compare(
                        left=Name(id='prior_message_count', ctx=Load()),
                        ops=[
                          Lt()],
                        comparators=[
                          Subscript(
                            value=Name(id='conditions', ctx=Load()),
                            slice=Constant(value='prior_message_count_gte'),
                            ctx=Load())]),
                      body=[
                        Assign(
                          targets=[
                            Name(id='matches', ctx=Store())],
                          value=Constant(value=False))])]),
                If(
                  test=Compare(
                    left=Constant(value='prior_message_count_gt'),
                    ops=[
                      In()],
                    comparators=[
                      Name(id='conditions', ctx=Load())]),
                  body=[
                    If(
                      test=Compare(
                        left=Name(id='prior_message_count', ctx=Load()),
                        ops=[
                          LtE()],
                        comparators=[
                          Subscript(
                            value=Name(id='conditions', ctx=Load()),
                            slice=Constant(value='prior_message_count_gt'),
                            ctx=Load())]),
                      body=[
                        Assign(
                          targets=[
                            Name(id='matches', ctx=Store())],
                          value=Constant(value=False))])]),
                If(
                  test=Name(id='matches', ctx=Load()),
                  body=[
                    Assign(
                      targets=[
                        Name(id='selected_route', ctx=Store())],
                      value=Name(id='route_name', ctx=Load())),
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Name(id='reasoning', ctx=Load()),
