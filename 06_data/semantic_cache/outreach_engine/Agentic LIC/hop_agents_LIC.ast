                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Name(id='reasoning', ctx=Load()),
                          attr='append',
                          ctx=Load()),
                        args=[
                          JoinedStr(
                            values=[
                              Constant(value='  - Connection status: '),
                              FormattedValue(
                                value=Name(id='connection_status', ctx=Load()),
                                conversion=-1)])])),
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Name(id='reasoning', ctx=Load()),
                          attr='append',
                          ctx=Load()),
                        args=[
                          JoinedStr(
                            values=[
                              Constant(value='  - Prior messages: '),
                              FormattedValue(
                                value=Name(id='prior_message_count', ctx=Load()),
                                conversion=-1)])])),
                    Break()])]),
            If(
              test=UnaryOp(
                op=Not(),
                operand=Name(id='selected_route', ctx=Load())),
              body=[
                Assign(
                  targets=[
                    Name(id='selected_route', ctx=Store())],
                  value=Constant(value='INMAIL')),
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='reasoning', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Constant(value='Default route: INMAIL')]))]),
            Assign(
              targets=[
                Name(id='constraints', ctx=Store())],
              value=Subscript(
                value=Subscript(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='routing_rules',
                    ctx=Load()),
                  slice=Name(id='selected_route', ctx=Load()),
                  ctx=Load()),
                slice=Constant(value='constraints'),
                ctx=Load())),
            Assign(
              targets=[
                Name(id='output_state', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='route'),
                  Constant(value='archetype'),
                  Constant(value='constraints'),
                  Constant(value='reasoning'),
                  Constant(value='connection_status'),
                  Constant(value='prior_message_count')],
                values=[
                  Name(id='selected_route', ctx=Load()),
                  Name(id='archetype', ctx=Load()),
                  Name(id='constraints', ctx=Load()),
                  Call(
                    func=Attribute(
                      value=Constant(value='\n'),
                      attr='join',
                      ctx=Load()),
                    args=[
                      Name(id='reasoning', ctx=Load())]),
                  Name(id='connection_status', ctx=Load()),
                  Name(id='prior_message_count', ctx=Load())])),
            Assign(
              targets=[
