        alias(name='CodeInterpreterTool'),
        alias(name='ValidationToolkit')],
      level=0),
    ClassDef(
      name='HOP1_ProfileAnalysisAgent',
      body=[
        Expr(
          value=Constant(value='\n    v13.0: HOP-1 - Profile Analysis with state-based I/O\n    \n    Single Responsibility: Classify recipient archetype\n    \n    Input:  mission_input_LIC.json\n    Output: state/1_profile_analysis.json\n    ')),
        FunctionDef(
          name='__init__',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='config',
                annotation=Subscript(
                  value=Name(id='Dict', ctx=Load()),
                  slice=Tuple(
                    elts=[
                      Name(id='str', ctx=Load()),
                      Name(id='Any', ctx=Load())],
                    ctx=Load()),
                  ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Initialize with externalized configuration\n        \n        Args:\n            config: Loaded from config/agent_specs_LIC.json\n        ')),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='config',
                  ctx=Store())],
              value=Subscript(
                value=Name(id='config', ctx=Load()),
                slice=Constant(value='profile_analysis_agent'),
                ctx=Load())),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='archetype_indicators',
                  ctx=Store())],
              value=Subscript(
                value=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='config',
                  ctx=Load()),
                slice=Constant(value='archetype_indicators'),
                ctx=Load())),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='default_archetype',
                  ctx=Store())],
              value=Subscript(
                value=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='config',
                  ctx=Load()),
                slice=Constant(value='default_archetype'),
                ctx=Load())),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='manual_override_threshold',
                  ctx=Store())],
              value=Subscript(
                value=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='config',
                  ctx=Load()),
                slice=Constant(value='manual_override_threshold'),
                ctx=Load()))]),
        FunctionDef(
          name='execute',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='state_mgr',
                annotation=Name(id='StateManager', ctx=Load())),
              arg(
                arg='mission',
                annotation=Name(id='OutreachMission', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Execute HOP-1: Analyze profile and classify archetype\n        \n        Args:\n            state_mgr: State manager for this mission\n            mission: Mission specification\n        \n        Returns:\n            Path to output state file\n        ')),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='\n'),
                      FormattedValue(
                        value=BinOp(
                          left=Constant(value='='),
                          op=Mult(),
                          right=Constant(value=80)),
                        conversion=-1)])])),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  Constant(value='HOP-1: PROFILE ANALYSIS')])),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      FormattedValue(
                        value=BinOp(
                          left=Constant(value='='),
                          op=Mult(),
                          right=Constant(value=80)),
                        conversion=-1),
                      Constant(value='\n')])])),
            Assign(
              targets=[
                Name(id='title', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='mission', ctx=Load()),
                        attr='recipient_profile',
                        ctx=Load()),
                      attr='get',
                      ctx=Load()),
                    args=[
                      Constant(value='title'),
                      Constant(value='')]),
                  attr='lower',
                  ctx=Load()))),
            Assign(
              targets=[
                Name(id='archetype', ctx=Store())],
              value=Constant(value=None)),
            Assign(
              targets=[
                Name(id='confidence', ctx=Store())],
              value=Constant(value=0.0)),
            Assign(
              targets=[
                Name(id='reasoning', ctx=Store())],
              value=Constant(value='')),
            Assign(
              targets=[
                Name(id='key_indicators', ctx=Store())],
              value=List(ctx=Load())),
            For(
              target=Tuple(
                elts=[
                  Name(id='arch_name', ctx=Store()),
                  Name(id='arch_config', ctx=Store())],
                ctx=Store()),
              iter=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='archetype_indicators',
                    ctx=Load()),
                  attr='items',
                  ctx=Load())),
              body=[
                For(
                  target=Name(id='keyword', ctx=Store()),
                  iter=Subscript(
                    value=Name(id='arch_config', ctx=Load()),
                    slice=Constant(value='keywords'),
                    ctx=Load()),
                  body=[
                    If(
                      test=Compare(
                        left=Name(id='keyword', ctx=Load()),
                        ops=[
                          In()],
                        comparators=[
                          Name(id='title', ctx=Load())]),
                      body=[
                        Assign(
                          targets=[
                            Name(id='archetype', ctx=Store())],
                          value=Name(id='arch_name', ctx=Load())),
                        Assign(
                          targets=[
                            Name(id='confidence', ctx=Store())],
                          value=Subscript(
                            value=Name(id='arch_config', ctx=Load()),
                            slice=Constant(value='confidence'),
                            ctx=Load())),
                        Assign(
                          targets=[
                            Name(id='reasoning', ctx=Store())],
                          value=JoinedStr(
                            values=[
                              Constant(value="Title '"),
                              FormattedValue(
                                value=Name(id='title', ctx=Load()),
                                conversion=-1),
                              Constant(value="' contains '"),
                              FormattedValue(
                                value=Name(id='keyword', ctx=Load()),
                                conversion=-1),
                              Constant(value="' indicator")])),
                        Assign(
                          targets=[
                            Name(id='key_indicators', ctx=Store())],
                          value=List(
                            elts=[
                              Name(id='keyword', ctx=Load())],
                            ctx=Load())),
                        Break()])]),
                If(
                  test=Name(id='archetype', ctx=Load()),
                  body=[
                    Break()])]),
            If(
              test=UnaryOp(
                op=Not(),
                operand=Name(id='archetype', ctx=Load())),
              body=[
                Assign(
                  targets=[
                    Name(id='archetype', ctx=Store())],
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='default_archetype',
                    ctx=Load())),
                Assign(
                  targets=[
                    Name(id='confidence', ctx=Store())],
                  value=Subscript(
                    value=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='config',
                      ctx=Load()),
                    slice=Constant(value='default_confidence'),
                    ctx=Load())),
                Assign(
                  targets=[
                    Name(id='reasoning', ctx=Store())],
                  value=JoinedStr(
                    values=[
                      Constant(value="Default classification - ambiguous title '"),
                      FormattedValue(
                        value=Name(id='title', ctx=Load()),
                        conversion=-1),
                      Constant(value="'")])),
                Assign(
                  targets=[
                    Name(id='key_indicators', ctx=Store())],
                  value=List(
                    elts=[
                      Name(id='title', ctx=Load())],
                    ctx=Load()))]),
            Assign(
              targets=[
                Name(id='needs_manual_override', ctx=Store())],
              value=Compare(
                left=Name(id='confidence', ctx=Load()),
                ops=[
                  Lt()],
                comparators=[
                  Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='manual_override_threshold',
                    ctx=Load())])),
            Assign(
              targets=[
                Name(id='output_state', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='archetype'),
                  Constant(value='confidence'),
                  Constant(value='reasoning'),
                  Constant(value='key_indicators'),
                  Constant(value='needs_manual_override'),
                  Constant(value='recipient_title'),
                  Constant(value='recipient_name'),
                  Constant(value='recipient_company')],
                values=[
                  Name(id='archetype', ctx=Load()),
                  Name(id='confidence', ctx=Load()),
                  Name(id='reasoning', ctx=Load()),
                  Name(id='key_indicators', ctx=Load()),
                  Name(id='needs_manual_override', ctx=Load()),
                  Name(id='title', ctx=Load()),
                  Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='mission', ctx=Load()),
                        attr='recipient_profile',
                        ctx=Load()),
                      attr='get',
                      ctx=Load()),
                    args=[
                      Constant(value='name'),
                      Constant(value='')]),
                  Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='mission', ctx=Load()),
                        attr='recipient_profile',
                        ctx=Load()),
                      attr='get',
                      ctx=Load()),
                    args=[
                      Constant(value='company'),
                      Constant(value='')])])),
            Assign(
              targets=[
                Name(id='output_path', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='state_mgr', ctx=Load()),
                  attr='write_state',
                  ctx=Load()),
                args=[
                  Constant(value='HOP-1'),
                  Name(id='output_state', ctx=Load())])),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='✓ Profile Analysis Complete')])])),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='  Archetype: '),
                      FormattedValue(
                        value=Name(id='archetype', ctx=Load()),
                        conversion=-1)])])),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='  Confidence: '),
                      FormattedValue(
                        value=Name(id='confidence', ctx=Load()),
                        conversion=-1,
                        format_spec=JoinedStr(
                          values=[
                            Constant(value='.2f')]))])])),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='  Reasoning: '),
                      FormattedValue(
                        value=Name(id='reasoning', ctx=Load()),
                        conversion=-1),
                      Constant(value='\n')])])),
            Return(
              value=Name(id='output_path', ctx=Load()))],
          returns=Name(id='str', ctx=Load()))]),
    ClassDef(
      name='HOP3_SenderGroundingAgent',
      body=[
        Expr(
          value=Constant(value='\n    v13.0: HOP-3 - Sender Grounding Extraction (NEW - decomposed from S2)\n    \n    Single Responsibility: Extract sender capabilities from knowledge base\n    \n    Input:  master_resume.json, sender_knowledge_base.json\n    Output: state/3_sender_grounding.json\n    ')),
        FunctionDef(
          name='__init__',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='config',
                annotation=Subscript(
                  value=Name(id='Dict', ctx=Load()),
                  slice=Tuple(
                    elts=[
                      Name(id='str', ctx=Load()),
                      Name(id='Any', ctx=Load())],
                    ctx=Load()),
                  ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Initialize with externalized configuration\n        \n        Args:\n            config: Loaded from config/agent_specs_LIC.json\n        ')),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='config',
                  ctx=Store())],
              value=Subscript(
                value=Name(id='config', ctx=Load()),
                slice=Constant(value='sender_grounding_agent'),
                ctx=Load())),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='source_files',
                  ctx=Store())],
              value=Subscript(
                value=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='config',
                  ctx=Load()),
                slice=Constant(value='source_files'),
                ctx=Load())),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='extraction_targets',
                  ctx=Store())],
              value=Subscript(
                value=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='config',
                  ctx=Load()),
                slice=Constant(value='extraction_targets'),
                ctx=Load()))]),
        FunctionDef(
          name='execute',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='state_mgr',
                annotation=Name(id='StateManager', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Execute HOP-3: Extract sender grounding from knowledge base\n        \n        Args:\n            state_mgr: State manager for this mission\n        \n        Returns:\n            Path to output state file\n        ')),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='\n'),
                      FormattedValue(
                        value=BinOp(
                          left=Constant(value='='),
                          op=Mult(),
                          right=Constant(value=80)),
                        conversion=-1)])])),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  Constant(value='HOP-3: SENDER GROUNDING EXTRACTION')])),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      FormattedValue(
                        value=BinOp(
                          left=Constant(value='='),
                          op=Mult(),
                          right=Constant(value=80)),
                        conversion=-1),
                      Constant(value='\n')])])),
            Assign(
              targets=[
                Name(id='grounding', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='team_members'),
                  Constant(value='products'),
                  Constant(value='case_studies'),
                  Constant(value='quantifiable_achievements'),
                  Constant(value='raw_evidence')],
                values=[
                  List(ctx=Load()),
                  List(ctx=Load()),
                  List(ctx=Load()),
                  List(ctx=Load()),
                  Dict()])),
            For(
              target=Name(id='source_file', ctx=Store()),
              iter=Attribute(
                value=Name(id='self', ctx=Load()),
                attr='source_files',
                ctx=Load()),
              body=[
                If(
                  test=UnaryOp(
                    op=Not(),
                    operand=Call(
                      func=Attribute(
                        value=Attribute(
                          value=Name(id='os', ctx=Load()),
                          attr='path',
                          ctx=Load()),
                        attr='exists',
                        ctx=Load()),
                      args=[
                        Name(id='source_file', ctx=Load())])),
                  body=[
                    Expr(
                      value=Call(
                        func=Name(id='print', ctx=Load()),
                        args=[
                          JoinedStr(
                            values=[
                              Constant(value='  ⚠ Warning: '),
                              FormattedValue(
                                value=Name(id='source_file', ctx=Load()),
                                conversion=-1),
                              Constant(value=' not found, skipping')])])),
                    Continue()]),
                Expr(
                  value=Call(
                    func=Name(id='print', ctx=Load()),
                    args=[
                      JoinedStr(
                        values=[
                          Constant(value='  Loading: '),
                          FormattedValue(
                            value=Name(id='source_file', ctx=Load()),
                            conversion=-1)])])),
                With(
                  items=[
                    withitem(
                      context_expr=Call(
                        func=Name(id='open', ctx=Load()),
                        args=[
                          Name(id='source_file', ctx=Load()),
                          Constant(value='r')]),
                      optional_vars=Name(id='f', ctx=Store()))],
                  body=[
                    Assign(
                      targets=[
                        Name(id='data', ctx=Store())],
                      value=Call(
                        func=Attribute(
                          value=Name(id='json', ctx=Load()),
                          attr='load',
                          ctx=Load()),
                        args=[
                          Name(id='f', ctx=Load())]))]),
                If(
                  test=Compare(
                    left=Constant(value='sender_knowledge_base'),
                    ops=[
                      In()],
                    comparators=[
                      Name(id='source_file', ctx=Load())]),
                  body=[
                    If(
                      test=Compare(
                        left=Constant(value='whitelisted_team_members'),
                        ops=[
                          In()],
                        comparators=[
                          Name(id='data', ctx=Load())]),
                      body=[
                        Assign(
                          targets=[
                            Subscript(
                              value=Name(id='grounding', ctx=Load()),
                              slice=Constant(value='team_members'),
                              ctx=Store())],
                          value=ListComp(
                            elt=Subscript(
                              value=Name(id='member', ctx=Load()),
                              slice=Constant(value='name'),
                              ctx=Load()),
                            generators=[
                              comprehension(
                                target=Name(id='member', ctx=Store()),
                                iter=Subscript(
                                  value=Name(id='data', ctx=Load()),
                                  slice=Constant(value='whitelisted_team_members'),
                                  ctx=Load()),
                                is_async=0)]))]),
                    If(
                      test=Compare(
                        left=Constant(value='whitelisted_products'),
                        ops=[
                          In()],
                        comparators=[
                          Name(id='data', ctx=Load())]),
                      body=[
                        Assign(
                          targets=[
                            Subscript(
                              value=Name(id='grounding', ctx=Load()),
                              slice=Constant(value='products'),
                              ctx=Store())],
                          value=ListComp(
                            elt=Subscript(
                              value=Name(id='product', ctx=Load()),
                              slice=Constant(value='name'),
                              ctx=Load()),
                            generators=[
                              comprehension(
                                target=Name(id='product', ctx=Store()),
                                iter=Subscript(
                                  value=Name(id='data', ctx=Load()),
                                  slice=Constant(value='whitelisted_products'),
                                  ctx=Load()),
                                is_async=0)]))]),
                    If(
                      test=Compare(
                        left=Constant(value='whitelisted_case_studies'),
                        ops=[
                          In()],
                        comparators=[
                          Name(id='data', ctx=Load())]),
                      body=[
                        Assign(
                          targets=[
                            Subscript(
                              value=Name(id='grounding', ctx=Load()),
                              slice=Constant(value='case_studies'),
                              ctx=Store())],
                          value=ListComp(
                            elt=Subscript(
                              value=Name(id='case', ctx=Load()),
                              slice=Constant(value='client'),
                              ctx=Load()),
                            generators=[
                              comprehension(
                                target=Name(id='case', ctx=Store()),
                                iter=Subscript(
                                  value=Name(id='data', ctx=Load()),
                                  slice=Constant(value='whitelisted_case_studies'),
                                  ctx=Load()),
                                is_async=0)]))]),
                    If(
                      test=Compare(
                        left=Constant(value='quantifiable_achievements'),
                        ops=[
                          In()],
                        comparators=[
                          Name(id='data', ctx=Load())]),
                      body=[
                        Assign(
                          targets=[
                            Subscript(
                              value=Name(id='grounding', ctx=Load()),
                              slice=Constant(value='quantifiable_achievements'),
                              ctx=Store())],
                          value=Subscript(
                            value=Name(id='data', ctx=Load()),
                            slice=Constant(value='quantifiable_achievements'),
                            ctx=Load()))])],
                  orelse=[
                    If(
                      test=Compare(
                        left=Constant(value='master_resume'),
                        ops=[
                          In()],
                        comparators=[
                          Name(id='source_file', ctx=Load())]),
                      body=[
                        If(
                          test=Compare(
                            left=Constant(value='professional_experience'),
                            ops=[
                              In()],
                            comparators=[
                              Name(id='data', ctx=Load())]),
                          body=[
                            For(
                              target=Name(id='exp', ctx=Store()),
                              iter=Subscript(
                                value=Name(id='data', ctx=Load()),
                                slice=Constant(value='professional_experience'),
                                ctx=Load()),
                              body=[
                                Assign(
                                  targets=[
                                    Name(id='company', ctx=Store())],
                                  value=Call(
                                    func=Attribute(
                                      value=Name(id='exp', ctx=Load()),
                                      attr='get',
                                      ctx=Load()),
                                    args=[
                                      Constant(value='company'),
                                      Constant(value='')])),
                                Expr(
                                  value=Call(
                                    func=Attribute(
                                      value=Call(
                                        func=Attribute(
                                          value=Subscript(
                                            value=Name(id='grounding', ctx=Load()),
                                            slice=Constant(value='raw_evidence'),
                                            ctx=Load()),
                                          attr='setdefault',
                                          ctx=Load()),
                                        args=[
                                          Constant(value='companies'),
                                          List(ctx=Load())]),
                                      attr='append',
                                      ctx=Load()),
                                    args=[
                                      Name(id='company', ctx=Load())])),
                                If(
                                  test=Compare(
                                    left=Constant(value='bullet_pool'),
                                    ops=[
                                      In()],
                                    comparators=[
                                      Name(id='exp', ctx=Load())]),
                                  body=[
                                    Expr(
                                      value=Call(
                                        func=Attribute(
                                          value=Call(
                                            func=Attribute(
                                              value=Subscript(
                                                value=Name(id='grounding', ctx=Load()),
                                                slice=Constant(value='raw_evidence'),
                                                ctx=Load()),
                                              attr='setdefault',
                                              ctx=Load()),
                                            args=[
                                              Constant(value='achievements'),
                                              List(ctx=Load())]),
                                          attr='extend',
                                          ctx=Load()),
                                        args=[
                                          Subscript(
                                            value=Subscript(
                                              value=Name(id='exp', ctx=Load()),
                                              slice=Constant(value='bullet_pool'),
                                              ctx=Load()),
                                            slice=Slice(
                                              upper=Constant(value=3)),
                                            ctx=Load())]))])])])])])]),
            Assign(
              targets=[
                Name(id='output_state', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='sender_grounding'),
                  Constant(value='source_files_loaded')],
                values=[
                  Name(id='grounding', ctx=Load()),
                  ListComp(
                    elt=Name(id='f', ctx=Load()),
                    generators=[
                      comprehension(
                        target=Name(id='f', ctx=Store()),
                        iter=Attribute(
                          value=Name(id='self', ctx=Load()),
                          attr='source_files',
                          ctx=Load()),
                        ifs=[
                          Call(
                            func=Attribute(
                              value=Attribute(
                                value=Name(id='os', ctx=Load()),
                                attr='path',
                                ctx=Load()),
                              attr='exists',
                              ctx=Load()),
                            args=[
                              Name(id='f', ctx=Load())])],
                        is_async=0)])])),
            Assign(
              targets=[
                Name(id='output_path', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='state_mgr', ctx=Load()),
                  attr='write_state',
                  ctx=Load()),
                args=[
                  Constant(value='HOP-3'),
                  Name(id='output_state', ctx=Load())])),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
