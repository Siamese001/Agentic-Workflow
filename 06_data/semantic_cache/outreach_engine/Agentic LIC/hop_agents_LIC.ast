                value=Name(id='mission', ctx=Load()),
                attr='prior_message_count',
                ctx=Load())),
            Assign(
              targets=[
                Name(id='selected_route', ctx=Store())],
              value=Constant(value=None)),
            Assign(
              targets=[
                Name(id='reasoning', ctx=Store())],
