          returns=Name(id='float', ctx=Load()))]),
    ClassDef(
      name='HOPOrchestrator',
      body=[
        Expr(
          value=Constant(value='\n    v13.0: HOP-based Workflow Orchestrator\n    \n    BREAKING CHANGE from v12.0:\n    - OLD: Monolithic orchestrator with in-memory object passing\n    - NEW: "Foreman" pattern - iterates through HOPs, all I/O via state files\n    - Implements S6→S2 meta-loop (Factual failure)\n    - Implements S5 retry (Creative failure)\n    \n    The Orchestrator is configuration-driven and agent-agnostic.\n    ')),
        FunctionDef(
          name='__init__',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Initialize orchestrator with all dependencies')),
            With(
              items=[
                withitem(
                  context_expr=Call(
                    func=Name(id='open', ctx=Load()),
                    args=[
                      Constant(value='config/agent_specs_LIC.json'),
                      Constant(value='r')]),
                  optional_vars=Name(id='f', ctx=Store()))],
              body=[
                Assign(
                  targets=[
                    Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='config',
                      ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='json', ctx=Load()),
                      attr='load',
                      ctx=Load()),
                    args=[
                      Name(id='f', ctx=Load())]))]),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='circuit_breaker',
                  ctx=Store())],
              value=Call(
                func=Name(id='CircuitBreaker', ctx=Load()),
                keywords=[
                  keyword(
                    arg='failure_threshold',
                    value=Subscript(
                      value=Subscript(
                        value=Attribute(
                          value=Name(id='self', ctx=Load()),
                          attr='config',
                          ctx=Load()),
                        slice=Constant(value='circuit_breaker'),
                        ctx=Load()),
                      slice=Constant(value='failure_threshold'),
                      ctx=Load())),
                  keyword(
                    arg='timeout_seconds',
                    value=Subscript(
                      value=Subscript(
                        value=Attribute(
                          value=Name(id='self', ctx=Load()),
                          attr='config',
                          ctx=Load()),
                        slice=Constant(value='circuit_breaker'),
                        ctx=Load()),
                      slice=Constant(value='timeout_seconds'),
                      ctx=Load()))])),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='search_client',
                  ctx=Store())],
              value=Call(
                func=Name(id='GoogleSearchClient', ctx=Load()),
                args=[
                  Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='circuit_breaker',
                    ctx=Load())])),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='llm_client',
                  ctx=Store())],
              value=Call(
                func=Name(id='GeminiLLMClient', ctx=Load()),
                args=[
