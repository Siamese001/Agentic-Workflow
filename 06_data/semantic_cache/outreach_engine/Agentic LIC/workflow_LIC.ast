                op=Mult(),
                right=Constant(value=20))),
            Assign(
              targets=[
                Name(id='factual_loops', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='gate', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='factual_loop_count'),
                  Constant(value=0)])),
            Assign(
