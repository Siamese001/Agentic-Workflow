              value=Call(
                func=Name(id='min', ctx=Load()),
                args=[
                  Constant(value=30),
                  BinOp(
                    left=Call(
                      func=Attribute(
                        value=Name(id='research', ctx=Load()),
                        attr='get',
                        ctx=Load()),
                      args=[
                        Constant(value='signal_score'),
                        Constant(value=0.5)]),
                    op=Mult(),
                    right=Constant(value=30))])),
            Assign(
              targets=[
                Name(id='passed', ctx=Store())],
