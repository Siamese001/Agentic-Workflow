      level=0),
    ClassDef(
      name='HOP2_ResearchAgent',
      body=[
        Expr(
          value=Constant(value='\n    v13.0: Research Agent - Vector-store-first with fallback RAG\n    \n    BREAKING CHANGE from v12.0:\n    - OLD: All research at runtime (60-80s)\n    - NEW: Query vector store first (<1s), fallback RAG only for gaps\n    \n    Single Responsibility: Synthesize research context\n    \n    Input:  state/1_profile_analysis.json\n    Output: state/2_research_context.json\n    ')),
        FunctionDef(
          name='__init__',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='config',
                annotation=Subscript(
                  value=Name(id='Dict', ctx=Load()),
                  slice=Tuple(
                    elts=[
                      Name(id='str', ctx=Load()),
                      Name(id='Any', ctx=Load())],
                    ctx=Load()),
                  ctx=Load())),
              arg(
                arg='memory_store',
                annotation=Name(id='VectorMemoryStore', ctx=Load())),
              arg(
                arg='search_client',
                annotation=Name(id='GoogleSearchClient', ctx=Load())),
              arg(
                arg='llm_client',
                annotation=Name(id='GeminiLLMClient', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Initialize with externalized config and live API clients\n        \n        Args:\n            config: Loaded from config/agent_specs_LIC.json\n            memory_store: Pre-populated vector database\n            search_client: Google Search API client (fallback only)\n            llm_client: Gemini LLM client\n        ')),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='config',
                  ctx=Store())],
              value=Subscript(
                value=Name(id='config', ctx=Load()),
                slice=Constant(value='research_agent'),
                ctx=Load())),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='memory_store',
                  ctx=Store())],
              value=Name(id='memory_store', ctx=Load())),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='search_client',
                  ctx=Store())],
              value=Name(id='search_client', ctx=Load())),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='llm_client',
                  ctx=Store())],
              value=Name(id='llm_client', ctx=Load())),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='vector_params',
                  ctx=Store())],
              value=Subscript(
                value=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='config',
                  ctx=Load()),
                slice=Constant(value='vector_store_query_params'),
                ctx=Load())),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='fallback_params',
                  ctx=Store())],
              value=Subscript(
                value=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='config',
                  ctx=Load()),
                slice=Constant(value='fallback_rag_params'),
                ctx=Load())),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='critique_params',
                  ctx=Store())],
              value=Subscript(
                value=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='config',
                  ctx=Load()),
                slice=Constant(value='cache_critique_params'),
                ctx=Load()))]),
        AsyncFunctionDef(
          name='execute',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='state_mgr',
                annotation=Name(id='StateManager', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Execute HOP-2: Research synthesis with vector-first strategy\n        \n        Args:\n            state_mgr: State manager for this mission\n        \n        Returns:\n            Path to output state file\n        ')),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='\n'),
                      FormattedValue(
                        value=BinOp(
                          left=Constant(value='='),
                          op=Mult(),
                          right=Constant(value=80)),
                        conversion=-1)])])),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  Constant(value='HOP-2: RESEARCH AGENT (Vector-Store-First)')])),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      FormattedValue(
                        value=BinOp(
                          left=Constant(value='='),
                          op=Mult(),
                          right=Constant(value=80)),
                        conversion=-1),
                      Constant(value='\n')])])),
            Assign(
              targets=[
                Name(id='profile_state', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='state_mgr', ctx=Load()),
                  attr='read_state',
                  ctx=Load()),
                args=[
                  Constant(value='HOP-1')])),
            Assign(
              targets=[
                Name(id='company', ctx=Store())],
              value=Subscript(
                value=Name(id='profile_state', ctx=Load()),
                slice=Constant(value='recipient_company'),
                ctx=Load())),
            Assign(
              targets=[
                Name(id='recipient', ctx=Store())],
              value=Subscript(
                value=Name(id='profile_state', ctx=Load()),
                slice=Constant(value='recipient_name'),
                ctx=Load())),
            Assign(
              targets=[
                Name(id='archetype', ctx=Store())],
              value=Subscript(
                value=Name(id='profile_state', ctx=Load()),
                slice=Constant(value='archetype'),
                ctx=Load())),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  Constant(value='STEP 1: Querying vector store (cached intelligence)...')])),
            Assign(
              targets=[
                Name(id='cached_context', ctx=Store())],
              value=Await(
                value=Call(
                  func=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='_query_vector_store',
                    ctx=Load()),
                  args=[
                    Name(id='company', ctx=Load()),
                    Name(id='recipient', ctx=Load()),
                    Name(id='archetype', ctx=Load())]))),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='  ✓ Retrieved '),
                      FormattedValue(
                        value=Call(
                          func=Name(id='len', ctx=Load()),
                          args=[
                            Subscript(
                              value=Name(id='cached_context', ctx=Load()),
                              slice=Constant(value='all_results'),
                              ctx=Load())]),
                        conversion=-1),
                      Constant(value=' cached documents')])])),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  Constant(value='\nSTEP 2: Evaluating cache quality...')])),
            Assign(
              targets=[
                Tuple(
                  elts=[
                    Name(id='is_sufficient', ctx=Store()),
                    Name(id='gaps', ctx=Store())],
                  ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='_critique_cache',
                  ctx=Load()),
                args=[
                  Name(id='cached_context', ctx=Load())])),
            If(
              test=Name(id='is_sufficient', ctx=Load()),
              body=[
                Expr(
                  value=Call(
                    func=Name(id='print', ctx=Load()),
                    args=[
                      JoinedStr(
                        values=[
                          Constant(value='  ✓ Cache is sufficient (confidence: '),
                          FormattedValue(
                            value=Subscript(
                              value=Name(id='cached_context', ctx=Load()),
                              slice=Constant(value='cache_confidence'),
                              ctx=Load()),
                            conversion=-1,
                            format_spec=JoinedStr(
                              values=[
                                Constant(value='.2f')])),
                          Constant(value=')')])])),
                Assign(
                  targets=[
                    Name(id='final_context', ctx=Store())],
                  value=Name(id='cached_context', ctx=Load()))],
              orelse=[
                Expr(
                  value=Call(
                    func=Name(id='print', ctx=Load()),
                    args=[
                      JoinedStr(
                        values=[
                          Constant(value='  ⚠ Cache has gaps: '),
                          FormattedValue(
                            value=Name(id='gaps', ctx=Load()),
                            conversion=-1)])])),
                Expr(
                  value=Call(
                    func=Name(id='print', ctx=Load()),
                    args=[
                      JoinedStr(
                        values=[
                          Constant(value='\nSTEP 3: Running fallback RAG to fill gaps...')])])),
                Assign(
                  targets=[
                    Name(id='fallback_context', ctx=Store())],
                  value=Await(
                    value=Call(
                      func=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='_run_fallback_rag',
                        ctx=Load()),
                      args=[
                        Name(id='company', ctx=Load()),
                        Name(id='recipient', ctx=Load()),
                        Name(id='gaps', ctx=Load())]))),
                Expr(
                  value=Call(
                    func=Name(id='print', ctx=Load()),
                    args=[
                      JoinedStr(
                        values=[
                          Constant(value='  ✓ Retrieved '),
                          FormattedValue(
                            value=Call(
                              func=Name(id='len', ctx=Load()),
                              args=[
                                Subscript(
                                  value=Name(id='fallback_context', ctx=Load()),
                                  slice=Constant(value='rag_results'),
                                  ctx=Load())]),
                            conversion=-1),
                          Constant(value=' additional sources')])])),
                Assign(
                  targets=[
                    Name(id='final_context', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='_merge_contexts',
                      ctx=Load()),
                    args=[
                      Name(id='cached_context', ctx=Load()),
                      Name(id='fallback_context', ctx=Load())]))]),
            Assign(
              targets=[
                Name(id='output_state', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='recipient_insights'),
                  Constant(value='company_context'),
                  Constant(value='strategic_brief'),
                  Constant(value='rag_results'),
                  Constant(value='signal_score'),
                  Constant(value='cache_hit'),
                  Constant(value='fallback_used'),
                  Constant(value='total_sources')],
                values=[
                  Subscript(
                    value=Name(id='final_context', ctx=Load()),
                    slice=Constant(value='recipient_insights'),
                    ctx=Load()),
                  Subscript(
                    value=Name(id='final_context', ctx=Load()),
                    slice=Constant(value='company_context'),
                    ctx=Load()),
                  Subscript(
                    value=Name(id='final_context', ctx=Load()),
                    slice=Constant(value='strategic_brief'),
                    ctx=Load()),
                  Subscript(
                    value=Name(id='final_context', ctx=Load()),
                    slice=Constant(value='all_results'),
                    ctx=Load()),
                  Subscript(
                    value=Name(id='final_context', ctx=Load()),
                    slice=Constant(value='signal_score'),
                    ctx=Load()),
                  Name(id='is_sufficient', ctx=Load()),
                  UnaryOp(
                    op=Not(),
                    operand=Name(id='is_sufficient', ctx=Load())),
                  Call(
                    func=Name(id='len', ctx=Load()),
                    args=[
                      Subscript(
                        value=Name(id='final_context', ctx=Load()),
                        slice=Constant(value='all_results'),
                        ctx=Load())])])),
            Assign(
              targets=[
                Name(id='output_path', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='state_mgr', ctx=Load()),
                  attr='write_state',
                  ctx=Load()),
                args=[
                  Constant(value='HOP-2'),
                  Name(id='output_state', ctx=Load())])),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='\n✓ Research Complete')])])),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='  Total sources: '),
                      FormattedValue(
                        value=Subscript(
                          value=Name(id='output_state', ctx=Load()),
                          slice=Constant(value='total_sources'),
                          ctx=Load()),
                        conversion=-1)])])),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='  Signal score: '),
                      FormattedValue(
                        value=Subscript(
                          value=Name(id='output_state', ctx=Load()),
                          slice=Constant(value='signal_score'),
                          ctx=Load()),
                        conversion=-1,
                        format_spec=JoinedStr(
                          values=[
                            Constant(value='.2f')]))])])),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='  Cache hit: '),
                      FormattedValue(
                        value=Subscript(
                          value=Name(id='output_state', ctx=Load()),
                          slice=Constant(value='cache_hit'),
                          ctx=Load()),
                        conversion=-1),
                      Constant(value='\n')])])),
            Return(
              value=Name(id='output_path', ctx=Load()))],
          returns=Name(id='str', ctx=Load())),
        AsyncFunctionDef(
          name='_query_vector_store',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='company',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='recipient',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='archetype',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Query vector store for pre-computed intelligence')),
            Assign(
              targets=[
                Name(id='company_results', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='memory_store',
                    ctx=Load()),
                  attr='query_by_company',
                  ctx=Load()),
                keywords=[
                  keyword(
                    arg='company_name',
                    value=Name(id='company', ctx=Load())),
                  keyword(
                    arg='query_text',
                    value=Constant(value='strategic priorities initiatives roadmap platform')),
                  keyword(
                    arg='n_results',
                    value=Subscript(
                      value=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='vector_params',
                        ctx=Load()),
                      slice=Constant(value='n_results'),
                      ctx=Load()))])),
            Assign(
              targets=[
                Name(id='exec_results', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='memory_store',
                    ctx=Load()),
                  attr='query_by_executive',
                  ctx=Load()),
                keywords=[
                  keyword(
                    arg='executive_name',
                    value=Name(id='recipient', ctx=Load())),
                  keyword(
                    arg='query_text',
                    value=Constant(value='recent posts presentations LinkedIn about background')),
                  keyword(
                    arg='n_results',
                    value=Constant(value=10))])),
            Assign(
              targets=[
                Name(id='strategic_briefs', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='memory_store',
                    ctx=Load()),
                  attr='get_strategic_briefs',
                  ctx=Load()),
                keywords=[
                  keyword(
                    arg='company_name',
                    value=Name(id='company', ctx=Load())),
                  keyword(
                    arg='max_age_days',
                    value=Constant(value=90))])),
            Assign(
              targets=[
                Name(id='recipient_insights', ctx=Store())],
              value=ListComp(
                elt=Subscript(
                  value=Subscript(
                    value=Name(id='r', ctx=Load()),
                    slice=Constant(value='text'),
                    ctx=Load()),
                  slice=Slice(
                    upper=Constant(value=200)),
                  ctx=Load()),
                generators=[
                  comprehension(
                    target=Name(id='r', ctx=Store()),
                    iter=Subscript(
                      value=Name(id='exec_results', ctx=Load()),
                      slice=Slice(
                        upper=Constant(value=5)),
                      ctx=Load()),
                    is_async=0)])),
            Assign(
              targets=[
                Name(id='company_context', ctx=Store())],
              value=ListComp(
                elt=Subscript(
                  value=Subscript(
                    value=Name(id='r', ctx=Load()),
                    slice=Constant(value='text'),
                    ctx=Load()),
                  slice=Slice(
                    upper=Constant(value=200)),
                  ctx=Load()),
                generators=[
                  comprehension(
                    target=Name(id='r', ctx=Store()),
                    iter=Subscript(
                      value=Name(id='company_results', ctx=Load()),
                      slice=Slice(
                        upper=Constant(value=5)),
                      ctx=Load()),
                    is_async=0)])),
            Assign(
              targets=[
                Name(id='strategic_brief_text', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Constant(value='\n'),
                  attr='join',
                  ctx=Load()),
                args=[
                  ListComp(
                    elt=Subscript(
                      value=Name(id='s', ctx=Load()),
                      slice=Constant(value='text'),
                      ctx=Load()),
                    generators=[
                      comprehension(
                        target=Name(id='s', ctx=Store()),
                        iter=Name(id='strategic_briefs', ctx=Load()),
                        is_async=0)])])),
            Assign(
              targets=[
                Name(id='all_results', ctx=Store())],
              value=BinOp(
                left=BinOp(
                  left=Name(id='company_results', ctx=Load()),
                  op=Add(),
                  right=Name(id='exec_results', ctx=Load())),
                op=Add(),
                right=Name(id='strategic_briefs', ctx=Load()))),
            Assign(
              targets=[
                Name(id='signal_score', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='_calculate_signal_score',
                  ctx=Load()),
                args=[
                  Name(id='all_results', ctx=Load())])),
            Assign(
              targets=[
                Name(id='cache_confidence', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='_calculate_cache_confidence',
                  ctx=Load()),
                args=[
                  Name(id='company_results', ctx=Load()),
                  Name(id='exec_results', ctx=Load()),
                  Name(id='strategic_briefs', ctx=Load())])),
            Return(
              value=Dict(
                keys=[
                  Constant(value='recipient_insights'),
                  Constant(value='company_context'),
                  Constant(value='strategic_brief'),
                  Constant(value='all_results'),
                  Constant(value='signal_score'),
                  Constant(value='cache_confidence')],
                values=[
                  Name(id='recipient_insights', ctx=Load()),
                  Name(id='company_context', ctx=Load()),
                  Name(id='strategic_brief_text', ctx=Load()),
                  Name(id='all_results', ctx=Load()),
                  Name(id='signal_score', ctx=Load()),
                  Name(id='cache_confidence', ctx=Load())]))],
          returns=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='Any', ctx=Load())],
              ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='_critique_cache',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='cached_context',
                annotation=Subscript(
                  value=Name(id='Dict', ctx=Load()),
                  slice=Tuple(
                    elts=[
                      Name(id='str', ctx=Load()),
                      Name(id='Any', ctx=Load())],
                    ctx=Load()),
                  ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Evaluate if cached context is sufficient')),
            Assign(
              targets=[
                Name(id='min_confidence', ctx=Store())],
              value=Subscript(
                value=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='critique_params',
                  ctx=Load()),
                slice=Constant(value='min_confidence_score'),
                ctx=Load())),
            Assign(
              targets=[
                Name(id='min_recency', ctx=Store())],
              value=Subscript(
                value=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='critique_params',
                  ctx=Load()),
                slice=Constant(value='min_recency_days'),
                ctx=Load())),
            Assign(
              targets=[
                Name(id='min_recipient_count', ctx=Store())],
              value=Subscript(
                value=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='critique_params',
                  ctx=Load()),
                slice=Constant(value='min_recipient_specific_count'),
                ctx=Load())),
            Assign(
              targets=[
                Name(id='gaps', ctx=Store())],
              value=List(ctx=Load())),
            Assign(
              targets=[
                Name(id='has_strategic_brief', ctx=Store())],
              value=Compare(
                left=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Subscript(
                      value=Name(id='cached_context', ctx=Load()),
                      slice=Constant(value='strategic_brief'),
                      ctx=Load())]),
                ops=[
                  Gt()],
                comparators=[
                  Constant(value=100)])),
            If(
              test=UnaryOp(
                op=Not(),
                operand=Name(id='has_strategic_brief', ctx=Load())),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='gaps', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Constant(value='strategic_brief')]))]),
            Assign(
              targets=[
                Name(id='recent_sources', ctx=Store())],
              value=ListComp(
                elt=Name(id='r', ctx=Load()),
                generators=[
                  comprehension(
                    target=Name(id='r', ctx=Store()),
                    iter=Subscript(
                      value=Name(id='cached_context', ctx=Load()),
                      slice=Constant(value='all_results'),
                      ctx=Load()),
                    ifs=[
                      Compare(
                        left=Call(
                          func=Attribute(
                            value=Call(
                              func=Attribute(
                                value=Name(id='r', ctx=Load()),
                                attr='get',
                                ctx=Load()),
                              args=[
                                Constant(value='metadata'),
                                Dict()]),
                            attr='get',
                            ctx=Load()),
                          args=[
                            Constant(value='age_days'),
                            Constant(value=999)]),
                        ops=[
                          Lt()],
                        comparators=[
                          Name(id='min_recency', ctx=Load())])],
                    is_async=0)])),
            Assign(
              targets=[
                Name(id='has_recent', ctx=Store())],
              value=Compare(
                left=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Name(id='recent_sources', ctx=Load())]),
                ops=[
                  GtE()],
                comparators=[
                  Constant(value=3)])),
            If(
              test=UnaryOp(
                op=Not(),
                operand=Name(id='has_recent', ctx=Load())),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='gaps', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Constant(value='recent_news')]))]),
            Assign(
              targets=[
                Name(id='has_recipient_data', ctx=Store())],
