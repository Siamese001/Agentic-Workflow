                  Constant(value='\nMODE: SYNTHESIS\nTASK: Rewrite the section to synthesize and resolve both critiques.\n{style_guide}\nSection: {section_text}\nCritique 1 (Strategist): {critique}\nCritique 2 (Red Team): {critique_2}\nExample: {{"status": "success", "refined_text": "Drove 10% profit growth."}}\nREFLECTION: Does the new text resolve both critiques?\nYour Refinement:\n'),
                  Constant(value='\nMODE: ANALYTICAL\nTASK: Review bullets and suggest opportunities to add metrics.\n{style_guide}\nBullets: {bullets}\nExample: {{"status": "success", "suggestions": ["Quantify \'Led team\' with number..."]}}\nREFLECTION: Are these suggestions specific?\nYour Suggestions:\n'),
                  Constant(value='MODE: NLI. Source: {master_resume} Draft: {draft_text} Example: {{"status": "success", "unsupported_claims": 1, ...}} REFLECTION: Is this claim truly unsupported? Your NLI Analysis:'),
                  Constant(value='MODE: ANALYTICAL. Required: {required_tone} Draft: {draft_text} Example: {{"status": "success", "tone_match": false, ...}} REFLECTION: Is the tone mismatch severe? Your Analysis:'),
                  Constant(value='MODE: ANALYTICAL. Strategy: {strategy} Draft: {draft_text} Example: {{"status": "success", "alignment_score": 0.2, ...}} REFLECTION: Why is the alignment score low? Your Analysis:'),
                  Constant(value='MODE: NLI. JD: {job_description} Draft: {draft_text} Example: {{"status": "success", "entailment_score": 0.5, ...}} REFLECTION: Does the draft entail the JD? Your Analysis:'),
                  Constant(value='MODE: SYNTHESIS. Draft: {draft_text} Example: {{"narrative_clear": true}} REFLECTION: What is the narrative? Your Analysis:'),
                  Constant(value='MODE: ANALYTICAL. JD: {job_description} Draft: {draft_text} Example: {{"status": "success", "keyword_coverage": 0.67, ...}} REFLECTION: Are the missing keywords critical? Your Analysis:'),
                  Constant(value='MODE: ANALYTICAL. Draft: {draft_text} Example: {{"status": "success", "avg_signal_score": 5.0, ...}} REFLECTION: Which bullets are pure noise? Your Analysis:'),
                  Constant(value='MODE: ANALYTICAL. Draft: {draft_text} Example: {{"status": "success", "gaps_found": 1, ...}} REFLECTION: Are the dates logical? Your Analysis:'),
                  Constant(value='MODE: ANALYTICAL. Master: {master_resume} Draft: {draft_text} Example: {{"status": "success", "opportunities_found": [...], ...}} REFLECTION: Is this opportunity relevant? Your Analysis:'),
                  Constant(value='MODE: ADVERSARIAL. Act as skeptical hiring manager. Draft: {draft_text} Example: {{"status": "success", "red_flags": [...], ...}} REFLECTION: Is this red flag a dealbreaker? Your Analysis:'),
                  Constant(value='(This is a local tool, this prompt is a placeholder) Draft: {draft_text}'),
                  Constant(value='\nMODE: STRATEGY\nTASK: Generate a resume strategy for this job.\nJob Title: {job_title}\nCompany: {company}\nJob Description: {job_description}\nThis is branch {branch_num} of {total_branches}. Be creative and distinct.\n{style_guide}\nExample: {{"strategy_name": "AI Visionary", "focus_areas": [...], "tone": "leadership"}}\nREFLECTION: Is this strategy unique from other branches?\nYour Strategy Branch:\n'),
                  Constant(value='\nMODE: ANALYTICAL\nTASK: Vote for the single best strategy branch.\nJob Description: {job_description}\nBranches: {branches_json}\nExample: {{"best_branch_id": "branch_1", "reason": "Branch 1 is most aligned."}}\nREFLECTION: Why is this branch better than the others?\nYour Vote:\n'),
                  Constant(value='\nMODE: META\nTASK: Generate prompts based on strategy, style, and complexity.\n{style_guide}\nTask Complexity: {complexity}\nStrategy: {strategy}\nExample (for \'complex\' task):\n{{"bullet_generation_prompt": "Create 3 high-impact...", "critique_prompt": "Review for executive tone..."}}\nREFLECTION: Are these prompts tailored to the complexity?\nYour Prompts:\n'),
                  Constant(value='\nMODE: NLI\nTASK: Fact-check bullets against the source experience.\nSource Experience: {experience}\nBullets to Check: {bullets}\nStrategy (for context): {strategy}\nExample: {{"verified_bullets": [...], "rejected_bullets": [...]}}\nREFLECTION: Is this bullet a plausible but unverified claim?\nYour Verification:\n'),
                  Constant(value='MODE: CREATIVE. Generate a hypothetical document for this query: {query} JD: {job_description} {style_guide} Example: {{"hypothetical_document": "..."}} Your Document:'),
                  Constant(value='MODE: ANALYTICAL. Rerank candidates by relevance. Query: {query} Strategy: {strategy} Candidates: {candidates} Example: {{"ranked": [...]}} Your Ranking:'),
                  Constant(value='MODE: ANALYTICAL. Analyze strategy for vagueness. Strategy: {strategy} Example: {{...}} Your Analysis:'),
                  Constant(value="MODE: ANALYTICAL. Route human feedback. Options: 'STRATEGY', 'BULLET_GENERATION', 'DRAFTING', 'INJECT_EDIT'. Feedback: {human_feedback} Example: {{...}} Your Routing Decision:"),
