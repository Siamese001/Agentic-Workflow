                  Constant(value='meta_tool_critique')],
                values=[
                  Constant(value='\nMODE: ANALYTICAL\nTASK: Review the draft against the strategy.\n{style_guide}\nStrategy: {strategy}\nDraft: {draft}\nExample: {{"status": "success", "feedback": "Draft summary is weak..."}}\nREFLECTION: Is the feedback actionable?\nYour Analysis:\n'),
