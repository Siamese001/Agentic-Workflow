Module(
  body=[
    ImportFrom(
      module='src.lic_agentic.agents.k7_validator_agent',
      names=[
        alias(name='ValidatorAgent')],
      level=0),
    FunctionDef(
      name='test_retry_brings_to_pass',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='agent', ctx=Store())],
          value=Call(
            func=Name(id='ValidatorAgent', ctx=Load()),
            keywords=[
              keyword(
                arg='max_retries',
                value=Constant(value=1))])),
        Assign(
          targets=[
            Name(id='initial_draft', ctx=Store())],
          value=Constant(value='Subject: Hello\n\nHello there\nBest regards,\nLIC Outreach Bot')),
        Assign(
          targets=[
            Name(id='artifacts', ctx=Store())],
          value=Dict(
            keys=[
              Constant(value='aid')],
            values=[
              Constant(value='Grounded insight')])),
        Assign(
          targets=[
            Name(id='verdict', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='agent', ctx=Load()),
              attr='check',
              ctx=Load()),
            args=[
              Name(id='initial_draft', ctx=Load())],
            keywords=[
              keyword(
                arg='route_decision',
                value=Constant(value=None)),
              keyword(arg='pii_map', value=Dict()),
              keyword(
                arg='artifacts',
                value=Name(id='artifacts', ctx=Load()))])),
        Assert(
          test=Attribute(
            value=Name(id='verdict', ctx=Load()),
            attr='passed',
            ctx=Load())),
        Assert(
          test=Compare(
            left=Constant(value='CTA:'),
            ops=[
              In()],
            comparators=[
              Attribute(
                value=Name(id='verdict', ctx=Load()),
                attr='final_draft',
                ctx=Load())])),
        Assert(
          test=Compare(
            left=Constant(value='[artifact_id:aid]'),
            ops=[
              In()],
            comparators=[
              Attribute(
                value=Name(id='verdict', ctx=Load()),
                attr='final_draft',
                ctx=Load())]))])])