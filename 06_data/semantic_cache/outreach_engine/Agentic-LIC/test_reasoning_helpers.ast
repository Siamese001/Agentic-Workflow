Module(
  body=[
    ImportFrom(
      module='src.lic_agentic.reasoning',
      names=[
        alias(name='cot'),
        alias(name='reflexion')],
      level=0),
    FunctionDef(
      name='test_cot_expand_guarantees_minimum_step',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='steps', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='cot', ctx=Load()),
              attr='expand',
              ctx=Load()),
            args=[
              Constant(value='Consider options')],
            keywords=[
              keyword(
                arg='steps',
                value=Constant(value=0))])),
        Assert(
          test=Compare(
            left=Name(id='steps', ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              List(
                elts=[
                  Constant(value='Step 1: Consider options')],
                ctx=Load())]))]),
    FunctionDef(
      name='test_cot_expand_respects_requested_steps',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='steps', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='cot', ctx=Load()),
              attr='expand',
              ctx=Load()),
            args=[
              Constant(value='Consider options')],
            keywords=[
              keyword(
                arg='steps',
                value=Constant(value=2))])),
        Assert(
          test=Compare(
            left=Call(
              func=Name(id='len', ctx=Load()),
              args=[
                Name(id='steps', ctx=Load())]),
            ops=[
              Eq()],
            comparators=[
              Constant(value=2)]))]),
    FunctionDef(
      name='test_reflexion_apply_feedback_appends_insight',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='updated', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='reflexion', ctx=Load()),
              attr='apply_feedback',
              ctx=Load()),
            args=[
              Constant(value='Draft body'),
              Constant(value='Focus on product value')])),
        Assert(
          test=Compare(
            left=Constant(value='Reflexion:'),
            ops=[
              In()],
            comparators=[
              Name(id='updated', ctx=Load())])),
        Assert(
          test=Call(
            func=Attribute(
              value=Name(id='updated', ctx=Load()),
              attr='startswith',
              ctx=Load()),
            args=[
              Constant(value='Draft body')]))]),
    FunctionDef(
      name='test_reflexion_no_insight_returns_original',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='updated', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='reflexion', ctx=Load()),
              attr='apply_feedback',
              ctx=Load()),
            args=[
              Constant(value='Draft body'),
              Constant(value='')])),
        Assert(
          test=Compare(
            left=Name(id='updated', ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value='Draft body')]))])])