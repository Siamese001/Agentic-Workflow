Module(
  body=[
    Expr(
      value=Constant(value='Tests for ReasoningToggles validation logic.')),
    Import(
      names=[
        alias(name='pytest')]),
    ImportFrom(
      module='pydantic',
      names=[
        alias(name='ValidationError')],
      level=0),
    ImportFrom(
      module='src.lic_agentic.reasoning.toggles',
      names=[
        alias(name='ReasoningToggles')],
      level=0),
    FunctionDef(
      name='test_toggle_defaults',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='toggles', ctx=Store())],
          value=Call(
            func=Name(id='ReasoningToggles', ctx=Load()))),
        Assert(
          test=Attribute(
            value=Name(id='toggles', ctx=Load()),
            attr='cot',
            ctx=Load())),
        Assert(
          test=Attribute(
            value=Name(id='toggles', ctx=Load()),
            attr='reflexion',
            ctx=Load())),
        Assert(
          test=Compare(
            left=Constant(value=1),
            ops=[
              LtE(),
              LtE()],
            comparators=[
              Attribute(
                value=Name(id='toggles', ctx=Load()),
                attr='tot_branches',
                ctx=Load()),
              Constant(value=4)]))]),
    FunctionDef(
      name='test_toggle_bounds_for_tot_branches',
      args=arguments(),
      body=[
        With(
          items=[
            withitem(
              context_expr=Call(
                func=Attribute(
                  value=Name(id='pytest', ctx=Load()),
                  attr='raises',
                  ctx=Load()),
                args=[
                  Name(id='ValidationError', ctx=Load())]))],
          body=[
            Expr(
              value=Call(
                func=Name(id='ReasoningToggles', ctx=Load()),
                keywords=[
                  keyword(
                    arg='tot_branches',
                    value=Constant(value=7))]))])]),
    FunctionDef(
      name='test_toggle_bounds_for_min_tot_depth',
      args=arguments(),
      body=[
        With(
          items=[
            withitem(
              context_expr=Call(
                func=Attribute(
                  value=Name(id='pytest', ctx=Load()),
                  attr='raises',
                  ctx=Load()),
                args=[
                  Name(id='ValidationError', ctx=Load())]))],
          body=[
            Expr(
              value=Call(
                func=Name(id='ReasoningToggles', ctx=Load()),
                keywords=[
                  keyword(
                    arg='min_tot_depth',
                    value=Constant(value=5))]))])]),
    FunctionDef(
      name='test_toggle_bounds_for_temperature',
      args=arguments(),
      body=[
        With(
          items=[
            withitem(
              context_expr=Call(
                func=Attribute(
                  value=Name(id='pytest', ctx=Load()),
                  attr='raises',
                  ctx=Load()),
                args=[
                  Name(id='ValidationError', ctx=Load())]))],
          body=[
            Expr(
              value=Call(
                func=Name(id='ReasoningToggles', ctx=Load()),
                keywords=[
                  keyword(
                    arg='temperature_cap',
                    value=Constant(value=0.05))]))])]),
    FunctionDef(
      name='test_toggle_bounds_for_self_consistency',
      args=arguments(),
      body=[
        With(
          items=[
            withitem(
              context_expr=Call(
                func=Attribute(
                  value=Name(id='pytest', ctx=Load()),
                  attr='raises',
                  ctx=Load()),
                args=[
                  Name(id='ValidationError', ctx=Load())]))],
          body=[
            Expr(
              value=Call(
                func=Name(id='ReasoningToggles', ctx=Load()),
                keywords=[
                  keyword(
                    arg='self_consistency',
                    value=Constant(value=10))]))])])])