Module(
  body=[
    ImportFrom(
      module='src.lic_agentic.rag.evidence_registry',
      names=[
        alias(name='EvidenceRegistry')],
      level=0),
    FunctionDef(
      name='test_mapping',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='registry', ctx=Store())],
          value=Call(
            func=Name(id='EvidenceRegistry', ctx=Load()))),
        Assign(
          targets=[
            Name(id='artifact_id', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='registry', ctx=Load()),
              attr='upsert',
              ctx=Load()),
            keywords=[
              keyword(
                arg='scope',
                value=Constant(value='company')),
              keyword(
                arg='company_id',
                value=Constant(value='ACME')),
              keyword(
                arg='source_url',
                value=Constant(value='http://example.com')),
              keyword(
                arg='summary',
                value=Constant(value='ACME hit revenue goals')),
              keyword(
                arg='anchor_date',
                value=Constant(value='2025-10-01')),
              keyword(
                arg='confidence',
                value=Constant(value=0.9)),
              keyword(
                arg='used_in_section',
                value=Constant(value='value_wedge'))])),
        Assert(
          test=Compare(
            left=Name(id='artifact_id', ctx=Load()),
            ops=[
              In()],
            comparators=[
              Name(id='registry', ctx=Load())])),
        Assign(
          targets=[
            Name(id='stored', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='registry', ctx=Load()),
              attr='get',
              ctx=Load()),
            args=[
              Name(id='artifact_id', ctx=Load())])),
        Assert(
          test=BoolOp(
            op=And(),
            values=[
              Name(id='stored', ctx=Load()),
              Compare(
                left=Attribute(
                  value=Name(id='stored', ctx=Load()),
                  attr='used_in_section',
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value='value_wedge')])]))])])