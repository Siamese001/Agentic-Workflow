Module(
  body=[
    Expr(
      value=Constant(value='Prompt engineering stack.')),
    Import(
      names=[
        alias(name='json')]),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Any'),
        alias(name='Dict')],
      level=0),
    ImportFrom(
      module='core_v10_7',
      names=[
        alias(name='BaseAgent'),
        alias(name='GeneratedPrompts'),
        alias(name='StrategyPlan'),
        alias(name='ValidationError'),
        alias(name='track_metrics'),
        alias(name='_format_prompt_with_defaults')],
      level=0),
    ClassDef(
      name='PromptEngineerAgent',
      bases=[
        Name(id='BaseAgent', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='LLM-driven prompt engineering that adapts to task complexity.')),
        AsyncFunctionDef(
          name='run_async',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='strategy',
                annotation=Name(id='StrategyPlan', ctx=Load())),
              arg(
                arg='complexity',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='workflow_id',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='log_info',
                  ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='Engineering prompts (Complexity: '),
                      FormattedValue(
                        value=Name(id='complexity', ctx=Load()),
                        conversion=-1),
                      Constant(value=')...')])])),
            Assign(
              targets=[
                Name(id='client', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='get_model_client',
                  ctx=Load()),
                args=[
                  Constant(value='prompt_engineer_model')])),
            Assign(
              targets=[
                Name(id='meta_prompt_template', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='prompt_manager',
                    ctx=Load()),
                  attr='get_template',
                  ctx=Load()),
                args=[
                  Constant(value='prompt_engineer')])),
            Assign(
              targets=[
                Name(id='meta_prompt', ctx=Store())],
              value=Await(
                value=Call(
                  func=Name(id='_format_prompt_with_defaults', ctx=Load()),
                  args=[
                    Name(id='meta_prompt_template', ctx=Load()),
                    Dict(
                      keys=[
                        Constant(value='strategy'),
                        Constant(value='complexity'),
                        Constant(value='style_guide'),
                        Constant(value='job_description')],
                      values=[
                        Call(
                          func=Attribute(
                            value=Name(id='strategy', ctx=Load()),
                            attr='model_dump_json',
                            ctx=Load())),
                        Name(id='complexity', ctx=Load()),
                        Constant(value='Style: Generate clear, role-appropriate prompts.'),
                        Constant(value='N/A')]),
                    Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='budget_manager',
                      ctx=Load()),
                    Attribute(
                      value=Name(id='client', ctx=Load()),
                      attr='goal_state',
                      ctx=Load()),
                    Attribute(
                      value=Name(id='client', ctx=Load()),
                      attr='top_failures',
                      ctx=Load())]))),
            Assign(
              targets=[
                Name(id='response', ctx=Store())],
              value=Await(
                value=Call(
                  func=Attribute(
                    value=Name(id='client', ctx=Load()),
                    attr='chat_completion_async',
                    ctx=Load()),
                  keywords=[
                    keyword(
                      arg='messages',
                      value=List(
                        elts=[
                          Dict(
                            keys=[
                              Constant(value='role'),
                              Constant(value='content')],
                            values=[
                              Constant(value='user'),
                              Name(id='meta_prompt', ctx=Load())])],
                        ctx=Load())),
                    keyword(
                      arg='temperature',
                      value=Attribute(
                        value=Attribute(
                          value=Attribute(
                            value=Attribute(
                              value=Name(id='self', ctx=Load()),
                              attr='config',
                              ctx=Load()),
                            attr='model_config',
                            ctx=Load()),
                          attr='prompt_engineer_model',
                          ctx=Load()),
                        attr='temperature',
                        ctx=Load())),
                    keyword(
                      arg='response_format',
                      value=Constant(value='json_object'))]))),
            Assign(
              targets=[
                Tuple(
                  elts=[
                    Name(id='validated_output', ctx=Store()),
                    Name(id='error', ctx=Store())],
                  ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='validator',
                    ctx=Load()),
                  attr='validate',
                  ctx=Load()),
                args=[
                  Subscript(
                    value=Name(id='response', ctx=Load()),
                    slice=Constant(value='content'),
                    ctx=Load()),
                  Name(id='GeneratedPrompts', ctx=Load())])),
            If(
              test=Name(id='error', ctx=Load()),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='log_error',
                      ctx=Load()),
                    args=[
                      JoinedStr(
                        values=[
                          Constant(value='PromptEngineerAgent failed validation: '),
                          FormattedValue(
                            value=Name(id='error', ctx=Load()),
                            conversion=-1),
                          Constant(value='. Returning baseline prompts.')])])),
                Raise(
                  exc=Call(
                    func=Name(id='ValidationError', ctx=Load()),
                    args=[
                      Name(id='error', ctx=Load())]))]),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='log_feedback',
                  ctx=Load()),
                args=[
                  Name(id='workflow_id', ctx=Load()),
                  Constant(value='prompt_engineering'),
                  Constant(value='success'),
                  Dict(
                    keys=[
                      Constant(value='prompt_count')],
                    values=[
                      Call(
                        func=Name(id='len', ctx=Load()),
                        args=[
                          Attribute(
                            value=Name(id='validated_output', ctx=Load()),
                            attr='prompts',
                            ctx=Load())])])])),
            Return(
              value=Dict(
                keys=[
                  Constant(value='prompts'),
                  Constant(value='complexity')],
                values=[
                  Name(id='validated_output', ctx=Load()),
                  Name(id='complexity', ctx=Load())]))],
          decorator_list=[
            Call(
              func=Name(id='track_metrics', ctx=Load()),
              args=[
                Constant(value='run_prompt_engineer')])],
          returns=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='Any', ctx=Load())],
              ctx=Load()),
            ctx=Load()))])])