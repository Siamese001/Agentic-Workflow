Module(
  body=[
    Expr(
      value=Constant(value='E2E check that value claims include evidence anchors.')),
    ImportFrom(
      module='__future__',
      names=[
        alias(name='annotations')],
      level=0),
    ImportFrom(
      module='types',
      names=[
        alias(name='SimpleNamespace')],
      level=0),
    ImportFrom(
      module='src.lic_agentic.agents.k3_message_architect',
      names=[
        alias(name='MessageArchitect')],
      level=0),
    ImportFrom(
      module='src.lic_agentic.reasoning.toggles',
      names=[
        alias(name='ReasoningToggles')],
      level=0),
    FunctionDef(
      name='extract_artifact_markers',
      args=arguments(
        args=[
          arg(
            arg='draft',
            annotation=Name(id='str', ctx=Load()))]),
      body=[
        Return(
          value=ListComp(
            elt=Name(id='line', ctx=Load()),
            generators=[
              comprehension(
                target=Name(id='line', ctx=Store()),
                iter=Call(
                  func=Attribute(
                    value=Name(id='draft', ctx=Load()),
                    attr='splitlines',
                    ctx=Load())),
                ifs=[
                  Call(
                    func=Attribute(
                      value=Name(id='line', ctx=Load()),
                      attr='startswith',
                      ctx=Load()),
                    args=[
                      Constant(value='[artifact_id:')])],
                is_async=0)]))],
      returns=Subscript(
        value=Name(id='list', ctx=Load()),
        slice=Name(id='str', ctx=Load()),
        ctx=Load())),
    FunctionDef(
      name='test_value_claims_are_anchored',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='toggles', ctx=Store())],
          value=Call(
            func=Name(id='ReasoningToggles', ctx=Load()))),
        Assign(
          targets=[
            Name(id='architect', ctx=Store())],
          value=Call(
            func=Name(id='MessageArchitect', ctx=Load()),
            args=[
              Name(id='toggles', ctx=Load())])),
        Assign(
          targets=[
            Name(id='sanitized', ctx=Store())],
          value=Call(
            func=Name(id='SimpleNamespace', ctx=Load()),
            keywords=[
              keyword(
                arg='prompt',
                value=Constant(value='Update on strategic wins')),
              keyword(
                arg='company_id',
                value=Constant(value='ACME')),
              keyword(
                arg='contact_id',
                value=Constant(value='C1'))])),
        Assign(
          targets=[
            Name(id='plan', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='architect', ctx=Load()),
              attr='_build_plan',
              ctx=Load()),
            args=[
              List(
                elts=[
                  Constant(value='ACME latest milestones'),
                  Constant(value='ACME recent news'),
                  Constant(value='C1 profile highlights')],
                ctx=Load()),
              Name(id='sanitized', ctx=Load())])),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='plan', ctx=Load()),
              attr='dedupe',
              ctx=Load()))),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='plan', ctx=Load()),
              attr='budget',
              ctx=Load()),
            keywords=[
              keyword(
                arg='max_calls',
                value=Constant(value=6))])),
        Assign(
          targets=[
            Name(id='outcomes', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='plan', ctx=Load()),
              attr='execute',
              ctx=Load()),
            args=[
              Attribute(
                value=Name(id='architect', ctx=Load()),
                attr='tool_registry',
                ctx=Load()),
              Attribute(
                value=Name(id='architect', ctx=Load()),
                attr='content_store',
                ctx=Load())])),
        Assign(
          targets=[
            Name(id='expected_markers', ctx=Store())],
          value=Call(
            func=Name(id='len', ctx=Load()),
            args=[
              Name(id='outcomes', ctx=Load())])),
        Assign(
          targets=[
            Name(id='package', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='architect', ctx=Load()),
              attr='compose',
              ctx=Load()),
            args=[
              Name(id='sanitized', ctx=Load())],
            keywords=[
              keyword(
                arg='route_decision',
                value=Constant(value=None))])),
        Assign(
          targets=[
            Name(id='markers', ctx=Store())],
          value=Call(
            func=Name(id='extract_artifact_markers', ctx=Load()),
            args=[
              Attribute(
                value=Name(id='package', ctx=Load()),
                attr='draft',
                ctx=Load())])),
        Assert(
          test=Name(id='markers', ctx=Load()),
          msg=Constant(value='Expected at least one artifact marker in the draft')),
        Assert(
          test=Compare(
            left=Call(
              func=Name(id='len', ctx=Load()),
              args=[
                Name(id='markers', ctx=Load())]),
            ops=[
              Eq()],
            comparators=[
              Name(id='expected_markers', ctx=Load())]))])])