Module(
  body=[
    Expr(
      value=Constant(value='Prompt injection detection heuristics for the outreach stack.')),
    ImportFrom(
      module='__future__',
      names=[
        alias(name='annotations')],
      level=0),
    ImportFrom(
      module='dataclasses',
      names=[
        alias(name='dataclass')],
      level=0),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Iterable')],
      level=0),
    AnnAssign(
      target=Name(id='_HIGH_RISK_KEYWORDS', ctx=Store()),
      annotation=Subscript(
        value=Name(id='Iterable', ctx=Load()),
        slice=Name(id='str', ctx=Load()),
        ctx=Load()),
      value=Tuple(
        elts=[
          Constant(value='ignore previous instructions'),
          Constant(value='exfiltrate'),
          Constant(value='password'),
          Constant(value='disable safety'),
          Constant(value='run shell')],
        ctx=Load()),
      simple=1),
    AnnAssign(
      target=Name(id='_MEDIUM_RISK_KEYWORDS', ctx=Store()),
      annotation=Subscript(
        value=Name(id='Iterable', ctx=Load()),
        slice=Name(id='str', ctx=Load()),
        ctx=Load()),
      value=Tuple(
        elts=[
          Constant(value='bypass'),
          Constant(value='override'),
          Constant(value='forget the rules')],
        ctx=Load()),
      simple=1),
    ClassDef(
      name='InjectionFinding',
      body=[
        Expr(
          value=Constant(value='Represents the outcome of a prompt-injection scan.')),
        AnnAssign(
          target=Name(id='is_injection', ctx=Store()),
          annotation=Name(id='bool', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='severity', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='rationale', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1)],
      decorator_list=[
        Call(
          func=Name(id='dataclass', ctx=Load()),
          keywords=[
            keyword(
              arg='frozen',
              value=Constant(value=True))])]),
    FunctionDef(
      name='_score_prompt',
      args=arguments(
        args=[
          arg(
            arg='prompt',
            annotation=Name(id='str', ctx=Load()))]),
      body=[
        Assign(
          targets=[
            Name(id='lowered', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='prompt', ctx=Load()),
              attr='lower',
              ctx=Load()))),
        For(
          target=Name(id='keyword', ctx=Store()),
          iter=Name(id='_HIGH_RISK_KEYWORDS', ctx=Load()),
          body=[
            If(
              test=Compare(
                left=Name(id='keyword', ctx=Load()),
                ops=[
                  In()],
                comparators=[
                  Name(id='lowered', ctx=Load())]),
              body=[
                Return(
                  value=Tuple(
                    elts=[
                      Constant(value=2),
                      JoinedStr(
                        values=[
                          Constant(value="High risk keyword detected: '"),
                          FormattedValue(
                            value=Name(id='keyword', ctx=Load()),
                            conversion=-1),
                          Constant(value="'")])],
                    ctx=Load()))])]),
        For(
          target=Name(id='keyword', ctx=Store()),
          iter=Name(id='_MEDIUM_RISK_KEYWORDS', ctx=Load()),
          body=[
            If(
              test=Compare(
                left=Name(id='keyword', ctx=Load()),
                ops=[
                  In()],
                comparators=[
                  Name(id='lowered', ctx=Load())]),
              body=[
                Return(
                  value=Tuple(
                    elts=[
                      Constant(value=1),
                      JoinedStr(
                        values=[
                          Constant(value="Medium risk keyword detected: '"),
                          FormattedValue(
                            value=Name(id='keyword', ctx=Load()),
                            conversion=-1),
                          Constant(value="'")])],
                    ctx=Load()))])]),
        Return(
          value=Tuple(
            elts=[
              Constant(value=0),
              Constant(value='No malicious intent detected')],
            ctx=Load()))],
      returns=Subscript(
        value=Name(id='tuple', ctx=Load()),
        slice=Tuple(
          elts=[
            Name(id='int', ctx=Load()),
            Name(id='str', ctx=Load())],
          ctx=Load()),
        ctx=Load())),
    FunctionDef(
      name='detect_injection',
      args=arguments(
        args=[
          arg(
            arg='prompt',
            annotation=Name(id='str', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='Detect whether *prompt* looks like a prompt-injection attempt.')),
        Assign(
          targets=[
            Tuple(
              elts=[
                Name(id='score', ctx=Store()),
                Name(id='rationale', ctx=Store())],
              ctx=Store())],
          value=Call(
            func=Name(id='_score_prompt', ctx=Load()),
            args=[
              Name(id='prompt', ctx=Load())])),
        If(
          test=Compare(
            left=Name(id='score', ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value=2)]),
          body=[
            Return(
              value=Call(
                func=Name(id='InjectionFinding', ctx=Load()),
                args=[
                  Constant(value=True),
                  Constant(value='high'),
                  Name(id='rationale', ctx=Load())]))]),
        If(
          test=Compare(
            left=Name(id='score', ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value=1)]),
          body=[
            Return(
              value=Call(
                func=Name(id='InjectionFinding', ctx=Load()),
                args=[
                  Constant(value=True),
                  Constant(value='med'),
                  Name(id='rationale', ctx=Load())]))]),
        Return(
          value=Call(
            func=Name(id='InjectionFinding', ctx=Load()),
            args=[
              Constant(value=False),
              Constant(value='low'),
              Name(id='rationale', ctx=Load())]))],
      returns=Name(id='InjectionFinding', ctx=Load()))])