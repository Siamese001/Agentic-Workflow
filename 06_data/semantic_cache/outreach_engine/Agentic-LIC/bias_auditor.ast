Module(
  body=[
    Expr(
      value=Constant(value='Minimal bias auditor stub used for safety-aware routing.')),
    ImportFrom(
      module='__future__',
      names=[
        alias(name='annotations')],
      level=0),
    ImportFrom(
      module='dataclasses',
      names=[
        alias(name='dataclass')],
      level=0),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Dict')],
      level=0),
    ClassDef(
      name='BiasAssessment',
      body=[
        AnnAssign(
          target=Name(id='score', ctx=Store()),
          annotation=Name(id='float', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='notes', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1)],
      decorator_list=[
        Call(
          func=Name(id='dataclass', ctx=Load()),
          keywords=[
            keyword(
              arg='frozen',
              value=Constant(value=True))])]),
    FunctionDef(
      name='audit_bias',
      args=arguments(
        args=[
          arg(arg='inputs')]),
      body=[
        Expr(
          value=Constant(value='Return a light-weight bias score for *inputs*.')),
        Assign(
          targets=[
            Name(id='prompt', ctx=Store())],
          value=Call(
            func=Name(id='getattr', ctx=Load()),
            args=[
              Name(id='inputs', ctx=Load()),
              Constant(value='prompt'),
              Call(
                func=Name(id='getattr', ctx=Load()),
                args=[
                  Name(id='inputs', ctx=Load()),
                  Constant(value='prompt'),
                  Constant(value='')])])),
        If(
          test=UnaryOp(
            op=Not(),
            operand=Name(id='prompt', ctx=Load())),
          body=[
            Return(
              value=Call(
                func=Name(id='BiasAssessment', ctx=Load()),
                args=[
                  Constant(value=0.0),
                  Constant(value='Empty prompt, no bias risk')]))]),
        Assign(
          targets=[
            Name(id='score', ctx=Store())],
          value=IfExp(
            test=Compare(
              left=Constant(value='diversity'),
              ops=[
                In()],
              comparators=[
                Call(
                  func=Attribute(
                    value=Name(id='prompt', ctx=Load()),
                    attr='lower',
                    ctx=Load()))]),
            body=Constant(value=0.1),
            orelse=Constant(value=0.0))),
        Assign(
          targets=[
            Name(id='notes', ctx=Store())],
          value=IfExp(
            test=Name(id='score', ctx=Load()),
            body=Constant(value='Detected inclusive language'),
            orelse=Constant(value='No flagged bias'))),
        Return(
          value=Call(
            func=Name(id='BiasAssessment', ctx=Load()),
            args=[
              Name(id='score', ctx=Load()),
              Name(id='notes', ctx=Load())]))],
      returns=Name(id='BiasAssessment', ctx=Load()))])