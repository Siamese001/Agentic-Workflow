Module(
  body=[
    ImportFrom(
      module='src.lic_agentic.rag.tool_registry',
      names=[
        alias(name='BaseTool'),
        alias(name='ToolRegistry'),
        alias(name='ToolResult'),
        alias(name='default_registry')],
      level=0),
    ClassDef(
      name='DummyTool',
      bases=[
        Name(id='BaseTool', ctx=Load())],
      body=[
        Assign(
          targets=[
            Name(id='name', ctx=Store())],
          value=Constant(value='dummy')),
        Assign(
          targets=[
            Name(id='cost', ctx=Store())],
          value=Constant(value=0.1)),
        FunctionDef(
          name='run',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='query',
                annotation=Name(id='str', ctx=Load())),
              arg(arg='context')]),
          body=[
            Return(
              value=Call(
                func=Name(id='ToolResult', ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='answer for '),
                      FormattedValue(
                        value=Name(id='query', ctx=Load()),
                        conversion=-1)]),
                  List(
                    elts=[
                      Constant(value='http://dummy')],
                    ctx=Load()),
                  Constant(value=42),
                  Constant(value=0.9)]))])]),
    FunctionDef(
      name='test_tool_registration_and_execution',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='registry', ctx=Store())],
          value=Call(
            func=Name(id='ToolRegistry', ctx=Load()))),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='registry', ctx=Load()),
              attr='register',
              ctx=Load()),
            args=[
              Call(
                func=Name(id='DummyTool', ctx=Load()))])),
        Assign(
          targets=[
            Name(id='tool', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='registry', ctx=Load()),
              attr='resolve',
              ctx=Load()),
            args=[
              Constant(value='dummy')])),
        Assert(
          test=Call(
            func=Name(id='isinstance', ctx=Load()),
            args=[
              Name(id='tool', ctx=Load()),
              Name(id='DummyTool', ctx=Load())])),
        Assign(
          targets=[
            Name(id='result', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='tool', ctx=Load()),
              attr='run',
              ctx=Load()),
            args=[
              Constant(value='query'),
              Dict()])),
        Assert(
          test=Call(
            func=Name(id='isinstance', ctx=Load()),
            args=[
              Name(id='result', ctx=Load()),
              Name(id='ToolResult', ctx=Load())])),
        Assert(
          test=Compare(
            left=Attribute(
              value=Name(id='result', ctx=Load()),
              attr='confidence',
              ctx=Load()),
            ops=[
              GtE()],
            comparators=[
              Constant(value=0.0)]))]),
    FunctionDef(
      name='test_default_registry_includes_builtin_tools',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='registry', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='ToolRegistry', ctx=Load()),
              attr='default_with_builtins',
              ctx=Load()))),
        For(
          target=Name(id='name', ctx=Store()),
          iter=Tuple(
            elts=[
              Constant(value='web_search'),
              Constant(value='profile_lookup'),
              Constant(value='news')],
            ctx=Load()),
          body=[
            Assert(
              test=Compare(
                left=Name(id='name', ctx=Load()),
                ops=[
                  In()],
                comparators=[
                  Call(
                    func=Attribute(
                      value=Name(id='registry', ctx=Load()),
                      attr='available',
                      ctx=Load()))]))])]),
    FunctionDef(
      name='test_resolve_missing_tool_raises_key_error',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='registry', ctx=Store())],
          value=Call(
            func=Name(id='ToolRegistry', ctx=Load()))),
        Try(
          body=[
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='registry', ctx=Load()),
                  attr='resolve',
                  ctx=Load()),
                args=[
                  Constant(value='missing')]))],
          handlers=[
            ExceptHandler(
              type=Name(id='KeyError', ctx=Load()),
              name='exc',
              body=[
                Assert(
                  test=Compare(
                    left=Constant(value='missing'),
                    ops=[
                      In()],
                    comparators=[
                      Call(
                        func=Name(id='str', ctx=Load()),
                        args=[
                          Name(id='exc', ctx=Load())])]))])],
          orelse=[
            Raise(
              exc=Call(
                func=Name(id='AssertionError', ctx=Load()),
                args=[
                  Constant(value='Expected KeyError for missing tool')]))])]),
    FunctionDef(
      name='test_default_registry_factory_matches_classmethod',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='registry_fn', ctx=Store())],
          value=Call(
            func=Name(id='default_registry', ctx=Load()))),
        Assign(
          targets=[
            Name(id='registry_cls', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='ToolRegistry', ctx=Load()),
              attr='default_with_builtins',
              ctx=Load()))),
        Assert(
          test=Compare(
            left=Call(
              func=Attribute(
                value=Name(id='registry_fn', ctx=Load()),
                attr='available',
                ctx=Load())),
            ops=[
              Eq()],
            comparators=[
              Call(
                func=Attribute(
                  value=Name(id='registry_cls', ctx=Load()),
                  attr='available',
                  ctx=Load()))]))])])