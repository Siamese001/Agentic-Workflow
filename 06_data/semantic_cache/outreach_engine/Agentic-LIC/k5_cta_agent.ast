Module(
  body=[
    Expr(
      value=Constant(value='Refine the call-to-action portion of the draft.')),
    ImportFrom(
      module='__future__',
      names=[
        alias(name='annotations')],
      level=0),
    ClassDef(
      name='CTAAgent',
      body=[
        FunctionDef(
          name='adjust',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='draft',
                annotation=Name(id='str', ctx=Load())),
              arg(arg='route_decision')]),
          body=[
            Assign(
              targets=[
                Name(id='cta_line', ctx=Store())],
              value=Constant(value='CTA: Would you be open to a 15-minute chat next week?')),
            Return(
              value=JoinedStr(
                values=[
                  FormattedValue(
                    value=Name(id='draft', ctx=Load()),
                    conversion=-1),
                  Constant(value='\n\n'),
                  FormattedValue(
                    value=Name(id='cta_line', ctx=Load()),
                    conversion=-1)]))],
          returns=Name(id='str', ctx=Load()))])])