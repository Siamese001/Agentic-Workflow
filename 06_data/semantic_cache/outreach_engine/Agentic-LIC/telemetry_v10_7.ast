Module(
  body=[
    Expr(
      value=Constant(value='Telemetry helpers emitting MCP-compatible events.')),
    ImportFrom(
      module='__future__',
      names=[
        alias(name='annotations')],
      level=0),
    Import(
      names=[
        alias(name='logging')]),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Any'),
        alias(name='Dict'),
        alias(name='Optional')],
      level=0),
    ImportFrom(
      module='mcp',
      names=[
        alias(name='emit_event')],
      level=0),
    Assign(
      targets=[
        Name(id='logger', ctx=Store())],
      value=Call(
        func=Attribute(
          value=Name(id='logging', ctx=Load()),
          attr='getLogger',
          ctx=Load()),
        args=[
          Constant(value='telemetry_v10_7')])),
    FunctionDef(
      name='log_event',
      args=arguments(
        args=[
          arg(
            arg='agent',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='event',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='data',
            annotation=Subscript(
              value=Name(id='Optional', ctx=Load()),
              slice=Subscript(
                value=Name(id='Dict', ctx=Load()),
                slice=Tuple(
                  elts=[
                    Name(id='str', ctx=Load()),
                    Name(id='Any', ctx=Load())],
                  ctx=Load()),
                ctx=Load()),
              ctx=Load()))],
        defaults=[
          Constant(value=None)]),
      body=[
        Expr(
          value=Constant(value='Emit a telemetry event while preserving local logging.')),
        Assign(
          targets=[
            Name(id='payload', ctx=Store())],
          value=Dict(
            keys=[
              Constant(value='agent'),
              Constant(value='event'),
              Constant(value='payload')],
            values=[
              Name(id='agent', ctx=Load()),
              Name(id='event', ctx=Load()),
              BoolOp(
                op=Or(),
                values=[
                  Name(id='data', ctx=Load()),
                  Dict()])])),
        Expr(
          value=Call(
            func=Name(id='emit_event', ctx=Load()),
            args=[
              Name(id='payload', ctx=Load())])),
        Expr(
          value=Call(
            func=Attribute(
              value=Name(id='logger', ctx=Load()),
              attr='debug',
              ctx=Load()),
            args=[
              Constant(value='Telemetry emitted: %s - %s'),
              Name(id='agent', ctx=Load()),
              Name(id='event', ctx=Load())]))],
      returns=Constant(value=None)),
    Assign(
      targets=[
        Name(id='__all__', ctx=Store())],
      value=List(
        elts=[
          Constant(value='log_event')],
        ctx=Load()))])