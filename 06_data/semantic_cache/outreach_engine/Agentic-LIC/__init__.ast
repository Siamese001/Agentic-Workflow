Module(
  body=[
    Expr(
      value=Constant(value='Stack-specific agent implementations for v10.7.')),
    ImportFrom(
      module='models',
      names=[
        alias(name='SpecialistDraftPacket'),
        alias(name='EvidenceClarificationRecord'),
        alias(name='EvidenceBriefRecord'),
        alias(name='EvidenceLiaisonPacket'),
        alias(name='CritiqueFindingRecord'),
        alias(name='CritiquePanelPacket')],
      level=1),
    ImportFrom(
      module='safety',
      names=[
        alias(name='PIISanitizerAgent'),
        alias(name='BiasDetectorAgent'),
        alias(name='PromptInjectionDetectorAgent'),
        alias(name='ConstitutionalReviewerAgent')],
      level=1),
    ImportFrom(
      module='strategy',
      names=[
        alias(name='QueryComplexityClassifier'),
        alias(name='ToTStrategistAgent')],
      level=1),
    ImportFrom(
      module='prompting',
      names=[
        alias(name='PromptEngineerAgent')],
      level=1),
    ImportFrom(
      module='rag',
      names=[
        alias(name='RAG_SearchAgent')],
      level=1),
    ImportFrom(
      module='drafting',
      names=[
        alias(name='StructureLeadAgent'),
        alias(name='NarrativeStylistAgent'),
        alias(name='ComplianceEditorAgent'),
        alias(name='EvidenceLiaisonAgent'),
        alias(name='CritiqueRoutingPanel'),
        alias(name='DraftingGuildCoordinator')],
      level=1),
    ImportFrom(
      module='bullet',
      names=[
        alias(name='BulletEntityExtractionAgent'),
        alias(name='BulletMetricsEnrichmentAgent'),
        alias(name='BulletNarrativeSynthesisAgent'),
        alias(name='BulletEvidenceLinkerAgent'),
        alias(name='BulletConfidenceScoringAgent'),
        alias(name='BulletCoordinatorAgent'),
        alias(name='BulletProvenanceAuditorAgent'),
        alias(name='AsyncBulletGeneratorAgent'),
        alias(name='AsyncBulletCritiqueAgent')],
      level=1),
    ImportFrom(
      module='hil',
      names=[
        alias(name='VirtualReviewerPersonaAgent'),
        alias(name='VirtualReviewerCouncilAgent'),
        alias(name='HILFeedbackSummarizerAgent'),
        alias(name='HILReconciliationAgent'),
        alias(name='HILAmbiguityDetectorAgent'),
        alias(name='HILFeedbackRouterAgent')],
      level=1),
    Assign(
      targets=[
        Name(id='__all__', ctx=Store())],
      value=List(
        elts=[
          Constant(value='SpecialistDraftPacket'),
          Constant(value='EvidenceClarificationRecord'),
          Constant(value='EvidenceBriefRecord'),
          Constant(value='EvidenceLiaisonPacket'),
          Constant(value='CritiqueFindingRecord'),
          Constant(value='CritiquePanelPacket'),
          Constant(value='PIISanitizerAgent'),
          Constant(value='BiasDetectorAgent'),
          Constant(value='PromptInjectionDetectorAgent'),
          Constant(value='ConstitutionalReviewerAgent'),
          Constant(value='QueryComplexityClassifier'),
          Constant(value='ToTStrategistAgent'),
          Constant(value='PromptEngineerAgent'),
          Constant(value='RAG_SearchAgent'),
          Constant(value='StructureLeadAgent'),
          Constant(value='NarrativeStylistAgent'),
          Constant(value='ComplianceEditorAgent'),
          Constant(value='EvidenceLiaisonAgent'),
          Constant(value='CritiqueRoutingPanel'),
          Constant(value='DraftingGuildCoordinator'),
          Constant(value='BulletEntityExtractionAgent'),
          Constant(value='BulletMetricsEnrichmentAgent'),
          Constant(value='BulletNarrativeSynthesisAgent'),
          Constant(value='BulletEvidenceLinkerAgent'),
          Constant(value='BulletConfidenceScoringAgent'),
          Constant(value='BulletCoordinatorAgent'),
          Constant(value='BulletProvenanceAuditorAgent'),
          Constant(value='AsyncBulletGeneratorAgent'),
          Constant(value='AsyncBulletCritiqueAgent'),
          Constant(value='VirtualReviewerPersonaAgent'),
          Constant(value='VirtualReviewerCouncilAgent'),
          Constant(value='HILFeedbackSummarizerAgent'),
          Constant(value='HILReconciliationAgent'),
          Constant(value='HILAmbiguityDetectorAgent'),
          Constant(value='HILFeedbackRouterAgent')],
        ctx=Load()))])