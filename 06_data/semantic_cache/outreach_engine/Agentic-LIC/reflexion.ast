Module(
  body=[
    Expr(
      value=Constant(value='Simple reflexion scoring helpers.')),
    ImportFrom(
      module='__future__',
      names=[
        alias(name='annotations')],
      level=0),
    FunctionDef(
      name='apply_feedback',
      args=arguments(
        args=[
          arg(
            arg='draft',
            annotation=Name(id='str', ctx=Load())),
          arg(
            arg='insight',
            annotation=Name(id='str', ctx=Load()))]),
      body=[
        If(
          test=UnaryOp(
            op=Not(),
            operand=Name(id='insight', ctx=Load())),
          body=[
            Return(
              value=Name(id='draft', ctx=Load()))]),
        Return(
          value=JoinedStr(
            values=[
              FormattedValue(
                value=Name(id='draft', ctx=Load()),
                conversion=-1),
              Constant(value='\n\nReflexion: '),
              FormattedValue(
                value=Name(id='insight', ctx=Load()),
                conversion=-1)]))],
      returns=Name(id='str', ctx=Load()))])