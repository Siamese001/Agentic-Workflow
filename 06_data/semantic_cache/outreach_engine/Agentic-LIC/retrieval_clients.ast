Module(
  body=[
    Assign(
      targets=[
        Name(id='__version__', ctx=Store())],
      value=Constant(value='12.0')),
    Import(
      names=[
        alias(name='os')]),
    ImportFrom(
      module='googleapiclient.discovery',
      names=[
        alias(name='build')],
      level=0),
    ImportFrom(
      module='utils_LIC',
      names=[
        alias(name='CircuitBreaker'),
        alias(name='CircuitBreakerOpenError')],
      level=0),
    ClassDef(
      name='GoogleSearchClient',
      body=[
        Expr(
          value=Constant(value='\n    Centralized client for all Google Custom Search API calls with circuit breaker protection\n    ')),
        FunctionDef(
          name='__init__',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='circuit_breaker',
                annotation=Name(id='CircuitBreaker', ctx=Load()))]),
          body=[
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='api_key',
                  ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='os', ctx=Load()),
                    attr='environ',
                    ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='GOOGLE_API_KEY')])),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='cse_id',
                  ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='os', ctx=Load()),
                    attr='environ',
                    ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='GOOGLE_CSE_ID')])),
            If(
              test=UnaryOp(
                op=Not(),
                operand=BoolOp(
                  op=And(),
                  values=[
                    Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='api_key',
                      ctx=Load()),
                    Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='cse_id',
                      ctx=Load())])),
              body=[
                Raise(
                  exc=Call(
                    func=Name(id='ValueError', ctx=Load()),
                    args=[
                      Constant(value='GOOGLE_API_KEY or GOOGLE_CSE_ID not found in environment')]))]),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='service',
                  ctx=Store())],
              value=Call(
                func=Name(id='build', ctx=Load()),
                args=[
                  Constant(value='customsearch'),
                  Constant(value='v1')],
                keywords=[
                  keyword(
                    arg='developerKey',
                    value=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='api_key',
                      ctx=Load()))])),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='circuit_breaker',
                  ctx=Store())],
              value=Name(id='circuit_breaker', ctx=Load()))]),
        FunctionDef(
          name='_execute_search_call',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='query',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='num_results',
                annotation=Name(id='int', ctx=Load()))],
            defaults=[
              Constant(value=5)]),
          body=[
            Expr(
              value=Constant(value='Execute the actual search API call')),
            Assign(
              targets=[
                Name(id='res', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Call(
                    func=Attribute(
                      value=Call(
                        func=Attribute(
                          value=Attribute(
                            value=Name(id='self', ctx=Load()),
                            attr='service',
                            ctx=Load()),
                          attr='cse',
                          ctx=Load())),
                      attr='list',
                      ctx=Load()),
                    keywords=[
                      keyword(
                        arg='q',
                        value=Name(id='query', ctx=Load())),
                      keyword(
                        arg='cx',
                        value=Attribute(
                          value=Name(id='self', ctx=Load()),
                          attr='cse_id',
                          ctx=Load())),
                      keyword(
                        arg='num',
                        value=Name(id='num_results', ctx=Load()))]),
                  attr='execute',
                  ctx=Load()))),
            Return(
              value=Call(
                func=Attribute(
                  value=Name(id='res', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='items'),
                  List(ctx=Load())]))],
          returns=Name(id='list', ctx=Load())),
        FunctionDef(
          name='search',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='query',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='num_results',
                annotation=Name(id='int', ctx=Load()))],
            defaults=[
              Constant(value=5)]),
          body=[
            Expr(
              value=Constant(value='\n        Execute search with circuit breaker protection\n        \n        Args:\n            query: Search query string\n            num_results: Number of results to return (default 5)\n            \n        Returns:\n            List of search result items\n            \n        Raises:\n            Exception: If API call fails\n            CircuitBreakerOpenError: If circuit breaker is OPEN\n        ')),
            Try(
              body=[
                Return(
                  value=Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='circuit_breaker',
                        ctx=Load()),
                      attr='call',
                      ctx=Load()),
                    args=[
                      Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='_execute_search_call',
                        ctx=Load()),
                      Name(id='query', ctx=Load())],
                    keywords=[
                      keyword(
                        arg='num_results',
                        value=Name(id='num_results', ctx=Load()))]))],
              handlers=[
                ExceptHandler(
                  type=Name(id='Exception', ctx=Load()),
                  name='e',
                  body=[
                    Raise(
                      exc=Call(
                        func=Name(id='Exception', ctx=Load()),
                        args=[
                          JoinedStr(
                            values=[
                              Constant(value='Google Search API call failed: '),
                              FormattedValue(
                                value=Name(id='e', ctx=Load()),
                                conversion=-1)])]))])])],
          returns=Name(id='list', ctx=Load()))])])