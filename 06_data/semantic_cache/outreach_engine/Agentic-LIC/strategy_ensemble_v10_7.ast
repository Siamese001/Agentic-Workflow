              value=Name(id='text', ctx=Load()))]),
        Return(
          value=BinOp(
            left=Subscript(
              value=Name(id='text', ctx=Load()),
              slice=Slice(
                upper=BinOp(
                  left=Name(id='limit', ctx=Load()),
                  op=Sub(),
                  right=Constant(value=3))),
              ctx=Load()),
            op=Add(),
            right=Constant(value='...')))],
      returns=Name(id='str', ctx=Load())),
    ClassDef(
