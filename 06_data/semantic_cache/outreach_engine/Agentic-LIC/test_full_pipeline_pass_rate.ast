Module(
  body=[
    ImportFrom(
      module='types',
      names=[
        alias(name='SimpleNamespace')],
      level=0),
    ImportFrom(
      module='src.lic_agentic.reasoning.toggles',
      names=[
        alias(name='ReasoningToggles')],
      level=0),
    ImportFrom(
      module='src.lic_agentic.stacks.outreach_stack',
      names=[
        alias(name='OutreachStack')],
      level=0),
    FunctionDef(
      name='test_full_pipeline_pass_rate',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='stack', ctx=Store())],
          value=Call(
            func=Name(id='OutreachStack', ctx=Load()),
            args=[
              Call(
                func=Name(id='ReasoningToggles', ctx=Load()))])),
        Assign(
          targets=[
            Name(id='samples', ctx=Store())],
          value=List(
            elts=[
              Call(
                func=Name(id='SimpleNamespace', ctx=Load()),
                keywords=[
                  keyword(
                    arg='prompt',
                    value=Constant(value='Excited to connect')),
                  keyword(
                    arg='company_id',
                    value=Constant(value='ACME')),
                  keyword(
                    arg='contact_id',
                    value=Constant(value='C1'))]),
              Call(
                func=Name(id='SimpleNamespace', ctx=Load()),
                keywords=[
                  keyword(
                    arg='prompt',
                    value=Constant(value='Shared interest in innovation')),
                  keyword(
                    arg='company_id',
                    value=Constant(value='OMEGA')),
                  keyword(
                    arg='contact_id',
                    value=Constant(value='C2'))]),
              Call(
                func=Name(id='SimpleNamespace', ctx=Load()),
                keywords=[
                  keyword(
                    arg='prompt',
                    value=Constant(value='Curious about collaboration')),
                  keyword(
                    arg='company_id',
                    value=Constant(value='BETA')),
                  keyword(
                    arg='contact_id',
                    value=Constant(value='C3'))])],
            ctx=Load())),
        Assign(
          targets=[
            Name(id='passes', ctx=Store())],
          value=Constant(value=0)),
        For(
          target=Name(id='sample', ctx=Store()),
          iter=Name(id='samples', ctx=Load()),
          body=[
            Assign(
              targets=[
                Name(id='outcome', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='stack', ctx=Load()),
                  attr='run',
                  ctx=Load()),
                args=[
                  Name(id='sample', ctx=Load())])),
            Assign(
              targets=[
                Name(id='verdict', ctx=Store())],
              value=Subscript(
                value=Name(id='outcome', ctx=Load()),
                slice=Constant(value='verdict'),
                ctx=Load())),
            If(
              test=Attribute(
                value=Name(id='verdict', ctx=Load()),
                attr='passed',
                ctx=Load()),
              body=[
                AugAssign(
                  target=Name(id='passes', ctx=Store()),
                  op=Add(),
                  value=Constant(value=1))]),
            Assert(
              test=Compare(
                left=Constant(value='[artifact_id:'),
                ops=[
                  In()],
                comparators=[
                  Subscript(
                    value=Name(id='outcome', ctx=Load()),
                    slice=Constant(value='draft'),
                    ctx=Load())]))]),
        Assert(
          test=Compare(
            left=BinOp(
              left=Name(id='passes', ctx=Load()),
              op=Div(),
              right=Call(
                func=Name(id='len', ctx=Load()),
                args=[
                  Name(id='samples', ctx=Load())])),
            ops=[
              GtE()],
            comparators=[
              Constant(value=0.85)])),
        Assert(
          test=Compare(
            left=Call(
              func=Attribute(
                value=Attribute(
                  value=Attribute(
                    value=Name(id='stack', ctx=Load()),
                    attr='validator',
                    ctx=Load()),
                  attr='metrics',
                  ctx=Load()),
                attr='pass_rate',
                ctx=Load())),
            ops=[
              GtE()],
            comparators=[
              Constant(value=0.85)])),
        Assign(
          targets=[
            Name(id='failing_drafts', ctx=Store())],
          value=List(
            elts=[
              BinOp(
                left=BinOp(
                  left=Constant(value='Subject: Follow up\n\n'),
                  op=Add(),
                  right=Call(
                    func=Attribute(
                      value=Constant(value=' '),
                      attr='join',
                      ctx=Load()),
                    args=[
                      List(
                        elts=[
                          Constant(value='This detailed note maintains substantial context for evaluation'),
                          Constant(value='and demonstrates reflective intent with customer centric framing'),
                          Constant(value='while awaiting artifact grounding'),
                          Constant(value='The narrative reiterates partnership opportunities across multiple domains'),
                          Constant(value='and reinforces diligence in aligning outcomes with stakeholder needs')],
                        ctx=Load())])),
                op=Add(),
                right=Constant(value='\nCTA: Would a quick sync be useful?\nBest regards,\nLIC Outreach Bot')),
              BinOp(
                left=BinOp(
                  left=Constant(value='Subject: Quick ping\n\n'),
                  op=Add(),
                  right=Call(
                    func=Attribute(
                      value=Constant(value=' '),
                      attr='join',
                      ctx=Load()),
                    args=[
                      List(
                        elts=[
                          Constant(value='Here is another comprehensive paragraph designed to hold steady token counts'),
                          Constant(value='showing empathy and curiosity about mutual goals'),
                          Constant(value='pending reinforcement with evidence'),
                          Constant(value='The structure acknowledges prior interactions and commitments'),
                          Constant(value='and articulates the shared momentum behind the outreach')],
                        ctx=Load())])),
                op=Add(),
                right=Constant(value='\nCTA: Can we schedule a short intro?\nBest regards,\nLIC Outreach Bot'))],
            ctx=Load())),
        For(
          target=Name(id='failing', ctx=Store()),
          iter=Name(id='failing_drafts', ctx=Load()),
          body=[
            Assign(
              targets=[
                Name(id='verdict', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='stack', ctx=Load()),
                    attr='validator',
                    ctx=Load()),
                  attr='check',
                  ctx=Load()),
                args=[
                  Name(id='failing', ctx=Load())],
                keywords=[
                  keyword(
                    arg='route_decision',
                    value=Constant(value=None)),
                  keyword(arg='pii_map', value=Dict()),
                  keyword(
                    arg='artifacts',
                    value=Dict(
                      keys=[
                        Constant(value='aid')],
                      values=[
                        Constant(value='Grounded data point')]))])),
            Assert(
              test=Attribute(
                value=Name(id='verdict', ctx=Load()),
                attr='passed',
                ctx=Load()))]),
        Assert(
          test=Compare(
            left=Call(
              func=Attribute(
                value=Attribute(
                  value=Attribute(
                    value=Name(id='stack', ctx=Load()),
                    attr='validator',
                    ctx=Load()),
                  attr='metrics',
                  ctx=Load()),
                attr='retry_success_rate',
                ctx=Load())),
            ops=[
              GtE()],
            comparators=[
              Constant(value=0.8)])),
        Assert(
          test=Compare(
            left=Call(
              func=Attribute(
                value=Attribute(
                  value=Attribute(
                    value=Name(id='stack', ctx=Load()),
                    attr='validator',
                    ctx=Load()),
                  attr='metrics',
                  ctx=Load()),
                attr='token_drift',
                ctx=Load())),
            ops=[
              LtE()],
            comparators=[
              Constant(value=0.1)]))])])