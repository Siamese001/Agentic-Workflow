      targets=[
        Name(id='__version__', ctx=Store())],
      value=Constant(value='12.0')),
    Import(
      names=[
        alias(name='asyncio')]),
    Import(
      names=[
        alias(name='json')]),
    Import(
      names=[
        alias(name='sys')]),
    Import(
