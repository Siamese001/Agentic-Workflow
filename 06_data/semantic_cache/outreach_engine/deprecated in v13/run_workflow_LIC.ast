                            conversion=-1),
                          Constant(value=': '),
                          FormattedValue(
                            value=Name(id='e', ctx=Load()),
                            conversion=-1)])])),
                Expr(
                  value=Call(
                    func=Name(id='print', ctx=Load()),
                    args=[
                      JoinedStr(
                        values=[
                          Constant(value='Line '),
                          FormattedValue(
                            value=Attribute(
                              value=Name(id='e', ctx=Load()),
                              attr='lineno',
                              ctx=Load()),
                            conversion=-1),
                          Constant(value=', column '),
                          FormattedValue(
                            value=Attribute(
                              value=Name(id='e', ctx=Load()),
                              attr='colno',
                              ctx=Load()),
                            conversion=-1),
                          Constant(value=': '),
                          FormattedValue(
                            value=Attribute(
                              value=Name(id='e', ctx=Load()),
                              attr='msg',
                              ctx=Load()),
                            conversion=-1)])])),
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='sys', ctx=Load()),
                      attr='exit',
                      ctx=Load()),
                    args=[
                      Constant(value=1)]))])])],
      returns=Subscript(
        value=Name(id='Dict', ctx=Load()),
        slice=Tuple(
          elts=[
            Name(id='str', ctx=Load()),
            Name(id='Any', ctx=Load())],
          ctx=Load()),
        ctx=Load())),
    FunctionDef(
      name='validate_mission_input',
      args=arguments(
        args=[
          arg(
            arg='input_data',
            annotation=Subscript(
              value=Name(id='Dict', ctx=Load()),
              slice=Tuple(
                elts=[
                  Name(id='str', ctx=Load()),
                  Name(id='Any', ctx=Load())],
                ctx=Load()),
              ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Validate that mission input contains all required fields.\n    \n    Args:\n        input_data: Loaded mission input dictionary\n    \n    Returns:\n        True if valid, False otherwise\n    ')),
        Assign(
          targets=[
            Name(id='required_keys', ctx=Store())],
          value=List(
            elts=[
              Constant(value='sender_profile'),
              Constant(value='recipient_profile'),
              Constant(value='job_description')],
            ctx=Load())),
        Assign(
          targets=[
            Name(id='missing_keys', ctx=Store())],
          value=ListComp(
            elt=Name(id='key', ctx=Load()),
            generators=[
              comprehension(
                target=Name(id='key', ctx=Store()),
                iter=Name(id='required_keys', ctx=Load()),
                ifs=[
                  Compare(
                    left=Name(id='key', ctx=Load()),
                    ops=[
                      NotIn()],
                    comparators=[
                      Name(id='input_data', ctx=Load())])],
                is_async=0)])),
        If(
          test=Name(id='missing_keys', ctx=Load()),
          body=[
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='FATAL: mission_input_LIC.json is missing required keys: '),
                      FormattedValue(
                        value=Call(
                          func=Attribute(
                            value=Constant(value=', '),
                            attr='join',
                            ctx=Load()),
                          args=[
                            Name(id='missing_keys', ctx=Load())]),
                        conversion=-1)])])),
            Return(
              value=Constant(value=False))]),
        Assign(
          targets=[
            Name(id='sender_required', ctx=Store())],
          value=List(
            elts=[
              Constant(value='name'),
              Constant(value='title'),
              Constant(value='company')],
            ctx=Load())),
        Assign(
          targets=[
            Name(id='sender_missing', ctx=Store())],
          value=ListComp(
            elt=Name(id='key', ctx=Load()),
            generators=[
              comprehension(
                target=Name(id='key', ctx=Store()),
                iter=Name(id='sender_required', ctx=Load()),
                ifs=[
                  Compare(
                    left=Name(id='key', ctx=Load()),
                    ops=[
                      NotIn()],
                    comparators=[
                      Subscript(
                        value=Name(id='input_data', ctx=Load()),
                        slice=Constant(value='sender_profile'),
