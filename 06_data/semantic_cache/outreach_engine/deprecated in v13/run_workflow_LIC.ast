    FunctionDef(
      name='load_mission_input',
      args=arguments(
        args=[
          arg(
            arg='filename',
            annotation=Name(id='str', ctx=Load()))],
        defaults=[
          Constant(value='mission_input_LIC.json')]),
      body=[
        Expr(
          value=Constant(value='\n    Loads the mission input JSON file.\n    \n    Args:\n        filename: Path to mission input JSON file\n    \n    Returns:\n        Dictionary containing mission parameters\n    \n    Raises:\n        SystemExit: If file not found or invalid JSON\n    ')),
        If(
          test=UnaryOp(
            op=Not(),
            operand=Call(
              func=Attribute(
                value=Attribute(
                  value=Name(id='os', ctx=Load()),
                  attr='path',
                  ctx=Load()),
                attr='exists',
                ctx=Load()),
              args=[
                Name(id='filename', ctx=Load())])),
          body=[
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='FATAL: '),
                      FormattedValue(
                        value=Name(id='filename', ctx=Load()),
                        conversion=-1),
                      Constant(value=' not found. Please create it.')])])),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='\nExpected location: '),
                      FormattedValue(
                        value=Call(
                          func=Attribute(
                            value=Attribute(
                              value=Name(id='os', ctx=Load()),
                              attr='path',
                              ctx=Load()),
                            attr='abspath',
                            ctx=Load()),
                          args=[
                            Name(id='filename', ctx=Load())]),
                        conversion=-1)])])),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  Constant(value='\nThe file should contain:')])),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  Constant(value='- sender_profile: Your profile information')])),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  Constant(value='- recipient_profile: Target recipient information')])),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  Constant(value='- job_description: Job details for context')])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='sys', ctx=Load()),
                  attr='exit',
                  ctx=Load()),
                args=[
                  Constant(value=1)]))]),
        Try(
          body=[
            With(
              items=[
                withitem(
                  context_expr=Call(
                    func=Name(id='open', ctx=Load()),
                    args=[
                      Name(id='filename', ctx=Load()),
                      Constant(value='r')]),
                  optional_vars=Name(id='f', ctx=Store()))],
              body=[
                Return(
                  value=Call(
                    func=Attribute(
                      value=Name(id='json', ctx=Load()),
                      attr='load',
                      ctx=Load()),
                    args=[
                      Name(id='f', ctx=Load())]))])],
          handlers=[
            ExceptHandler(
              type=Attribute(
                value=Name(id='json', ctx=Load()),
                attr='JSONDecodeError',
                ctx=Load()),
              name='e',
              body=[
                Expr(
                  value=Call(
                    func=Name(id='print', ctx=Load()),
                    args=[
                      JoinedStr(
                        values=[
                          Constant(value='FATAL: Error decoding '),
