    ClassDef(
      name='RoutingAgent',
      body=[
        Expr(
          value=Constant(value='\n    Agent 3: Determine message route\n    Uses v11.4 decision tree logic\n    ')),
        FunctionDef(
          name='__init__',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='event_bus',
                annotation=Name(id='EventBus', ctx=Load()))]),
          body=[
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='event_bus',
                  ctx=Store())],
              value=Name(id='event_bus', ctx=Load())),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='status',
                  ctx=Store())],
              value=Attribute(
                value=Name(id='AgentStatus', ctx=Load()),
                attr='IDLE',
                ctx=Load()))]),
        AsyncFunctionDef(
          name='determine_route',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='mission',
                annotation=Name(id='OutreachMission', ctx=Load())),
              arg(
                arg='profile_analysis',
                annotation=Name(id='ProfileAnalysis', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        v11.4 Decision Tree:\n        1. IF not_connected AND senior_exec → INMAIL\n        2. ELSE IF recruiter → CONNECTION_REQ\n        3. ELSE IF connected AND prior_messages > 0 → FOLLOW_UP\n        4. ELSE → CONNECTION_REQ (default)\n        ')),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='status',
                  ctx=Store())],
              value=Attribute(
                value=Name(id='AgentStatus', ctx=Load()),
                attr='RUNNING',
                ctx=Load())),
            Assign(
              targets=[
                Name(id='is_connected', ctx=Store())],
              value=Compare(
                left=Attribute(
                  value=Name(id='mission', ctx=Load()),
                  attr='connection_status',
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value='connected')])),
            Assign(
              targets=[
                Name(id='has_prior_messages', ctx=Store())],
              value=Compare(
                left=Attribute(
                  value=Name(id='mission', ctx=Load()),
                  attr='prior_message_count',
                  ctx=Load()),
                ops=[
                  Gt()],
                comparators=[
                  Constant(value=0)])),
            Assign(
              targets=[
                Name(id='is_senior_exec', ctx=Store())],
              value=Compare(
                left=Attribute(
                  value=Name(id='profile_analysis', ctx=Load()),
                  attr='archetype',
                  ctx=Load()),
                ops=[
                  In()],
                comparators=[
                  List(
                    elts=[
                      Attribute(
                        value=Name(id='Archetype', ctx=Load()),
                        attr='C_LEVEL',
                        ctx=Load()),
                      Attribute(
                        value=Name(id='Archetype', ctx=Load()),
                        attr='EXECUTIVE',
                        ctx=Load())],
                    ctx=Load())])),
            Assign(
              targets=[
                Name(id='is_recruiter', ctx=Store())],
              value=Compare(
                left=Attribute(
                  value=Name(id='profile_analysis', ctx=Load()),
                  attr='archetype',
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Attribute(
                    value=Name(id='Archetype', ctx=Load()),
                    attr='RECRUITER',
                    ctx=Load())])),
            If(
              test=BoolOp(
                op=And(),
                values=[
                  UnaryOp(
                    op=Not(),
                    operand=Name(id='is_connected', ctx=Load())),
                  Name(id='is_senior_exec', ctx=Load())]),
              body=[
                Assign(
                  targets=[
                    Name(id='route', ctx=Store())],
                  value=Attribute(
                    value=Name(id='Route', ctx=Load()),
                    attr='INMAIL',
                    ctx=Load())),
                Assign(
                  targets=[
                    Name(id='reasoning', ctx=Store())],
                  value=Constant(value='Not connected + senior executive → INMAIL'))],
              orelse=[
                If(
                  test=Name(id='is_recruiter', ctx=Load()),
                  body=[
                    Assign(
                      targets=[
                        Name(id='route', ctx=Store())],
                      value=Attribute(
                        value=Name(id='Route', ctx=Load()),
                        attr='CONNECTION_REQ',
                        ctx=Load())),
                    Assign(
                      targets=[
                        Name(id='reasoning', ctx=Store())],
                      value=Constant(value='Recruiter → CONNECTION_REQ'))],
                  orelse=[
                    If(
                      test=BoolOp(
                        op=And(),
                        values=[
                          Name(id='is_connected', ctx=Load()),
                          Name(id='has_prior_messages', ctx=Load())]),
                      body=[
                        Assign(
                          targets=[
                            Name(id='route', ctx=Store())],
                          value=Attribute(
                            value=Name(id='Route', ctx=Load()),
                            attr='FOLLOW_UP',
                            ctx=Load())),
                        Assign(
                          targets=[
                            Name(id='reasoning', ctx=Store())],
                          value=JoinedStr(
                            values=[
                              Constant(value='Connected + '),
                              FormattedValue(
                                value=Attribute(
                                  value=Name(id='mission', ctx=Load()),
                                  attr='prior_message_count',
                                  ctx=Load()),
                                conversion=-1),
                              Constant(value=' prior messages → FOLLOW_UP')]))],
                      orelse=[
                        Assign(
                          targets=[
                            Name(id='route', ctx=Store())],
                          value=Attribute(
                            value=Name(id='Route', ctx=Load()),
                            attr='CONNECTION_REQ',
                            ctx=Load())),
                        Assign(
                          targets=[
                            Name(id='reasoning', ctx=Store())],
                          value=Constant(value='Default → CONNECTION_REQ'))])])]),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='\n🧭 Routing Decision: '),
                      FormattedValue(
                        value=Attribute(
                          value=Name(id='route', ctx=Load()),
                          attr='value',
                          ctx=Load()),
                        conversion=-1)])])),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='   Reasoning: '),
                      FormattedValue(
                        value=Name(id='reasoning', ctx=Load()),
                        conversion=-1)])])),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='status',
                  ctx=Store())],
              value=Attribute(
                value=Name(id='AgentStatus', ctx=Load()),
                attr='COMPLETED',
                ctx=Load())),
            Return(
              value=Name(id='route', ctx=Load()))],
          returns=Name(id='Route', ctx=Load()))]),
