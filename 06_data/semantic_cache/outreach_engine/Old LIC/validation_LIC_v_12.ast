        FunctionDef(
          name='check_diversity',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='new_message',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Check if new message is sufficiently different from:\n        1. Session history (current run)\n        2. Persistent ledger (all past runs)\n        \n        Returns:\n            (is_diverse, max_similarity, similar_messages)\n        ')),
            Assign(
              targets=[
                Name(id='all_messages', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='session_history',
                    ctx=Load()),
                  attr='copy',
                  ctx=Load()))),
            For(
              target=Name(id='entry', ctx=Store()),
              iter=Attribute(
                value=Name(id='self', ctx=Load()),
                attr='persistent_history',
                ctx=Load()),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='all_messages', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Subscript(
                        value=Name(id='entry', ctx=Load()),
                        slice=Constant(value='message'),
                        ctx=Load())]))]),
            If(
              test=UnaryOp(
                op=Not(),
                operand=Name(id='all_messages', ctx=Load())),
              body=[
                Return(
                  value=Tuple(
                    elts=[
                      Constant(value=True),
                      Constant(value=0.0),
                      List(ctx=Load())],
                    ctx=Load()))]),
            Assign(
              targets=[
                Name(id='all_messages_with_new', ctx=Store())],
              value=BinOp(
                left=Name(id='all_messages', ctx=Load()),
                op=Add(),
                right=List(
                  elts=[
                    Name(id='new_message', ctx=Load())],
                  ctx=Load()))),
            Try(
              body=[
                Assign(
                  targets=[
                    Name(id='tfidf_matrix', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='vectorizer',
                        ctx=Load()),
                      attr='fit_transform',
                      ctx=Load()),
                    args=[
                      Name(id='all_messages_with_new', ctx=Load())])),
                Assign(
                  targets=[
                    Name(id='new_message_vector', ctx=Store())],
                  value=Subscript(
                    value=Name(id='tfidf_matrix', ctx=Load()),
                    slice=UnaryOp(
                      op=USub(),
                      operand=Constant(value=1)),
                    ctx=Load())),
                Assign(
                  targets=[
                    Name(id='history_vectors', ctx=Store())],
                  value=Subscript(
                    value=Name(id='tfidf_matrix', ctx=Load()),
                    slice=Slice(
                      upper=UnaryOp(
                        op=USub(),
                        operand=Constant(value=1))),
                    ctx=Load())),
                Assign(
                  targets=[
                    Name(id='similarities', ctx=Store())],
                  value=Subscript(
                    value=Call(
                      func=Name(id='cosine_similarity', ctx=Load()),
                      args=[
                        Name(id='new_message_vector', ctx=Load()),
                        Name(id='history_vectors', ctx=Load())]),
                    slice=Constant(value=0),
                    ctx=Load())),
                Assign(
                  targets=[
                    Name(id='max_similarity', ctx=Store())],
                  value=Call(
                    func=Name(id='float', ctx=Load()),
                    args=[
                      Call(
                        func=Attribute(
                          value=Name(id='np', ctx=Load()),
                          attr='max',
                          ctx=Load()),
                        args=[
                          Name(id='similarities', ctx=Load())])])),
                If(
                  test=Compare(
                    left=Name(id='max_similarity', ctx=Load()),
                    ops=[
                      Gt()],
                    comparators=[
                      Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='SIMILARITY_THRESHOLD',
                        ctx=Load())]),
                  body=[
                    Assign(
                      targets=[
                        Name(id='similar_indices', ctx=Store())],
                      value=Subscript(
                        value=Call(
                          func=Attribute(
                            value=Name(id='np', ctx=Load()),
                            attr='where',
                            ctx=Load()),
                          args=[
                            Compare(
                              left=Name(id='similarities', ctx=Load()),
                              ops=[
                                Gt()],
                              comparators=[
                                Attribute(
                                  value=Name(id='self', ctx=Load()),
                                  attr='SIMILARITY_THRESHOLD',
                                  ctx=Load())])]),
                        slice=Constant(value=0),
                        ctx=Load())),
                    Assign(
                      targets=[
                        Name(id='similar_messages', ctx=Store())],
                      value=ListComp(
                        elt=BinOp(
                          left=Subscript(
                            value=Subscript(
                              value=Name(id='all_messages', ctx=Load()),
                              slice=Name(id='i', ctx=Load()),
                              ctx=Load()),
                            slice=Slice(
                              upper=Constant(value=100)),
                            ctx=Load()),
                          op=Add(),
                          right=Constant(value='...')),
                        generators=[
                          comprehension(
                            target=Name(id='i', ctx=Store()),
                            iter=Name(id='similar_indices', ctx=Load()),
                            is_async=0)])),
                    Return(
                      value=Tuple(
                        elts=[
                          Constant(value=False),
                          Name(id='max_similarity', ctx=Load()),
                          Name(id='similar_messages', ctx=Load())],
                        ctx=Load()))]),
                Return(
                  value=Tuple(
                    elts=[
                      Constant(value=True),
                      Name(id='max_similarity', ctx=Load()),
                      List(ctx=Load())],
                    ctx=Load()))],
              handlers=[
                ExceptHandler(
                  type=Name(id='Exception', ctx=Load()),
                  name='e',
                  body=[
                    Expr(
                      value=Call(
                        func=Name(id='print', ctx=Load()),
                        args=[
                          JoinedStr(
                            values=[
                              Constant(value='[MessageDiversityValidator] Error calculating similarity: '),
                              FormattedValue(
                                value=Name(id='e', ctx=Load()),
                                conversion=-1)])])),
                    Return(
                      value=Tuple(
                        elts=[
                          Constant(value=True),
                          Constant(value=0.0),
                          List(ctx=Load())],
                        ctx=Load()))])])],
          returns=Subscript(
            value=Name(id='Tuple', ctx=Load()),
            slice=Tuple(
