            Name(id='ESCALATION_STEP', ctx=Store())],
          value=Constant(value=0.15)),
        Assign(
          targets=[
            Name(id='MAX_TEMPERATURE', ctx=Store())],
          value=Constant(value=0.95)),
        FunctionDef(
          name='__init__',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            AnnAssign(
              target=Attribute(
                value=Name(id='self', ctx=Load()),
                attr='attempt_history',
                ctx=Store()),
              annotation=Subscript(
                value=Name(id='Dict', ctx=Load()),
