                value=Name(id='self', ctx=Load()),
                attr='success_temperatures',
                ctx=Store()),
              annotation=Subscript(
                value=Name(id='Dict', ctx=Load()),
                slice=Tuple(
                  elts=[
                    Name(id='str', ctx=Load()),
                    Name(id='float', ctx=Load())],
                  ctx=Load()),
                ctx=Load()),
              value=Dict(),
              simple=0)]),
        FunctionDef(
          name='get_temperature',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='component',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='archetype',
                annotation=Name(id='Archetype', ctx=Load())),
              arg(
                arg='attempt',
                annotation=Name(id='int', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Get temperature for this generation attempt')),
            Assign(
              targets=[
                Name(id='base_temp', ctx=Store())],
              value=Subscript(
                value=Attribute(
