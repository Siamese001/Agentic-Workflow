          value=Constant(value='\n    Progressive temperature escalation for retry attempts\n    FEATURE 2.2 from SUPREME_SPELL\n    ')),
        Assign(
          targets=[
            Name(id='BASE_TEMPERATURES', ctx=Store())],
          value=Dict(
            keys=[
