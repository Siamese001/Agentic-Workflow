                  ctx=Load())),
              arg(
                arg='max_tokens',
                annotation=Name(id='int', ctx=Load()))],
            defaults=[
              Name(id='MAX_CONTEXT_TOKENS', ctx=Load())]),
          body=[
            Expr(
              value=Constant(value='\n        Truncate context sections by priority if exceeding token limit\n        ')),
            Assign(
              targets=[
                Name(id='total_chars', ctx=Store())],
              value=Call(
                func=Name(id='sum', ctx=Load()),
                args=[
                  GeneratorExp(
                    elt=Call(
                      func=Name(id='len', ctx=Load()),
                      args=[
                        Name(id='text', ctx=Load())]),
                    generators=[
                      comprehension(
                        target=Name(id='text', ctx=Store()),
                        iter=Call(
                          func=Attribute(
                            value=Name(id='context_sections', ctx=Load()),
                            attr='values',
                            ctx=Load())),
                        is_async=0)])])),
            Assign(
              targets=[
                Name(id='estimated_tokens', ctx=Store())],
              value=BinOp(
                left=Name(id='total_chars', ctx=Load()),
                op=FloorDiv(),
                right=Constant(value=4))),
            If(
              test=Compare(
                left=Name(id='estimated_tokens', ctx=Load()),
                ops=[
                  LtE()],
                comparators=[
                  Name(id='max_tokens', ctx=Load())]),
              body=[
                Return(
                  value=Name(id='context_sections', ctx=Load()))]),
            Assign(
              targets=[
                Name(id='sorted_sections', ctx=Store())],
              value=Call(
                func=Name(id='sorted', ctx=Load()),
                args=[
                  Call(
                    func=Attribute(
                      value=Name(id='context_sections', ctx=Load()),
                      attr='items',
                      ctx=Load()))],
                keywords=[
                  keyword(
                    arg='key',
                    value=Lambda(
                      args=arguments(
                        args=[
                          arg(arg='x')]),
                      body=Call(
                        func=Attribute(
                          value=Attribute(
                            value=Name(id='cls', ctx=Load()),
                            attr='SECTION_PRIORITIES',
                            ctx=Load()),
                          attr='get',
                          ctx=Load()),
                        args=[
                          Subscript(
                            value=Name(id='x', ctx=Load()),
                            slice=Constant(value=0),
                            ctx=Load()),
                          Constant(value=50)]))),
                  keyword(
                    arg='reverse',
                    value=Constant(value=True))])),
            Assign(
              targets=[
                Name(id='truncated', ctx=Store())],
              value=Dict()),
            Assign(
              targets=[
                Name(id='running_tokens', ctx=Store())],
              value=Constant(value=0)),
            Assign(
              targets=[
                Name(id='token_budget', ctx=Store())],
              value=Name(id='max_tokens', ctx=Load())),
            For(
              target=Tuple(
                elts=[
                  Name(id='section_name', ctx=Store()),
                  Name(id='section_text', ctx=Store())],
                ctx=Store()),
              iter=Name(id='sorted_sections', ctx=Load()),
              body=[
                Assign(
                  targets=[
                    Name(id='section_tokens', ctx=Store())],
                  value=BinOp(
                    left=Call(
                      func=Name(id='len', ctx=Load()),
                      args=[
                        Name(id='section_text', ctx=Load())]),
                    op=FloorDiv(),
                    right=Constant(value=4))),
                If(
                  test=Compare(
                    left=BinOp(
                      left=Name(id='running_tokens', ctx=Load()),
                      op=Add(),
                      right=Name(id='section_tokens', ctx=Load())),
                    ops=[
                      LtE()],
                    comparators=[
                      Name(id='token_budget', ctx=Load())]),
                  body=[
                    Assign(
                      targets=[
                        Subscript(
                          value=Name(id='truncated', ctx=Load()),
                          slice=Name(id='section_name', ctx=Load()),
                          ctx=Store())],
                      value=Name(id='section_text', ctx=Load())),
                    AugAssign(
                      target=Name(id='running_tokens', ctx=Store()),
                      op=Add(),
                      value=Name(id='section_tokens', ctx=Load()))],
                  orelse=[
                    Assign(
                      targets=[
                        Name(id='remaining_tokens', ctx=Store())],
                      value=BinOp(
                        left=Name(id='token_budget', ctx=Load()),
                        op=Sub(),
                        right=Name(id='running_tokens', ctx=Load()))),
                    Assign(
                      targets=[
                        Name(id='remaining_chars', ctx=Store())],
                      value=BinOp(
                        left=Name(id='remaining_tokens', ctx=Load()),
                        op=Mult(),
                        right=Constant(value=4))),
                    If(
                      test=Compare(
                        left=Name(id='remaining_chars', ctx=Load()),
                        ops=[
                          Gt()],
                        comparators=[
                          Constant(value=100)]),
                      body=[
                        Assign(
                          targets=[
                            Subscript(
                              value=Name(id='truncated', ctx=Load()),
                              slice=Name(id='section_name', ctx=Load()),
                              ctx=Store())],
                          value=BinOp(
                            left=Subscript(
                              value=Name(id='section_text', ctx=Load()),
                              slice=Slice(
                                upper=Name(id='remaining_chars', ctx=Load())),
                              ctx=Load()),
                            op=Add(),
                            right=Constant(value='... [truncated]'))),
                        Assign(
                          targets=[
                            Name(id='running_tokens', ctx=Store())],
                          value=Name(id='token_budget', ctx=Load()))]),
                    Break()])]),
            Return(
              value=Name(id='truncated', ctx=Load()))],
          decorator_list=[
            Name(id='classmethod', ctx=Load())],
          returns=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='str', ctx=Load())],
              ctx=Load()),
            ctx=Load())),
        FunctionDef(
