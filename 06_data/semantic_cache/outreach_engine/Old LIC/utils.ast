                            attr='value',
                            ctx=Load()),
                          conversion=-1),
                        Constant(value='_'),
                        FormattedValue(
                          value=Name(id='component', ctx=Load()),
                          conversion=-1)]),
                    ctx=Load()),
                  attr='append',
                  ctx=Load()),
                args=[
                  Name(id='escalated_temp', ctx=Load())])),
            Return(
              value=Name(id='escalated_temp', ctx=Load()))],
          returns=Name(id='float', ctx=Load())),
        FunctionDef(
