          decorator_list=[
            Name(id='classmethod', ctx=Load())],
          returns=Subscript(
            value=Name(id='Tuple', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='bool', ctx=Load()),
                Name(id='int', ctx=Load())],
              ctx=Load()),
            ctx=Load()))]),
    ClassDef(
      name='AdaptiveTemperatureController',
      body=[
