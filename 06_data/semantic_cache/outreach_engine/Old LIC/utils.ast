    ClassDef(
      name='ContextManager',
      body=[
        Expr(
          value=Constant(value='\n    Intelligent context window management with priority-based truncation\n    GAP 7.1, 7.2, 7.3 from v10.22\n    ')),
        Assign(
          targets=[
            Name(id='SECTION_PRIORITIES', ctx=Store())],
          value=Dict(
            keys=[
              Constant(value='job_description'),
              Constant(value='recipient_profile'),
              Constant(value='company_context'),
              Constant(value='sender_profile'),
              Constant(value='rag_recent'),
              Constant(value='rag_historical'),
              Constant(value='examples')],
            values=[
              Constant(value=100),
              Constant(value=90),
              Constant(value=80),
              Constant(value=70),
              Constant(value=60),
              Constant(value=40),
              Constant(value=30)])),
        Assign(
          targets=[
            Name(id='MAX_CONTEXT_TOKENS', ctx=Store())],
          value=Constant(value=180000)),
        FunctionDef(
          name='truncate_intelligently',
          args=arguments(
            args=[
              arg(arg='cls'),
              arg(
                arg='context_sections',
                annotation=Subscript(
                  value=Name(id='Dict', ctx=Load()),
                  slice=Tuple(
                    elts=[
                      Name(id='str', ctx=Load()),
                      Name(id='str', ctx=Load())],
