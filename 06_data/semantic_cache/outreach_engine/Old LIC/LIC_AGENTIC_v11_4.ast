                  Constant(value='\n\nDECISION TREE (v10.24):\n1. IF connection_status == "not_connected" AND recipient_title contains [\'CEO\', \'CTO\', \'VP\', \'Director\', \'Chief\']:\n   → Route = INMAIL (for senior executives who aren\'t connections)\n\n2. ELSE IF recipient_title contains [\'Recruiter\', \'Talent\', \'Sourcing\', \'Recruiting\']:\n   → Route = CONNECTION_REQ (always start with connection request for recruiters)\n\n3. ELSE IF connection_status == "connected" AND prior_message_count > 0:\n   → Route = FOLLOW_UP (continuing an existing conversation)\n\n4. ELSE:\n   → Route = CONNECTION_REQ (default for new contacts)\n\nARCHETYPE CLASSIFICATION:\n- IF recipient_title contains [\'CEO\', \'Chief\', \'President\'] → C_LEVEL\n- ELSE IF recipient_title contains [\'VP\', \'Vice President\', \'SVP\', \'EVP\'] → EXECUTIVE\n- ELSE IF recipient_title contains [\'Recruiter\', \'Talent Acquisition\', \'Sourcing\'] → RECRUITER\n- ELSE IF recipient_title contains [\'Manager\', \'Director\', \'Head of\', \'Lead\'] → HIRING_MANAGER\n- ELSE → HIRING_MANAGER (default)\n\nReturn JSON with:\n{\n  "route": "INMAIL" | "CONNECTION_REQ" | "EMAIL" | "FOLLOW_UP",\n  "archetype": "C_LEVEL" | "EXECUTIVE" | "RECRUITER" | "HIRING_MANAGER" | "PEER",\n  "reasoning": "Brief explanation referencing decision tree step"\n}\n')]))],
