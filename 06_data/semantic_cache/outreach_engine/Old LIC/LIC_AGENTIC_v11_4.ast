                attr='last_failure_time',
                ctx=Store()),
              annotation=Subscript(
                value=Name(id='Optional', ctx=Load()),
                slice=Name(id='datetime', ctx=Load()),
                ctx=Load()),
              value=Constant(value=None),
              simple=0),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='state',
                  ctx=Store())],
              value=Constant(value='CLOSED'))]),
        AsyncFunctionDef(
          name='call',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(arg='func')],
            vararg=arg(arg='args'),
            kwarg=arg(arg='kwargs')),
          body=[
            Expr(
              value=Constant(value='Execute function with circuit breaker')),
            If(
              test=Compare(
                left=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='state',
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value='OPEN')]),
              body=[
                If(
                  test=Compare(
                    left=Attribute(
                      value=BinOp(
                        left=Call(
                          func=Attribute(
                            value=Name(id='datetime', ctx=Load()),
                            attr='now',
                            ctx=Load())),
                        op=Sub(),
                        right=Attribute(
                          value=Name(id='self', ctx=Load()),
                          attr='last_failure_time',
                          ctx=Load())),
                      attr='seconds',
                      ctx=Load()),
                    ops=[
                      Gt()],
                    comparators=[
                      Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='timeout',
                        ctx=Load())]),
                  body=[
                    Assign(
                      targets=[
                        Attribute(
                          value=Name(id='self', ctx=Load()),
                          attr='state',
                          ctx=Store())],
                      value=Constant(value='HALF_OPEN'))],
                  orelse=[
                    Raise(
                      exc=Call(
                        func=Name(id='Exception', ctx=Load()),
                        args=[
                          Constant(value='Circuit breaker is OPEN')]))])]),
            Try(
              body=[
                Assign(
                  targets=[
                    Name(id='result', ctx=Store())],
                  value=Await(
                    value=Call(
                      func=Name(id='func', ctx=Load()),
                      args=[
                        Starred(
                          value=Name(id='args', ctx=Load()),
                          ctx=Load())],
                      keywords=[
                        keyword(
                          value=Name(id='kwargs', ctx=Load()))]))),
                Assign(
                  targets=[
                    Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='failure_count',
                      ctx=Store())],
                  value=Constant(value=0)),
                Assign(
                  targets=[
                    Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='state',
                      ctx=Store())],
                  value=Constant(value='CLOSED')),
                Return(
                  value=Name(id='result', ctx=Load()))],
              handlers=[
                ExceptHandler(
                  type=Name(id='Exception', ctx=Load()),
                  name='e',
                  body=[
                    AugAssign(
                      target=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='failure_count',
                        ctx=Store()),
                      op=Add(),
                      value=Constant(value=1)),
                    Assign(
                      targets=[
                        Attribute(
                          value=Name(id='self', ctx=Load()),
                          attr='last_failure_time',
                          ctx=Store())],
                      value=Call(
                        func=Attribute(
                          value=Name(id='datetime', ctx=Load()),
                          attr='now',
                          ctx=Load()))),
                    If(
                      test=Compare(
                        left=Attribute(
                          value=Name(id='self', ctx=Load()),
                          attr='failure_count',
                          ctx=Load()),
                        ops=[
                          GtE()],
                        comparators=[
                          Attribute(
                            value=Name(id='self', ctx=Load()),
                            attr='failure_threshold',
                            ctx=Load())]),
                      body=[
                        Assign(
                          targets=[
                            Attribute(
                              value=Name(id='self', ctx=Load()),
                              attr='state',
                              ctx=Store())],
                          value=Constant(value='OPEN'))]),
                    Raise(
                      exc=Name(id='e', ctx=Load()))])])])]),
