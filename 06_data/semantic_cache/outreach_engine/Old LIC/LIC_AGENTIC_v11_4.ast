                    ctx=Load()),
                  List(
                    elts=[
                      Constant(value='impossible'),
                      Constant(value='contradiction'),
                      Constant(value='conflict'),
                      Constant(value='incompatible')],
                    ctx=Load())]))]),
        FunctionDef(
          name='classify_failure',
