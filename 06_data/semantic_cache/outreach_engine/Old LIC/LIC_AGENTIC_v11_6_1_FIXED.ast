    ClassDef(
      name='SignalQualityScorer',
      body=[
        Expr(
          value=Constant(value='\n    Weights RAG sources by reliability for message generation\n    FEATURE 1.1 from SUPREME_SPELL\n    ')),
        Assign(
          targets=[
            Name(id='SOURCE_WEIGHTS', ctx=Store())],
          value=Dict(
            keys=[
              Constant(value='RECIPIENT_LINKEDIN_ABOUT'),
              Constant(value='RECIPIENT_RECENT_POST'),
              Constant(value='COMPANY_BLOG_ANNOUNCEMENT'),
              Constant(value='COMPANY_LINKEDIN_PAGE'),
              Constant(value='NEWS_ARTICLE_COMPANY'),
              Constant(value='COMPETITOR_COMPARISON'),
              Constant(value='GENERIC_INDUSTRY_TREND'),
              Constant(value='SENDER_PROFILE_ONLY')],
            values=[
              Constant(value=2.0),
              Constant(value=1.8),
              Constant(value=1.5),
              Constant(value=1.3),
              Constant(value=1.2),
              Constant(value=0.9),
              Constant(value=0.6),
              Constant(value=0.3)])),
        Assign(
          targets=[
            Name(id='MINIMUM_SIGNAL_THRESHOLD', ctx=Store())],
          value=Constant(value=0.7)),
        FunctionDef(
          name='calculate_signal_score',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='rag_results',
                annotation=Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Name(id='RAGResult', ctx=Load()),
                  ctx=Load())),
              arg(
                arg='message_content',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Calculate weighted signal quality score for generated message\n        ')),
            Assign(
              targets=[
                Name(id='keyword_scores', ctx=Store())],
              value=Call(
                func=Name(id='defaultdict', ctx=Load()),
                args=[
                  Name(id='float', ctx=Load())])),
            Assign(
              targets=[
                Name(id='source_breakdown', ctx=Store())],
              value=Call(
                func=Name(id='defaultdict', ctx=Load()),
                args=[
                  Name(id='int', ctx=Load())])),
            For(
              target=Name(id='result', ctx=Store()),
              iter=Name(id='rag_results', ctx=Load()),
              body=[
                Assign(
                  targets=[
                    Name(id='weight', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='SOURCE_WEIGHTS',
                        ctx=Load()),
                      attr='get',
                      ctx=Load()),
                    args=[
                      Attribute(
                        value=Name(id='result', ctx=Load()),
                        attr='source_type',
                        ctx=Load()),
                      Constant(value=0.5)])),
                For(
                  target=Name(id='keyword', ctx=Store()),
                  iter=Attribute(
                    value=Name(id='result', ctx=Load()),
                    attr='extracted_keywords',
                    ctx=Load()),
                  body=[
                    If(
                      test=Compare(
                        left=Call(
                          func=Attribute(
                            value=Name(id='keyword', ctx=Load()),
                            attr='lower',
                            ctx=Load())),
                        ops=[
                          In()],
                        comparators=[
                          Call(
                            func=Attribute(
                              value=Name(id='message_content', ctx=Load()),
                              attr='lower',
                              ctx=Load()))]),
                      body=[
                        AugAssign(
                          target=Subscript(
                            value=Name(id='keyword_scores', ctx=Load()),
                            slice=Name(id='keyword', ctx=Load()),
                            ctx=Store()),
                          op=Add(),
                          value=Name(id='weight', ctx=Load())),
                        AugAssign(
                          target=Subscript(
                            value=Name(id='source_breakdown', ctx=Load()),
                            slice=Attribute(
                              value=Name(id='result', ctx=Load()),
                              attr='source_type',
                              ctx=Load()),
                            ctx=Store()),
                          op=Add(),
                          value=Constant(value=1))])])]),
            If(
              test=UnaryOp(
                op=Not(),
                operand=Name(id='keyword_scores', ctx=Load())),
              body=[
                Return(
                  value=Tuple(
                    elts=[
                      Constant(value=0.0),
                      Call(
                        func=Name(id='dict', ctx=Load()),
                        args=[
                          Name(id='source_breakdown', ctx=Load())])],
                    ctx=Load()))]),
            Assign(
              targets=[
                Name(id='signal_score', ctx=Store())],
              value=BinOp(
                left=Call(
                  func=Name(id='sum', ctx=Load()),
                  args=[
                    Call(
                      func=Attribute(
                        value=Name(id='keyword_scores', ctx=Load()),
                        attr='values',
                        ctx=Load()))]),
                op=Div(),
                right=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Name(id='keyword_scores', ctx=Load())]))),
            Return(
              value=Tuple(
                elts=[
                  Name(id='signal_score', ctx=Load()),
                  Call(
                    func=Name(id='dict', ctx=Load()),
                    args=[
                      Name(id='source_breakdown', ctx=Load())])],
                ctx=Load()))],
          returns=Subscript(
            value=Name(id='Tuple', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='float', ctx=Load()),
                Subscript(
                  value=Name(id='Dict', ctx=Load()),
                  slice=Tuple(
                    elts=[
                      Name(id='str', ctx=Load()),
                      Name(id='int', ctx=Load())],
                    ctx=Load()),
                  ctx=Load())],
              ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='validate_minimum_signal',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='score',
                annotation=Name(id='float', ctx=Load()))]),
          body=[
            Return(
              value=Compare(
                left=Name(id='score', ctx=Load()),
                ops=[
                  GtE()],
                comparators=[
                  Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='MINIMUM_SIGNAL_THRESHOLD',
                    ctx=Load())]))],
          returns=Name(id='bool', ctx=Load()))]),
    ClassDef(
