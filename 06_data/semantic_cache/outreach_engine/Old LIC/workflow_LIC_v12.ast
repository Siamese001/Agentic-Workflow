    ClassDef(
      name='SelfConsistencySynthesizer',
      body=[
        Expr(
          value=Constant(value='\n    N-candidate generation with synthesis for C_LEVEL archetype\n    Uses live LLM calls for candidate generation and synthesis\n    ')),
        FunctionDef(
          name='__init__',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='llm_client',
                annotation=Name(id='GeminiLLMClient', ctx=Load()))]),
          body=[
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='llm_client',
                  ctx=Store())],
              value=Name(id='llm_client', ctx=Load())),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='n_candidates',
                  ctx=Store())],
              value=Constant(value=3))]),
        AsyncFunctionDef(
          name='synthesize_c_level_message',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='scaffold',
                annotation=Name(id='MessageScaffold', ctx=Load())),
              arg(
                arg='context',
                annotation=Name(id='ResearchContext', ctx=Load())),
              arg(
                arg='profile_analysis',
                annotation=Name(id='ProfileAnalysis', ctx=Load())),
              arg(
                arg='temperature',
                annotation=Name(id='float', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Generate N candidates and synthesize the best elements\n        Only used for C_LEVEL archetype\n        ')),
            If(
              test=Compare(
                left=Attribute(
                  value=Name(id='scaffold', ctx=Load()),
                  attr='archetype',
                  ctx=Load()),
                ops=[
                  NotEq()],
                comparators=[
                  Attribute(
                    value=Name(id='Archetype', ctx=Load()),
                    attr='C_LEVEL',
                    ctx=Load())]),
              body=[
                Raise(
                  exc=Call(
                    func=Name(id='ValueError', ctx=Load()),
                    args=[
                      Constant(value='Self-consistency synthesis only for C_LEVEL')]))]),
            Assign(
              targets=[
                Name(id='candidates', ctx=Store())],
              value=List(ctx=Load())),
            For(
              target=Name(id='i', ctx=Store()),
              iter=Call(
                func=Name(id='range', ctx=Load()),
                args=[
                  Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='n_candidates',
                    ctx=Load())]),
              body=[
                Assign(
                  targets=[
                    Name(id='candidate', ctx=Store())],
                  value=Await(
                    value=Call(
                      func=Attribute(
