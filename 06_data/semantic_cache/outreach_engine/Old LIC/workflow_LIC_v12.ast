                  ctx=Store())],
              value=Name(id='circuit_breaker', ctx=Load())),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='status',
                  ctx=Store())],
              value=Attribute(
                value=Name(id='AgentStatus', ctx=Load()),
                attr='IDLE',
                ctx=Load()))]),
        FunctionDef(
          name='determine_route',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='mission',
                annotation=Name(id='OutreachMission', ctx=Load())),
              arg(
                arg='profile_analysis',
                annotation=Name(id='ProfileAnalysis', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Select route based on connection status and prior message count\n        ')),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='status',
                  ctx=Store())],
              value=Attribute(
                value=Name(id='AgentStatus', ctx=Load()),
                attr='RUNNING',
                ctx=Load())),
            Assign(
              targets=[
                Name(id='connection_status', ctx=Store())],
              value=Attribute(
                value=Name(id='mission', ctx=Load()),
                attr='connection_status',
                ctx=Load())),
            Assign(
              targets=[
                Name(id='prior_messages', ctx=Store())],
              value=Attribute(
                value=Name(id='mission', ctx=Load()),
                attr='prior_message_count',
                ctx=Load())),
            If(
              test=Attribute(
                value=Name(id='mission', ctx=Load()),
                attr='route_override',
                ctx=Load()),
              body=[
                Assign(
                  targets=[
                    Name(id='reasoning', ctx=Store())],
                  value=JoinedStr(
                    values=[
                      Constant(value='Manual route override: '),
                      FormattedValue(
                        value=Attribute(
                          value=Attribute(
                            value=Name(id='mission', ctx=Load()),
                            attr='route_override',
                            ctx=Load()),
                          attr='value',
                          ctx=Load()),
                        conversion=-1)])),
                Return(
                  value=Tuple(
                    elts=[
                      Attribute(
                        value=Name(id='mission', ctx=Load()),
                        attr='route_override',
                        ctx=Load()),
                      Name(id='reasoning', ctx=Load())],
                    ctx=Load()))]),
            If(
              test=Compare(
                left=Name(id='prior_messages', ctx=Load()),
                ops=[
                  Gt()],
                comparators=[
                  Constant(value=0)]),
              body=[
                Assign(
                  targets=[
                    Name(id='route', ctx=Store())],
                  value=Attribute(
                    value=Name(id='Route', ctx=Load()),
                    attr='FOLLOW_UP',
                    ctx=Load())),
                Assign(
                  targets=[
                    Name(id='reasoning', ctx=Store())],
                  value=JoinedStr(
                    values=[
                      Constant(value='Follow-up message (prior count: '),
                      FormattedValue(
                        value=Name(id='prior_messages', ctx=Load()),
                        conversion=-1),
                      Constant(value=')')]))],
              orelse=[
                If(
                  test=Compare(
                    left=Name(id='connection_status', ctx=Load()),
                    ops=[
                      Eq()],
                    comparators=[
                      Constant(value='not_connected')]),
                  body=[
                    Assign(
                      targets=[
                        Name(id='route', ctx=Store())],
                      value=Attribute(
                        value=Name(id='Route', ctx=Load()),
                        attr='CONNECTION_REQ',
                        ctx=Load())),
                    Assign(
                      targets=[
                        Name(id='reasoning', ctx=Store())],
                      value=Constant(value='Not connected - using LinkedIn connection request'))],
                  orelse=[
                    If(
                      test=Compare(
                        left=Name(id='connection_status', ctx=Load()),
                        ops=[
                          In()],
                        comparators=[
                          List(
                            elts=[
                              Constant(value='1st'),
                              Constant(value='connected')],
                            ctx=Load())]),
                      body=[
                        Assign(
                          targets=[
                            Name(id='route', ctx=Store())],
                          value=Attribute(
                            value=Name(id='Route', ctx=Load()),
                            attr='INMAIL',
                            ctx=Load())),
                        Assign(
                          targets=[
                            Name(id='reasoning', ctx=Store())],
                          value=Constant(value='1st degree connection - using LinkedIn InMail'))],
                      orelse=[
                        If(
                          test=Compare(
                            left=Name(id='connection_status', ctx=Load()),
                            ops=[
                              Eq()],
                            comparators=[
                              Constant(value='email_available')]),
                          body=[
                            Assign(
                              targets=[
                                Name(id='route', ctx=Store())],
                              value=Attribute(
                                value=Name(id='Route', ctx=Load()),
                                attr='EMAIL',
                                ctx=Load())),
                            Assign(
                              targets=[
                                Name(id='reasoning', ctx=Store())],
                              value=Constant(value='Email available - using email outreach'))],
                          orelse=[
                            Assign(
                              targets=[
                                Name(id='route', ctx=Store())],
                              value=Attribute(
                                value=Name(id='Route', ctx=Load()),
                                attr='INMAIL',
                                ctx=Load())),
                            Assign(
                              targets=[
                                Name(id='reasoning', ctx=Store())],
                              value=JoinedStr(
                                values=[
                                  Constant(value='Default routing for status: '),
                                  FormattedValue(
                                    value=Name(id='connection_status', ctx=Load()),
                                    conversion=-1)]))])])])]),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='status',
                  ctx=Store())],
              value=Attribute(
                value=Name(id='AgentStatus', ctx=Load()),
                attr='COMPLETED',
                ctx=Load())),
            Return(
              value=Tuple(
                elts=[
                  Name(id='route', ctx=Load()),
                  Name(id='reasoning', ctx=Load())],
                ctx=Load()))],
          returns=Subscript(
            value=Name(id='Tuple', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='Route', ctx=Load()),
                Name(id='str', ctx=Load())],
              ctx=Load()),
            ctx=Load()))]),
    ClassDef(
      name='ScaffoldAgent',
      body=[
        Expr(
          value=Constant(value='\n    Creates structural scaffold for message generation\n    ')),
        FunctionDef(
          name='__init__',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='circuit_breaker',
                annotation=Name(id='CircuitBreaker', ctx=Load()))]),
          body=[
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='circuit_breaker',
                  ctx=Store())],
              value=Name(id='circuit_breaker', ctx=Load())),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='status',
                  ctx=Store())],
              value=Attribute(
                value=Name(id='AgentStatus', ctx=Load()),
                attr='IDLE',
                ctx=Load()))]),
        FunctionDef(
          name='create_scaffold',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='route',
                annotation=Name(id='Route', ctx=Load())),
              arg(
                arg='archetype',
                annotation=Name(id='Archetype', ctx=Load())),
              arg(
                arg='context',
                annotation=Name(id='ResearchContext', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Build message scaffold with sections and constraints\n        ')),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='status',
                  ctx=Store())],
              value=Attribute(
                value=Name(id='AgentStatus', ctx=Load()),
                attr='RUNNING',
                ctx=Load())),
            Assign(
              targets=[
                Name(id='constraints', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='CONFIG_REGISTRY', ctx=Load()),
                  attr='get_route_constraints',
                  ctx=Load()),
                args=[
                  Name(id='route', ctx=Load()),
                  Name(id='archetype', ctx=Load())])),
            Assign(
              targets=[
                Name(id='sections', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='_define_sections',
                  ctx=Load()),
                args=[
                  Name(id='route', ctx=Load()),
                  Name(id='constraints', ctx=Load())])),
            Assign(
              targets=[
                Name(id='context_aware_cta', ctx=Store())],
              value=Compare(
                left=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Attribute(
                      value=Name(id='context', ctx=Load()),
                      attr='rag_results',
                      ctx=Load())]),
                ops=[
                  GtE()],
                comparators=[
                  Constant(value=5)])),
            Assign(
              targets=[
                Name(id='scaffold', ctx=Store())],
              value=Call(
                func=Name(id='MessageScaffold', ctx=Load()),
                keywords=[
                  keyword(
                    arg='route',
                    value=Name(id='route', ctx=Load())),
                  keyword(
                    arg='archetype',
                    value=Name(id='archetype', ctx=Load())),
                  keyword(
                    arg='sections',
                    value=Name(id='sections', ctx=Load())),
                  keyword(
                    arg='constraints',
                    value=Name(id='constraints', ctx=Load())),
                  keyword(
                    arg='locked_sections',
                    value=Call(
                      func=Name(id='set', ctx=Load()))),
                  keyword(
                    arg='context_aware_cta',
                    value=Name(id='context_aware_cta', ctx=Load()))])),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='status',
                  ctx=Store())],
              value=Attribute(
                value=Name(id='AgentStatus', ctx=Load()),
                attr='COMPLETED',
                ctx=Load())),
            Return(
              value=Name(id='scaffold', ctx=Load()))],
          returns=Name(id='MessageScaffold', ctx=Load())),
        FunctionDef(
          name='_define_sections',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='route',
                annotation=Name(id='Route', ctx=Load())),
              arg(
                arg='constraints',
                annotation=Subscript(
                  value=Name(id='Dict', ctx=Load()),
                  slice=Tuple(
                    elts=[
                      Name(id='str', ctx=Load()),
                      Name(id='Any', ctx=Load())],
                    ctx=Load()),
                  ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Define required sections based on route')),
            If(
              test=Compare(
                left=Name(id='route', ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Attribute(
                    value=Name(id='Route', ctx=Load()),
                    attr='CONNECTION_REQ',
                    ctx=Load())]),
              body=[
                Return(
                  value=Dict(
                    keys=[
                      Constant(value='greeting'),
                      Constant(value='body'),
                      Constant(value='signature')],
                    values=[
                      Dict(
                        keys=[
                          Constant(value='word_range'),
                          Constant(value='required')],
                        values=[
                          Call(
                            func=Attribute(
                              value=Name(id='constraints', ctx=Load()),
                              attr='get',
                              ctx=Load()),
                            args=[
                              Constant(value='greeting_word_range'),
                              Tuple(
                                elts=[
                                  Constant(value=2),
                                  Constant(value=4)],
                                ctx=Load())]),
                          Constant(value=True)]),
                      Dict(
                        keys=[
                          Constant(value='word_range'),
                          Constant(value='required')],
                        values=[
                          Tuple(
                            elts=[
                              Call(
                                func=Attribute(
                                  value=Name(id='constraints', ctx=Load()),
                                  attr='get',
                                  ctx=Load()),
                                args=[
                                  Constant(value='body_min_words'),
                                  Constant(value=25)]),
                              Subscript(
                                value=Subscript(
                                  value=Name(id='constraints', ctx=Load()),
