    ClassDef(
      name='ConstraintFeasibilityChecker',
      body=[
        Expr(
          value=Constant(value='\n    Pre-flight check for constraint feasibility\n    ')),
        FunctionDef(
          name='check_feasibility',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='route',
                annotation=Name(id='Route', ctx=Load())),
              arg(
                arg='archetype',
                annotation=Name(id='Archetype', ctx=Load())),
              arg(
                arg='required_elements',
                annotation=Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Name(id='str', ctx=Load()),
                  ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Check if constraints are feasible given available context\n        ')),
            Assign(
              targets=[
                Name(id='constraints', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='CONFIG_REGISTRY', ctx=Load()),
                  attr='get_route_constraints',
                  ctx=Load()),
                args=[
                  Name(id='route', ctx=Load()),
                  Name(id='archetype', ctx=Load())])),
            Assign(
              targets=[
                Name(id='target_words', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='CONFIG_REGISTRY', ctx=Load()),
                  attr='get_target_word_count',
                  ctx=Load()),
                args=[
                  Name(id='archetype', ctx=Load()),
                  Name(id='route', ctx=Load())])),
            Assign(
              targets=[
                Name(id='min_words_per_element', ctx=Store())],
              value=Constant(value=3)),
            Assign(
              targets=[
                Name(id='min_total_words', ctx=Store())],
              value=BinOp(
                left=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Name(id='required_elements', ctx=Load())]),
                op=Mult(),
                right=Name(id='min_words_per_element', ctx=Load()))),
            If(
              test=Compare(
                left=Name(id='target_words', ctx=Load()),
                ops=[
                  Lt()],
                comparators=[
                  Name(id='min_total_words', ctx=Load())]),
              body=[
                Return(
                  value=Tuple(
                    elts=[
                      Constant(value=False),
                      JoinedStr(
                        values=[
                          Constant(value='Target word count ('),
                          FormattedValue(
                            value=Name(id='target_words', ctx=Load()),
                            conversion=-1),
                          Constant(value=') insufficient for '),
                          FormattedValue(
                            value=Call(
                              func=Name(id='len', ctx=Load()),
                              args=[
                                Name(id='required_elements', ctx=Load())]),
                            conversion=-1),
                          Constant(value=' required elements')])],
                    ctx=Load()))]),
            If(
              test=BoolOp(
                op=And(),
                values=[
                  Compare(
                    left=Name(id='route', ctx=Load()),
                    ops=[
                      Eq()],
                    comparators=[
                      Attribute(
                        value=Name(id='Route', ctx=Load()),
                        attr='CONNECTION_REQ',
                        ctx=Load())]),
                  Compare(
                    left=Call(
                      func=Name(id='len', ctx=Load()),
                      args=[
                        Name(id='required_elements', ctx=Load())]),
                    ops=[
                      Gt()],
                    comparators=[
                      Constant(value=4)])]),
              body=[
                Return(
                  value=Tuple(
                    elts=[
                      Constant(value=False),
                      Constant(value='Too many required elements for CONNECTION_REQ (max 4)')],
                    ctx=Load()))]),
            Return(
              value=Tuple(
                elts=[
                  Constant(value=True),
                  Constant(value='Constraints feasible')],
                ctx=Load()))],
          returns=Subscript(
            value=Name(id='Tuple', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='bool', ctx=Load()),
                Name(id='str', ctx=Load())],
              ctx=Load()),
            ctx=Load()))]),
