                op=Mult(),
                right=Constant(value=0.1))),
            Assign(
              targets=[
                Name(id='confidence', ctx=Store())],
              value=BinOp(
                left=BinOp(
                  left=Name(id='base_score', ctx=Load()),
                  op=Add(),
                  right=Name(id='diversity_bonus', ctx=Load())),
