                                args=[
                                  Name(id='current_phrase', ctx=Load())])]))]),
                    Assign(
                      targets=[
                        Name(id='current_phrase', ctx=Store())],
                      value=List(ctx=Load()))])]),
            If(
              test=Compare(
                left=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Name(id='current_phrase', ctx=Load())]),
                ops=[
                  GtE()],
                comparators=[
                  Constant(value=2)]),
              body=[
                Expr(
                  value=Call(
