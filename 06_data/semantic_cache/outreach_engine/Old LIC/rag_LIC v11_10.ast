                            iter=Name(id='rag_results', ctx=Load()),
                            is_async=0)])])])),
            Assign(
              targets=[
                Name(id='base_score', ctx=Store())],
              value=Call(
                func=Name(id='min', ctx=Load()),
                args=[
                  Constant(value=0.75),
                  BinOp(
                    left=Name(id='num_results', ctx=Load()),
                    op=Mult(),
                    right=Constant(value=0.15))])),
            Assign(
              targets=[
                Name(id='diversity_bonus', ctx=Store())],
              value=Call(
                func=Name(id='min', ctx=Load()),
                args=[
                  Constant(value=0.3),
                  BinOp(
