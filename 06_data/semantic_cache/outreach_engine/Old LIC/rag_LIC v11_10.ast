                    elts=[
                      Name(id='str', ctx=Load()),
                      Name(id='int', ctx=Load())],
                    ctx=Load()),
                  ctx=Load())],
              ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='validate_minimum_signal',
          args=arguments(
            args=[
              arg(arg='self'),
