                  orelse=[
                    Assign(
                      targets=[
                        Name(id='remaining_tokens', ctx=Store())],
                      value=BinOp(
                        left=Name(id='token_budget', ctx=Load()),
                        op=Sub(),
                        right=Name(id='running_tokens', ctx=Load()))),
                    Assign(
                      targets=[
                        Name(id='remaining_chars', ctx=Store())],
                      value=BinOp(
                        left=Name(id='remaining_tokens', ctx=Load()),
                        op=Mult(),
                        right=Attribute(
                          value=Name(id='cls', ctx=Load()),
                          attr='CHARS_PER_TOKEN',
                          ctx=Load()))),
                    If(
                      test=Compare(
                        left=Name(id='remaining_chars', ctx=Load()),
                        ops=[
                          Gt()],
                        comparators=[
                          Constant(value=100)]),
                      body=[
                        Assign(
                          targets=[
                            Subscript(
                              value=Name(id='truncated', ctx=Load()),
                              slice=Name(id='section_name', ctx=Load()),
                              ctx=Store())],
                          value=BinOp(
                            left=Subscript(
                              value=Name(id='section_text', ctx=Load()),
                              slice=Slice(
                                upper=Name(id='remaining_chars', ctx=Load())),
                              ctx=Load()),
                            op=Add(),
                            right=Constant(value='... [truncated]'))),
                        Assign(
                          targets=[
                            Name(id='running_tokens', ctx=Store())],
                          value=Name(id='token_budget', ctx=Load())),
                        Expr(
                          value=Call(
                            func=Name(id='print', ctx=Load()),
                            args=[
                              JoinedStr(
                                values=[
                                  Constant(value="[ContextManager] Truncated '"),
                                  FormattedValue(
                                    value=Name(id='section_name', ctx=Load()),
                                    conversion=-1),
                                  Constant(value="' to fit budget")])]))],
                      orelse=[
                        Expr(
                          value=Call(
                            func=Name(id='print', ctx=Load()),
                            args=[
                              JoinedStr(
                                values=[
                                  Constant(value="[ContextManager] Dropped '"),
                                  FormattedValue(
                                    value=Name(id='section_name', ctx=Load()),
                                    conversion=-1),
                                  Constant(value="' - insufficient space")])]))]),
                    Break()])]),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='[ContextManager] Truncation complete: '),
                      FormattedValue(
