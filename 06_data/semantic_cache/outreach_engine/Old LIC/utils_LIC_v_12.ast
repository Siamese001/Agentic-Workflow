            ctx=Load()))]),
    ClassDef(
      name='AdaptiveTemperatureController',
      body=[
        Expr(
          value=Constant(value='\n    Progressive temperature escalation for retry attempts.\n    FEATURE 2.2 from SUPREME_SPELL\n    \n    Each archetype has a base temperature. On retry attempts,\n    temperature increases by ESCALATION_STEP to encourage more\n    creative solutions, up to MAX_TEMPERATURE.\n    \n    Example:\n    - Attempt 1: 0.45 (base for C_LEVEL)\n    - Attempt 2: 0.60 (base + 0.15)\n    - Attempt 3: 0.75 (base + 0.30)\n    - Attempt 4+: 0.95 (capped at MAX)\n    ')),
        Assign(
          targets=[
            Name(id='BASE_TEMPERATURES', ctx=Store())],
          value=Dict(
            keys=[
              Attribute(
                value=Name(id='Archetype', ctx=Load()),
                attr='C_LEVEL',
                ctx=Load()),
              Attribute(
                value=Name(id='Archetype', ctx=Load()),
                attr='EXECUTIVE',
                ctx=Load()),
              Attribute(
                value=Name(id='Archetype', ctx=Load()),
                attr='SENIOR_TA',
                ctx=Load()),
              Attribute(
                value=Name(id='Archetype', ctx=Load()),
                attr='RECRUITER',
                ctx=Load())],
            values=[
              Constant(value=0.45),
              Constant(value=0.5),
              Constant(value=0.55),
              Constant(value=0.65)])),
        Assign(
          targets=[
            Name(id='ESCALATION_STEP', ctx=Store())],
          value=Constant(value=0.15)),
        Assign(
          targets=[
            Name(id='MAX_TEMPERATURE', ctx=Store())],
          value=Constant(value=0.95)),
        FunctionDef(
          name='__init__',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Initialize temperature controller with history tracking')),
            AnnAssign(
              target=Attribute(
                value=Name(id='self', ctx=Load()),
                attr='attempt_history',
                ctx=Store()),
              annotation=Subscript(
                value=Name(id='Dict', ctx=Load()),
                slice=Tuple(
                  elts=[
                    Name(id='str', ctx=Load()),
                    Subscript(
                      value=Name(id='List', ctx=Load()),
                      slice=Name(id='float', ctx=Load()),
                      ctx=Load())],
                  ctx=Load()),
                ctx=Load()),
              value=Call(
                func=Name(id='defaultdict', ctx=Load()),
                args=[
                  Name(id='list', ctx=Load())]),
              simple=0),
            AnnAssign(
              target=Attribute(
                value=Name(id='self', ctx=Load()),
                attr='success_temperatures',
                ctx=Store()),
              annotation=Subscript(
                value=Name(id='Dict', ctx=Load()),
                slice=Tuple(
                  elts=[
                    Name(id='str', ctx=Load()),
                    Name(id='float', ctx=Load())],
                  ctx=Load()),
                ctx=Load()),
              value=Dict(),
              simple=0)]),
        FunctionDef(
          name='get_temperature',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='component',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='archetype',
