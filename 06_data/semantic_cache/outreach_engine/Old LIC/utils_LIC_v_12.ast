                    value=Name(id='CircuitState', ctx=Load()),
                    attr='OPEN',
                    ctx=Load())]),
              body=[
                If(
                  test=BoolOp(
                    op=And(),
                    values=[
                      Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='last_failure_time',
                        ctx=Load()),
                      Compare(
                        left=BinOp(
                          left=Call(
                            func=Attribute(
                              value=Name(id='datetime', ctx=Load()),
                              attr='now',
                              ctx=Load())),
                          op=Sub(),
                          right=Attribute(
                            value=Name(id='self', ctx=Load()),
                            attr='last_failure_time',
                            ctx=Load())),
                        ops=[
                          Gt()],
                        comparators=[
                          Call(
