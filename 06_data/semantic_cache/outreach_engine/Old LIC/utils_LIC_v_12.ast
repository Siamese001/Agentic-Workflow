                                  FormattedValue(
                                    value=Attribute(
                                      value=Name(id='self', ctx=Load()),
                                      attr='failure_threshold',
                                      ctx=Load()),
                                    conversion=-1)])]))]),
                    Raise()])])])]),
    ClassDef(
      name='ContextManager',
      body=[
        Expr(
          value=Constant(value='\n    Intelligent context window management with priority-based truncation\n    GAP 7.1, 7.2, 7.3 from v10.22\n    \n    Different sections of context have different priorities:\n    - Job description: Highest priority, never truncate\n    - Recipient profile: High priority\n    - Company context: Medium-high priority\n    - Sender profile: Medium priority\n    - RAG results: Lower priority, truncate oldest first\n    - Examples: Lowest priority, truncate first\n    ')),
        Assign(
          targets=[
            Name(id='SECTION_PRIORITIES', ctx=Store())],
          value=Dict(
            keys=[
              Constant(value='job_description'),
              Constant(value='recipient_profile'),
              Constant(value='company_context'),
              Constant(value='sender_profile'),
              Constant(value='rag_recent'),
              Constant(value='rag_historical'),
              Constant(value='examples')],
            values=[
              Constant(value=100),
              Constant(value=90),
              Constant(value=80),
              Constant(value=70),
              Constant(value=60),
              Constant(value=40),
              Constant(value=30)])),
        Assign(
          targets=[
            Name(id='MAX_CONTEXT_TOKENS', ctx=Store())],
          value=Constant(value=180000)),
        Assign(
          targets=[
            Name(id='CHARS_PER_TOKEN', ctx=Store())],
          value=Constant(value=4)),
        FunctionDef(
          name='truncate_intelligently',
          args=arguments(
            args=[
              arg(arg='cls'),
              arg(
                arg='context_sections',
                annotation=Subscript(
                  value=Name(id='Dict', ctx=Load()),
                  slice=Tuple(
                    elts=[
                      Name(id='str', ctx=Load()),
                      Name(id='str', ctx=Load())],
                    ctx=Load()),
                  ctx=Load())),
              arg(
                arg='max_tokens',
                annotation=Name(id='int', ctx=Load()))],
            defaults=[
              Name(id='MAX_CONTEXT_TOKENS', ctx=Load())]),
          body=[
            Expr(
              value=Constant(value='\n        Truncate context sections by priority if exceeding token limit.\n        \n        Args:\n            context_sections: Dictionary of section_name -> section_text\n            max_tokens: Maximum tokens allowed\n        \n        Returns:\n            Truncated context_sections dictionary\n        ')),
            Assign(
              targets=[
                Name(id='total_chars', ctx=Store())],
              value=Call(
                func=Name(id='sum', ctx=Load()),
                args=[
                  GeneratorExp(
                    elt=Call(
                      func=Name(id='len', ctx=Load()),
                      args=[
                        Name(id='text', ctx=Load())]),
                    generators=[
                      comprehension(
                        target=Name(id='text', ctx=Store()),
                        iter=Call(
                          func=Attribute(
                            value=Name(id='context_sections', ctx=Load()),
                            attr='values',
                            ctx=Load())),
                        is_async=0)])])),
            Assign(
              targets=[
                Name(id='estimated_tokens', ctx=Store())],
              value=BinOp(
                left=Name(id='total_chars', ctx=Load()),
                op=FloorDiv(),
                right=Attribute(
                  value=Name(id='cls', ctx=Load()),
                  attr='CHARS_PER_TOKEN',
                  ctx=Load()))),
            If(
              test=Compare(
                left=Name(id='estimated_tokens', ctx=Load()),
                ops=[
                  LtE()],
                comparators=[
                  Name(id='max_tokens', ctx=Load())]),
              body=[
                Return(
                  value=Name(id='context_sections', ctx=Load()))]),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='[ContextManager] Context exceeds limit ('),
                      FormattedValue(
                        value=Name(id='estimated_tokens', ctx=Load()),
                        conversion=-1),
                      Constant(value=' > '),
                      FormattedValue(
                        value=Name(id='max_tokens', ctx=Load()),
                        conversion=-1),
                      Constant(value=' tokens), truncating...')])])),
            Assign(
              targets=[
                Name(id='sorted_sections', ctx=Store())],
              value=Call(
                func=Name(id='sorted', ctx=Load()),
                args=[
                  Call(
