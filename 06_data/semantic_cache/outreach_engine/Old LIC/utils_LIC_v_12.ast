                annotation=Name(id='int', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Get temperature for this generation attempt.\n        \n        Args:\n            component: Component identifier (e.g., "body", "cta")\n            archetype: Recipient archetype\n            attempt: Attempt number (1-indexed)\n        \n        Returns:\n            Temperature value for LLM generation\n        ')),
            Assign(
              targets=[
                Name(id='base_temp', ctx=Store())],
              value=Subscript(
                value=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='BASE_TEMPERATURES',
                  ctx=Load()),
                slice=Name(id='archetype', ctx=Load()),
                ctx=Load())),
            Assign(
              targets=[
                Name(id='escalated_temp', ctx=Store())],
              value=Call(
                func=Name(id='min', ctx=Load()),
                args=[
                  Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='MAX_TEMPERATURE',
                    ctx=Load()),
                  BinOp(
                    left=Name(id='base_temp', ctx=Load()),
                    op=Add(),
                    right=BinOp(
                      left=BinOp(
                        left=Name(id='attempt', ctx=Load()),
                        op=Sub(),
                        right=Constant(value=1)),
                      op=Mult(),
                      right=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='ESCALATION_STEP',
                        ctx=Load())))])),
            Assign(
              targets=[
                Name(id='key', ctx=Store())],
              value=JoinedStr(
                values=[
                  FormattedValue(
                    value=Attribute(
                      value=Name(id='archetype', ctx=Load()),
                      attr='value',
                      ctx=Load()),
                    conversion=-1),
                  Constant(value='_'),
                  FormattedValue(
                    value=Name(id='component', ctx=Load()),
                    conversion=-1)])),
            Expr(
              value=Call(
                func=Attribute(
                  value=Subscript(
                    value=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='attempt_history',
                      ctx=Load()),
                    slice=Name(id='key', ctx=Load()),
                    ctx=Load()),
                  attr='append',
                  ctx=Load()),
                args=[
                  Name(id='escalated_temp', ctx=Load())])),
            If(
              test=Compare(
                left=Name(id='attempt', ctx=Load()),
                ops=[
                  Gt()],
                comparators=[
                  Constant(value=1)]),
              body=[
                Expr(
                  value=Call(
                    func=Name(id='print', ctx=Load()),
                    args=[
                      JoinedStr(
                        values=[
                          Constant(value='[TempController] Escalating temperature for '),
                          FormattedValue(
                            value=Name(id='component', ctx=Load()),
                            conversion=-1),
                          Constant(value=': '),
                          FormattedValue(
                            value=Name(id='escalated_temp', ctx=Load()),
                            conversion=-1,
                            format_spec=JoinedStr(
                              values=[
                                Constant(value='.2f')])),
                          Constant(value=' (attempt '),
                          FormattedValue(
                            value=Name(id='attempt', ctx=Load()),
                            conversion=-1),
                          Constant(value=')')])]))]),
            Return(
              value=Name(id='escalated_temp', ctx=Load()))],
          returns=Name(id='float', ctx=Load())),
        FunctionDef(
          name='record_success',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='component',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='archetype',
                annotation=Name(id='Archetype', ctx=Load())),
              arg(
                arg='temperature',
                annotation=Name(id='float', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Record which temperature succeeded for learning.\n        \n        Args:\n            component: Component identifier\n            archetype: Recipient archetype\n            temperature: Temperature that succeeded\n        ')),
            Assign(
              targets=[
                Name(id='key', ctx=Store())],
              value=JoinedStr(
                values=[
                  FormattedValue(
                    value=Attribute(
                      value=Name(id='archetype', ctx=Load()),
                      attr='value',
                      ctx=Load()),
                    conversion=-1),
                  Constant(value='_'),
                  FormattedValue(
                    value=Name(id='component', ctx=Load()),
                    conversion=-1)])),
            Assign(
              targets=[
                Subscript(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='success_temperatures',
                    ctx=Load()),
                  slice=Name(id='key', ctx=Load()),
                  ctx=Store())],
              value=Name(id='temperature', ctx=Load())),
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='[TempController] Success recorded for '),
                      FormattedValue(
                        value=Name(id='component', ctx=Load()),
                        conversion=-1),
                      Constant(value=' at temp '),
                      FormattedValue(
                        value=Name(id='temperature', ctx=Load()),
                        conversion=-1,
                        format_spec=JoinedStr(
                          values=[
                            Constant(value='.2f')]))])]))]),
        FunctionDef(
          name='get_success_rate',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='component',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='archetype',
                annotation=Name(id='Archetype', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Get average success temperature for component+archetype.\n        \n        Args:\n            component: Component identifier\n            archetype: Recipient archetype\n        \n        Returns:\n            Average successful temperature, or None if no history\n        ')),
            Assign(
              targets=[
                Name(id='key', ctx=Store())],
              value=JoinedStr(
                values=[
                  FormattedValue(
                    value=Attribute(
                      value=Name(id='archetype', ctx=Load()),
                      attr='value',
                      ctx=Load()),
                    conversion=-1),
                  Constant(value='_'),
                  FormattedValue(
                    value=Name(id='component', ctx=Load()),
                    conversion=-1)])),
            If(
              test=Compare(
                left=Name(id='key', ctx=Load()),
                ops=[
                  In()],
                comparators=[
                  Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='success_temperatures',
                    ctx=Load())]),
              body=[
                Return(
                  value=Subscript(
                    value=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='success_temperatures',
                      ctx=Load()),
                    slice=Name(id='key', ctx=Load()),
                    ctx=Load()))]),
            Return(
              value=Constant(value=None))],
          returns=Subscript(
            value=Name(id='Optional', ctx=Load()),
            slice=Name(id='float', ctx=Load()),
            ctx=Load()))]),
    ClassDef(
      name='TextProcessor',
      body=[
        Expr(
          value=Constant(value='Utility functions for text processing and analysis')),
        FunctionDef(
          name='count_words',
          args=arguments(
            args=[
              arg(
                arg='text',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Count words in text.\n        \n        Args:\n            text: Input text\n        \n        Returns:\n            Word count\n        ')),
            Return(
              value=Call(
                func=Name(id='len', ctx=Load()),
                args=[
                  Call(
                    func=Attribute(
                      value=Name(id='text', ctx=Load()),
                      attr='split',
                      ctx=Load()))]))],
          decorator_list=[
            Name(id='staticmethod', ctx=Load())],
          returns=Name(id='int', ctx=Load())),
        FunctionDef(
          name='count_chars',
          args=arguments(
            args=[
              arg(
                arg='text',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Count characters in text.\n        \n        Args:\n            text: Input text\n        \n        Returns:\n            Character count\n        ')),
            Return(
              value=Call(
                func=Name(id='len', ctx=Load()),
                args=[
                  Name(id='text', ctx=Load())]))],
          decorator_list=[
            Name(id='staticmethod', ctx=Load())],
          returns=Name(id='int', ctx=Load())),
        FunctionDef(
          name='extract_sentences',
          args=arguments(
            args=[
              arg(
                arg='text',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Extract sentences from text.\n        \n        Args:\n            text: Input text\n        \n        Returns:\n            List of sentences\n        ')),
            Assign(
              targets=[
                Name(id='sentences', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='re', ctx=Load()),
                  attr='split',
                  ctx=Load()),
                args=[
                  Constant(value='[.!?]+'),
                  Name(id='text', ctx=Load())])),
            Return(
              value=ListComp(
                elt=Call(
                  func=Attribute(
                    value=Name(id='s', ctx=Load()),
                    attr='strip',
                    ctx=Load())),
                generators=[
                  comprehension(
                    target=Name(id='s', ctx=Store()),
                    iter=Name(id='sentences', ctx=Load()),
                    ifs=[
                      Call(
                        func=Attribute(
                          value=Name(id='s', ctx=Load()),
                          attr='strip',
                          ctx=Load()))],
                    is_async=0)]))],
          decorator_list=[
            Name(id='staticmethod', ctx=Load())],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='extract_metrics',
          args=arguments(
            args=[
              arg(
                arg='text',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Extract quantitative metrics from text.\n        \n        Args:\n            text: Input text\n        \n        Returns:\n            List of metrics (percentages, multipliers, large numbers)\n        ')),
            Assign(
              targets=[
                Name(id='metric_pattern', ctx=Store())],
              value=Constant(value='\\b\\d+%|\\b\\d+x\\b|\\b\\d+\\s*(million|billion|thousand|k)\\b')),
            Return(
              value=Call(
                func=Attribute(
                  value=Name(id='re', ctx=Load()),
                  attr='findall',
                  ctx=Load()),
                args=[
                  Name(id='metric_pattern', ctx=Load()),
                  Name(id='text', ctx=Load()),
                  Attribute(
                    value=Name(id='re', ctx=Load()),
                    attr='IGNORECASE',
                    ctx=Load())]))],
          decorator_list=[
            Name(id='staticmethod', ctx=Load())],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='remove_extra_whitespace',
          args=arguments(
            args=[
              arg(
                arg='text',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Remove extra whitespace from text.\n        \n        Args:\n            text: Input text\n        \n        Returns:\n            Cleaned text\n        ')),
            Assign(
              targets=[
                Name(id='text', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='re', ctx=Load()),
                  attr='sub',
                  ctx=Load()),
                args=[
                  Constant(value='\\s+'),
                  Constant(value=' '),
                  Name(id='text', ctx=Load())])),
            Return(
              value=Call(
                func=Attribute(
                  value=Name(id='text', ctx=Load()),
                  attr='strip',
                  ctx=Load())))],
          decorator_list=[
            Name(id='staticmethod', ctx=Load())],
          returns=Name(id='str', ctx=Load())),
        FunctionDef(
          name='truncate_text',
          args=arguments(
            args=[
              arg(
                arg='text',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='max_chars',
                annotation=Name(id='int', ctx=Load())),
              arg(
                arg='suffix',
                annotation=Name(id='str', ctx=Load()))],
            defaults=[
              Constant(value='...')]),
          body=[
            Expr(
              value=Constant(value='\n        Truncate text to maximum character length.\n        \n        Args:\n            text: Input text\n            max_chars: Maximum characters\n            suffix: Suffix to add if truncated\n        \n        Returns:\n            Truncated text\n        ')),
            If(
              test=Compare(
                left=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Name(id='text', ctx=Load())]),
                ops=[
                  LtE()],
                comparators=[
                  Name(id='max_chars', ctx=Load())]),
              body=[
                Return(
                  value=Name(id='text', ctx=Load()))]),
            Return(
              value=BinOp(
                left=Subscript(
                  value=Name(id='text', ctx=Load()),
                  slice=Slice(
                    upper=BinOp(
                      left=Name(id='max_chars', ctx=Load()),
                      op=Sub(),
                      right=Call(
                        func=Name(id='len', ctx=Load()),
                        args=[
                          Name(id='suffix', ctx=Load())]))),
                  ctx=Load()),
                op=Add(),
                right=Name(id='suffix', ctx=Load())))],
          decorator_list=[
            Name(id='staticmethod', ctx=Load())],
          returns=Name(id='str', ctx=Load()))]),
    ClassDef(
      name='ValidationHelper',
      body=[
        Expr(
          value=Constant(value='Helper functions for validation logic')),
        FunctionDef(
          name='check_word_count_range',
          args=arguments(
            args=[
              arg(
                arg='text',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='min_words',
                annotation=Name(id='int', ctx=Load())),
              arg(
                arg='max_words',
                annotation=Name(id='int', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Check if text is within word count range.\n        \n        Args:\n            text: Input text\n            min_words: Minimum word count\n            max_words: Maximum word count\n        \n        Returns:\n            (is_valid, message)\n        ')),
            Assign(
              targets=[
                Name(id='word_count', ctx=Store())],
              value=Call(
                func=Name(id='len', ctx=Load()),
                args=[
                  Call(
                    func=Attribute(
                      value=Name(id='text', ctx=Load()),
                      attr='split',
                      ctx=Load()))])),
            If(
              test=Compare(
                left=Name(id='word_count', ctx=Load()),
                ops=[
                  Lt()],
                comparators=[
                  Name(id='min_words', ctx=Load())]),
              body=[
                Return(
                  value=Tuple(
                    elts=[
                      Constant(value=False),
                      JoinedStr(
                        values=[
                          Constant(value='Word count '),
                          FormattedValue(
                            value=Name(id='word_count', ctx=Load()),
                            conversion=-1),
                          Constant(value=' below minimum '),
                          FormattedValue(
                            value=Name(id='min_words', ctx=Load()),
                            conversion=-1)])],
                    ctx=Load()))],
              orelse=[
                If(
                  test=Compare(
                    left=Name(id='word_count', ctx=Load()),
                    ops=[
                      Gt()],
                    comparators=[
                      Name(id='max_words', ctx=Load())]),
                  body=[
                    Return(
                      value=Tuple(
                        elts=[
                          Constant(value=False),
                          JoinedStr(
                            values=[
                              Constant(value='Word count '),
                              FormattedValue(
                                value=Name(id='word_count', ctx=Load()),
                                conversion=-1),
                              Constant(value=' exceeds maximum '),
                              FormattedValue(
                                value=Name(id='max_words', ctx=Load()),
                                conversion=-1)])],
                        ctx=Load()))])]),
            Return(
              value=Tuple(
                elts=[
                  Constant(value=True),
                  JoinedStr(
                    values=[
                      Constant(value='Word count '),
                      FormattedValue(
                        value=Name(id='word_count', ctx=Load()),
                        conversion=-1),
                      Constant(value=' within range ['),
                      FormattedValue(
                        value=Name(id='min_words', ctx=Load()),
                        conversion=-1),
                      Constant(value=', '),
                      FormattedValue(
                        value=Name(id='max_words', ctx=Load()),
                        conversion=-1),
                      Constant(value=']')])],
                ctx=Load()))],
          decorator_list=[
            Name(id='staticmethod', ctx=Load())],
          returns=Subscript(
            value=Name(id='Tuple', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='bool', ctx=Load()),
                Name(id='str', ctx=Load())],
              ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='check_char_limit',
          args=arguments(
            args=[
              arg(
                arg='text',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='max_chars',
                annotation=Name(id='int', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Check if text exceeds character limit.\n        \n        Args:\n            text: Input text\n            max_chars: Maximum characters\n        \n        Returns:\n            (is_valid, message)\n        ')),
            Assign(
              targets=[
                Name(id='char_count', ctx=Store())],
              value=Call(
                func=Name(id='len', ctx=Load()),
                args=[
                  Name(id='text', ctx=Load())])),
            If(
              test=Compare(
                left=Name(id='char_count', ctx=Load()),
                ops=[
                  Gt()],
                comparators=[
                  Name(id='max_chars', ctx=Load())]),
              body=[
                Return(
                  value=Tuple(
                    elts=[
                      Constant(value=False),
                      JoinedStr(
                        values=[
                          Constant(value='Character count '),
                          FormattedValue(
                            value=Name(id='char_count', ctx=Load()),
                            conversion=-1),
                          Constant(value=' exceeds limit '),
                          FormattedValue(
                            value=Name(id='max_chars', ctx=Load()),
                            conversion=-1)])],
                    ctx=Load()))]),
            Return(
              value=Tuple(
                elts=[
                  Constant(value=True),
                  JoinedStr(
                    values=[
                      Constant(value='Character count '),
                      FormattedValue(
                        value=Name(id='char_count', ctx=Load()),
                        conversion=-1),
                      Constant(value=' within limit '),
                      FormattedValue(
                        value=Name(id='max_chars', ctx=Load()),
                        conversion=-1)])],
                ctx=Load()))],
          decorator_list=[
            Name(id='staticmethod', ctx=Load())],
          returns=Subscript(
            value=Name(id='Tuple', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='bool', ctx=Load()),
                Name(id='str', ctx=Load())],
              ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='find_placeholders',
          args=arguments(
            args=[
              arg(
                arg='text',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Find placeholder patterns in text.\n        \n        Args:\n            text: Input text\n        \n        Returns:\n            List of placeholder patterns found\n        ')),
            Assign(
              targets=[
                Name(id='patterns', ctx=Store())],
              value=List(
                elts=[
                  Constant(value='\\[.*?\\]'),
                  Constant(value='\\{.*?\\}'),
                  Constant(value='<.*?>'),
                  Constant(value='\\bPLACEHOLDER\\b'),
                  Constant(value='\\bTODO\\b'),
                  Constant(value='\\bXXX\\b'),
                  Constant(value='\\bFIXME\\b')],
                ctx=Load())),
            Assign(
              targets=[
                Name(id='found', ctx=Store())],
              value=List(ctx=Load())),
            For(
              target=Name(id='pattern', ctx=Store()),
              iter=Name(id='patterns', ctx=Load()),
              body=[
                Assign(
                  targets=[
                    Name(id='matches', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='re', ctx=Load()),
                      attr='findall',
                      ctx=Load()),
                    args=[
                      Name(id='pattern', ctx=Load()),
                      Name(id='text', ctx=Load()),
                      Attribute(
                        value=Name(id='re', ctx=Load()),
                        attr='IGNORECASE',
                        ctx=Load())])),
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='found', ctx=Load()),
                      attr='extend',
                      ctx=Load()),
                    args=[
                      Name(id='matches', ctx=Load())]))]),
            Return(
              value=Name(id='found', ctx=Load()))],
          decorator_list=[
            Name(id='staticmethod', ctx=Load())],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='calculate_checksum',
          args=arguments(
            args=[
              arg(
                arg='text',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Calculate simple checksum for text.\n        \n        Args:\n            text: Input text\n        \n        Returns:\n            Hexadecimal checksum string\n        ')),
            Import(
              names=[
                alias(name='hashlib')]),
            Return(
              value=Subscript(
                value=Call(
                  func=Attribute(
                    value=Call(
                      func=Attribute(
                        value=Name(id='hashlib', ctx=Load()),
                        attr='md5',
                        ctx=Load()),
                      args=[
                        Call(
                          func=Attribute(
                            value=Name(id='text', ctx=Load()),
                            attr='encode',
                            ctx=Load()))]),
                    attr='hexdigest',
                    ctx=Load())),
                slice=Slice(
                  upper=Constant(value=16)),
                ctx=Load()))],
          decorator_list=[
            Name(id='staticmethod', ctx=Load())],
          returns=Name(id='str', ctx=Load()))]),
    ClassDef(
      name='Timer',
      body=[
        Expr(
          value=Constant(value='Simple timer for measuring execution time')),
        FunctionDef(
          name='__init__',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Initialize timer')),
            AnnAssign(
              target=Attribute(
                value=Name(id='self', ctx=Load()),
                attr='start_time',
                ctx=Store()),
              annotation=Subscript(
                value=Name(id='Optional', ctx=Load()),
                slice=Name(id='datetime', ctx=Load()),
                ctx=Load()),
              value=Constant(value=None),
              simple=0),
            AnnAssign(
              target=Attribute(
                value=Name(id='self', ctx=Load()),
                attr='end_time',
                ctx=Store()),
              annotation=Subscript(
                value=Name(id='Optional', ctx=Load()),
                slice=Name(id='datetime', ctx=Load()),
                ctx=Load()),
              value=Constant(value=None),
              simple=0)]),
        FunctionDef(
          name='start',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Start timer')),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='start_time',
                  ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='datetime', ctx=Load()),
                  attr='now',
                  ctx=Load())))]),
        FunctionDef(
          name='stop',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='\n        Stop timer and return elapsed seconds.\n        \n        Returns:\n            Elapsed time in seconds\n        ')),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='end_time',
                  ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='datetime', ctx=Load()),
                  attr='now',
                  ctx=Load()))),
            If(
              test=Compare(
                left=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='start_time',
                  ctx=Load()),
                ops=[
                  Is()],
                comparators=[
                  Constant(value=None)]),
              body=[
                Return(
                  value=Constant(value=0.0))]),
            Return(
              value=Call(
                func=Attribute(
                  value=BinOp(
                    left=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='end_time',
                      ctx=Load()),
                    op=Sub(),
                    right=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='start_time',
                      ctx=Load())),
                  attr='total_seconds',
                  ctx=Load())))],
          returns=Name(id='float', ctx=Load())),
        FunctionDef(
          name='elapsed',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='\n        Get elapsed time without stopping timer.\n        \n        Returns:\n            Elapsed time in seconds\n        ')),
            If(
              test=Compare(
                left=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='start_time',
                  ctx=Load()),
                ops=[
                  Is()],
                comparators=[
                  Constant(value=None)]),
              body=[
                Return(
                  value=Constant(value=0.0))]),
            Return(
              value=Call(
                func=Attribute(
                  value=BinOp(
                    left=Call(
                      func=Attribute(
                        value=Name(id='datetime', ctx=Load()),
                        attr='now',
                        ctx=Load())),
                    op=Sub(),
                    right=Attribute(
                      value=Name(id='self', ctx=Load()),
                      attr='start_time',
                      ctx=Load())),
                  attr='total_seconds',
                  ctx=Load())))],
          returns=Name(id='float', ctx=Load()))])])