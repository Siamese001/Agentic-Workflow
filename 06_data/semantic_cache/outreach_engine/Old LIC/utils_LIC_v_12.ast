            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='str', ctx=Load())],
              ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='detect_overflow',
          args=arguments(
            args=[
              arg(arg='cls'),
              arg(
                arg='context_text',
                annotation=Name(id='str', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Detect if context exceeds safe limits.\n        \n        Args:\n            context_text: Full context string\n        \n        Returns:\n            (is_overflow, estimated_tokens)\n        ')),
            Assign(
              targets=[
                Name(id='estimated_tokens', ctx=Store())],
              value=BinOp(
                left=Call(
