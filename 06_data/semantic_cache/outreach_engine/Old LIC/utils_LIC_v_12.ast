                                  attr='timeout_seconds',
                                  ctx=Load()),
                                conversion=-1),
                              Constant(value='s)')])]))])]),
            Try(
              body=[
                Assign(
                  targets=[
                    Name(id='result', ctx=Store())],
                  value=Call(
                    func=Name(id='func', ctx=Load()),
                    args=[
                      Starred(
