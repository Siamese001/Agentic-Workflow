                            keywords=[
                              keyword(
                                arg='seconds',
                                value=Attribute(
                                  value=Name(id='self', ctx=Load()),
                                  attr='timeout_seconds',
                                  ctx=Load()))])])]),
                  body=[
                    Assign(
                      targets=[
                        Attribute(
                          value=Name(id='self', ctx=Load()),
                          attr='state',
                          ctx=Store())],
