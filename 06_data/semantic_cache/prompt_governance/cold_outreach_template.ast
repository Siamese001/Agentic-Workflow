Module(
  body=[
    Expr(
      value=Constant(value='\nOutreach Engine API v1 Router\nLEVEL 4 - API routing configuration for outreach communication endpoints\n')),
    Import(
      names=[
        alias(name='sys')]),
    ImportFrom(
      module='pathlib',
      names=[
        alias(name='Path')],
      level=0),
    Assign(
      targets=[
        Name(id='project_root', ctx=Store())],
      value=Attribute(
        value=Attribute(
          value=Attribute(
            value=Attribute(
              value=Attribute(
                value=Call(
                  func=Name(id='Path', ctx=Load()),
                  args=[
                    Name(id='__file__', ctx=Load())]),
                attr='parent',
                ctx=Load()),
              attr='parent',
              ctx=Load()),
            attr='parent',
            ctx=Load()),
          attr='parent',
          ctx=Load()),
        attr='parent',
        ctx=Load())),
    Expr(
      value=Call(
        func=Attribute(
          value=Attribute(
            value=Name(id='sys', ctx=Load()),
            attr='path',
            ctx=Load()),
          attr='insert',
          ctx=Load()),
        args=[
          Constant(value=0),
          Call(
            func=Name(id='str', ctx=Load()),
            args=[
              Name(id='project_root', ctx=Load())])])),
    ImportFrom(
      module='fastapi',
      names=[
        alias(name='APIRouter')],
      level=0),
    ImportFrom(
      module='agentic_core.api',
      names=[
        alias(name='create_success_response'),
        alias(name='create_error_response'),
        alias(name='handle_errors'),
        alias(name='log_api_calls'),
        alias(name='ServiceUnavailableAPIException')],
      level=0),
    Try(
      body=[
        ImportFrom(
          module='endpoints',
          names=[
            alias(name='send_outreach'),
            alias(name='preview_message'),
            alias(name='healthcheck')],
          level=1),
        Assign(
          targets=[
            Name(id='ENDPOINTS_AVAILABLE', ctx=Store())],
          value=Constant(value=True))],
      handlers=[
        ExceptHandler(
          type=Name(id='ImportError', ctx=Load()),
          name='e',
          body=[
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='Warning: Could not import some endpoint routers: '),
                      FormattedValue(
                        value=Name(id='e', ctx=Load()),
                        conversion=-1)])])),
            Assign(
              targets=[
                Name(id='ENDPOINTS_AVAILABLE', ctx=Store())],
              value=Constant(value=False)),
            Assign(
              targets=[
                Name(id='send_outreach', ctx=Store())],
              value=Constant(value=None)),
            Assign(
              targets=[
                Name(id='preview_message', ctx=Store())],
              value=Constant(value=None)),
            Assign(
              targets=[
                Name(id='healthcheck', ctx=Store())],
              value=Constant(value=None))])]),
    Assign(
      targets=[
        Name(id='router', ctx=Store())],
      value=Call(
        func=Name(id='APIRouter', ctx=Load()),
        keywords=[
          keyword(
            arg='prefix',
            value=Constant(value='/outreach')),
          keyword(
            arg='tags',
            value=List(
              elts=[
                Constant(value='outreach')],
              ctx=Load()))])),
    If(
      test=Name(id='ENDPOINTS_AVAILABLE', ctx=Load()),
      body=[
        If(
          test=Name(id='send_outreach', ctx=Load()),
          body=[
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='router', ctx=Load()),
                  attr='include_router',
                  ctx=Load()),
                args=[
                  Attribute(
                    value=Name(id='send_outreach', ctx=Load()),
                    attr='router',
                    ctx=Load())],
                keywords=[
                  keyword(
                    arg='prefix',
                    value=Constant(value='/send')),
                  keyword(
                    arg='tags',
                    value=List(
                      elts=[
                        Constant(value='outreach-sending')],
                      ctx=Load()))]))]),
        If(
          test=Name(id='preview_message', ctx=Load()),
          body=[
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='router', ctx=Load()),
                  attr='include_router',
                  ctx=Load()),
                args=[
                  Attribute(
                    value=Name(id='preview_message', ctx=Load()),
                    attr='router',
                    ctx=Load())],
                keywords=[
                  keyword(
                    arg='prefix',
                    value=Constant(value='/preview')),
                  keyword(
                    arg='tags',
                    value=List(
                      elts=[
                        Constant(value='outreach-preview')],
                      ctx=Load()))]))]),
        If(
          test=Name(id='healthcheck', ctx=Load()),
          body=[
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='router', ctx=Load()),
                  attr='include_router',
                  ctx=Load()),
                args=[
                  Attribute(
                    value=Name(id='healthcheck', ctx=Load()),
                    attr='router',
                    ctx=Load())],
                keywords=[
                  keyword(
                    arg='prefix',
                    value=Constant(value='/health')),
                  keyword(
                    arg='tags',
                    value=List(
                      elts=[
                        Constant(value='health')],
                      ctx=Load()))]))])]),
    AsyncFunctionDef(
      name='root',
      args=arguments(),
      body=[
        Expr(
          value=Constant(value='Root endpoint for outreach engine')),
        Try(
          body=[
            If(
              test=UnaryOp(
                op=Not(),
                operand=Name(id='ENDPOINTS_AVAILABLE', ctx=Load())),
              body=[
                Return(
                  value=Call(
                    func=Name(id='create_error_response', ctx=Load()),
                    keywords=[
                      keyword(
                        arg='error_code',
                        value=Constant(value='ENDPOINTS_UNAVAILABLE')),
                      keyword(
                        arg='message',
                        value=Constant(value='Some endpoint routers are not available')),
                      keyword(
                        arg='error_type',
                        value=Constant(value='configuration_error'))]))]),
            Assign(
              targets=[
                Name(id='available_endpoints', ctx=Store())],
              value=List(ctx=Load())),
            If(
              test=Name(id='healthcheck', ctx=Load()),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='available_endpoints', ctx=Load()),
                      attr='extend',
                      ctx=Load()),
                    args=[
                      List(
                        elts=[
                          Constant(value='/health/ - Health check endpoints')],
                        ctx=Load())]))]),
            If(
              test=Name(id='send_outreach', ctx=Load()),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='available_endpoints', ctx=Load()),
                      attr='extend',
                      ctx=Load()),
                    args=[
                      List(
                        elts=[
                          Constant(value='/outreach/send - Send outreach message')],
                        ctx=Load())]))]),
            If(
              test=Name(id='preview_message', ctx=Load()),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='available_endpoints', ctx=Load()),
                      attr='extend',
                      ctx=Load()),
                    args=[
                      List(
                        elts=[
                          Constant(value='/outreach/preview - Message preview')],
                        ctx=Load())]))]),
            Return(
              value=Call(
                func=Name(id='create_success_response', ctx=Load()),
                keywords=[
                  keyword(
                    arg='data',
                    value=Dict(
                      keys=[
                        Constant(value='engine'),
                        Constant(value='version'),
                        Constant(value='status'),
                        Constant(value='shared_api_integration'),
                        Constant(value='available_endpoints')],
                      values=[
                        Constant(value='outreach_engine'),
                        Constant(value='1.0.0'),
                        Constant(value='active'),
                        Constant(value='agentic_core.api'),
                        Name(id='available_endpoints', ctx=Load())])),
                  keyword(
                    arg='message',
                    value=Constant(value='Outreach engine API is running'))]))],
          handlers=[
            ExceptHandler(
              type=Name(id='Exception', ctx=Load()),
              body=[
                Raise(
                  exc=Call(
                    func=Name(id='ServiceUnavailableAPIException', ctx=Load()),
                    keywords=[
                      keyword(
                        arg='message',
                        value=Constant(value='Root endpoint unavailable')),
                      keyword(
                        arg='error_code',
                        value=Constant(value='ROOT_ENDPOINT_ERROR'))]))])])],
      decorator_list=[
        Call(
          func=Attribute(
            value=Name(id='router', ctx=Load()),
            attr='get',
            ctx=Load()),
          args=[
            Constant(value='/')]),
        Call(
          func=Name(id='handle_errors', ctx=Load())),
        Call(
          func=Name(id='log_api_calls', ctx=Load()),
          keywords=[
            keyword(
              arg='log_level',
              value=Constant(value='info'))])]),
    Assign(
      targets=[
        Name(id='__all__', ctx=Store())],
      value=List(
        elts=[
          Constant(value='router')],
        ctx=Load()))])