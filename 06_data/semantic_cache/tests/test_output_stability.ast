Module(
  body=[
    ImportFrom(
      module='l3.lic_orchestrator',
      names=[
        alias(name='LICOrchestrator')],
      level=0),
    ImportFrom(
      module='agentic_workflow.LIC_capabilities.lic_atomic_spec',
      names=[
        alias(name='ATOMIC_LIC_SPEC')],
      level=0),
    FunctionDef(
      name='test_phase_c',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='orchestrator', ctx=Store())],
          value=Call(
            func=Name(id='LICOrchestrator', ctx=Load()),
            args=[
              Name(id='ATOMIC_LIC_SPEC', ctx=Load())])),
        Assign(
          targets=[
            Name(id='mock_context', ctx=Store())],
          value=Dict(
            keys=[
              Constant(value='recipient'),
              Constant(value='type'),
              Constant(value='recipient_type'),
              Constant(value='date_window')],
            values=[
              Dict(
                keys=[
                  Constant(value='first_name'),
                  Constant(value='title'),
                  Constant(value='company')],
                values=[
                  Constant(value='John'),
                  Constant(value='Engineering Manager'),
                  Constant(value='TechCorp')]),
              Constant(value='SHORT_NEW'),
              Constant(value='EXECUTIVE'),
              Constant(value='next week')])),
        Assign(
          targets=[
            Name(id='mock_sender', ctx=Store())],
          value=Dict(
            keys=[
              Constant(value='first_name'),
              Constant(value='last_name'),
              Constant(value='title'),
              Constant(value='linkedin_url')],
            values=[
              Constant(value='Jane'),
              Constant(value='Smith'),
              Constant(value='Senior Software Engineer'),
              Constant(value='https://linkedin.com/in/janesmith')])),
        Assign(
          targets=[
            Name(id='result', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='orchestrator', ctx=Load()),
              attr='execute_full_pipeline',
              ctx=Load()),
            args=[
              Constant(value='SHORT_NEW'),
              Name(id='mock_context', ctx=Load()),
              Name(id='mock_sender', ctx=Load())])),
        Expr(
          value=Call(
            func=Name(id='print', ctx=Load()),
            args=[
              Constant(value='EXECUTION TRACE:')])),
        For(
          target=Name(id='trace', ctx=Store()),
          iter=Attribute(
            value=Name(id='result', ctx=Load()),
            attr='execution_trace',
            ctx=Load()),
          body=[
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='  '),
                      FormattedValue(
                        value=Subscript(
                          value=Name(id='trace', ctx=Load()),
                          slice=Constant(value='node'),
                          ctx=Load()),
                        conversion=-1),
                      Constant(value=': '),
                      FormattedValue(
                        value=Subscript(
                          value=Name(id='trace', ctx=Load()),
                          slice=Constant(value='status'),
                          ctx=Load()),
                        conversion=-1),
                      Constant(value=' - '),
                      FormattedValue(
                        value=Call(
                          func=Attribute(
                            value=Name(id='trace', ctx=Load()),
                            attr='get',
                            ctx=Load()),
                          args=[
                            Constant(value='error'),
                            Constant(value='No error')]),
                        conversion=-1)])]))]),
        Expr(
          value=Call(
            func=Name(id='print', ctx=Load()),
            args=[
              JoinedStr(
                values=[
                  Constant(value='FINAL ERROR: '),
                  FormattedValue(
                    value=Attribute(
                      value=Name(id='result', ctx=Load()),
                      attr='error_message',
                      ctx=Load()),
                    conversion=-1)])])),
        Expr(
          value=Call(
            func=Name(id='print', ctx=Load()),
            args=[
              JoinedStr(
                values=[
                  Constant(value='SUCCESS: '),
                  FormattedValue(
                    value=Attribute(
                      value=Name(id='result', ctx=Load()),
                      attr='success',
                      ctx=Load()),
                    conversion=-1)])])),
        If(
          test=UnaryOp(
            op=Not(),
            operand=Attribute(
              value=Name(id='result', ctx=Load()),
              attr='success',
              ctx=Load())),
          body=[
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  Constant(value='VALIDATION: Pipeline correctly rejected mock data due to insufficient confidence/signal scores')]))],
          orelse=[
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  Constant(value='Pipeline succeeded with mock data')]))])]),
    If(
      test=Compare(
        left=Name(id='__name__', ctx=Load()),
        ops=[
          Eq()],
        comparators=[
          Constant(value='__main__')]),
      body=[
        Expr(
          value=Call(
            func=Name(id='test_phase_c', ctx=Load())))])])