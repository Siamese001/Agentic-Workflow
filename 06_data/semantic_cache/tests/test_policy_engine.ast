              attr='budget',
              ctx=Load()),
            keywords=[
              keyword(
                arg='max_calls',
                value=Constant(value=2))])),
        Assert(
          test=Compare(
            left=Call(
              func=Name(id='len', ctx=Load()),
              args=[
                Attribute(
                  value=Name(id='plan', ctx=Load()),
                  attr='jobs',
                  ctx=Load())]),
            ops=[
              Eq()],
            comparators=[
              Constant(value=2)]))]),
    FunctionDef(
      name='test_execute_uses_cache_when_fresh',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='store', ctx=Store())],
