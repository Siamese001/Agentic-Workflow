                        arg='suffix',
                        value=Constant(value='.py')),
                      keyword(
                        arg='delete',
                        value=Constant(value=False))]),
                  optional_vars=Name(id='f', ctx=Store()))],
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='f', ctx=Load()),
                      attr='write',
                      ctx=Load()),
                    args=[
                      Name(id='security_code', ctx=Load())])),
                Assign(
                  targets=[
                    Name(id='temp_path', ctx=Store())],
                  value=Call(
                    func=Name(id='Path', ctx=Load()),
                    args=[
                      Attribute(
                        value=Name(id='f', ctx=Load()),
                        attr='name',
                        ctx=Load())]))]),
            Try(
              body=[
                Assign(
                  targets=[
                    Name(id='safety_signature', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='SafetyExtractor', ctx=Load()),
                      attr='extract_safety_signature',
                      ctx=Load()),
                    args=[
                      Name(id='temp_path', ctx=Load())])),
                Assert(
