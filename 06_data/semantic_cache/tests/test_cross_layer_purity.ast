        FunctionDef(
          name='test_data_flow_contract',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test that data flows properly between layers without contamination')),
            Assign(
              targets=[
                Name(id='clean_input', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='user_profile'),
                  Constant(value='target')],
                values=[
                  Dict(
                    keys=[
                      Constant(value='name'),
                      Constant(value='skills')],
                    values=[
                      Constant(value='John'),
                      List(
                        elts=[
                          Constant(value='Python')],
                        ctx=Load())]),
                  Constant(value='Software Engineer')])),
            Assign(
              targets=[
                Name(id='processed_data', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='clean_input', ctx=Load()),
                  attr='copy',
                  ctx=Load()))),
            Assign(
              targets=[
                Subscript(
                  value=Name(id='processed_data', ctx=Load()),
                  slice=Constant(value='l1_metadata'),
                  ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='strategy_applied')],
                values=[
                  Constant(value=True)])),
            Assert(
              test=Compare(
                left=Subscript(
                  value=Name(id='processed_data', ctx=Load()),
                  slice=Constant(value='user_profile'),
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Subscript(
                    value=Name(id='clean_input', ctx=Load()),
                    slice=Constant(value='user_profile'),
                    ctx=Load())])),
            Assign(
              targets=[
                Subscript(
                  value=Name(id='processed_data', ctx=Load()),
                  slice=Constant(value='l2_metadata'),
                  ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='execution_completed')],
                values=[
                  Constant(value=True)])),
            Assert(
              test=Compare(
                left=Subscript(
                  value=Name(id='processed_data', ctx=Load()),
                  slice=Constant(value='user_profile'),
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Subscript(
                    value=Name(id='clean_input', ctx=Load()),
                    slice=Constant(value='user_profile'),
                    ctx=Load())])),
            Assert(
              test=Compare(
                left=Subscript(
                  value=Name(id='processed_data', ctx=Load()),
                  slice=Constant(value='l1_metadata'),
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Dict(
                    keys=[
                      Constant(value='strategy_applied')],
                    values=[
                      Constant(value=True)])])),
            Assign(
              targets=[
                Subscript(
                  value=Name(id='processed_data', ctx=Load()),
                  slice=Constant(value='l3_metadata'),
                  ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='dag_executed')],
                values=[
                  Constant(value=True)])),
            Assert(
              test=Compare(
                left=Subscript(
                  value=Name(id='processed_data', ctx=Load()),
                  slice=Constant(value='user_profile'),
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Subscript(
                    value=Name(id='clean_input', ctx=Load()),
                    slice=Constant(value='user_profile'),
                    ctx=Load())])),
            Assert(
              test=Compare(
                left=Subscript(
