                                    withitem(
                                      context_expr=Call(
                                        func=Name(id='open', ctx=Load()),
                                        args=[
                                          Name(id='source_file', ctx=Load()),
                                          Constant(value='r')]),
                                      optional_vars=Name(id='f', ctx=Store()))],
                                  body=[
                                    Assign(
                                      targets=[
                                        Name(id='source_code', ctx=Store())],
                                      value=Call(
                                        func=Attribute(
                                          value=Name(id='f', ctx=Load()),
                                          attr='read',
                                          ctx=Load())))]),
                                For(
                                  target=Name(id='other_layer', ctx=Store()),
                                  iter=Name(id='layers', ctx=Load()),
                                  body=[
                                    If(
                                      test=Compare(
                                        left=Name(id='other_layer', ctx=Load()),
                                        ops=[
                                          NotEq()],
                                        comparators=[
                                          Name(id='layer', ctx=Load())]),
                                      body=[
                                        If(
                                          test=Compare(
                                            left=JoinedStr(
                                              values=[
                                                Constant(value='from agentic_core.'),
                                                FormattedValue(
                                                  value=Name(id='other_layer', ctx=Load()),
                                                  conversion=-1)]),
                                            ops=[
                                              In()],
                                            comparators=[
                                              Name(id='source_code', ctx=Load())]),
                                          body=[
                                            Expr(
                                              value=Call(
                                                func=Attribute(
                                                  value=Name(id='dependencies', ctx=Load()),
                                                  attr='add',
                                                  ctx=Load()),
                                                args=[
                                                  Name(id='other_layer', ctx=Load())]))])])])])],
                          handlers=[
                            ExceptHandler(
                              type=Name(id='ImportError', ctx=Load()),
                              body=[
                                Continue()])])]),
                    Assign(
                      targets=[
                        Subscript(
                          value=Name(id='layer_dependencies', ctx=Load()),
                          slice=Name(id='layer', ctx=Load()),
                          ctx=Store())],
                      value=Name(id='dependencies', ctx=Load()))],
                  handlers=[
                    ExceptHandler(
                      type=Name(id='ImportError', ctx=Load()),
                      body=[
                        Assign(
                          targets=[
                            Subscript(
                              value=Name(id='layer_dependencies', ctx=Load()),
                              slice=Name(id='layer', ctx=Load()),
                              ctx=Store())],
                          value=Call(
                            func=Name(id='set', ctx=Load())))])])]),
            For(
              target=Tuple(
                elts=[
                  Name(id='layer', ctx=Store()),
                  Name(id='deps', ctx=Store())],
                ctx=Store()),
              iter=Call(
                func=Attribute(
                  value=Name(id='layer_dependencies', ctx=Load()),
                  attr='items',
                  ctx=Load())),
              body=[
                For(
                  target=Name(id='dep', ctx=Store()),
                  iter=Name(id='deps', ctx=Load()),
                  body=[
                    If(
                      test=Compare(
                        left=Name(id='layer', ctx=Load()),
                        ops=[
                          In()],
                        comparators=[
                          Call(
                            func=Attribute(
                              value=Name(id='layer_dependencies', ctx=Load()),
                              attr='get',
                              ctx=Load()),
                            args=[
                              Name(id='dep', ctx=Load()),
                              Call(
                                func=Name(id='set', ctx=Load()))])]),
                      body=[
                        Assert(
                          test=Constant(value=False),
                          msg=JoinedStr(
                            values=[
                              Constant(value='Circular dependency detected: '),
                              FormattedValue(
                                value=Name(id='layer', ctx=Load()),
                                conversion=-1),
                              Constant(value=' <-> '),
                              FormattedValue(
                                value=Name(id='dep', ctx=Load()),
                                conversion=-1)]))])])])]),
        FunctionDef(
          name='test_layer_isolation_contract',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
