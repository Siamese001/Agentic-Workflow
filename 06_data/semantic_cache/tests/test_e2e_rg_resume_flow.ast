        FunctionDef(
          name='test_creative_failure_halts_when_dominant',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test that creative failures halt when >= mechanical failures')),
            Assign(
              targets=[
                Name(id='failure_analysis', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='CREATIVE'),
                  Constant(value='MECHANICAL'),
                  Constant(value='SEMANTIC')],
                values=[
                  Constant(value=3),
                  Constant(value=2),
                  Constant(value=1)])),
            Assign(
              targets=[
                Name(id='creative_failures', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='failure_analysis', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='CREATIVE'),
                  Constant(value=0)])),
            Assign(
              targets=[
                Name(id='mechanical_failures', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='failure_analysis', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='MECHANICAL'),
                  Constant(value=0)])),
            Assign(
              targets=[
                Name(id='should_halt', ctx=Store())],
              value=BoolOp(
                op=And(),
                values=[
                  Compare(
                    left=Name(id='creative_failures', ctx=Load()),
                    ops=[
                      Gt()],
                    comparators=[
                      Constant(value=0)]),
                  Compare(
                    left=Name(id='creative_failures', ctx=Load()),
                    ops=[
                      GtE()],
                    comparators=[
                      Name(id='mechanical_failures', ctx=Load())])])),
            Assert(
              test=Name(id='should_halt', ctx=Load()),
              msg=Constant(value='Should halt when creative failures >= mechanical failures')),
            If(
              test=Name(id='should_halt', ctx=Load()),
              body=[
                With(
                  items=[
                    withitem(
                      context_expr=Call(
                        func=Attribute(
                          value=Name(id='pytest', ctx=Load()),
                          attr='raises',
                          ctx=Load()),
                        args=[
                          Name(id='HopExecutionError', ctx=Load())]))],
