                              FormattedValue(
                                value=Name(id='creative_failures', ctx=Load()),
                                conversion=-1),
                              Constant(value=' creative vs. '),
                              FormattedValue(
                                value=Name(id='mechanical_failures', ctx=Load()),
                                conversion=-1),
                              Constant(value=' mechanical). Lowering temperature will not fix this. Halting.')])]))])])])]),
