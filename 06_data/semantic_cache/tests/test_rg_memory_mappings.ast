                left=Constant(value='user_id'),
                ops=[
                  In()],
                comparators=[
                  Subscript(
                    value=Name(id='round_trip_schema', ctx=Load()),
                    slice=Constant(value='properties'),
                    ctx=Load())]))]),
        FunctionDef(
