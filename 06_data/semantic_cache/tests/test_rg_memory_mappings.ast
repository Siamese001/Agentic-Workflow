              value=Constant(value='Test data mapper transforms data according to rules')),
            If(
              test=Compare(
                left=Name(id='DataMapper', ctx=Load()),
                ops=[
                  Is()],
                comparators=[
                  Name(id='Mock', ctx=Load())]),
              body=[
