                    Name(id='target_schema', ctx=Load())]),
                ops=[
                  Is()],
                comparators=[
                  Constant(value=True)])),
            Assign(
              targets=[
                Name(id='incompatible_schema', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='type'),
                  Constant(value='properties')],
                values=[
