                func=Name(id='DataMapper', ctx=Load()),
                args=[
                  Dict()])),
            Assign(
              targets=[
                Name(id='source_data', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='name'),
                  Constant(value='age'),
                  Constant(value='email')],
                values=[
                  Constant(value='John Doe'),
                  Constant(value=30),
                  Constant(value='john@example.com')])),
            Assign(
              targets=[
                Name(id='mapping_rules', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='full_name'),
                  Constant(value='years_old'),
                  Constant(value='contact_email')],
                values=[
                  Constant(value='name'),
                  Constant(value='age'),
                  Constant(value='email')])),
            Assign(
              targets=[
                Name(id='transformed', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='mapper', ctx=Load()),
                  attr='map_data',
                  ctx=Load()),
                args=[
                  Name(id='source_data', ctx=Load()),
                  Name(id='mapping_rules', ctx=Load())])),
            Assert(
              test=Compare(
                left=Subscript(
                  value=Name(id='transformed', ctx=Load()),
                  slice=Constant(value='full_name'),
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value='John Doe')])),
            Assert(
              test=Compare(
                left=Subscript(
                  value=Name(id='transformed', ctx=Load()),
                  slice=Constant(value='years_old'),
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value=30)])),
            Assert(
              test=Compare(
                left=Subscript(
                  value=Name(id='transformed', ctx=Load()),
                  slice=Constant(value='contact_email'),
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value='john@example.com')]))]),
