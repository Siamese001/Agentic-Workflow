                      attr='configure',
                      ctx=Load()),
                    keywords=[
                      keyword(
                        arg='enabled',
                        value=Constant(value=True)),
                      keyword(
                        arg='detail_level',
                        value=Name(id='detail_level', ctx=Load()))])),
                Assign(
                  targets=[
                    Name(id='config', ctx=Store())],
                  value=Dict(
                    keys=[
                      Constant(value='use_concurrent_research'),
                      Constant(value='use_multi_draft'),
                      Constant(value='telemetry_detail_level')],
