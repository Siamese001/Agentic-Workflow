                        args=[
                          Name(id='mock_orchestrator', ctx=Load()),
                          Constant(value='_execute_workflow_phases_concurrent_async')]),
                      optional_vars=Name(id='mock_concurrent', ctx=Store()))],
                  body=[
                    Assign(
                      targets=[
                        Attribute(
                          value=Name(id='mock_concurrent', ctx=Load()),
                          attr='return_value',
                          ctx=Store())],
                      value=Call(
                        func=Name(id='OutreachPipelineResult', ctx=Load()),
                        keywords=[
                          keyword(
                            arg='success',
                            value=Constant(value=True)),
