                                    Constant(value='memory')],
                                  values=[
                                    Constant(value=0.8),
                                    Constant(value=0.6)]),
                                Constant(value='detailed debug data')]))])),
                    Assign(
                      targets=[
                        Name(id='_', ctx=Store())],
                      value=Call(
                        func=Attribute(
                          value=Name(id='asyncio', ctx=Load()),
                          attr='run',
                          ctx=Load()),
                        args=[
                          Call(
                            func=Attribute(
                              value=Name(id='mock_orchestrator', ctx=Load()),
                              attr='orchestrate_outreach_concurrent',
                              ctx=Load()),
                            args=[
                              Name(id='sample_mission', ctx=Load()),
                              Name(id='sample_recipient', ctx=Load()),
                              Name(id='config', ctx=Load())])])),
                    Assign(
                      targets=[
                        Name(id='events', ctx=Store())],
                      value=Call(
                        func=Attribute(
                          value=Attribute(
                            value=Name(id='self', ctx=Load()),
                            attr='bus',
                            ctx=Load()),
                          attr='get_events',
                          ctx=Load()))),
                    Assign(
                      targets=[
                        Subscript(
                          value=Name(id='results', ctx=Load()),
                          slice=Name(id='detail_level', ctx=Load()),
                          ctx=Store())],
                      value=Name(id='events', ctx=Load()))])]),
            Assign(
              targets=[
