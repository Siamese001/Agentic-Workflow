                  Constant(value='verbose'),
                  Constant(value='standard'),
                  Constant(value='minimal')],
                ctx=Load())),
            Assign(
              targets=[
                Name(id='results', ctx=Store())],
              value=Dict()),
            For(
              target=Name(id='detail_level', ctx=Store()),
              iter=Name(id='detail_levels', ctx=Load()),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='bus',
                        ctx=Load()),
                      attr='clear',
