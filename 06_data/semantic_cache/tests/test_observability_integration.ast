                            Constant(value='concurrent_id')],
                          values=[
                            Constant(value='test_concurrent_123')]))])),
                Assign(
                  targets=[
                    Name(id='_', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='asyncio', ctx=Load()),
                      attr='run',
                      ctx=Load()),
                    args=[
                      Call(
                        func=Attribute(
                          value=Name(id='mock_orchestrator', ctx=Load()),
