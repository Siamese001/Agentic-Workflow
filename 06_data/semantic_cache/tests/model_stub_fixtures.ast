                  value=Name(id='self', ctx=Load()),
                  attr='mock_recipient',
                  ctx=Store())],
              value=Call(
                func=Name(id='Mock', ctx=Load())))]),
        FunctionDef(
          name='test_safety_always_uses_heavy_models_regardless_of_budget',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
