Module(
  body=[
    Expr(
      value=Constant(value='\nIntegration tests for RAG Pipeline\nTests RAG retrieval, augmentation, and generation behaviors\n')),
    Import(
      names=[
        alias(name='pytest')]),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Dict'),
        alias(name='Any'),
        alias(name='List')],
      level=0),
    ImportFrom(
      module='unittest.mock',
      names=[
        alias(name='Mock')],
      level=0),
    Try(
      body=[
        ImportFrom(
          module='agentic_core.l4_memory.providers.rag_provider',
          names=[
            alias(name='RAGProvider')],
          level=0),
        ImportFrom(
          module='agentic_core.l4_memory.providers.provider_registry',
          names=[
            alias(name='ProviderRegistry')],
          level=0),
        ImportFrom(
          module='agentic_core.l2_execution.executors.company_research_executor',
          names=[
            alias(name='CompanyResearchExecutor')],
          level=0)],
      handlers=[
        ExceptHandler(
          type=Name(id='ImportError', ctx=Load()),
          body=[
            Assign(
              targets=[
                Name(id='RAGProvider', ctx=Store()),
                Name(id='ProviderRegistry', ctx=Store()),
                Name(id='CompanyResearchExecutor', ctx=Store())],
              value=Name(id='Mock', ctx=Load()))])]),
    ClassDef(
      name='TestRAGPipelineIntegration',
      body=[
        Expr(
          value=Constant(value='Test RAG pipeline integration contracts')),
        FunctionDef(
          name='test_rag_hybrid_retrieval_configured_contract',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test RAG pipeline has hybrid retrieval configured')),
            If(
              test=Compare(
                left=Name(id='RAGProvider', ctx=Load()),
                ops=[
                  Is()],
                comparators=[
                  Name(id='Mock', ctx=Load())]),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='pytest', ctx=Load()),
                      attr='skip',
                      ctx=Load()),
                    args=[
                      Constant(value='RAGProvider not implemented')]))]),
            Assign(
              targets=[
                Name(id='config', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='retrieval_mode'),
                  Constant(value='dense_retriever'),
                  Constant(value='sparse_retriever')],
                values=[
                  Constant(value='hybrid'),
                  Dict(
                    keys=[
                      Constant(value='model')],
                    values=[
                      Constant(value='sentence-transformer')]),
                  Dict(
                    keys=[
                      Constant(value='analyzer')],
                    values=[
                      Constant(value='standard')])])),
            Assign(
              targets=[
                Name(id='rag_provider', ctx=Store())],
              value=Call(
                func=Name(id='RAGProvider', ctx=Load()),
                args=[
                  Name(id='config', ctx=Load())])),
            Assign(
              targets=[
                Name(id='retrieval_config', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='rag_provider', ctx=Load()),
                  attr='get_retrieval_config',
                  ctx=Load()))),
            Assert(
              test=Compare(
                left=Subscript(
                  value=Name(id='retrieval_config', ctx=Load()),
                  slice=Constant(value='mode'),
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value='hybrid')])),
            Assert(
              test=Compare(
                left=Constant(value='dense_retriever'),
                ops=[
                  In()],
                comparators=[
                  Name(id='retrieval_config', ctx=Load())])),
            Assert(
              test=Compare(
                left=Constant(value='sparse_retriever'),
                ops=[
                  In()],
                comparators=[
                  Name(id='retrieval_config', ctx=Load())])),
            Assert(
              test=Compare(
                left=Subscript(
                  value=Subscript(
                    value=Name(id='retrieval_config', ctx=Load()),
                    slice=Constant(value='dense_retriever'),
                    ctx=Load()),
                  slice=Constant(value='model'),
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value='sentence-transformer')])),
            Assert(
              test=Compare(
                left=Subscript(
                  value=Subscript(
                    value=Name(id='retrieval_config', ctx=Load()),
                    slice=Constant(value='sparse_retriever'),
                    ctx=Load()),
                  slice=Constant(value='analyzer'),
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value='standard')]))]),
        FunctionDef(
          name='test_rag_dense_and_sparse_retrievers_valid_contract',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test RAG dense and sparse retrievers are valid')),
            If(
              test=Compare(
                left=Name(id='RAGProvider', ctx=Load()),
                ops=[
                  Is()],
                comparators=[
                  Name(id='Mock', ctx=Load())]),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='pytest', ctx=Load()),
                      attr='skip',
                      ctx=Load()),
                    args=[
                      Constant(value='RAGProvider not implemented')]))]),
            Assign(
              targets=[
                Name(id='rag_provider', ctx=Store())],
              value=Call(
                func=Name(id='RAGProvider', ctx=Load()),
                args=[
                  Dict(
                    keys=[
                      Constant(value='retrieval_mode')],
                    values=[
                      Constant(value='hybrid')])])),
            Assign(
              targets=[
                Name(id='dense_query', ctx=Store())],
              value=Constant(value='machine learning engineer with Python experience')),
            Assign(
              targets=[
                Name(id='dense_results', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='rag_provider', ctx=Load()),
                  attr='query_dense_retriever',
                  ctx=Load()),
                args=[
                  Name(id='dense_query', ctx=Load())])),
            Assert(
              test=Call(
                func=Name(id='isinstance', ctx=Load()),
                args=[
                  Name(id='dense_results', ctx=Load()),
                  Name(id='list', ctx=Load())])),
            For(
              target=Name(id='result', ctx=Store()),
              iter=Name(id='dense_results', ctx=Load()),
              body=[
                Assert(
                  test=Compare(
                    left=Constant(value='doc_id'),
                    ops=[
                      In()],
                    comparators=[
                      Name(id='result', ctx=Load())])),
                Assert(
                  test=Compare(
                    left=Constant(value='score'),
                    ops=[
                      In()],
                    comparators=[
                      Name(id='result', ctx=Load())])),
                Assert(
                  test=Compare(
                    left=Constant(value='content'),
                    ops=[
                      In()],
                    comparators=[
                      Name(id='result', ctx=Load())])),
                Assert(
                  test=Call(
                    func=Name(id='isinstance', ctx=Load()),
                    args=[
                      Subscript(
                        value=Name(id='result', ctx=Load()),
                        slice=Constant(value='score'),
                        ctx=Load()),
                      Tuple(
                        elts=[
                          Name(id='int', ctx=Load()),
                          Name(id='float', ctx=Load())],
                        ctx=Load())])),
                Assert(
                  test=Compare(
                    left=Constant(value=0),
                    ops=[
                      LtE(),
                      LtE()],
                    comparators=[
                      Subscript(
                        value=Name(id='result', ctx=Load()),
                        slice=Constant(value='score'),
                        ctx=Load()),
                      Constant(value=1)]))]),
            Assign(
              targets=[
                Name(id='sparse_results', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='rag_provider', ctx=Load()),
                  attr='query_sparse_retriever',
                  ctx=Load()),
                args=[
                  Name(id='dense_query', ctx=Load())])),
            Assert(
              test=Call(
                func=Name(id='isinstance', ctx=Load()),
                args=[
                  Name(id='sparse_results', ctx=Load()),
                  Name(id='list', ctx=Load())])),
            For(
              target=Name(id='result', ctx=Store()),
              iter=Name(id='sparse_results', ctx=Load()),
              body=[
                Assert(
                  test=Compare(
                    left=Constant(value='doc_id'),
                    ops=[
                      In()],
                    comparators=[
                      Name(id='result', ctx=Load())])),
                Assert(
                  test=Compare(
                    left=Constant(value='score'),
                    ops=[
                      In()],
                    comparators=[
                      Name(id='result', ctx=Load())])),
                Assert(
                  test=Compare(
                    left=Constant(value='content'),
                    ops=[
                      In()],
                    comparators=[
                      Name(id='result', ctx=Load())])),
                Assert(
                  test=Call(
                    func=Name(id='isinstance', ctx=Load()),
                    args=[
                      Subscript(
                        value=Name(id='result', ctx=Load()),
                        slice=Constant(value='score'),
                        ctx=Load()),
                      Tuple(
                        elts=[
                          Name(id='int', ctx=Load()),
                          Name(id='float', ctx=Load())],
                        ctx=Load())]))])]),
        FunctionDef(
          name='test_rag_rrf_reranker_deterministic_contract',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test RAG RRF reranker is deterministic')),
            If(
              test=Compare(
                left=Name(id='RAGProvider', ctx=Load()),
                ops=[
                  Is()],
                comparators=[
                  Name(id='Mock', ctx=Load())]),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='pytest', ctx=Load()),
                      attr='skip',
                      ctx=Load()),
                    args=[
                      Constant(value='RAGProvider not implemented')]))]),
            Assign(
              targets=[
                Name(id='rag_provider', ctx=Store())],
              value=Call(
                func=Name(id='RAGProvider', ctx=Load()),
                args=[
                  Dict(
                    keys=[
                      Constant(value='reranker')],
                    values=[
                      Constant(value='rrf')])])),
            Assign(
              targets=[
                Name(id='mock_results', ctx=Store())],
              value=List(
                elts=[
                  Dict(
                    keys=[
                      Constant(value='doc_id'),
                      Constant(value='content'),
                      Constant(value='dense_score'),
                      Constant(value='sparse_score'),
                      Constant(value='source')],
                    values=[
                      Constant(value='doc1'),
                      Constant(value='Senior ML Engineer position requiring Python expertise'),
                      Constant(value=0.9),
                      Constant(value=0.7),
                      Constant(value='hybrid')]),
                  Dict(
                    keys=[
                      Constant(value='doc_id'),
                      Constant(value='content'),
                      Constant(value='dense_score'),
                      Constant(value='sparse_score'),
                      Constant(value='source')],
                    values=[
                      Constant(value='doc2'),
                      Constant(value='Data Scientist role with machine learning focus'),
                      Constant(value=0.8),
                      Constant(value=0.9),
                      Constant(value='hybrid')]),
                  Dict(
                    keys=[
                      Constant(value='doc_id'),
                      Constant(value='content'),
                      Constant(value='dense_score'),
                      Constant(value='sparse_score'),
                      Constant(value='source')],
                    values=[
                      Constant(value='doc3'),
                      Constant(value='Software Engineer with AI/ML background'),
                      Constant(value=0.6),
                      Constant(value=0.8),
                      Constant(value='hybrid')])],
                ctx=Load())),
            Assign(
              targets=[
                Name(id='reranked1', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='rag_provider', ctx=Load()),
                  attr='rerank_results',
                  ctx=Load()),
                args=[
                  Name(id='mock_results', ctx=Load())])),
            Assign(
              targets=[
                Name(id='reranked2', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='rag_provider', ctx=Load()),
                  attr='rerank_results',
                  ctx=Load()),
                args=[
                  Name(id='mock_results', ctx=Load())])),
            Assert(
              test=Compare(
                left=Name(id='reranked1', ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Name(id='reranked2', ctx=Load())])),
            For(
              target=Name(id='i', ctx=Store()),
              iter=Call(
                func=Name(id='range', ctx=Load()),
                args=[
                  Constant(value=1),
                  Call(
                    func=Name(id='len', ctx=Load()),
                    args=[
                      Name(id='reranked1', ctx=Load())])]),
              body=[
                Assert(
                  test=Compare(
                    left=Subscript(
                      value=Subscript(
                        value=Name(id='reranked1', ctx=Load()),
                        slice=BinOp(
                          left=Name(id='i', ctx=Load()),
                          op=Sub(),
                          right=Constant(value=1)),
                        ctx=Load()),
                      slice=Constant(value='rrf_score'),
                      ctx=Load()),
                    ops=[
                      GtE()],
                    comparators=[
                      Subscript(
                        value=Subscript(
                          value=Name(id='reranked1', ctx=Load()),
                          slice=Name(id='i', ctx=Load()),
                          ctx=Load()),
                        slice=Constant(value='rrf_score'),
                        ctx=Load())]))]),
            For(
              target=Name(id='result', ctx=Store()),
              iter=Name(id='reranked1', ctx=Load()),
              body=[
                Assert(
                  test=Compare(
                    left=Constant(value='rrf_score'),
                    ops=[
                      In()],
                    comparators=[
                      Name(id='result', ctx=Load())])),
                Assert(
                  test=Compare(
                    left=Subscript(
                      value=Name(id='result', ctx=Load()),
                      slice=Constant(value='rrf_score'),
                      ctx=Load()),
                    ops=[
                      NotEq()],
                    comparators=[
                      Subscript(
                        value=Name(id='result', ctx=Load()),
                        slice=Constant(value='dense_score'),
                        ctx=Load())])),
                Assert(
                  test=Compare(
                    left=Subscript(
                      value=Name(id='result', ctx=Load()),
                      slice=Constant(value='rrf_score'),
                      ctx=Load()),
                    ops=[
                      NotEq()],
                    comparators=[
                      Subscript(
                        value=Name(id='result', ctx=Load()),
                        slice=Constant(value='sparse_score'),
                        ctx=Load())]))])]),
        FunctionDef(
          name='test_rag_golden_queries_present_contract',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test RAG pipeline has golden queries for validation')),
            If(
              test=Compare(
                left=Name(id='RAGProvider', ctx=Load()),
                ops=[
                  Is()],
                comparators=[
                  Name(id='Mock', ctx=Load())]),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='pytest', ctx=Load()),
                      attr='skip',
                      ctx=Load()),
                    args=[
                      Constant(value='RAGProvider not implemented')]))]),
            Assign(
              targets=[
                Name(id='rag_provider', ctx=Store())],
              value=Call(
                func=Name(id='RAGProvider', ctx=Load()),
                args=[
                  Dict()])),
            Assign(
              targets=[
                Name(id='golden_queries', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='rag_provider', ctx=Load()),
                  attr='get_golden_queries',
                  ctx=Load()))),
            Assert(
              test=Call(
                func=Name(id='isinstance', ctx=Load()),
                args=[
                  Name(id='golden_queries', ctx=Load()),
                  Name(id='list', ctx=Load())])),
            Assert(
              test=Compare(
                left=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Name(id='golden_queries', ctx=Load())]),
                ops=[
                  Gt()],
                comparators=[
                  Constant(value=0)])),
            For(
              target=Name(id='query', ctx=Store()),
              iter=Name(id='golden_queries', ctx=Load()),
              body=[
                Assert(
                  test=Compare(
                    left=Constant(value='query'),
                    ops=[
                      In()],
                    comparators=[
                      Name(id='query', ctx=Load())])),
                Assert(
                  test=Compare(
                    left=Constant(value='expected_results'),
                    ops=[
                      In()],
                    comparators=[
                      Name(id='query', ctx=Load())])),
                Assert(
                  test=Compare(
                    left=Constant(value='expected_min_score'),
                    ops=[
                      In()],
                    comparators=[
                      Name(id='query', ctx=Load())])),
                Assert(
                  test=Call(
                    func=Name(id='isinstance', ctx=Load()),
                    args=[
                      Subscript(
                        value=Name(id='query', ctx=Load()),
                        slice=Constant(value='expected_results'),
                        ctx=Load()),
                      Name(id='list', ctx=Load())])),
                Assert(
                  test=Call(
                    func=Name(id='isinstance', ctx=Load()),
                    args=[
                      Subscript(
                        value=Name(id='query', ctx=Load()),
                        slice=Constant(value='expected_min_score'),
                        ctx=Load()),
                      Tuple(
                        elts=[
                          Name(id='int', ctx=Load()),
                          Name(id='float', ctx=Load())],
                        ctx=Load())]))])]),
        FunctionDef(
          name='test_rag_golden_queries_pass_contract',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test RAG golden queries pass validation')),
            If(
              test=Compare(
                left=Name(id='RAGProvider', ctx=Load()),
                ops=[
                  Is()],
                comparators=[
                  Name(id='Mock', ctx=Load())]),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='pytest', ctx=Load()),
                      attr='skip',
                      ctx=Load()),
                    args=[
                      Constant(value='RAGProvider not implemented')]))]),
            Assign(
              targets=[
                Name(id='rag_provider', ctx=Store())],
              value=Call(
                func=Name(id='RAGProvider', ctx=Load()),
                args=[
                  Dict()])),
            Assign(
              targets=[
                Name(id='golden_queries', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='rag_provider', ctx=Load()),
                  attr='get_golden_queries',
                  ctx=Load()))),
            For(
              target=Name(id='golden_query', ctx=Store()),
              iter=Subscript(
                value=Name(id='golden_queries', ctx=Load()),
                slice=Slice(
                  upper=Constant(value=3)),
                ctx=Load()),
              body=[
                Assign(
                  targets=[
                    Name(id='query_text', ctx=Store())],
                  value=Subscript(
                    value=Name(id='golden_query', ctx=Load()),
                    slice=Constant(value='query'),
                    ctx=Load())),
                Assign(
                  targets=[
                    Name(id='expected_results', ctx=Store())],
                  value=Subscript(
                    value=Name(id='golden_query', ctx=Load()),
                    slice=Constant(value='expected_results'),
                    ctx=Load())),
                Assign(
                  targets=[
                    Name(id='min_score', ctx=Store())],
                  value=Subscript(
                    value=Name(id='golden_query', ctx=Load()),
                    slice=Constant(value='expected_min_score'),
                    ctx=Load())),
                Assign(
                  targets=[
                    Name(id='results', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='rag_provider', ctx=Load()),
                      attr='query',
                      ctx=Load()),
                    args=[
                      Dict(
                        keys=[
                          Constant(value='query'),
                          Constant(value='max_results'),
                          Constant(value='include_sources')],
                        values=[
                          Name(id='query_text', ctx=Load()),
                          Constant(value=10),
                          Constant(value=True)])])),
                Assert(
                  test=Compare(
                    left=Constant(value='results'),
                    ops=[
                      In()],
                    comparators=[
                      Name(id='results', ctx=Load())])),
                Assert(
                  test=Compare(
                    left=Call(
                      func=Name(id='len', ctx=Load()),
                      args=[
                        Subscript(
                          value=Name(id='results', ctx=Load()),
                          slice=Constant(value='results'),
                          ctx=Load())]),
                    ops=[
                      GtE()],
                    comparators=[
                      Call(
                        func=Name(id='len', ctx=Load()),
                        args=[
                          Name(id='expected_results', ctx=Load())])])),
                If(
                  test=Subscript(
                    value=Name(id='results', ctx=Load()),
                    slice=Constant(value='results'),
                    ctx=Load()),
                  body=[
                    Assign(
                      targets=[
                        Name(id='top_score', ctx=Store())],
                      value=Call(
                        func=Attribute(
                          value=Subscript(
                            value=Subscript(
                              value=Name(id='results', ctx=Load()),
                              slice=Constant(value='results'),
                              ctx=Load()),
                            slice=Constant(value=0),
                            ctx=Load()),
                          attr='get',
                          ctx=Load()),
                        args=[
                          Constant(value='score'),
                          Constant(value=0)])),
                    Assert(
                      test=Compare(
                        left=Name(id='top_score', ctx=Load()),
                        ops=[
                          GtE()],
                        comparators=[
                          Name(id='min_score', ctx=Load())]))])])]),
        FunctionDef(
          name='test_rag_source_attribution_required_contract',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test RAG pipeline provides source attribution')),
            If(
              test=Compare(
                left=Name(id='RAGProvider', ctx=Load()),
                ops=[
                  Is()],
                comparators=[
                  Name(id='Mock', ctx=Load())]),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='pytest', ctx=Load()),
                      attr='skip',
                      ctx=Load()),
                    args=[
                      Constant(value='RAGProvider not implemented')]))]),
            Assign(
              targets=[
                Name(id='rag_provider', ctx=Store())],
              value=Call(
                func=Name(id='RAGProvider', ctx=Load()),
                args=[
                  Dict()])),
            Assign(
              targets=[
                Name(id='query_data', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='query'),
                  Constant(value='max_results'),
                  Constant(value='include_sources')],
                values=[
                  Constant(value='software engineer requirements at tech companies'),
                  Constant(value=5),
                  Constant(value=True)])),
            Assign(
              targets=[
                Name(id='result', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='rag_provider', ctx=Load()),
                  attr='query',
                  ctx=Load()),
                args=[
                  Name(id='query_data', ctx=Load())])),
            Assert(
              test=Compare(
                left=Constant(value='results'),
                ops=[
                  In()],
                comparators=[
                  Name(id='result', ctx=Load())])),
            For(
              target=Name(id='doc', ctx=Store()),
              iter=Subscript(
                value=Name(id='result', ctx=Load()),
                slice=Constant(value='results'),
                ctx=Load()),
              body=[
                Assert(
                  test=BoolOp(
                    op=Or(),
                    values=[
                      Compare(
                        left=Constant(value='source'),
                        ops=[
                          In()],
                        comparators=[
                          Name(id='doc', ctx=Load())]),
                      Compare(
                        left=Constant(value='doc_id'),
                        ops=[
                          In()],
                        comparators=[
                          Name(id='doc', ctx=Load())])])),
                Assert(
                  test=Compare(
                    left=Constant(value='content'),
                    ops=[
                      In()],
                    comparators=[
                      Name(id='doc', ctx=Load())])),
                Assert(
                  test=Compare(
                    left=Constant(value='score'),
                    ops=[
                      In()],
                    comparators=[
                      Name(id='doc', ctx=Load())])),
                If(
                  test=Compare(
                    left=Constant(value='source'),
                    ops=[
                      In()],
                    comparators=[
                      Name(id='doc', ctx=Load())]),
                  body=[
                    Assert(
                      test=Call(
                        func=Name(id='isinstance', ctx=Load()),
                        args=[
                          Subscript(
                            value=Name(id='doc', ctx=Load()),
                            slice=Constant(value='source'),
                            ctx=Load()),
                          Name(id='dict', ctx=Load())])),
                    Assert(
                      test=BoolOp(
                        op=Or(),
                        values=[
                          Compare(
                            left=Constant(value='title'),
                            ops=[
                              In()],
                            comparators=[
                              Subscript(
                                value=Name(id='doc', ctx=Load()),
                                slice=Constant(value='source'),
                                ctx=Load())]),
                          Compare(
                            left=Constant(value='url'),
                            ops=[
                              In()],
                            comparators=[
                              Subscript(
                                value=Name(id='doc', ctx=Load()),
                                slice=Constant(value='source'),
                                ctx=Load())])]))])])]),
        FunctionDef(
          name='test_rag_retrieval_latency_within_bounds_contract',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test RAG retrieval meets latency requirements')),
            If(
              test=Compare(
                left=Name(id='RAGProvider', ctx=Load()),
                ops=[
                  Is()],
                comparators=[
                  Name(id='Mock', ctx=Load())]),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='pytest', ctx=Load()),
                      attr='skip',
