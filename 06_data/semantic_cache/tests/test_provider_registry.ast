Module(
  body=[
    Expr(
      value=Constant(value='\nContract-level tests for Provider Registry (L4)\nTests memory provider management and RAG behaviors\n')),
    Import(
      names=[
        alias(name='pytest')]),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Dict'),
        alias(name='Any'),
        alias(name='List')],
      level=0),
    ImportFrom(
      module='unittest.mock',
      names=[
        alias(name='Mock')],
      level=0),
    Try(
      body=[
        ImportFrom(
          module='agentic_core.l4_memory.providers.provider_registry',
          names=[
            alias(name='ProviderRegistry')],
          level=0),
        ImportFrom(
          module='agentic_core.l4_memory.providers.rag_provider',
          names=[
            alias(name='RAGProvider')],
          level=0),
        ImportFrom(
          module='agentic_core.l4_memory.providers.kg_provider',
          names=[
            alias(name='KGProvider')],
          level=0)],
      handlers=[
        ExceptHandler(
          type=Name(id='ImportError', ctx=Load()),
          body=[
            Assign(
              targets=[
                Name(id='ProviderRegistry', ctx=Store()),
                Name(id='RAGProvider', ctx=Store()),
                Name(id='KGProvider', ctx=Store())],
              value=Name(id='Mock', ctx=Load()))])]),
    ClassDef(
      name='TestProviderRegistryContracts',
      body=[
        Expr(
          value=Constant(value='Test provider registry contracts at L4 boundary')),
        FunctionDef(
          name='test_registry_initialization_contract',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test provider registry initializes with required configuration')),
            If(
              test=Compare(
                left=Name(id='ProviderRegistry', ctx=Load()),
                ops=[
                  Is()],
                comparators=[
                  Name(id='Mock', ctx=Load())]),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='pytest', ctx=Load()),
                      attr='skip',
                      ctx=Load()),
                    args=[
                      Constant(value='ProviderRegistry not implemented')]))]),
            Assign(
              targets=[
                Name(id='config', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='default_timeout'),
                  Constant(value='max_providers')],
                values=[
                  Constant(value=30),
                  Constant(value=10)])),
            Assign(
              targets=[
                Name(id='registry', ctx=Store())],
              value=Call(
                func=Name(id='ProviderRegistry', ctx=Load()),
                args=[
                  Name(id='config', ctx=Load())])),
            Assert(
              test=Call(
                func=Name(id='hasattr', ctx=Load()),
                args=[
                  Name(id='registry', ctx=Load()),
                  Constant(value='register_provider')])),
            Assert(
              test=Call(
                func=Name(id='hasattr', ctx=Load()),
                args=[
                  Name(id='registry', ctx=Load()),
                  Constant(value='get_provider')])),
            Assert(
              test=Call(
                func=Name(id='hasattr', ctx=Load()),
                args=[
                  Name(id='registry', ctx=Load()),
                  Constant(value='list_providers')])),
            Assert(
              test=Call(
                func=Name(id='hasattr', ctx=Load()),
                args=[
                  Name(id='registry', ctx=Load()),
                  Constant(value='unregister_provider')]))]),
        FunctionDef(
          name='test_registry_provider_registration_contract',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test provider registration and retrieval')),
            If(
              test=Compare(
                left=Name(id='ProviderRegistry', ctx=Load()),
                ops=[
                  Is()],
                comparators=[
                  Name(id='Mock', ctx=Load())]),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='pytest', ctx=Load()),
                      attr='skip',
                      ctx=Load()),
                    args=[
                      Constant(value='ProviderRegistry not implemented')]))]),
            Assign(
              targets=[
                Name(id='registry', ctx=Store())],
              value=Call(
                func=Name(id='ProviderRegistry', ctx=Load()),
                args=[
                  Dict()])),
            Assign(
              targets=[
                Name(id='mock_provider', ctx=Store())],
              value=Call(
                func=Name(id='Mock', ctx=Load()))),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='mock_provider', ctx=Load()),
                  attr='name',
                  ctx=Store())],
              value=Constant(value='test_provider')),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='mock_provider', ctx=Load()),
                  attr='provider_type',
                  ctx=Store())],
              value=Constant(value='rag')),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='registry', ctx=Load()),
                  attr='register_provider',
                  ctx=Load()),
                args=[
                  Constant(value='test_provider'),
                  Name(id='mock_provider', ctx=Load())])),
            Assign(
              targets=[
                Name(id='retrieved', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='registry', ctx=Load()),
                  attr='get_provider',
                  ctx=Load()),
                args=[
                  Constant(value='test_provider')])),
            Assert(
              test=Compare(
                left=Name(id='retrieved', ctx=Load()),
                ops=[
                  Is()],
                comparators=[
                  Name(id='mock_provider', ctx=Load())])),
            Assign(
              targets=[
                Name(id='providers', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='registry', ctx=Load()),
                  attr='list_providers',
                  ctx=Load()))),
            Assert(
              test=Compare(
                left=Constant(value='test_provider'),
                ops=[
                  In()],
                comparators=[
                  Name(id='providers', ctx=Load())]))]),
        FunctionDef(
          name='test_registry_provider_validation_contract',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test provider validation during registration')),
            If(
              test=Compare(
                left=Name(id='ProviderRegistry', ctx=Load()),
                ops=[
                  Is()],
                comparators=[
                  Name(id='Mock', ctx=Load())]),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='pytest', ctx=Load()),
                      attr='skip',
                      ctx=Load()),
                    args=[
                      Constant(value='ProviderRegistry not implemented')]))]),
            Assign(
              targets=[
                Name(id='registry', ctx=Store())],
              value=Call(
                func=Name(id='ProviderRegistry', ctx=Load()),
                args=[
                  Dict()])),
            Assign(
              targets=[
                Name(id='invalid_provider', ctx=Store())],
              value=Call(
                func=Name(id='Mock', ctx=Load()))),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='invalid_provider', ctx=Load()),
                  attr='name',
                  ctx=Store())],
              value=Constant(value='invalid')),
            With(
              items=[
                withitem(
                  context_expr=Call(
                    func=Attribute(
                      value=Name(id='pytest', ctx=Load()),
                      attr='raises',
                      ctx=Load()),
                    args=[
                      Tuple(
                        elts=[
                          Name(id='ValueError', ctx=Load()),
                          Name(id='TypeError', ctx=Load())],
                        ctx=Load())]))],
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='registry', ctx=Load()),
                      attr='register_provider',
                      ctx=Load()),
                    args=[
                      Constant(value='invalid'),
                      Name(id='invalid_provider', ctx=Load())]))]),
            Assign(
              targets=[
                Name(id='valid_provider', ctx=Store())],
              value=Call(
                func=Name(id='Mock', ctx=Load()))),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='valid_provider', ctx=Load()),
                  attr='name',
                  ctx=Store())],
              value=Constant(value='valid')),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='valid_provider', ctx=Load()),
                  attr='query',
                  ctx=Store())],
              value=Call(
                func=Name(id='Mock', ctx=Load()))),
            Assign(
              targets=[
                Attribute(
                  value=Name(id='valid_provider', ctx=Load()),
                  attr='validate_input',
                  ctx=Store())],
              value=Call(
                func=Name(id='Mock', ctx=Load()))),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='registry', ctx=Load()),
                  attr='register_provider',
                  ctx=Load()),
                args=[
                  Constant(value='valid'),
                  Name(id='valid_provider', ctx=Load())])),
            Assert(
              test=Compare(
                left=Call(
                  func=Attribute(
                    value=Name(id='registry', ctx=Load()),
                    attr='get_provider',
                    ctx=Load()),
                  args=[
                    Constant(value='valid')]),
                ops=[
                  Is()],
                comparators=[
                  Name(id='valid_provider', ctx=Load())]))]),
        FunctionDef(
          name='test_rag_provider_initialization_contract',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test RAG provider initializes with required configuration')),
            If(
              test=Compare(
                left=Name(id='RAGProvider', ctx=Load()),
                ops=[
                  Is()],
                comparators=[
                  Name(id='Mock', ctx=Load())]),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='pytest', ctx=Load()),
                      attr='skip',
                      ctx=Load()),
                    args=[
                      Constant(value='RAGProvider not implemented')]))]),
            Assign(
              targets=[
                Name(id='config', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='embedding_model'),
                  Constant(value='retrieval_mode'),
                  Constant(value='max_results')],
                values=[
                  Constant(value='default'),
                  Constant(value='hybrid'),
                  Constant(value=10)])),
            Assign(
              targets=[
                Name(id='provider', ctx=Store())],
              value=Call(
                func=Name(id='RAGProvider', ctx=Load()),
                args=[
                  Name(id='config', ctx=Load())])),
            Assert(
              test=Call(
                func=Name(id='hasattr', ctx=Load()),
                args=[
                  Name(id='provider', ctx=Load()),
                  Constant(value='query')])),
            Assert(
              test=Call(
                func=Name(id='hasattr', ctx=Load()),
                args=[
                  Name(id='provider', ctx=Load()),
                  Constant(value='validate_input')])),
            Assert(
              test=Call(
                func=Name(id='hasattr', ctx=Load()),
                args=[
                  Name(id='provider', ctx=Load()),
                  Constant(value='get_retrieval_config')]))]),
        FunctionDef(
          name='test_rag_provider_hybrid_retrieval_contract',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test RAG provider supports hybrid retrieval')),
            If(
              test=Compare(
                left=Name(id='RAGProvider', ctx=Load()),
                ops=[
                  Is()],
                comparators=[
                  Name(id='Mock', ctx=Load())]),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='pytest', ctx=Load()),
                      attr='skip',
                      ctx=Load()),
                    args=[
                      Constant(value='RAGProvider not implemented')]))]),
            Assign(
              targets=[
                Name(id='config', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='retrieval_mode')],
                values=[
                  Constant(value='hybrid')])),
            Assign(
              targets=[
                Name(id='provider', ctx=Store())],
              value=Call(
                func=Name(id='RAGProvider', ctx=Load()),
                args=[
                  Name(id='config', ctx=Load())])),
            Assign(
              targets=[
                Name(id='retrieval_config', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='provider', ctx=Load()),
                  attr='get_retrieval_config',
                  ctx=Load()))),
            Assert(
              test=Compare(
                left=Subscript(
                  value=Name(id='retrieval_config', ctx=Load()),
                  slice=Constant(value='mode'),
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value='hybrid')])),
            Assert(
              test=Compare(
                left=Constant(value='dense_retriever'),
                ops=[
                  In()],
                comparators=[
                  Name(id='retrieval_config', ctx=Load())])),
            Assert(
              test=Compare(
                left=Constant(value='sparse_retriever'),
                ops=[
                  In()],
                comparators=[
                  Name(id='retrieval_config', ctx=Load())]))]),
        FunctionDef(
          name='test_rag_provider_rrf_reranker_contract',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test RAG provider uses deterministic RRF reranking')),
            If(
              test=Compare(
                left=Name(id='RAGProvider', ctx=Load()),
                ops=[
                  Is()],
                comparators=[
                  Name(id='Mock', ctx=Load())]),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='pytest', ctx=Load()),
                      attr='skip',
                      ctx=Load()),
                    args=[
                      Constant(value='RAGProvider not implemented')]))]),
            Assign(
              targets=[
                Name(id='config', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='reranker')],
                values=[
                  Constant(value='rrf')])),
            Assign(
              targets=[
                Name(id='provider', ctx=Store())],
              value=Call(
                func=Name(id='RAGProvider', ctx=Load()),
                args=[
                  Name(id='config', ctx=Load())])),
            Assign(
              targets=[
                Name(id='mock_results', ctx=Store())],
              value=List(
                elts=[
                  Dict(
                    keys=[
                      Constant(value='doc'),
                      Constant(value='score'),
                      Constant(value='source')],
                    values=[
                      Constant(value='doc1'),
                      Constant(value=0.9),
                      Constant(value='dense')]),
                  Dict(
                    keys=[
                      Constant(value='doc'),
                      Constant(value='score'),
                      Constant(value='source')],
                    values=[
                      Constant(value='doc2'),
                      Constant(value=0.8),
                      Constant(value='sparse')]),
                  Dict(
                    keys=[
                      Constant(value='doc'),
                      Constant(value='score'),
                      Constant(value='source')],
                    values=[
                      Constant(value='doc3'),
                      Constant(value=0.7),
                      Constant(value='dense')])],
                ctx=Load())),
            Assign(
              targets=[
                Name(id='reranked', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='provider', ctx=Load()),
                  attr='rerank_results',
                  ctx=Load()),
                args=[
                  Name(id='mock_results', ctx=Load())])),
            Assign(
              targets=[
                Name(id='reranked2', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='provider', ctx=Load()),
                  attr='rerank_results',
                  ctx=Load()),
                args=[
                  Name(id='mock_results', ctx=Load())])),
            Assert(
              test=Compare(
                left=Name(id='reranked', ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Name(id='reranked2', ctx=Load())])),
            For(
              target=Name(id='i', ctx=Store()),
              iter=Call(
                func=Name(id='range', ctx=Load()),
                args=[
                  Constant(value=1),
                  Call(
                    func=Name(id='len', ctx=Load()),
                    args=[
                      Name(id='reranked', ctx=Load())])]),
              body=[
                Assert(
                  test=Compare(
                    left=Subscript(
                      value=Subscript(
                        value=Name(id='reranked', ctx=Load()),
                        slice=BinOp(
                          left=Name(id='i', ctx=Load()),
                          op=Sub(),
                          right=Constant(value=1)),
                        ctx=Load()),
                      slice=Constant(value='reranked_score'),
                      ctx=Load()),
                    ops=[
                      GtE()],
                    comparators=[
                      Subscript(
                        value=Subscript(
                          value=Name(id='reranked', ctx=Load()),
                          slice=Name(id='i', ctx=Load()),
                          ctx=Load()),
                        slice=Constant(value='reranked_score'),
                        ctx=Load())]))])]),
        FunctionDef(
          name='test_rag_provider_golden_queries_contract',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test RAG provider has golden queries for validation')),
            If(
              test=Compare(
                left=Name(id='RAGProvider', ctx=Load()),
                ops=[
                  Is()],
                comparators=[
                  Name(id='Mock', ctx=Load())]),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='pytest', ctx=Load()),
                      attr='skip',
                      ctx=Load()),
                    args=[
                      Constant(value='RAGProvider not implemented')]))]),
            Assign(
              targets=[
                Name(id='provider', ctx=Store())],
              value=Call(
                func=Name(id='RAGProvider', ctx=Load()),
                args=[
                  Dict()])),
            Assign(
              targets=[
                Name(id='golden_queries', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='provider', ctx=Load()),
                  attr='get_golden_queries',
                  ctx=Load()))),
            Assert(
              test=Call(
                func=Name(id='isinstance', ctx=Load()),
                args=[
                  Name(id='golden_queries', ctx=Load()),
                  Name(id='list', ctx=Load())])),
            Assert(
              test=Compare(
                left=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Name(id='golden_queries', ctx=Load())]),
                ops=[
                  Gt()],
                comparators=[
                  Constant(value=0)])),
            For(
              target=Name(id='query', ctx=Store()),
              iter=Name(id='golden_queries', ctx=Load()),
              body=[
                Assert(
                  test=Compare(
                    left=Constant(value='query'),
                    ops=[
                      In()],
                    comparators=[
                      Name(id='query', ctx=Load())])),
                Assert(
                  test=Compare(
                    left=Constant(value='expected_results'),
                    ops=[
                      In()],
                    comparators=[
                      Name(id='query', ctx=Load())])),
                Assert(
                  test=Call(
                    func=Name(id='isinstance', ctx=Load()),
                    args=[
                      Subscript(
                        value=Name(id='query', ctx=Load()),
                        slice=Constant(value='expected_results'),
                        ctx=Load()),
                      Name(id='list', ctx=Load())]))])]),
        FunctionDef(
          name='test_rag_provider_source_attribution_contract',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test RAG provider provides source attribution')),
            If(
              test=Compare(
                left=Name(id='RAGProvider', ctx=Load()),
                ops=[
                  Is()],
                comparators=[
                  Name(id='Mock', ctx=Load())]),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='pytest', ctx=Load()),
                      attr='skip',
                      ctx=Load()),
                    args=[
                      Constant(value='RAGProvider not implemented')]))]),
            Assign(
              targets=[
                Name(id='provider', ctx=Store())],
              value=Call(
                func=Name(id='RAGProvider', ctx=Load()),
                args=[
                  Dict()])),
            Assign(
              targets=[
                Name(id='query_input', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='query'),
                  Constant(value='max_results'),
                  Constant(value='include_sources')],
                values=[
                  Constant(value='test query'),
                  Constant(value=5),
                  Constant(value=True)])),
            Assign(
              targets=[
                Name(id='result', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='provider', ctx=Load()),
                  attr='query',
                  ctx=Load()),
                args=[
                  Name(id='query_input', ctx=Load())])),
            Assert(
              test=Compare(
                left=Constant(value='results'),
                ops=[
                  In()],
                comparators=[
                  Name(id='result', ctx=Load())])),
            For(
              target=Name(id='doc', ctx=Store()),
              iter=Subscript(
                value=Name(id='result', ctx=Load()),
                slice=Constant(value='results'),
                ctx=Load()),
              body=[
                Assert(
                  test=BoolOp(
                    op=Or(),
                    values=[
                      Compare(
                        left=Constant(value='source'),
                        ops=[
                          In()],
                        comparators=[
                          Name(id='doc', ctx=Load())]),
                      Compare(
                        left=Constant(value='doc_id'),
                        ops=[
                          In()],
                        comparators=[
                          Name(id='doc', ctx=Load())])])),
                Assert(
                  test=Compare(
                    left=Constant(value='content'),
                    ops=[
                      In()],
                    comparators=[
                      Name(id='doc', ctx=Load())]))])]),
        FunctionDef(
          name='test_rag_provider_latency_bounds_contract',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test RAG provider respects latency bounds')),
            If(
              test=Compare(
                left=Name(id='RAGProvider', ctx=Load()),
                ops=[
                  Is()],
                comparators=[
                  Name(id='Mock', ctx=Load())]),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='pytest', ctx=Load()),
                      attr='skip',
                      ctx=Load()),
                    args=[
                      Constant(value='RAGProvider not implemented')]))]),
            Assign(
              targets=[
                Name(id='config', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='max_latency_ms')],
                values=[
                  Constant(value=1000)])),
            Assign(
              targets=[
                Name(id='provider', ctx=Store())],
              value=Call(
                func=Name(id='RAGProvider', ctx=Load()),
                args=[
                  Name(id='config', ctx=Load())])),
            Import(
              names=[
                alias(name='time')]),
            Assign(
              targets=[
                Name(id='start_time', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='time', ctx=Load()),
                  attr='time',
                  ctx=Load()))),
            Assign(
              targets=[
                Name(id='result', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='provider', ctx=Load()),
                  attr='query',
                  ctx=Load()),
                args=[
                  Dict(
                    keys=[
                      Constant(value='query'),
                      Constant(value='max_results')],
                    values=[
                      Constant(value='simple test'),
                      Constant(value=3)])])),
            Assign(
              targets=[
                Name(id='elapsed_ms', ctx=Store())],
              value=BinOp(
                left=BinOp(
                  left=Call(
                    func=Attribute(
                      value=Name(id='time', ctx=Load()),
                      attr='time',
                      ctx=Load())),
                  op=Sub(),
                  right=Name(id='start_time', ctx=Load())),
                op=Mult(),
                right=Constant(value=1000))),
            Assert(
              test=Compare(
                left=Name(id='elapsed_ms', ctx=Load()),
                ops=[
                  Lt()],
                comparators=[
                  BinOp(
                    left=Subscript(
                      value=Name(id='config', ctx=Load()),
                      slice=Constant(value='max_latency_ms'),
                      ctx=Load()),
                    op=Mult(),
                    right=Constant(value=1.5))]))]),
        FunctionDef(
          name='test_kg_provider_initialization_contract',
