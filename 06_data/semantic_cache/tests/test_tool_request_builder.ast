Module(
  body=[
    Expr(
      value=Constant(value='\nL2 â€” Tool Router (v10_9)\n\nMaps an L1 PlanObject and its steps to the correct L2 execution function.\n\nThis replaces the 10_8/10_7 mixed router behavior and provides:\n    â€¢ clean mode-based routing\n    â€¢ no orchestration logic\n    â€¢ no planning logic\n    â€¢ deterministic executor selection\n')),
    ImportFrom(
      module='__future__',
      names=[
        alias(name='annotations')],
      level=0),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Any'),
        alias(name='Dict'),
        alias(name='Callable'),
        alias(name='Awaitable')],
      level=0),
    ImportFrom(
      module='shared.models',
      names=[
        alias(name='PlanObject')],
      level=0),
    ImportFrom(
      module='shared.exceptions',
      names=[
        alias(name='OrchestrationError')],
      level=0),
    ImportFrom(
      module='l2.strategy_execution',
      names=[
        alias(name='execute_strategy')],
      level=0),
    ImportFrom(
      module='l2.rag_execution',
      names=[
        alias(name='execute_rag')],
      level=0),
    ImportFrom(
      module='l2.bullet_execution',
      names=[
        alias(name='execute_bullets')],
      level=0),
    ImportFrom(
      module='l2.drafting_execution',
      names=[
        alias(name='execute_drafting')],
      level=0),
    ImportFrom(
      module='l2.qa_execution',
      names=[
        alias(name='execute_qa')],
      level=0),
    ImportFrom(
      module='l2.safety_execution',
      names=[
        alias(name='execute_safety')],
      level=0),
    AnnAssign(
      target=Name(id='_EXECUTOR_MAP', ctx=Store()),
      annotation=Subscript(
        value=Name(id='Dict', ctx=Load()),
        slice=Tuple(
          elts=[
            Name(id='str', ctx=Load()),
            Subscript(
              value=Name(id='Callable', ctx=Load()),
              slice=Tuple(
                elts=[
                  List(
                    elts=[
                      Name(id='PlanObject', ctx=Load()),
                      Subscript(
                        value=Name(id='Dict', ctx=Load()),
                        slice=Tuple(
                          elts=[
                            Name(id='str', ctx=Load()),
                            Name(id='Any', ctx=Load())],
                          ctx=Load()),
                        ctx=Load())],
                    ctx=Load()),
                  Subscript(
                    value=Name(id='Awaitable', ctx=Load()),
                    slice=Name(id='Any', ctx=Load()),
                    ctx=Load())],
                ctx=Load()),
              ctx=Load())],
          ctx=Load()),
        ctx=Load()),
      value=Dict(
        keys=[
          Constant(value='strategy'),
          Constant(value='rag'),
          Constant(value='bullets'),
          Constant(value='drafting'),
          Constant(value='qa'),
          Constant(value='safety')],
        values=[
          Name(id='execute_strategy', ctx=Load()),
          Name(id='execute_rag', ctx=Load()),
          Name(id='execute_bullets', ctx=Load()),
          Name(id='execute_drafting', ctx=Load()),
          Name(id='execute_qa', ctx=Load()),
          Name(id='execute_safety', ctx=Load())]),
      simple=1),
    FunctionDef(
      name='route_executor',
      args=arguments(
        args=[
          arg(
            arg='plan',
            annotation=Name(id='PlanObject', ctx=Load()))]),
      body=[
        Expr(
          value=Constant(value='\n    Determine the correct L2 executor based solely on plan.mode.\n    ')),
        Assign(
          targets=[
            Name(id='mode', ctx=Store())],
          value=Call(
            func=Attribute(
              value=BoolOp(
                op=Or(),
                values=[
                  Attribute(
                    value=Name(id='plan', ctx=Load()),
                    attr='mode',
                    ctx=Load()),
                  Constant(value='')]),
              attr='lower',
              ctx=Load()))),
        If(
          test=Compare(
            left=Name(id='mode', ctx=Load()),
            ops=[
              NotIn()],
            comparators=[
              Name(id='_EXECUTOR_MAP', ctx=Load())]),
          body=[
            Raise(
              exc=Call(
                func=Name(id='OrchestrationError', ctx=Load()),
                args=[
                  JoinedStr(
                    values=[
                      Constant(value='No L2 executor found for plan mode: '),
                      FormattedValue(
                        value=Name(id='mode', ctx=Load()),
                        conversion=-1)])]))]),
        Return(
          value=Subscript(
            value=Name(id='_EXECUTOR_MAP', ctx=Load()),
            slice=Name(id='mode', ctx=Load()),
            ctx=Load()))],
      returns=Subscript(
        value=Name(id='Callable', ctx=Load()),
        slice=Tuple(
          elts=[
            List(
              elts=[
                Name(id='PlanObject', ctx=Load()),
                Subscript(
                  value=Name(id='Dict', ctx=Load()),
                  slice=Tuple(
                    elts=[
                      Name(id='str', ctx=Load()),
                      Name(id='Any', ctx=Load())],
                    ctx=Load()),
                  ctx=Load())],
              ctx=Load()),
            Subscript(
              value=Name(id='Awaitable', ctx=Load()),
              slice=Name(id='Any', ctx=Load()),
              ctx=Load())],
          ctx=Load()),
        ctx=Load()))])