                    value=Attribute(
                      value=Name(id='agent', ctx=Load()),
                      attr='config',
                      ctx=Load()),
                    attr='model_config',
                    ctx=Load()),
                  attr='strategy_model_simple',
                  ctx=Load()),
                attr='model_name',
                ctx=Load())])),
        Assert(
          test=Compare(
            left=Attribute(
              value=Name(id='client', ctx=Load()),
              attr='model_name',
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Name(id='expected', ctx=Load())]))]),
    FunctionDef(
