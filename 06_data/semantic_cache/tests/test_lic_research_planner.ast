        FunctionDef(
          name='test_plan_is_pure_and_has_no_execution',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(arg='default_planner'),
              arg(arg='sample_outreach_context')]),
          body=[
            Expr(
              value=Constant(value='Test that plan is pure with no external execution calls.')),
            Assign(
              targets=[
                Name(id='plan', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='default_planner', ctx=Load()),
                  attr='plan',
                  ctx=Load()),
                keywords=[
                  keyword(
                    arg='role_title',
                    value=Constant(value='Senior Software Engineer')),
                  keyword(
                    arg='company_name',
                    value=Constant(value='TechCorp')),
                  keyword(
                    arg='outreach_context',
                    value=Name(id='sample_outreach_context', ctx=Load()))])),
            Assert(
              test=Call(
                func=Name(id='isinstance', ctx=Load()),
                args=[
                  Name(id='plan', ctx=Load()),
                  Name(id='LICResearchPlan', ctx=Load())])),
            Assert(
              test=Compare(
                left=Attribute(
                  value=Name(id='plan', ctx=Load()),
                  attr='role_title',
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value='Senior Software Engineer')])),
            Assert(
              test=Compare(
                left=Attribute(
                  value=Name(id='plan', ctx=Load()),
                  attr='company_name',
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value='TechCorp')])),
            Assert(
              test=Compare(
                left=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Attribute(
                      value=Name(id='plan', ctx=Load()),
                      attr='seed_queries',
                      ctx=Load())]),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value=3)])),
            Assert(
              test=Compare(
                left=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Attribute(
                      value=Name(id='plan', ctx=Load()),
                      attr='hops',
                      ctx=Load())]),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value=3)])),
            For(
              target=Name(id='hop', ctx=Store()),
              iter=Attribute(
                value=Name(id='plan', ctx=Load()),
                attr='hops',
                ctx=Load()),
              body=[
                Assert(
                  test=Call(
                    func=Name(id='isinstance', ctx=Load()),
                    args=[
                      Name(id='hop', ctx=Load()),
                      Name(id='LICResearchHop', ctx=Load())])),
                Assert(
                  test=Call(
                    func=Name(id='isinstance', ctx=Load()),
                    args=[
                      Attribute(
                        value=Name(id='hop', ctx=Load()),
                        attr='query_text',
                        ctx=Load()),
