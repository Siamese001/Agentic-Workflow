                    attr='metadata',
                    ctx=Load()),
                  slice=Constant(value='cache_critique_enabled'),
                  ctx=Load()),
                ops=[
                  Is()],
                comparators=[
                  Constant(value=False)]))]),
        FunctionDef(
          name='test_metadata_contains_signal_targets',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(arg='default_planner'),
              arg(arg='sample_outreach_context')]),
          body=[
