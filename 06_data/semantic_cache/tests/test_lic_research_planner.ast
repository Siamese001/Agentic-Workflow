                    comparators=[
                      Attribute(
                        value=Name(id='hop', ctx=Load()),
                        attr='metadata',
                        ctx=Load())])),
                Assert(
                  test=Compare(
                    left=Constant(value='vector_first'),
                    ops=[
                      In()],
                    comparators=[
                      Attribute(
                        value=Name(id='hop', ctx=Load()),
                        attr='metadata',
                        ctx=Load())])),
                Assert(
                  test=Compare(
                    left=Subscript(
                      value=Attribute(
                        value=Name(id='hop', ctx=Load()),
                        attr='metadata',
                        ctx=Load()),
                      slice=Constant(value='expansion_applied'),
                      ctx=Load()),
                    ops=[
                      Is()],
                    comparators=[
                      Constant(value=True)])),
                Assert(
                  test=Compare(
                    left=Subscript(
                      value=Attribute(
                        value=Name(id='hop', ctx=Load()),
                        attr='metadata',
                        ctx=Load()),
                      slice=Constant(value='role_aware'),
                      ctx=Load()),
                    ops=[
                      Is()],
                    comparators=[
                      Constant(value=True)])),
                Assert(
                  test=Compare(
                    left=Subscript(
                      value=Attribute(
                        value=Name(id='hop', ctx=Load()),
                        attr='metadata',
                        ctx=Load()),
                      slice=Constant(value='vector_first'),
                      ctx=Load()),
                    ops=[
                      Is()],
                    comparators=[
                      Constant(value=True)]))])]),
        FunctionDef(
          name='test_different_role_titles_and_companies',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(arg='default_planner'),
              arg(arg='sample_outreach_context')]),
          body=[
            Expr(
              value=Constant(value='Test planner with different role titles and companies.')),
            Assign(
              targets=[
                Name(id='test_cases', ctx=Store())],
              value=List(
                elts=[
                  Tuple(
                    elts=[
                      Constant(value='Product Manager'),
                      Constant(value='StartupCo')],
                    ctx=Load()),
                  Tuple(
                    elts=[
                      Constant(value='Data Scientist'),
                      Constant(value='DataCorp')],
                    ctx=Load()),
                  Tuple(
                    elts=[
                      Constant(value='DevOps Engineer'),
                      Constant(value='CloudTech')],
                    ctx=Load())],
                ctx=Load())),
            For(
              target=Tuple(
                elts=[
                  Name(id='role_title', ctx=Store()),
                  Name(id='company_name', ctx=Store())],
                ctx=Store()),
              iter=Name(id='test_cases', ctx=Load()),
              body=[
                Assign(
                  targets=[
                    Name(id='plan', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='default_planner', ctx=Load()),
                      attr='plan',
                      ctx=Load()),
                    keywords=[
                      keyword(
                        arg='role_title',
                        value=Name(id='role_title', ctx=Load())),
                      keyword(
                        arg='company_name',
                        value=Name(id='company_name', ctx=Load())),
                      keyword(
                        arg='outreach_context',
                        value=Name(id='sample_outreach_context', ctx=Load()))])),
                Assert(
                  test=Compare(
                    left=Attribute(
                      value=Name(id='plan', ctx=Load()),
                      attr='role_title',
                      ctx=Load()),
                    ops=[
                      Eq()],
                    comparators=[
                      Name(id='role_title', ctx=Load())])),
                Assert(
                  test=Compare(
                    left=Attribute(
                      value=Name(id='plan', ctx=Load()),
                      attr='company_name',
                      ctx=Load()),
                    ops=[
                      Eq()],
                    comparators=[
                      Name(id='company_name', ctx=Load())])),
                Assert(
                  test=Compare(
                    left=Call(
                      func=Name(id='len', ctx=Load()),
                      args=[
                        Attribute(
                          value=Name(id='plan', ctx=Load()),
                          attr='hops',
                          ctx=Load())]),
                    ops=[
                      Eq()],
                    comparators=[
                      Constant(value=3)])),
                Assert(
                  test=Compare(
                    left=Name(id='role_title', ctx=Load()),
                    ops=[
                      In()],
                    comparators=[
                      Subscript(
                        value=Attribute(
                          value=Name(id='plan', ctx=Load()),
                          attr='seed_queries',
                          ctx=Load()),
                        slice=Constant(value=0),
                        ctx=Load())])),
                Assert(
                  test=Compare(
                    left=Name(id='company_name', ctx=Load()),
                    ops=[
                      In()],
                    comparators=[
                      Subscript(
                        value=Attribute(
                          value=Name(id='plan', ctx=Load()),
                          attr='seed_queries',
                          ctx=Load()),
                        slice=Constant(value=0),
                        ctx=Load())])),
                Assert(
                  test=Compare(
                    left=Name(id='company_name', ctx=Load()),
                    ops=[
                      In()],
                    comparators=[
                      Subscript(
                        value=Attribute(
                          value=Name(id='plan', ctx=Load()),
                          attr='seed_queries',
                          ctx=Load()),
                        slice=Constant(value=1),
                        ctx=Load())])),
                Assert(
                  test=Compare(
                    left=Name(id='company_name', ctx=Load()),
                    ops=[
                      In()],
                    comparators=[
                      Subscript(
                        value=Attribute(
                          value=Name(id='plan', ctx=Load()),
                          attr='seed_queries',
                          ctx=Load()),
                        slice=Constant(value=2),
                        ctx=Load())]))])])]),
    If(
      test=Compare(
        left=Name(id='__name__', ctx=Load()),
