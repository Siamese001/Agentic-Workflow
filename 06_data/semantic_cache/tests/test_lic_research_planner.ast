        FunctionDef(
          name='test_query_expansion_strategies_deterministic',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(arg='default_planner'),
              arg(arg='sample_outreach_context')]),
          body=[
            Expr(
              value=Constant(value='Test that query expansion is deterministic.')),
            Assign(
              targets=[
                Name(id='plan1', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='default_planner', ctx=Load()),
                  attr='plan',
                  ctx=Load()),
                keywords=[
                  keyword(
                    arg='role_title',
                    value=Constant(value='Senior Software Engineer')),
                  keyword(
                    arg='company_name',
                    value=Constant(value='TechCorp')),
                  keyword(
                    arg='outreach_context',
                    value=Name(id='sample_outreach_context', ctx=Load()))])),
            Assign(
              targets=[
                Name(id='plan2', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='default_planner', ctx=Load()),
                  attr='plan',
                  ctx=Load()),
                keywords=[
                  keyword(
                    arg='role_title',
                    value=Constant(value='Senior Software Engineer')),
                  keyword(
                    arg='company_name',
                    value=Constant(value='TechCorp')),
                  keyword(
                    arg='outreach_context',
                    value=Name(id='sample_outreach_context', ctx=Load()))])),
            Assert(
              test=Compare(
                left=Attribute(
                  value=Name(id='plan1', ctx=Load()),
                  attr='seed_queries',
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Attribute(
                    value=Name(id='plan2', ctx=Load()),
                    attr='seed_queries',
                    ctx=Load())])),
            Assert(
              test=Compare(
                left=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Attribute(
                      value=Name(id='plan1', ctx=Load()),
                      attr='hops',
                      ctx=Load())]),
                ops=[
                  Eq()],
                comparators=[
                  Call(
                    func=Name(id='len', ctx=Load()),
                    args=[
                      Attribute(
                        value=Name(id='plan2', ctx=Load()),
                        attr='hops',
                        ctx=Load())])])),
            For(
              target=Tuple(
                elts=[
                  Name(id='hop1', ctx=Store()),
                  Name(id='hop2', ctx=Store())],
                ctx=Store()),
              iter=Call(
                func=Name(id='zip', ctx=Load()),
                args=[
                  Attribute(
                    value=Name(id='plan1', ctx=Load()),
                    attr='hops',
                    ctx=Load()),
                  Attribute(
                    value=Name(id='plan2', ctx=Load()),
                    attr='hops',
                    ctx=Load())]),
              body=[
                Assert(
                  test=Compare(
                    left=Attribute(
                      value=Name(id='hop1', ctx=Load()),
                      attr='query_text',
                      ctx=Load()),
                    ops=[
                      Eq()],
                    comparators=[
                      Attribute(
                        value=Name(id='hop2', ctx=Load()),
                        attr='query_text',
                        ctx=Load())])),
                Assert(
                  test=Compare(
                    left=Attribute(
                      value=Name(id='hop1', ctx=Load()),
                      attr='expansion_strategy',
                      ctx=Load()),
                    ops=[
                      Eq()],
                    comparators=[
                      Attribute(
                        value=Name(id='hop2', ctx=Load()),
                        attr='expansion_strategy',
                        ctx=Load())])),
                Assert(
                  test=Compare(
                    left=Attribute(
                      value=Name(id='hop1', ctx=Load()),
                      attr='requires_freshness',
                      ctx=Load()),
                    ops=[
                      Eq()],
                    comparators=[
                      Attribute(
                        value=Name(id='hop2', ctx=Load()),
                        attr='requires_freshness',
                        ctx=Load())]))])]),
        FunctionDef(
          name='test_hop_metadata_structure',
          args=arguments(
