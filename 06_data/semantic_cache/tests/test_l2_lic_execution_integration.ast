Module(
  body=[
    ImportFrom(
      module='src.lic_agentic.reasoning.toggles',
      names=[
        alias(name='ReasoningToggles')],
      level=0),
    ImportFrom(
      module='src.lic_agentic.stacks.outreach_stack',
      names=[
        alias(name='OutreachStack'),
        alias(name='StackInputs')],
      level=0),
    ClassDef(
      name='_Inputs',
      body=[
        Assign(
          targets=[
            Name(id='prompt', ctx=Store())],
          value=Constant(value='Hello')),
        Assign(
          targets=[
            Name(id='company_id', ctx=Store())],
          value=Constant(value='ACME')),
        Assign(
          targets=[
            Name(id='contact_id', ctx=Store())],
          value=Constant(value='C1'))]),
    FunctionDef(
      name='test_safe_route_equivalence',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='stack', ctx=Store())],
          value=Call(
            func=Name(id='OutreachStack', ctx=Load()),
            args=[
              Call(
                func=Name(id='ReasoningToggles', ctx=Load()))])),
        Assign(
          targets=[
            Name(id='out', ctx=Store())],
          value=Call(
            func=Attribute(
              value=Name(id='stack', ctx=Load()),
              attr='run',
              ctx=Load()),
            args=[
              Call(
                func=Name(id='StackInputs', ctx=Load()),
                keywords=[
                  keyword(
                    arg='prompt',
                    value=Constant(value='Hello')),
                  keyword(
                    arg='company_id',
                    value=Constant(value='ACME')),
                  keyword(
                    arg='contact_id',
                    value=Constant(value='C1'))])])),
        Assert(
          test=Compare(
            left=Constant(value='draft'),
            ops=[
              In()],
            comparators=[
              Name(id='out', ctx=Load())])),
        Assert(
          test=Attribute(
            value=Subscript(
              value=Name(id='out', ctx=Load()),
              slice=Constant(value='verdict'),
              ctx=Load()),
            attr='passed',
            ctx=Load()))])])