Module(
  body=[
    Import(
      names=[
        alias(name='pytest')]),
    ImportFrom(
      module='routing_policy',
      names=[
        alias(name='RoutingCriteria'),
        alias(name='decide_route')],
      level=0),
    FunctionDef(
      name='test_high_complexity_routes_to_gpt4o',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='decision', ctx=Store())],
          value=Call(
            func=Name(id='decide_route', ctx=Load()),
            args=[
              Call(
                func=Name(id='RoutingCriteria', ctx=Load()),
                keywords=[
                  keyword(
                    arg='task_type',
                    value=Constant(value='analysis')),
                  keyword(
                    arg='complexity',
                    value=Constant(value='high'))])])),
        Assert(
          test=Compare(
            left=Attribute(
              value=Name(id='decision', ctx=Load()),
              attr='model',
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value='gpt-4o')])),
        Assert(
          test=Compare(
            left=Attribute(
              value=Name(id='decision', ctx=Load()),
              attr='endpoint',
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value='default')]))]),
    FunctionDef(
      name='test_strict_risk_routes_to_gpt4o',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='decision', ctx=Store())],
          value=Call(
            func=Name(id='decide_route', ctx=Load()),
            args=[
              Call(
                func=Name(id='RoutingCriteria', ctx=Load()),
                keywords=[
                  keyword(
                    arg='task_type',
                    value=Constant(value='analysis')),
                  keyword(
                    arg='risk_level',
                    value=Constant(value='strict'))])])),
        Assert(
          test=Compare(
            left=Attribute(
              value=Name(id='decision', ctx=Load()),
              attr='model',
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value='gpt-4o')])),
        Assert(
          test=Compare(
            left=Attribute(
              value=Name(id='decision', ctx=Load()),
              attr='endpoint',
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value='default')]))]),
    FunctionDef(
      name='test_low_latency_routes_to_fast_endpoint',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='decision', ctx=Store())],
          value=Call(
            func=Name(id='decide_route', ctx=Load()),
            args=[
              Call(
                func=Name(id='RoutingCriteria', ctx=Load()),
                keywords=[
                  keyword(
                    arg='task_type',
                    value=Constant(value='analysis')),
                  keyword(
                    arg='latency_target_ms',
                    value=Constant(value=500))])])),
        Assert(
          test=Compare(
            left=Attribute(
              value=Name(id='decision', ctx=Load()),
              attr='model',
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value='gpt-4o-mini')])),
        Assert(
          test=Compare(
            left=Attribute(
              value=Name(id='decision', ctx=Load()),
              attr='endpoint',
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value='fast')]))]),
    FunctionDef(
      name='test_default_case_rationale_deterministic',
      args=arguments(),
      body=[
        Assign(
          targets=[
            Name(id='decision', ctx=Store())],
          value=Call(
            func=Name(id='decide_route', ctx=Load()),
            args=[
              Call(
                func=Name(id='RoutingCriteria', ctx=Load()),
                keywords=[
                  keyword(
                    arg='task_type',
                    value=Constant(value='analysis'))])])),
        Assert(
          test=Compare(
            left=Attribute(
              value=Name(id='decision', ctx=Load()),
              attr='rationale',
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value='Default routing for normal tasks.')]))])])