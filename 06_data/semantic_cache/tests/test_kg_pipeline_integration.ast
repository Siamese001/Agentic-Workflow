                func=Attribute(
                  value=Name(id='kg_provider', ctx=Load()),
                  attr='create_entity',
                  ctx=Load()),
                args=[
                  Constant(value='Company'),
                  Name(id='company_data', ctx=Load())])),
            Assert(
              test=Compare(
                left=Subscript(
