                  body=[
                    Assign(
                      targets=[
                        Name(id='result', ctx=Store())],
                      value=Call(
                        func=Attribute(
                          value=Name(id='kg_provider', ctx=Load()),
                          attr='create_relation',
                          ctx=Load()),
                        args=[
                          Subscript(
                            value=Name(id='invalid_rel', ctx=Load()),
                            slice=Constant(value='subject'),
                            ctx=Load()),
                          Subscript(
                            value=Name(id='invalid_rel', ctx=Load()),
                            slice=Constant(value='predicate'),
                            ctx=Load()),
                          Subscript(
                            value=Name(id='invalid_rel', ctx=Load()),
                            slice=Constant(value='object'),
                            ctx=Load())])),
                    Assert(
                      test=BoolOp(
                        op=Or(),
                        values=[
                          Compare(
                            left=Constant(value='error'),
                            ops=[
                              In()],
                            comparators=[
                              Name(id='result', ctx=Load())]),
                          Compare(
                            left=Name(id='result', ctx=Load()),
                            ops=[
                              Is()],
                            comparators=[
                              Constant(value=None)])]))],
                  handlers=[
                    ExceptHandler(
                      type=Tuple(
                        elts=[
                          Name(id='ValueError', ctx=Load()),
                          Name(id='KeyError', ctx=Load())],
                        ctx=Load()),
                      body=[
                        Pass()])])])]),
