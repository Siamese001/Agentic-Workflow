                            Name(id='KGProvider', ctx=Load()),
                            Name(id='TemporalStore', ctx=Load())],
                          ctx=Load()),
                        is_async=0)])]),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='pytest', ctx=Load()),
                      attr='skip',
                      ctx=Load()),
                    args=[
                      Constant(value='KG components not implemented')]))]),
