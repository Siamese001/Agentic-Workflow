                      attr='create_entity',
                      ctx=Load()),
                    args=[
                      Constant(value='Person'),
                      Dict(
                        keys=[
                          Constant(value='name'),
                          Constant(value='skill')],
                        values=[
                          JoinedStr(
                            values=[
                              Constant(value='Person_'),
                              FormattedValue(
                                value=Name(id='i', ctx=Load()),
                                conversion=-1)]),
                          JoinedStr(
                            values=[
                              Constant(value='Skill_'),
                              FormattedValue(
                                value=BinOp(
                                  left=Name(id='i', ctx=Load()),
                                  op=Mod(),
                                  right=Constant(value=10)),
                                conversion=-1)])])])),
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='entities', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Name(id='entity', ctx=Load())]))]),
