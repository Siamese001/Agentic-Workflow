                  In()],
                comparators=[
                  Name(id='person_entity', ctx=Load())])),
            Assert(
              test=Compare(
                left=Constant(value='properties'),
                ops=[
                  In()],
                comparators=[
                  Name(id='person_entity', ctx=Load())])),
