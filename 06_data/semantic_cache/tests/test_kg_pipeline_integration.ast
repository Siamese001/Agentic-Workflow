              value=Constant(value='Test KG integrates with temporal memory')),
            If(
              test=Call(
                func=Name(id='all', ctx=Load()),
                args=[
                  GeneratorExp(
                    elt=Compare(
                      left=Name(id='cls', ctx=Load()),
                      ops=[
