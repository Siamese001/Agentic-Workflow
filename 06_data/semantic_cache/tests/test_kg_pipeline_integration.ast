                  attr='create_entity',
                  ctx=Load()),
                args=[
                  Constant(value='Company'),
                  Dict(
                    keys=[
                      Constant(value='name')],
                    values=[
                      Constant(value='TestCorp')])])),
            Assign(
              targets=[
                Name(id='invalid_relations', ctx=Store())],
              value=List(
                elts=[
                  Dict(
                    keys=[
                      Constant(value='subject'),
                      Constant(value='predicate'),
                      Constant(value='object')],
                    values=[
                      Subscript(
                        value=Name(id='person', ctx=Load()),
                        slice=Constant(value='id'),
                        ctx=Load()),
                      Constant(value='invalid_relation'),
                      Subscript(
                        value=Name(id='company', ctx=Load()),
                        slice=Constant(value='id'),
                        ctx=Load())]),
                  Dict(
                    keys=[
                      Constant(value='subject'),
                      Constant(value='predicate'),
                      Constant(value='object')],
                    values=[
                      Constant(value='non_existent_id'),
                      Constant(value='works_at'),
                      Subscript(
                        value=Name(id='company', ctx=Load()),
                        slice=Constant(value='id'),
                        ctx=Load())]),
                  Dict(
                    keys=[
                      Constant(value='subject'),
                      Constant(value='predicate'),
                      Constant(value='object')],
                    values=[
                      Subscript(
                        value=Name(id='person', ctx=Load()),
                        slice=Constant(value='id'),
                        ctx=Load()),
                      Constant(value='works_at'),
                      Constant(value='non_existent_id')])],
                ctx=Load())),
            For(
              target=Name(id='invalid_rel', ctx=Store()),
              iter=Name(id='invalid_relations', ctx=Load()),
              body=[
