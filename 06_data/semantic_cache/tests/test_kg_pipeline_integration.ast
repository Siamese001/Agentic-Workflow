                    keys=[
                      Constant(value='type'),
                      Constant(value='entity_type'),
                      Constant(value='limit')],
                    values=[
                      Constant(value='entity_query'),
                      Constant(value='Person'),
                      Constant(value=50)])])),
            Assign(
              targets=[
                Name(id='elapsed_time', ctx=Store())],
              value=BinOp(
                left=Call(
                  func=Attribute(
                    value=Name(id='time', ctx=Load()),
                    attr='time',
                    ctx=Load())),
                op=Sub(),
                right=Name(id='start_time', ctx=Load()))),
            Assert(
              test=Compare(
                left=Name(id='elapsed_time', ctx=Load()),
                ops=[
                  Lt()],
                comparators=[
                  Constant(value=2.0)])),
            Assert(
              test=Compare(
                left=Constant(value='results'),
                ops=[
                  In()],
                comparators=[
                  Name(id='query_result', ctx=Load())])),
            Assert(
              test=Compare(
