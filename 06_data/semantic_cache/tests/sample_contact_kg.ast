        FunctionDef(
          name='_filter_by_signals',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='results',
                annotation=Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Name(id='OutreachRAGResult', ctx=Load()),
                  ctx=Load())),
              arg(
                arg='signal_params',
                annotation=Subscript(
                  value=Name(id='Dict', ctx=Load()),
                  slice=Tuple(
                    elts=[
                      Name(id='str', ctx=Load()),
                      Name(id='Any', ctx=Load())],
                    ctx=Load()),
                  ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='Filter results based on signal parameters.')),
            Assign(
              targets=[
                Name(id='min_score', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='signal_params', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='min_signal_score'),
                  Constant(value=0.0)])),
            Assign(
              targets=[
                Name(id='max_age', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='signal_params', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='max_age_days'),
                  Constant(value=365)])),
            Assign(
              targets=[
                Name(id='signal_types', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='signal_params', ctx=Load()),
                  attr='get',
                  ctx=Load()),
                args=[
                  Constant(value='signal_types'),
                  List(ctx=Load())])),
            Assign(
              targets=[
                Name(id='filtered', ctx=Store())],
              value=List(ctx=Load())),
            For(
              target=Name(id='result', ctx=Store()),
              iter=Name(id='results', ctx=Load()),
              body=[
                If(
                  test=Compare(
                    left=Attribute(
                      value=Name(id='result', ctx=Load()),
                      attr='signal_score',
                      ctx=Load()),
                    ops=[
                      Lt()],
                    comparators=[
                      Name(id='min_score', ctx=Load())]),
                  body=[
                    Continue()]),
                If(
                  test=Compare(
                    left=Attribute(
                      value=Name(id='result', ctx=Load()),
                      attr='age_days',
                      ctx=Load()),
                    ops=[
                      Gt()],
                    comparators=[
                      Name(id='max_age', ctx=Load())]),
                  body=[
                    Continue()]),
                If(
                  test=BoolOp(
                    op=And(),
                    values=[
                      Name(id='signal_types', ctx=Load()),
                      Compare(
                        left=Attribute(
                          value=Name(id='result', ctx=Load()),
                          attr='signal_type',
                          ctx=Load()),
                        ops=[
                          NotIn()],
                        comparators=[
                          Name(id='signal_types', ctx=Load())])]),
                  body=[
                    Continue()]),
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='filtered', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Name(id='result', ctx=Load())]))]),
            Return(
              value=Name(id='filtered', ctx=Load()))],
          returns=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='OutreachRAGResult', ctx=Load()),
            ctx=Load())),
