        FunctionDef(
          name='test_thread_safety_basic',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test basic thread safety of budget manager operations.')),
            Assign(
              targets=[
                Name(id='results', ctx=Store())],
              value=List(ctx=Load())),
            Assign(
              targets=[
                Name(id='errors', ctx=Store())],
              value=List(ctx=Load())),
            FunctionDef(
              name='worker',
              args=arguments(
                args=[
                  arg(arg='worker_id')]),
              body=[
                Try(
                  body=[
                    For(
                      target=Name(id='i', ctx=Store()),
                      iter=Call(
                        func=Name(id='range', ctx=Load()),
                        args=[
                          Constant(value=10)]),
                      body=[
                        Expr(
                          value=Call(
                            func=Attribute(
                              value=Attribute(
                                value=Name(id='self', ctx=Load()),
                                attr='budget_manager',
                                ctx=Load()),
                              attr='start_stage',
                              ctx=Load()),
                            args=[
                              JoinedStr(
                                values=[
                                  Constant(value='worker_'),
                                  FormattedValue(
                                    value=Name(id='worker_id', ctx=Load()),
                                    conversion=-1)])])),
                        Expr(
                          value=Call(
                            func=Attribute(
                              value=Attribute(
                                value=Name(id='self', ctx=Load()),
                                attr='budget_manager',
                                ctx=Load()),
                              attr='record_tokens',
                              ctx=Load()),
                            args=[
                              JoinedStr(
                                values=[
                                  Constant(value='worker_'),
                                  FormattedValue(
                                    value=Name(id='worker_id', ctx=Load()),
                                    conversion=-1)]),
                              Constant(value=100)])),
                        Expr(
                          value=Call(
                            func=Attribute(
                              value=Attribute(
                                value=Name(id='self', ctx=Load()),
                                attr='budget_manager',
                                ctx=Load()),
                              attr='record_request',
                              ctx=Load()))),
                        If(
                          test=Compare(
                            left=BinOp(
                              left=Name(id='i', ctx=Load()),
                              op=Mod(),
                              right=Constant(value=2)),
                            ops=[
                              Eq()],
                            comparators=[
                              Constant(value=0)]),
                          body=[
                            Assign(
                              targets=[
                                Name(id='depth_ok', ctx=Store())],
                              value=Call(
                                func=Attribute(
                                  value=Attribute(
                                    value=Name(id='self', ctx=Load()),
                                    attr='budget_manager',
                                    ctx=Load()),
                                  attr='increment_depth',
                                  ctx=Load()),
                                args=[
                                  JoinedStr(
                                    values=[
                                      Constant(value='worker_'),
                                      FormattedValue(
                                        value=Name(id='worker_id', ctx=Load()),
                                        conversion=-1)])])),
                            If(
                              test=Name(id='depth_ok', ctx=Load()),
                              body=[
                                Expr(
                                  value=Call(
                                    func=Attribute(
                                      value=Attribute(
                                        value=Name(id='self', ctx=Load()),
                                        attr='budget_manager',
                                        ctx=Load()),
                                      attr='decrement_depth',
                                      ctx=Load()),
                                    args=[
                                      JoinedStr(
                                        values=[
                                          Constant(value='worker_'),
                                          FormattedValue(
                                            value=Name(id='worker_id', ctx=Load()),
                                            conversion=-1)])]))])])])],
                  handlers=[
                    ExceptHandler(
                      type=Name(id='Exception', ctx=Load()),
                      name='e',
                      body=[
                        Expr(
                          value=Call(
                            func=Attribute(
                              value=Name(id='errors', ctx=Load()),
                              attr='append',
                              ctx=Load()),
                            args=[
                              Tuple(
                                elts=[
                                  Name(id='worker_id', ctx=Load()),
                                  Name(id='e', ctx=Load())],
                                ctx=Load())]))])]),
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='results', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Name(id='worker_id', ctx=Load())]))]),
            Assign(
              targets=[
                Name(id='threads', ctx=Store())],
              value=List(ctx=Load())),
            For(
              target=Name(id='i', ctx=Store()),
              iter=Call(
                func=Name(id='range', ctx=Load()),
                args=[
                  Constant(value=5)]),
              body=[
                Assign(
                  targets=[
                    Name(id='thread', ctx=Store())],
                  value=Call(
                    func=Attribute(
                      value=Name(id='threading', ctx=Load()),
                      attr='Thread',
                      ctx=Load()),
                    keywords=[
                      keyword(
                        arg='target',
                        value=Name(id='worker', ctx=Load())),
                      keyword(
                        arg='args',
                        value=Tuple(
                          elts=[
                            Name(id='i', ctx=Load())],
                          ctx=Load()))])),
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='threads', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Name(id='thread', ctx=Load())])),
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='thread', ctx=Load()),
                      attr='start',
                      ctx=Load())))]),
            For(
              target=Name(id='thread', ctx=Store()),
              iter=Name(id='threads', ctx=Load()),
              body=[
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='thread', ctx=Load()),
                      attr='join',
                      ctx=Load())))]),
            Assert(
              test=Compare(
                left=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Name(id='errors', ctx=Load())]),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value=0)])),
            Assert(
              test=Compare(
                left=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Name(id='results', ctx=Load())]),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value=5)])),
            Assign(
              targets=[
                Name(id='usage', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='self', ctx=Load()),
                    attr='budget_manager',
                    ctx=Load()),
                  attr='current_usage',
                  ctx=Load()))),
            Assert(
              test=Compare(
                left=Subscript(
                  value=Name(id='usage', ctx=Load()),
                  slice=Constant(value='tokens_used'),
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value=5000)])),
            Assert(
              test=Compare(
                left=Subscript(
                  value=Name(id='usage', ctx=Load()),
                  slice=Constant(value='requests_made'),
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value=50)])),
            Assert(
              test=Compare(
                left=Subscript(
                  value=Name(id='usage', ctx=Load()),
                  slice=Constant(value='current_depth'),
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value=0)]))]),
        FunctionDef(
