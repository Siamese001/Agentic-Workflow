Module(
  body=[
    Expr(
      value=Constant(value='\nL2 Execution Layer Unit Tests\n\nTests for tool execution, SDK calls, and MCP integration without planning logic.\nFocuses on individual tool execution, error handling, and response validation.\n')),
    Import(
      names=[
        alias(name='pytest')]),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Dict'),
        alias(name='Any'),
        alias(name='List'),
        alias(name='Optional')],
      level=0),
    ImportFrom(
      module='dataclasses',
      names=[
        alias(name='dataclass')],
      level=0),
    ImportFrom(
      module='unittest.mock',
      names=[
        alias(name='Mock'),
        alias(name='patch'),
        alias(name='AsyncMock')],
      level=0),
    Import(
      names=[
        alias(name='asyncio')]),
    Import(
      names=[
        alias(name='time')]),
    Assign(
      targets=[
        Name(id='pytestmark', ctx=Store())],
      value=List(
        elts=[
          Attribute(
            value=Attribute(
              value=Name(id='pytest', ctx=Load()),
              attr='mark',
              ctx=Load()),
            attr='unit',
            ctx=Load()),
          Attribute(
            value=Attribute(
              value=Name(id='pytest', ctx=Load()),
              attr='mark',
              ctx=Load()),
            attr='l2',
            ctx=Load()),
          Attribute(
            value=Attribute(
              value=Name(id='pytest', ctx=Load()),
              attr='mark',
              ctx=Load()),
            attr='execution',
            ctx=Load())],
        ctx=Load())),
    ClassDef(
      name='MockToolRequest',
      body=[
        Expr(
          value=Constant(value='Mock tool request for testing L2 execution.')),
        AnnAssign(
          target=Name(id='tool_name', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='parameters', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='Any', ctx=Load())],
              ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='timeout', ctx=Store()),
          annotation=Name(id='float', ctx=Load()),
          value=Constant(value=30.0),
          simple=1),
        AnnAssign(
          target=Name(id='retry_count', ctx=Store()),
          annotation=Name(id='int', ctx=Load()),
          value=Constant(value=3),
          simple=1)],
      decorator_list=[
        Call(
          func=Name(id='dataclass', ctx=Load()),
          keywords=[
            keyword(
              arg='frozen',
              value=Constant(value=True))])]),
    ClassDef(
      name='MockToolResponse',
      body=[
        Expr(
          value=Constant(value='Mock tool response for testing L2 execution.')),
        AnnAssign(
          target=Name(id='success', ctx=Store()),
          annotation=Name(id='bool', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='data', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Optional', ctx=Load()),
            slice=Subscript(
              value=Name(id='Dict', ctx=Load()),
              slice=Tuple(
                elts=[
                  Name(id='str', ctx=Load()),
                  Name(id='Any', ctx=Load())],
                ctx=Load()),
              ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='error', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Optional', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='execution_time', ctx=Store()),
          annotation=Name(id='float', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='tokens_used', ctx=Store()),
          annotation=Name(id='int', ctx=Load()),
          simple=1)],
      decorator_list=[
        Call(
          func=Name(id='dataclass', ctx=Load()),
          keywords=[
            keyword(
              arg='frozen',
              value=Constant(value=True))])]),
    ClassDef(
      name='TestToolExecutionCore',
      body=[
        Expr(
          value=Constant(value='Test core L2 tool execution functionality.')),
        FunctionDef(
          name='test_successful_tool_execution',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test successful tool execution with valid parameters.')),
            Assign(
              targets=[
                Name(id='request', ctx=Store())],
              value=Call(
                func=Name(id='MockToolRequest', ctx=Load()),
                keywords=[
                  keyword(
                    arg='tool_name',
                    value=Constant(value='text_analyzer')),
                  keyword(
                    arg='parameters',
                    value=Dict(
                      keys=[
                        Constant(value='text'),
                        Constant(value='analysis_type')],
                      values=[
                        Constant(value='Sample job description'),
                        Constant(value='requirements')])),
                  keyword(
                    arg='timeout',
                    value=Constant(value=10.0))])),
            Assign(
              targets=[
                Name(id='response', ctx=Store())],
              value=Call(
                func=Name(id='MockToolResponse', ctx=Load()),
                keywords=[
                  keyword(
                    arg='success',
                    value=Constant(value=True)),
                  keyword(
                    arg='data',
                    value=Dict(
                      keys=[
                        Constant(value='extracted_requirements')],
                      values=[
                        List(
                          elts=[
                            Constant(value='Python'),
                            Constant(value='AWS'),
                            Constant(value='5+ years experience')],
                          ctx=Load())])),
                  keyword(
                    arg='error',
                    value=Constant(value=None)),
                  keyword(
                    arg='execution_time',
                    value=Constant(value=1.5)),
                  keyword(
                    arg='tokens_used',
                    value=Constant(value=150))])),
            Assert(
              test=Compare(
                left=Attribute(
                  value=Name(id='response', ctx=Load()),
                  attr='success',
                  ctx=Load()),
                ops=[
                  Is()],
                comparators=[
                  Constant(value=True)])),
            Assert(
              test=Compare(
                left=Attribute(
                  value=Name(id='response', ctx=Load()),
                  attr='data',
                  ctx=Load()),
                ops=[
                  IsNot()],
                comparators=[
                  Constant(value=None)])),
            Assert(
              test=Compare(
                left=Constant(value='extracted_requirements'),
                ops=[
                  In()],
                comparators=[
                  Attribute(
                    value=Name(id='response', ctx=Load()),
                    attr='data',
                    ctx=Load())])),
            Assert(
              test=Compare(
                left=Attribute(
                  value=Name(id='response', ctx=Load()),
                  attr='error',
                  ctx=Load()),
                ops=[
                  Is()],
                comparators=[
                  Constant(value=None)])),
            Assert(
              test=Compare(
                left=Attribute(
                  value=Name(id='response', ctx=Load()),
                  attr='execution_time',
                  ctx=Load()),
                ops=[
                  Lt()],
                comparators=[
                  Attribute(
                    value=Name(id='request', ctx=Load()),
                    attr='timeout',
                    ctx=Load())]))]),
        FunctionDef(
          name='test_tool_timeout_handling',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test tool execution timeout handling.')),
            Assign(
              targets=[
                Name(id='request', ctx=Store())],
              value=Call(
                func=Name(id='MockToolRequest', ctx=Load()),
                keywords=[
                  keyword(
                    arg='tool_name',
                    value=Constant(value='slow_processor')),
                  keyword(
                    arg='parameters',
                    value=Dict(
                      keys=[
                        Constant(value='data')],
                      values=[
                        Constant(value='large_dataset')])),
                  keyword(
                    arg='timeout',
                    value=Constant(value=0.1))])),
            Assign(
              targets=[
                Name(id='start_time', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='time', ctx=Load()),
                  attr='time',
                  ctx=Load()))),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='time', ctx=Load()),
                  attr='sleep',
                  ctx=Load()),
                args=[
                  Constant(value=0.2)])),
            Assign(
              targets=[
                Name(id='execution_time', ctx=Store())],
              value=BinOp(
                left=Call(
                  func=Attribute(
                    value=Name(id='time', ctx=Load()),
                    attr='time',
                    ctx=Load())),
                op=Sub(),
                right=Name(id='start_time', ctx=Load()))),
            Assign(
              targets=[
                Name(id='response', ctx=Store())],
              value=Call(
                func=Name(id='MockToolResponse', ctx=Load()),
                keywords=[
                  keyword(
                    arg='success',
                    value=Constant(value=False)),
                  keyword(
                    arg='data',
                    value=Constant(value=None)),
                  keyword(
                    arg='error',
                    value=JoinedStr(
                      values=[
                        Constant(value='Tool execution timed out after '),
                        FormattedValue(
                          value=Name(id='execution_time', ctx=Load()),
                          conversion=-1,
                          format_spec=JoinedStr(
                            values=[
                              Constant(value='.2f')])),
                        Constant(value='s')])),
                  keyword(
                    arg='execution_time',
                    value=Name(id='execution_time', ctx=Load())),
                  keyword(
                    arg='tokens_used',
                    value=Constant(value=0))])),
            Assert(
              test=Compare(
                left=Attribute(
                  value=Name(id='response', ctx=Load()),
                  attr='success',
                  ctx=Load()),
                ops=[
                  Is()],
                comparators=[
                  Constant(value=False)])),
            Assert(
              test=Compare(
                left=Attribute(
                  value=Name(id='response', ctx=Load()),
                  attr='error',
                  ctx=Load()),
                ops=[
                  IsNot()],
                comparators=[
                  Constant(value=None)])),
            Assert(
              test=Compare(
                left=Constant(value='timed out'),
                ops=[
                  In()],
                comparators=[
                  Call(
                    func=Attribute(
                      value=Attribute(
                        value=Name(id='response', ctx=Load()),
                        attr='error',
                        ctx=Load()),
                      attr='lower',
                      ctx=Load()))])),
            Assert(
              test=Compare(
                left=Name(id='execution_time', ctx=Load()),
                ops=[
                  Gt()],
                comparators=[
                  Attribute(
                    value=Name(id='request', ctx=Load()),
                    attr='timeout',
                    ctx=Load())]))]),
        FunctionDef(
          name='test_tool_parameter_validation',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test tool parameter validation before execution.')),
            Assign(
              targets=[
                Name(id='valid_request', ctx=Store())],
              value=Call(
                func=Name(id='MockToolRequest', ctx=Load()),
                keywords=[
                  keyword(
                    arg='tool_name',
                    value=Constant(value='resume_parser')),
                  keyword(
                    arg='parameters',
                    value=Dict(
                      keys=[
                        Constant(value='resume_text'),
                        Constant(value='format')],
                      values=[
                        Constant(value='John Doe\nExperience: 5 years'),
                        Constant(value='structured')])),
                  keyword(
                    arg='timeout',
                    value=Constant(value=15.0))])),
            Assign(
              targets=[
                Name(id='required_params', ctx=Store())],
              value=List(
                elts=[
                  Constant(value='resume_text'),
                  Constant(value='format')],
                ctx=Load())),
            Assign(
              targets=[
                Name(id='valid_params', ctx=Store())],
              value=Call(
                func=Name(id='all', ctx=Load()),
                args=[
                  GeneratorExp(
                    elt=Compare(
                      left=Name(id='param', ctx=Load()),
                      ops=[
                        In()],
                      comparators=[
                        Attribute(
                          value=Name(id='valid_request', ctx=Load()),
                          attr='parameters',
                          ctx=Load())]),
                    generators=[
                      comprehension(
                        target=Name(id='param', ctx=Store()),
                        iter=Name(id='required_params', ctx=Load()),
                        is_async=0)])])),
            Assert(
              test=Compare(
                left=Name(id='valid_params', ctx=Load()),
                ops=[
                  Is()],
                comparators=[
                  Constant(value=True)])),
            Assign(
              targets=[
                Name(id='invalid_request', ctx=Store())],
              value=Call(
                func=Name(id='MockToolRequest', ctx=Load()),
                keywords=[
                  keyword(
                    arg='tool_name',
                    value=Constant(value='resume_parser')),
                  keyword(
                    arg='parameters',
                    value=Dict(
                      keys=[
                        Constant(value='resume_text')],
                      values=[
                        Constant(value='John Doe\nExperience: 5 years')])),
                  keyword(
                    arg='timeout',
                    value=Constant(value=15.0))])),
            Assign(
              targets=[
                Name(id='missing_params', ctx=Store())],
              value=ListComp(
                elt=Name(id='param', ctx=Load()),
                generators=[
                  comprehension(
                    target=Name(id='param', ctx=Store()),
                    iter=Name(id='required_params', ctx=Load()),
                    ifs=[
                      Compare(
                        left=Name(id='param', ctx=Load()),
                        ops=[
                          NotIn()],
                        comparators=[
                          Attribute(
                            value=Name(id='invalid_request', ctx=Load()),
                            attr='parameters',
                            ctx=Load())])],
                    is_async=0)])),
            Assert(
              test=Compare(
                left=Call(
                  func=Name(id='len', ctx=Load()),
                  args=[
                    Name(id='missing_params', ctx=Load())]),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value=1)])),
            Assert(
              test=Compare(
                left=Constant(value='format'),
                ops=[
                  In()],
                comparators=[
                  Name(id='missing_params', ctx=Load())]))])]),
    ClassDef(
      name='TestRetryAndBackoffLogic',
      body=[
        Expr(
          value=Constant(value='Test L2 retry logic and exponential backoff.')),
        FunctionDef(
          name='test_retry_on_failure',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test retry mechanism for failed tool executions.')),
            Assign(
              targets=[
                Name(id='retry_count', ctx=Store())],
              value=Constant(value=0)),
            Assign(
              targets=[
                Name(id='max_retries', ctx=Store())],
              value=Constant(value=3)),
            For(
              target=Name(id='attempt', ctx=Store()),
              iter=Call(
                func=Name(id='range', ctx=Load()),
                args=[
                  Name(id='max_retries', ctx=Load())]),
              body=[
                AugAssign(
                  target=Name(id='retry_count', ctx=Store()),
                  op=Add(),
                  value=Constant(value=1)),
                If(
                  test=Compare(
                    left=Name(id='attempt', ctx=Load()),
                    ops=[
                      Lt()],
                    comparators=[
                      Constant(value=2)]),
                  body=[
                    Continue()],
                  orelse=[
                    Assign(
                      targets=[
                        Name(id='response', ctx=Store())],
                      value=Call(
                        func=Name(id='MockToolResponse', ctx=Load()),
                        keywords=[
                          keyword(
                            arg='success',
                            value=Constant(value=True)),
                          keyword(
                            arg='data',
                            value=Dict(
                              keys=[
                                Constant(value='result')],
                              values=[
                                Constant(value='success_after_retry')])),
                          keyword(
                            arg='error',
                            value=Constant(value=None)),
                          keyword(
                            arg='execution_time',
                            value=Constant(value=1.0)),
                          keyword(
                            arg='tokens_used',
                            value=Constant(value=100))])),
                    Break()])],
              orelse=[
                Assign(
                  targets=[
                    Name(id='response', ctx=Store())],
                  value=Call(
                    func=Name(id='MockToolResponse', ctx=Load()),
                    keywords=[
                      keyword(
                        arg='success',
                        value=Constant(value=False)),
                      keyword(
                        arg='data',
                        value=Constant(value=None)),
                      keyword(
                        arg='error',
                        value=Constant(value='All retry attempts failed')),
                      keyword(
                        arg='execution_time',
                        value=Constant(value=0.0)),
                      keyword(
                        arg='tokens_used',
                        value=Constant(value=0))]))]),
            Assert(
              test=Compare(
                left=Name(id='retry_count', ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value=3)])),
            Assert(
              test=Compare(
                left=Attribute(
                  value=Name(id='response', ctx=Load()),
                  attr='success',
                  ctx=Load()),
                ops=[
                  Is()],
                comparators=[
                  Constant(value=True)])),
            Assert(
              test=Compare(
                left=Subscript(
                  value=Attribute(
                    value=Name(id='response', ctx=Load()),
                    attr='data',
                    ctx=Load()),
                  slice=Constant(value='result'),
                  ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Constant(value='success_after_retry')]))]),
        FunctionDef(
          name='test_exponential_backoff_timing',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test exponential backoff timing between retries.')),
            Assign(
              targets=[
                Name(id='base_delay', ctx=Store())],
              value=Constant(value=1.0)),
            Assign(
              targets=[
                Name(id='max_delay', ctx=Store())],
              value=Constant(value=10.0)),
            Assign(
              targets=[
                Name(id='retry_attempts', ctx=Store())],
              value=List(ctx=Load())),
            For(
              target=Name(id='attempt', ctx=Store()),
              iter=Call(
                func=Name(id='range', ctx=Load()),
                args=[
                  Constant(value=4)]),
              body=[
                Assign(
                  targets=[
                    Name(id='delay', ctx=Store())],
                  value=Call(
                    func=Name(id='min', ctx=Load()),
                    args=[
                      BinOp(
                        left=Name(id='base_delay', ctx=Load()),
                        op=Mult(),
                        right=BinOp(
                          left=Constant(value=2),
                          op=Pow(),
                          right=Name(id='attempt', ctx=Load()))),
                      Name(id='max_delay', ctx=Load())])),
                Expr(
                  value=Call(
                    func=Attribute(
                      value=Name(id='retry_attempts', ctx=Load()),
                      attr='append',
                      ctx=Load()),
                    args=[
                      Name(id='delay', ctx=Load())]))]),
            Assign(
              targets=[
                Name(id='expected_delays', ctx=Store())],
              value=List(
                elts=[
                  Constant(value=1.0),
                  Constant(value=2.0),
                  Constant(value=4.0),
                  Constant(value=8.0)],
                ctx=Load())),
            Assert(
              test=Compare(
                left=Name(id='retry_attempts', ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Name(id='expected_delays', ctx=Load())])),
            Assert(
              test=Call(
                func=Name(id='all', ctx=Load()),
                args=[
                  GeneratorExp(
                    elt=Compare(
                      left=Name(id='delay', ctx=Load()),
                      ops=[
                        LtE()],
                      comparators=[
                        Name(id='max_delay', ctx=Load())]),
                    generators=[
                      comprehension(
                        target=Name(id='delay', ctx=Store()),
                        iter=Name(id='retry_attempts', ctx=Load()),
                        is_async=0)])]))]),
        FunctionDef(
          name='test_circuit_breaker_activation',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test circuit breaker activation after consecutive failures.')),
            Assign(
              targets=[
                Name(id='failure_threshold', ctx=Store())],
              value=Constant(value=5)),
            Assign(
              targets=[
                Name(id='consecutive_failures', ctx=Store())],
              value=Constant(value=0)),
            Assign(
              targets=[
                Name(id='circuit_breaker_open', ctx=Store())],
              value=Constant(value=False)),
            For(
              target=Name(id='i', ctx=Store()),
              iter=Call(
                func=Name(id='range', ctx=Load()),
                args=[
                  Constant(value=7)]),
              body=[
                If(
                  test=Compare(
                    left=Name(id='i', ctx=Load()),
                    ops=[
                      Lt()],
                    comparators=[
                      Constant(value=6)]),
                  body=[
                    AugAssign(
                      target=Name(id='consecutive_failures', ctx=Store()),
                      op=Add(),
                      value=Constant(value=1)),
                    If(
                      test=Compare(
                        left=Name(id='consecutive_failures', ctx=Load()),
                        ops=[
                          GtE()],
                        comparators=[
                          Name(id='failure_threshold', ctx=Load())]),
                      body=[
                        Assign(
                          targets=[
                            Name(id='circuit_breaker_open', ctx=Store())],
                          value=Constant(value=True))])],
                  orelse=[
                    If(
                      test=Name(id='circuit_breaker_open', ctx=Load()),
                      body=[
                        Assign(
                          targets=[
                            Name(id='response', ctx=Store())],
                          value=Call(
                            func=Name(id='MockToolResponse', ctx=Load()),
                            keywords=[
                              keyword(
                                arg='success',
                                value=Constant(value=False)),
                              keyword(
                                arg='data',
                                value=Constant(value=None)),
                              keyword(
                                arg='error',
                                value=Constant(value='Circuit breaker is open')),
                              keyword(
                                arg='execution_time',
                                value=Constant(value=0.0)),
                              keyword(
                                arg='tokens_used',
                                value=Constant(value=0))]))])])]),
            Assert(
              test=Compare(
                left=Name(id='circuit_breaker_open', ctx=Load()),
                ops=[
                  Is()],
                comparators=[
                  Constant(value=True)])),
            Assert(
              test=Compare(
                left=Name(id='consecutive_failures', ctx=Load()),
                ops=[
                  GtE()],
                comparators=[
                  Name(id='failure_threshold', ctx=Load())]))])]),
    ClassDef(
      name='TestResponseValidationAndParsing',
      body=[
        Expr(
          value=Constant(value='Test L2 response validation and data parsing.')),
        FunctionDef(
          name='test_response_schema_validation',
          args=arguments(
            args=[
              arg(arg='self')]),
          body=[
            Expr(
              value=Constant(value='Test validation of tool response schemas.')),
            Assign(
              targets=[
                Name(id='expected_schema', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='type'),
                  Constant(value='properties'),
                  Constant(value='required')],
                values=[
                  Constant(value='object'),
                  Dict(
                    keys=[
                      Constant(value='requirements'),
                      Constant(value='skills'),
                      Constant(value='experience_level')],
                    values=[
                      Dict(
                        keys=[
                          Constant(value='type')],
                        values=[
                          Constant(value='array')]),
                      Dict(
                        keys=[
                          Constant(value='type')],
                        values=[
                          Constant(value='array')]),
                      Dict(
                        keys=[
                          Constant(value='type')],
                        values=[
                          Constant(value='string')])]),
                  List(
                    elts=[
                      Constant(value='requirements'),
                      Constant(value='skills')],
                    ctx=Load())])),
            Assign(
              targets=[
                Name(id='valid_response', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='requirements'),
                  Constant(value='skills'),
                  Constant(value='experience_level')],
                values=[
                  List(
                    elts=[
                      Constant(value='Python'),
                      Constant(value='AWS')],
                    ctx=Load()),
                  List(
                    elts=[
                      Constant(value='programming'),
                      Constant(value='cloud computing')],
                    ctx=Load()),
                  Constant(value='senior')])),
            Assign(
              targets=[
                Name(id='is_valid', ctx=Store())],
              value=BoolOp(
                op=And(),
                values=[
                  Call(
                    func=Name(id='isinstance', ctx=Load()),
                    args=[
                      Name(id='valid_response', ctx=Load()),
                      Name(id='dict', ctx=Load())]),
                  Call(
                    func=Name(id='all', ctx=Load()),
                    args=[
                      GeneratorExp(
                        elt=Compare(
                          left=Name(id='prop', ctx=Load()),
                          ops=[
                            In()],
                          comparators=[
                            Name(id='valid_response', ctx=Load())]),
                        generators=[
                          comprehension(
                            target=Name(id='prop', ctx=Store()),
                            iter=Subscript(
                              value=Name(id='expected_schema', ctx=Load()),
                              slice=Constant(value='required'),
                              ctx=Load()),
                            is_async=0)])]),
                  Call(
                    func=Name(id='all', ctx=Load()),
                    args=[
                      GeneratorExp(
                        elt=Call(
                          func=Name(id='isinstance', ctx=Load()),
                          args=[
                            Subscript(
                              value=Name(id='valid_response', ctx=Load()),
                              slice=Name(id='prop', ctx=Load()),
                              ctx=Load()),
                            Subscript(
                              value=Subscript(
                                value=Subscript(
                                  value=Name(id='expected_schema', ctx=Load()),
                                  slice=Constant(value='properties'),
                                  ctx=Load()),
                                slice=Name(id='prop', ctx=Load()),
                                ctx=Load()),
                              slice=Constant(value='type'),
