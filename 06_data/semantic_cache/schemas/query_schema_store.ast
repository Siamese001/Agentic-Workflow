Module(
  body=[
    Expr(
      value=Constant(value='\nSchema definitions for schema store querying and search operations.\nContains only type definitions and data models - no execution logic.\n')),
    ImportFrom(
      module='dataclasses',
      names=[
        alias(name='dataclass')],
      level=0),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Optional'),
        alias(name='Dict'),
        alias(name='Any'),
        alias(name='List')],
      level=0),
    ImportFrom(
      module='enum',
      names=[
        alias(name='Enum')],
      level=0),
    ClassDef(
      name='QueryType',
      bases=[
        Name(id='Enum', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Types of schema store queries.')),
        Assign(
          targets=[
            Name(id='SEARCH', ctx=Store())],
          value=Constant(value='search')),
        Assign(
          targets=[
            Name(id='FILTER', ctx=Store())],
          value=Constant(value='filter')),
        Assign(
          targets=[
            Name(id='AGGREGATE', ctx=Store())],
          value=Constant(value='aggregate')),
        Assign(
          targets=[
            Name(id='JOIN', ctx=Store())],
          value=Constant(value='join'))]),
    ClassDef(
      name='QueryLanguage',
      bases=[
        Name(id='Enum', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Supported query languages.')),
        Assign(
          targets=[
            Name(id='SQL', ctx=Store())],
          value=Constant(value='sql')),
        Assign(
          targets=[
            Name(id='GRAPHQL', ctx=Store())],
          value=Constant(value='graphql')),
        Assign(
          targets=[
            Name(id='SPARQL', ctx=Store())],
          value=Constant(value='sparql')),
        Assign(
          targets=[
            Name(id='CUSTOM_DSL', ctx=Store())],
          value=Constant(value='custom_dsl'))]),
    ClassDef(
      name='QueryParameters',
      body=[
        Expr(
          value=Constant(value='Schema for query execution parameters.')),
        AnnAssign(
          target=Name(id='query_type', ctx=Store()),
          annotation=Name(id='QueryType', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='language', ctx=Store()),
          annotation=Name(id='QueryLanguage', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='query_string', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='parameters', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='Any', ctx=Load())],
              ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='limit', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Optional', ctx=Load()),
            slice=Name(id='int', ctx=Load()),
            ctx=Load()),
          value=Constant(value=None),
          simple=1),
        AnnAssign(
          target=Name(id='offset', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Optional', ctx=Load()),
            slice=Name(id='int', ctx=Load()),
            ctx=Load()),
          value=Constant(value=None),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='QueryResult',
      body=[
        Expr(
          value=Constant(value='Schema for individual query result.')),
        AnnAssign(
          target=Name(id='result_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='data', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Subscript(
              value=Name(id='Dict', ctx=Load()),
              slice=Tuple(
                elts=[
                  Name(id='str', ctx=Load()),
                  Name(id='Any', ctx=Load())],
                ctx=Load()),
              ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='total_count', ctx=Store()),
          annotation=Name(id='int', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='execution_time_ms', ctx=Store()),
          annotation=Name(id='int', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='has_more', ctx=Store()),
          annotation=Name(id='bool', ctx=Load()),
          value=Constant(value=False),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='StoreQuery',
      body=[
        AnnAssign(
          target=Name(id='query_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='store_name', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='parameters', ctx=Store()),
          annotation=Name(id='QueryParameters', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='execution_metadata', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='Any', ctx=Load())],
              ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='result', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Optional', ctx=Load()),
            slice=Name(id='QueryResult', ctx=Load()),
            ctx=Load()),
          value=Constant(value=None),
          simple=1),
        Expr(
          value=Constant(value='Schema for complete store query.'))],
      decorator_list=[
        Name(id='dataclass', ctx=Load())])])