Module(
  body=[
    Expr(
      value=Constant(value='\nSchema definitions for safety score computation and analysis.\nContains only type definitions and data models - no execution logic.\n')),
    ImportFrom(
      module='dataclasses',
      names=[
        alias(name='dataclass')],
      level=0),
    ImportFrom(
      module='typing',
      names=[
        alias(name='List')],
      level=0),
    ImportFrom(
      module='enum',
      names=[
        alias(name='Enum')],
      level=0),
    ClassDef(
      name='ScoreMetric',
      bases=[
        Name(id='Enum', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Safety score computation metrics.')),
        Assign(
          targets=[
            Name(id='VULNERABILITY', ctx=Store())],
          value=Constant(value='vulnerability')),
        Assign(
          targets=[
            Name(id='THREAT_LEVEL', ctx=Store())],
          value=Constant(value='threat_level')),
        Assign(
          targets=[
            Name(id='EXPOSURE', ctx=Store())],
          value=Constant(value='exposure')),
        Assign(
          targets=[
            Name(id='CONTAINMENT', ctx=Store())],
          value=Constant(value='containment'))]),
    ClassDef(
      name='ComputationMethod',
      bases=[
        Name(id='Enum', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Safety score computation methods.')),
        Assign(
          targets=[
            Name(id='WEIGHTED_AVERAGE', ctx=Store())],
          value=Constant(value='weighted_average')),
        Assign(
          targets=[
            Name(id='BAYESIAN', ctx=Store())],
          value=Constant(value='bayesian')),
        Assign(
          targets=[
            Name(id='STATISTICAL', ctx=Store())],
          value=Constant(value='statistical')),
        Assign(
          targets=[
            Name(id='HEURISTIC', ctx=Store())],
          value=Constant(value='heuristic'))]),
    ClassDef(
      name='ScoreComponent',
      body=[
        Expr(
          value=Constant(value='Schema for individual score component.')),
        AnnAssign(
          target=Name(id='component_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='metric', ctx=Store()),
          annotation=Name(id='ScoreMetric', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='value', ctx=Store()),
          annotation=Name(id='float', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='weight', ctx=Store()),
          annotation=Name(id='float', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='confidence', ctx=Store()),
          annotation=Name(id='float', ctx=Load()),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='SafetyScoreComputation',
      body=[
        Expr(
          value=Constant(value='Schema for safety score computation.')),
        AnnAssign(
          target=Name(id='computation_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='target_schema_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='computation_method', ctx=Store()),
          annotation=Name(id='ComputationMethod', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='components', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='ScoreComponent', ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='computation_timestamp', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='SafetyScoreResult',
      body=[
        Expr(
          value=Constant(value='Schema for safety score computation results.')),
        AnnAssign(
          target=Name(id='result_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='computation', ctx=Store()),
          annotation=Name(id='SafetyScoreComputation', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='overall_score', ctx=Store()),
          annotation=Name(id='float', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='confidence_level', ctx=Store()),
          annotation=Name(id='float', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='risk_classification', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())])])