Module(
  body=[
    Expr(
      value=Constant(value='\nSchema definitions for schema snapshot preparation and creation.\nContains only type definitions and data models - no execution logic.\n')),
    ImportFrom(
      module='dataclasses',
      names=[
        alias(name='dataclass')],
      level=0),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Optional'),
        alias(name='Dict'),
        alias(name='Any')],
      level=0),
    ImportFrom(
      module='enum',
      names=[
        alias(name='Enum')],
      level=0),
    ClassDef(
      name='SnapshotType',
      bases=[
        Name(id='Enum', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Types of schema snapshots.')),
        Assign(
          targets=[
            Name(id='FULL', ctx=Store())],
          value=Constant(value='full')),
        Assign(
          targets=[
            Name(id='INCREMENTAL', ctx=Store())],
          value=Constant(value='incremental')),
        Assign(
          targets=[
            Name(id='DIFFERENTIAL', ctx=Store())],
          value=Constant(value='differential')),
        Assign(
          targets=[
            Name(id='POINT_IN_TIME', ctx=Store())],
          value=Constant(value='point_in_time'))]),
    ClassDef(
      name='CompressionLevel',
      bases=[
        Name(id='Enum', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Snapshot compression levels.')),
        Assign(
          targets=[
            Name(id='NONE', ctx=Store())],
          value=Constant(value='none')),
        Assign(
          targets=[
            Name(id='LIGHT', ctx=Store())],
          value=Constant(value='light')),
        Assign(
          targets=[
            Name(id='MEDIUM', ctx=Store())],
          value=Constant(value='medium')),
        Assign(
          targets=[
            Name(id='HEAVY', ctx=Store())],
          value=Constant(value='heavy'))]),
    ClassDef(
      name='SnapshotConfig',
      body=[
        Expr(
          value=Constant(value='Schema for snapshot configuration.')),
        AnnAssign(
          target=Name(id='snapshot_type', ctx=Store()),
          annotation=Name(id='SnapshotType', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='compression_level', ctx=Store()),
          annotation=Name(id='CompressionLevel', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='include_metadata', ctx=Store()),
          annotation=Name(id='bool', ctx=Load()),
          value=Constant(value=True),
          simple=1),
        AnnAssign(
          target=Name(id='include_dependencies', ctx=Store()),
          annotation=Name(id='bool', ctx=Load()),
          value=Constant(value=True),
          simple=1),
        AnnAssign(
          target=Name(id='retention_days', ctx=Store()),
          annotation=Name(id='int', ctx=Load()),
          value=Constant(value=30),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='SnapshotMetadata',
      body=[
        Expr(
          value=Constant(value='Schema for snapshot metadata.')),
        AnnAssign(
          target=Name(id='snapshot_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='created_at', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='size_bytes', ctx=Store()),
          annotation=Name(id='int', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='schema_count', ctx=Store()),
          annotation=Name(id='int', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='checksum', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='parent_snapshot_id', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Optional', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load()),
          value=Constant(value=None),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='SchemaSnapshot',
      body=[
        Expr(
          value=Constant(value='Schema for complete schema snapshot.')),
        AnnAssign(
          target=Name(id='snapshot_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='configuration', ctx=Store()),
          annotation=Name(id='SnapshotConfig', ctx=Load()),
