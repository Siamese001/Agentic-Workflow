              ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='creation_time_ms', ctx=Store()),
          annotation=Name(id='int', ctx=Load()),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())])])