                      value=Name(id='self', ctx=Load()),
                      attr='validate_all_categories',
                      ctx=Load())))]),
            Assign(
              targets=[
                Name(id='report', ctx=Store())],
              value=Dict(
                keys=[
                  Constant(value='validation_timestamp'),
                  Constant(value='workspace_root'),
                  Constant(value='overall_status'),
                  Constant(value='categories'),
                  Constant(value='summary')],
                values=[
                  Call(
                    func=Name(id='str', ctx=Load()),
                    args=[
                      Attribute(
                        value=Call(
                          func=Attribute(
                            value=Call(
                              func=Name(id='Path', ctx=Load()),
                              args=[
                                Name(id='__file__', ctx=Load())]),
                            attr='stat',
                            ctx=Load())),
                        attr='st_mtime',
                        ctx=Load())]),
                  Call(
                    func=Name(id='str', ctx=Load()),
                    args=[
                      Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='workspace_root',
                        ctx=Load())]),
                  Constant(value='COMPLIANT'),
                  Dict(),
                  Dict(
                    keys=[
                      Constant(value='total_categories'),
                      Constant(value='compliant_categories'),
                      Constant(value='non_compliant_categories'),
                      Constant(value='issues')],
                    values=[
                      Call(
                        func=Name(id='len', ctx=Load()),
                        args=[
                          Attribute(
                            value=Name(id='self', ctx=Load()),
                            attr='validation_results',
                            ctx=Load())]),
                      Constant(value=0),
                      Constant(value=0),
                      List(ctx=Load())])])),
            For(
              target=Name(id='result', ctx=Store()),
              iter=Attribute(
                value=Name(id='self', ctx=Load()),
                attr='validation_results',
                ctx=Load()),
              body=[
                Assign(
                  targets=[
                    Name(id='category_report', ctx=Store())],
                  value=Dict(
                    keys=[
                      Constant(value='status'),
                      Constant(value='yaml_count'),
                      Constant(value='meta_count'),
                      Constant(value='details'),
                      Constant(value='yaml_items'),
                      Constant(value='meta_items')],
                    values=[
                      Attribute(
                        value=Attribute(
                          value=Name(id='result', ctx=Load()),
                          attr='status',
                          ctx=Load()),
                        attr='value',
                        ctx=Load()),
                      Call(
                        func=Name(id='len', ctx=Load()),
                        args=[
                          Attribute(
                            value=Name(id='result', ctx=Load()),
                            attr='yaml_items',
                            ctx=Load())]),
                      Call(
                        func=Name(id='len', ctx=Load()),
                        args=[
                          Attribute(
                            value=Name(id='result', ctx=Load()),
                            attr='meta_items',
                            ctx=Load())]),
                      Attribute(
                        value=Name(id='result', ctx=Load()),
                        attr='details',
                        ctx=Load()),
                      Call(
                        func=Name(id='sorted', ctx=Load()),
                        args=[
                          Call(
                            func=Name(id='list', ctx=Load()),
                            args=[
                              Attribute(
                                value=Name(id='result', ctx=Load()),
                                attr='yaml_items',
                                ctx=Load())])]),
                      Call(
                        func=Name(id='sorted', ctx=Load()),
                        args=[
                          Call(
                            func=Name(id='list', ctx=Load()),
                            args=[
                              Attribute(
                                value=Name(id='result', ctx=Load()),
                                attr='meta_items',
                                ctx=Load())])])])),
                Assign(
                  targets=[
                    Subscript(
                      value=Subscript(
                        value=Name(id='report', ctx=Load()),
                        slice=Constant(value='categories'),
                        ctx=Load()),
                      slice=Attribute(
                        value=Name(id='result', ctx=Load()),
                        attr='category',
                        ctx=Load()),
                      ctx=Store())],
                  value=Name(id='category_report', ctx=Load())),
                If(
                  test=Compare(
                    left=Attribute(
                      value=Name(id='result', ctx=Load()),
                      attr='status',
                      ctx=Load()),
                    ops=[
                      Eq()],
                    comparators=[
                      Attribute(
                        value=Name(id='ValidationStatus', ctx=Load()),
                        attr='MATCH',
                        ctx=Load())]),
                  body=[
                    AugAssign(
                      target=Subscript(
                        value=Subscript(
                          value=Name(id='report', ctx=Load()),
                          slice=Constant(value='summary'),
                          ctx=Load()),
                        slice=Constant(value='compliant_categories'),
                        ctx=Store()),
                      op=Add(),
                      value=Constant(value=1))],
                  orelse=[
                    AugAssign(
                      target=Subscript(
                        value=Subscript(
                          value=Name(id='report', ctx=Load()),
                          slice=Constant(value='summary'),
                          ctx=Load()),
                        slice=Constant(value='non_compliant_categories'),
                        ctx=Store()),
                      op=Add(),
                      value=Constant(value=1)),
                    Expr(
                      value=Call(
                        func=Attribute(
                          value=Subscript(
                            value=Subscript(
                              value=Name(id='report', ctx=Load()),
                              slice=Constant(value='summary'),
                              ctx=Load()),
                            slice=Constant(value='issues'),
                            ctx=Load()),
                          attr='append',
                          ctx=Load()),
                        args=[
                          Dict(
                            keys=[
                              Constant(value='category'),
                              Constant(value='issue'),
                              Constant(value='details')],
                            values=[
                              Attribute(
                                value=Name(id='result', ctx=Load()),
                                attr='category',
                                ctx=Load()),
                              Attribute(
                                value=Attribute(
                                  value=Name(id='result', ctx=Load()),
                                  attr='status',
                                  ctx=Load()),
                                attr='value',
                                ctx=Load()),
                              Attribute(
                                value=Name(id='result', ctx=Load()),
                                attr='details',
                                ctx=Load())])])),
                    Assign(
                      targets=[
                        Subscript(
                          value=Name(id='report', ctx=Load()),
                          slice=Constant(value='overall_status'),
                          ctx=Store())],
                      value=Constant(value='NON_COMPLIANT'))])]),
            Return(
              value=Name(id='report', ctx=Load()))],
          returns=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='Any', ctx=Load())],
              ctx=Load()),
            ctx=Load())),
        FunctionDef(
          name='save_compliance_report',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='output_path',
                annotation=Subscript(
                  value=Name(id='Optional', ctx=Load()),
                  slice=Name(id='Path', ctx=Load()),
                  ctx=Load()))],
            defaults=[
              Constant(value=None)]),
          body=[
            Expr(
              value=Constant(value='\n        Save compliance report to file\n        \n        Args:\n            output_path: Optional custom output path\n            \n        Returns:\n            Path where report was saved\n        ')),
            If(
              test=Compare(
                left=Name(id='output_path', ctx=Load()),
                ops=[
                  Is()],
                comparators=[
                  Constant(value=None)]),
              body=[
                Assign(
                  targets=[
                    Name(id='output_path', ctx=Store())],
                  value=BinOp(
                    left=BinOp(
                      left=Attribute(
                        value=Name(id='self', ctx=Load()),
                        attr='workspace_root',
                        ctx=Load()),
                      op=Div(),
                      right=Constant(value='02_schemas')),
                    op=Div(),
                    right=Constant(value='cross_validation_report.json')))]),
            Expr(
              value=Call(
                func=Attribute(
                  value=Attribute(
                    value=Name(id='output_path', ctx=Load()),
                    attr='parent',
                    ctx=Load()),
                  attr='mkdir',
                  ctx=Load()),
                keywords=[
                  keyword(
                    arg='parents',
                    value=Constant(value=True)),
                  keyword(
                    arg='exist_ok',
                    value=Constant(value=True))])),
            Assign(
              targets=[
                Name(id='report', ctx=Store())],
              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='generate_compliance_report',
                  ctx=Load()))),
            With(
              items=[
