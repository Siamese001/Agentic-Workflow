        FunctionDef(
          name='validate_category',
          args=arguments(
            args=[
              arg(arg='self'),
              arg(
                arg='category',
                annotation=Name(id='str', ctx=Load())),
              arg(
                arg='yaml_extractor',
                annotation=Name(id='callable', ctx=Load())),
              arg(
                arg='meta_extractor',
                annotation=Name(id='callable', ctx=Load()))]),
          body=[
            Expr(
              value=Constant(value='\n        Validate a specific category between YAML and META\n        \n        Args:\n            category: Category name for reporting\n            yaml_extractor: Function to extract items from YAML\n            meta_extractor: Function to extract items from META\n            \n        Returns:\n            ValidationResult with analysis\n        ')),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='self', ctx=Load()),
                  attr='load_yaml_files',
                  ctx=Load()))),
            Assign(
              targets=[
                Name(id='yaml_items', ctx=Store())],
              value=Call(
                func=Name(id='yaml_extractor', ctx=Load()))),
            Assign(
              targets=[
                Name(id='meta_items', ctx=Store())],
              value=Call(
                func=Name(id='meta_extractor', ctx=Load()))),
            If(
              test=Compare(
                left=Name(id='yaml_items', ctx=Load()),
                ops=[
                  Eq()],
                comparators=[
                  Name(id='meta_items', ctx=Load())]),
              body=[
                Assign(
                  targets=[
                    Name(id='status', ctx=Store())],
                  value=Attribute(
                    value=Name(id='ValidationStatus', ctx=Load()),
                    attr='MATCH',
                    ctx=Load())),
                Assign(
                  targets=[
                    Name(id='details', ctx=Store())],
                  value=JoinedStr(
                    values=[
                      Constant(value='Perfect match: '),
                      FormattedValue(
                        value=Call(
                          func=Name(id='len', ctx=Load()),
                          args=[
                            Name(id='yaml_items', ctx=Load())]),
                        conversion=-1),
                      Constant(value=' items')]))],
              orelse=[
                If(
                  test=Call(
                    func=Attribute(
                      value=Name(id='yaml_items', ctx=Load()),
                      attr='issubset',
                      ctx=Load()),
                    args=[
                      Name(id='meta_items', ctx=Load())]),
                  body=[
                    Assign(
                      targets=[
                        Name(id='status', ctx=Store())],
                      value=Attribute(
                        value=Name(id='ValidationStatus', ctx=Load()),
                        attr='EXTRA_IN_META',
                        ctx=Load())),
                    Assign(
                      targets=[
                        Name(id='extra_in_meta', ctx=Store())],
                      value=BinOp(
                        left=Name(id='meta_items', ctx=Load()),
                        op=Sub(),
                        right=Name(id='yaml_items', ctx=Load()))),
                    Assign(
                      targets=[
                        Name(id='details', ctx=Store())],
                      value=JoinedStr(
                        values=[
                          Constant(value='YAML subset of META. Extra in META: '),
                          FormattedValue(
                            value=Name(id='extra_in_meta', ctx=Load()),
                            conversion=-1)]))],
                  orelse=[
                    If(
                      test=Call(
                        func=Attribute(
                          value=Name(id='meta_items', ctx=Load()),
                          attr='issubset',
                          ctx=Load()),
                        args=[
                          Name(id='yaml_items', ctx=Load())]),
                      body=[
                        Assign(
                          targets=[
                            Name(id='status', ctx=Store())],
                          value=Attribute(
                            value=Name(id='ValidationStatus', ctx=Load()),
                            attr='EXTRA_IN_YAML',
                            ctx=Load())),
                        Assign(
                          targets=[
                            Name(id='extra_in_yaml', ctx=Store())],
                          value=BinOp(
                            left=Name(id='yaml_items', ctx=Load()),
                            op=Sub(),
                            right=Name(id='meta_items', ctx=Load()))),
                        Assign(
                          targets=[
                            Name(id='details', ctx=Store())],
                          value=JoinedStr(
                            values=[
                              Constant(value='META subset of YAML. Extra in YAML: '),
                              FormattedValue(
                                value=Name(id='extra_in_yaml', ctx=Load()),
                                conversion=-1)]))],
                      orelse=[
                        Assign(
                          targets=[
                            Name(id='status', ctx=Store())],
                          value=Attribute(
                            value=Name(id='ValidationStatus', ctx=Load()),
                            attr='MISMATCH',
                            ctx=Load())),
                        Assign(
                          targets=[
                            Name(id='missing_in_yaml', ctx=Store())],
                          value=BinOp(
                            left=Name(id='meta_items', ctx=Load()),
                            op=Sub(),
                            right=Name(id='yaml_items', ctx=Load()))),
                        Assign(
                          targets=[
                            Name(id='missing_in_meta', ctx=Store())],
                          value=BinOp(
                            left=Name(id='yaml_items', ctx=Load()),
                            op=Sub(),
                            right=Name(id='meta_items', ctx=Load()))),
                        Assign(
                          targets=[
                            Name(id='details', ctx=Store())],
                          value=JoinedStr(
                            values=[
                              Constant(value='Mismatch. Missing in YAML: '),
                              FormattedValue(
                                value=Name(id='missing_in_yaml', ctx=Load()),
                                conversion=-1),
                              Constant(value=', Missing in META: '),
                              FormattedValue(
                                value=Name(id='missing_in_meta', ctx=Load()),
                                conversion=-1)]))])])]),
            Return(
              value=Call(
                func=Name(id='ValidationResult', ctx=Load()),
                keywords=[
                  keyword(
                    arg='category',
                    value=Name(id='category', ctx=Load())),
                  keyword(
                    arg='status',
                    value=Name(id='status', ctx=Load())),
                  keyword(
                    arg='yaml_items',
                    value=Name(id='yaml_items', ctx=Load())),
                  keyword(
                    arg='meta_items',
                    value=Name(id='meta_items', ctx=Load())),
                  keyword(
                    arg='details',
                    value=Name(id='details', ctx=Load()))]))],
          returns=Name(id='ValidationResult', ctx=Load())),
        FunctionDef(
