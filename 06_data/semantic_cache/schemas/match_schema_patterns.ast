Module(
  body=[
    Expr(
      value=Constant(value='\nSchema definitions for schema pattern matching and recognition.\nContains only type definitions and data models - no execution logic.\n')),
    ImportFrom(
      module='dataclasses',
      names=[
        alias(name='dataclass')],
      level=0),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Dict'),
        alias(name='Any'),
        alias(name='List'),
        alias(name='Tuple')],
      level=0),
    ImportFrom(
      module='enum',
      names=[
        alias(name='Enum')],
      level=0),
    ClassDef(
      name='PatternType',
      bases=[
        Name(id='Enum', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Schema pattern types.')),
        Assign(
          targets=[
            Name(id='STRUCTURAL', ctx=Store())],
          value=Constant(value='structural')),
        Assign(
          targets=[
            Name(id='BEHAVIORAL', ctx=Store())],
          value=Constant(value='behavioral')),
        Assign(
          targets=[
            Name(id='SEMANTIC', ctx=Store())],
          value=Constant(value='semantic')),
        Assign(
          targets=[
            Name(id='TEMPORAL', ctx=Store())],
          value=Constant(value='temporal'))]),
    ClassDef(
      name='MatchingStrategy',
      bases=[
        Name(id='Enum', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Pattern matching strategies.')),
        Assign(
          targets=[
            Name(id='EXACT', ctx=Store())],
          value=Constant(value='exact')),
        Assign(
          targets=[
            Name(id='FUZZY', ctx=Store())],
          value=Constant(value='fuzzy')),
        Assign(
          targets=[
            Name(id='PARTIAL', ctx=Store())],
          value=Constant(value='partial')),
        Assign(
          targets=[
            Name(id='APPROXIMATE', ctx=Store())],
          value=Constant(value='approximate'))]),
    ClassDef(
      name='SchemaPattern',
      body=[
        Expr(
          value=Constant(value='Schema for individual schema pattern.')),
        AnnAssign(
          target=Name(id='pattern_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='pattern_type', ctx=Store()),
          annotation=Name(id='PatternType', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='pattern_definition', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='Any', ctx=Load())],
              ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='matching_criteria', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='Any', ctx=Load())],
              ctx=Load()),
            ctx=Load()),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='PatternMatching',
      body=[
        Expr(
          value=Constant(value='Schema for pattern matching context.')),
        AnnAssign(
          target=Name(id='matching_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='target_schema_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='patterns_to_match', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='SchemaPattern', ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='matching_strategy', ctx=Store()),
          annotation=Name(id='MatchingStrategy', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='matching_timestamp', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='PatternMatchingResult',
      body=[
        Expr(
          value=Constant(value='Schema for pattern matching results.')),
        AnnAssign(
          target=Name(id='result_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='matching', ctx=Store()),
          annotation=Name(id='PatternMatching', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='matched_patterns', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Subscript(
              value=Name(id='Dict', ctx=Load()),
              slice=Tuple(
                elts=[
                  Name(id='str', ctx=Load()),
                  Name(id='Any', ctx=Load())],
                ctx=Load()),
              ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='match_scores', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Subscript(
              value=Name(id='Tuple', ctx=Load()),
              slice=Tuple(
                elts=[
                  Name(id='str', ctx=Load()),
                  Name(id='float', ctx=Load())],
                ctx=Load()),
              ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='matching_successful', ctx=Store()),
          annotation=Name(id='bool', ctx=Load()),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())])])