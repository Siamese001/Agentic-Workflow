Module(
  body=[
    Expr(
      value=Constant(value='\nSchema definitions for schema update consolidation and batching.\nContains only type definitions and data models - no execution logic.\n')),
    ImportFrom(
      module='dataclasses',
      names=[
        alias(name='dataclass')],
      level=0),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Optional'),
        alias(name='Dict'),
        alias(name='Any'),
        alias(name='List')],
      level=0),
    ImportFrom(
      module='enum',
      names=[
        alias(name='Enum')],
      level=0),
    ClassDef(
      name='ConsolidationMode',
      bases=[
        Name(id='Enum', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Update consolidation modes.')),
        Assign(
          targets=[
            Name(id='BATCH', ctx=Store())],
          value=Constant(value='batch')),
        Assign(
          targets=[
            Name(id='INCREMENTAL', ctx=Store())],
          value=Constant(value='incremental')),
        Assign(
          targets=[
            Name(id='PERIODIC', ctx=Store())],
          value=Constant(value='periodic')),
        Assign(
          targets=[
            Name(id='EVENT_DRIVEN', ctx=Store())],
          value=Constant(value='event_driven'))]),
    ClassDef(
      name='UpdatePriority',
      bases=[
        Name(id='Enum', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Update priority levels.')),
        Assign(
          targets=[
            Name(id='CRITICAL', ctx=Store())],
          value=Constant(value='critical')),
        Assign(
          targets=[
            Name(id='HIGH', ctx=Store())],
          value=Constant(value='high')),
        Assign(
          targets=[
            Name(id='MEDIUM', ctx=Store())],
          value=Constant(value='medium')),
        Assign(
          targets=[
            Name(id='LOW', ctx=Store())],
          value=Constant(value='low'))]),
    ClassDef(
      name='SchemaUpdate',
      body=[
        Expr(
          value=Constant(value='Schema for individual schema update.')),
        AnnAssign(
          target=Name(id='update_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='schema_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='update_type', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='update_data', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='Any', ctx=Load())],
              ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='priority', ctx=Store()),
          annotation=Name(id='UpdatePriority', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='timestamp', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='ConsolidationConfig',
      body=[
        Expr(
          value=Constant(value='Schema for consolidation configuration.')),
        AnnAssign(
          target=Name(id='mode', ctx=Store()),
          annotation=Name(id='ConsolidationMode', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='batch_size', ctx=Store()),
          annotation=Name(id='int', ctx=Load()),
          value=Constant(value=100),
          simple=1),
        AnnAssign(
          target=Name(id='timeout_seconds', ctx=Store()),
          annotation=Name(id='int', ctx=Load()),
          value=Constant(value=300),
          simple=1),
        AnnAssign(
          target=Name(id='priority_filter', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Optional', ctx=Load()),
            slice=Subscript(
              value=Name(id='List', ctx=Load()),
              slice=Name(id='UpdatePriority', ctx=Load()),
              ctx=Load()),
            ctx=Load()),
          value=Constant(value=None),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='ConsolidatedUpdates',
      body=[
        Expr(
          value=Constant(value='Schema for consolidated update batch.')),
        AnnAssign(
          target=Name(id='batch_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='updates', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
