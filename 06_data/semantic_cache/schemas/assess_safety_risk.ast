Module(
  body=[
    Expr(
      value=Constant(value='\nSchema definitions for safety risk assessment and evaluation.\nContains only type definitions and data models - no execution logic.\n')),
    ImportFrom(
      module='dataclasses',
      names=[
        alias(name='dataclass')],
      level=0),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Dict'),
        alias(name='Any'),
        alias(name='List')],
      level=0),
    ImportFrom(
      module='enum',
      names=[
        alias(name='Enum')],
      level=0),
    ClassDef(
      name='RiskCategory',
      bases=[
        Name(id='Enum', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Safety risk assessment categories.')),
        Assign(
          targets=[
            Name(id='SECURITY', ctx=Store())],
          value=Constant(value='security')),
        Assign(
          targets=[
            Name(id='PRIVACY', ctx=Store())],
          value=Constant(value='privacy')),
        Assign(
          targets=[
            Name(id='PERFORMANCE', ctx=Store())],
          value=Constant(value='performance')),
        Assign(
          targets=[
            Name(id='COMPLIANCE', ctx=Store())],
          value=Constant(value='compliance'))]),
    ClassDef(
      name='RiskLevel',
      bases=[
        Name(id='Enum', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Risk severity levels.')),
        Assign(
          targets=[
            Name(id='CRITICAL', ctx=Store())],
          value=Constant(value='critical')),
        Assign(
          targets=[
            Name(id='HIGH', ctx=Store())],
          value=Constant(value='high')),
        Assign(
          targets=[
            Name(id='MEDIUM', ctx=Store())],
          value=Constant(value='medium')),
        Assign(
          targets=[
            Name(id='LOW', ctx=Store())],
          value=Constant(value='low'))]),
    ClassDef(
      name='RiskFactor',
      body=[
        Expr(
          value=Constant(value='Schema for individual risk factor.')),
        AnnAssign(
          target=Name(id='factor_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='category', ctx=Store()),
          annotation=Name(id='RiskCategory', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='description', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='impact_score', ctx=Store()),
          annotation=Name(id='float', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='likelihood_score', ctx=Store()),
          annotation=Name(id='float', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='mitigation_suggestions', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load()),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='RiskAssessment',
      body=[
        Expr(
          value=Constant(value='Schema for risk assessment context.')),
        AnnAssign(
          target=Name(id='assessment_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='target_schema_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='risk_factors', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='RiskFactor', ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='assessment_timestamp', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='assessment_context', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='Any', ctx=Load())],
              ctx=Load()),
            ctx=Load()),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='RiskAssessmentResult',
      body=[
        Expr(
          value=Constant(value='Schema for risk assessment results.')),
        AnnAssign(
          target=Name(id='result_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='assessment', ctx=Store()),
          annotation=Name(id='RiskAssessment', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='overall_risk_level', ctx=Store()),
          annotation=Name(id='RiskLevel', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='risk_score', ctx=Store()),
          annotation=Name(id='float', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='priority_actions', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load()),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())])])