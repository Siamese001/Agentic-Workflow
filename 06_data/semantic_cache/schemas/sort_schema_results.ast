          value=Constant(value='relevance')),
        Assign(
          targets=[
            Name(id='CONFIDENCE', ctx=Store())],
          value=Constant(value='confidence')),
        Assign(
          targets=[
            Name(id='ALPHABETICAL', ctx=Store())],
          value=Constant(value='alphabetical'))]),
    ClassDef(
      name='SortConfiguration',
      body=[
        Expr(
          value=Constant(value='Schema for sorting configuration.')),
        AnnAssign(
          target=Name(id='primary_criterion', ctx=Store()),
          annotation=Name(id='SortCriterion', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='primary_order', ctx=Store()),
          annotation=Name(id='SortOrder', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='secondary_criteria', ctx=Store()),
          annotation=Subscript(
