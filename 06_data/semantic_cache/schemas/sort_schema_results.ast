              slice=Subscript(
                value=Name(id='Tuple', ctx=Load()),
                slice=Tuple(
                  elts=[
                    Name(id='SortCriterion', ctx=Load()),
                    Name(id='SortOrder', ctx=Load())],
                  ctx=Load()),
                ctx=Load()),
              ctx=Load()),
            ctx=Load()),
          value=Constant(value=None),
          simple=1),
        AnnAssign(
          target=Name(id='stable_sort', ctx=Store()),
          annotation=Name(id='bool', ctx=Load()),
          value=Constant(value=True),
          simple=1),
        AnnAssign(
          target=Name(id='null_handling', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          value=Constant(value='last'),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='SortedResult',
      body=[
        Expr(
          value=Constant(value='Schema for individual sorted result.')),
        AnnAssign(
