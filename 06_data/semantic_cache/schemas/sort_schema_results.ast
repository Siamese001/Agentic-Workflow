        Expr(
          value=Constant(value='Result sorting orders.')),
        Assign(
          targets=[
            Name(id='ASCENDING', ctx=Store())],
          value=Constant(value='ascending')),
        Assign(
          targets=[
            Name(id='DESCENDING', ctx=Store())],
