Module(
  body=[
    Expr(
      value=Constant(value='\nSchema definitions for schema API calling and invocation.\nContains only type definitions and data models - no execution logic.\n')),
    ImportFrom(
      module='dataclasses',
      names=[
        alias(name='dataclass')],
      level=0),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Dict'),
        alias(name='Any'),
        alias(name='List')],
      level=0),
    ImportFrom(
      module='enum',
      names=[
        alias(name='Enum')],
      level=0),
    ClassDef(
      name='ApiType',
      bases=[
        Name(id='Enum', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Schema API types.')),
        Assign(
          targets=[
            Name(id='REST', ctx=Store())],
          value=Constant(value='rest')),
        Assign(
          targets=[
            Name(id='GRAPHQL', ctx=Store())],
          value=Constant(value='graphql')),
        Assign(
          targets=[
            Name(id='GRPC', ctx=Store())],
          value=Constant(value='grpc')),
        Assign(
          targets=[
            Name(id='WEBSOCKET', ctx=Store())],
          value=Constant(value='websocket'))]),
    ClassDef(
      name='CallMode',
      bases=[
        Name(id='Enum', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='API call modes.')),
        Assign(
          targets=[
            Name(id='SYNCHRONOUS', ctx=Store())],
          value=Constant(value='synchronous')),
        Assign(
          targets=[
            Name(id='ASYNCHRONOUS', ctx=Store())],
          value=Constant(value='asynchronous')),
        Assign(
          targets=[
            Name(id='STREAMING', ctx=Store())],
          value=Constant(value='streaming')),
        Assign(
          targets=[
            Name(id='BATCH', ctx=Store())],
          value=Constant(value='batch'))]),
    ClassDef(
      name='ApiCall',
      body=[
        Expr(
          value=Constant(value='Schema for individual API call.')),
        AnnAssign(
          target=Name(id='call_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='api_type', ctx=Store()),
          annotation=Name(id='ApiType', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='endpoint', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='method', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='parameters', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='Any', ctx=Load())],
              ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='call_mode', ctx=Store()),
          annotation=Name(id='CallMode', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='timeout_ms', ctx=Store()),
          annotation=Name(id='int', ctx=Load()),
          value=Constant(value=30000),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='ApiCallContext',
      body=[
        Expr(
          value=Constant(value='Schema for API call context.')),
        AnnAssign(
          target=Name(id='context_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='target_schema_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='api_calls', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='ApiCall', ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='call_environment', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='Any', ctx=Load())],
              ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='call_timestamp', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='ApiCallResult',
      body=[
        Expr(
          value=Constant(value='Schema for API call results.')),
        AnnAssign(
          target=Name(id='result_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='context', ctx=Store()),
          annotation=Name(id='ApiCallContext', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='call_successful', ctx=Store()),
          annotation=Name(id='bool', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='responses', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Subscript(
              value=Name(id='Dict', ctx=Load()),
              slice=Tuple(
                elts=[
                  Name(id='str', ctx=Load()),
                  Name(id='Any', ctx=Load())],
                ctx=Load()),
              ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='call_time_ms', ctx=Store()),
          annotation=Name(id='int', ctx=Load()),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())])])