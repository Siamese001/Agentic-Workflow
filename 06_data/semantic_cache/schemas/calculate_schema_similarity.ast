Module(
  body=[
    Expr(
      value=Constant(value='\nSchema definitions for schema similarity calculation and comparison.\nContains only type definitions and data models - no execution logic.\n')),
    ImportFrom(
      module='dataclasses',
      names=[
        alias(name='dataclass')],
      level=0),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Dict'),
        alias(name='Any'),
        alias(name='List')],
      level=0),
    ImportFrom(
      module='enum',
      names=[
        alias(name='Enum')],
      level=0),
    ClassDef(
      name='SimilarityMetric',
      bases=[
        Name(id='Enum', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Similarity calculation metrics.')),
        Assign(
          targets=[
            Name(id='COSINE', ctx=Store())],
          value=Constant(value='cosine')),
        Assign(
          targets=[
            Name(id='EUCLIDEAN', ctx=Store())],
          value=Constant(value='euclidean')),
        Assign(
          targets=[
            Name(id='MANHATTAN', ctx=Store())],
          value=Constant(value='manhattan')),
        Assign(
          targets=[
            Name(id='PEARSON', ctx=Store())],
          value=Constant(value='pearson')),
        Assign(
          targets=[
            Name(id='JACCARD', ctx=Store())],
          value=Constant(value='jaccard'))]),
    ClassDef(
      name='ComparisonScope',
      bases=[
        Name(id='Enum', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Scope of schema comparison.')),
        Assign(
          targets=[
            Name(id='STRUCTURAL', ctx=Store())],
          value=Constant(value='structural')),
        Assign(
          targets=[
            Name(id='SEMANTIC', ctx=Store())],
          value=Constant(value='semantic')),
        Assign(
          targets=[
            Name(id='HYBRID', ctx=Store())],
          value=Constant(value='hybrid')),
        Assign(
          targets=[
            Name(id='ATTRIBUTE_LEVEL', ctx=Store())],
          value=Constant(value='attribute_level'))]),
    ClassDef(
      name='SimilarityConfiguration',
      body=[
        Expr(
          value=Constant(value='Schema for similarity calculation configuration.')),
        AnnAssign(
          target=Name(id='metric', ctx=Store()),
          annotation=Name(id='SimilarityMetric', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='scope', ctx=Store()),
          annotation=Name(id='ComparisonScope', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='weight_semantic', ctx=Store()),
          annotation=Name(id='float', ctx=Load()),
          value=Constant(value=0.5),
          simple=1),
        AnnAssign(
          target=Name(id='weight_structural', ctx=Store()),
          annotation=Name(id='float', ctx=Load()),
          value=Constant(value=0.5),
          simple=1),
        AnnAssign(
          target=Name(id='threshold', ctx=Store()),
          annotation=Name(id='float', ctx=Load()),
          value=Constant(value=0.8),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='SchemaComparison',
      body=[
        Expr(
          value=Constant(value='Schema for individual schema comparison.')),
        AnnAssign(
          target=Name(id='schema_a_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='schema_b_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='similarity_score', ctx=Store()),
          annotation=Name(id='float', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='comparison_details', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='Any', ctx=Load())],
              ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='comparison_timestamp', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='SimilarityMatrix',
      body=[
        Expr(
          value=Constant(value='Schema for similarity matrix results.')),
        AnnAssign(
          target=Name(id='matrix_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='schema_ids', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='similarity_scores', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Subscript(
              value=Name(id='List', ctx=Load()),
              slice=Name(id='float', ctx=Load()),
              ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='configuration', ctx=Store()),
          annotation=Name(id='SimilarityConfiguration', ctx=Load()),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())])])