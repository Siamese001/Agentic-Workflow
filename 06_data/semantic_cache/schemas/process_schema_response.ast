Module(
  body=[
    Expr(
      value=Constant(value='\nSchema definitions for schema response processing and handling.\nContains only type definitions and data models - no execution logic.\n')),
    ImportFrom(
      module='dataclasses',
      names=[
        alias(name='dataclass')],
      level=0),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Optional'),
        alias(name='Dict'),
        alias(name='Any'),
        alias(name='List')],
      level=0),
    ImportFrom(
      module='enum',
      names=[
        alias(name='Enum')],
      level=0),
    ClassDef(
      name='ResponseType',
      bases=[
        Name(id='Enum', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Types of schema responses.')),
        Assign(
          targets=[
            Name(id='SUCCESS', ctx=Store())],
          value=Constant(value='success')),
        Assign(
          targets=[
            Name(id='ERROR', ctx=Store())],
          value=Constant(value='error')),
        Assign(
          targets=[
            Name(id='PARTIAL', ctx=Store())],
          value=Constant(value='partial')),
        Assign(
          targets=[
            Name(id='TIMEOUT', ctx=Store())],
          value=Constant(value='timeout'))]),
    ClassDef(
      name='ProcessingAction',
      bases=[
        Name(id='Enum', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Response processing actions.')),
        Assign(
          targets=[
            Name(id='STORE', ctx=Store())],
          value=Constant(value='store')),
        Assign(
          targets=[
            Name(id='FORWARD', ctx=Store())],
          value=Constant(value='forward')),
        Assign(
          targets=[
            Name(id='TRANSFORM', ctx=Store())],
          value=Constant(value='transform')),
        Assign(
          targets=[
            Name(id='AGGREGATE', ctx=Store())],
          value=Constant(value='aggregate'))]),
    ClassDef(
      name='ResponseMetadata',
      body=[
        Expr(
          value=Constant(value='Schema for response metadata.')),
        AnnAssign(
          target=Name(id='response_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='source_service', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='timestamp', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='processing_time_ms', ctx=Store()),
          annotation=Name(id='int', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='size_bytes', ctx=Store()),
          annotation=Name(id='int', ctx=Load()),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='ProcessingConfiguration',
      body=[
        Expr(
          value=Constant(value='Schema for response processing configuration.')),
        AnnAssign(
          target=Name(id='default_action', ctx=Store()),
          annotation=Name(id='ProcessingAction', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='error_handling', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          value=Constant(value='retry'),
          simple=1),
        AnnAssign(
          target=Name(id='max_retries', ctx=Store()),
          annotation=Name(id='int', ctx=Load()),
          value=Constant(value=3),
          simple=1),
        AnnAssign(
          target=Name(id='timeout_ms', ctx=Store()),
          annotation=Name(id='int', ctx=Load()),
          value=Constant(value=10000),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='ProcessedResponse',
      body=[
        AnnAssign(
          target=Name(id='original_response', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='Any', ctx=Load())],
              ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='processing_actions', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='ProcessingAction', ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='metadata', ctx=Store()),
          annotation=Name(id='ResponseMetadata', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='processing_timestamp', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='processed_data', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Optional', ctx=Load()),
            slice=Subscript(
              value=Name(id='Dict', ctx=Load()),
              slice=Tuple(
                elts=[
                  Name(id='str', ctx=Load()),
                  Name(id='Any', ctx=Load())],
                ctx=Load()),
              ctx=Load()),
            ctx=Load()),
          value=Constant(value=None),
          simple=1),
        Expr(
          value=Constant(value='Schema for processed response data.'))],
      decorator_list=[
        Name(id='dataclass', ctx=Load())])])