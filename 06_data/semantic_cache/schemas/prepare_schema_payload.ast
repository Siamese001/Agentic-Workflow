        Expr(
          value=Constant(value='Payload compression types.')),
        Assign(
          targets=[
            Name(id='NONE', ctx=Store())],
          value=Constant(value='none')),
        Assign(
          targets=[
            Name(id='GZIP', ctx=Store())],
          value=Constant(value='gzip')),
        Assign(
          targets=[
            Name(id='ZSTD', ctx=Store())],
          value=Constant(value='zstd')),
        Assign(
          targets=[
            Name(id='LZ4', ctx=Store())],
          value=Constant(value='lz4'))]),
    ClassDef(
      name='SchemaPayload',
      body=[
        Expr(
          value=Constant(value='Schema for prepared schema payload.')),
        AnnAssign(
          target=Name(id='payload_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='format', ctx=Store()),
          annotation=Name(id='PayloadFormat', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='compression', ctx=Store()),
          annotation=Name(id='CompressionType', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='size_bytes', ctx=Store()),
          annotation=Name(id='int', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='checksum', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='metadata', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Optional', ctx=Load()),
            slice=Subscript(
              value=Name(id='Dict', ctx=Load()),
              slice=Tuple(
                elts=[
                  Name(id='str', ctx=Load()),
                  Name(id='str', ctx=Load())],
                ctx=Load()),
              ctx=Load()),
            ctx=Load()),
          value=Constant(value=None),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='PayloadConfiguration',
      body=[
        Expr(
          value=Constant(value='Schema for payload preparation configuration.')),
        AnnAssign(
          target=Name(id='target_format', ctx=Store()),
          annotation=Name(id='PayloadFormat', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='compression', ctx=Store()),
          annotation=Name(id='CompressionType', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='include_metadata', ctx=Store()),
          annotation=Name(id='bool', ctx=Load()),
          value=Constant(value=True),
          simple=1),
        AnnAssign(
          target=Name(id='validate_integrity', ctx=Store()),
          annotation=Name(id='bool', ctx=Load()),
          value=Constant(value=True),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='PreparedPayload',
