Module(
  body=[
    Expr(
      value=Constant(value='\nSchema definitions for schema payload preparation and formatting.\nContains only type definitions and data models - no execution logic.\n')),
    ImportFrom(
      module='dataclasses',
      names=[
        alias(name='dataclass')],
      level=0),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Optional'),
        alias(name='Dict')],
      level=0),
    ImportFrom(
      module='enum',
      names=[
        alias(name='Enum')],
      level=0),
    ClassDef(
      name='PayloadFormat',
      bases=[
        Name(id='Enum', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Supported payload formats.')),
        Assign(
          targets=[
            Name(id='JSON', ctx=Store())],
          value=Constant(value='json')),
        Assign(
          targets=[
            Name(id='YAML', ctx=Store())],
          value=Constant(value='yaml')),
        Assign(
          targets=[
            Name(id='XML', ctx=Store())],
          value=Constant(value='xml')),
        Assign(
