Module(
  body=[
    Expr(
      value=Constant(value='\nSchema definitions for orchestration-level schema planning.\nContains only type definitions and data models - no execution logic.\n')),
    ImportFrom(
      module='dataclasses',
      names=[
        alias(name='dataclass')],
      level=0),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Optional'),
        alias(name='Dict'),
        alias(name='Any'),
        alias(name='List')],
      level=0),
    ImportFrom(
      module='enum',
      names=[
        alias(name='Enum')],
      level=0),
    ClassDef(
      name='OrchestrationMode',
      bases=[
        Name(id='Enum', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Orchestration execution modes.')),
        Assign(
          targets=[
            Name(id='SEQUENTIAL', ctx=Store())],
          value=Constant(value='sequential')),
        Assign(
          targets=[
            Name(id='PARALLEL', ctx=Store())],
          value=Constant(value='parallel')),
        Assign(
          targets=[
            Name(id='PIPELINED', ctx=Store())],
          value=Constant(value='pipelined')),
        Assign(
          targets=[
            Name(id='CONDITIONAL', ctx=Store())],
          value=Constant(value='conditional'))]),
    ClassDef(
      name='ResourceType',
      bases=[
        Name(id='Enum', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Resource types for orchestration.')),
        Assign(
          targets=[
            Name(id='CPU', ctx=Store())],
          value=Constant(value='cpu')),
        Assign(
          targets=[
            Name(id='MEMORY', ctx=Store())],
          value=Constant(value='memory')),
        Assign(
          targets=[
            Name(id='STORAGE', ctx=Store())],
          value=Constant(value='storage')),
        Assign(
          targets=[
            Name(id='NETWORK', ctx=Store())],
          value=Constant(value='network'))]),
    ClassDef(
      name='OrchestrationStep',
      body=[
        Expr(
          value=Constant(value='Schema for individual orchestration step.')),
        AnnAssign(
          target=Name(id='step_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='step_type', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='dependencies', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='resources_required', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='ResourceType', ctx=Load()),
                Name(id='int', ctx=Load())],
              ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='timeout_seconds', ctx=Store()),
          annotation=Name(id='int', ctx=Load()),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='OrchestrationPlan',
      body=[
        Expr(
          value=Constant(value='Schema for complete orchestration plan.')),
        AnnAssign(
          target=Name(id='plan_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='mode', ctx=Store()),
          annotation=Name(id='OrchestrationMode', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='steps', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='OrchestrationStep', ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='total_resources', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='ResourceType', ctx=Load()),
                Name(id='int', ctx=Load())],
              ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='estimated_duration_seconds', ctx=Store()),
          annotation=Name(id='int', ctx=Load()),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='OrchestrationRequest',
      body=[
        Expr(
          value=Constant(value='Schema for orchestration planning request.')),
        AnnAssign(
          target=Name(id='schema_ids', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
