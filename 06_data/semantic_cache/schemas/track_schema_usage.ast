Module(
  body=[
    Expr(
      value=Constant(value='\nSchema definitions for schema usage tracking and monitoring.\nContains only type definitions and data models - no execution logic.\n')),
    ImportFrom(
      module='dataclasses',
      names=[
        alias(name='dataclass')],
      level=0),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Dict'),
        alias(name='List'),
        alias(name='Union')],
      level=0),
    ImportFrom(
      module='enum',
      names=[
        alias(name='Enum')],
      level=0),
    ClassDef(
      name='UsageType',
      bases=[
        Name(id='Enum', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Schema usage tracking types.')),
        Assign(
          targets=[
            Name(id='CPU', ctx=Store())],
          value=Constant(value='cpu')),
        Assign(
          targets=[
            Name(id='MEMORY', ctx=Store())],
          value=Constant(value='memory')),
        Assign(
          targets=[
            Name(id='NETWORK', ctx=Store())],
          value=Constant(value='network')),
        Assign(
          targets=[
            Name(id='STORAGE', ctx=Store())],
          value=Constant(value='storage')),
        Assign(
          targets=[
            Name(id='API_CALLS', ctx=Store())],
          value=Constant(value='api_calls'))]),
    ClassDef(
      name='TrackingFrequency',
      bases=[
        Name(id='Enum', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Usage tracking frequency.')),
        Assign(
          targets=[
            Name(id='REAL_TIME', ctx=Store())],
          value=Constant(value='real_time')),
        Assign(
          targets=[
            Name(id='PER_MINUTE', ctx=Store())],
          value=Constant(value='per_minute')),
        Assign(
          targets=[
            Name(id='PER_HOUR', ctx=Store())],
          value=Constant(value='per_hour')),
        Assign(
          targets=[
            Name(id='PER_DAY', ctx=Store())],
          value=Constant(value='per_day'))]),
    ClassDef(
      name='UsageMetric',
      body=[
        Expr(
          value=Constant(value='Schema for individual usage metric.')),
        AnnAssign(
          target=Name(id='metric_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='usage_type', ctx=Store()),
          annotation=Name(id='UsageType', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='value', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Union', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='int', ctx=Load()),
                Name(id='float', ctx=Load())],
              ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='unit', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='timestamp', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='schema_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='UsageTracking',
      body=[
        Expr(
          value=Constant(value='Schema for usage tracking configuration.')),
        AnnAssign(
          target=Name(id='tracking_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='target_schema_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='tracking_frequency', ctx=Store()),
          annotation=Name(id='TrackingFrequency', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='metrics_tracked', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='UsageType', ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='retention_days', ctx=Store()),
          annotation=Name(id='int', ctx=Load()),
          value=Constant(value=30),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='UsageTrackingResult',
      body=[
        Expr(
          value=Constant(value='Schema for usage tracking results.')),
        AnnAssign(
          target=Name(id='result_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='tracking', ctx=Store()),
          annotation=Name(id='UsageTracking', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='metrics_collected', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='UsageMetric', ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='total_usage', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='UsageType', ctx=Load()),
                Subscript(
                  value=Name(id='Union', ctx=Load()),
                  slice=Tuple(
                    elts=[
                      Name(id='int', ctx=Load()),
                      Name(id='float', ctx=Load())],
                    ctx=Load()),
                  ctx=Load())],
              ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='tracking_period', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
