Module(
  body=[
    Expr(
      value=Constant(value='\nSchema definitions for schema contract enforcement and management.\nContains only type definitions and data models - no execution logic.\n')),
    ImportFrom(
      module='dataclasses',
      names=[
        alias(name='dataclass')],
      level=0),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Optional'),
        alias(name='Dict'),
        alias(name='Any'),
        alias(name='List')],
      level=0),
    ImportFrom(
      module='enum',
      names=[
        alias(name='Enum')],
      level=0),
    ClassDef(
      name='ContractType',
      bases=[
        Name(id='Enum', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Types of schema contracts.')),
        Assign(
          targets=[
            Name(id='INTERFACE', ctx=Store())],
          value=Constant(value='interface')),
        Assign(
          targets=[
            Name(id='DATA', ctx=Store())],
          value=Constant(value='data')),
        Assign(
          targets=[
            Name(id='SERVICE', ctx=Store())],
          value=Constant(value='service')),
        Assign(
          targets=[
            Name(id='BEHAVIORAL', ctx=Store())],
          value=Constant(value='behavioral'))]),
    ClassDef(
      name='EnforcementLevel',
      bases=[
        Name(id='Enum', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Contract enforcement levels.')),
        Assign(
          targets=[
            Name(id='STRICT', ctx=Store())],
          value=Constant(value='strict')),
        Assign(
          targets=[
            Name(id='LENIENT', ctx=Store())],
          value=Constant(value='lenient')),
        Assign(
          targets=[
            Name(id='WARNING_ONLY', ctx=Store())],
          value=Constant(value='warning_only')),
        Assign(
          targets=[
            Name(id='LOG_ONLY', ctx=Store())],
          value=Constant(value='log_only'))]),
    ClassDef(
      name='SchemaContract',
      body=[
        Expr(
          value=Constant(value='Schema for individual schema contract.')),
        AnnAssign(
          target=Name(id='contract_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='contract_type', ctx=Store()),
          annotation=Name(id='ContractType', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='parties_involved', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='terms', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='Any', ctx=Load())],
              ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='enforcement_level', ctx=Store()),
          annotation=Name(id='EnforcementLevel', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='expiration_date', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Optional', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load()),
          value=Constant(value=None),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='ContractViolation',
      body=[
        Expr(
          value=Constant(value='Schema for contract violation details.')),
        AnnAssign(
          target=Name(id='contract_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='violating_schema_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='violation_type', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='severity', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='description', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='timestamp', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='ContractEnforcementResult',
      body=[
        Expr(
          value=Constant(value='Schema for contract enforcement results.')),
        AnnAssign(
          target=Name(id='enforcement_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='contract_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='violations', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='ContractViolation', ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='actions_taken', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='enforcement_timestamp', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())])])