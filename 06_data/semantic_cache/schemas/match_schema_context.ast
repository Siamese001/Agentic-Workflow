Module(
  body=[
    Expr(
      value=Constant(value='\nSchema definitions for schema context matching and alignment.\nContains only type definitions and data models - no execution logic.\n')),
    ImportFrom(
      module='dataclasses',
      names=[
        alias(name='dataclass')],
      level=0),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Dict'),
        alias(name='Any'),
        alias(name='List')],
      level=0),
    ImportFrom(
      module='enum',
      names=[
        alias(name='Enum')],
      level=0),
    ClassDef(
      name='MatchingStrategy',
      bases=[
        Name(id='Enum', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Context matching strategies.')),
        Assign(
          targets=[
            Name(id='EXACT_MATCH', ctx=Store())],
          value=Constant(value='exact_match')),
        Assign(
          targets=[
            Name(id='SEMANTIC_MATCH', ctx=Store())],
          value=Constant(value='semantic_match')),
        Assign(
          targets=[
            Name(id='STRUCTURAL_MATCH', ctx=Store())],
          value=Constant(value='structural_match')),
        Assign(
          targets=[
            Name(id='HYBRID_MATCH', ctx=Store())],
          value=Constant(value='hybrid_match'))]),
    ClassDef(
      name='MatchScope',
      bases=[
        Name(id='Enum', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Context matching scopes.')),
        Assign(
          targets=[
            Name(id='FULL_CONTEXT', ctx=Store())],
          value=Constant(value='full_context')),
        Assign(
          targets=[
            Name(id='PARTIAL_CONTEXT', ctx=Store())],
          value=Constant(value='partial_context')),
        Assign(
          targets=[
            Name(id='KEY_ELEMENTS', ctx=Store())],
          value=Constant(value='key_elements')),
        Assign(
          targets=[
            Name(id='RELATIONSHIPS_ONLY', ctx=Store())],
          value=Constant(value='relationships_only'))]),
    ClassDef(
      name='ContextMatchingConfig',
      body=[
        Expr(
          value=Constant(value='Schema for context matching configuration.')),
        AnnAssign(
          target=Name(id='strategy', ctx=Store()),
          annotation=Name(id='MatchingStrategy', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='scope', ctx=Store()),
          annotation=Name(id='MatchScope', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='similarity_threshold', ctx=Store()),
          annotation=Name(id='float', ctx=Load()),
          value=Constant(value=0.7),
          simple=1),
        AnnAssign(
          target=Name(id='include_metadata', ctx=Store()),
          annotation=Name(id='bool', ctx=Load()),
          value=Constant(value=True),
          simple=1),
        AnnAssign(
          target=Name(id='max_matches', ctx=Store()),
          annotation=Name(id='int', ctx=Load()),
          value=Constant(value=5),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='ContextMatch',
      body=[
        Expr(
          value=Constant(value='Schema for individual context match.')),
        AnnAssign(
          target=Name(id='match_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='source_context_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='target_context_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='match_score', ctx=Store()),
          annotation=Name(id='float', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='match_type', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='alignment_details', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='Any', ctx=Load())],
              ctx=Load()),
            ctx=Load()),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='ContextMatchingResult',
      body=[
        Expr(
          value=Constant(value='Schema for context matching results.')),
        AnnAssign(
          target=Name(id='matching_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='configuration', ctx=Store()),
          annotation=Name(id='ContextMatchingConfig', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='matches', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='ContextMatch', ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='processing_time_ms', ctx=Store()),
          annotation=Name(id='int', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='total_contexts_analyzed', ctx=Store()),
          annotation=Name(id='int', ctx=Load()),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())])])