          value=Constant(value=False),
          simple=1),
        AnnAssign(
          target=Name(id='encryption_required', ctx=Store()),
          annotation=Name(id='bool', ctx=Load()),
          value=Constant(value=False),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='ExecutionPayload',
