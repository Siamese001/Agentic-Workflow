      names=[
        alias(name='Dict'),
        alias(name='Any')],
      level=0),
    ImportFrom(
      module='enum',
      names=[
        alias(name='Enum')],
      level=0),
    ClassDef(
      name='PayloadType',
      bases=[
        Name(id='Enum', ctx=Load())],
