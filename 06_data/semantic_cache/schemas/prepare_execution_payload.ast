          value=Constant(value='immediate')),
        Assign(
          targets=[
            Name(id='LAZY', ctx=Store())],
          value=Constant(value='lazy')),
        Assign(
          targets=[
            Name(id='CACHED', ctx=Store())],
          value=Constant(value='cached')),
        Assign(
          targets=[
            Name(id='STREAMING', ctx=Store())],
          value=Constant(value='streaming'))]),
    ClassDef(
