          simple=1),
        AnnAssign(
          target=Name(id='payload_type', ctx=Store()),
          annotation=Name(id='PayloadType', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='content_size_bytes', ctx=Store()),
          annotation=Name(id='int', ctx=Load()),
          simple=1),
        AnnAssign(
