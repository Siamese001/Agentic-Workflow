                      value=Name(id='results', ctx=Load()),
                      slice=Constant(value='added_files'),
                      ctx=Load())]),
                ops=[
                  Gt()],
                comparators=[
                  Constant(value=10)]),
              body=[
                Expr(
                  value=Call(
                    func=Name(id='print', ctx=Load()),
                    args=[
                      JoinedStr(
                        values=[
                          Constant(value='  ... and '),
                          FormattedValue(
                            value=BinOp(
                              left=Call(
                                func=Name(id='len', ctx=Load()),
                                args=[
                                  Subscript(
                                    value=Name(id='results', ctx=Load()),
                                    slice=Constant(value='added_files'),
                                    ctx=Load())]),
                              op=Sub(),
                              right=Constant(value=10)),
                            conversion=-1),
                          Constant(value=' more')])]))])]),
        Assign(
          targets=[
            Name(id='report', ctx=Store())],
          value=Dict(
            keys=[
              Constant(value='timestamp'),
              Constant(value='verification_type'),
              Constant(value='results'),
              Constant(value='sample_missing_files'),
              Constant(value='sample_added_files')],
            values=[
              Constant(value='2025-12-02T20:30:00.000000'),
              Constant(value='zero_loss_analysis'),
              Name(id='results', ctx=Load()),
              Subscript(
                value=Subscript(
                  value=Name(id='results', ctx=Load()),
                  slice=Constant(value='missing_files'),
                  ctx=Load()),
                slice=Slice(
                  upper=Constant(value=20)),
                ctx=Load()),
              Subscript(
                value=Subscript(
                  value=Name(id='results', ctx=Load()),
                  slice=Constant(value='added_files'),
                  ctx=Load()),
                slice=Slice(
                  upper=Constant(value=20)),
                ctx=Load())])),
        With(
          items=[
            withitem(
              context_expr=Call(
                func=Name(id='open', ctx=Load()),
                args=[
                  Constant(value='zero_loss_verification.json'),
                  Constant(value='w')]),
              optional_vars=Name(id='f', ctx=Store()))],
          body=[
            Import(
              names=[
                alias(name='json')]),
            Expr(
              value=Call(
                func=Attribute(
                  value=Name(id='json', ctx=Load()),
                  attr='dump',
                  ctx=Load()),
                args=[
                  Name(id='report', ctx=Load()),
                  Name(id='f', ctx=Load())],
                keywords=[
                  keyword(
                    arg='indent',
                    value=Constant(value=2))]))]),
        Expr(
          value=Call(
            func=Name(id='print', ctx=Load()),
            args=[
              JoinedStr(
                values=[
                  Constant(value='\n✅ Detailed verification saved to: zero_loss_verification.json')])])),
        If(
          test=Compare(
            left=Subscript(
              value=Name(id='results', ctx=Load()),
              slice=Constant(value='zero_loss_status'),
              ctx=Load()),
            ops=[
              Eq()],
            comparators=[
              Constant(value='PASS')]),
          body=[
            Expr(
              value=Call(
                func=Name(id='print', ctx=Load()),
                args=[
                  Constant(value='🎉 ZERO-LOSS VERIFICATION PASSED - All original files preserved')])),
            Return(
