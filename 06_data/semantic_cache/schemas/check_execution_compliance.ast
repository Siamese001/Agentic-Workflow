              ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='mandatory', ctx=Store()),
          annotation=Name(id='bool', ctx=Load()),
          value=Constant(value=True),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
