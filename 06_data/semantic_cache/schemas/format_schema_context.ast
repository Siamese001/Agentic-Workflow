Module(
  body=[
    Expr(
      value=Constant(value='\nSchema definitions for schema context formatting and structuring.\nContains only type definitions and data models - no execution logic.\n')),
    ImportFrom(
      module='dataclasses',
      names=[
        alias(name='dataclass')],
      level=0),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Dict'),
        alias(name='Any')],
      level=0),
    ImportFrom(
      module='enum',
      names=[
        alias(name='Enum')],
      level=0),
    ClassDef(
      name='ContextType',
      bases=[
        Name(id='Enum', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Types of schema contexts.')),
        Assign(
          targets=[
            Name(id='EXECUTION', ctx=Store())],
          value=Constant(value='execution')),
        Assign(
          targets=[
            Name(id='VALIDATION', ctx=Store())],
          value=Constant(value='validation')),
        Assign(
          targets=[
            Name(id='TRANSFORMATION', ctx=Store())],
          value=Constant(value='transformation')),
        Assign(
          targets=[
            Name(id='DOCUMENTATION', ctx=Store())],
          value=Constant(value='documentation'))]),
    ClassDef(
      name='FormattingStyle',
      bases=[
        Name(id='Enum', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Context formatting styles.')),
        Assign(
          targets=[
            Name(id='COMPACT', ctx=Store())],
          value=Constant(value='compact')),
        Assign(
          targets=[
            Name(id='VERBOSE', ctx=Store())],
          value=Constant(value='verbose')),
        Assign(
          targets=[
            Name(id='STRUCTURED', ctx=Store())],
          value=Constant(value='structured')),
        Assign(
          targets=[
            Name(id='FLAT', ctx=Store())],
          value=Constant(value='flat'))]),
    ClassDef(
      name='SchemaContext',
      body=[
        Expr(
          value=Constant(value='Schema for formatted schema context.')),
        AnnAssign(
          target=Name(id='context_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='context_type', ctx=Store()),
          annotation=Name(id='ContextType', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='formatting_style', ctx=Store()),
          annotation=Name(id='FormattingStyle', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='content', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='Any', ctx=Load())],
              ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='hierarchy_level', ctx=Store()),
          annotation=Name(id='int', ctx=Load()),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='ContextFormattingRules',
      body=[
        Expr(
          value=Constant(value='Schema for context formatting rules.')),
        AnnAssign(
          target=Name(id='include_inheritance', ctx=Store()),
          annotation=Name(id='bool', ctx=Load()),
          value=Constant(value=True),
          simple=1),
        AnnAssign(
          target=Name(id='max_depth', ctx=Store()),
          annotation=Name(id='int', ctx=Load()),
          value=Constant(value=10),
          simple=1),
        AnnAssign(
          target=Name(id='sort_keys', ctx=Store()),
          annotation=Name(id='bool', ctx=Load()),
          value=Constant(value=True),
          simple=1),
        AnnAssign(
          target=Name(id='preserve_order', ctx=Store()),
          annotation=Name(id='bool', ctx=Load()),
          value=Constant(value=False),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='FormattedContext',
      body=[
        Expr(
          value=Constant(value='Schema for completely formatted context.')),
        AnnAssign(
          target=Name(id='context', ctx=Store()),
          annotation=Name(id='SchemaContext', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='formatting_rules', ctx=Store()),
          annotation=Name(id='ContextFormattingRules', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='formatted_output', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='Any', ctx=Load())],
              ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='formatting_timestamp', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())])])