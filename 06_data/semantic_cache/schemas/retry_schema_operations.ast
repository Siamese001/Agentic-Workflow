          value=Constant(value='Schema for individual schema retry.')),
        AnnAssign(
          target=Name(id='retry_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='target_operation_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
