      body=[
        Expr(
          value=Constant(value='Retry trigger conditions.')),
        Assign(
          targets=[
            Name(id='TRANSIENT_ERROR', ctx=Store())],
          value=Constant(value='transient_error')),
        Assign(
          targets=[
            Name(id='TIMEOUT', ctx=Store())],
          value=Constant(value='timeout')),
        Assign(
          targets=[
            Name(id='RATE_LIMIT', ctx=Store())],
          value=Constant(value='rate_limit')),
        Assign(
          targets=[
            Name(id='SERVICE_UNAVAILABLE', ctx=Store())],
          value=Constant(value='service_unavailable'))]),
    ClassDef(
      name='RetryConfiguration',
      body=[
        Expr(
          value=Constant(value='Schema for retry configuration.')),
        AnnAssign(
          target=Name(id='config_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='retry_strategy', ctx=Store()),
          annotation=Name(id='RetryStrategy', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='max_attempts', ctx=Store()),
          annotation=Name(id='int', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='base_delay_ms', ctx=Store()),
          annotation=Name(id='int', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='max_delay_ms', ctx=Store()),
          annotation=Name(id='int', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='retry_conditions', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='RetryCondition', ctx=Load()),
            ctx=Load()),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='SchemaRetry',
