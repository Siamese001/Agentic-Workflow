Module(
  body=[
    Expr(
      value=Constant(value='\nSchema definitions for schema operation retry and recovery.\nContains only type definitions and data models - no execution logic.\n')),
    ImportFrom(
      module='dataclasses',
      names=[
        alias(name='dataclass')],
      level=0),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Dict'),
        alias(name='Any'),
        alias(name='List')],
      level=0),
    ImportFrom(
      module='enum',
      names=[
        alias(name='Enum')],
      level=0),
    ClassDef(
      name='RetryStrategy',
      bases=[
        Name(id='Enum', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Schema retry strategies.')),
        Assign(
          targets=[
            Name(id='EXPONENTIAL_BACKOFF', ctx=Store())],
          value=Constant(value='exponential_backoff')),
        Assign(
          targets=[
            Name(id='LINEAR_BACKOFF', ctx=Store())],
          value=Constant(value='linear_backoff')),
        Assign(
          targets=[
            Name(id='FIXED_INTERVAL', ctx=Store())],
          value=Constant(value='fixed_interval')),
        Assign(
          targets=[
            Name(id='ADAPTIVE', ctx=Store())],
          value=Constant(value='adaptive'))]),
    ClassDef(
