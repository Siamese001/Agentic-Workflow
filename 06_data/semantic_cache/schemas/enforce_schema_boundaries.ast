Module(
  body=[
    Expr(
      value=Constant(value='\nSchema definitions for schema boundary enforcement and containment.\nContains only type definitions and data models - no execution logic.\n')),
    ImportFrom(
      module='dataclasses',
      names=[
        alias(name='dataclass')],
      level=0),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Dict'),
        alias(name='Any'),
        alias(name='List')],
      level=0),
    ImportFrom(
      module='enum',
      names=[
        alias(name='Enum')],
      level=0),
    ClassDef(
      name='BoundaryType',
      bases=[
        Name(id='Enum', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Types of schema boundaries.')),
        Assign(
          targets=[
            Name(id='NAMESPACE', ctx=Store())],
          value=Constant(value='namespace')),
        Assign(
          targets=[
            Name(id='ACCESS_LEVEL', ctx=Store())],
          value=Constant(value='access_level')),
        Assign(
          targets=[
            Name(id='DATA_SCOPE', ctx=Store())],
          value=Constant(value='data_scope')),
        Assign(
          targets=[
            Name(id='RESOURCE_LIMIT', ctx=Store())],
          value=Constant(value='resource_limit'))]),
    ClassDef(
      name='EnforcementAction',
      bases=[
        Name(id='Enum', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Boundary enforcement actions.')),
        Assign(
          targets=[
            Name(id='ALLOW', ctx=Store())],
          value=Constant(value='allow')),
        Assign(
          targets=[
            Name(id='BLOCK', ctx=Store())],
          value=Constant(value='block')),
        Assign(
          targets=[
            Name(id='WARN', ctx=Store())],
          value=Constant(value='warn')),
        Assign(
          targets=[
            Name(id='LOG', ctx=Store())],
          value=Constant(value='log')),
        Assign(
          targets=[
            Name(id='ESCALATE', ctx=Store())],
          value=Constant(value='escalate'))]),
    ClassDef(
      name='SchemaBoundary',
      body=[
        Expr(
          value=Constant(value='Schema for individual boundary definition.')),
        AnnAssign(
          target=Name(id='boundary_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='boundary_type', ctx=Store()),
          annotation=Name(id='BoundaryType', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='scope', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='constraints', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='Any', ctx=Load())],
              ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='enforcement_action', ctx=Store()),
          annotation=Name(id='EnforcementAction', ctx=Load()),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='BoundaryViolation',
      body=[
        Expr(
          value=Constant(value='Schema for boundary violation details.')),
        AnnAssign(
          target=Name(id='boundary_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='violator_schema_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='violation_type', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='severity', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='description', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='BoundaryEnforcementResult',
      body=[
        Expr(
          value=Constant(value='Schema for boundary enforcement results.')),
        AnnAssign(
          target=Name(id='enforcement_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='violations', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='BoundaryViolation', ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='actions_taken', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='EnforcementAction', ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='enforcement_timestamp', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())])])