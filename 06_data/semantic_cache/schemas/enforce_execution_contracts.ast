                elts=[
                  Name(id='str', ctx=Load()),
                  Name(id='Any', ctx=Load())],
                ctx=Load()),
              ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='enforcement_level', ctx=Store()),
          annotation=Name(id='EnforcementLevel', ctx=Load()),
          simple=1),
        AnnAssign(
