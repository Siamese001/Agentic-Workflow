Module(
  body=[
    Expr(
      value=Constant(value='\nSchema definitions for schema vector search and similarity operations.\nContains only type definitions and data models - no execution logic.\n')),
    ImportFrom(
      module='dataclasses',
      names=[
        alias(name='dataclass')],
      level=0),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Optional'),
        alias(name='Dict'),
        alias(name='Any'),
        alias(name='List')],
      level=0),
    ImportFrom(
      module='enum',
      names=[
        alias(name='Enum')],
      level=0),
    ClassDef(
      name='SearchMethod',
      bases=[
        Name(id='Enum', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Vector search methods.')),
        Assign(
          targets=[
            Name(id='COSINE_SIMILARITY', ctx=Store())],
          value=Constant(value='cosine_similarity')),
        Assign(
          targets=[
            Name(id='EUCLIDEAN_DISTANCE', ctx=Store())],
          value=Constant(value='euclidean_distance')),
        Assign(
          targets=[
            Name(id='DOT_PRODUCT', ctx=Store())],
          value=Constant(value='dot_product')),
        Assign(
          targets=[
            Name(id='APPROXIMATE_NEAREST', ctx=Store())],
          value=Constant(value='approximate_nearest'))]),
    ClassDef(
      name='SearchScope',
      bases=[
        Name(id='Enum', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Vector search scopes.')),
        Assign(
          targets=[
            Name(id='FULL_VECTOR', ctx=Store())],
          value=Constant(value='full_vector')),
        Assign(
          targets=[
            Name(id='PARTIAL_VECTOR', ctx=Store())],
          value=Constant(value='partial_vector')),
        Assign(
          targets=[
            Name(id='WEIGHTED_VECTOR', ctx=Store())],
          value=Constant(value='weighted_vector')),
        Assign(
          targets=[
            Name(id='SEGMENTED_VECTOR', ctx=Store())],
          value=Constant(value='segmented_vector'))]),
    ClassDef(
      name='VectorSearchQuery',
      body=[
        Expr(
          value=Constant(value='Schema for vector search query.')),
        AnnAssign(
          target=Name(id='query_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='query_vector', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='float', ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='search_method', ctx=Store()),
          annotation=Name(id='SearchMethod', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='search_scope', ctx=Store()),
          annotation=Name(id='SearchScope', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='threshold', ctx=Store()),
          annotation=Name(id='float', ctx=Load()),
          value=Constant(value=0.8),
          simple=1),
        AnnAssign(
          target=Name(id='max_results', ctx=Store()),
          annotation=Name(id='int', ctx=Load()),
          value=Constant(value=10),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='VectorSearchResult',
      body=[
        Expr(
          value=Constant(value='Schema for individual vector search result.')),
        AnnAssign(
          target=Name(id='result_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='schema_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='similarity_score', ctx=Store()),
          annotation=Name(id='float', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='distance', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Optional', ctx=Load()),
            slice=Name(id='float', ctx=Load()),
            ctx=Load()),
          value=Constant(value=None),
          simple=1),
        AnnAssign(
          target=Name(id='metadata', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Optional', ctx=Load()),
            slice=Subscript(
              value=Name(id='Dict', ctx=Load()),
              slice=Tuple(
                elts=[
                  Name(id='str', ctx=Load()),
                  Name(id='Any', ctx=Load())],
                ctx=Load()),
              ctx=Load()),
            ctx=Load()),
          value=Constant(value=None),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='VectorSearchResponse',
      body=[
        Expr(
          value=Constant(value='Schema for complete vector search response.')),
        AnnAssign(
          target=Name(id='search_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='query', ctx=Store()),
          annotation=Name(id='VectorSearchQuery', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='results', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='VectorSearchResult', ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='search_time_ms', ctx=Store()),
          annotation=Name(id='int', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='total_candidates', ctx=Store()),
          annotation=Name(id='int', ctx=Load()),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())])])