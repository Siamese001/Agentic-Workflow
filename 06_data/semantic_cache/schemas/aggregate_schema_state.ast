Module(
  body=[
    Expr(
      value=Constant(value='\nSchema definitions for schema state aggregation and consolidation.\nContains only type definitions and data models - no execution logic.\n')),
    ImportFrom(
      module='dataclasses',
      names=[
        alias(name='dataclass')],
      level=0),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Dict'),
        alias(name='Any'),
        alias(name='List')],
      level=0),
    ImportFrom(
      module='enum',
      names=[
        alias(name='Enum')],
      level=0),
    ClassDef(
      name='AggregationStrategy',
      bases=[
        Name(id='Enum', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='State aggregation strategies.')),
        Assign(
          targets=[
            Name(id='MERGE', ctx=Store())],
          value=Constant(value='merge')),
        Assign(
          targets=[
            Name(id='OVERWRITE', ctx=Store())],
          value=Constant(value='overwrite')),
        Assign(
          targets=[
            Name(id='APPEND', ctx=Store())],
          value=Constant(value='append')),
        Assign(
          targets=[
            Name(id='TRANSFORM', ctx=Store())],
          value=Constant(value='transform'))]),
    ClassDef(
      name='AggregationScope',
      bases=[
        Name(id='Enum', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='State aggregation scopes.')),
        Assign(
          targets=[
            Name(id='SINGLE_SCHEMA', ctx=Store())],
          value=Constant(value='single_schema')),
        Assign(
          targets=[
            Name(id='SCHEMA_COLLECTION', ctx=Store())],
          value=Constant(value='schema_collection')),
        Assign(
          targets=[
            Name(id='LAYER_SPECIFIC', ctx=Store())],
          value=Constant(value='layer_specific')),
        Assign(
          targets=[
            Name(id='CROSS_LAYER', ctx=Store())],
          value=Constant(value='cross_layer'))]),
    ClassDef(
      name='StateAggregationConfig',
      body=[
        AnnAssign(
          target=Name(id='strategy', ctx=Store()),
          annotation=Name(id='AggregationStrategy', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='scope', ctx=Store()),
          annotation=Name(id='AggregationScope', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='aggregation_timestamp', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='conflict_resolution', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          value=Constant(value='latest_wins'),
          simple=1),
        AnnAssign(
          target=Name(id='preserve_history', ctx=Store()),
          annotation=Name(id='bool', ctx=Load()),
          value=Constant(value=True),
          simple=1),
        Expr(
          value=Constant(value='Schema for state aggregation configuration.'))],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='AggregatedState',
      body=[
        Expr(
          value=Constant(value='Schema for aggregated state representation.')),
        AnnAssign(
          target=Name(id='state_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='source_states', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='str', ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='aggregated_data', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='Any', ctx=Load())],
              ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='aggregation_metadata', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='Any', ctx=Load())],
              ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='version', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='StateAggregationResult',
      body=[
        Expr(
          value=Constant(value='Schema for state aggregation results.')),
        AnnAssign(
          target=Name(id='aggregation_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='configuration', ctx=Store()),
          annotation=Name(id='StateAggregationConfig', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='aggregated_state', ctx=Store()),
          annotation=Name(id='AggregatedState', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='processing_time_ms', ctx=Store()),
          annotation=Name(id='int', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='conflicts_resolved', ctx=Store()),
          annotation=Name(id='int', ctx=Load()),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())])])