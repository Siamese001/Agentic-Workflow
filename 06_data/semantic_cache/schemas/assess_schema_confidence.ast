Module(
  body=[
    Expr(
      value=Constant(value='\nSchema definitions for schema confidence assessment and evaluation.\nContains only type definitions and data models - no execution logic.\n')),
    ImportFrom(
      module='dataclasses',
      names=[
        alias(name='dataclass')],
      level=0),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Optional'),
        alias(name='Dict'),
        alias(name='Any'),
        alias(name='List')],
      level=0),
    ImportFrom(
      module='enum',
      names=[
        alias(name='Enum')],
      level=0),
    ClassDef(
      name='ConfidenceFactor',
      bases=[
        Name(id='Enum', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Factors affecting schema confidence.')),
        Assign(
          targets=[
            Name(id='DATA_QUALITY', ctx=Store())],
          value=Constant(value='data_quality')),
        Assign(
          targets=[
            Name(id='MODEL_ACCURACY', ctx=Store())],
          value=Constant(value='model_accuracy')),
        Assign(
          targets=[
            Name(id='HISTORICAL_PERFORMANCE', ctx=Store())],
          value=Constant(value='historical_performance')),
        Assign(
          targets=[
            Name(id='EXPERT_VALIDATION', ctx=Store())],
          value=Constant(value='expert_validation')),
        Assign(
          targets=[
            Name(id='PEER_REVIEW', ctx=Store())],
          value=Constant(value='peer_review'))]),
    ClassDef(
      name='AssessmentMethod',
      bases=[
        Name(id='Enum', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Confidence assessment methods.')),
        Assign(
          targets=[
            Name(id='STATISTICAL_ANALYSIS', ctx=Store())],
          value=Constant(value='statistical_analysis')),
        Assign(
          targets=[
            Name(id='EXPERT_EVALUATION', ctx=Store())],
          value=Constant(value='expert_evaluation')),
        Assign(
          targets=[
            Name(id='CROSS_VALIDATION', ctx=Store())],
          value=Constant(value='cross_validation')),
        Assign(
          targets=[
            Name(id='BENCHMARK_COMPARISON', ctx=Store())],
          value=Constant(value='benchmark_comparison'))]),
    ClassDef(
      name='ConfidenceAssessment',
      body=[
        Expr(
          value=Constant(value='Schema for confidence assessment configuration.')),
        AnnAssign(
          target=Name(id='assessment_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='method', ctx=Store()),
          annotation=Name(id='AssessmentMethod', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='factors_considered', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='ConfidenceFactor', ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='weighting_scheme', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='ConfidenceFactor', ctx=Load()),
                Name(id='float', ctx=Load())],
              ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='confidence_level', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='ConfidenceFactorScore',
      body=[
        Expr(
          value=Constant(value='Schema for individual confidence factor score.')),
        AnnAssign(
          target=Name(id='factor', ctx=Store()),
          annotation=Name(id='ConfidenceFactor', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='score', ctx=Store()),
          annotation=Name(id='float', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='evidence', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Optional', ctx=Load()),
            slice=Subscript(
              value=Name(id='Dict', ctx=Load()),
              slice=Tuple(
                elts=[
                  Name(id='str', ctx=Load()),
                  Name(id='Any', ctx=Load())],
                ctx=Load()),
              ctx=Load()),
            ctx=Load()),
          value=Constant(value=None),
          simple=1),
        AnnAssign(
          target=Name(id='uncertainty', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Optional', ctx=Load()),
            slice=Name(id='float', ctx=Load()),
            ctx=Load()),
          value=Constant(value=None),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='ConfidenceAssessmentResult',
      body=[
        Expr(
          value=Constant(value='Schema for confidence assessment results.')),
        AnnAssign(
          target=Name(id='schema_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='overall_confidence', ctx=Store()),
          annotation=Name(id='float', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='factor_scores', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='ConfidenceFactorScore', ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='assessment_metadata', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='Any', ctx=Load())],
              ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='assessment_timestamp', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())])])