              iter=Name(id='current_leaves', ctx=Load()),
              body=[
                Assign(
                  targets=[
                    Name(id='domain', ctx=Store())],
                  value=Subscript(
                    value=Call(
                      func=Attribute(
                        value=Attribute(
                          value=Name(id='leaf', ctx=Load()),
                          attr='path',
                          ctx=Load()),
                        attr='split',
                        ctx=Load()),
                      args=[
                        Constant(value='/')]),
                    slice=Constant(value=0),
