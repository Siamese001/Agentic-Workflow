          value=Constant(value='high')),
        Assign(
          targets=[
            Name(id='VERY_HIGH', ctx=Store())],
          value=Constant(value='very_high'))]),
    ClassDef(
      name='ConfidenceConfiguration',
      body=[
        Expr(
          value=Constant(value='Schema for confidence computation configuration.')),
        AnnAssign(
          target=Name(id='metric', ctx=Store()),
