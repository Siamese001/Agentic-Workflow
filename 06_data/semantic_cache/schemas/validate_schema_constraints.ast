Module(
  body=[
    Expr(
      value=Constant(value='\nSchema definitions for schema constraint validation and enforcement.\nContains only type definitions and data models - no execution logic.\n')),
    ImportFrom(
      module='dataclasses',
      names=[
        alias(name='dataclass')],
      level=0),
    ImportFrom(
      module='typing',
      names=[
        alias(name='Optional'),
        alias(name='Dict'),
        alias(name='Any'),
        alias(name='List'),
        alias(name='Union')],
      level=0),
    ImportFrom(
      module='enum',
      names=[
        alias(name='Enum')],
      level=0),
    ClassDef(
      name='ConstraintType',
      bases=[
        Name(id='Enum', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Types of schema constraints.')),
        Assign(
          targets=[
            Name(id='REQUIRED', ctx=Store())],
          value=Constant(value='required')),
        Assign(
          targets=[
            Name(id='MIN_LENGTH', ctx=Store())],
          value=Constant(value='min_length')),
        Assign(
          targets=[
            Name(id='MAX_LENGTH', ctx=Store())],
          value=Constant(value='max_length')),
        Assign(
          targets=[
            Name(id='PATTERN', ctx=Store())],
          value=Constant(value='pattern')),
        Assign(
          targets=[
            Name(id='RANGE', ctx=Store())],
          value=Constant(value='range')),
        Assign(
          targets=[
            Name(id='ENUM', ctx=Store())],
          value=Constant(value='enum')),
        Assign(
          targets=[
            Name(id='CUSTOM', ctx=Store())],
          value=Constant(value='custom'))]),
    ClassDef(
      name='ConstraintSeverity',
      bases=[
        Name(id='Enum', ctx=Load())],
      body=[
        Expr(
          value=Constant(value='Constraint violation severity levels.')),
        Assign(
          targets=[
            Name(id='ERROR', ctx=Store())],
          value=Constant(value='error')),
        Assign(
          targets=[
            Name(id='WARNING', ctx=Store())],
          value=Constant(value='warning')),
        Assign(
          targets=[
            Name(id='INFO', ctx=Store())],
          value=Constant(value='info'))]),
    ClassDef(
      name='SchemaConstraint',
      body=[
        Expr(
          value=Constant(value='Schema for individual constraint definition.')),
        AnnAssign(
          target=Name(id='constraint_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='constraint_type', ctx=Store()),
          annotation=Name(id='ConstraintType', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='field_path', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='parameters', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Dict', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='Any', ctx=Load())],
              ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='severity', ctx=Store()),
          annotation=Name(id='ConstraintSeverity', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='message_template', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='ConstraintViolation',
      body=[
        AnnAssign(
          target=Name(id='constraint_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='field_path', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='actual_value', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Union', ctx=Load()),
            slice=Tuple(
              elts=[
                Name(id='str', ctx=Load()),
                Name(id='int', ctx=Load()),
                Name(id='float', ctx=Load()),
                Name(id='bool', ctx=Load()),
                Subscript(
                  value=Name(id='List', ctx=Load()),
                  slice=Name(id='Any', ctx=Load()),
                  ctx=Load())],
              ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='message', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='severity', ctx=Store()),
          annotation=Name(id='ConstraintSeverity', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='expected_value', ctx=Store()),
          annotation=Subscript(
            value=Name(id='Optional', ctx=Load()),
            slice=Subscript(
              value=Name(id='Union', ctx=Load()),
              slice=Tuple(
                elts=[
                  Name(id='str', ctx=Load()),
                  Name(id='int', ctx=Load()),
                  Name(id='float', ctx=Load()),
                  Name(id='bool', ctx=Load()),
                  Subscript(
                    value=Name(id='List', ctx=Load()),
                    slice=Name(id='Any', ctx=Load()),
                    ctx=Load())],
                ctx=Load()),
              ctx=Load()),
            ctx=Load()),
          value=Constant(value=None),
          simple=1),
        Expr(
          value=Constant(value='Schema for constraint violation details.'))],
      decorator_list=[
        Name(id='dataclass', ctx=Load())]),
    ClassDef(
      name='ConstraintValidationResult',
      body=[
        Expr(
          value=Constant(value='Schema for constraint validation results.')),
        AnnAssign(
          target=Name(id='schema_id', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='is_valid', ctx=Store()),
          annotation=Name(id='bool', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='violations', ctx=Store()),
          annotation=Subscript(
            value=Name(id='List', ctx=Load()),
            slice=Name(id='ConstraintViolation', ctx=Load()),
            ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='validation_timestamp', ctx=Store()),
          annotation=Name(id='str', ctx=Load()),
          simple=1),
        AnnAssign(
          target=Name(id='total_constraints_checked', ctx=Store()),
          annotation=Name(id='int', ctx=Load()),
          simple=1)],
      decorator_list=[
        Name(id='dataclass', ctx=Load())])])