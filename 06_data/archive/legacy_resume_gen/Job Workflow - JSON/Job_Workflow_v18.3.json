  "audit_ready_assurance": {
    "qa_gates": [
      "Non-deferral Assurance",
      "Context & Memory Utilization",
      "Transformer Metrics Logging",
      "Six-Section Enforcement",
      "Numbering & Alignment",
      "Privacy & Sensitive-Data Compliance",
      "Omission Audit",
      "Style & Standalone Conformance",
      "Domain-Specific Gates",
      "Evidence coverage ratio",
      "Semantic entailment (NLI)",
      "Numeric sanity gate",
      "Cross-field constraints",
      "Source quality and recency",
      "Adversarial negation test",
      "Prompt no-op stability",
      "Drift guard vs baseline",
      "Retrieval recall floor on anchors",
      "Self-consistency voting gate"
    ],
    "gate_formulas": {
      "evidence_coverage": "(facts_with_evidence/total_facts) >= thresholds.evidence_coverage_min",
      "semantic_entailment": "all(nli_score_i >= thresholds.nli_entailment_min for nli_score_i in nli_scores)",
      "numeric_sanity": "all(abs_diff_i <= thresholds.numeric_abs_diff_max for abs_diff_i in num_fail_ids) if num_checks else True",
      "cross_field_constraints": "len(xfield_violations) == 0",
      "source_quality_recency": "(authority_min_met is True) and (recency_days_max_observed <= thresholds.recency_days_max) and (primary_source_present is True)",
      "adversarial_negation": "(negation_margin := (base_confidence - negated_confidence)) >= 0",
      "prompt_noop_stability": "stability_cosine >= thresholds.stability_cosine_min",
      "drift_guard": "(drift_score <= thresholds.drift_score_max) or (drift_rationale_present is True)",
      "retrieval_anchor_recall": "(anchors_hit/required_anchors) >= thresholds.anchor_recall_min",
      "self_consistency_voting": "min(vote_agree_rate_sentence, vote_agree_rate_claim) >= thresholds.vote_agree_rate_min"
    }
  }