import os
import shutil

ROOT = r"C:\Users\amita\Documents\Work\AI Job Search\AI\ML\DL\GenAI\LLM 101\LLM Pipelines\Resume Gen\Git\Agentic_Workflow-10_11\scripts"

# --- New folder structure ---
NEW_FOLDERS = {
    "maintenance": [],
    "validation": [],
    "ingestion": [],
    "dev_tools": [],
    "ci_pipeline": [],
    "utils": [],
    "pipeline_artifacts": [],
    "pipeline_logs": [],
    "runtime": [],
}

# --- Mapping of existing files â†’ new folders ---
ROUTING = {
    "ast_purity_scanner.py": "maintenance",
    "contract_registry_validator.py": "validation",
    "manifest_validator.py": "validation",
    "semantic_validation_engine.py": "validation",
    "test_matrix_validator.py": "validation",
    "ci_enforcer.py": "ci_pipeline",
    "golden_trace_auditor.py": "validation",
    "pipeline_artifacts": "pipeline_artifacts",
    "pipeline_logs": "pipeline_logs",
    "runtime": "runtime",
}

def ensure_new_folders():
    for folder in NEW_FOLDERS:
        path = os.path.join(ROOT, folder)
        if not os.path.exists(path):
            os.makedirs(path)

def move_file(src, dest_folder):
    dest = os.path.join(ROOT, dest_folder, os.path.basename(src))
    print(f"MOVE: {src} â†’ {dest}")
    shutil.move(src, dest)

def migrate():
    ensure_new_folders()

    for item in os.listdir(ROOT):
        full = os.path.join(ROOT, item)

        # folder routing (artifacts, logs, runtime) - skip if same destination
        if os.path.isdir(full):
            if item in ROUTING:
                dest = ROUTING[item]
                if item != dest:  # only move if different destination
                    new_path = os.path.join(ROOT, dest)
                    print(f"MOVE FOLDER CONTENTS: {item} â†’ {dest}")
                    for f in os.listdir(full):
                        shutil.move(os.path.join(full, f), new_path)
                    try:
                        os.rmdir(full)
                    except:
                        pass
            continue

        # file routing
        if item in ROUTING:
            move_file(full, ROUTING[item])

    # delete empty folders
    for f in os.listdir(ROOT):
        full = os.path.join(ROOT, f)
        if os.path.isdir(full) and not os.listdir(full):
            print(f"DELETE EMPTY FOLDER: {full}")
            os.rmdir(full)

if __name__ == "__main__":
    migrate()
