{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentic-workflow-10-11/schemas/l2_execution/execution_types.json",
  "title": "L2 Execution Types Schema",
  "description": "Data types for L2 execution layer - tool execution, engine coordination",
  "type": "object",
  "properties": {
    "execution_request": {
      "type": "object",
      "properties": {
        "tool_name": {
          "type": "string",
          "description": "Name of the tool to execute"
        },
        "tool_args": {
          "type": "object",
          "description": "Arguments for the tool execution"
        },
        "execution_type": {
          "type": "string",
          "enum": ["rag", "search", "http", "sql", "file", "embedding"],
          "description": "Type of execution to perform"
        },
        "engine": {
          "type": "string",
          "enum": ["resume", "outreach"],
          "description": "Engine context for execution"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 300000,
          "description": "Timeout in milliseconds"
        }
      },
      "required": ["tool_name", "tool_args", "execution_type"]
    },
    "execution_response": {
      "type": "object",
      "properties": {
        "result": {
          "type": "object",
          "description": "Tool execution result"
        },
        "success": {
          "type": "boolean",
          "description": "Whether execution was successful"
        },
        "error": {
          "type": "string",
          "description": "Error message if execution failed"
        },
        "latency_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Execution latency in milliseconds"
        },
        "tokens_used": {
          "type": "integer",
          "minimum": 0,
          "description": "Tokens consumed during execution"
        }
      },
      "required": ["result", "success", "latency_ms"]
    }
  }
}
