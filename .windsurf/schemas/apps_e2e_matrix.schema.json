{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentic-workflow.local/schemas/apps_e2e_matrix.schema.json",
  "title": "AppsE2EMatrix",
  "description": "All-apps roll-up matrix. Generated from per-app proof bundles, never hand-authored.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "matrix_schema_version",
    "generated_at_utc",
    "git_commit",
    "harness_run_id",
    "apps",
    "totals"
  ],
  "properties": {
    "matrix_schema_version": {"type": "string"},
    "generated_at_utc": {"type": "string", "pattern": "Z$"},
    "git_commit": {"type": "string"},
    "harness_run_id": {"type": "string"},
    "apps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "app_name",
          "discovered",
          "entrypoint_command",
          "entrypoint_runnable",
          "proof_bundle_ref",
          "success",
          "blocking_gaps",
          "agentic_core_spine_status",
          "app_overlay_authority_status",
          "static_dag_status",
          "l3_runtime_status",
          "c0_status",
          "prompt_assembly_status",
          "l2_status",
          "exit_status",
          "uwg_l4_status",
          "l6_status",
          "otel_status",
          "verifier_status"
        ],
        "properties": {
          "app_name": {"type": "string"},
          "discovered": {"type": "boolean"},
          "entrypoint_command": {"type": ["string", "null"]},
          "entrypoint_runnable": {"type": "boolean"},
          "proof_bundle_ref": {"type": ["string", "null"]},
          "success": {"type": "boolean"},
          "blocking_gaps": {"type": "array", "items": {"type": "string"}},
          "agentic_core_spine_status": {"type": "string"},
          "app_overlay_authority_status": {"type": "string"},
          "static_dag_status": {"type": "string", "enum": ["present", "missing", "not_applicable", "unknown"]},
          "l3_runtime_status": {"type": "string", "enum": ["ran", "bypassed", "missing", "not_applicable"]},
          "c0_status": {"type": "string", "enum": ["present", "bypassed", "missing", "not_applicable"]},
          "prompt_assembly_status": {"type": "string", "enum": ["present", "bypassed", "missing", "not_applicable"]},
          "l2_status": {"type": "string", "enum": ["present", "bypassed", "missing", "not_applicable"]},
          "exit_status": {"type": "string", "enum": ["present", "missing", "duplicate"]},
          "uwg_l4_status": {"type": "string", "enum": ["present", "bypassed", "missing", "not_applicable"]},
          "l6_status": {"type": "string", "enum": ["present", "missing", "before_exit"]},
          "otel_status": {"type": "string", "enum": ["present", "synthetic", "missing"]},
          "verifier_status": {"type": "string", "enum": ["pass", "fail", "skipped"]}
        }
      }
    },
    "totals": {
      "type": "object",
      "required": ["discovered", "runnable", "succeeded", "failed", "not_run"],
      "properties": {
        "discovered": {"type": "integer"},
        "runnable": {"type": "integer"},
        "succeeded": {"type": "integer"},
        "failed": {"type": "integer"},
        "not_run": {"type": "integer"}
      }
    }
  }
}
