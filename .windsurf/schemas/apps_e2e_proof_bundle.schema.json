{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentic-workflow.local/schemas/apps_e2e_proof_bundle.schema.json",
  "title": "AppE2EProofBundle",
  "description": "Per-app end-to-end auditability proof bundle. One bundle per real `python -m apps_*` run.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "proof_schema_version",
    "harness_schema_version",
    "app_name",
    "app_package",
    "entrypoint_command",
    "run_id",
    "request_id",
    "trace_root",
    "started_at_utc",
    "finished_at_utc",
    "exit_code",
    "git_commit",
    "git_dirty",
    "runtime_mode",
    "mock_mode_detected",
    "fixture_mode_detected",
    "synthetic_trace_detected",
    "success",
    "blocking_gaps",
    "harness_pass",
    "honest_fail_closed",
    "harness_run_id",
    "app_overlay_authority_status",
    "agentic_core_spine_status",
    "static_dag_ref",
    "static_dag_sha256",
    "runtime_route_contract_ref",
    "runtime_l3_receipt_ref",
    "runtime_l3_bypass_ref",
    "runtime_c0_receipt_ref",
    "runtime_prompt_assembly_ref",
    "runtime_l2_artifact_ref",
    "runtime_exit_disposition_ref",
    "runtime_exhaust_ref",
    "otel_or_runtime_trace_ref",
    "artifact_manifest_ref",
    "stage_matrix"
  ],
  "properties": {
    "proof_schema_version": {"type": "string", "pattern": "^apps_e2e_proof/[0-9]{4}-[0-9]{2}-[0-9]{2}/v[0-9]+$"},
    "harness_schema_version": {"type": "string"},
    "app_name": {"type": "string", "pattern": "^apps_[a-z_]+$"},
    "app_package": {"type": "string"},
    "entrypoint_command": {"type": "string"},
    "run_id": {"type": "string", "minLength": 8},
    "request_id": {"type": "string", "minLength": 1},
    "trace_root": {"type": "string", "minLength": 1},
    "started_at_utc": {"type": "string", "pattern": "Z$"},
    "finished_at_utc": {"type": "string", "pattern": "Z$"},
    "exit_code": {"type": "integer"},
    "git_commit": {"type": "string"},
    "git_dirty": {"type": "boolean"},
    "runtime_mode": {
      "type": "string",
      "enum": [
        "governed_spine_active",
        "standalone_orchestrator_pre_spine",
        "skeleton_only",
        "fail_closed"
      ]
    },
    "mock_mode_detected": {"type": "boolean"},
    "fixture_mode_detected": {"type": "boolean"},
    "synthetic_trace_detected": {"type": "boolean"},
    "success": {"type": "boolean"},
    "blocking_gaps": {"type": "array", "items": {"type": "string"}},
    "harness_pass": {"type": "boolean"},
    "honest_fail_closed": {"type": "boolean"},
    "harness_run_id": {"type": "string"},
    "app_overlay_authority_status": {
      "type": "string",
      "enum": ["overlay_respected", "overlay_violated", "overlay_unknown"]
    },
    "agentic_core_spine_status": {
      "type": "string",
      "enum": ["spine_active", "spine_bypassed", "spine_partial", "spine_unverified"]
    },
    "static_dag_ref": {"type": ["string", "null"]},
    "static_dag_sha256": {"type": ["string", "null"]},
    "runtime_route_contract_ref": {"type": ["string", "null"]},
    "runtime_l3_receipt_ref": {"type": ["string", "null"]},
    "runtime_l3_bypass_ref": {"type": ["string", "null"]},
    "runtime_c0_receipt_ref": {"type": ["string", "null"]},
    "runtime_prompt_assembly_ref": {"type": ["string", "null"]},
    "runtime_l2_artifact_ref": {"type": ["string", "null"]},
    "runtime_exit_disposition_ref": {"type": ["string", "null"]},
    "runtime_exhaust_ref": {"type": ["string", "null"]},
    "otel_or_runtime_trace_ref": {"type": ["string", "null"]},
    "artifact_manifest_ref": {"type": ["string", "null"]},
    "verifier_result_ref": {"type": ["string", "null"]},
    "stage_matrix": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stage", "static_required", "runtime_required", "present", "pass"],
        "properties": {
          "stage": {"type": "string"},
          "static_required": {"type": "boolean"},
          "runtime_required": {"type": "boolean"},
          "present": {"type": "boolean"},
          "artifact": {"type": ["string", "null"]},
          "pass": {"type": "boolean"},
          "gap": {"type": ["string", "null"]}
        }
      }
    }
  }
}
