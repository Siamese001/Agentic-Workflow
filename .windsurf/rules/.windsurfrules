def audit_test_count_invariants():
    """
    Enforce test-count and collection-count invariants.
    
    Detects:
    - Renamed files not discovered
    - Broken test collection
    - Silent deselection
    - Moved tests
    - Accidental marker filtering
    """
    
    from tests._config.test_count_baseline import BASELINE
    import json
    from pathlib import Path
    
    # Collect current counts
    current_counts = collect_test_counts()
    
    violations = []
    
    # Check total collected
    if current_counts['total_collected'] < BASELINE['total_collected']:
        violations.append({
            'type': 'total_count_drop',
            'baseline': BASELINE['total_collected'],
            'current': current_counts['total_collected'],
            'missing': BASELINE['total_collected'] - current_counts['total_collected'],
            'message': f"Total tests dropped from {BASELINE['total_collected']} to {current_counts['total_collected']}"
        })
    
    # Check directory counts
    for directory, baseline_count in BASELINE['directory_counts'].items():
        current_count = current_counts['directory_counts'].get(directory, 0)
        
        if current_count < baseline_count:
            violations.append({
                'type': 'directory_count_drop',
                'directory': directory,
                'baseline': baseline_count,
                'current': current_count,
                'missing': baseline_count - current_count,
                'message': f"Tests in {directory} dropped from {baseline_count} to {current_count}"
            })
    
    # Check marker counts
    for marker, baseline_count in BASELINE['marker_counts'].items():
        current_count = current_counts['marker_counts'].get(marker, 0)
        
        if current_count < baseline_count:
            violations.append({
                'type': 'marker_count_drop',
                'marker': marker,
                'baseline': baseline_count,
                'current': current_count,
                'missing': baseline_count - current_count,
                'message': f"Tests with @pytest.mark.{marker} dropped from {baseline_count} to {current_count}"
            })
    
    # Check xfail count (increases are violations)
    if current_counts['xfail_count'] > BASELINE['xfail_count']:
        violations.append({
            'type': 'xfail_count_increase',
            'baseline': BASELINE['xfail_count'],
            'current': current_counts['xfail_count'],
            'added': current_counts['xfail_count'] - BASELINE['xfail_count'],
            'message': f"xfail count increased from {BASELINE['xfail_count']} to {current_counts['xfail_count']}. Must use strict=True (§11.4)"
        })
    
    # Check skip count (increases are violations)
    if current_counts['skip_count'] > BASELINE['skip_count']:
        violations.append({
            'type': 'skip_count_increase',
            'baseline': BASELINE['skip_count'],
            'current': current_counts['skip_count'],
            'added': current_counts['skip_count'] - BASELINE['skip_count'],
            'message': f"Skip count increased from {BASELINE['skip_count']} to {current_counts['skip_count']}. Must be in allowlist (§12)"
        })
    
    if violations:
        raise TestCountInvariantViolation(
            f"Found {len(violations)} test count invariant violations. "
            f"Test counts unexpectedly dropped or increased.",
            violations
        )
    
    # If counts increased (new tests added), update baseline
    if current_counts['total_collected'] > BASELINE['total_collected']:
        logger.info(f"✅ Test count increased: {BASELINE['total_collected']} → {current_counts['total_collected']}")
        update_baseline_file(current_counts)


