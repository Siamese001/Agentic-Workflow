def generate_skip_review_report():
    """Generate monthly skip review report."""
    from tests._config.skip_allowlist import ALLOWED_SKIPS
    from datetime import datetime, timedelta

    today = datetime.now().date()
    ninety_days_ago = today - timedelta(days=90)

    expired = []
    long_running = []
    no_owner = []

    for skip in ALLOWED_SKIPS:
        # Check expiry
        if 'expiry_date' in skip:
            expiry = datetime.strptime(skip['expiry_date'], '%Y-%m-%d').date()
            if expiry < today:
                expired.append(skip)

        # Check age (if created_date tracked)
        if 'created_date' in skip:
            created = datetime.strptime(skip['created_date'], '%Y-%m-%d').date()
            if created < ninety_days_ago:
                long_running.append(skip)

        # Check owner
        if 'owner' not in skip or not skip['owner']:
            no_owner.append(skip)

    report = f"""
# Skip Allowlist Review Report
Generated: {today}

## Expired Skips ({len(expired)})
{format_skip_list(expired)}

## Long-Running Skips >90 days ({len(long_running)})
{format_skip_list(long_running)}

## Skips Without Owner ({len(no_owner)})
{format_skip_list(no_owner)}

## Action Required
- Review expired skips: Fix test or extend expiry with justification
- Review long-running skips: Prioritize fixing or document permanent skip
- Assign owners to unowned skips
"""

    return report
