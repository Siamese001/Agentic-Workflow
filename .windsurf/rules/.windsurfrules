        "bge_model", "vector_store", "embedding",
        "ast_parse", "dependency_graph",
        "pytest", "test_collection"
    ]

    for file in get_python_files():
        ast_tree = ast.parse(file.read_text())

        for node in ast.walk(ast_tree):
