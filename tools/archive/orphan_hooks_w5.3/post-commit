#!/bin/sh
command -v git-lfs >/dev/null 2>&1 || { printf >&2 "\n%s\n\n" "This repository is configured for Git LFS but 'git-lfs' was not found on your path. If you no longer wish to use Git LFS, remove this hook by deleting the 'post-commit' file in the hooks directory (set by 'core.hookspath'; usually '.git/hooks')."; exit 2; }
git lfs post-commit "$@"

# MCP Config SSOT sync — if config/mcp_servers.yaml was in this commit,
# auto-sync YAML → global so they never drift.
if git diff-tree --no-commit-id --name-only -r HEAD | grep -q 'config/mcp_servers.yaml'; then
    printf '[post-commit] MCP config changed — syncing YAML → global...\n' >&2
    python tools/adg/sync_yaml_to_global.py 2>&1 | sed 's/^/  /' >&2
fi
