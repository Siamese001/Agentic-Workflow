## Integrity Verification Script

```bash
#!/bin/bash
# Data Integrity Verification Script
# Usage: ./verify_data_integrity.sh

echo "Verifying data directory integrity..."
echo "Generated: 2025-12-09T12:00:00Z"

# Check if all files exist and match hashes
while IFS= read -r line; do
    if [[ $line =~ ^([^:]+):\ (.+)$ ]]; then
        file="${BASH_REMATCH[1]}"
        expected_hash="${BASH_REMATCH[2]}"

        if [[ -f "$file" ]]; then
            actual_hash=$(sha256sum "$file" | cut -d' ' -f1)
            if [[ "$actual_hash" == "$expected_hash" ]]; then
                echo "✓ $file - Verified"
            else
                echo "✗ $file - HASH MISMATCH"
                echo "  Expected: $expected_hash"
                echo "  Actual: $actual_hash"
            fi
        else
            echo "✗ $file - FILE NOT FOUND"
        fi
    fi
done < <(grep -E "^[^#].*:" "$0")

echo "Verification complete."
```

