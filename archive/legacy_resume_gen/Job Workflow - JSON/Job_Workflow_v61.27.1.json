  "5.output": {
    "description": "The 'Assembler' phase of the workflow with enhanced validation.",
    "assembly_engine": {
      "policy": "ITERATE_ALL_VALIDATE_AND_RENDER",
      "render_settings": {
        "show_provenance_markers": false
      },
      "steps": [
        "RENDER_NAME",
        "RENDER_HEADLINE",
        "RENDER_CONTACT",
        "EXECUTE_K1_SUMMARY",
        "RENDER_ALL_EXPERIENCE_BLOCKS",
        "EXECUTE_K8_AND_RENDER_COMPETENCIES",
        "EXECUTE_K11_AND_RENDER_SKILLS_LIST",
        "EXECUTE_K9_COVER_LETTER"
      ],
      "validation_gates": [
        {
          "gate_id": "VG_SUMMARY_GROUNDING_CHECK",
          "policy": "VERIFY_ALL_CLAIMS_AGAINST_BULLET_POOL"
        },
        {
          "gate_id": "VG_BULLET_HALLUCINATION_CHECK",
          "policy": "VALIDATE_GENERATED_BULLETS_AGAINST_SOURCE_POOL"
        },
        {
          "gate_id": "VG_THEMATIC_UNIQUENESS",
          "policy": "ENSURE_PRIMARY_THEME_APPEARS_ONCE"
        },
        {
          "gate_id": "VG_CREATIVE_BRIEF_ADHERENCE",
          "policy": "ENFORCE_ALL_CREATIVE_BRIEF_CONSTRAINTS"
        },
        {
          "gate_id": "VG_HEADER_INTEGRITY_CHECK",
          "policy": "STRICT_COMPARE_HEADER_TO_SCAFFOLD"
        },
        {
          "gate_id": "VG_BULLET_PROVENANCE_CHECK",
          "policy": "VALIDATE_BULLET_ORIGIN_AND_METRICS"
        },
        {
          "gate_id": "VG_REDUNDANCY_CHECK",
          "policy": "ENFORCE_GLOBAL_DEDUPLICATION_MATRIX"
        },
        {
          "gate_id": "VG_NATURAL_HYPHEN_PRESERVATION",
          "policy": "ENFORCE_HYPHENATION_RULES_JSON"
        },
        {
          "gate_id": "VG_COMPETENCY_WORD_COUNT_BALANCE",
          "policy": "VALIDATE_WORD_COUNT_VARIANCE"
        },
        {
          "gate_id": "VG_BULLET_PUNCTUATION",
          "policy": "ENSURE_ALL_BULLETS_END_WITH_PERIOD"
        },
        {
          "gate_id": "VG_SUMMARY_VOICE_TENSE",
          "policy": "ENFORCE_THIRD_PERSON_PAST_TENSE"
        },
        {
          "gate_id": "VG_AGENTIC_OUTPUT_VALIDATION",
          "policy": "ENSURE_DETAILED_TRACE_NOT_SUMMARY"
        },
        {
          "gate_id": "VG_COMPANY_PRODUCT_COMPREHENSIVE",
          "policy": "NO_TARGET_PRODUCTS_IN_PAST_ROLES",
          "apply_to": ["K.6", "K.7", "K.8", "K.9"],
          "validation": "Ensure no target company products in non-target experience",
          "generic_mapping": {
            "Snowflake": "cloud data platform",
            "Databricks": "unified analytics platform",
            "Tableau": "business intelligence tool"
          },
          "on_fail": "Replace with generic terms",
          "severity": "CRITICAL"
        },
        {
          "gate_id": "VG_QA_METRICS",
          "thresholds": {
            "K.1": {"company_present": "REQUIRED", "confidence": "≥0.95"},
            "K.2": {"peer_jds": "≥3", "differentiators": "≥3"},
            "K.4": {"words": "8-12", "chars": "≤90"},
            "K.5": {"words": "120-140", "voice": "third_person"},
            "K.6": {"bullet_words": "25-35", "provenance": "4V-3T-0S"},
            "K.7": {"bullet_words": "22-30", "provenance": "4V-2T-0S"},
            "K.8": {"count": "6", "words": "24-30"},
            "K.9": {"specifics": "≥4", "words": "85-100"}
          },
          "enforcement": "BLOCKING",
          "severity": "CRITICAL"
        }
      ]
    },
    "resume_filename_generator": {
      "format": "Amit_Ayer_Resume_{company_name_sanitized}_{job_title_sanitized}_{jr_suffix}_v{date}.docx",
      "logic": "Sanitize company (max 20 chars) and job title (max 25 chars), replacing special characters with underscores. Conditionally add '_JR_' suffix if sanitized job title is less than 8 characters. Format date as MMDDYYYY."
    },
    "formatters": {
      "date_formatter": {
        "input": "YYYY-MM-DD",
        "output": "MM-DD-YYYY"
      }
    },
    "artifact_render_settings": {
      "application_tracker": {
        "format": "fenced_json_block"
      }
    }
  },
  "6.conditions": {
    "description": "The inviolable, hardcoded rules of the v61.27.1 architecture.",
    "critical_rules": [
      "The 'Artist' (LLM) is forbidden from generating any factual data. All such data MUST originate from the 'Clerk's' scaffold.",
      "The 'Artist' (LLM) MUST strictly adhere to all constraints defined in the '/4.reasoning/creative_brief'.",
      "The workflow MUST halt if the 'Clerk' phase fails to extract a complete and structurally valid data scaffold.",
      "The 'Assembler' phase MUST pass all defined validation gates before rendering the final output.",
      "The system will not attempt to access any external URLs for file ingestion. All source data must be provided directly by the user.",
      "K.0 MUST extract authenticity patterns from ≥10 LinkedIn profiles",
      "K.0 MUST analyze ≥3 peer JDs for competitive positioning",
      "Two-stage retrieval MUST be used for ALL external RAG calls",
      "Deduplication matrix thresholds MUST be enforced between all sections",
      "Company product validation MUST apply to K.6, K.7, K.8, and K.9",
      "Position-weighted scoring MUST apply to K.6 bullets 1-2",
      "AI detection defense thresholds MUST be checked before output",
      "QA metrics MUST pass for each K-node before proceeding"
    ],
    "agentic_rag_hardening_policy": {
      "name": "Multi-Stage Signal Quality Pipeline - Enhanced",
      "stages": [
        {
          "stage": 1,
          "name": "Two-Stage Retrieval",
          "method": "BM25 coarse retrieval → Cross-encoder reranking → Final selection",
          "params": {
            "bm25_top_n": 200,
            "bm25_k1": 1.5,
            "bm25_b": 0.75,
            "rerank_top_k": 20,
            "final_k": 5,
            "crossencoder_model": "ms-marco-MiniLM-L-6-v2",
            "min_relevance_score": 0.75
          }
        },
        {
          "stage": 2,
          "name": "HyDE Enrichment",
          "method": "For JDs <200 words, generate hypothetical 400-word expansion",
          "trigger": "jd_word_count < 200 OR keyword_density < 0.05",
          "prompt": "Generate comprehensive job description with 8-10 skills, responsibilities, metrics"
        },
        {
          "stage": 3,
          "name": "Source Authority Tiering",
          "method": "Tier 1 (company) > Tier 2 (news) > Tier 3 (forums)"
        },
        {
          "stage": 4,
          "name": "Self-Critique Guardrail",
          "method": "Validate retrieved context supports claims"
        },
        {
          "stage": 5,
          "name": "External Fact-Checking",
          "method": "Verify against fact-check endpoint"
        }
      ],
      "failure_recovery_path": {
        "name": "Hop Refinement",
        "logic": "On search failure, first increase search breadth. If still fails, switch to a HyDE-guided query. Max 2 refinements."
      }
    },
    "credibility_markers": [
      {
        "type": "currency",
        "format": "$##M"
      },
      {
