  "message_type_router": {
    "inputs_required": [
      "name",
      "title",
      "about",
      "profile_url"
    ],
    "features": [
      "seniority_cues",
      "org_level_in_title",
      "scope_markers",
      "about_signals",
      "geo_signals",
      "industry_terms",
      "function_terms",
      "company_size_hint"
    ],
    "weights": {
      "boardroom_fit": 0.45,
      "exec_fit": 0.3,
      "role_fit": 0.2,
      "other": 0.05
    },
    "thresholds": {
      "c_level_min": 0.75,
      "executive_min": 0.6,
      "role_fit_min": 0.55
    },
    "tie_breakers": [
      "prefer boardroom_fit",
      "else exec_fit",
      "else highest role_fit with strongest company_size_hint"
    ],
    "mapping": [
      {
        "if": "boardroom_fit>=c_level_min",
        "route": "C_LEVEL"
      },
      {
        "elif": "exec_fit>=executive_min",
        "route": "EXECUTIVE"
      },
      {
        "elif": "role_fit>=role_fit_min and 'TA' in function_terms",
        "route": "SENIOR_TA"
      },
      {
        "elif": "role_fit>=role_fit_min and 'Recruiter' in function_terms",
        "route": "RECRUITER"
      },
      {
        "else": "SHORT_NEW"
      }
    ],
    "smoke_tests": [
      "Router blocks if any required LinkedIn field is missing",
      "Router returns one of the five message types",
      "Scores are logged to audit with features contributing to top route"
    ]
  },
