          "Verify archetype targeting unchanged"
        ]
      },
      "migration_steps": {
        "step_1": "Create section 2.5.global_message_constraints with all constraints",
        "step_2": "Add API helper functions to section 2.5",
        "step_3": "Update routes in section 3 to reference global constraints",
        "step_4": "Update QA rules in section 6 to reference global constraints",
        "step_5": "Update validation gates in section 6 to use API functions",
