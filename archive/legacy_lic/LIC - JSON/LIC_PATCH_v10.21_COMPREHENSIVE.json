    {
      "patch_id": "PATCH-v10.21-002",
      "title": "Route Consolidation - Remove SHORT_NEW and LONG_NEW",
      "severity": "MEDIUM_REFACTORING",
      "category": "ARCHITECTURAL",
      "description": "Remove ambiguous SHORT_NEW and LONG_NEW routes. Consolidate to clear use cases: CONNECTION_REQ (connection requests), INMAIL (premium messages), FOLLOW_UP (existing connections).",
      "rationale": {
        "problem": "SHORT_NEW and LONG_NEW are ambiguous route names that overlap with INMAIL and create confusion in route selection. Rarely used in practice.",
        "solution": "Remove both routes. Users choose from CONNECTION_REQ, INMAIL, or FOLLOW_UP based on clear use cases.",
        "benefits": [
          "Simplified decision tree (3 routes instead of 5)",
          "Eliminated route confusion and overlap",
          "Clearer user intent mapping",
          "Reduced maintenance burden",
          "Better alignment with LinkedIn platform types"
        ]
      },
      "implementation": {
        "phase_1_remove_route_definitions": {
          "location": "/3.context.central_config.routes",
          "routes_to_remove": [
            "SHORT_NEW",
            "LONG_NEW"
          ],
          "routes_to_keep": [
            "CONNECTION_REQ",
            "INMAIL",
            "FOLLOW_UP"
          ],
          "mapping_logic": {
            "SHORT_NEW_users_should_use": "FOLLOW_UP (if existing connection) OR CONNECTION_REQ (if new connection)",
            "LONG_NEW_users_should_use": "INMAIL"
          }
        },
        "phase_2_update_routing_decision_tree": {
          "location": "/4.reasoning.routing_decision_tree",
          "before": {
            "abbreviation_mapping": {
              "CR": "CONNECTION_REQ",
              "SN": "SHORT_NEW",
              "FU": "FOLLOW_UP",
              "LN": "LONG_NEW"
            }
          },
          "after": {
            "abbreviation_mapping": {
              "CR": "CONNECTION_REQ",
              "IM": "INMAIL",
              "FU": "FOLLOW_UP"
            }
          },
          "decision_logic_before": {
            "if_route_override": "Use override value directly",
            "else": "Default to SHORT_NEW"
          },
          "decision_logic_after": {
            "if_route_override": "Use override value directly (must be CONNECTION_REQ, INMAIL, or FOLLOW_UP)",
            "if_job_specific": "Default to INMAIL",
            "if_follow_up_context": "Default to FOLLOW_UP",
            "else": "Prompt user to select route"
          }
        },
        "phase_3_update_input_validation": {
          "location": "/2.input.linkedin_input_collection_v75",
          "before": {
            "message_context.type.options": [
              "CONNECTION_REQ",
              "INMAIL",
              "SHORT_NEW",
              "LONG_NEW",
              "FOLLOW_UP"
            ]
          },
          "after": {
            "message_context.type.options": [
              "CONNECTION_REQ",
              "INMAIL",
              "FOLLOW_UP"
            ]
          }
        },
        "phase_4_update_tool_usage_guidance": {
          "location": "/4.reasoning.tool_usage_specifics.tool_call_budget.guidance",
          "before": {
            "CONNECTION_REQ_non_job": 0,
            "CONNECTION_REQ_job": "6-8",
            "SHORT_NEW": "3-6",
            "LONG_NEW": "8-12",
            "FOLLOW_UP": "2-4",
            "INMAIL": "8-12"
          },
          "after": {
            "CONNECTION_REQ_non_job": 0,
            "CONNECTION_REQ_job": "6-8",
            "FOLLOW_UP": "2-4",
            "INMAIL": "8-12"
          }
        },
        "phase_5_update_templates": {
          "locations": [
            "/5.output.greeting_templates",
            "/5.output.cta_templates",
            "/5.output.signature_formats"
          ],
          "changes": "Remove all SHORT_NEW and LONG_NEW specific templates",
          "keep": "Only CONNECTION_REQ, INMAIL, FOLLOW_UP templates"
        },
        "phase_6_update_qa_rules": {
          "location": "/6.validation.qa_rules",
          "affected_rules": [
            "LIC-QA-013",
            "LIC-QA-026"
          ],
          "changes": "Remove references to SHORT_NEW and LONG_NEW from validation logic"
        },
        "phase_7_update_override_policies": {
          "location": "/3.context.system.override_policies.route_override",
          "before": {
            "validation": "Must be valid route name from [CONNECTION_REQ, SHORT_NEW, LONG_NEW, FOLLOW_UP, INMAIL]"
          },
          "after": {
            "validation": "Must be valid route name from [CONNECTION_REQ, INMAIL, FOLLOW_UP]"
          }
        }
      },
      "user_migration_guide": {
        "for_short_new_users": {
          "old_use_case": "Short new connection message",
          "new_route": "CONNECTION_REQ or FOLLOW_UP",
          "decision_criteria": "If not yet connected → CONNECTION_REQ. If already connected → FOLLOW_UP",
          "constraint_changes": "CONNECTION_REQ: 330 chars. FOLLOW_UP: 120-170 words"
        },
        "for_long_new_users": {
          "old_use_case": "Long new connection message with subject line",
          "new_route": "INMAIL",
          "decision_criteria": "Always use INMAIL for messages requiring subject line and expanded format",
          "constraint_changes": "INMAIL: 180-250 words (consistent with LONG_NEW range)"
        }
      },
      "testing_requirements": {
        "test_cases": [
          {
            "test_id": "TC-v10.21-002-01",
            "description": "Verify SHORT_NEW route no longer available",
            "expected_result": "Route selection only shows CONNECTION_REQ, INMAIL, FOLLOW_UP"
          },
          {
            "test_id": "TC-v10.21-002-02",
            "description": "Verify LONG_NEW route no longer available",
            "expected_result": "Route selection only shows CONNECTION_REQ, INMAIL, FOLLOW_UP"
          },
          {
            "test_id": "TC-v10.21-002-03",
            "description": "Test route override validation",
            "expected_result": "Attempting to use SHORT_NEW or LONG_NEW throws validation error"
          },
          {
            "test_id": "TC-v10.21-002-04",
            "description": "Test default routing logic",
            "expected_result": "System prompts user for route selection instead of defaulting to SHORT_NEW"
          },
          {
            "test_id": "TC-v10.21-002-05",
            "description": "Verify tool call budgets updated",
            "expected_result": "No SHORT_NEW or LONG_NEW entries in guidance"
          }
        ],
        "migration_verification": [
          "All former SHORT_NEW use cases work with CONNECTION_REQ or FOLLOW_UP",
          "All former LONG_NEW use cases work with INMAIL",
          "No functional regressions in message generation"
        ]
      },
      "rollback_procedure": {
        "trigger": "If users report confusion or workflow breaks",
        "steps": [
          "Restore SHORT_NEW and LONG_NEW route definitions in section 3",
          "Restore abbreviation mappings in section 4",
          "Restore route options in section 2 input validation",
          "Restore templates in section 5",
          "Restore guidance in section 4 tool usage",
          "Update decision tree default back to SHORT_NEW"
        ]
      },
      "benefits": {
        "clarity": "3 clear routes aligned with LinkedIn platform types",
        "simplicity": "40% reduction in route complexity",
        "maintenance": "Fewer templates and validation paths to maintain",
        "user_experience": "Less confusion about which route to choose"
      }
    },

    {
      "patch_id": "PATCH-v10.21-003",
      "title": "Archetype Config Migration to Global Constraints",
      "severity": "LOW_REFACTORING",
      "category": "ARCHITECTURAL",
      "description": "Update archetype-specific configurations in section 4.reasoning.archetype_explicit_configs to reference global message constraints instead of hardcoded values.",
      "rationale": {
        "problem": "Archetype configs contain hardcoded word count targets that duplicate global constraints. Changes require updating both locations.",
        "solution": "Replace hardcoded values with references to global constraints via API.",
        "benefits": [
          "Complete centralization of all constraint values",
          "Archetype targets automatically sync with global constraints",
          "Eliminates last remaining constraint duplication",
          "Completes v10.21 refactoring architecture"
        ]
      },
      "implementation": {
