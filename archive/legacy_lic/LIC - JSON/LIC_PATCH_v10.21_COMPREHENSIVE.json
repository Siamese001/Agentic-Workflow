            {
              "archetype": "C_LEVEL",
              "section": "message_body",
              "before": {
                "word_count": [190, 230]
              },
              "after": {
                "word_count": {
                  "source": "REFERENCE → get_target_word_count('INMAIL', 'C_LEVEL')",
                  "value": "→ 240 (from global constraints)",
                  "range": "→ [180, 250] (INMAIL range from global constraints)"
                }
              }
            },
            {
              "archetype": "EXECUTIVE",
              "section": "message_body",
              "before": {
                "word_count": [160, 220]
              },
