                  "source": "REFERENCE → get_target_word_count('INMAIL', 'EXECUTIVE')",
                  "value": "→ 225 (from global constraints)",
                  "range": "→ [180, 250] (INMAIL range from global constraints)"
                }
              }
            },
            {
              "archetype": "SENIOR_TA",
              "section": "message_body",
              "before": {
                "word_count": [150, 190]
              },
              "after": {
                "word_count": {
                  "source": "REFERENCE → get_target_word_count('INMAIL', 'SENIOR_TA')",
                  "value": "→ 210 (from global constraints)",
                  "range": "→ [180, 250] (INMAIL range from global constraints)"
                }
              }
