    {
      "patch_id": "PATCH-v10.21-001",
      "title": "Centralized Global Message Constraints",
      "severity": "CRITICAL_REFACTORING",
      "category": "ARCHITECTURAL",
      "description": "Create single source of truth for all message length constraints in new section 2.5.global_message_constraints. All other sections reference this global config via API.",
      "rationale": {
        "problem": "Message length constraints scattered across routes, QA rules, validation gates, and archetype configs. Changes require updating 4+ locations with risk of inconsistency.",
        "solution": "Centralize all constraints in one section. All other sections reference via API helpers.",
        "benefits": [
          "Single-point updates for constraint changes",
          "Eliminates duplicated constraint definitions",
          "Reduces risk of inconsistent constraints",
          "Easier maintenance and testing",
          "Clear constraint documentation"
        ]
      },
      "implementation": {
        "phase_1_create_global_section": {
          "location": "NEW SECTION: /2.5.global_message_constraints",
          "structure": {
            "description": "Single source of truth for all message length constraints. All other sections reference these values.",
            "routes": {
              "CONNECTION_REQ": {
                "char_limit": 330,
                "word_range": null,
                "word_min": null,
                "word_max": null,
                "enforcement": "character",
                "includes_signature": true,
                "signature_overhead_chars": 20,
                "notes": "LinkedIn connection request platform limit"
              },
              "INMAIL": {
                "char_limit": null,
                "word_range": [180, 250],
                "word_min": 180,
                "word_max": 250,
                "enforcement": "word_count",
                "target_by_archetype": {
                  "RECRUITER": 200,
                  "SENIOR_TA": 210,
                  "EXECUTIVE": 225,
                  "C_LEVEL": 240
                },
                "notes": "Premium InMail with expanded format"
              },
              "FOLLOW_UP": {
                "char_limit": null,
                "word_range": [120, 170],
                "word_min": 120,
                "word_max": 170,
                "enforcement": "word_count",
                "target_by_archetype": {
                  "RECRUITER": 140,
                  "SENIOR_TA": 145,
                  "EXECUTIVE": 150,
                  "C_LEVEL": 160
                },
                "notes": "Shorter format for existing connections"
              }
            },
            "component_constraints": {
              "K.2_subject_line": {
                "char_limit": 60,
                "word_range": [4, 7],
                "word_min": 4,
                "word_max": 7,
                "applies_to_routes": ["INMAIL"],
                "notes": "Subject line for InMail messages only"
              },
              "K.5_cta": {
                "CONNECTION_REQ": {
                  "word_max": 5,
                  "word_min": null,
                  "format": "micro",
                  "notes": "Ultra-compressed CTA for connection requests"
                },
                "INMAIL": {
                  "word_range": [15, 25],
                  "word_min": 15,
                  "word_max": 25,
                  "format": "expanded_with_dates",
                  "notes": "Full CTA with date window proposals"
                },
                "FOLLOW_UP": {
                  "word_range": [15, 25],
                  "word_min": 15,
                  "word_max": 25,
                  "format": "standard_with_dates",
                  "notes": "Standard CTA with continuity reference"
                }
              },
              "K.6_signature": {
                "simplified": {
                  "lines": 2,
                  "estimated_chars": 20,
                  "format": "Regards,\\n{first_name}",
                  "use_cases": ["CONNECTION_REQ"]
                },
                "warm": {
                  "lines": 2,
                  "estimated_chars": 18,
                  "format": "Thanks,\\n{first_name}",
                  "use_cases": ["FOLLOW_UP"]
                },
                "professional": {
                  "lines": 4,
                  "estimated_chars": 80,
                  "format": "Best regards,\\n{first_name} {last_name}\\n{title}\\n{linkedin_url}",
                  "use_cases": ["INMAIL"]
                },
                "standard": {
                  "lines": 4,
                  "estimated_chars": 80,
                  "format": "Best regards,\\n{first_name} {last_name}\\n{title}\\n{linkedin_url}",
                  "use_cases": ["INMAIL"]
                }
              }
            },
            "validation_thresholds": {
              "word_count_tolerance": 0,
              "char_count_tolerance": 0,
              "enforcement_mode": "strict",
              "truncation_allowed": false,
              "notes": "Zero tolerance policy for constraint violations"
            }
          }
        },
        "phase_2_create_api_helpers": {
          "location": "NEW SECTION: /2.5.global_message_constraints.api",
          "functions": [
            {
              "function_name": "get_global_constraint",
              "description": "Retrieve constraint from global config",
              "signature": "get_global_constraint(category: string, key: string, attribute?: string) -> any",
              "examples": [
                {
                  "call": "get_global_constraint('routes', 'INMAIL')",
                  "returns": "{char_limit: null, word_range: [180, 250], ...}"
                },
                {
                  "call": "get_global_constraint('routes', 'INMAIL', 'word_max')",
                  "returns": "250"
                },
                {
                  "call": "get_global_constraint('component_constraints', 'K.2_subject_line')",
                  "returns": "{char_limit: 60, word_range: [4, 7]}"
                }
              ],
              "implementation": {
                "step_1": "Load global_message_constraints config",
                "step_2": "Navigate to category[key]",
                "step_3": "If attribute specified, return category[key][attribute]",
                "step_4": "Else return entire category[key] object",
                "error_handling": "Return null if path not found, log error"
              }
            },
            {
              "function_name": "validate_against_global_constraint",
              "description": "Validate content against global constraints",
              "signature": "validate_against_global_constraint(route: string, content_type: string, content: string) -> ValidationResult",
              "examples": [
                {
                  "call": "validate_against_global_constraint('INMAIL', 'full_message', message_text)",
                  "returns": "{valid: true, count: 215, min: 180, max: 250}"
                },
                {
                  "call": "validate_against_global_constraint('CONNECTION_REQ', 'full_message', message_text)",
                  "returns": "{valid: false, count: 345, limit: 330}"
                }
              ],
              "implementation": {
                "step_1": "Load constraints for route",
                "step_2": "Determine enforcement type (word_count vs character)",
                "step_3": "Count content (words or chars)",
                "step_4": "Compare against min/max or limit",
                "step_5": "Return validation result object"
              },
              "return_schema": {
                "valid": "boolean",
                "count": "number",
                "limit": "number (for char enforcement)",
                "min": "number (for word enforcement)",
                "max": "number (for word enforcement)",
                "enforcement_type": "string"
              }
            },
            {
              "function_name": "get_target_word_count",
              "description": "Get target word count for route + archetype combination",
              "signature": "get_target_word_count(route: string, archetype: string) -> number",
              "examples": [
                {
                  "call": "get_target_word_count('INMAIL', 'C_LEVEL')",
                  "returns": "240"
                },
                {
                  "call": "get_target_word_count('FOLLOW_UP', 'RECRUITER')",
                  "returns": "140"
                },
                {
                  "call": "get_target_word_count('CONNECTION_REQ', 'EXECUTIVE')",
                  "returns": "null (no word count targets for char-limited routes)"
                }
              ],
              "implementation": {
                "step_1": "Load constraints for route",
                "step_2": "Check if target_by_archetype exists",
                "step_3": "If yes, return target_by_archetype[archetype]",
                "step_4": "If no archetype-specific target, return midpoint of word_range",
                "step_5": "If char-limited route, return null",
                "fallback_calculation": "(word_min + word_max) / 2"
              }
            }
          ]
        },
        "phase_3_update_routes": {
          "location": "/3.context.central_config.routes",
          "changes": [
            {
              "route": "CONNECTION_REQ",
              "before": {
                "char_limit": 330,
                "word_range": null
              },
              "after": {
                "length_constraints": {
                  "source": "REFERENCE → 2.5.global_message_constraints.routes.CONNECTION_REQ",
                  "char_limit": "→ get_global_constraint('routes', 'CONNECTION_REQ', 'char_limit')",
                  "word_range": "→ get_global_constraint('routes', 'CONNECTION_REQ', 'word_range')"
                }
              }
            },
            {
              "route": "INMAIL",
              "before": {
                "char_limit": null,
                "word_range": [180, 240]
              },
              "after": {
                "length_constraints": {
                  "source": "REFERENCE → 2.5.global_message_constraints.routes.INMAIL",
                  "word_range": "→ get_global_constraint('routes', 'INMAIL', 'word_range')",
                  "target_by_archetype": "→ get_global_constraint('routes', 'INMAIL', 'target_by_archetype')"
                }
              }
            },
            {
              "route": "FOLLOW_UP",
              "before": {
                "char_limit": null,
                "word_range": [120, 170]
              },
              "after": {
                "length_constraints": {
                  "source": "REFERENCE → 2.5.global_message_constraints.routes.FOLLOW_UP",
                  "word_range": "→ get_global_constraint('routes', 'FOLLOW_UP', 'word_range')",
                  "target_by_archetype": "→ get_global_constraint('routes', 'FOLLOW_UP', 'target_by_archetype')"
                }
              }
            }
          ],
          "notes": "Remove hardcoded constraints, replace with references to global config"
        },
        "phase_4_update_qa_rules": {
          "location": "/6.validation.qa_rules",
          "changes": [
            {
              "rule_id": "LIC-QA-001",
              "name": "Word count within route range",
              "before": {
                "check": "Word count within route range",
                "implementation": "Hardcoded range check"
              },
              "after": {
                "check": "Word count within route range",
                "constraint_source": "REFERENCE → 2.5.global_message_constraints.routes[route].word_range",
                "implementation": "get_global_constraint('routes', route, 'word_range')",
                "validation": "word_count >= word_min AND word_count <= word_max"
              }
            },
            {
              "rule_id": "LIC-QA-002",
              "name": "Character limit respected",
              "before": {
                "check": "Character limit respected",
                "implementation": "Hardcoded limit check"
              },
              "after": {
                "check": "Character limit respected",
                "constraint_source": "REFERENCE → 2.5.global_message_constraints.routes[route].char_limit",
                "implementation": "get_global_constraint('routes', route, 'char_limit')",
                "validation": "char_count <= char_limit (if char_limit != null)"
              }
            },
            {
              "rule_id": "LIC-QA-012",
              "name": "Subject line appropriateness",
              "before": {
                "check": "Subject line appropriateness",
                "implementation": "Hardcoded 60 char / 4-7 word limits"
              },
              "after": {
                "check": "Subject line appropriateness",
                "constraint_source": "REFERENCE → 2.5.global_message_constraints.component_constraints.K.2_subject_line",
                "implementation": "get_global_constraint('component_constraints', 'K.2_subject_line')",
                "validation": "char_count <= 60 AND word_count in [4, 7]"
              }
            }
          ]
        },
        "phase_5_update_validation_gates": {
          "location": "/6.validation.master_validation_gate",
          "changes": [
            {
              "phase": "structural_compliance",
              "check_id": "word_count",
              "before": {
                "constraint_source": "Hardcoded in validation logic"
              },
              "after": {
                "constraint_source": "2.5.global_message_constraints.routes[route].word_range",
                "method": "get_global_constraint('routes', route_name, 'word_range')",
                "pass_criteria": "word_min <= count <= word_max"
              }
            },
            {
              "phase": "structural_compliance",
              "check_id": "char_limit",
              "before": {
                "constraint_source": "Hardcoded in validation logic"
              },
              "after": {
                "constraint_source": "2.5.global_message_constraints.routes[route].char_limit",
                "method": "get_global_constraint('routes', route_name, 'char_limit')",
                "pass_criteria": "count <= char_limit (if not null)"
              }
            }
          ]
        }
      },
      "testing_requirements": {
