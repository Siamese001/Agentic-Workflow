  "patches": [
    {
      "patch_id": "PATCH-v10.20-001",
      "severity": "WARNING",
      "gap_id": "GAP-001",
      "name": "Template Spell-Check Integration",
      "description": "Add spell-check validation to boot validator for all templates",
      "affected_sections": ["3.context.system.boot_validator"],
      "implementation": {
        "add_to_boot_validator": {
          "spell_check_engine": {
            "enabled": true,
            "dictionary": "en_US",
            "custom_terms": [
              "LinkedIn",
              "InMail",
              "GitHub",
              "DevOps",
              "SaaS",
              "API"
            ],
            "validation_targets": [
              "greeting_templates",
              "cta_templates",
              "signature_formats"
            ],
            "common_typos": {
              "Hii": "Hi",
              "Helo": "Hello",
              "recieve": "receive",
              "seperate": "separate",
              "definately": "definitely"
            },
            "on_typo_detected": {
              "action": "BLOCK_SYSTEM_START",
              "message": "Boot validation failed: Typo detected in {template_type}: '{typo}' should be '{correction}'",
              "recovery": "Fix typo in template and restart"
            }
          }
        }
      },
      "test_validation": "TC-002 will pass after implementation"
    },

    {
      "patch_id": "PATCH-v10.20-002",
      "severity": "CRITICAL",
      "gap_id": "GAP-002",
      "name": "Circular Reference Detection",
      "description": "Add circular reference detection to schema loader to prevent infinite loops",
      "affected_sections": ["3.context.system.schema_loader"],
      "implementation": {
        "add_to_schema_loader": {
          "circular_reference_detector": {
            "enabled": true,
            "execution": "DURING_SCHEMA_LOAD",
            "blocking": true,
            "detection_algorithm": {
              "method": "Depth-First Search with visited tracking",
              "max_depth": 100,
              "track_reference_chain": true
            },
            "validation_checks": [
              {
                "check": "self_reference",
                "pattern": "schema.field references itself",
                "severity": "CRITICAL"
              },
              {
                "check": "circular_chain",
                "pattern": "A → B → C → A",
                "severity": "CRITICAL"
              },
              {
                "check": "indirect_circular",
                "pattern": "A → B → C → D → B",
                "severity": "CRITICAL"
              }
            ],
            "on_circular_ref_detected": {
              "action": "BLOCK_SYSTEM_START",
              "message": "Boot validation failed: Circular reference detected in {schema_file}: {reference_chain}",
              "recovery": "Break circular reference and restart",
              "log_chain": true
            }
          }
        }
      },
      "test_validation": "TC-003 will pass after implementation"
    },

    {
      "patch_id": "PATCH-v10.20-003",
      "severity": "WARNING",
      "gap_id": "GAP-003",
      "name": "CPO Classification Disambiguation",
      "description": "Add CPO-specific logic with RAG fallback to determine TA vs general HR focus",
      "affected_sections": ["4.reasoning.deterministic_classification_v1"],
      "implementation": {
        "add_to_classification": {
          "cpo_disambiguation": {
            "trigger": "title contains 'Chief People Officer' OR 'CPO'",
            "method": "RAG-assisted domain inference",
            "process": [
              "Step 1: Check if 'Talent Acquisition' or 'TA' appears in About",
              "Step 2: If yes → classify as SENIOR_TA",
              "Step 3: If no → execute RAG query: '{name} {company} responsibilities talent acquisition recruiting'",
              "Step 4: Analyze RAG results for TA-specific terminology density",
              "Step 5: If TA_density > 0.6 → SENIOR_TA, else → C_LEVEL"
            ],
            "ta_keywords": [
              "talent acquisition",
              "recruiting",
              "recruitment",
              "hiring",
              "talent pipeline",
              "sourcing",
              "candidate"
            ],
            "confidence_thresholds": {
              "high_confidence": 0.9,
              "medium_confidence": 0.75,
              "low_confidence": 0.6
            },
            "fallback_strategy": {
              "if_rag_unavailable": "Prompt user for manual classification",
              "default_if_ambiguous": "SENIOR_TA"
            }
          }
        },
        "update_stage_3_mapping": [
          {
            "priority": 1.5,
            "condition": "CPO & TA_focus_confirmed",
            "output": "SENIOR_TA",
            "confidence": 0.94
          },
          {
            "priority": 1.6,
            "condition": "CPO & HR_general_focus",
            "output": "C_LEVEL",
            "confidence": 0.92
          }
        ]
      },
      "test_validation": "TC-005 will pass after implementation"
    },

    {
      "patch_id": "PATCH-v10.20-004",
      "severity": "CRITICAL",
      "gap_id": "GAP-004",
      "name": "Per-Claim Confidence Enforcement",
      "description": "Implement granular per-claim confidence checking before aggregate calculation",
      "affected_sections": [
        "4.reasoning.rag_validation_framework.confidence_scoring",
        "6.validation.master_validation_gate"
      ],
      "implementation": {
        "enhance_confidence_scoring": {
          "per_claim_validation": {
            "enabled": true,
            "execution_point": "BEFORE_AGGREGATE_CALCULATION",
            "blocking": true,
            "threshold": 0.80,
            "validation_process": [
              "Step 1: Parse K.3 body into atomic claims",
              "Step 2: Calculate confidence for each claim individually",
              "Step 3: Check each claim against 0.80 threshold",
              "Step 4: REJECT any claim below threshold",
              "Step 5: Remove low-confidence claims from body",
              "Step 6: Recalculate aggregate with remaining claims",
              "Step 7: If aggregate still < 0.95, trigger full regeneration"
            ],
            "claim_extraction": {
              "method": "Sentence-level parsing with claim boundary detection",
              "splitters": [".", ";", "and", "while", "by", "which", "that"],
              "ignore_patterns": [
                "greeting",
                "closing",
                "transition_phrases"
              ]
            },
            "confidence_calculation": {
              "base_score": 1.0,
              "deductions": [
                {"condition": "No RAG source found", "penalty": -0.5},
                {"condition": "Metric without source mapping", "penalty": -0.4},
                {"condition": "Company not in whitelist", "penalty": -1.0},
                {"condition": "Role drift (similarity <0.92)", "penalty": -0.3},
                {"condition": "Context coherence <0.80", "penalty": -0.25},
                {"condition": "Temporal inconsistency", "penalty": -0.2},
                {"condition": "Vague/generic language", "penalty": -0.15}
              ]
            },
            "rejection_strategy": {
              "single_claim_below_threshold": {
                "action": "REMOVE_CLAIM",
                "log_message": "Claim '{claim_text}' removed (confidence {score} < 0.80)",
                "regeneration_trigger": "If >2 claims removed or body too short"
              },
              "multiple_claims_below_threshold": {
                "action": "FULL_REGENERATION",
                "log_message": "Multiple low-confidence claims detected, regenerating K.3",
                "strategy": "Increase RAG retrievers, apply stricter validation"
              }
            }
          }
        },
        "add_qa_rule": {
          "LIC-QA-106": {
            "severity": "CRITICAL",
            "check": "Every claim in K.3 has â‰¥0.80 confidence",
            "fix": "Remove low-confidence claims or regenerate",
            "validation_point": "POST_GENERATION",
            "blocking": true
          }
        }
      },
      "test_validation": "TC-011 will pass after implementation"
    },

    {
      "patch_id": "PATCH-v10.20-005",
      "severity": "CRITICAL",
      "gap_id": "GAP-005",
      "name": "Metric Context Coherence Validation",
      "description": "Enforce that metrics appear with required context keywords from source",
      "affected_sections": [
        "4.reasoning.entity_grounding_framework",
        "6.validation.qa_rules"
      ],
      "implementation": {
        "enhance_entity_grounding": {
          "metric_context_validation": {
            "enabled": true,
            "execution_point": "POST_GENERATION",
            "blocking": true,
            "validation_process": [
              "Step 1: Extract all metrics from K.3 body",
              "Step 2: For each metric, lookup required_context_keywords from metric_source_map",
              "Step 3: Extract Â±20 words surrounding metric in K.3",
              "Step 4: Check if â‰¥2 required keywords present in surrounding context",
              "Step 5: If keyword_match_count < 2, REJECT metric usage",
              "Step 6: Calculate context_coherence_score",
              "Step 7: If context_coherence_score < 0.80, REJECT"
            ],
            "context_extraction": {
              "window_size": 20,
              "window_type": "words",
              "direction": "bidirectional",
              "include_sentence": true
            },
            "keyword_matching": {
              "exact_match_weight": 1.0,
              "semantic_match_weight": 0.7,
              "synonym_match_weight": 0.85,
              "min_keywords_required": 2,
              "semantic_similarity_threshold": 0.85
            },
            "coherence_scoring": {
              "formula": "(matched_keywords / required_keywords) * average_similarity",
              "minimum_score": 0.80,
              "penalize_missing_keywords": true
            },
            "on_validation_failure": {
              "action": "REJECT_METRIC_USAGE",
              "message": "Metric '{metric}' missing required context. Required: {keywords}, Found: {found_keywords}",
              "regeneration": true,
              "inject_context_requirements": true
            }
          }
        },
        "update_qa_rule": {
          "LIC-QA-043": {
            "severity": "CRITICAL",
            "check": "Metrics appear with correct context keywords (â‰¥0.80 coherence)",
            "fix": "Regenerate with context requirements injected",
            "validation_point": "POST_GENERATION",
            "blocking": true,
            "enhanced": true
          }
        },
        "add_qa_rule": {
          "LIC-QA-107": {
            "severity": "CRITICAL",
            "check": "Every metric has â‰¥2 required context keywords within Â±20 words",
            "fix": "Add context or remove metric",
            "validation_point": "POST_GENERATION",
            "blocking": true
          }
        }
      },
      "test_validation": "TC-015 will pass after implementation"
