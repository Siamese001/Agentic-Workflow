    {
      "patch_id": "PATCH-v10.20-007",
      "severity": "CRITICAL",
      "gap_id": "GAP-007",
      "name": "Placeholder Detection Patterns",
      "description": "Add comprehensive placeholder detection to prevent generic content in final output",
      "affected_sections": [
        "6.validation.qa_rules",
        "6.validation.master_validation_gate"
      ],
      "implementation": {
        "add_placeholder_detector": {
          "enabled": true,
          "execution_point": "POST_GENERATION",
          "blocking": true,
          "detection_patterns": [
            {
              "pattern": "\\[([A-Z_]+)\\]",
              "description": "Square bracket placeholders [INITIATIVE]",
              "severity": "CRITICAL"
            },
            {
              "pattern": "\\{([A-Z_]+)\\}",
              "description": "Curly brace placeholders {COMPANY}",
              "severity": "CRITICAL"
            },
            {
              "pattern": "__([A-Z_]+)__",
              "description": "Double underscore placeholders __ROLE__",
              "severity": "CRITICAL"
            },
            {
              "pattern": "\\[TBD\\]|\\[TODO\\]|\\[PLACEHOLDER\\]",
              "description": "Common placeholder keywords",
              "severity": "CRITICAL"
            },
            {
              "pattern": "\\{\\{[^}]+\\}\\}",
              "description": "Template variable placeholders {{variable}}",
              "severity": "CRITICAL"
            },
            {
              "pattern": "<[A-Z_]+>",
              "description": "Angle bracket placeholders <METRIC>",
              "severity": "WARNING"
            }
          ],
          "scan_targets": [
            "K.2_subject_line",
            "K.3_body",
            "K.5_cta"
          ],
          "on_detection": {
            "action": "REJECT",
            "error_code": "LIC-QA-067",
            "message": "Placeholder '{placeholder}' detected in {location}",
            "fix": "Replace with specific content or regenerate",
            "regeneration": true
          },
          "exceptions": {
            "allowed_in_templates": true,
            "allowed_in_examples": true,
            "allowed_in_documentation": true
          }
        },
        "enhance_qa_rule": {
          "LIC-QA-067": {
            "severity": "CRITICAL",
            "check": "No placeholders in final output using pattern matching",
            "fix": "Replace placeholder with specific content",
            "validation_point": "POST_GENERATION",
            "blocking": true,
            "enhanced": true,
            "detection_method": "Regex pattern matching across 6 patterns"
          }
        }
      },
      "test_validation": "TC-021 will pass after implementation"
