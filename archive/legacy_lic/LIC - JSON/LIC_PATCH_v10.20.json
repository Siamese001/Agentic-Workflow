    {
      "patch_id": "PATCH-v10.20-008",
      "severity": "CRITICAL",
      "gap_id": "GAP-008",
      "name": "Job Title Position Validator",
      "description": "Enforce job title appears in first 50 words for job-specific messages",
      "affected_sections": [
        "6.validation.qa_rules",
        "6.validation.master_validation_gate"
      ],
      "implementation": {
        "add_job_title_position_validator": {
          "enabled": true,
          "trigger": "job_application_confirmed == true",
          "execution_point": "POST_GENERATION",
          "blocking": true,
          "validation_process": [
            "Step 1: Extract job_title from context",
            "Step 2: Tokenize K.3 body into words",
            "Step 3: Find first occurrence of job_title (exact or high-similarity match)",
            "Step 4: Count word position of first occurrence",
            "Step 5: If position > 50, REJECT",
            "Step 6: If not found at all, REJECT with higher severity"
          ],
          "word_counting": {
            "tokenizer": "whitespace + punctuation",
            "exclude": ["articles", "conjunctions", "prepositions"],
            "count_type": "content_words_only",
            "threshold": 50
          },
          "matching": {
            "exact_match_priority": true,
            "fuzzy_match_threshold": 0.92,
            "case_insensitive": true,
            "allow_partial_match": false
          },
          "validation_outcomes": {
            "found_within_50_words": {
              "action": "ACCEPT",
              "log": "Job title found at position {position}"
            },
            "found_after_50_words": {
              "action": "REJECT",
              "error_code": "LIC-QA-075",
              "message": "Job title '{job_title}' found at position {position}, must be within first 50 words",
              "fix": "Regenerate K.3 with job title in opening"
            },
            "not_found": {
              "action": "REJECT",
              "error_code": "LIC-QA-075",
              "message": "Job title '{job_title}' not found in K.3 body",
              "fix": "Regenerate K.3 with job title explicitly included",
              "severity": "CRITICAL"
            }
          },
          "regeneration_strategy": {
            "inject_constraint": "Job title MUST appear in first sentence or second sentence",
            "template_suggestion": "I'm reaching out about the {job_title} role...",
            "max_retries": 2
          }
        },
        "enhance_qa_rule": {
          "LIC-QA-075": {
            "severity": "CRITICAL",
            "check": "If job_confirmed=true, job_title appears in first 50 words of K.3",
            "fix": "Regenerate K.3 with job title upfront",
            "validation_point": "POST_GENERATION",
            "blocking": true,
            "enhanced": true,
            "implementation": "Word position counter with fuzzy matching"
          }
        }
      },
      "test_validation": "TC-022 will pass after implementation"
