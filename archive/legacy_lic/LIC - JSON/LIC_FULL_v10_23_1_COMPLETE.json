          {
            "rule_id": "string",
            "severity": "CRITICAL | WARNING | INFO",
            "component": "string - which K-node failed",
            "data_source": "string - staging_buffer field",
            "expected": "any",
            "actual": "any",
            "message": "string",
            "suggested_fix": "string"
          }
        ],
        "timestamp": "ISO8601",
        "route": "string",
        "archetype": "string",
        "staging_buffer_snapshot": "object - for debugging"
      }
    }
