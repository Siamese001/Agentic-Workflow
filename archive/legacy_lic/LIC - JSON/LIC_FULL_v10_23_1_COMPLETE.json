    "phase_6_gate": {
      "name": "The Gate: Output Decision",
      "engine": "Master Validation Gate",
      "inputs": ["ValidationResult from QA Engine V2"],
      "outputs": ["Final message file OR failure report (NEVER both)"],
      "blocking": true,

      "gate_decision_pattern": {
        "description": "Exception-based gate that blocks file writes on validation failure",
        "execution_point": "After all validation batches complete",

        "implementation_pseudocode": [
          "# SCOPE ISOLATION VERIFICATION",
          "if 'artist_output' in dir():",
          "    raise ScopeViolationError('artist_output still accessible - scope isolation failed')",
          "",
          "# VALIDATION EXECUTION",
          "try:",
          "    run_validation_batch_1(staging_buffer)  # ONLY staging_buffer parameter",
          "    run_validation_batch_2(staging_buffer)",
          "    run_validation_batch_3(staging_buffer)",
          "    run_validation_batch_4(staging_buffer)",
          "    all_validations_pass = True",
          "except FatalValidationException as e:",
          "    all_validations_pass = False",
          "    failure_report = generate_failure_report(e, staging_buffer)",
          "",
          "# GATE DECISION",
          "if all_validations_pass:",
          "    artist_output = artist_output_backup  # Restore for file rendering",
          "    write_final_message_file(staging_buffer['full_message_actual']['raw_text'])",
          "    display_to_user(staging_buffer['full_message_actual']['raw_text'])",
          "    log_success('All validations passed, message delivered')",
          "else:",
          "    display_failure_report(failure_report)",
          "    DO_NOT_WRITE_FILE",
          "    DO_NOT_DISPLAY_MESSAGE",
          "    log_failure('Validation failed, message blocked')"
        ],

        "success_path": [
          "All validations pass",
          "Restore artist_output_backup for final rendering",
          "Write message file to disk",
          "Display message to user",
          "Log success with metrics"
        ],

        "failure_path": [
          "Any validation fails",
          "Generate failure report with specifics",
          "Display report to user",
          "DO NOT write message file",
          "DO NOT display message",
          "Log failure with details"
        ]
      },

      "FatalValidationException": {
        "description": "Exception raised when critical validation fails",
        "attributes": {
          "rule_id": "string - failed rule ID",
          "message": "string - detailed error message",
          "data_source": "string - staging_buffer field checked",
          "expected": "any - expected value or range",
          "actual": "any - actual measured value from staging_buffer",
          "suggested_fix": "string - remediation guidance"
        }
      },

      "failure_report_format": {
        "result": "BLOCKED",
