        "requirements": [
          "zero_loss",
          "zero_ambiguity",
          "zero_omission",
          "zero_misrepresentation"
        ],
        "record_conformance": true
      }
    },
    "canonical_boundary": {
      "forbid_beyond_sections_1_to_6": true
    },
    "minimal_runtime_inputs": [
      "Recipient archetype",
      "Message type",
      "Governance version pins",
      "Context plan"
    ]
  },
  "2.task": {
    "purpose": "Restructure outreach into the six-section LIC shell and produce a compliant message.",
    "deliverable_target": {
      "rules": [
        "Produce compliant LinkedIn outreach artifact for specified archetype.",
        "Audience options: C_LEVEL, EXECUTIVE, SENIOR_TA, RECRUITER, SHORT_NEW.",
        "Apply strict QA grid; block on failure.",
        "Insert pause marker after Sections 3, 4, and 5."
      ]
    },
    "success_criteria": {
      "output_gate": [
        "LinkedIn QA Grid PASS",
        "Archetype microstructure PASS"
      ],
      "reasoning_gate": [
        "CoT and ToT present in Section 4 when SHOW_REASONING true"
      ]
    }
  },
