{
  "schema_version": "13.0",
  "description": "Externalized agent operational parameters for LIC v13.0 - All agent-specific configurations, thresholds, and behaviors",
  
  "circuit_breaker": {
    "failure_threshold": 3,
    "timeout_seconds": 60,
    "_comment": "Circuit breaker prevents cascade failures by blocking requests after consecutive failures"
  },
  
  "context_manager": {
    "section_priorities": {
      "job_description": 100,
      "recipient_profile": 90,
      "company_context": 80,
      "sender_profile": 70,
      "rag_recent": 60,
      "rag_historical": 40,
      "examples": 30
    },
    "max_context_tokens": 180000,
    "chars_per_token": 4,
    "min_truncated_section_chars": 100,
    "_comment": "Intelligent context window management with priority-based truncation"
  },
  
  "adaptive_temperature_controller": {
    "base_temperatures": {
      "C_LEVEL": 0.45,
      "EXECUTIVE": 0.5,
      "SENIOR_TA": 0.55,
      "RECRUITER": 0.65
    },
    "escalation_step": 0.15,
    "max_temperature": 0.95,
    "max_creative_retries": 3,
    "_comment": "Progressive temperature escalation for retry attempts - each retry increases temperature to encourage creativity"
  },
  
  "signal_quality_scorer": {
    "source_weights": {
      "STRATEGIC_BRIEF": 2.5,
      "RECIPIENT_LINKEDIN_ABOUT": 2.0,
      "RECIPIENT_RECENT_POST": 1.8,
      "COMPANY_BLOG_ANNOUNCEMENT": 1.5,
      "COMPANY_LINKEDIN_PAGE": 1.3,
      "NEWS_ARTICLE_COMPANY": 1.2,
      "COMPETITOR_COMPARISON": 0.9,
      "GENERIC_INDUSTRY_TREND": 0.6,
      "SENDER_PROFILE_ONLY": 0.3,
      "MASTER_RESUME": 2.0,
      "SENDER_KNOWLEDGE_BASE": 1.8
    },
    "minimum_signal_threshold": 0.7,
    "_comment": "v12.0 weights RAG sources by reliability - STRATEGIC_BRIEF is highest signal"
  },
  
  "claim_confidence_scorer": {
    "min_per_claim_confidence": 0.7,
    "min_aggregate_confidence": 0.75,
    "min_word_overlap": 3,
    "confidence_calculation": {
      "supporting_source_weight": 0.3,
      "avg_source_weight": 0.7,
      "source_boost_per_additional": 0.1,
      "max_confidence": 1.0
    },
    "_comment": "Per-claim confidence scoring with rejection gate - ensures all claims are RAG-grounded"
  },
  
  "rag_agent_config": {
    "archetype_params": {
      "C_LEVEL": {
        "total_calls": 24,
        "retrievers": ["linkedin", "company_blog", "news", "industry_reports"],
        "recency_weight": 0.85,
        "depth_priority": "maximum"
      },
      "EXECUTIVE": {
        "total_calls": 18,
        "retrievers": ["linkedin", "company_blog", "news"],
        "recency_weight": 0.75,
        "depth_priority": "high"
      },
      "SENIOR_TA": {
        "total_calls": 16,
        "retrievers": ["linkedin", "github", "tech_blogs", "conference_talks"],
        "recency_weight": 0.7,
        "depth_priority": "technical"
      },
      "RECRUITER": {
        "total_calls": 8,
        "retrievers": ["linkedin", "company_careers"],
        "recency_weight": 0.6,
        "depth_priority": "efficient"
      }
    },
    "max_rag_reflexion_loops": 2,
    "min_signal_for_proceed": 0.7,
    "adversarial_critique_enabled": true,
    "_comment": "Archetype-specific RAG parameters from config_LIC.py ARCHETYPE_RAG_PARAMS"
  },
  
  "reasoning_agent_config": {
    "archetype_params": {
      "C_LEVEL": {
        "max_hops": 6,
        "temperature": 0.45,
        "self_consistency_runs": 12,
        "tot_branches": 16,
        "reasoning_depth": "maximum",
        "synthesis_enabled": true
      },
      "EXECUTIVE": {
        "max_hops": 4,
        "temperature": 0.5,
        "self_consistency_runs": 5,
        "tot_branches": 6,
        "reasoning_depth": "high",
        "synthesis_enabled": true
      },
      "SENIOR_TA": {
        "max_hops": 4,
        "temperature": 0.55,
        "self_consistency_runs": 4,
        "tot_branches": 4,
        "reasoning_depth": "technical",
        "synthesis_enabled": false
      },
      "RECRUITER": {
        "max_hops": 2,
        "temperature": 0.65,
        "self_consistency_runs": 3,
        "tot_branches": 0,
        "reasoning_depth": "efficient",
        "synthesis_enabled": false
      }
    },
    "_comment": "Archetype-specific reasoning configurations from config_LIC.py ARCHETYPE_REASONING_PARAMS"
  },
  
  "profile_analysis_agent": {
    "archetype_indicators": {
      "C_LEVEL": {
        "keywords": ["ceo", "cto", "cfo", "coo", "chief", "president", "founder"],
        "confidence": 0.95
      },
      "EXECUTIVE": {
        "keywords": ["vp", "vice president", "director", "head of", "lead"],
        "confidence": 0.9
      },
      "RECRUITER": {
        "keywords": ["recruiter", "talent", "hiring", "hr"],
        "confidence": 0.92
      },
      "SENIOR_TA": {
        "keywords": ["principal", "staff", "senior", "architect", "tech lead", "engineering manager"],
        "confidence": 0.88
      }
    },
    "default_archetype": "EXECUTIVE",
    "default_confidence": 0.6,
    "manual_override_threshold": 0.75,
    "_comment": "Archetype classification based on title keywords - confidence < 0.75 requires manual override"
  },
  
  "routing_agent": {
    "routing_rules": {
      "CONNECTION_REQ": {
        "conditions": {
          "connection_status": "not_connected",
          "prior_message_count": 0
        },
        "constraints": {
          "word_range": [40, 60],
          "char_limit": 300,
          "subject_required": false
        }
      },
      "INMAIL": {
        "conditions": {
          "connection_status": "not_connected",
          "prior_message_count_gte": 0
        },
        "constraints": {
          "word_range": [180, 250],
          "char_limit": 1900,
          "subject_required": true
        }
      },
      "EMAIL": {
        "conditions": {
          "connection_status": "connected"
        },
        "constraints": {
          "word_range": [200, 350],
          "char_limit": 2500,
          "subject_required": true
        }
      },
      "FOLLOW_UP": {
        "conditions": {
          "prior_message_count_gt": 0
        },
        "constraints": {
          "word_range": [150, 220],
          "char_limit": 1600,
          "subject_required": true
        }
      }
    },
    "_comment": "Routing decision logic based on connection status and message history"
  },
  
  "scaffold_agent": {
    "section_definitions": {
      "INMAIL": {
        "sections": ["subject", "greeting", "opening", "body", "cta", "signature"],
        "word_allocations": {
          "subject": [4, 8],
          "greeting": [2, 5],
          "opening": [20, 40],
          "body": [100, 180],
          "cta": [5, 12],
          "signature": [2, 6]
        },
        "required_sections": ["subject", "greeting", "body", "signature"]
      },
      "CONNECTION_REQ": {
        "sections": ["greeting", "body", "signature"],
        "word_allocations": {
          "greeting": [2, 4],
          "body": [25, 50],
          "signature": [2, 4]
        },
        "required_sections": ["greeting", "body", "signature"]
      },
      "EMAIL": {
        "sections": ["subject", "greeting", "opening", "body", "cta", "signature"],
        "word_allocations": {
          "subject": [4, 10],
          "greeting": [2, 6],
          "opening": [30, 60],
          "body": [120, 250],
          "cta": [6, 15],
          "signature": [3, 8]
        },
        "required_sections": ["subject", "greeting", "body", "signature"]
      },
      "FOLLOW_UP": {
        "sections": ["subject", "greeting", "reference", "body", "cta", "signature"],
        "word_allocations": {
          "subject": [4, 8],
          "greeting": [2, 4],
          "reference": [10, 20],
          "body": [80, 160],
          "cta": [5, 10],
          "signature": [2, 5]
        },
        "required_sections": ["subject", "greeting", "reference", "body", "signature"]
      }
    },
    "lockable_sections": ["greeting", "signature"],
    "_comment": "Message structure definitions for each route"
  },
  
  "generation_agent": {
    "max_generation_attempts": 5,
    "c_level_n_candidates": 3,
    "synthesis_enabled_archetypes": ["C_LEVEL", "EXECUTIVE"],
    "generation_timeout_seconds": 120,
    "_comment": "Generation orchestrator parameters - C_LEVEL uses N-candidate synthesis"
  },
  
  "validation_agent": {
    "max_validation_loops": 10,
    "halt_on_critical": true,
    "halt_on_high": true,
    "regenerate_on_medium": true,
    "log_only_on_info": true,
    "validation_timeout_seconds": 30,
    "_comment": "Validation execution parameters and severity handling"
  },
  
  "gate_decision_agent": {
    "_comment": "NEW v13.0: HOP-7 agent that makes the Slow Loop decision",
    "factual_failure_rules": [
      "LIC-QA-201",
      "LIC-QA-106",
      "LIC-QA-105",
      "LIC-QA-043",
      "LIC-QA-003"
    ],
    "max_factual_loops": 2,
    "max_creative_retries": 3,
    "loop_decision_logic": {
      "FACTUAL_FAILURE": "raise FactualGapError -> trigger S6->S2 meta-loop",
      "CREATIVE_FAILURE": "raise CreativeFailureError -> HALT workflow",
      "PASS": "return True -> proceed to output"
    }
  },
  
  "sender_grounding_agent": {
    "_comment": "NEW v13.0: HOP-3 agent that extracts sender capabilities from master_resume.json and sender_knowledge_base.json",
    "source_files": [
      "master_resume.json",
      "sender_knowledge_base.json"
    ],
    "extraction_targets": {
      "team_members": "whitelisted_team_members",
      "products": "whitelisted_products",
      "case_studies": "whitelisted_case_studies",
      "quantifiable_achievements": "quantifiable_achievements"
    },
    "output_format": "SenderGroundingWhitelists dataclass"
  },
  
  "research_agent": {
    "_comment": "NEW v13.0: HOP-2 agent - queries vector store first, uses fallback RAG for gaps",
    "vector_store_query_params": {
      "n_results": 20,
      "similarity_threshold": 0.7
    },
    "fallback_rag_params": {
      "max_searches": 10,
      "search_timeout_seconds": 60,
      "pdf_parsing_enabled": true
    },
    "cache_critique_params": {
      "min_confidence_score": 0.7,
      "min_recency_days": 90,
      "min_recipient_specific_count": 3
    },
    "strategic_brief_params": {
      "required": true,
      "min_overlap_keywords": 3,
      "search_queries": [
        "{company} strategic priorities",
        "{company} {year} roadmap",
        "{recipient_name} recent presentations"
      ]
    }
  },
  
  "qa_report_agent": {
    "_comment": "NEW v13.0: HOP-8 agent that generates final QA_Report.md",
    "report_sections": [
      "executive_summary",
      "archetype_route_selection",
      "research_quality_assessment",
      "generation_strategy",
      "validation_results",
      "loop_execution_details",
      "final_message_quality_score",
      "recommendations"
    ],
    "scoring_weights": {
      "research_quality": 0.3,
      "strategic_alignment": 0.3,
      "validation_pass_rate": 0.2,
      "loop_efficiency": 0.1,
      "generation_quality": 0.1
    },
    "output_file": "QA_Report.md",
    "markdown_formatting": true
  },
  
  "state_manager": {
    "_comment": "NEW v13.0: Manages read/write of state files for HOP architecture",
    "state_directory": "state",
    "state_file_format": "json",
    "create_directory_if_missing": true,
    "atomic_writes": true,
    "compression": false
  },
  
  "hop_execution_order": {
    "_comment": "NEW v13.0: Formal execution order for HOP-based architecture",
    "hops": [
      {
        "hop_id": "HOP-1",
        "agent": "ProfileAnalysisAgent",
        "input_files": ["mission_input_LIC.json"],
        "output_file": "1_profile_analysis.json"
      },
      {
        "hop_id": "HOP-2",
        "agent": "ResearchAgent",
        "input_files": ["1_profile_analysis.json"],
        "output_file": "2_research_context.json"
      },
      {
        "hop_id": "HOP-3",
        "agent": "SenderGroundingAgent",
        "input_files": ["master_resume.json", "sender_knowledge_base.json"],
        "output_file": "3_sender_grounding.json"
      },
      {
        "hop_id": "HOP-4",
        "agent": "RoutingAgent",
        "input_files": ["1_profile_analysis.json", "mission_input_LIC.json"],
        "output_file": "4_routing_decision.json"
      },
      {
        "hop_id": "HOP-4.5",
        "agent": "ScaffoldAgent",
        "input_files": ["4_routing_decision.json", "1_profile_analysis.json"],
        "output_file": "4.5_scaffold.json"
      },
      {
        "hop_id": "HOP-5",
        "agent": "GenerationAgent",
        "input_files": ["2_research_context.json", "3_sender_grounding.json", "4.5_scaffold.json"],
        "output_file": "5_generated_drafts.json"
      },
      {
        "hop_id": "HOP-6",
        "agent": "ValidationAgent",
        "input_files": ["5_generated_drafts.json", "2_research_context.json"],
        "output_file": "6_validation_report.json"
      },
      {
        "hop_id": "HOP-7",
        "agent": "GateDecisionAgent",
        "input_files": ["6_validation_report.json"],
        "output_file": "7_gate_decision.json",
        "_comment": "Makes Slow Loop decision: FACTUAL->loop to HOP-2, CREATIVE->HALT, PASS->proceed"
      },
      {
        "hop_id": "HOP-8",
        "agent": "QAReportAgent",
        "input_files": ["state/*"],
        "output_file": "QA_Report.md"
      }
    ]
  },
  
  "tone_mappings": {
    "_comment": "Archetype-specific tone configurations from config_LIC.py ARCHETYPE_TONE_MAPPINGS",
    "C_LEVEL": {
      "message_tone": "strategic",
      "verb_preference": ["discuss", "align", "explore", "advance"],
      "jargon_level": "strategic",
      "formality": "very high"
    },
    "EXECUTIVE": {
      "message_tone": "professional",
      "verb_preference": ["collaborate", "discuss", "connect", "share"],
      "jargon_level": "professional",
      "formality": "high"
    },
    "SENIOR_TA": {
      "message_tone": "technical_peer",
      "verb_preference": ["build", "implement", "architect", "optimize"],
      "jargon_level": "technical",
      "formality": "moderate"
    },
    "RECRUITER": {
      "message_tone": "warm_professional",
      "verb_preference": ["match", "connect", "support", "assist"],
      "jargon_level": "minimal",
      "formality": "moderate"
    }
  },
  
  "word_count_targets": {
    "_comment": "Archetype-specific word count targets from config_LIC.py ARCHETYPE_WORD_TARGETS",
    "C_LEVEL": {
      "INMAIL": 240,
      "FOLLOW_UP": 160,
      "CONNECTION_REQ": null,
      "EMAIL": 350
    },
    "EXECUTIVE": {
      "INMAIL": 225,
      "FOLLOW_UP": 150,
      "CONNECTION_REQ": null,
      "EMAIL": 325
    },
    "SENIOR_TA": {
      "INMAIL": 220,
      "FOLLOW_UP": 148,
      "CONNECTION_REQ": null,
      "EMAIL": 310
    },
    "RECRUITER": {
      "INMAIL": 200,
      "FOLLOW_UP": 140,
      "CONNECTION_REQ": null,
      "EMAIL": 275
    }
  }
}
