  "5.output": {
    "description": "The 'Assembler' phase of the workflow.",
    "assembly_engine": {
      "policy": "ITERATE_ALL_VALIDATE_AND_RENDER",
      "steps": [
        "RENDER_MAIN_HEADER",
        "RENDER_EXECUTIVE_SUMMARY",
        "ITERATE_AND_RENDER_EXPERIENCE_BLOCKS",
        "RENDER_COMPETENCIES",
        "RENDER_COVER_LETTER",
        "GENERATE_OPTIMIZED_SKILLS_LIST"
      ],
      "validation_gates": [
        {
          "gate_id": "VG_CREATIVE_BRIEF_ADHERENCE",
          "policy": "ENFORCE_ALL_CREATIVE_BRIEF_CONSTRAINTS"
        },
        {
          "gate_id": "VG_HEADER_INTEGRITY_CHECK",
          "policy": "STRICT_COMPARE_HEADER_TO_SCAFFOLD"
        },
        {
          "gate_id": "VG_BULLET_PROVENANCE_CHECK",
          "policy": "VALIDATE_BULLET_ORIGIN_AND_METRICS"
        },
        {
          "gate_id": "VG_REDUNDANCY_CHECK",
          "policy": "ENFORCE_GLOBAL_DEDUPLICATION_MATRIX"
        },
        {
          "gate_id": "VG_NATURAL_HYPHEN_PRESERVATION",
          "policy": "ENFORCE_HYPHENATION_RULES_JSON"
        },
        {
          "gate_id": "VG_COMPETENCY_WORD_COUNT_BALANCE",
          "policy": "VALIDATE_WORD_COUNT_VARIANCE"
        },
        {
          "gate_id": "VG_BULLET_PUNCTUATION",
          "policy": "ENSURE_ALL_BULLETS_END_WITH_PERIOD"
        },
        {
          "gate_id": "VG_SUMMARY_VOICE_TENSE",
          "policy": "ENFORCE_THIRD_PERSON_PAST_TENSE"
        },
        {
          "gate_id": "VG_AGENTIC_OUTPUT_VALIDATION",
          "policy": "ENSURE_DETAILED_TRACE_NOT_SUMMARY"
        }
      ]
    },
    "resume_filename_generator": {
      "format": "Amit_Ayer_Resume_{company_name_sanitized}_{job_title_sanitized}_{jr_suffix}_v{date}.docx",
      "logic": "Sanitize company (max 20 chars) and job title (max 25 chars), replacing special characters with underscores. Conditionally add '_JR_' suffix if sanitized job title is less than 8 characters. Format date as MMDDYYYY."
    },
    "formatters": {
      "date_formatter": {
        "input": "YYYY-MM-DD",
        "output": "MM-DD-YYYY"
      }
    }
  },
  "6.conditions": {
    "description": "The inviolable, hardcoded rules of the v56.2 architecture.",
    "critical_rules": [
      "The 'Artist' (LLM) is forbidden from generating any factual data. All such data MUST originate from the 'Clerk's' scaffold.",
      "The 'Artist' (LLM) MUST strictly adhere to all constraints defined in the '/4.reasoning/creative_brief'.",
      "The workflow MUST halt if the 'Clerk' phase fails to extract a complete and structurally valid data scaffold.",
      "The 'Assembler' phase MUST pass all defined validation gates before rendering the final output.",
      "The system will not attempt to access any external URLs for file ingestion. All source data must be provided directly by the user."
    ],
    "agentic_rag_hardening_policy": {
      "name": "Multi-Stage Signal Quality Pipeline",
      "stages": [
        {
          "stage": 1,
          "name": "Relevance Filtering",
          "method": "Two-stage retrieval with a cross-encoder reranker to find the most semantically relevant documents."
        },
        {
          "stage": 2,
          "name": "Source Authority Tiering",
          "method": "Prioritize information from higher-tier sources (e.g., Tier 1: Official company sites) over lower-tier sources (e.g., Tier 3: Forums)."
        },
        {
          "stage": 3,
          "name": "Query Enhancement (Conditional)",
          "method": "For sparse queries, use Hypothetical Document Embeddings (HyDE) to find documents similar to a generated ideal answer."
        },
        {
          "stage": 4,
          "name": "Self-Critique Guardrail",
          "method": "Before generation, the agent must validate that the retrieved context directly and unambiguously supports the statement it is about to generate."
        },
        {
          "stage": 5,
          "name": "External Fact-Checking",
          "method": "Verify key claims against a designated external fact-checking service endpoint."
        }
      ],
      "failure_recovery_path": {
        "name": "Hop Refinement",
        "logic": "On search failure, first increase search breadth. If still fails, switch to a HyDE-guided query. Max 2 refinements."
      }
    },
    "credibility_markers": [
      {
        "type": "currency",
        "format": "$##M"
      },
      {
        "type": "percentage",
        "format": "##%"
      }
    ],
    "agentic_guardrails": {
      "max_reasoning_depth": 7,
      "max_self_correction_loops": 3
    },
    "version_pinning": {
      "App_Schema_v4.json": "v4.0.0",
      "App_Tracker_QA_v5.json": "v5.0.0"
    }
  },
  "7.post_submission": {
    "description": "Handles the generation of the final tracker entry after a successful run.",
    "schema_transformation_gate": {
      "gate_id": "VG-FINAL-SCHEMA-TRANSFORM",
      "execution_point": "BEFORE_TRACKER_GENERATION",
      "blocking": true,
      "policy": "MAP_AND_VALIDATE_TO_SCHEMA",
      "schema_source_of_truth": "App_Schema_v4.json",
      "qa_spec_source_of_truth": "App_Tracker_QA_v5.json",
      "on_unmapped_key": "DROP_FIELD_SILENTLY",
      "on_validation_failure": "HALT_AND_REPORT",
      "key_map": {
        "company_name": "Company",
        "category": "Category",
        "sub_category": "Sub-Category",
        "job_title": "Job Title",
        "primary_job_role": "Primary Job Role",
        "job_url": "JD URL"
      },
      "validation_gates": [
        {
          "gate_id": "VG_NO_SILENT_TRUNCATION",
          "policy": "HALT_ON_POTENTIAL_DATA_LOSS"
        },
        {
          "gate_id": "VG_CONTROLLED_VOCABULARY",
          "policy": "VALIDATE_ENUMS_AGAINST_QA_SPEC"
        }
      ]
    }
  },
  "8.audit": {
    "decoupled_audit_renderer": {
      "enabled": true,
      "log_source": "execution_log.json",
      "l_series_templates": {
        "L1": "Summary of actions and decisions.",
        "L2": "Detailed step-by-step execution trace.",
        "L3": "Exhaustive trace with full data payloads."
      }
    }
  }
