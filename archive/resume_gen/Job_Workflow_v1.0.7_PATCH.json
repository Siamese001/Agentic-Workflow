  "integrated_validation_gates": {
    "description": "Unified validation gates merging v1.0.6 prose quality enforcement with v1.0.5 P0 defect fixes",
    
    "VG_PROSE_QUALITY_COMPLIANCE_V1_0_7": {
      "gate_id": "VG_PROSE_QUALITY_COMPLIANCE_V1_0_7",
      "version": "1.0.7",
      "execution_point": "POST_GENERATION_PRE_FILE_WRITE",
      "blocking": true,
      "severity": "CRITICAL",
      "description": "Comprehensive prose quality validation merging v1.0.6 synthesis checks with v1.0.5 P0 validation requirements",
      
      "checks": [
        {
          "check_id": "K.1_narrative_structure_v1_0_7",
          "source": "v1.0.5 P0-003 + v1.0.6 prose enforcement",
          "validation": "6-sentence arc, NO bullet-like content, synthesize umbrella statements",
          "components": {
            "sentence_count_check": {
              "requirement": "Exactly 6 sentences",
              "tolerance": 0,
              "on_fail": "REGENERATE_WITH_STRUCTURE_ENFORCEMENT"
            },
            "sentence_structure_validation": {
              "sentence_1": {
                "prescribed_pattern": "Industry + years + outcomes + through technology",
                "industry_first_check": true,
                "validation_keywords": {
                  "industry_sector_terms": ["financial services", "technology", "healthcare", "manufacturing", "retail", "insurance", "payments"],
                  "years_experience": ["years", "decades"],
                  "outcomes_terms": ["delivering", "driving", "achieving", "transforming"],
                  "technology_subordination": ["through", "via", "leveraging", "using"]
                }
              },
              "sentences_2_3": {
                "prescribed_pattern": "Quantified business impact - umbrella statements",
                "validation_keywords": {
                  "quantified_metrics": ["$", "%", "M", "B", "revenue", "cost", "efficiency", "growth"],
                  "business_impact_verbs": ["increased", "reduced", "improved", "optimized", "generated"]
                }
              },
              "sentences_4_5": {
                "prescribed_pattern": "Leadership scope and organizational impact",
                "validation_keywords": {
                  "leadership_terms": ["led", "directed", "managed", "oversaw", "guided", "spearheaded"],
                  "scope_indicators": ["team", "organization", "department", "division", "business unit", "cross-functional"]
                }
              },
              "sentence_6": {
                "prescribed_pattern": "Advanced capability with business application",
                "validation_keywords": {
                  "capability_terms": ["expertise", "proficiency", "specialization", "mastery"],
                  "business_application": ["business", "strategic", "commercial", "operational", "value"]
                }
              }
            },
            "bullet_like_content_detection": {
              "forbidden_patterns": [
                "Deployed [technology]",
                "Built [specific system]",
                "Implemented [tool]",
                "Led [single project]"
              ],
              "on_detect": "REGENERATE_WITH_SYNTHESIS_MANDATE"
            },
            "cosine_similarity_to_bullets": {
              "method": "Calculate cosine to all 13 bullets (7 K.5A + 6 K.6A)",
              "threshold": "<0.6 for EACH bullet",
              "total_checks": 13,
              "on_exceed": "REGENERATE_WITH_PARAPHRASE_PROHIBITION"
            }
          },
          "qa_report_output": {
            "table_name": "k1_narrative_structure_validation_v1_0_7",
            "columns": [
              "sentence_number",
              "prescribed_content",
              "actual_sentence_preview",
              "word_count",
              "structure_compliance",
              "keyword_validation",
              "status"
            ],
            "row_count": 6
          }
        },
        {
          "check_id": "K.5B_synthesis_quality_v1_0_7",
          "source": "v1.0.6 overview synthesis + v1.0.5 P0-001 deduplication",
          "validation": "Business function opening, cosine <0.6 to each K.5A bullet, baseline <0.75",
          "components": {
            "business_function_opening": {
              "requirement": "First 5 words use tier 2 business vocabulary",
              "tier_2_vocabulary": ["transformation", "growth", "operations", "strategy", "delivery", "led", "directed", "oversaw"],
              "on_fail": "REGENERATE_WITH_BUSINESS_FUNCTION_CONSTRAINT"
            },
            "cosine_similarity_to_bullets": {
              "method": "Calculate cosine to all 7 K.5A bullets",
              "threshold": "<0.6 for EACH bullet",
              "total_checks": 7,
              "on_exceed": "REGENERATE_WITH_SYNTHESIS_MANDATE"
            },
            "keyword_overlap": {
              "threshold": "≥0.35 with bullet pool",
              "on_fail": "REGENERATE_WITH_COHERENCE_REQUIREMENT"
            },
            "baseline_similarity": {
              "method": "Calculate cosine to master_baseline_unify_overview",
              "threshold": "<0.75 (strict boundary - 0.75 fails)",
              "on_exceed": "REGENERATE_WITH_DIFFERENTIATION_MANDATE"
            }
          },
          "qa_report_output": {
            "deduplication_table": {
              "table_name": "k5b_bullet_deduplication_matrix",
              "columns": ["section", "overview_vs_bullet", "cosine_score", "threshold", "margin", "status"],
              "row_count": 7
            },
            "baseline_similarity_table": {
              "table_name": "k5b_baseline_similarity",
              "columns": ["section", "customized_overview", "master_baseline", "cosine_score", "threshold", "boundary_policy", "margin", "status"],
              "row_count": 1
            }
          }
        },
        {
          "check_id": "K.6B_synthesis_quality_v1_0_7",
          "source": "v1.0.6 overview synthesis + v1.0.5 P0-001 deduplication",
          "validation": "Business function opening, cosine <0.6 to each K.6A bullet, baseline <0.75",
          "components": {
            "business_function_opening": "SAME_AS_K5B",
            "cosine_similarity_to_bullets": {
              "method": "Calculate cosine to all 6 K.6A bullets",
              "threshold": "<0.6 for EACH bullet",
              "total_checks": 6,
              "on_exceed": "REGENERATE_WITH_SYNTHESIS_MANDATE"
            },
            "keyword_overlap": {
              "threshold": "≥0.35 with bullet pool",
              "on_fail": "REGENERATE_WITH_COHERENCE_REQUIREMENT"
            },
            "baseline_similarity": {
              "method": "Calculate cosine to master_baseline_ibm_overview",
              "threshold": "<0.75 (strict boundary - 0.75 fails)",
              "on_exceed": "REGENERATE_WITH_DIFFERENTIATION_MANDATE"
            }
          },
          "qa_report_output": {
            "deduplication_table": {
              "table_name": "k6b_bullet_deduplication_matrix",
              "columns": ["section", "overview_vs_bullet", "cosine_score", "threshold", "margin", "status"],
              "row_count": 6
            },
            "baseline_similarity_table": {
              "table_name": "k6b_baseline_similarity",
              "columns": ["section", "customized_overview", "master_baseline", "cosine_score", "threshold", "boundary_policy", "margin", "status"],
              "row_count": 1
            }
          }
        },
        {
          "check_id": "K.8_complete_ranking_v1_0_7",
          "source": "v1.0.6 competency validation",
          "validation": "Full 1-6 order, positions 1-2 industry/leadership, positions 1-3 no technology",
          "components": {
            "positions_1_2_validation": {
              "requirement": "MUST be tier 1 (industry) or tier 2 (leadership)",
              "on_fail": "AUTO_REORDER_OR_REGENERATE"
            },
            "positions_1_3_technology_prohibition": {
              "requirement": "CANNOT be tier 3 (technology)",
              "on_fail": "SWAP_WITH_TIER_1_OR_2_FROM_LOWER_POSITIONS"
            },
            "auto_classification": {
              "enabled": true,
              "method": "Classify each competency as tier 1/2/3, reorder if violations detected"
            }
          }
        }
      ],
      
      "max_regeneration_attempts": 3,
      "on_exhaustion": "HALT_WITH_PROSE_QUALITY_FAILURE_REPORT"
    }
  },

