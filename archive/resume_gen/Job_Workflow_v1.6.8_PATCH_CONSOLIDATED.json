      "change_id": "C-1.6.8-004",
      "gap_reference": "GAP: Skills Count (8-12)",
      "description": "Add VG_SKILL_COUNT_COMPLIANCE gate to validate K.11 skill count range",
      "section": "5.output.validation_gates",
      "action": "APPEND",
      "content": {
        "VG_SKILL_COUNT_COMPLIANCE": {
          "description": "Validates K.11 skill count within range 8-12. Reads from staging_buffer, cannot access artist_output.",
          "execution_point": "POST_K11_GENERATION",
          "blocking": true,
          "severity": "HIGH",
          "reads_from": "staging_buffer['K.11'] ONLY",
          "cannot_access": "artist_output (scope isolated)",
          "staging_buffer_processing_required": {
            "note": "K.11 must be added to staging buffer creation",
            "section": "5.output.staging_buffer_creation.implementation_algorithm.processing_steps",
            "required_structure": {
              "K.11": {
                "extract": "artist_output.get('K.11', {}).get('skills', [])",
                "process_each_skill": {
                  "strip_tags": "Remove ALL <tags> and [MARKERS]",
                  "calculate": {
                    "skill_text": "cleaned_text",
                    "skill_number": "Extract leading number if present"
                  }
                },
                "store": {
                  "skills": "array of skill texts",
                  "total_skills": "len(skills)"
                }
              }
            }
          },
          "validation_method": {
            "source": "staging_buffer['K.11']['skills']",
            "calculate": "len(skills)",
            "min": "GLOBAL_ENFORCEMENT_SPEC.generation_logic.skill_count_range.min (8)",
            "max": "GLOBAL_ENFORCEMENT_SPEC.generation_logic.skill_count_range.max (12)",
            "on_below_min": {
              "action": "raise ValidationException",
              "message": "K.11 skill count below minimum. Expected: 8-12, Actual: {actual_count}",
              "regenerate": true,
              "max_attempts": 3
            },
            "on_above_max": {
              "action": "raise ValidationException",
              "message": "K.11 skill count above maximum. Expected: 8-12, Actual: {actual_count}",
              "regenerate": true,
              "max_attempts": 3
            }
          },
          "qa_report_integration": {
            "section": "7.1",
            "content": [
              "**K.11 Skill Count Validation**",
              "- Expected Range: 8-12 skills",
              "- Actual Count: {actual_count}",
              "- Status: ✅ PASS / ❌ FAIL"
            ]
