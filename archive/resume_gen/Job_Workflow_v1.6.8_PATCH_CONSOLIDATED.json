    {
      "change_id": "C-1.6.8-005",
      "gap_reference": "GAP: Summary Sentence Count (6)",
      "description": "Add VG_EXECUTIVE_SUMMARY_STRUCTURE_COMPLIANCE gate to validate K.1 sentence count and structure",
      "section": "5.output.validation_gates",
      "action": "APPEND",
      "content": {
        "VG_EXECUTIVE_SUMMARY_STRUCTURE_COMPLIANCE": {
          "description": "Validates K.1 executive summary structure: exactly 6 sentences, narrative arc style, no bullet-like formatting. Reads from staging_buffer, cannot access artist_output.",
          "execution_point": "POST_K1_GENERATION",
          "blocking": true,
          "severity": "CRITICAL",
          "reads_from": "staging_buffer['K.1'] ONLY",
          "cannot_access": "artist_output (scope isolated)",
          "validation_method": {
            "sentence_count_validation": {
              "source": "staging_buffer['K.1']['rendered_text']",
              "calculate": "staging_buffer['K.1']['sentence_count']",
              "expected": "GLOBAL_ENFORCEMENT_SPEC.validation_rules.executive_summary_structure.sentence_count (6)",
              "tolerance": 0,
              "on_mismatch": {
                "action": "raise ValidationException",
                "message": "K.1 sentence count violation. Expected: exactly 6, Actual: {actual_count}",
                "detail": "First 200 chars: '{text_preview}'",
                "regenerate": true,
                "max_attempts": 3
              }
            },
            "bullet_like_detection": {
              "description": "Detects bullet-like formatting forbidden in K.1",
              "source": "staging_buffer['K.1']['rendered_text']",
              "patterns_to_detect": [
                "^\\s*[•\\-\\*\\+]",
                "\\n\\s*[•\\-\\*\\+]",
                "^\\s*\\d+\\.",
                "\\n\\s*\\d+\\."
              ],
              "on_detected": {
                "action": "raise ValidationException",
                "message": "K.1 contains forbidden bullet-like formatting. Pattern detected: '{detected_pattern}'",
                "halt": true
              }
            },
            "narrative_arc_heuristic": {
              "description": "Basic check for narrative flow (not exhaustive)",
              "source": "staging_buffer['K.1']['rendered_text']",
              "checks": [
                {
                  "check": "sentence_length_variation",
                  "method": "Calculate length of each sentence",
                  "heuristic": "Flag if all sentences <15 words or all >40 words",
                  "on_monotonous": {
                    "action": "WARNING",
                    "message": "K.1 may lack narrative depth (monotonous sentence length)"
                  }
                },
                {
                  "check": "opening_sentence_structure",
                  "method": "Verify first sentence contains industry + years pattern",
                  "heuristic": "Industry keyword appears in first 10 words",
                  "on_missing": {
                    "action": "WARNING",
                    "message": "K.1 opening may not follow industry-first pattern"
                  }
                }
              ]
            },
            "forbidden_content_validation": {
              "description": "Validates absence of bullet-like content per GLOBAL_ENFORCEMENT_SPEC",
              "forbidden_content": "GLOBAL_ENFORCEMENT_SPEC.validation_rules.executive_summary_structure.forbidden_content",
              "check": "bullet-like formatting not present (already covered by bullet_like_detection)"
            }
          },
          "qa_report_integration": {
            "section": "4.2",
            "subsections": {
              "4.2.1": {
                "name": "Sentence Count Validation",
                "format": "text",
                "content": [
                  "**Expected Sentence Count:** 6",
                  "**Actual Sentence Count:** {actual_count}",
                  "**Status:** ✅ PASS / ❌ FAIL"
                ]
              },
              "4.2.2": {
                "name": "Bullet-Like Pattern Detection",
                "format": "text",
                "content": [
                  "**Patterns Checked:** Bullet markers (•, -, *, +), Numbered lists (1., 2., ...)",
                  "**Patterns Detected:** {detected_patterns}",
                  "**Status:** ✅ PASS (none detected) / ❌ FAIL (patterns found)"
                ]
              },
              "4.2.3": {
                "name": "Narrative Arc Heuristic",
                "format": "markdown_table",
                "columns": ["Sentence", "Word Count", "Status"],
                "rows": [
                  {"sentence": 1, "word_count": "{s1_words}", "status": "✅/⚠️"},
                  {"sentence": 2, "word_count": "{s2_words}", "status": "✅/⚠️"},
                  {"sentence": 3, "word_count": "{s3_words}", "status": "✅/⚠️"},
                  {"sentence": 4, "word_count": "{s4_words}", "status": "✅/⚠️"},
                  {"sentence": 5, "word_count": "{s5_words}", "status": "✅/⚠️"},
                  {"sentence": 6, "word_count": "{s6_words}", "status": "✅/⚠️"}
                ]
              }
            }
          },
          "on_pass": "Log '✅ VG_EXECUTIVE_SUMMARY_STRUCTURE_COMPLIANCE: K.1 has 6 sentences, no bullet-like content'",
          "on_fail": "RAISE_EXCEPTION_NO_FILES_WRITTEN"
        }
      }
    },

