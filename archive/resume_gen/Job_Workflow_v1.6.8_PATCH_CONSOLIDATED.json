    {
      "change_id": "C-1.6.8-001",
      "gap_reference": "GAP: Headline Word Count (4 words/segment)",
      "description": "Add VG_HEADLINE_WORD_COUNT_COMPLIANCE gate to validate K.4 word count per segment",
      "section": "5.output.validation_gates",
      "action": "APPEND",
      "content": {
        "VG_HEADLINE_WORD_COUNT_COMPLIANCE": {
          "description": "Validates K.4 headline word count: max 4 words per segment. Reads from staging_buffer, cannot access artist_output.",
          "execution_point": "POST_K4_GENERATION",
          "blocking": true,
          "severity": "CRITICAL",
          "reads_from": "staging_buffer['K.4'] ONLY",
          "cannot_access": "artist_output (scope isolated)",
          "validation_method": {
            "source": "staging_buffer['K.4']['rendered_text']",
            "parse_segments": "rendered_text.split('|')",
            "validate_each_segment": {
              "strip_whitespace": "segment.strip()",
              "calculate_words": "len(segment.strip().split())",
              "max_words": "GLOBAL_ENFORCEMENT_SPEC.word_counts.K.4_headline.max (4)",
              "on_exceed": {
                "action": "raise ValidationException",
                "message": "K.4 segment {segment_index} exceeds 4-word limit. Actual: {actual_words} words. Text: '{segment_text}'",
                "regenerate": true,
                "max_attempts": 3
              }
            },
            "empty_segment_check": {
              "check": "len(segment.strip()) == 0",
              "action": "HALT_WITH_MESSAGE: 'K.4 contains empty segment at position {segment_index}'"
            }
          },
          "qa_report_integration": {
            "section": "2.2",
            "table": {
              "columns": ["Segment", "Text", "Word Count", "Limit", "Status"],
              "rows": [
                {
                  "segment": 1,
                  "text": "{segment_1_text}",
                  "word_count": "{segment_1_words}",
                  "limit": 4,
                  "status": "✅ if ≤4, ❌ if >4"
                },
                {
                  "segment": 2,
                  "text": "{segment_2_text}",
                  "word_count": "{segment_2_words}",
                  "limit": 4,
                  "status": "✅ if ≤4, ❌ if >4"
                },
                {
                  "segment": 3,
                  "text": "{segment_3_text}",
                  "word_count": "{segment_3_words}",
                  "limit": 4,
                  "status": "✅ if ≤4, ❌ if >4"
                }
              ]
            }
          },
          "on_pass": "Log '✅ VG_HEADLINE_WORD_COUNT_COMPLIANCE: All segments ≤4 words'",
          "on_fail": "RAISE_EXCEPTION_NO_FILES_WRITTEN"
        }
      }
    },

