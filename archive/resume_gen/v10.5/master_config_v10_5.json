    "v10_5_changes": [
      "SCHEMA_VERSION: Updated to v10.5",
      "FILE_PATHS: All logs/dbs updated to v10_5 versions.",
      "FIX_2 (Dynamic Routing): Added '_simple' (Flash) and '_complex' (Pro/Opus) variants for strategy, prompt_engineer, and react_conductor models.",
