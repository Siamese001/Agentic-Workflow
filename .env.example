# Agentic Workflow — Environment Variables
# Copy this file to .env and fill in your API keys

# =============================================================================
# X1D LLM Judge Providers (for executive summary evaluation)
# =============================================================================

# Gemini Pro (Google AI)
# Get key from: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI ChatGPT
# Get key from: https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude
# Get key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# =============================================================================
# X1D executive-summary judge models (apps_rg/runtime/judges/executive_summary_x1d.py)
# App-specific vars take precedence over generic provider model env vars below.
# =============================================================================
# Preferred for X1D Gemini judge (overrides GEMINI_MODEL when set):
# APPS_RG_GEMINI_JUDGE_MODEL=gemini-2.0-flash
# Preferred for X1D Anthropic judge (overrides ANTHROPIC_MODEL when set):
# APPS_RG_ANTHROPIC_JUDGE_MODEL=claude-3-5-sonnet-20241022
# Optional: on 404 model not found only, try ANTHROPIC_MODEL then code default (never silent):
# APPS_RG_ANTHROPIC_ALLOW_MODEL_FALLBACK=false

# =============================================================================
# Optional: Generic provider default models (used when APPS_RG_*_JUDGE_MODEL unset)
# =============================================================================
# GEMINI_MODEL=gemini-2.0-flash
# OPENAI_MODEL=gpt-4o
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# =============================================================================
# Qwen/vLLM Provider (local inference)
# =============================================================================

# Base URL for vLLM server (default: http://localhost:8000/v1)
# VLLM_BASE_URL=http://localhost:8000/v1

# Qwen model name (default: Qwen/Qwen2.5-32B-Instruct-AWQ)
# QWEN_VLLM_MODEL=Qwen/Qwen2.5-32B-Instruct-AWQ

# Timeout for Qwen requests in seconds (default: 60)
# APPS_RG_QWEN_TIMEOUT_SECONDS=60

# =============================================================================
# Other MCP/Integration Keys (if needed)
# =============================================================================

# Tavily API key for web search
# TAVILY_API_KEY=your_tavily_api_key_here

# Notion integration token (if using Notion MCP)
# NOTION_INTEGRATION_TOKEN=your_notion_token_here

# Context7 API key (optional, for library docs)
# CONTEXT7_API_KEY=your_context7_api_key_here
