# Template — copy to .env and fill in. Reference: docs/reference/environment/env-reference.md

# --- Core LLM providers (required — all configured in CI secrets and local .env) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- Model pinning (deployment-variable) ---
# Defaults track agentic_core/L0_routing/config/model_registry.py SSOT (refreshed 2026-05-01).
# Consensus jury (L1 consensus_validator + W2b cert jury): OPENAI_MODEL + ANTHROPIC_MODEL + GEMINI_PRO_MODEL.
# Healing tiers (L2 healers): GEMINI_MODEL=flash (cheap), GEMINI_PRO_MODEL=pro (escalation).

# Healing tier LOW — flash (cheap/fast cloud)
GEMINI_MODEL=gemini-3-flash-preview
# Healing tier LOW — pro escalation (structural/novel failures) AND Google juror on consensus jury
GEMINI_PRO_MODEL=gemini-3.1-pro-preview
# Optional: override just the flash tier without touching GEMINI_MODEL (read by gemini_gateway_provisioner)
GEMINI_FLASH_MODEL=

# OpenAI juror (consensus jury)
OPENAI_MODEL=gpt-5.4-mini
# Anthropic juror (consensus jury)
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: comma-separated override of the full consensus juror set.
# Empty = use default 3-juror set (OPENAI_MODEL, ANTHROPIC_MODEL, GEMINI_PRO_MODEL).
CONSENSUS_JURORS=
# Opt-in: append local Qwen as 4th juror (raises threshold 2/3 -> 3/4).
USE_QWEN_CONSENSUS_JUROR=
# Judge provider override (null | gemini | qwen). Empty = registry default.
JUDGE_PROVIDER=
# DEPRECATED — use GOOGLE_API_KEY instead. Accepted as fallback alias only.
# GEMINI_API_KEY=

# --- MCP / integration tokens ---
NOTION_TOKEN=
NOTION_MCP_DATABASE_ID=
GITHUB_TOKEN=
FIGMA_TOKEN=
FIGMA_TEAM_ID=

# --- Redis ---
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
LANGCACHE_REDIS_KEY=
LANGCACHE_ID=

# --- Embedding service ---
EMBEDDING_ENABLED=true
EMBEDDING_DEVICE=cuda
# Default provider when callers of create_embedding_client() omit `provider=`.
# Valid: bge-m3 | openai | gemini | anthropic. Set to bge-m3 for local-only
# (BGE via vLLM or sentence-transformers); set to openai to route through the
# OpenAI SDK (which honors OPENAI_API_BASE_URL — point at vLLM for hybrid).
AGENTIC_EMBEDDING_PROVIDER=bge-m3
# Optional explicit model pin; leave empty to use the provider's factory default
# (BAAI/bge-m3 for bge-m3, text-embedding-3-large for openai).
AGENTIC_EMBEDDING_MODEL=

# --- HIVE MIND persistent store ---
HIVE_MIND_STRICT_MODE=false
SEMANTIC_CACHE_D2_ENABLED=1
SEMANTIC_CACHE_PROMOTE_ENABLED=1
SEMANTIC_CACHE_L1_WARMUP_LIMIT=256
SEMANTIC_CACHE_THRESHOLD=0.95        # R1B similarity gate: 0.0=permissive, 1.0=strict (default 0.95)
SEMANTIC_CACHE_TTL_SECONDS=86400     # R1B entry TTL in seconds; 0=no expiry (default 86400 = 24h)
EXACT_CACHE_D1_ENABLED=1             # R1A exact-cache writeback + D1 gate
EMBEDDING_MODEL_ID=bge-m3-v1
HIVE_MIND_EMBEDDING_MODEL_VERSION=bge-m3-v1
HIVE_MIND_RETRIEVAL_CONFIG_HASH=default
HIVE_MIND_MIN_CONFIDENCE=0.98
HIVE_MIND_TRACE_SAMPLING_RATE=1.0
HIVE_MIND_PROMOTION_THRESHOLD=0.8
HIVE_MIND_WORKING_MEMORY_TTL=86400
HIVE_MIND_LONG_TERM_TTL=604800

# --- Local Qwen/vLLM inference (optional — overrides code defaults) ---
# If unset, code defaults to http://localhost:8000/v1 and Qwen/Qwen2.5-32B-Instruct-AWQ.
# Set VLLM_BASE_URL to the WSL IP when calling from Windows, e.g. http://172.23.114.118:8000/v1
VLLM_BASE_URL=http://172.23.114.118:8000/v1
VLLM_MODEL_NAME=

# --- Application ---
LOG_LEVEL=INFO
DEBUG=false
PYTHONUNBUFFERED=1
PYTHONUTF8=1

# --- Author-Gate ledger integrity (W4 hardening) ---
# 64-hex-char HMAC-SHA256 key. Generate per machine; never commit.
# Pre-populated at .windsurf/state/refactor_decisions/.signing_key (gitignored).
AUTHOR_GATE_SIGNING_KEY=

# --- ADG three-bucket gate flags (plan adg-three-bucket-unified-c4f8e2 W5/W6) ---
# W5 P5.1: spine delegation gate mode. Default "strict" (flipped 2026-04-30).
#   Rollback: APPS_SPINE_DELEGATION_GATE_MODE=advisory
APPS_SPINE_DELEGATION_GATE_MODE=
# W5 P5.1/P3.2: bypass the apps_* spine delegation gate entirely.
APPS_SPINE_DELEGATION_GATE_BYPASS=
# W5 P5.2: optional health-score floor for three-bucket gap gate (0.0-100.0).
#   Default 0.0 (reporting-only) until P5.5 soak calibrates.
THREE_BUCKET_GAP_MIN_HEALTH_SCORE=
# W5 / three-bucket-gap-remediation-069806: bypass the three-bucket gap gate.
THREE_BUCKET_GAP_BYPASS=
# W5 / three-bucket-gap-remediation-069806: advisory mode override (default 1=strict).
THREE_BUCKET_GAP_STRICT=
# W5 P5.3: activate the L2 agent blast-radius cache pilot (default off).
#   Only literal "1" activates; any other value (including "true") is OFF.
L2_PILOT_BLAST_RADIUS_ENABLED=
# W6 P6.2: bypass the ADG snapshot signature verification gate.
ADG_SIGNATURE_BYPASS=
# W6 P6.3: bypass the schema-graduation readiness gate.
ADG_TRIPLET_GRADUATION_BYPASS=
# W6 P6.1: bypass ADG_CERTIFIED strict run (once soak completes).
ADG_CERTIFIED_BYPASS=
# W6: schema-graduation-readiness strict mode. Flip once soak is green.
SCHEMA_GRADUATION_READINESS_STRICT=
# W4 P4.1: bypass the pre-commit MM dual-state silent rollback guard.
PRECOMMIT_MM_GUARD_BYPASS=
# W3 P3.1: strict-mode flag for consumer-mode declaration gate (default 1).
CONSUMER_MODE_GATE_STRICT=
# W3 P3.1: bypass for consumer-mode declaration gate.
CONSUMER_MODE_BYPASS=
# W3 runtime-observability: strict-mode flags (defaults 1 post-W5 P5.1).
RUNTIME_PROOF_VIEW_STRICT=
GENAI_SEMCONV_STRICT=
# W3 runtime-observability: bypass variants.
RUNTIME_PROOF_VIEW_BYPASS=
GENAI_SEMCONV_BYPASS=
# W6 P6.1: ADG_CERTIFIED_STRICT=1 activates strict without --strict CLI flag.
ADG_CERTIFIED_STRICT=
# W6 P6.2: signing-gate strict-mode activation (env sibling of --strict).
ADG_SIGNATURE_GATE_STRICT=
# W6 P6.2: path override for Ed25519 signing keypair.
ADG_SIGNING_KEY_PATH=
# W6 P6.3: bypass for the graduate_schema_not_null script.
SCHEMA_GRADUATION_BYPASS=
# W6 P6.3: bypass for the schema-graduation readiness gate.
SCHEMA_GRADUATION_READINESS_BYPASS=
# Constitutional §31: bypass for the SSOT folder-routing gate.
SSOT_FOLDER_BYPASS=

# --- Broader 3B-tier bypass surface (declared for P6.5 gate hygiene) ---
# Author-gate v2 strict/bypass.
AUTHOR_GATE_V2_BYPASS=
AUTHOR_GATE_V2_STRICT=
# Call-multiplicity gate.
CALL_MULTIPLICITY_BYPASS=
CALL_MULTIPLICITY_THRESHOLD=
# Cross-app contract gate.
CROSS_APP_CONTRACT_BYPASS=
# Dangling-import ratchet.
DANGLING_IMPORT_BYPASS=
# Edge-authority wiring gate.
EDGE_AUTHORITY_BYPASS=
# Semantic-edges suppression override (runtime OTel emit gate).
EMITS_SUPPRESS=
# Impossible-states gate.
IMPOSSIBLE_STATES_BYPASS=
# L3 runtime gate mode selector.
L3_RUNTIME_GATE_MODE=
# Registry-integrity gate.
REGISTRY_INTEGRITY_BYPASS=
# Runtime-topology gate.
RUNTIME_TOPOLOGY_BYPASS=
# Test-concentration gate trio.
TEST_CONCENTRATION_GATE_BYPASS=
TEST_CONCENTRATION_GATE_STRICT=
TEST_CONCENTRATION_GATE_WRITE_BASELINE=
# Unresolved-dependencies ratchet.
UNRESOLVED_RATCHET_BYPASS=
# ADG SSOT HMAC signing key.
ADG_SSOT_HMAC_KEY=
# OTel MCP runtime ADG dir override.
OTEL_MCP_RUNTIME_ADG_DIR=
# OTel proof-pipeline output path + mode.
OTEL_PROOF_OUTPUT=
OTEL_PROOF_OUTPUT_MODE=
# HuggingFace access token (required for gated models — Qwen AWQ, Llama, etc.).
# Canonical var is HF_TOKEN; HUGGINGFACE_HUB_TOKEN is the legacy alias the SDK also honors.
HF_TOKEN=
HUGGINGFACE_HUB_TOKEN=
# HuggingFace caches (used when L5 safety downloads sentence-transformers etc).
HF_HOME=
HUGGINGFACE_HUB_CACHE=
# Apps HOP pipeline location gate bypass (ops_scripts/ci/check_apps_hop_pipeline_location.py).
APPS_HOP_PIPELINE_GATE_BYPASS=
# LLM-judge-veto: mock-safe approved-mock attestation flag (test/CI fixture path only).
LLMJUDGEVETO_APPROVED_MOCK_SAFE=
# Local Qwen consensus-juror endpoint + model (Scenario-A live-provider proof).
LOCAL_QWEN_ENDPOINT=http://172.23.114.118:8000/v1
LOCAL_QWEN_MODEL=
# W2 verifier output directory override (ops_scripts/ci/_w2_verifier_common.py).
W2_ARTIFACT_DIR=

# Tavily web search API key — used by apps_research.integrations.tavily_retrieval (plan P1.2)
TAVILY_API_KEY=


# ============================================================================
# WA1.P1 (three-bucket-and-apps-spine-closeout-a4f8c2) — residual flag declaration.
# 50 flags read in code but previously undeclared. Grouped by purpose; defaults
# blank unless the documented default is non-empty.
# ============================================================================

# --- Author-Gate / decision-ledger discipline (constitutional §30) ---
# Bypasses + fail-closed escalations for the AG capture/audit pipeline.
ASK_PACKET_AUDIT_FRESHNESS_BYPASS=
ASK_PACKET_STALENESS_DAYS=                  # default 7 days
AUTHOR_GATE_UI_CONFORMANCE_BYPASS=
AUTHOR_GATE_UI_STALENESS_DAYS=              # default 7 days
DECISION_LEDGER_FRESHNESS_BYPASS=
DECISION_LEDGER_STRICT=                     # 1 = fail-closed on stale ledger
CALIBRATION_AUTHENTICITY_BYPASS=

# --- AG queue drain / seed markers (constitutional §35) ---
AG_QUEUE_DRAIN_FRESHNESS_BYPASS=
AG_QUEUE_SEED_MARKERS_BYPASS=

# --- Plan registration / Notion plans-DB enforcement (constitutional §36) ---
PLAN_REGISTRATION_BYPASS=
PLAN_REGISTRATION_FAIL_CLOSED=              # 1 = block when plan unregistered
NOTION_PLANS_AI_SUMMARY_FAIL_CLOSED=
NOTION_PLANS_STATUS_FAIL_CLOSED=
BACKLOG_PLAN_LINKAGE_FAIL_CLOSED=
NOTION_API_TOKEN=                           # alias for NOTION_API_KEY (some scripts read this name)

# --- Token-budget / scope-containment guards (constitutional §33, §34) ---
ALWAYS_ON_BUDGET_BYPASS=

# --- Apps domain-contract harness parity (apps_eval_doctrine §6) ---
APP_DOMAIN_HARNESS_PARITY_FAIL_CLOSED=
AGENT_SPEC_COMPLETENESS_FAIL_CLOSED=
APPS_DOM_FIXTURE_FRESHNESS_BYPASS=
APPS_DOM_FIXTURE_FRESHNESS_HOURS=           # default 24 hours

# --- Fort Knox certification discipline (constitutional §32) ---
FORTKNOX_DISCIPLINE_BYPASS=                 # shared bypass across both arms
FORTKNOX_FRESHNESS_BYPASS=
FORTKNOX_DEV_MODE=                          # 1 = ephemeral signing key path
DIRTY_TREE_ACK=                             # 1 = ACK uncommitted tree on signoff
POSITIVE_CONTROL_REQ_IDS=                   # comma-separated canary req IDs
POSITIVE_CONTROL_STRICT=                    # 1 = strict canary verification
MIN_PASSING_CONTROLS=                       # min positive-control count (default 1)
HOLDOUT_ISOLATION_BYPASS=
LEGACY_YAML_DELETION_BYPASS=
GROUNDED_RAG_ACTIVE_FAIL_CLOSED=
CSV_SIGNOFF_PATH=                           # alternate signoff CSV emission path

# --- Three-bucket ADG certification (plan adg-three-bucket-unified-c4f8e2) ---
ADG_CERTIFICATION_MODE=                     # advisory|strict (default advisory)
AGENTIC_CORE_RUNTIME_MODE=                  # spine runtime mode override

# --- RationaleQualityJudge calibration gates (plan apps-underwriting-ai-rationale-judge-deferred-d4e7a2) ---
# RJC1: Spearman calibration gate. Set to 1 to fail-close when rho drops below 0.80 global / 0.70 per-dim.
RATIONALE_JUDGE_CALIB_FAIL_CLOSED=1
# RJC1 bypass (scripted batch runs only).
RATIONALE_JUDGE_CALIB_BYPASS=
# RJC2: holdout/dev-fixture split integrity. Set to 1 to fail-close on overlap.
EVAL_HOLDOUT_SPLIT_FAIL_CLOSED=1
# RJC2 bypass (scripted batch runs only).
EVAL_HOLDOUT_SPLIT_BYPASS=
# Weekly calibration report bypass.
RATIONALE_JUDGE_REPORT_BYPASS=
# DS-R4: production log miner — PII policy approved 2026-05-06 by Amit Ayer.
# Set to 1 to skip mining in offline/test environments. Leave empty for live runs.
PROD_LOG_MINER_BYPASS=

# --- apps_research / apps_rg / apps_underwriting_ai tunables ---
APPS_RESEARCH_RETRIEVAL_V2=                 # 1 = enable v2 retrieval path
APPS_RG_BLUEPRINT_HASH=                     # cache-busting hash override
APPS_RG_POLICY_HASH=                        # cache-busting hash override
APPS_UW_AGREEMENT_LOG_PATH=                 # frontier judge agreement log
APPS_UW_FRONTIER_JUDGE_MODEL=               # default OpenAI/Gemini model
APPS_UW_FRONTIER_PAIRING_ENABLED=           # 1 = enable frontier-pair runs
APPS_UW_RATIONALE_LLM_DISABLED=             # 1 = skip rationale LLM
NARRATIVE_LENIENT_CRITICAL=                 # apps_rg narrative pass tolerance
NARRATIVE_TEMP_LADDER=                      # apps_rg ensemble temp schedule

# --- LLM provider model overrides (apps_rg / apps_underwriting_ai) ---
ANTHROPIC_NARRATIVE_GENERATOR_MODEL=
ANTHROPIC_NARRATIVE_JUDGE_MODEL=
GEMINI_NARRATIVE_GENERATOR_MODEL=
OPENAI_NARRATIVE_GENERATOR_MODEL=
OPENAI_NARRATIVE_JUDGE_MODEL=

# --- Frontier (apps_underwriting_ai vendor LLM) ---
FRONTIER_API_BASE_URL=
FRONTIER_API_KEY=

# --- Local vLLM (Qwen consensus juror) ---
VLLM_API_KEY=                               # local vLLM endpoint shared secret