# Agentic Workflow — Environment Variables
# Copy this file to .env and fill in your API keys

# =============================================================================
# X1D LLM Judge Providers (credentials + RG judge model overrides)
# Keys are workspace-wide; apps_rg reads them for Gemini/Anthropic X1D backends.
# =============================================================================

# Google AI / Gemini (canonical key name)
# Get key from: https://ai.google.dev/
GOOGLE_API_KEY=your_google_ai_api_key_here
# Deprecated alias (still read by loaders if GOOGLE_API_KEY is unset): GEMINI_API_KEY=

# OpenAI ChatGPT
# Get key from: https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude
# Get key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# =============================================================================
# apps_rg X1D proof judge env (SSOT: section_judge_policy.py + section_judge_profile.py)
# Adapters: executive_summary_x1d.py (headline, exec summary, unify, IBM, competencies advisory)
# =============================================================================
#
# Judge tiers (per section):
#   ENHANCED_REASONING     — executive_summary, final_aggregate_resume
#   STANDARD_REASONING    — headline, unify_narrative, ibm_narrative
#   BULLET_REWRITE_QUALITY — unify_bullets, ibm_bullets
#   OPTIONAL_ADVISORY     — competencies (does not gate X3 proof)
#
# Resolution: APPS_RG_*_JUDGE_MODEL_{ENHANCED|STANDARD} → optional APPS_RG_*_JUDGE_MODEL →
# profile_defaults (section_judge_profile.py). General OPENAI_MODEL / ANTHROPIC_MODEL /
# GOOGLE_AI_* are NOT used for proof judges.
#
# Forbidden for proof (advisory-only): *flash*, *mini*, *haiku*, gemini-2.0-flash, gpt-4o-mini
#
# --- Recommended overrides (uncomment and set) ---
# APPS_RG_GOOGLE_JUDGE_MODEL_ENHANCED=gemini-3.1-pro-preview   # ENHANCED_REASONING
# APPS_RG_GOOGLE_JUDGE_MODEL_STANDARD=gemini-2.5-pro           # STANDARD + BULLET tiers
# APPS_RG_GOOGLE_JUDGE_MODEL=   # optional global override (wins both tiers if set)
# APPS_RG_GEMINI_JUDGE_MODEL=   # deprecated alias of APPS_RG_GOOGLE_JUDGE_MODEL
# APPS_RG_OPENAI_JUDGE_MODEL_ENHANCED=gpt-5.5   # ENHANCED_REASONING chat/completions (+ reasoning.effort)
# Do NOT use gpt-5.5-pro here — completions-only SKU returns 404 on chat/completions.
# APPS_RG_OPENAI_JUDGE_MODEL_STANDARD=gpt-5.5        # STANDARD + BULLET tiers
# APPS_RG_OPENAI_JUDGE_REASONING_EFFORT=high         # ENHANCED only (gpt-5.5* family)
# APPS_RG_OPENAI_JUDGE_MODEL=   # optional global override (wins both tiers if set)
# APPS_RG_ANTHROPIC_JUDGE_MODEL_ENHANCED=claude-opus-4-6   # ENHANCED_REASONING
# APPS_RG_ANTHROPIC_JUDGE_MODEL_STANDARD=claude-sonnet-4-6  # STANDARD + BULLET tiers
# APPS_RG_ANTHROPIC_JUDGE_MODEL=   # optional global override (wins both tiers if set)
# APPS_RG_ANTHROPIC_JUDGE_MAX_OUTPUT_TOKENS=2000
# APPS_RG_GOOGLE_JUDGE_MAX_OUTPUT_TOKENS=4096
# APPS_RG_ANTHROPIC_ALLOW_MODEL_FALLBACK=false

# =============================================================================
# Generic Google AI models (canonical — agentic_core model_registry reads these)
# Deprecated aliases GEMINI_MODEL / GEMINI_PRO_MODEL / GEMINI_API_KEY: fallback only
# =============================================================================
# GOOGLE_API_KEY=your_google_ai_api_key_here
# GOOGLE_AI_MODEL=gemini-2.5-flash
# GOOGLE_AI_PRO_MODEL=gemini-2.5-pro
# GOOGLE_AI_MAX_OUTPUT_TOKENS=4096
# OPENAI_MODEL=gpt-5.1
# ANTHROPIC_MODEL=claude-sonnet-4-6

# =============================================================================
# Qwen/vLLM Provider (local inference)
# =============================================================================

# Base URL for vLLM server (default: http://localhost:8000/v1)
# VLLM_BASE_URL=http://localhost:8000/v1

# Context window — must match vLLM --max-model-len (default SSOT: 16384 on RTX 5090)
# VLLM_MAX_MODEL_LEN=16384

# Qwen model name (default: Qwen/Qwen2.5-32B-Instruct-AWQ)
# QWEN_VLLM_MODEL=Qwen/Qwen2.5-32B-Instruct-AWQ

# Timeout for Qwen chat completions in seconds (default: 60; 120 recommended under parallel load)
# APPS_RG_QWEN_TIMEOUT_SECONDS=120

# Auto-start Docker container local-qwen-vllm when preflight sees it stopped (default: off)
# APPS_RG_VLLM_AUTO_START=1

# Whole-run Phase-1 section lanes — vLLM-safe parallel dispatch (default: serial)
# APPS_RG_PARALLEL_PHASE1_LANES=1
# APPS_RG_PHASE1_MAX_PARALLEL=3

# =============================================================================
# apps_rg BGE-M3 embeddings + Chroma vector store (SSOT: apps_rg/runtime/embedding_settings.py)
# Chroma stores vectors only — embeddings are always explicit local BGE (never Chroma default EF).
# apps_rg __main__ auto-enables when BAAI/bge-m3 exists under repo artifacts or HF hub cache.
# Opt-out: EMBEDDING_ENABLED=false
# =============================================================================
# EMBEDDING_ENABLED=true
# APPS_RG_EMBEDDING_ENABLED=true
# APPS_RG_EMBEDDING_MODEL_PATH=C:/Users/you/.cache/huggingface/hub/models--BAAI--bge-m3/snapshots/<hash>
# CHROMA_PERSIST_DIR=./data/cache/chromadb
# EMBEDDING_MODEL_ID=bge-m3-v1
# APPS_RG_C0_DENSE_SPARSE_MANDATORY=1
# APPS_RG_C0_SPARSE_ENABLED=1
# APPS_RG_C03_GRAPH_MANDATORY=1

# =============================================================================
# ADG three-bucket audit (ADR-079 — opt-in; certification sets ADG_THREE_BUCKET=1)
# =============================================================================
# ADG_THREE_BUCKET=0
# ADG_RUNTIME_VIEW=0
# ADG_REGISTRY_LIFT=0
# ADG_THREE_BUCKET_REPORTS=0
# ADG_THREE_BUCKET_SIGN=0
# ADG_CERTIFICATION_MODE=0
# ADG_CERTIFIED_USE_ROLLUP=1
# ADG_CI_GATES_LEGACY_M=0
# ADG_SKIP_PLANE2_MANIFEST=0

# =============================================================================
# Other MCP/Integration Keys (if needed)
# =============================================================================

# Tavily API key for web search (Cursor MCP + apps_research)
# TAVILY_API_KEY=your_tavily_api_key_here

# Brave Search MCP only (legacy L2 / mcp_registry; optional if Tavily-only)
# BRAVE_API_KEY=your_brave_api_key_here

# Hugging Face Hub (model downloads / vLLM) — canonical name HF_TOKEN
# HF_TOKEN=hf_your_token_here

# Notion integration token (if using Notion MCP)
# NOTION_INTEGRATION_TOKEN=your_notion_token_here

# Context7 API key (optional, for library docs)
# CONTEXT7_API_KEY=your_context7_api_key_here

# =============================================================================
# Semantic cache — L0 Path-D / D2 (SSOT: config/expected_wiring.yaml,
# plan semcache-make-live-7a2d4b / check_expected_wiring required_env_flags)
# =============================================================================
# Enable D2 semantic cache learn/recall wiring surfaced by ExecutionOrchestrator.
SEMANTIC_CACHE_D2_ENABLED=1
# When set, allow promotion paths that call promote_to_long_term (qualification-gated).
SEMANTIC_CACHE_PROMOTE_ENABLED=

# =============================================================================
# L2 heal routing — confidence band cutoffs (SSOT-enforced pairing)
#
# Canonical reader: agentic_core/L2_execution/healers/routing_thresholds_ssot.py
# Policy: MEDIUM < HIGH, both finite, both in [0,1]; invalid combos fail closed on load.
#
# HIGH: scores at or above route to HealTier.HIGH semantics (deterministic/rules-first tier).
# MEDIUM: inclusive lower bound for the middle confidence band between HIGH and LOW.
#
# Defaults (paired): HIGH=0.85, MEDIUM=0.50 unless overridden together here.
#
# PRIMARY_* knobs in confidence_aware_executor.py are orthogonal (primary executor path).
# =============================================================================
#
# HEALING_CONFIDENCE_HIGH=0.85
# HEALING_CONFIDENCE_MEDIUM=0.50

# =============================================================================
# Router / cascade operational toggles (NOT the heal-band SSOT knobs above)
# =============================================================================
#
# HARD_DISABLE_QWEN=0
#
# FALLBACK_SEMANTICS (doc-only pointer): CASCADE_DISABLE_SEMANTICS,
# GEMINI_UNAVAILABLE_BEHAVIOR, DISABLE_QWEN_FALLBACK handled in HealingRouter helpers.
#
# Posterior ledger floor / opt-out knobs:
#
# ROUTING_POSTERIOR_N_FLOOR=
# ROUTING_POSTERIOR_DISABLED=

# =============================================================================
# Signal enhancer knobs (signal_quality_config) — NOT L2 heal routing
#
# SIGNAL_* adjusts signal-quality telemetry only — it does NOT move heal bands.
#
# Documents: agentic_core/runtime/config/signal_quality_config.py
# =============================================================================
#
# SIGNAL_EXCELLENT_MIN=
# SIGNAL_GOOD_MIN=
# SIGNAL_HIGH_MIN=
# SIGNAL_MARGINAL_MIN=

# =============================================================================
# ADG burndown report / canvas (tools/reports/adg_burndown_*.py)
# =============================================================================
ADG_BURNDOWN_INLINE_BYPASS=
ADG_BURNDOWN_CANVAS_BYPASS=
ADG_BURNDOWN_NO_OPEN=
CURSOR_CANVASES_DIR=
CURSOR_PROJECT_SLUG=

# =============================================================================
# apps_rg executive summary — post-regen judge rescoring mode
# soft_only (default) | full_panel — see executive_summary_repair_policy.py
# =============================================================================
APPS_RG_EXEC_SUMMARY_POST_REGEN_JUDGE_MODE=
APPS_RG_EXEC_SUMMARY_JUDGE_REGEN_PRESCRIPTIVE_DELTA=
APPS_RG_EXEC_SUMMARY_JUDGE_REGEN_LEGACY_BLOCK=
