# =============================================================================
# CONFIGURATION OPTIONS
# =============================================================================

# Redis Configuration (auto-configured by docker-compose)
REDIS_HOST=r# Redis Stack - L1 Cache (Hot Memory)
REDIS_URL=redis://localhost:6379

# Application Settings
PYTHONUNBUFFERED=1
LOG_LEVEL=INFO
DEBUG=false

# Embedding Configuration
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Canon Validator Settings
CACHE_WARMUP=true
MAX_RETRIES=3
RETRY_DELAY=1.0
FAILURE_THRESHOLD=5
SUCCESS_THRESHOLD=3

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# =============================================================================
# QUICK START INSTRUCTIONS
# =============================================================================

# 1. Copy this template:
#    cp .env.example .env
#
# 2. Edit .env with your actual API keys
#
# 3. Start the complete stack:
#    docker-compose up --build
#
# 4. Verify installation:
#    docker-compose logs agentic-app
#
# 5. Access services:
#    - RedisInsight UI: http://localhost:8001
#    - Application API: http://localhost:8000
#
