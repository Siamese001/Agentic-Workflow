# Subatomic Agentic Architecture - Environment Variables Template
# Copy this file to .env and fill in your actual API keys

# =============================================================================
# CORE LLM PROVIDERS (Required for basic functionality)
# =============================================================================

# OpenAI - GPT-4o, GPT-4o-mini, embeddings, function calling
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic - Claude 3.5 Sonnet, tool use, extended context
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Google Cloud - Gemini 1.5 Pro, grounding, multimodal
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_APPLICATION_CREDENTIALS=/app/path/to/service-account.json

# =============================================================================
# VECTOR DATABASES (Required for semantic search/RAG)
# =============================================================================

# Pinecone - Managed vector database
PINECONE_API_KEY=your-pinecone-api-key-here

# =============================================================================
# OPTIONAL PROVIDERS (Enhanced capabilities, cost optimization)
# =============================================================================

# Mistral AI - EU compliance, strong multilingual models
MISTRALAI_API_KEY=your-mistralai-api-key-here

# Cohere - RAG, reranking, embeddings
COHERE_API_KEY=your-cohere-api-key-here

# Groq - Ultra-fast inference (Llama, Mixtral on LPU)
GROQ_API_KEY=your-groq-api-key-here

# Together AI - Cheap diversified access to open source models
TOGETHER_API_KEY=your-together-api-key-here

# Fireworks AI - Strong tool-calling alternative
FIREWORKS_API_KEY=your-fireworks-api-key-here

# =============================================================================
# CONFIGURATION OPTIONS
# =============================================================================

# Redis Configuration (auto-configured by docker-compose)
REDIS_HOST=redis-stack
REDIS_PORT=6379
REDIS_URL=redis://redis-stack:6379

# Application Settings
PYTHONUNBUFFERED=1
LOG_LEVEL=INFO
DEBUG=false

# =============================================================================
# QUICK START INSTRUCTIONS
# =============================================================================

# 1. Copy this template:
#    cp .env.example .env
#
# 2. Edit .env with your actual API keys
#
# 3. Start the complete stack:
#    docker-compose up --build
#
# 4. Verify installation:
#    docker-compose logs agentic-app
#
# 5. Access services:
#    - RedisInsight UI: http://localhost:8001
#    - Application API: http://localhost:8000
#
# =============================================================================
# API KEY SOURCES
# =============================================================================

# OpenAI: https://platform.openai.com/api-keys
# Anthropic: https://console.anthropic.com/
# Google Cloud: https://console.cloud.google.com/iam-admin/serviceaccounts
# Pinecone: https://app.pinecone.io/
# Mistral AI: https://console.mistral.ai/
# Cohere: https://dashboard.cohere.com/api-keys
# Groq: https://console.groq.com/keys
# Together AI: https://api.together.xyz/settings/api-keys
# Fireworks AI: https://fireworks.ai/account/api-keys
