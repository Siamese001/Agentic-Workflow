# Subatomic Agentic Architecture - Environment Variables Template
# Copy this file to .env and fill in your actual API keys

# =============================================================================
# CORE LLM PROVIDERS (Required for basic functionality)
# =============================================================================

# OpenAI - GPT-4o, GPT-4o-mini, embeddings, function calling
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic - Claude 3.5 Sonnet, tool use, extended context
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Cloud - Gemini 2.5, grounding, multimodal
GEMINI_API_KEY=your_google_gemini_api_key_here

# Google AI - Alternative key name used by some scripts
GOOGLE_API_KEY=your_google_api_key_here

# Gemini Model Configuration (Tiered Sovereignty)
GEMINI_MODEL=gemini-3-flash-preview      # Standard arbitration (0.50 - 0.75 confidence)
GEMINI_PRO_MODEL=gemini-2.5-pro          # Advanced reasoning recovery (< 0.50 confidence)

# Sovereign Thresholds
SOVEREIGN_HIGH_CONFIDENCE=0.75
SOVEREIGN_MEDIUM_CONFIDENCE=0.50

# Signal Quality Thresholds
SIGNAL_EXCELLENT_MIN=0.9
SIGNAL_HIGH_MIN=0.75
SIGNAL_MEDIUM_MIN=0.6
SIGNAL_LOW_MIN=0.4

# =============================================================================
# ADDITIONAL PROVIDERS (Optional)
# =============================================================================

# Brave Search API
BRAVE_API_KEY=your_brave_api_key_here

# Additional configuration can be added here as needed
