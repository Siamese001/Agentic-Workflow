{
  "$description": "Configuration-driven Artist specifications implementing Clean R&R: 'What' (this file) vs 'How' (workflow_RES.py). Each section defines WHAT to generate and HOW to build context, delegating implementation details to Python.",
  "$schema_version": "artist_specs_v2.0_clean_rr",
  "K0_CERTIFICATIONS_HEADER": {
    "description": "Static header: 'CERTIFICATIONS & CREDENTIALS'",
    "generation_method": "_generate_dummy_header"
  },
  "K0_COMPETENCIES_HEADER": {
    "description": "Static header: 'STRATEGIC & TECHNICAL COMPETENCIES'",
    "generation_method": "_generate_dummy_header"
  },
