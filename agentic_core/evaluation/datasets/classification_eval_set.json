{
  "name": "classification_eval_set",
  "version": "1.0.0",
  "description": "Golden dataset for binary and multi-class classification metric validation. Used by apps_eval ml_metrics_validation suite.",
  "examples": [
    {
      "id": "binary_perfect_precision",
      "description": "All predicted positives are true positives — precision = 1.0",
      "task": "binary",
      "positive_label": 1,
      "predictions": [1, 1, 1, 0, 0],
      "ground_truth": [1, 1, 1, 1, 0],
      "expected": {
        "precision": 1.0,
        "recall": 0.75,
        "f1": 0.857143
      }
    },
    {
      "id": "binary_perfect_recall",
      "description": "All true positives are retrieved — recall = 1.0",
      "task": "binary",
      "positive_label": 1,
      "predictions": [1, 1, 1, 1, 0],
      "ground_truth": [1, 1, 1, 0, 0],
      "expected": {
        "precision": 0.75,
        "recall": 1.0,
        "f1": 0.857143
      }
    },
    {
      "id": "binary_perfect_f1",
      "description": "No false positives or false negatives — F1 = 1.0",
      "task": "binary",
      "positive_label": 1,
      "predictions": [1, 1, 0, 0, 1],
      "ground_truth": [1, 1, 0, 0, 1],
      "expected": {
        "precision": 1.0,
        "recall": 1.0,
        "f1": 1.0
      }
    },
    {
      "id": "binary_zero_f1",
      "description": "All predictions wrong — F1 = 0.0",
      "task": "binary",
      "positive_label": 1,
      "predictions": [0, 0, 0, 1, 1],
      "ground_truth": [1, 1, 1, 0, 0],
      "expected": {
        "precision": 0.0,
        "recall": 0.0,
        "f1": 0.0
      }
    },
    {
      "id": "binary_harmonic_mean_invariant",
      "description": "F1 is harmonic mean of P and R: F1 = 2*P*R/(P+R)",
      "task": "binary",
      "positive_label": "pos",
      "predictions": ["pos", "pos", "neg", "pos", "neg"],
      "ground_truth": ["pos", "neg", "pos", "pos", "neg"],
      "expected": {
        "precision": 0.666667,
        "recall": 0.666667,
        "f1": 0.666667
      }
    },
    {
      "id": "confusion_matrix_total_invariant",
      "description": "TP + FP + TN + FN must equal total sample count",
      "task": "binary",
      "positive_label": 1,
      "predictions": [1, 0, 1, 0, 1, 0, 1, 0],
      "ground_truth": [1, 1, 0, 0, 1, 0, 0, 1],
      "expected": {
        "total": 8,
        "tp": 2,
        "fp": 2,
        "tn": 2,
        "fn": 2
      }
    },
    {
      "id": "multiclass_macro_f1",
      "description": "Macro F1 = unweighted mean of per-class F1 scores",
      "task": "multiclass",
      "averaging": "macro",
      "predictions": ["cat", "dog", "bird", "cat", "dog", "bird"],
      "ground_truth": ["cat", "cat", "bird", "cat", "dog", "dog"],
      "expected": {
        "f1_macro": 0.655556
      }
    },
    {
      "id": "multiclass_weighted_f1",
      "description": "Weighted F1 weights per-class F1 by class support",
      "task": "multiclass",
      "averaging": "weighted",
      "predictions": ["A", "A", "B", "B", "C"],
      "ground_truth": ["A", "B", "B", "B", "C"],
      "expected": {
        "f1_weighted": 0.813333
      }
    },
    {
      "id": "multiclass_micro_f1",
      "description": "Micro F1 aggregates TP/FP/FN across all classes",
      "task": "multiclass",
      "averaging": "micro",
      "predictions": ["A", "A", "B", "C"],
      "ground_truth": ["A", "B", "B", "C"],
      "expected": {
        "f1_micro": 0.75
      }
    }
  ]
}
