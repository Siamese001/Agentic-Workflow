{
  "mcpServers": {
    "browser": {
      "args": [
        "/c",
        "C:\\Program Files\\nodejs\\npx.cmd",
        "-y",
        "@modelcontextprotocol/server-puppeteer"
      ],
      "command": "cmd.exe"
    },
    "figma": {
      "args": [
        "/c",
        "C:\\Program Files\\nodejs\\npx.cmd",
        "-y",
        "figma-mcp-pro",
        "--figma-api-key",
        "${FIGMA_TOKEN}"
      ],
      "command": "cmd.exe",
      "description": "Figma design system integration, asset downloads, and design-to-code.",
      "env": {
        "FIGMA_TEAM_ID": "${FIGMA_TEAM_ID}"
      }
    },
    "filesystem": {
      "args": [
        "/c",
        "C:\\Program Files\\nodejs\\npx.cmd",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "./output",
        "./logs",
        "./project_knowledge"
      ],
      "command": "cmd.exe",
      "description": "Restricted access: Can only read/write to specific output folders."
    },
    "github": {
      "args": [
        "/c",
        "C:\\Program Files\\nodejs\\npx.cmd",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "command": "cmd.exe",
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "pinecone": {
      "args": [
        "/c",
        "C:\\Program Files\\nodejs\\npx.cmd",
        "-y",
        "@pinecone-database/mcp"
      ],
      "command": "cmd.exe",
      "description": "Vector database for semantic search and RAG.",
      "env": {
        "PINECONE_API_KEY": "${PINECONE_API_KEY}"
      }
    },
    "postgres_memory": {
      "args": [
        "/c",
        "C:\\Program Files\\nodejs\\npx.cmd",
        "-y",
        "@modelcontextprotocol/server-postgres",
        "${DATABASE_URL}"
      ],
      "command": "cmd.exe",
      "description": "Persistent episodic memory store."
    },
    "sequential_thinking": {
      "args": [
        "/c",
        "C:\\Program Files\\nodejs\\npx.cmd",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "command": "cmd.exe",
      "description": "Chain-of-thought reasoning and structured problem solving."
    },
    "terminal": {
      "args": [
        "/c",
        "powershell",
        "-Command",
        "& { $input | Out-Null; Write-Host 'Terminal MCP placeholder - PowerShell commands can be executed here' }"
      ],
      "command": "cmd.exe",
      "description": "Windows PowerShell terminal access."
    }
  }
}