{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentic-workflow-10-11/schemas/l1_planning/planning_types.json",
  "title": "L1 Planning Types Schema",
  "description": "Data types for L1 planning layer - strategy, research, message, refinement, safety planning",
  "type": "object",
  "properties": {
    "planning_request": {
      "type": "object",
      "properties": {
        "goal": {
          "type": "string",
          "description": "Primary objective for the planning session"
        },
        "context": {
          "type": "object",
          "description": "Additional context and constraints"
        },
        "success_criteria": {
          "type": "array",
          "items": {"type": "string"},
          "description": "List of success criteria"
        },
        "planning_type": {
          "type": "string",
          "enum": ["strategy", "research", "message", "refinement", "safety"],
          "description": "Type of planning to perform"
        }
      },
      "required": ["goal", "planning_type"]
    },
    "planning_response": {
      "type": "object",
      "properties": {
        "plan": {
          "type": "object",
          "description": "Generated plan with steps and rationale"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Confidence score in the plan"
        },
        "alternatives": {
          "type": "array",
          "items": {"type": "object"},
          "description": "Alternative approaches considered"
        },
        "risks": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Identified risks and mitigations"
        }
      },
      "required": ["plan", "confidence"]
    }
  }
}
