{
  "mcpServers": {
    "filesystem": {
      "command": "C:\\Program Files\\nodejs\\npx.cmd",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "./output", "./logs", "./project_knowledge"],
      "description": "Restricted access: Can only read/write to specific output folders."
    },
    "github": {
      "command": "C:\\Program Files\\nodejs\\npx.cmd",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}" }
    },
    "postgres_memory": {
      "command": "C:\\Program Files\\nodejs\\npx.cmd",
      "args": ["-y", "@modelcontextprotocol/server-postgres", "${DATABASE_URL}"],
      "description": "Persistent episodic memory store."
    },
    "browser": {
      "command": "C:\\Program Files\\nodejs\\npx.cmd",
      "args": ["-y", "@modelcontextprotocol/server-puppeteer"]
    },
    "terminal": {
      "command": "uvx",
      "args": ["mcp-server-command", "--allow-commands", "python", "pip", "grep", "cat", "ls"],
      "description": "Safe subset of terminal commands for self-correction."
    }
  }
}
