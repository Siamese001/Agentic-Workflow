# Production Environment Configuration
# Canon Validator Engine - Secrets and Configuration
# 
# IMPORTANT: This file contains sensitive information
# Do not commit to version control
# Use only in production environment

# ================================================
# API Keys (L3 - External Service Layer)
# ================================================

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_TOKENS=4096

# Tavily Search API Configuration
TAVILY_API_KEY=your_tavily_api_key_here
TAVILY_MAX_RESULTS=10
TAVILY_INCLUDE_RAW_CONTENT=false

# ================================================
# Redis Configuration (L4 - State Store)
# ================================================

# Redis Connection
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_strong_redis_password_here
REDIS_DB=0

# Redis Security
REDIS_SSL=false
REDIS_SSL_CERT_REQS=required

# Redis Performance
REDIS_CONNECTION_POOL_MAX=10
REDIS_CONNECTION_TIMEOUT=5
REDIS_SOCKET_TIMEOUT=5

# ================================================
# L5 Governance and Audit Configuration
# ================================================

# MEMemory Configuration
MEMORY_API_KEY=your_memory_api_key_here
MEMORY_ENDPOINT=https://api.memory.example.com
MEMORY_TIMEOUT=10

# Observation Store Configuration
OBSERVATION_STORE_TYPE=memory
OBSERVATION_BATCH_SIZE=100
OBSERVATION_FLUSH_INTERVAL=60

# ================================================
# Security Configuration
# ================================================

# Emergency Bailout Protocol (EBP)
EBP_ENABLED=true
EBP_AUTO_TRIGGER_ON_ERRORS=true
EBP_ERROR_THRESHOLD=10
EBP_TIME_WINDOW=300

# Access Control
ALLOWED_ORIGINS=https://yourdomain.com
API_RATE_LIMIT=100
API_RATE_WINDOW=60

# ================================================
# Logging and Monitoring (L5)
# ================================================

# Log Level
CANON_LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_TO_FILE=true
LOG_TO_CONSOLE=true

# Monitoring
METRICS_ENABLED=true
METRICS_PORT=9090
HEALTH_CHECK_PORT=8080

# OpenTelemetry
OTEL_ENABLED=true
OTEL_SERVICE_NAME=canon-validator
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:14268/api/traces

# ================================================
# Performance and Cost Governance
# ================================================

# LLM Rate Limiting
LLM_REQUESTS_PER_MINUTE=60
LLM_TOKENS_PER_MINUTE=10000
LLM_COST_LIMIT_PER_HOUR=10.0

# Cache Configuration
CACHE_TTL_DEFAULT=3600
CACHE_TTL_SHORT=300
CACHE_TTL_LONG=86400
CACHE_MAX_SIZE=10000

# ================================================
# Git Workspace Configuration
# ================================================

# Git Repository
GIT_REPO_PATH=/app/workspace
GIT_BRANCH=main
GIT_AUTO_COMMIT=false
GIT_SIGN_COMMITS=false

# File System Security
ALLOWED_DIRECTORIES=src,tests,docs,config,data,logs,reports
DENIED_PATTERNS=.env,*.key,*.pem,secrets/

# ================================================
# Docker and Deployment
# ================================================

# Container Configuration
CONTAINER_USER=appuser
CONTAINER_GROUP=appuser
CONTAINER_UID=1000
CONTAINER_GID=1000

# Environment
ENVIRONMENT=production
DEBUG=false
DEVELOPMENT_MODE=false

# ================================================
# MCP (Model Context Protocol) Configuration
# ================================================

MCP_ENABLED=true
MCP_SERVER_PORT=3000
MCP_MAX_CONNECTIONS=5
MCP_TIMEOUT=30
