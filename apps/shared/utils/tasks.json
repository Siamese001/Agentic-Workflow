{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Tests",
            "type": "shell",
            "command": ".venv\\Scripts\\pytest.exe",
            "args": ["tests", "-v"],
            "group": "test",
            "presentation": {
                "echo": true,
