{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Resume Generation Response",
  "description": "Schema for resume generation responses",
  "type": "object",
  "required": ["success", "resume_content", "metadata"],
  "properties": {
    "success": {
      "type": "boolean",
      "description": "Whether the resume generation was successful"
    },
    "resume_content": {
      "type": "object",
      "description": "Generated resume content structured by sections",
      "properties": {
        "header": {
          "type": "object",
          "properties": {
            "name": {"type": "string"},
            "contact": {
              "type": "object",
              "properties": {
                "email": {"type": "string"},
                "phone": {"type": "string"},
                "linkedin": {"type": "string"}
              }
            }
          }
        },
        "summary": {
          "type": "string",
          "description": "Professional summary section"
        },
        "experience": {
          "type": "array",
          "description": "Work experience entries",
          "items": {
            "type": "object",
            "properties": {
              "title": {"type": "string"},
              "company": {"type": "string"},
              "duration": {"type": "string"},
              "achievements": {
                "type": "array",
                "items": {"type": "string"}
              }
            }
          }
        },
        "education": {
          "type": "array",
          "description": "Education entries",
          "items": {
            "type": "object",
            "properties": {
              "degree": {"type": "string"},
              "institution": {"type": "string"},
              "year": {"type": "string"}
            }
          }
        },
        "skills": {
          "type": "object",
          "properties": {
            "technical": {
              "type": "array",
              "items": {"type": "string"}
            },
            "soft": {
              "type": "array",
              "items": {"type": "string"}
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Processing metadata and metrics",
      "properties": {
        "ats_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "ATS optimization score"
        },
        "processing_time": {
          "type": "number",
          "description": "Processing time in seconds"
        },
        "word_count": {
          "type": "integer",
          "description": "Total word count of generated resume"
        },
        "optimization_suggestions": {
          "type": "array",
          "description": "Suggestions for further optimization",
          "items": {"type": "string"}
        },
        "validation_results": {
          "type": "object",
          "properties": {
            "grammar_score": {"type": "number"},
            "readability_score": {"type": "number"},
            "keyword_density": {"type": "number"}
          }
        }
      }
    },
    "errors": {
      "type": "array",
      "description": "Any errors encountered during processing",
      "items": {
        "type": "object",
        "properties": {
          "code": {"type": "string"},
          "message": {"type": "string"},
          "field": {"type": "string"}
        }
      }
    }
  }
}
