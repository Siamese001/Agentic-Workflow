{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Outreach Generation Request",
  "description": "Schema for personalized outreach message generation requests",
  "type": "object",
  "required": [
    "recipient_profile",
    "sender_profile",
    "outreach_type"
  ],
  "properties": {
    "recipient_profile": {
      "type": "object",
      "description": "Information about the message recipient",
      "required": [
        "name",
        "company"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Full name of the recipient",
          "minLength": 2,
          "maxLength": 100
        },
        "company": {
          "type": "string",
          "description": "Company where the recipient works",
          "minLength": 2,
          "maxLength": 100
        },
        "role": {
          "type": "string",
          "description": "Job title or role of the recipient",
          "minLength": 2,
          "maxLength": 100
        },
        "industry": {
          "type": "string",
          "description": "Industry of the recipient's company",
          "minLength": 2,
          "maxLength": 50
        },
        "location": {
          "type": "string",
          "description": "Geographic location of the recipient",
          "maxLength": 100
        },
        "linkedin_url": {
          "type": "string",
          "format": "uri",
          "description": "LinkedIn profile URL of the recipient"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Email address of the recipient"
        },
        "phone": {
          "type": "string",
          "description": "Phone number of the recipient",
          "pattern": "^\\+?[\\d\\s\\-\\(\\)]+$"
        },
        "background": {
          "type": "object",
          "description": "Professional background information",
          "properties": {
            "experience_years": {
              "type": "integer",
              "minimum": 0,
              "maximum": 50,
              "description": "Years of professional experience"
            },
            "education": {
              "type": "string",
              "description": "Educational background"
            },
            "skills": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 2,
                "maxLength": 50
              },
              "description": "List of professional skills"
            },
            "achievements": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 10,
                "maxLength": 200
              },
              "description": "Notable professional achievements"
            }
          }
        },
        "interests": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 50
          },
          "description": "Professional interests or areas of focus"
        }
      }
    },
    "sender_profile": {
      "type": "object",
      "description": "Information about the message sender",
      "required": [
        "name",
        "role"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Full name of the sender",
          "minLength": 2,
          "maxLength": 100
        },
        "role": {
          "type": "string",
          "description": "Job title or role of the sender",
          "minLength": 2,
          "maxLength": 100
        },
        "company": {
          "type": "string",
          "description": "Company of the sender",
          "minLength": 2,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Email address of the sender"
        },
        "phone": {
          "type": "string",
          "description": "Phone number of the sender",
          "pattern": "^\\+?[\\d\\s\\-\\(\\)]+$"
        },
        "linkedin_url": {
          "type": "string",
          "format": "uri",
          "description": "LinkedIn profile URL of the sender"
        },
        "website": {
          "type": "string",
          "format": "uri",
          "description": "Personal or company website"
        },
        "expertise": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 50
          },
          "description": "Areas of expertise"
        },
        "background": {
          "type": "object",
          "description": "Professional background of the sender",
          "properties": {
            "experience_years": {
              "type": "integer",
              "minimum": 0,
              "maximum": 50,
              "description": "Years of professional experience"
            },
            "education": {
              "type": "string",
              "description": "Educational background"
            },
            "achievements": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 10,
                "maxLength": 200
              },
              "description": "Notable professional achievements"
            }
          }
        }
      }
    },
    "outreach_type": {
      "type": "string",
      "description": "Type of outreach message to generate",
      "enum": [
        "email",
        "linkedin",
        "cold_call",
        "follow_up",
        "networking",
        "referral_request",
        "interview_request",
        "partnership_proposal"
      ]
    },
    "context": {
      "type": "object",
      "description": "Additional context for the outreach",
      "properties": {
        "purpose": {
          "type": "string",
          "description": "Primary purpose of the outreach",
          "minLength": 10,
          "maxLength": 200
        },
        "relationship": {
          "type": "string",
          "description": "Existing relationship with recipient",
          "enum": [
            "stranger",
            "acquaintance",
            "colleague",
            "former_colleague",
            "friend",
            "mentor",
            "mentee"
          ]
        },
        "previous_contact": {
          "type": "object",
          "description": "Information about previous contact",
          "properties": {
            "date": {
              "type": "string",
              "format": "date",
              "description": "Date of last contact"
            },
            "method": {
              "type": "string",
              "description": "Method of previous contact",
              "enum": ["email", "phone", "in_person", "linkedin", "other"]
            },
            "summary": {
              "type": "string",
              "description": "Brief summary of previous contact",
              "maxLength": 500
            }
          }
        },
        "mutual_connections": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "description": "List of mutual connections"
        },
        "shared_interests": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 50
          },
          "description": "Shared interests or background"
        },
        "urgency": {
          "type": "string",
          "description": "Urgency level of the outreach",
          "enum": ["low", "medium", "high", "urgent"]
        }
      }
    },
    "preferences": {
      "type": "object",
      "description": "Preferences for message generation",
      "properties": {
        "tone": {
          "type": "string",
          "description": "Desired tone of the message",
          "enum": [
            "formal",
            "professional",
            "casual",
            "friendly",
            "enthusiastic",
            "urgent"
          ],
          "default": "professional"
        },
        "length": {
          "type": "string",
          "description": "Desired length of the message",
          "enum": ["brief", "medium", "detailed"],
          "default": "medium"
        },
        "style": {
          "type": "string",
          "description": "Writing style preference",
          "enum": ["direct", "relationship_focused", "value_proposition", "storytelling"],
          "default": "direct"
        },
        "include_call_to_action": {
          "type": "boolean",
          "description": "Whether to include a call to action",
          "default": true
        },
        "personalization_level": {
          "type": "string",
          "description": "Level of personalization",
          "enum": ["minimal", "moderate", "extensive"],
          "default": "moderate"
        },
        "avoid_topics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 50
          },
          "description": "Topics to avoid in the message"
        },
        "focus_areas": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 50
          },
          "description": "Areas to focus on in the message"
        }
      }
    },
    "async_processing": {
      "type": "boolean",
      "description": "Whether to process the request asynchronously",
      "default": false
    },
    "priority": {
      "type": "integer",
      "description": "Processing priority (1=high, 2=medium, 3=low)",
      "minimum": 1,
      "maximum": 3,
      "default": 2
    },
    "user_id": {
      "type": "string",
      "description": "User identifier for tracking and personalization",
      "minLength": 1,
      "maxLength": 50
    }
  },
  "example": {
    "recipient_profile": {
      "name": "Sarah Johnson",
      "company": "TechCorp Solutions",
      "role": "Senior Product Manager",
      "industry": "Technology",
      "email": "sarah.johnson@techcorp.com",
      "background": {
        "experience_years": 8,
        "skills": ["Product Management", "Agile", "Data Analysis", "User Research"]
      }
    },
    "sender_profile": {
      "name": "Mike Chen",
      "role": "Software Engineer",
      "company": "InnovateTech",
      "email": "mike.chen@innovatetech.com",
      "expertise": ["Full-Stack Development", "Cloud Architecture", "API Design"]
    },
    "outreach_type": "email",
    "context": {
      "purpose": "Discuss potential collaboration on product development",
      "relationship": "stranger",
      "mutual_connections": ["John Davis"],
      "urgency": "medium"
    },
    "preferences": {
      "tone": "professional",
      "length": "medium",
      "style": "value_proposition",
      "personalization_level": "moderate"
    },
    "async_processing": false,
    "priority": 2,
    "user_id": "user123"
  }
}
